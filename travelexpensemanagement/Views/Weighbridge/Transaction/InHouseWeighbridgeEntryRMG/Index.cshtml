<script>

    function validateBigWeighbridgeTable() {
        let isValid = true;
        let errorMessage = '';

        $('#tblInHouseRMGEntry tbody tr').each(function (index) {
            const rowId = this.id;
            const idx = rowId.replace('row', '');

            const weightRaw = $(`#TxtWeight${idx}`).val()?.trim();
            const date = $(`#TxtDate${idx}`).val()?.trim();
            const time = $(`#TxtTime${idx}`).val()?.trim();
            const fromPlace = $(`#ddlFromPlace${idx}`).val()?.trim();
            const toPlace = $(`#ddlToPlace${idx}`).val()?.trim();
            const itemName = $(`#TxtItemName${idx}`).val()?.trim();
            // Remark is excluded

            const weight = parseFloat(weightRaw) || 0;

            // First row
            if (index === 0) {
                if (!weightRaw || weight <= 0 || !date || !time || !fromPlace || !toPlace || !itemName) {
                    isValid = false;
                    errorMessage = 'Please fill required fields in the first row: Weight > 0, Date, Time, From Place, To Place, Item Name.';
                    return false; // break loop
                }
            }
            else {
                // Other rows: only if weight > 0
                if (weight > 0) {
                    if (!date || !time || !fromPlace || !toPlace || !itemName) {
                        isValid = false;
                        errorMessage = `Please fill required fields in row ${idx}: Date, Time, From Place, To Place, Item Name (since Weight > 0).`;
                        return false;
                    }
                }
                // else skip
            }
        });

        if (!isValid) {
            toastr.error(errorMessage);
        }

        return isValid;
    }

