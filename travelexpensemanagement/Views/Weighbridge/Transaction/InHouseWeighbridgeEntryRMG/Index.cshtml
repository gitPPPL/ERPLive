@{
    ViewBag.Title = "In House Weighbridge Entry RMG";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
    <legend class="legend-field">In House Weighbridge Entry RMG</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button onclick="window.location.href='@Url.Action("Index", "InHouseWeighbridgeEntryRMGList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>
    <form id="InHouseRMGForm">
        <input type="hidden" class="form-control" id="TxtDocId" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlDocType">Doc Type</label>
                    <select class="form-control" id="ddlDocType">
                        @* <option>--Select DOC Type--</option> *@
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumDocNo">Doc No <span class="required">*</span></label>
                    <input type="number" class="form-control" id="NumDocNo" placeholder="Enter Doc No" readonly>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DtDocDate">Doc Date <span class="required">*</span></label>
                    <input type="date" class="form-control" id="DtDocDate" readonly>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlStatus">Status</label>
                    <select class="form-control" id="ddlStatus">
                        <option value="1">Open</option>
                        <option value="0">Close</option>
                        <option value="2">Cancel</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlWeightType">Weight Type</label>
                    <select class="form-control" id="ddlWeightType">
                        <option>Gross</option>
                        <option>Tare</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtVehicleNo">Vehicle No <span class="required">*</span></label>
                    <input type="text" maxlength="20" class="form-control" id="TxtVehicleNo" placeholder="Enter Vehicle No">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtTareSlipNo">Tare Slip No</label>
                    <input type="number" class="form-control" id="TxtTareSlipNo" placeholder="Enter Tare Slip No">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtGrossSlipNo">Gross Slip No</label>
                    <input type="number" class="form-control" id="TxtGrossSlipNo" placeholder="Enter Gross Slip No">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-2">
                <label class="checkbox-input-mx">
                    <input type="checkbox" id="ChkCrystalReport" />
                    Crystal Report
                </label>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="TxtNobags25">No. of Bags (25 kg)</label>
                    <input type="text" class="form-control" oninput="allowOnlyNumbers(this)" id="TxtNobags25">
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="TxtNobags500">No. of Bags (500 kg)</label>
                    <input type="text" class="form-control" oninput="allowOnlyNumbers(this)" id="TxtNobags500">
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="TxtNobags1000">No. of Bags (1000 kg)</label>
                    <input type="text" class="form-control" oninput="allowOnlyNumbers(this)" id="TxtNobags1000">
                </div>
            </div>
        </div>
        <div class="card">
            <div class="table-responsive">
                <table id="tblInHouseRMGEntry" class="table-width">
                    <thead class="table-head">
                        <tr>                            
                            <th>Weight Type</th>
                            <th>Weight</th>
                            <th>Get Weight</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>From Place</th>
                            <th>To Place</th>
                            <th>Item Name</th>
                            <th>Remarks</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <!-- Pagination container -->
            <div class="row">
                <div class="col-md-12">
                    <div class="pagination-end">
                        <div class="custom-pagination" id="tablePagination"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="offset-md-10 col-md-2">
                <div class="btn-last">
                    <button id="btn-save" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
                </div>
            </div>
        </div>
    </form>
</fieldset>  

<script src="~/js/GlobalFunction.js" asp-append-version="true"></script>


<script>
    var allFieldIds = [
        "TxtDocId",
        "ddlDocType",
        "NumDocNo",
        "DtDocDate",
        "ddlStatus",
        "ddlWeightType",
        "TxtVehicleNo",
        "TxtTareSlipNo",
        "TxtGrossSlipNo",
        "ChkCrystalReport",
        "TxtNobags25",
        "TxtNobags500",
        "TxtNobags1000"
    ];

    const itemRecords = [
        "TxtWgtType",
        "TxtWeight",
        "TxtDate",
        "TxtTime",
        "ddlFromPlace",
        "ddlToPlace",
        "TxtItemName",
        "TxtRemarks"
    ];

    let docId = "";
    let readOnly;

    function getQueryParam(param) {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(param);
    }

    // On DOM ready
    $(async function () {
        try {
            await GetDocTypeAsync();
            $('#ddlDocType').prop('selectedIndex', 0);
            handleDocLoad();
        } catch (error) {
            toastr.error('Failed to load document types: ' + error);
        }
    });

    $(document).ready(function () {
        GetGateEntryList();
        addItemRecordRow();
        setEnterKeyFocus(allFieldIds);

        $(".draggable-modal").draggable({
            handle: ".popup-header"
        });

        $('#ddlDocType').on('change', function () {
            const VType = $(this).val();
            if (VType) {
                GetDocid(VType);
            }
        });

        // Delete Row Logic (merged both handlers properly)
        $(document).on('click', '.btn-delete-action, .btn-Itemdelete-action', function () {
            const $tbody = $(this).closest('tbody');
            const $row = $(this).closest('tr');
            const rowCount = $tbody.find('tr').length;

            if (rowCount > 1) {
                const isLastRow = $row.is(':last-child');
                $row.remove();

                if (isLastRow) {
                    const $lastRow = $tbody.find('tr:last');
                    if ($lastRow.length && $lastRow.find('.btn-add-action').length === 0) {
                        $lastRow.find('td:last').prepend(
                            `<i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer;"></i>`
                        );
                    }
                }
            } else {
                alert('Cannot delete the first row.');
            }
        });

        // Add Row
        $(document).on('click', '.btn-add-row, .btn-add-action', function () {
            addItemRecordRow();
        });

        // On GateNo Change
        $('#ddlGateNo').on('change', function () {
            var gateNo = $(this).val();
            var selectedOption = $(this).find('option:selected');

            if (gateNo) {
                var partyCode = selectedOption.data('party');
                var Vno = selectedOption.data('vno');
                var partyName = selectedOption.data('partynm');
                ensureOption($('#DdlPartyName'), partyCode, partyName);
                $('#DdlPartyName').val(partyCode).trigger('change');
            } else {
                $('#DdlPartyName').val('');
            }
        });

        // Ensure dropdown option exists
        function ensureOption($dropdown, code, name) {
            if (code && $dropdown.find(`option[value="${code}"]`).length === 0) {
                $dropdown.append(`<option value="${code}">${name}</option>`);
            }
        }

    $('#tblInHouseRMGEntry').on('click', 'button[id^="BtnGetWeight"]', function (e) {
        e.preventDefault();

        const buttonId = $(this).attr('id');
        const rowNum = buttonId.replace('BtnGetWeight', '');

        let currentDate = new Date();
        let yyyy = currentDate.getFullYear();
        let mm = String(currentDate.getMonth() + 1).padStart(2, '0');
        let dd = String(currentDate.getDate()).padStart(2, '0');
        let hours = String(currentDate.getHours()).padStart(2, '0');
        let minutes = String(currentDate.getMinutes()).padStart(2, '0');

        let formattedDate = `${yyyy}-${mm}-${dd}`;
        let formattedTime = `${hours}:${minutes}`;

        $(`#TxtDate${rowNum}`).val(formattedDate);
        $(`#TxtTime${rowNum}`).val(formattedTime);
        // const formattedDateTime = getCurrentFormattedDateTime();
        // $(`#TxtDateTime${rowNum}`).val(formattedDateTime);
        $(`#TxtWeight${rowNum}`).val(0);

    });

        // Save or Update Button
        $('#btn-save').on('click', async function (e) {
            e.preventDefault();


        if (!validateRequiredField('#ddlDocType','Doc Type') ||
            !validateRequiredField('#NumDocNo','Doc No') ||
            !validateRequiredField('#TxtVehicleNo', 'Vehicle No') ||
            !validateRequiredField('#DtDocDate','Doc Date')) return;

        if (!validateBigWeighbridgeTable()) {
        return;
        }

            const $btn = $(this);
            $btn.prop('disabled', true);

            try {
                const tableData = await collectFormData();
                console.log(tableData);

                if (docId) {
                    UpdateData(tableData);
                } else {
                    SaveData(tableData);
                }
            } catch (error) {
                toastr.error('An error occurred while saving the data.');
            } finally {
                $btn.prop('disabled', false);
            }
        });
    });
</script>


