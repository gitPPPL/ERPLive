    async function collectItemsDetail() {
      const items = [];

      $('#tblInHouseRMGEntry tbody tr').each(function () {
        const idx = this.id.replace('row', '');
        const $r = $(this);

        const getVal = (field) => $r.find(`#${field}${idx}`).val();

        items.push({
          SNO: parseIntSafe(idx),

          TYPE: getVal('TxtWgtType'),
          WEIGHT: parseFloatSafe(getVal('TxtWeight')),
          WGT_DATE: toNullableDate(getVal('TxtDate')),
          WGT_TIME: getVal('TxtTime'),
          FROM_PLACE: parseIntSafe(getVal('ddlFromPlace')),
          TO_PLACE: parseIntSafe(getVal('ddlToPlace')),
          ITEM_NAME: getVal('TxtItemName'),
          REMARKS: getVal('TxtRemarks'),

          // Optional fields not mapped to any UI
          V_SHIFT: null,
          STATUS: null,
          Ref_type: null,
          Ref_no: null,
          FROM_NAME: null,
          TO_NAME: null,
          ITEM_CODE: null,
          wb_time: null,
          COND: null,
          MOIS_PER: null,
          MOIS_WT: null
        });
      });

      return items;
    }



    function safeSetDropdown(selector, value) {
        const $el = $(selector);
        if (!$el.length) {
            console.warn(`Element not found: ${selector}`);
            return;
        }

        const $option = $el.find(`option[value="${value}"]`);
        if ($option.length > 0) {
            $el.val(value).trigger('change');
        } else {
            console.warn(`Value '${value}' not found in dropdown: ${selector}`);
        }
    }

 
