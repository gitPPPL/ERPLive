@{
	ViewBag.Title = "In House Weighbridge Entry List";
	Layout = "~/Views/Shared/_Layout.cshtml";

	var currentMenu = ViewBag.CurrentMenu as string;

	bool canAdd = false;
	bool canEdit = false;
	bool canDelete = false;
	bool canPrint = false;
	bool canExport = false;
	bool canMail = false;
	bool canApproval = false;
	bool canDocDetail = false;

	foreach (var permission in Model.UserMenuPermissions)
	{
		if (permission.MENU_NAME == ViewBag.CurrentMenu)
		{
			canAdd = Model.UserLevel == 1 || permission._ADD == 1;
			canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
			canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
			canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
			canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
			canMail = Model.UserLevel == 1 || permission._MAIL == 1;
			canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
			canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
			break;
		}
	}
}



<fieldset>

	<legend class="legend-field">In House Weighbridge Entry List</legend>

	<div class="row">

		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text"
					   id="searchBox"
					   class="form-control"
					   placeholder="Search by All Columns Name..."
					   aria-label="Search term">
			</div>
		</div>

		<div class="col-lg-6">

			<div class="btn-rightalign">

				@if (canAdd)
				{
					<button onclick="window.location.href='@Url.Action("Index", "InHouseWeighbridgeEntry")'"
							type="button"
							class="btn btn-add">

						<i class="fa fa-plus"></i>Add
					</button>
				}

				@if (canPrint)
				{
					<button class="btn btn-print"
							onclick="printCityMasterReport()">

						<i class="fa fa-print"></i> Print
					</button>
				}

				@if (canExport)
				{
					<button class="btn btn-export"
							onclick="exportToExcel()">

						<i class="fas fa-file-export"></i> Export
					</button>
				}

				@if (canMail)
				{
					<button class="btn btn-mail"
							onclick="callGetReportAsPdf()">

						<i class="fa fa-envelope"></i> Mail
					</button>
				}

				@if (canApproval)
				{
					<button class="btn btn-approved">

						<i class="fa fa-check"></i> Approved
					</button>
				}

			</div>

		</div>

	</div>

	<div class="card">

		<div class="table-responsive">

			<table id="tblInHouseWeighbridgeList"
				   class="table-width">

				<thead class="table-head">

					<tr>
						<th style="display:none;">Code</th>
						<th>Doc Type</th>
						<th>Doc No</th>
						<th>Doc Date</th>
						<th>Weight Type</th>
						<th>Tare Slip No</th>
						<th>Vehicle No</th>
						<th>Gross Slip No</th>
						<th>Action</th>
					</tr>

				</thead>

				<tbody></tbody>

			</table>

		</div>

		<!-- PAGINATION -->

		<div class="erppagelist-pagination">

			<div class="pagination-left">

				<select id="pageSizeSelect"
						onchange="changeRowsPerPage()">

					<option value="5">5</option>
					<option value="10" selected>10</option>
					<option value="20">20</option>
					<option value="50">50</option>

				</select>

			</div>

			<div class="pagination-center">

				<button onclick="prevPage()"
						class="page-nav"
						id="prevBtn">

					‹
				</button>

				<div id="pageNumbers"
					 class="page-numbers">
				</div>

				<button onclick="nextPage()"
						class="page-nav"
						id="nextBtn">

					›
				</button>

			</div>

			<div class="pagination-right"
				 id="pageInfoText">

				Results: 0 - 0 of 0

			</div>

		</div>

	</div>

</fieldset>

<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<script src="~/js/GlobalFunction.js" asp-append-version="true"></script>
<script>

	var permissions = {
		canEdit: @canEdit.ToString().ToLower(),
		canDelete: @canDelete.ToString().ToLower(),
		canDocDetail: @canDocDetail.ToString().ToLower()
	};

	// ================= PAGINATION VARIABLES =================

	let currentPage = 1;
	let pageSize = 10;
	let totalCount = 0;

	// ================= DOCUMENT READY =================

	$(document).ready(function () {

		GetMasterDataList();

		$('#searchBox').on('keyup', function () {

			currentPage = 1;

			GetMasterDataList();
		});
	});

	// ================= LOAD DATA =================

	function GetMasterDataList() {
		const searchTerm = $('#searchBox').val().trim();
		$.ajax({
			url: '@Url.Action("GetInHouseWBridgeList", "InHouseWeighbridgeEntryList")',
			type: 'GET',
			dataType: 'json',
			data: {
				searchTerm: searchTerm,
				pageNumber: currentPage,
				pageSize: pageSize
			},
			success: function (res) {
				const mastListData = res.data || [];
				totalCount = res.totalCount || 0;
				let tbody = $('#tblInHouseWeighbridgeList tbody');
				tbody.empty();
				if (mastListData.length === 0) {
					tbody.append(`
						<tr>
							<td colspan="10"
								class="text-center text-muted">

								No Record Found.

							</td>
						</tr>
					`);
					renderPagination();
					return;
				}

				$.each(mastListData, function (index, item) {

					let actions = '';

					if (permissions.canEdit) {

						actions += `
							<i class="fa fa-edit btn-edit"
							   data-bs-toggle="tooltip"
							   title="Edit"
							   onclick="AddOrEditFunction('${item.DOC_ID}')">
							</i>`;
					}

					actions += `
						<i class="fas fa-eye btn-view"
						   data-bs-toggle="tooltip"
						   title="View"
						   onclick="viewMenuDetails('${item.DOC_ID}')">
						</i>`;

					if (permissions.canDelete) {

						actions += `
						<i class="fas fa-trash btn-delete"
						data-bs-toggle="tooltip"
						title="Delete"
						onclick="deleteItem('${item.DOC_ID}')">
						</i>`;
					}

					if (permissions.canDocDetail) {

						actions += `
							<i class="fa fa-file btn-document btn-details"
							   data-bs-toggle="tooltip"
							   title="Document Details"
							   onclick="showImpExpExpensePopup('${item.DOC_ID}')">
							</i>`;
					}

					tbody.append(`
						<tr>

							<td class="d-none code">${item.DOC_ID}</td>

							<td>${item.V_TYPE || ''}</td>

							<td>${item.V_NO || ''}</td>

							<td>${item.V_DATE || ''}</td>

							<td>${item.WB_TYPE || ''}</td>

							<td>${item.TARE_NO || ''}</td>

							<td>${item.VEHICLE_NO || ''}</td>

							<td>${item.GROSS_NO || ''}</td>

							<td>${actions}</td>

						</tr>
					`);
				});

				renderPagination();
			},

			error: function (xhr) {

				toastr.error(
					'Error loading list: ' + xhr.responseText
				);
			}
		});
	}

	// ================= PAGINATION =================

	function renderPagination() {

		const totalPages = Math.ceil(totalCount / pageSize) || 1;

		let html = '';

		let maxVisible = 5;

		let startPage = Math.max(
			1,
			currentPage - Math.floor(maxVisible / 2)
		);

		let endPage = startPage + maxVisible - 1;

		if (endPage > totalPages) {

			endPage = totalPages;

			startPage = Math.max(
				1,
				endPage - maxVisible + 1
			);
		}

		if (startPage > 1) {

			html += `
				<span class="page-number"
					  onclick="goToPage(1)">
					  1
				</span>`;

			if (startPage > 2) {

				html += `
					<span class="dots">...</span>`;
			}
		}

		for (let i = startPage; i <= endPage; i++) {

			html += `
				<span class="page-number ${i === currentPage ? 'active' : ''}"
					  onclick="goToPage(${i})">
					  ${i}
				</span>`;
		}

		if (endPage < totalPages) {

			if (endPage < totalPages - 1) {

				html += `
					<span class="dots">...</span>`;
			}

			html += `
				<span class="page-number"
					  onclick="goToPage(${totalPages})">
					  ${totalPages}
				</span>`;
		}

		$('#pageNumbers').html(html);

		let start = (currentPage - 1) * pageSize + 1;

		let end = Math.min(currentPage * pageSize, totalCount);

		if (totalCount === 0) {

			start = 0;
			end = 0;
		}

		$('#pageInfoText').text(
			`Results: ${start} - ${end} of ${totalCount}`
		);

		$('#prevBtn').prop(
			'disabled',
			currentPage === 1
		);

		$('#nextBtn').prop(
			'disabled',
			currentPage === totalPages
		);
	}

	function prevPage() {
		if (currentPage > 1) {
			currentPage--;
			GetMasterDataList();
		}
	}

	function nextPage() {
		const totalPages = Math.ceil(totalCount / pageSize);
		if (currentPage < totalPages) {
			currentPage++;
			GetMasterDataList();
		}
	}

	function goToPage(page) {
		currentPage = page;
		GetMasterDataList();
	}

	function changeRowsPerPage() {
		pageSize = parseInt(
			$('#pageSizeSelect').val()
		);
		currentPage = 1;
		GetMasterDataList();
	}

	// ================= ACTIONS =================

	function AddOrEditFunction(rowId) {
		window.location.href = '/InHouseWeighbridgeEntry/Index?id=' + encodeURIComponent(rowId);
	}

	function viewMenuDetails(rowId) {
		window.location.href = '/InHouseWeighbridgeEntry/Index?id=' + encodeURIComponent(rowId) + '&readOnly=true';
	}

	function deleteItem(docId) {
		Swal.fire({
			title: "Delete?",
			text: "Are you sure?",
			icon: "warning",
			showCancelButton: true
		}).then(r => {
			if (r.isConfirmed) {
				$.ajax({
					url: '/InHouseWeighbridgeEntryList/DeleteInHouseWBridgeEntry',
					type: 'DELETE',
					data: { docid: docId },
				    success: function (res) {

					if (res.status) {
						toastr.success(res.message);
						GetMasterDataList();
					}
					else {
						toastr.error(res.message);
					}
				},

				error: function () {
				toastr.error("Something went wrong");
				}
				});

			}
		});
	}

	// ================= EXPORT =================
	function exportToExcel() {

		fetch('/InHouseWeighbridgeEntryList/ExportAllDocs')

			.then(response => {

				if (!response.ok)
					throw new Error("Network response was not ok");

				return response.json();
			})

			.then(responseData => {

				if (!responseData.status) {

					toastr.error("Failed to fetch data.");

					return;
				}

				const dataArray = responseData.data;

				if (!Array.isArray(dataArray) || dataArray.length === 0) {

					toastr.warning("No data available to export.");

					return;
				}

				const worksheet = XLSX.utils.json_to_sheet(
					dataArray,
					{ header: Object.keys(dataArray[0]) }
				);

				const workbook = XLSX.utils.book_new();

				XLSX.utils.book_append_sheet(
					workbook,
					worksheet,
					"AllDocs"
				);

				const now = new Date();

				const fileName =
					`StoreWeighBridge_${now.getTime()}.xlsx`;

				XLSX.writeFile(workbook, fileName);
			})

			.catch(error => {

				console.error(error);

				toastr.error("Failed to export data.");
			});
	}
	// ================= DOCUMENT POPUP =================
	function showImpExpExpensePopup(docCode) {

		$.ajax({

			url: '/InHouseWeighbridgeEntryList/GetInHouseWBridgeEntryDetails',

			type: 'GET',

			dataType: 'json',

			data: { docid: docCode },

			success: function (response) {

				if (response.status) {

					showDocumentPopupjQuery(
						response.data,
						docCode
					);

				} else {

					toastr.error(
						"Failed to get document details."
					);
				}
			},

			error: function () {

				toastr.error(
					"An error occurred while fetching document details."
				);
			}
		});
	}
</script>