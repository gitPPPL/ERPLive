@{
    ViewBag.Title = "In House Weighbridge Entry List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentMenu = ViewBag.CurrentMenu as string;
    bool canAdd = false;
    bool canEdit = false;
    bool canDelete = false;
    bool canPrint = false;
    bool canExport = false;
    bool canMail = false;
    bool canApproval = false;
    bool canDocDetail = false;

	foreach (var permission in Model.UserMenuPermissions)
	{
		if (permission.MENU_NAME == ViewBag.CurrentMenu)
		{
			canAdd = Model.UserLevel == 1 || permission._ADD == 1;
			canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
			canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
			canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
			canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
			canMail = Model.UserLevel == 1 || permission._MAIL == 1;
			canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
			canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
			break;
		}
	}
}

<div id="erp-center-toast-container"></div>
<!-- HEADER -->
<div class="erppagelist-header">
	<div class="erppagelist-title">
		<i class="fa fa-list"></i>
		<span>In House Weighbridge Entry List</span>
	</div>
	<div class="erppagelist-header-right">
		@if (canAdd)
		{
			<button class="erppage-header-back" onclick="location.href='@Url.Action("Index", "InHouseWeighbridgeEntry")'">
				<i class="fa fa-plus"></i>Add New
			</button>
		}
	</div>
</div>
<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
	<div class="erppagelist-search-wrapper">
		<i class="fa fa-search"></i>
		<input type="text" id="searchBox" placeholder="Search by All Columns Name...." />
	</div>
	<div class="erppagelist-actions">
		@if (canPrint)
		{
			<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" id="btn_Report">
				<i class="fa fa-print"></i>Print
			</button>
		}
		@if (canExport)
		{
			<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" id="btn_exportPdf" data-tooltip="Export to Excel">
				<i class="fa fa-file-excel"></i>Export
			</button>
		}
		@if (canMail)
		{
			<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail" onclick="callGetReportAsPdf()">
				<i class="fa fa-envelope"></i>Mail
			</button>
		}
		@if (canApproval)
		{

			<button class="erppagelist-btn erppagelist-btn-approve tooltip-btn" data-tooltip="Approve Records">
				<i class="fa fa-check-circle"></i>Approved
			</button>
		}
	</div>
</div>
<div class="erppagelist-container">
	<div class="excel-wrapper fixed-grid-wrapper">
		<table id="tblInHouseWeighbridgeList" class="excel-table fixed-grid-table">
			<colgroup>
				<col style="display:none;" />      
				<col style="width:140px;" /> 
				<col style="width:140px;" />   
				<col style="width:150px;" />    
				<col style="width:140px;" />  
				<col style="width:140px;" />      
				<col style="width:150px;" />    
				<col style="width:150px;" />     
				<col style="width:120px;" />     
			</colgroup>
			<thead>
				<tr>
					<th style="display:none;">Code</th>
					<th>Document Type</th>
					<th>Document No</th>
					<th>Document Date</th>
					<th>Weight Type</th>
					<th>Tare Slip No</th>
					<th>Vehicle No</th>
					<th>Gross Slip No</th>
					<th class="action-col">Action</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>

	</div>

	<div class="erppagelist-pagination">
		<div class="pagination-left">
			<select id="pageSizeSelect" onchange="changeRowsPerPage()">
				<option value="5">5</option>
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
			</select>
		</div>
		<div class="pagination-center">
			<button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
			<div id="pageNumbers" class="page-numbers"></div>

			<button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
		</div>
		<div class="pagination-right" id="pageInfoText">
			Results: 0 - 0 of 0
		</div>
	</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<script src="~/js/GlobalFunction.js" asp-append-version="true"></script>
<script>

	var permissions = {
		canEdit: @canEdit.ToString().ToLower(),
		canDelete: @canDelete.ToString().ToLower(),
		canDocDetail: @canDocDetail.ToString().ToLower()
	};

	let currentPage = 1;
	let pageSize = 10;
	let totalCount = 0;

	$(document).ready(function () {

		GetMasterDataList();

		$('#searchBox').on('keyup', function () {
			currentPage = 1;
			GetMasterDataList();
		});

		$('#btn_exportPdf').on('click', function () {
			var text = $('#searchBox').val();
			window.location.href = '/InHouseWeighbridgeEntry/ExportToExcel?searchTerm=' + encodeURIComponent(text);
		});

		$('#btn_Report').on('click', function () {
			var text = $('#searchBox').val();
			window.open('/InHouseWeighbridgeEntry/ExportToPdf?searchTerm=' + encodeURIComponent(text), '_blank');
		});
	});

	function GetMasterDataList() {
		const searchTerm = $('#searchBox').val().trim();
		$.ajax({
			url: '@Url.Action("GetInHouseWBridgeList", "InHouseWeighbridgeEntryList")',
			type: 'GET',
			dataType: 'json',
			data: {
				searchTerm: searchTerm,
				pageNumber: currentPage,
				pageSize: pageSize
			},
			success: function (res) {
				const mastListData = res.data || [];
				totalCount = res.totalCount || 0;
				let tbody = $('#tblInHouseWeighbridgeList tbody');
				tbody.empty();
				if (mastListData.length === 0) {
					tbody.append(`
						<tr>
							<td colspan="10"
								class="text-center text-muted">

								No Record Found.

							</td>
						</tr>
					`);
					renderPagination();
					return;
				}

				$.each(mastListData, function (index, item) {

					let actions = '';

					if (permissions.canEdit) {

						actions += `<button class="act-btn edit btn-edit" title="Edit" data-bs-toggle="tooltip" onclick="AddOrEditFunction('${item.DOC_ID}')"><i class="fa fa-edit"></i></button>`;
					}

					actions += `<button class="act-btn view btn-view" title="View" data-bs-toggle="tooltip" onclick="viewMenuDetails('${item.DOC_ID}')"><i class="fa fa-eye"></i></button>`;

					if (permissions.canDelete) {

						actions += `<button class="act-btn delete btn-delete" data-bs-toggle="tooltip" title="Delete" onclick="deleteItem('${item.DOC_ID}')"><i class="fa fa-trash"></i></button>`;
					}

					if (permissions.canDocDetail) {

						actions += `<button class="act-btn document  btn-document btn-details"  data-bs-toggle="tooltip"  title="Document Details" onclick="showImpExpExpensePopup('${item.DOC_ID}')"><i class="fa fa-file"></i></button>
							`;
					}

					tbody.append(`
						<tr>

							<td class="d-none code">${item.DOC_ID}</td>

							<td>${item.V_TYPE || ''}</td>

							<td>${item.V_NO || ''}</td>

							<td>${item.V_DATE || ''}</td>

							<td>${item.WB_TYPE || ''}</td>

							<td>${item.TARE_NO || ''}</td>

							<td>${item.VEHICLE_NO || ''}</td>

							<td>${item.GROSS_NO || ''}</td>

							<td>${actions}</td>

						</tr>
					`);
				});

				renderPagination();
			},

			error: function (xhr) {

				toastr.error(
					'Error loading list: ' + xhr.responseText
				);
			}
		});
	}

	function renderPagination() {

		const totalPages = Math.ceil(totalCount / pageSize) || 1;

		let html = '';

		let maxVisible = 5;

		let startPage = Math.max(
			1,
			currentPage - Math.floor(maxVisible / 2)
		);

		let endPage = startPage + maxVisible - 1;

		if (endPage > totalPages) {

			endPage = totalPages;

			startPage = Math.max(
				1,
				endPage - maxVisible + 1
			);
		}

		if (startPage > 1) {

			html += `
				<span class="page-number"
					  onclick="goToPage(1)">
					  1
				</span>`;

			if (startPage > 2) {

				html += `
					<span class="dots">...</span>`;
			}
		}

		for (let i = startPage; i <= endPage; i++) {

			html += `
				<span class="page-number ${i === currentPage ? 'active' : ''}"
					  onclick="goToPage(${i})">
					  ${i}
				</span>`;
		}

		if (endPage < totalPages) {

			if (endPage < totalPages - 1) {

				html += `
					<span class="dots">...</span>`;
			}

			html += `
				<span class="page-number"
					  onclick="goToPage(${totalPages})">
					  ${totalPages}
				</span>`;
		}

		$('#pageNumbers').html(html);

		let start = (currentPage - 1) * pageSize + 1;

		let end = Math.min(currentPage * pageSize, totalCount);

		if (totalCount === 0) {

			start = 0;
			end = 0;
		}

		$('#pageInfoText').text(
			`Results: ${start} - ${end} of ${totalCount}`
		);

		$('#prevBtn').prop(
			'disabled',
			currentPage === 1
		);

		$('#nextBtn').prop(
			'disabled',
			currentPage === totalPages
		);
	}

	function prevPage() {
		if (currentPage > 1) {
			currentPage--;
			GetMasterDataList();
		}
	}

	function nextPage() {
		const totalPages = Math.ceil(totalCount / pageSize);
		if (currentPage < totalPages) {
			currentPage++;
			GetMasterDataList();
		}
	}

	function goToPage(page) {
		currentPage = page;
		GetMasterDataList();
	}

	function changeRowsPerPage() {
		pageSize = parseInt(
			$('#pageSizeSelect').val()
		);
		currentPage = 1;
		GetMasterDataList();
	}

	function AddOrEditFunction(rowId) {
		window.location.href = '/InHouseWeighbridgeEntry/Index?id=' + encodeURIComponent(rowId);
	}

	function viewMenuDetails(rowId) {
		window.location.href = '/InHouseWeighbridgeEntry/Index?id=' + encodeURIComponent(rowId) + '&readOnly=true';
	}

	function deleteItem(docId) {
		Swal.fire({
			title: "Delete?",
			text: "Are you sure?",
			icon: "warning",
			showCancelButton: true
		}).then(r => {
			if (r.isConfirmed) {
				$.ajax({
					url: '/InHouseWeighbridgeEntryList/DeleteInHouseWBridgeEntry',
					type: 'DELETE',
					data: { docid: docId },
				    success: function (res) {

					if (res.status) {
						toastr.success(res.message);
						GetMasterDataList();
					}
					else {
						toastr.error(res.message);
					}
				},

				error: function () {
				toastr.error("Something went wrong");
				}
				});

			}
		});
	}

	function showImpExpExpensePopup(docCode) {

		$.ajax({

			url: '/InHouseWeighbridgeEntryList/GetInHouseWBridgeEntryDetails',

			type: 'GET',

			dataType: 'json',

			data: { docid: docCode },

			success: function (response) {

				if (response.status) {

					showDocumentPopupjQuery(
						response.data,
						docCode
					);

				} else {

					toastr.error(
						"Failed to get document details."
					);
				}
			},

			error: function () {

				toastr.error(
					"An error occurred while fetching document details."
				);
			}
		});
	}

</script>