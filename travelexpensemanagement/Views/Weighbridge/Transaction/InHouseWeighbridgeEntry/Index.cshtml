@{
    ViewBag.Title = "In House Weighbridge Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
    <legend class="legend-field">In House Weighbridge Entry</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button onclick="window.location.href='@Url.Action("Index", "InHouseWeighbridgeEntryList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>
    <form id="InHouseWeighbridgeEntryForm">
        <input type="hidden" class="form-control" id="TxtDocId" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlDocType">Doc Type</label>
                    <select class="form-control" id="ddlDocType">
                        @* <option>--Select DOC Type--</option> *@
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumDocNo">Doc No <span class="required">*</span></label>
                    <input type="number" class="form-control" id="NumDocNo" placeholder="Enter Doc No" readonly>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DtDocDate">Doc Date <span class="required">*</span></label>
                    <input type="date" class="form-control" id="DtDocDate">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlStatus">Status</label>
                    <select class="form-control" id="ddlStatus">
                        <option value="1">Open</option>
                        <option value="0">Close</option>
                        <option value="2">Cancel</option>

                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlWeightType">Weight Type <span class="required">*</span></label>
                    <select class="form-control" id="ddlWeightType">                    
                        <option value="Gross">Gross</option>
                        <option value="Tare">Tare</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtVehicleNo">Vehicle No <span class="required">*</span></label>
                    <input type="text" class="form-control" maxlength="20" id="TxtVehicleNo" placeholder="Enter Vehicle No">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlTareSlipNo">Tare Slip No</label>
                    <select id="ddlTareSlipNo" class="form-control">
                        <option>-select Tare Slip No.-</option>
                    </select>

                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlGrossSlipNo">Gross Slip No</label>
                    <select id="ddlGrossSlipNo" class="form-control">
                        <option>-select Gross Slip No.-</option>
                    </select>
      
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <label class="checkbox-input-mx">
                    <input type="checkbox" id="ChkCrystalReport" />
                    Crystal Report
                </label>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtNobags25">No. of Bags (25 Kg)</label>
                    <input type="text" maxlength="8" oninput="allowOnlyNumbers(this)" class="form-control" id="TxtNobags25">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtNobags500">No. of Bags (500 Kg)</label>
                    <input type="text" maxlength="8" oninput="allowOnlyNumbers(this)" class="form-control" id="TxtNobags500">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtNobags1000">No. of Bags (1000 Kg)</label>
                    <input type="text" maxlength="8" oninput="allowOnlyNumbers(this)" class="form-control" id="TxtNobags1000">
                </div>
            </div>
        </div>
        <div class="card">
            <div class="table-responsive">
                <table id="tblInHouseWeighbridgeEntry" class="table-width">
                    <thead class="table-head">
                        <tr>                           
                            <th>Wgt Type</th>
                            <th>Weight</th>
                            <th>Get Weight</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>From Place</th>
                            <th>To Place</th>
                            <th>Item Name</th>
                            <th>Remarks</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <!-- Pagination container -->
            <div class="row">
                <div class="col-md-12">
                    <div class="pagination-end">
                        <div class="custom-pagination" id="tablePagination"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="offset-md-10 col-md-2">
                <div class="btn-last">
                    <button id="btn-save" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
                </div>
            </div>
        </div>
    </form>
</fieldset>

<script src="~/js/GlobalFunction.js" asp-append-version="true"></script>

<script>
    var allFieldIds = [
        "TxtDocId",
        "ddlDocType",
        "NumDocNo",
        "DtDocDate",
        "ddlStatus",
        "ddlWeightType",
        "TxtVehicleNo",
        "ddlTareSlipNo",
        "ddlGrossSlipNo",
        "ChkCrystalReport",
        "TxtNobags25",
        "TxtNobags500",
        "TxtNobags1000"
    ];
    const itemRecords = [
        "TxtWgtType",
        "TxtWeight",
        "TxtDate",
        "TxtTime",
        "ddlFromPlace",
        "ddlToPlace",
        "TxtItemName",
        "TxtRemarks"
    ];
    const fieldsToToggle = [
            '#ddlTareSlipNo',
            '#ddlGrossSlipNo',
            '#TxtNobags25',
            '#TxtNobags500',
            '#TxtNobags1000'
     ];
    let docId = "";
    let readOnly;
    let isProgrammaticChange = false;
    let isFillingData = false;        
    $(document).ready(function () {

        setEnterKeyFocus(allFieldIds);

        $(".draggable-modal").draggable({
            handle: ".popup-header"
        });

        $('#ddlDocType').on('change', function () {
            const VType = $(this).val();
            if (VType) {
                GetDocid(VType);
            }
        });
                  
        $(document).on('click', '.btn-delete-action, .btn-Itemdelete-action', function () {
            var tbody = $(this).closest('tbody');
            var rowCount = tbody.find('tr').length;
            if (rowCount > 1) {
                $(this).closest('tr').remove();
            } else {
                toastr.warning('Cannot delete the first row.');
            }
        });

        $(document).on('click', '.btn-add-row, .btn-add-action', function () {
            var wbType = $('#ddlWeightType').val();
            var rowCount = $('#tblInHouseWeighbridgeEntry tbody tr').length;

            if (wbType === 'Tare') {
                toastr.warning('Cannot add more rows for Tare.');
                return;
            } else if (wbType === 'Gross') {
                if (rowCount >= 2) {
                    toastr.warning('Cannot add more than 2 rows for Gross.');
                    return;
                }
            }
            addItemRecordRow();
           const $wgtType = $('#TxtWgtType2');
           if ($wgtType.length) {
            $wgtType.val('Gross');
            $wgtType.prop('readonly', true);
           }
        });            

        $('#tblInHouseWeighbridgeEntry').on('click', 'button[id^="BtnGetWeight"]', function (e) {
            e.preventDefault();

            const buttonId = $(this).attr('id');
            const rowNum = buttonId.replace('BtnGetWeight', '');

            let currentDate = new Date();
            let yyyy = currentDate.getFullYear();
            let mm = String(currentDate.getMonth() + 1).padStart(2, '0');
            let dd = String(currentDate.getDate()).padStart(2, '0');
            let hours = String(currentDate.getHours()).padStart(2, '0');
            let minutes = String(currentDate.getMinutes()).padStart(2, '0');

            let formattedDate = `${yyyy}-${mm}-${dd}`;
            let formattedTime = `${hours}:${minutes}`;

            $(`#TxtDate${rowNum}`).val(formattedDate);
            $(`#TxtTime${rowNum}`).val(formattedTime);
            $(`#TxtWeight${rowNum}`).val(0);
        
        });

        $('#ddlWeightType').change(function () {            
            toggleReadOnly();         
        });

        $('#ddlTareSlipNo').on('select2:select', async function (e) {
            if (isFillingData) return;
            if (isProgrammaticChange) return;
            var SlipNo=$(this).val();  
            var vType = $(this).find("option:selected").text().split(' - ')[1];       
           isProgrammaticChange = true;
           $('#ddlGrossSlipNo').prop('selectedIndex', 0).change();
           isProgrammaticChange = false;
           await fillTableBySlipNo(SlipNo, vType);
           const $wgtType = $('#TxtWgtType2');
           if ($wgtType.length) {
            $wgtType.val('Gross');
            $wgtType.prop('readonly', true);
           }

      });

        $('#ddlGrossSlipNo').on('select2:select', async function (e) {
            if (isFillingData) return;
            if (isProgrammaticChange) return;
            var SlipNo=$(this).val();
            var vType=$(this).find("option:selected").text().split(' - ')[1];   
       
           isProgrammaticChange = true;
           $('#ddlTareSlipNo').prop('selectedIndex', 0).change();
           isProgrammaticChange = false;

           await fillTableByGrossSlipNo(SlipNo, vType);
           addItemRecordRow();
           const $wgtType = $('#TxtWgtType2');
           if ($wgtType.length) {
            $wgtType.val('Gross');
            $wgtType.prop('readonly', true);
           }

         });

        $('#btn-save').on('click', async function (e) {
            e.preventDefault();
                   

        if (!validateRequiredField('#ddlDocType','Doc Type') ||
            !validateRequiredField('#NumDocNo','Doc No') ||
            !validateRequiredField('#TxtVehicleNo', 'Vehicle No') ||
            !validateRequiredField('#DtDocDate','Doc Date')) return;
         
            if (!validateBigWeighbridgeTable()) {
             return;
            }
            const isValid = await checkValidDate();
            if (isValid === false) {
            return;
            }

            const $btn = $(this);
            $btn.prop('disabled', true);

            try {
                const tableData = await collectFormData();
                
                if (docId) {
                    UpdateData(tableData);
                } else {
                    SaveData(tableData);
                }
            } catch (error) {
                toastr.error('An error occurred while saving the data.');
            } finally {
                $btn.prop('disabled', false);
            }
        });

        $(async function () {
            try {
                await GetDocTypeAsync();
                $('#ddlDocType').prop('selectedIndex', 0);
                handleDocLoad();
            } catch (error) {
                toastr.error('Failed to load document types: ' + error);
            }
        });

        $('#ddlTareSlipNo').select2({
             placeholder: "-Select Tare Slip No.-",
             allowClear: true,
             width: '100%'
         });

        $('#ddlGrossSlipNo').select2({
             placeholder: "-Select Gross Slip No.-",
             allowClear: true,
             width: '100%'
         });

         getTareSlipNumbers();
         getGrossSlipNumbers();


    });
</script>

<script>

    function getQueryParam(param) {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(param);
     }

      async function fillTableBySlipNo(slipNo, vType) {
        try {
            const response = await $.ajax({
                url: "@Url.Action("GetWeighBridgeBySlipNo", "InHouseWeighbridgeEntry")",
                type: 'GET',
                data: { SlipNo: slipNo, vType: vType },
                dataType: 'json'
            });

      
            let itemsData = response.data || [];       
            let headerData = itemsData.length > 0 ? itemsData[0] : null;
   
            const $tableBody = $('#tblInHouseWeighbridgeEntry tbody');
            $tableBody.empty();

              $('#TxtVehicleNo').val(headerData.VEHICLE_NO);


            if (itemsData.length === 0) {
                console.log("No data found");
                return;
            }

            for (let index = 0; index < itemsData.length; index++) {

                const item = itemsData[index];
                const idx = index + 1;      
                 addItemRecordRow();
                await bindDropdownData(idx);
                $(`#TxtWeight${idx}`).val(item.WEIGHT ?? '');
                $(`#TxtDate${idx}`).val( item.WGT_DATE  ? item.WGT_DATE.substring(0, 10)  : '' );
                $(`#TxtWgtType${idx}`).val(item.TYPE ?? '');
                $(`#TxtItemName${idx}`)
                .val(item.ITEM_CODE ?? '')
                .trigger('change');

                $(`#ddlFromPlace${idx}`)
                .val(item.FROM_PLACE ?? '')
                .trigger('change');

                $(`#ddlToPlace${idx}`)
                .val(item.TO_PLACE ?? '')
                .trigger('change');
                $(`#TxtRemarks${idx}`).val(item.REMARKS ?? '');
                const formattedTime = convertTo24HourFormat(item.WGT_TIME ?? '');
                $(`#TxtTime${idx}`).val(formattedTime);
                $(`#ddlFromPlace${idx}`).prop('disabled', true);
                $(`#ddlToPlace${idx}`).prop('disabled', true);
                $(`#TxtItemName${idx}`).prop('disabled', true);
                $(`#TxtDate${idx}`).prop('readonly', true);
                $(`#TxtTime${idx}`).prop('readonly', true);
                $(`#TxtWeight${idx}`).prop('readonly', true);
                $(`#TxtWgtType${idx}`).prop('readonly', true);
                $(`#TxtRemarks${idx}`).prop('readonly', true);
                $(`#BtnGetWeight${idx}`).prop('disabled', true);
            }

        } catch (error) {

            console.error("Error fetching weighbridge slip data:", error);
        }
    }

    async function fillTableByGrossSlipNo(slipNo, vType){
          try {
               const response = await $.ajax({
                     url: "@Url.Action("GetWeighBridgeByGrossSlipNo", "InHouseWeighbridgeEntry")",
                   type: 'GET',
                   data: { SlipNo: slipNo, vType:vType },
                   dataType: 'json'
               });

               var $table = $('#tblInHouseWeighbridgeEntry tbody');
               $table.empty();
               var itemsData = response.data || [];
              let headerData = itemsData.length > 0 ? itemsData[0] : null;
                   
                $('#TxtVehicleNo').val(headerData.VEHICLE_NO);

               for (let index = 0; index < itemsData.length; index++) {
                   const item = itemsData[index];
                   const idx = index + 1;
                   addItemRecordRow();
                   await bindDropdownData(idx);
                   $(`#TxtWeight${idx}`).val(item.WEIGHT ?? "");
                   $(`#TxtDate${idx}`).val((item.WGT_DATE || '').substring(0, 10));
                   $(`#TxtWgtType${idx}`).val('Tare');
                   $(`#TxtItemName${idx}`).val(item.ITEM_NAME ?? "");
                   $(`#ddlFromPlace${idx}`).val(item.FROM_NAME ?? "");
                   $(`#ddlToPlace${idx}`).val(item.TO_NAME ?? "");
                   $(`#TxtRemarks${idx}`).val(item.REMARKS ?? "");
                   const formattedTime = convertTo24HourFormat(item.WGT_TIME ?? ""); $(`#TxtTime${idx}`).val(formattedTime);
               $(`#ddlFromPlace${idx}`).prop('disabled', true);
               $(`#ddlToPlace${idx}`).prop('disabled', true);
               $(`#TxtItemName${idx}`).prop('disabled', true);
               $(`#TxtDate${idx}`).prop('readOnly', true);
               $(`#TxtTime${idx}`).prop('readOnly', true);
               $(`#TxtWeight${idx}`).prop('readOnly', true);
               $(`#TxtWgtType${idx}`).prop('readOnly', true);
               $(`#TxtRemarks${idx}`).prop('readOnly', true);
               $(`#BtnGetWeight${idx}`).prop('disabled', true);

               }


          } catch (error) {
            console.error("Error fetching weighbridge slip data:", error);
          }
   }

    function getTareSlipNumbers() {

        $.ajax({
            url: "@Url.Action("GetTareSlipNo", "InHouseWeighbridgeEntry")",
            type: 'GET',
            dataType: 'json',

            success: function (response) {
                var $Tare = $('#ddlTareSlipNo');
                $Tare.empty();
                $Tare.append('<option value="">-Select Tare Slip No.-</option>');
                $.each(response, function (index, item) {
                    $Tare.append(
                        `<option value="${item.value}">
                            ${item.value} - ${item.text}
                        </option>`
                    );
                });
     
                $Tare.trigger('change');
            },

            error: function (xhr, error) {
                console.error("Error fetching tare slip numbers:", error);
            }
        });
    }

    function getGrossSlipNumbers() {

        $.ajax({
            url: "@Url.Action("GetGrossSlipNo", "InHouseWeighbridgeEntry")",
            type: 'GET',
            dataType: 'json',

            success: function (response) {

                var $Gross = $('#ddlGrossSlipNo');

                $Gross.empty();

                $Gross.append('<option value="">-Select Gross Slip No.-</option>');

                $.each(response, function (index, item) {

                    $Gross.append(
                        `<option value="${item.value}">
                            ${item.value} - ${item.text}
                        </option>`
                    );
                });

                $Gross.trigger('change');
            },

            error: function (xhr, error) {
                console.error("Error fetching Gross slip numbers:", error);
            }
        });
    }

    function toggleReadOnly() {
        const wbType = $('#ddlWeightType').val();       
        if (wbType === 'Tare') {           
            fieldsToToggle.forEach(selector => {
                const $el = $(selector);
                $el.val('');
                if ($el.is('select')) {
                    $el.prop('disabled', true);
                } else {
                    $el.prop('readonly', true);
                }
            });

            if (docId) return;
            $('#tblInHouseWeighbridgeEntry tbody').empty();
            addItemRecordRow();

            $('#tblInHouseWeighbridgeEntry tbody tr').each(function () {
                const rowId = this.id;
                const idx = rowId.replace('row', '');
                const $wgtType = $(`#TxtWgtType${idx}`);
                if ($wgtType.length) {
                    $wgtType.val('Tare');
                    $wgtType.prop('readonly', true);
                }
            });           

        } else {           
            fieldsToToggle.forEach(selector => {
                const $el = $(selector);

                if ($el.is('select')) {
                    $el.prop('disabled', false);
                } else {
                    $el.prop('readonly', false);
                }
            });

            $('#tblInHouseWeighbridgeEntry tbody').empty();

            if (wbType === 'Gross') {
                getTareSlipNumbers();
                getGrossSlipNumbers();              
            }
        }
    }

    function validateBigWeighbridgeTable() {  
        let rowCount = 0;
            const wbType = $('#ddlWeightType').val();
        $('#tblInHouseWeighbridgeEntry tbody tr').each(function (i) {
            const idx = this.id.replace('row', '');
            const weight = parseFloat($(`#TxtWeight${idx}`).val()) || 0;
            const fromPlace = $(`#ddlFromPlace${idx}`).val() || '';
            const toPlace = $(`#ddlToPlace${idx}`).val() || '';
            const itemCode = $(`#TxtItemName${idx}`).val() || '';
            const itemName = $(`#TxtItemName${idx} option:selected`).text() || '';
            const date = $(`#TxtDate${idx}`).val() || '';

            if (weight > 0) {
                rowCount++;
            }


            if (wbType === 'Gross' && i > 0) {

                // From Place empty
                if (weight > 0 && !fromPlace) {
                    toastr.error( `From Place is empty of Item ${itemName}` );
                    $(`#ddlFromPlace${idx}`).focus();
                    return false;
                }

                // To Place empty
                if (weight > 0 && !toPlace) {
                    toastr.error(  `To Place is empty of Item ${itemName}` );
                    $(`#ddlToPlace${idx}`).focus();
                    return false;
                }

                // From and To same
                if (
                    fromPlace &&
                    toPlace &&
                    fromPlace === toPlace
                ) {

                    toastr.error( `From Place and To Place cannot be same of Item ${itemName}` );

                    $(`#ddlFromPlace${idx}`).focus();
                    return false;
                }

                // Item empty
                if (weight > 0 && !itemCode) {

                    toastr.error(
                        `Item Code not valid of Item ${itemName}`
                    );

                    $(`#TxtItemName${idx}`).focus();

                    return false;
                }

                // Date empty
                if (weight > 0 && !date) {

                    toastr.error(
                        `Date is empty of Item ${itemName}`
                    );

                    $(`#TxtDate${idx}`).focus();

                    return false;
                }
            }
        });

        // At least one row check
        if (rowCount === 0) {

            toastr.error('Please enter at least one row.');

            return false;
        }

        return true;
    }

    function GetDocTypeAsync(selectedValue) {
          return new Promise((resolve, reject) => {
              $.ajax({
                  url: '@Url.Action("GetDocType", "InHouseWeighbridgeEntry")',
                  type: 'GET',
                  dataType: 'json',
                  success: function (response) {
                      if (response.status) {
                          const $dropdown = $('#ddlDocType');
                          $dropdown.empty();

                          $.each(response.data, function (index, item) {
                              $dropdown.append(`<option value="${item.CODE}">${item.NAME}</option>`);
                          });

                          if (selectedValue && $dropdown.find(`option[value="${selectedValue}"]`).length > 0) {
                              $dropdown.val(selectedValue).trigger('change');
                          } else {
                              $dropdown.prop('selectedIndex', 0);
                          }

                          resolve();
                      } else {
                          reject("Invalid response status.");
                      }
                  },
                  error: function (xhr, status, error) {
                      toastr.error("Document Type Load failed: " + error);
                      reject(error);
                  }
              });
          });
    }

    async function handleDocLoad() {
             docId = getQueryParam('id');
             readOnly = getQueryParam('readOnly');
            if (docId) {                
                $('#ddlDocType').prop('disabled', true);
                await GetDocData(docId, readOnly);
            } else {
                const Vtype = $('#ddlDocType').val(); 
                if(Vtype)
                {
                  GetDocid(Vtype);
                }
                const today = new Date();
                const todayDate = today.getFullYear() + '-' +
                    (today.getMonth() + 1).toString().padStart(2, '0') + '-' +
                    today.getDate().toString().padStart(2, '0');
                // $('#DtDocDate').val(todayDate.toISOString());
                 $('#DtDocDate').val(todayDate);
                 toggleReadOnly();
            }
    }

    function SaveData(saveDt) {
        $.ajax({
            url: '@Url.Action("SaveOrUpdateInHouseWeighBridgeEntry", "InHouseWeighbridgeEntry")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(saveDt),
            success: function (response) {
                if (response?.status) {
                    toastr.success("Data saved successfully.");
                    setTimeout(() => {
                        window.location.href = '/InHouseWeighbridgeEntryList/Index';
                    }, 1500);
                } else {
                    toastr.error(response?.message || "Save failed. Please try again.");
                }
            },
            error: function () {
                toastr.error("An error occurred while saving. Please contact the administrator.");
            }
        });
    }


    function UpdateData(UpdateDt) {
        $.ajax({
            url: '@Url.Action("SaveOrUpdateInHouseWeighBridgeEntry", "InHouseWeighbridgeEntry")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(UpdateDt),
            dataType: 'json',
            success: function (response) {
                if (response?.status) {
                    toastr.success("Data updated successfully");
                    setTimeout(() => {
                        window.location.href = '/InHouseWeighbridgeEntryList/Index';
                    }, 1500);
                } else {
                    toastr.error("Update failed: " + (response?.message || "Unknown error."));
                }
            },
            error: function (xhr, status, error) {
                toastr.error("Data not updated: " + error);
            }
        });
    }

    async function collectFormData() {
        const id = toNullableString(docId);
        const itemRecords = await collectItemsDetail();

        const formData = {
            DOC_ID: document.getElementById("TxtDocId").value,
            V_TYPE: document.getElementById("ddlDocType").value,
            V_NO: toNullableInt(document.getElementById("NumDocNo").value),
            V_DATE: toNullableDate(document.getElementById("DtDocDate").value),
