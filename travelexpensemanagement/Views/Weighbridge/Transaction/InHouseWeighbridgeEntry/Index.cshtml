    }     
   
    async function collectItemsDetail() {
      const items = [];

      $('#tblInHouseWeighbridgeEntry tbody tr').each(function () {
        const idx = this.id.replace('row', '');
        const $r = $(this);

        const rawWeight = $r.find(`#TxtWeight${idx}`).val();
        const weight = parseDecimalSafe(rawWeight);

        // Skip this row if weight is empty or <= 0
        if (!weight || weight <= 0) {
          return; // continue to next row
        }

        // Only rows with weight > 0 reach here
        const dateVal = $r.find(`#TxtDate${idx}`).val();
        const timeVal = $r.find(`#TxtTime${idx}`).val();
        const itemNameVal = toNullableString($r.find(`#TxtItemName${idx}`).val());
        const fromPlaceVal = toNullableString($r.find(`#ddlFromPlace${idx}`).val());
        const toPlaceVal = toNullableString($r.find(`#ddlToPlace${idx}`).val());
        const wgtTypeVal = toNullableString($r.find(`#TxtWgtType${idx}`).val());
        const remarksVal = toNullableString($r.find(`#TxtRemarks${idx}`).val());

        const itemName= toNullableString($r.find(`#TxtItemName${idx}`).val()) ? $r.find(`#TxtItemName${idx} option:selected`).text() : null;
        const fromName= toNullableString($r.find(`#ddlFromPlace${idx}`).val()) ? $r.find(`#ddlFromPlace${idx} option:selected`).text() : null;
        const toName=toNullableString($r.find(`#ddlToPlace${idx}`).val()) ? $r.find(`#ddlToPlace${idx} option:selected`).text() : null ;

        items.push({
          SNO: parseIntSafe(idx),
          WEIGHT: weight,
          WGT_DATE: dateVal ? toNullableDate(dateVal) : null,
          WGT_TIME: toNullableString(timeVal),
          ITEM_CODE: itemNameVal,
          ITEM_NAME: itemName,
          FROM_PLACE: fromPlaceVal,
          TO_PLACE: toPlaceVal,
          V_SHIFT: null,
          TYPE: wgtTypeVal,
          TARE_WGT: null,
          NET_WGT: 0,
          FROM_NAME:fromName ,
          TO_NAME:toName ,
          REMARKS: remarksVal,
          STATUS: null,
          Ref_type: null,
          Ref_no: null,
          wb_time: null,
          COND: null,
          MOIS_PER: null,
          MOIS_WT: null
        });
      });

      return items;
    }

    function safeSetDropdown(selector, value) {
        const $el = $(selector);
        if (!$el.length) {        
            return;
        }
        const $option = $el.find(`option[value="${value}"]`);
        if ($option.length > 0) {
            $el.val(value).trigger('change');
        } else {
            console.warn(`Value '${value}' not found in dropdown: ${selector}`);
        }
    }
     
    async function fillHeaderData(headdata) {
      if (!Array.isArray(headdata) || headdata.length === 0) {
        return;
      }
      const data = headdata[0];
      if (data.V_DATE) {
        const dt = new Date(data.V_DATE);
        const yyyy = dt.getFullYear();
        const mm = String(dt.getMonth() + 1).padStart(2, '0');
        const dd = String(dt.getDate()).padStart(2, '0');
        $('#DtDocDate').val(`${yyyy}-${mm}-${dd}`);
      } else {
        $('#DtDocDate').val('');
      } 

     $('#TxtDocId').val(data.DOC_ID || '');
     $("#ddlDocType").val(data.V_TYPE);
     $("#ddlStatus").val(data.STATUS ?? "");   
     $('#NumDocNo').val(data.V_NO != null ? data.V_NO : '');
     $('#TxtVehicleNo').val(data.VEHICLE_NO || '');      $('#ChkCrystalReport').prop('checked', false); 
     $('#TxtNobags25').val(data.SMALL_BAG != null ? data.SMALL_BAG : '');
     $('#TxtNobags500').val(data.MEDIUM_BAG != null ? data.MEDIUM_BAG : '');
     $('#TxtNobags1000').val(data.LARGE_BAG != null ? data.LARGE_BAG : '');
             
    $("#ddlWeightType").val(data.WB_TYPE ?? '');
    toggleReadOnly();

    $('#ddlTareSlipNo').val(data.TARE_NO);
    $('#ddlGrossSlipNo').val(data.GROSS_NO);


    }

    async function fillItemDetailTable(itemsData) {
        const $tbody = $('#tblInHouseWeighbridgeEntry tbody');
        $tbody.empty();
        for (let index = 0; index < itemsData.length; index++) {
            const item = itemsData[index];
            const idx = index + 1;
            addItemRecordRow();           
            await bindDropdownData(idx);

            $(`#TxtWeight${idx}`).val(item.WEIGHT ?? "");
            $(`#TxtDate${idx}`).val((item.WGT_DATE || '').substring(0, 10));
            $(`#TxtWgtType${idx}`).val(item.TYPE ?? "");
            $(`#TxtItemName${idx}`).val(item.ITEM_CODE ?? "").trigger('change');
            $(`#ddlFromPlace${idx}`).val(item.FROM_PLACE ?? "").trigger('change');
            $(`#ddlToPlace${idx}`).val(item.TO_PLACE ?? "").trigger('change');
            $(`#TxtRemarks${idx}`).val(item.REMARKS ?? "");
            const formattedTime = convertTo24HourFormat(item.WGT_TIME ?? "");
            $(`#TxtTime${idx}`).val(formattedTime);
     
            $(`#ddlFromPlace${idx}`).prop('disabled', true);
            $(`#ddlToPlace${idx}`).prop('disabled', true);
            $(`#TxtItemName${idx}`).prop('disabled', true);
            $(`#TxtDate${idx}`).prop('readOnly', true);
            $(`#TxtTime${idx}`).prop('readOnly', true);
            $(`#TxtWeight${idx}`).prop('readOnly', true);
            $(`#TxtWgtType${idx}`).prop('readOnly', true);
            $(`#TxtRemarks${idx}`).prop('readOnly', true);
            $(`#BtnGetWeight${idx}`).prop('disabled', true);
            $(`#row${idx} .btn-delete-action`).hide();
        }
    
    }

    function convertTo24HourFormat(timeStr) {
        if (!timeStr) return '';

        if (/^\d{2}:\d{2}(:\d{2})?$/.test(timeStr)) {
            return timeStr.substring(0, 5);
        }

        const [time, modifier] = timeStr.split(' ');
        if (!time || !modifier) return '';

        let [hours, minutes] = time.split(':');

        if (modifier.toUpperCase() === 'PM' && hours !== '12') {
            hours = String(Number(hours) + 12);
        } else if (modifier.toUpperCase() === 'AM' && hours === '12') {
            hours = '00';
        }

        return `${hours.padStart(2, '0')}:${minutes.padStart(2, '0')}`;
    }
         
    function formatDateForInput(dateValue) {
        if (!dateValue) return '';
        const dt = new Date(dateValue);
        const yyyy = dt.getFullYear();
        const mm = String(dt.getMonth() + 1).padStart(2, '0');
        const dd = String(dt.getDate()).padStart(2, '0');
        return `${yyyy}-${mm}-${dd}`;
    }

    function GetDocid(VType) {
        $.ajax({
            url: '@Url.Action("GetMaxVNo", "InHouseWeighbridgeEntry")',
            type: 'GET',
            data: { V_type: VType },
            success: function (response) {
                    debugger;
                    var v_no = response.data;
                    $('#NumDocNo').val(v_no);
                    $('#TxtDocId').val(VType + v_no);                   
            },

            error: function (xhr, status, error) {
                toastr.error('Error fetching Doc ID: ' + error);
            }
        });
    }
 
    async function GetDocData(MasterTblId, readOnly) {
        try {
            const response = await $.ajax({
                url: '/InHouseWeighbridgeEntry/GetInHouseWeighBridgeById',
                type: 'GET',
                data: { id: MasterTblId }
            });
            if (response.status) {                
                await fillHeaderData(response.header);
                await fillItemDetailTable(response.detail);
                if (readOnly === 'true') {
                    $('#btn-save, #cancelBtn').hide();
                    disableAllFields();
                } else {
                    $('#btn-save, #cancelBtn').show();
                    enableAllFields();
                }
            } else {
                toastr.error('No data returned.');
            }
        } catch (error) {
            toastr.error('Failed to load data.');
            console.error(error);
        }
    }

    function addItemRecordRow() {
        let tbody = $('#tblInHouseWeighbridgeEntry tbody');
        let rowCount = tbody.find('tr').length + 1;

        let newRow = `
            <tr class="no-border-input" id="row${rowCount}">
                <td><input type="text" class="form-control" id="TxtWgtType${rowCount}" placeholder="Wgt Type" /></td>
                <td><input type="text" class="form-control" id="TxtWeight${rowCount}" placeholder="Weight" /></td>
                <td><button type="button" class="btn btn-primary" id="BtnGetWeight${rowCount}">Get Weight</button></td>
                <td><input type="date" class="form-control" id="TxtDate${rowCount}" /></td>
                <td><input type="time" class="form-control" id="TxtTime${rowCount}" /></td>
                <td>
                    <select class="form-control" id="ddlFromPlace${rowCount}">
                        <option value="">Select From</option>
                    </select>
                </td>
                <td>
                    <select class="form-control" id="ddlToPlace${rowCount}">
                        <option value="">Select To</option>
                    </select>
                </td>
                <td>
                    <select class="form-control" id="TxtItemName${rowCount}">
                        <option value="">Select Item</option>
                    </select>
                </td>
                <td><input type="text" class="form-control" id="TxtRemarks${rowCount}" placeholder="Remarks" /></td>
                <td>
                    <i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer;"></i>
                    <i class="fa fa-trash btn-delete-action text-danger" title="Delete Row" style="cursor:pointer;"></i>
                </td>
            </tr>
        `;

        tbody.append(newRow);
 
        $(`#TxtWeight${rowCount}`).on('input', function () {
            let currentDate = new Date();
            let formattedDate = currentDate.toISOString().slice(0, 10);  
            let formattedTime = currentDate.toTimeString().slice(0, 5);   

            $(`#TxtDate${rowCount}`).val(formattedDate);
            $(`#TxtTime${rowCount}`).val(formattedTime);
            $(`#TxtDate${rowCount}`).prop('readOnly', true);
            $(`#TxtTime${rowCount}`).prop('readOnly', true);
        });

       const wbType = $('#ddlWeightType').val();
        if (wbType=='Tare') {
            $(`#ddlFromPlace${rowCount}`).prop('disabled', true);
            $(`#ddlToPlace${rowCount}`).prop('disabled', true);
            $(`#TxtItemName${rowCount}`).prop('disabled', true);
            $(`#TxtDate${rowCount}`).prop('readOnly', true);
            $(`#TxtTime${rowCount}`).prop('readOnly', true);
        }
       

        bindDropdownData(rowCount);     
        setEnterKeyFocusOnTable(itemRecords, rowCount);
     }

    function setEnterKeyFocusOnTable(sequence, rowCount) {
        sequence.forEach((id, index) => {
            let elementId = `#${id}${rowCount}`;
            $(document).on('keydown', elementId, function (e) {
                if (e.key === 'Enter' || e.key === 'Tab' || e.keyCode === 13 || e.keyCode === 9) {
                    e.preventDefault();

                    let nextIndex = index + 1;
                    if (nextIndex < sequence.length) {
                        let nextElementId = `#${sequence[nextIndex]}${rowCount}`;
                        if ($(nextElementId).length) {
                            $(nextElementId).focus();
                        }
                    } else {
                        addItemRecordRow();
                        setEnterKeyFocus(sequence, rowCount + 1);
                        $(`#${sequence[0]}${rowCount + 1}`).focus();
                    }
                }
            });
        });
    }

    function bindDropdownData(rowCount) {
        const itemSelect = $(`#TxtItemName${rowCount}`);
        const fromAddSelect = $(`#ddlFromPlace${rowCount}`);
        const toAddSelect = $(`#ddlToPlace${rowCount}`);

        const loadDropdown = (url, selectElem, defaultText, formatter) => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: url,
                    type: 'GET',
                    dataType: 'json',
                    success: function (response) {
                        if (response.status) {
                            selectElem.empty().append(
                                $('<option>', {
                                    value: '',
                                    text: defaultText
                                })
                            );

                            $.each(response.data, function (i, item) {
                                selectElem.append(formatter(item));
                            });

                            selectElem.select2({
                                width: '300px',
                                placeholder: defaultText,
                                allowClear: true,
                                minimumResultsForSearch: 0
                            });

                            resolve();
                        } else {
                            toastr.error(`${defaultText} load failed`);
                            resolve();
                        }
                    },
                    error: function (xhr, status, error) {
                        toastr.error(`Error loading ${defaultText}: ${error}`);
                        reject(error);
                    }
                });
            });
        };

        return Promise.all([
            loadDropdown(
                '@Url.Action("GetPlaceMast", "StoreWeighbridgeEntry")',
                fromAddSelect,
                "- Select From Place -",
                item => `<option value="${item.CODE}">${item.NAME}</option>`
            ),
            loadDropdown(
                '@Url.Action("GetPlaceMast", "StoreWeighbridgeEntry")',
                toAddSelect,
                "- Select To Place -",
                item => `<option value="${item.CODE}">${item.NAME}</option>`
            ),
            loadDropdown(
                '@Url.Action("GetItemList", "StoreWeighbridgeEntry")',
                itemSelect,
                "- Select Item -",
                item => `<option value="${item.CODE}">${item.NAME}</option>`
            )
        ]);
    }

    function formatDate(dateStr) {
      if (!dateStr) return '';
      const d = new Date(dateStr);
      return d.toISOString().split('T')[0];
    }

    function parseIntSafe(value) {
        const parsed = parseInt(value, 10);
        return isNaN(parsed) ? null : parsed;
    }

    function parseFloatSafe(value) {
        const parsed = parseFloat(value);
        return isNaN(parsed) ? null : parsed;
    }

    function parseDate(dateStr) {
        if (!dateStr) return null;
        const parts = dateStr.split(/[-\/]/);
        if (parts.length === 3) {
            let [day, month, year] = parts.map(p => parseInt(p, 10));
            if (year < 1000) year += 2000;
            return new Date(year, month - 1, day);
        }
        return null;
     }

    function toNullableInt(val) {
        const parsed = parseInt(val);
        return isNaN(parsed) ? null : parsed;
    }

    function toNullableDate(val) {
        const date = new Date(val);
        return isNaN(date.getTime()) ? null : val;
    }

    function toNullableString(val) {
      return val?.trim() || null;
    }

    function allowOnlyDecimalNumbers(input) {
      input.value = input.value
        .replace(/[^0-9.]/g, '')
        .replace(/(\..*)\./g, '$1');
    }

    function setFieldsEnabled(enabled) {
      allFieldIds.forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          el.disabled = !enabled;
        }
      });
    }

    function parseDecimalSafe(val) {
        const num = parseFloat(val);
        return isNaN(num) ? null : num;
    }

    function setEnterKeyFocus(sequence) {
               sequence.forEach((id, index) => {
                   $(`#${id}`).on('keypress', function (e) {
                       if (e.key === 'Enter') {
                           e.preventDefault();
                           if (index + 1 < sequence.length) {
                               $(`#${sequence[index + 1]}`).focus();
                           }
                       }
                   });
               });
    }

    function enableAllFields() {
      allFieldIds.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.disabled = false;
      });
    }

    function disableAllFields() {
      allFieldIds.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.disabled = true;
      });
    }

    function allowOnlyNumbers(input) {
      input.value = input.value.replace(/[^0-9]/g, '');
    }

     async function checkValidDate() {
    const data = {    
        vdate: $("#DtDocDate").val(),
        vtype: $("#ddlDocType").val(),
        vno: $("#NumDocNo").val()
    };
    try {
            const response = await fetch('/InHouseWeighbridgeEntry/CheckValidDate', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
        });

        const result = await response.json();

        if (result.status === false) {    
            showToast("result.message", { type: "warning" });
            return false;
        }

        return true;

    } catch (error) {
       showToast("result.message", { type: "warning" });
        return false;
    }
}

