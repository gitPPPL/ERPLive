    async function fillItemDetailTable(itemsData) {
        const $tbody = $('#tblInHouseWeighbridgeEntry tbody');
        $tbody.empty();
        for (let index = 0; index < itemsData.length; index++) {
            const item = itemsData[index];
            const idx = index + 1;
            addItemRecordRow();           
            await bindDropdownData(idx);

            $(`#TxtWeight${idx}`).val(item.WEIGHT ?? "");
            $(`#TxtDate${idx}`).val((item.WGT_DATE || '').substring(0, 10));
            $(`#TxtWgtType${idx}`).val(item.TYPE ?? "");
            $(`#TxtItemName${idx}`).val(item.ITEM_CODE ?? "").trigger('change');
            $(`#ddlFromPlace${idx}`).val(item.FROM_PLACE ?? "").trigger('change');
            $(`#ddlToPlace${idx}`).val(item.TO_PLACE ?? "").trigger('change');
            $(`#TxtRemarks${idx}`).val(item.REMARKS ?? "");
            const formattedTime = convertTo24HourFormat(item.WGT_TIME ?? "");
            $(`#TxtTime${idx}`).val(formattedTime);
     
            $(`#ddlFromPlace${idx}`).prop('disabled', true);
            $(`#ddlToPlace${idx}`).prop('disabled', true);
            $(`#TxtItemName${idx}`).prop('disabled', true);
            $(`#TxtDate${idx}`).prop('readOnly', true);
            $(`#TxtTime${idx}`).prop('readOnly', true);
            $(`#TxtWeight${idx}`).prop('readOnly', true);
            $(`#TxtWgtType${idx}`).prop('readOnly', true);
            $(`#TxtRemarks${idx}`).prop('readOnly', true);
            $(`#BtnGetWeight${idx}`).prop('disabled', true);
            $(`#row${idx} .btn-delete-action`).hide();
        }
    
    }
    function convertTo24HourFormat(timeStr) {
        if (!timeStr) return '';
        if (/^\d{2}:\d{2}(:\d{2})?$/.test(timeStr)) {
            return timeStr.substring(0, 5);
        }
        const [time, modifier] = timeStr.split(' ');
        if (!time || !modifier) return '';
        let [hours, minutes] = time.split(':');
        if (modifier.toUpperCase() === 'PM' && hours !== '12') {
            hours = String(Number(hours) + 12);
        } else if (modifier.toUpperCase() === 'AM' && hours === '12') {
            hours = '00';
        }
        return `${hours.padStart(2, '0')}:${minutes.padStart(2, '0')}`;
    }         
    function formatDateForInput(dateValue) {
        if (!dateValue) return '';
        const dt = new Date(dateValue);
        const yyyy = dt.getFullYear();
        const mm = String(dt.getMonth() + 1).padStart(2, '0');
        const dd = String(dt.getDate()).padStart(2, '0');
        return `${yyyy}-${mm}-${dd}`;
    }
