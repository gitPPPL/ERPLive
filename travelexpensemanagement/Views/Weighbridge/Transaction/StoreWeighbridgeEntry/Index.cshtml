@{
    ViewBag.Title = "Store Weighbridge Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<fieldset>
    <legend class="legend-field">Store Weighbridge Entry</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button onclick="handleBack('@Url.Action("Index", "StoreWeighbridgeEntryList")', readOnly)" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
                @* <button type="button" onclick="handleBack('@Url.Action("Index", "StoreWeighbridgeEntryList")', readOnly)">
                    <i class="fa-solid fa-arrow-left"></i>Back to list
                </button> *@
            </div>
        </div>
    </div>
    <form id="StoreWeighbridgeEntryForm">
        <input type="hidden" class="form-control" id="TxtDocId" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlDocType">Doc Type <span class="required">*</span></label>
                    <select class="form-control" id="ddlDocType">
                        @* <option value="">Select DOC Type</option> *@
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumDocNo">Doc No <span class="required">*</span></label>
                    <input type="number" class="form-control" id="NumDocNo" placeholder="Enter Doc No" readonly>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DtDocDate">Doc Date <span class="required">*</span></label>
                    <input type="date" class="form-control" id="DtDocDate">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlStatus">Status</label>
                    <select class="form-control" id="ddlStatus">                         
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlGateNo">Gate in No@*  <span class="required">*</span> *@</label>
                    <select class="form-control" id="ddlGateNo">
                        <option value="">Select Gate in No</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DdlPartyName">Party Name</label>
                    <select class="form-control" id="DdlPartyName">
                        <option selected disabled>-select party name-</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtPartyWeight">Party Weight</label>
                    <input type="text" class="form-control" id="TxtPartyWeight" placeholder="Enter Party Weight">
                </div>
            </div>
            <div class="col-md-3">
                <div class="input-divide">
                    <label class="checkbox-input-mx">
                        <input type="checkbox" id="ChkCrystalReport" />
                        Crystal Report
                    </label>
                    <div class="form-group">
                        <label for="Txtlabel12">Label12</label>
                        <textarea class="form-control" id="Txtlabel12"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="table-responsive">
                <table id="tblStoreWeighbridge" class="table-width">
                    <thead class="table-head">
                        <tr>
                            <th style="display:none;"><input type="checkbox" id="selectAllPR" /></th>
                            <th>Weight</th>
                            <th>Get Wgt.</th>
                            <th>T.Wgt.</th>
                            <th>N.Wgt.</th>
                            <th>Date/Time</th>
                            <th>From Place</th>
                            <th>To Place</th>
                            <th>Item</th>
                            <th>Remarks</th>
                            <th class="action-col">Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="btn-add-row-last">
                        <i class="fa fa-plus btn-add-row" title="Add Row"><span>Add New Row</span></i>
                    </div>
                   @*  <div class="pagination-end">
                        <div class="custom-pagination" id="tablePagination"></div>
                    </div> *@
                </div>
            </div>
        </div>
        <div class="row">
            <div class="offset-md-10 col-md-2">
                <div class="btn-last">
                    <button id="btn-save" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
                </div>
            </div>
        </div>
    </form>
</fieldset>

