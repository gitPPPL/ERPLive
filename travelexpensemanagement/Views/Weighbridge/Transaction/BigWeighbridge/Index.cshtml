@{
    ViewBag.Title = "Big Weighbridge Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="erp-toast-container"></div>

<fieldset>
    <legend class="legend-field">Big Weighbridge</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="window.location.href='@Url.Action("Index", "BigWeighbridgeList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>
    <form id="BigWeighbridgeForm">
        <input type="hidden" class="form-control" id="TxtDocId" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlDocType">Doc Type <span class="required">*</span></label>
                    <select class="form-control" id="ddlDocType">
                        @* <option value="">--Select DOC Type--</option> *@
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumDocNo">Doc No <span class="required">*</span></label>
                    <input type="text" class="form-control" id="NumDocNo" placeholder="Enter Doc No" readonly>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DtDocDate">Doc Date <span class="required">*</span></label>
                    <input type="date" class="form-control" id="DtDocDate">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlWBType">WB Type</label>
                    <select class="form-control" id="ddlWBType">
                        <option value="">Select WB Type</option>
                        <option>Raw Material</option>
                        <option>Store</option>
                        <option>Fuel</option>
                        <option>Sales</option>
                        <option>Outsider</option>
                        <option>Misc</option>
                        <option>JobWork</option>
                        <option>RGP</option>
                        <option>Sales Return</option>

                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtQRCode">QR Code</label>
                    <input type="text" class="form-control" id="TxtQRCode" placeholder="Enter QR Code">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DdlGateNo">Gate No</label>
                    <select class="form-control" id="DdlGateNo">
                        <option value="">-select Gate No.-</option>
                    </select>
                    @* <input type="number" class="form-control" id="DdlGateNo" placeholder="Enter Gate No"> *@
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlPartyName">Party Name</label>
                    <select class="form-control" id="ddlPartyName">
                        <option value="">Select Party Name</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtVehicleNo">Vehicle No</label>
                    <input type="text" maxlength="20" class="form-control" id="TxtVehicleNo" placeholder="Enter Vehicle No">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumPartyGrossWeight">Party Gross Weight</label>
                    <input type="text" maxlength="10" oninput="allowOnlyDecimal(this)" class="form-control" id="NumPartyGrossWeight">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumTrWeight">Tr Weight</label>
                    <input type="text" maxlength="10" oninput="allowOnlyDecimal(this)" class="form-control" id="NumTrWeight">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumNetWeight">Net Weight</label>
                    <input type="text" maxlength="10" oninput="allowOnlyDecimal(this)" class="form-control" id="NumNetWeight">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtPartyWBNo">Party WB No.</label>
                    <input type="text" maxlength="20" class="form-control" id="TxtPartyWBNo" placeholder="Enter WayBill InvNo">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumNoBag25">No of Bags(25 Kg)</label>
                    <input type="text" maxlength="8" class="form-control" oninput="allowOnlyNumbers(this)" id="NumNoBag25">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumNoBag500">No of Bags(500 Kg)</label>
                    <input type="text" maxlength="8" class="form-control" oninput="allowOnlyNumbers(this)" id="NumNoBag500">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumNoBag1000">No of Bags(1000 Kg)</label>
                    <input type="text" maxlength="8" class="form-control" oninput="allowOnlyNumbers(this)" id="NumNoBag1000">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtRemarks">Remarks</label>
                    <textarea type="text" maxlength="500" class="form-control" id="txtRemarks" placeholder="Enter Remarks"></textarea>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="offset-md-8 col-md-4">
                <label class="checkbox-input-mx button-right">
                    <input type="checkbox" id="ChkCrystalReport" />
                    Crystal Report
                    <button id="btn-print" type="button" class="btn btn-success"><i class="fa fa-save"></i>Print Gatepass</button>
                </label>
            </div>
        </div>
        <div class="card">
            <div class="table-responsive">
                <table id="tblBigWeighbridge" class="table-width">
                    <thead class="table-head">
                        <tr>
                            <th>Weight</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Item</th>
                            <th>From Place</th>
                            <th>To Place</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="ddlStatus">Status</label>
                        <select class="form-control" id="ddlStatus">
                            <option value="1">Open</option>
                            <option value="0">Close</option>
                            <option value="2">Cancel</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="DtStatusDate">Date</label>
                        <input type="datetime-local" id="DtStatusDate" class="form-control" readonly>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="offset-md-10 col-md-2">
                <div class="btn-last">
                    <button id="btn-save" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
                </div>
            </div>
        </div>
    </form>
</fieldset>

<script src="~/js/GlobalFunction.js" asp-append-version="true"></script>

<script>
    const allFieldIds = [
      "DtDocDate","ddlWBType","TxtQRCode","DdlGateNo","ddlPartyName",
      "NumPartyGrossWeight","NumTrWeight","NumNetWeight","TxtVehicleNo",
      "TxtPartyWBNo","ChkCrystalReport","txtRemarks","NumNoBag25","NumNoBag500","NumNoBag1000"
    ];

    const itemRecords = [
      "TxtWeight","TxtDate","TxtTime","ddlItemname","DdlFromPlace","DdlToPlace"
    ];

    let docId = "", readOnly;

    function getQueryParam(param) {
      return new URLSearchParams(window.location.search).get(param);
    }

    $(document).ready(function () {
      initPage();
    });

    async function initPage() {
          try {
            await GetDocTypeAsync();
            await handleDocLoad();
            
            // addItemRecordRow();
            if (!docId) {
                await GetPartyList();
                addItemRecordRow();
            }
            setEnterKeyFocus(allFieldIds);
            wireEvents();
        } catch (err) {
            toastr.error('Initialization failed: ' + err);
        }
    }

    function wireEvents() {

      // $('#ddlWBType').on('change', function(){
      //    var wbType =$(this).val();
      //    if(wbType === "Outsider" || wbType === "Sales Return"){
      //       $('#ddlPartyName').prop('disabled', false);
      //       $('#TxtVehicleNo').prop('readOnly', false);
      //       GetPartyList();
      //    } else {
      //       $('#ddlPartyName').prop('disabled', true).val('').trigger('change');
      //       $('#TxtVehicleNo').prop('readOnly', true);
      //    }
      //    GetGateEntryList($('#ddlWBType').val());
      // });

      $("#NumPartyGrossWeight, #NumTrWeight").on('input', updateNetWeight);

      $('#btn-save').on('click', async (e) => {
        e.preventDefault();

        // var wbType=$('#ddlWBType').val();
        //    if (wbType !== "Outsider" && wbType !== "Sales Return") {
        //     if (!validateRequiredField('#DdlGateNo', 'Gate No')) return;
        //    }

        // if (!validateRequiredField('#ddlDocType','Doc Type') ||
        //     !validateRequiredField('#NumDocNo','Doc No') ||
        //     !validateRequiredField('#DtDocDate','Doc Date') ||
        //     !validateRequiredField('#ddlWBType','WB Type') ||
        //     !validateRequiredField('#TxtVehicleNo','Vehicle No.')) return;

        if (!(await validateBigWeighbridgeForm())) return;

       //  if (!validateBigWeighbridgeTable()) {
       //    return;
       //  }

       // if (!validateWeightOrder()) {
       //   return;
       // }

        try {
          const data = await collectFormData();
          console.log(data);
          docId ? UpdateData(data) : SaveData(data);
        } catch (err) {
          toastr.error("Error saving data: " + err);
        }
      });

      $('#ddlDocType').on('change', () => {
        const val = $('#ddlDocType').val();
        if (val) GetDocid(val);
      });

      $(document).on('click', '.btn-delete-action, .btn-Itemdelete-action', function () {
        const tbody = $(this).closest('tbody');
        if (tbody.find('tr').length > 1) {
          $(this).closest('tr').remove();
        } else {
          alert('Cannot delete the first row.');
        }
      });

        $(document).on('click', '.btn-add-action', async function () {
            await addItemRecordRow();
        });

        // $(document).on('click', '.btn-Itemadd-action', function () {
        //      if (!docId) {
        //         return;
        //      }
        //      addItemRecordRow();
        // });

        $('#DdlGateNo').on('change', function () {
            var gateNo = $(this).val();
            var selectedOption = $(this).find('option:selected');
            if (gateNo) {
                $('#TxtVehicleNo').val(selectedOption.data('vehicalno') || '');
                var partyCode = selectedOption.data('party');
                var partyName = selectedOption.data('partynm');
                ensureOption($('#ddlPartyName'), partyCode, partyName);
                $('#ddlPartyName').val(partyCode).trigger('change');
            } else {
                $('#TxtVehicleNo').val('');
                $('#ddlPartyName').val('').trigger('change');
            }
        });

        function ensureOption($dropdown, code, name) {
            if (code && $dropdown.find(`option[value="${code}"]`).length === 0) {
                $dropdown.append(`<option value="${code}">${name}</option>`);
            }
        }

    }

</script>

