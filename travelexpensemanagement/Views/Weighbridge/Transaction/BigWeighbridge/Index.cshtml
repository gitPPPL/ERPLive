    async function validateBigWeighbridgeForm() {

        const wbType = $('#ddlWBType').val()?.trim();
        const docType = $('#ddlDocType').val()?.trim();
        const docNo = $('#NumDocNo').val()?.trim();
        const docDate = $('#DtDocDate').val()?.trim();
        const gateNo = $('#DdlGateNo').val()?.trim();
        const party = $('#ddlPartyName').val()?.trim();
        const vehicle = $('#TxtVehicleNo').val()?.trim();

        // HEADER VALIDATION

        if (!docType) {
            showToast("Voucher Type not selected.", { type: "warning" });
            $('#ddlDocType').addClass('is-invalid').focus();
            return false;
        } else {
            $('#ddlDocType').removeClass('is-invalid');
        }

        if (!docNo || parseInt(docNo) === 0) {
            showToast("Invalid Voucher No.", { type: "warning" });
            $('#NumDocNo').addClass('is-invalid').focus();
            return false;
        } else {
            $('#NumDocNo').removeClass('is-invalid');
        }

        if (!docDate) {
            showToast("Voucher Date is required.", { type: "warning" });
            $('#DtDocDate').addClass('is-invalid').focus();
            return false;
        } else {
            $('#DtDocDate').removeClass('is-invalid');
        }

        if (!wbType) {
            showToast("WB Type is required.", { type: "warning" });
            $('#ddlWBType').addClass('is-invalid').focus();
            return false;
        } else {
            $('#ddlWBType').removeClass('is-invalid');
        }

        // GATE VALIDATION
        const gateRequiredTypes = [ "Raw Material", "Store", "Sales Return",  "Fuel", "Misc", "RGP", "Sales" ];

        if (gateRequiredTypes.includes(wbType) && !gateNo) {
            showToast("Gate Inward No is required.", { type: "warning" });
            $('#DdlGateNo').addClass('is-invalid').focus();
            return false;
        } else {
            $('#DdlGateNo').removeClass('is-invalid');
        }

        if (!party) {
            showToast("Party Name is required.", { type: "warning" });
            $('#ddlPartyName').addClass('is-invalid').focus();
            return false;
        } else {
            $('#ddlPartyName').removeClass('is-invalid');
        }

        if (!vehicle) {
            showToast("Vehicle No is required.", { type: "warning" });
            $('#TxtVehicleNo').addClass('is-invalid').focus();
            return false;
        } else {
            $('#TxtVehicleNo').removeClass('is-invalid');
        }

        // KANT + MISC BLOCK RULE

        if (docType === "KANT" && wbType === "Misc") {
            showToast("Entry not allowed in Misc for Inward/Outward.", {
                type: "warning"
            });
            return false;
        }

        // GRID CHECK

        const rows = $('#tblBigWeighbridge tbody tr');

        if (rows.length === 0) {
            showToast("No Record in grid to save.", { type: "warning" });
            return false;
        }

        let validRowCount = 0;
        let weights = [];
        let firstWeight = null;

        // ROW VALIDATION

        for (let i = 0; i < rows.length; i++) {

            const idx = rows[i].id.replace('row', '');

            const weight = parseDecimalSafe($(`#TxtWeight${idx}`).val());
            const date = $(`#TxtDate${idx}`).val()?.trim();
            const time = $(`#TxtTime${idx}`).val()?.trim();
            const item = $(`#ddlItemname${idx}`).val();
            const fromPlace = $(`#DdlFromPlace${idx}`).val();
            const toPlace = $(`#DdlToPlace${idx}`).val();

            if (weight > 0) {
                validRowCount++;
                weights.push(weight);

                if (firstWeight === null) {
                    firstWeight = weight;
                }
            }

            // Validate only rows having weight > 0
            if (weight > 0) {

                // Date
                if (!date) {
                    showToast(`Date required in row ${idx}`, { type: "warning" });
                    $(`#TxtDate${idx}`).addClass('is-invalid').focus();
                    return false;
                } else {
                    $(`#TxtDate${idx}`).removeClass('is-invalid');
                }

                // Time
                if (!time) {
                    showToast(`Time required in row ${idx}`, { type: "warning" });
                    $(`#TxtTime${idx}`).addClass('is-invalid').focus();
                    return false;
                } else {
                    $(`#TxtTime${idx}`).removeClass('is-invalid');
                }

                // Item
                if (!item) {
                    showToast(`Item required in row ${idx}`, { type: "warning" });
                    $(`#ddlItemname${idx}`).addClass('is-invalid').focus();
                    return false;
                } else {
                    $(`#ddlItemname${idx}`).removeClass('is-invalid');
                }

                // From Place (matches VB code)
                if (!fromPlace) {
                    showToast(`From Place required in row ${idx}`, {
                        type: "warning"
                    });
                    $(`#DdlFromPlace${idx}`).addClass('is-invalid').focus();
                    return false;
                } else {
                    $(`#DdlFromPlace${idx}`).removeClass('is-invalid');
                }

                // To Place (matches VB code)
                if (!toPlace) {
                    showToast(`To Place required in row ${idx}`, {
                        type: "warning"
                    });
                    $(`#DdlToPlace${idx}`).addClass('is-invalid').focus();
                    return false;
                } else {
                    $(`#DdlToPlace${idx}`).removeClass('is-invalid');
                }
            }
        }

        // NO VALID DATA CHECK

        if (validRowCount === 0) {
            showToast("Weight should not be blank or 0.", { type: "warning" });
            return false;
        }

        // SINGLE ROW CHECK

        if (rows.length === 1 && firstWeight === 0) {
            showToast("Weight should not be blank or 0.", { type: "warning" });
            $(`#TxtWeight${rows[0].id.replace('row', '')}`)
                .addClass('is-invalid')
                .focus();
            return false;
        }

        // WEIGHT ORDER VALIDATION

        if (weights.length >= 2) {

            // Sales → Ascending
            if (wbType === "Sales") {
                for (let i = 1; i < weights.length; i++) {
                    if (weights[i] < weights[i - 1]) {
                        showToast(
                            "Weight must be in ASCENDING order for Sales.",
                            { type: "warning" }
                        );
                        return false;
                    }
                }
            }

            // Raw Material / Store / Fuel / Sales Return → Descending
            if ([
                "Raw Material",
                "Store",
                "Fuel",
                "Sales Return"
            ].includes(wbType)) {
                for (let i = 1; i < weights.length; i++) {
                    if (weights[i] > weights[i - 1]) {
                        showToast(
                            "Weight must be in DESCENDING order.",
                            { type: "warning" }
                        );
                        return false;
                    }
                }
            }

            // Outsider / Misc → Detect flow dynamically
            if (["Outsider", "Misc"].includes(wbType) && weights.length >= 3) {

                let flow = "";

                if (weights[1] < weights[0]) {
                    flow = "DESC";
                } else if (weights[1] > weights[0]) {
                    flow = "ASC";
                }

                for (let i = 2; i < weights.length; i++) {

                    if (flow === "DESC" && weights[i] > weights[i - 1]) {
                        showToast(
                            "Invalid weight. Weight must be in DESCENDING order.",
                            { type: "warning" }
                        );
                        return false;
                    }

                    if (flow === "ASC" && weights[i] < weights[i - 1]) {
                        showToast(
                            "Invalid weight. Weight must be in ASCENDING order.",
                            { type: "warning" }
                        );
                        return false;
                    }
                }
            }
        }

        // COMPANY RULE (pubCompCode = 7)

        if (typeof pubCompCode !== "undefined" && pubCompCode === 7) {
            const lastWeight = weights[weights.length - 1] || 0;

            if (lastWeight > 0 && lastWeight < 1000) {
                const proceed = confirm(
                    "Weight must be more than 1000 Kgs.\nDo you want to continue?"
                );

                if (!proceed) {
                    return false;
                }
            }
        }

        // IMAGE VALIDATION (ASYNC)

        if (
            typeof pubCompCode !== "undefined" &&
            [1, 4].includes(pubCompCode) &&
            wbType === "Raw Material" &&
            $('#ddlStatus').val()?.toUpperCase() === "CLOSE"
        ) {
            const imgOk = await checkVehicleImages();

            if (!imgOk) {
                showToast(
                    "Front and Back both Images of Vehicle not captured.",
                    { type: "warning" }
                );
                return false;
            }
        }

        return true;
    }
    

    function updateNetWeight() {
      const g = parseFloat($("#NumPartyGrossWeight").val()) || 0;
      const t = parseFloat($("#NumTrWeight").val()) || 0;
      $("#NumNetWeight").val((g - t).toFixed(2));
    }

    async function handleDocLoad() {
        docId = getQueryParam('id');
        readOnly = getQueryParam('readOnly');
        if (docId) {
            $('#ddlDocType').prop('disabled', true);
            await GetDocData(docId, readOnly);

            var wbType =$('#ddlWBType').val();
            if(wbType === "Outsider" || wbType === "Sales Return"){
            $('#ddlPartyName').prop('disabled', false);
            $('#TxtVehicleNo').prop('readOnly', false);
            // var partyCode=$('#ddlPartyName').val();
           const partyCode = $('#ddlPartyName').val();
           await GetPartyList(partyCode);
            } else {
                $('#ddlPartyName').prop('disabled', true);
                $('#TxtVehicleNo').prop('readOnly', true);
            }

        } else {
            $('#ddlDocType').prop('selectedIndex', 0);
            const Vtype = $('#ddlDocType').val();
            if(Vtype)
            {
                GetDocid(Vtype);
            }
            GetGateEntryList();
            const today = new Date();
