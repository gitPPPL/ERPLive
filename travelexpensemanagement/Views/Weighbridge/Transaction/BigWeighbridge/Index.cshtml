@{
    ViewBag.Title = "Big Weighbridge Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-balance-scale"></i>
        </div>
        <div class="erppage-header-title">Big Weighbridge Entry</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "BigWeighbridgeList")', readOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="BigWeighbridgeForm">
    <input type="hidden" class="form-control" id="TxtDocId" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Type</label>
                    <select class="erppage-input erppage-select" id="ddlDocType">
                        <option>Select Doc Type</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Document No</label>
                    <input type="number" class="erppage-redinput" id="NumDocNo" placeholder="Enter Doc No" readonly>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-redinput" id="DtDocDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">WB Type</label>
                    <select class="erppage-input erppage-required" id="ddlWBType">
                        <option value="">Select WB Type</option>
                        <option value="Raw Material">Raw Material</option>
                        <option value="Store">Store</option>
                        <option value="Fuel">Fuel</option>
                        <option value="Sales">Sales</option>
                        <option value="Outsider">Outsider</option>
                        <option value="Misc">Misc</option>
                        <option value="JobWork">JobWork</option>
                        <option value="RGP">RGP</option>
                        <option value="Sales Return">Sales Return</option>
                    </select>
                </div>
            </div>
            <div class="erppage-grid4">

                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Gate No</label>
                    <select class="erppage-redinput erppage-required" id="DdlGateNo">
                        <option value="">Select Gate No.</option>
                    </select>
                </div>

                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Party Name</label>
                    <select id="ddlPartyName" class="erppage-input erppage-select">
                        <option value="">Select Party Name</option>
                    </select>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Vehicle No</label>
                    <input type="text" maxlength="20" class="erppage-input" id="TxtVehicleNo" placeholder="Enter Vehicle No" readonly>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Party Gross Weight</label>
                    <input type="text" maxlength="10" oninput="allowOnlyDecimal(this)" class="erppage-input" id="NumPartyGrossWeight">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Tr Weight</label>
                    <input type="text" maxlength="10" oninput="allowOnlyDecimal(this)" class="erppage-input" id="NumTrWeight">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Net Weight</label>
                    <input type="text" maxlength="10" oninput="allowOnlyDecimal(this)" class="erppage-input" id="NumNetWeight">
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Party WB No.</label>
                    <input type="text" maxlength="20" class="erppage-input" id="TxtPartyWBNo" placeholder="Enter Party WB No.">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">No of Bags(25 Kg)</label>
                    <input type="text" maxlength="8" oninput="allowOnlyNumbers(this)" class="erppage-input" id="NumNoBag25">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">No of Bags(500 Kg)</label>
                    <input type="text" maxlength="8" oninput="allowOnlyNumbers(this)" class="erppage-input" id="NumNoBag500">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">No of Bags(1000 Kg)</label>
                    <input type="text" maxlength="10" oninput="allowOnlyNumbers(this)" class="erppage-input" id="NumNoBag1000">
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Remarks</label>
                    <textarea type="text" maxlength="500" class="erppage-textarea" id="txtRemarks" placeholder="Enter Remarks"></textarea>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">QR Code</label>
                    <input type="text" class="erppage-input" id="TxtQRCode" placeholder="Enter QR Code">
                </div>
                <div class="erppage-divfield">
                    <div class="erppagesmodal-checkbox-wrap">
                        <label class="erppage-label">Crystal Report</label>
                        <input type="checkbox" id="ChkCrystalReport" />
                    </div>
                </div>

            </div>
            <div class="erppagelist-toolbar-end" style="margin: 0px; padding: 0px;">
                <div class="erppage-internalaction" style="margin: 0;">
                    <button type="button" id="btn-print" class="erppage-btn erppage-btn-common">
                        <i class="fa fa-print"></i>
                        <span>Print Gatepass</span>
                    </button>
                </div>
            </div>
            <div class="erppagelist-container">
                <div class="excel-wrapper">
                    <table id="tblBigWeighbridge" class="excel-table fixed-grid-table table-width">
                        <colgroup>
                            <col style="display:none;">      
                            <col style="width:120px;">       
                            <col style="width:130px;">       
                            <col style="width:110px;">       
                            <col style="width:220px;">       
                            <col style="width:180px;">       
                            <col style="width:180px;">       
                            <col style="width:120px;">       
                        </colgroup>
                        <thead class="table-head">
                            <tr>
                                <th style="display:none;">Code</th>
                                <th>Weight</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Item</th>
                                <th>From Place</th>
                                <th>To Place</th>
                                <th class="action-col">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="erppagelist-pagination">
                    <div class="pagination-left">
                        <select id="pageSizeSelect" onchange="changeRowsPerPage()">
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                    </div>
                    <div class="pagination-center">
                        <button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
                        <div id="pageNumbers" class="page-numbers"></div>

                        <button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
                    </div>
                    <div class="pagination-right" id="pageInfoText">
                        Results: 0 - 0 of 0
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="erppage-actions" style="background: #ededed;border: 1px solid #d1d1d1;border-radius: 4px;">
            <div class="erppage-divfield">
                <label class="erppage-label">Status</label>
                <select class="erppage-input" id="ddlStatus">
                    <option value="1">Open</option>
                    <option value="0">Close</option>
                    <option value="2">Cancel</option>
                </select>
            </div>
            <div class="erppage-divfield">
                <label class="erppage-label">Date</label>
                <input type="datetime-local" class="erppage-input" id="DtStatusDate" readonly>
            </div>
            <button id="btn-save" type="submit" class="erppage-btn erppage-btn-save">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>
        </div>
    </div>
</div>

<script>
    window.pubCompCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.PubCompCode ?? 0));
</script>

<script src="~/js/erpjs/weighbridge/transaction/bigweighbridge/bigweighbridge.js"></script>
<script src="~/js/GlobalFunction.js" asp-append-version="true"></script>

