@{
    ViewBag.Title = "Parameter Master";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<style>
    /*Loder*/
    .circle-loader {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    /* Spinner container */
    .container {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
    }

    /* Spinner parts (the spinning rings) */
    .spinner-part {
        position: absolute;
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 18px solid transparent;
        animation: rotate var(--speed) var(--timing) infinite;
    }

        .spinner-part:first-child {
            border-left-color: #E8A0BF;
            border-top: 1px solid #E8A0BF;
            --speed: 0.8s;
            --timing: linear;
        }

        .spinner-part:nth-child(2) {
            border-top-color: #BA90C6;
            border-right: 1px solid #BA90C6;
            --speed: 0.8s;
            --timing: ease-in-out;
        }

        .spinner-part:last-child {
            border-right-color: #C0DBEA;
            border-bottom: 1px solid #C0DBEA;
            --speed: 0.8s;
            --timing: ease-in-out;
        }

    @@keyframes rotate {
        0%
    {
        transform: rotate(0);
    }
    100% {
        transform: rotate(360deg);
    }

    }
</style>


<h1>Update Tables</h1>
<div class="circle-loader" style="display: none;">
    <div class="container">
        Loading...
        <div class="spinner-part"></div>
        <div class="spinner-part"></div>
        <div class="spinner-part"></div>
    </div>
</div>
<button id="btn-update" type="button" class="btn btn-primary">
    <i class="fa fa-save"></i> Update Table
</button>

