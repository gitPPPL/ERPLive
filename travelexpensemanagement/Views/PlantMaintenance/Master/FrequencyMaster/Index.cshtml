@{
	ViewBag.Title = "Frequency Master";
	Layout = "~/Views/Shared/_Layout.cshtml";
} 

@* loader *@  
<div class="circle-loader" style="display: none;">
	<div class="container">
		Loading...
		<div class="spinner-part"></div>
		<div class="spinner-part"></div>
		<div class="spinner-part"></div>
	</div>
</div>

<fieldset>
	<legend class="legend-field">Frequency Master</legend>
	<div class="row">
		<div class="offset-md-8 col-md-4">
			<div class="button-right">
				<button onclick="window.location.href='@Url.Action("Index", "FrequencyMasterList")'" type="button" class="btn btn-draft">
					<i class="fa fa-list"></i>Back to list
				</button>
			</div>
		</div>
	</div>
	<form id="FrequencyMasterForm">
		<input type="hidden" class="form-control" id="CODE" name="Code">
		<div class="row">
			<div class="col-md-3">
				<div class="form-group">
					<label>Frequency Name</label>
					<input type="text" class="form-control" id="txtFreqName" name="Name" placeholder="Enter Frequency Name">
				</div>

			</div>
			<div class="col-md-3">
				<div class="form-group">
					<label>ShortName</label>
					<input type="text" class="form-control" id="txtShortName" name="ShortName" placeholder="Enter Short Name">
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<label>Days</label>
					<input type="number" class="form-control" id="Days" name="Days" placeholder="Enter Days">
				</div>
			</div>
			<div class="col-md-3">
				<div class="btn-mt">
					<div class="toggle-wrapper justify-content-center" id="ddlActive">
						<input type="hidden" id="IsActive" name="IsActive" value="1">
						<div id="customToggle" class="custom-toggle active"></div>
						<span id="statusLabel" class="status-label 0 active">Active</span>
					</div>
				</div>
			</div>
		</div>
		
		<div class="row">
			<div class="offset-md-9 col-md-3">
				<div class="button-right btn-mt">
					<button id="btnSave" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
				</div>
			</div>
		</div>
	</form>
</fieldset>

<script>
	//==============FOR TOGGLE==================
	document.addEventListener("DOMContentLoaded", function () {
		const toggle = document.getElementById('customToggle');
		const label = document.getElementById('statusLabel');
		const hiddenInput = document.getElementById('IsActive');
		toggle.addEventListener('click', function () {
			toggle.classList.toggle('active');
			const isActive = toggle.classList.contains('active');

			label.textContent = isActive ? 'Active' : 'Inactive';
			label.classList.toggle('active', isActive);
			label.classList.toggle('inactive', !isActive);

			hiddenInput.value = isActive ? '1' : '0';

			console.log("Toggle value:", hiddenInput.value);
		});
	});

	$(document).ready(function(){
		const urlParams= new URLSearchParams(window.location.search);
		const code= urlParams.get('code');
		const mode= new URLSearchParams(window.location.search).get('mode');

		//========Readonly Mode=======
		if(mode==='view'){
			$('#FrequencyMasterForm input').prop('readonly', true);
			$('#customToggle').css('pointer-events', 'none');
			$('#btnSave').hide();
		}

		if(code){
		  loadDataOnEdit(code);
		}
		//========Save and Update Data=============
		$('#btnSave').on('click',function(e){
			e.preventDefault();

			if (!validateRequiredField('#txtFreqName', 'Name')) return;
			if (!validateRequiredField('#Days', 'Day')) return;
			
			var codeVal = $('#CODE').val() || 0;
			var formData={
				CODE:codeVal,
				NAME:$('#txtFreqName').val(),
				SHORTNAME:$('#txtShortName').val(),
				DAYS:$('#Days').val() || 0,
				ACTIVE:$('#IsActive').val() || 0,
				Action:codeVal > 0 ? "Update" :"Insert"
			}
			console.log("FormData",formData);
				//show loader
		    $('.circle-loader').css('display', 'flex');

			$.ajax({
				url:'/FrequencyMaster/SaveAndUpdateData',
				type:'Post',
			    contentType:'application/json; charset=utf-8',
				data:JSON.stringify(formData),
				success:function(res){
					if(res.success){
						if(formData.Action=="Insert") showFlashMessageByKey('insert','success');
						else showFlashMessageByKey('update','success');

						setTimeout(function(){
							window.location.href='/FrequencyMasterList/Index';
						},500)
					}
					else{
						toastr.warning("Data Saved Failed !!");
					}
				},
				error:function(xhr){
				    let msg = xhr.responseText || "Unexpected error occurred";
	                toastr.error(msg);
				},
				complete: function () {
				  $('.circle-loader').css('display', 'none');
				}
			});
		});
	});

	//======Load Data on Edit=======
	function loadDataOnEdit(code){
			//show loader
	    $('.circle-loader').css('display', 'flex');

		$.ajax({
			url:'/FrequencyMaster/loadDataOnEdit',
			type:'Get',
			data:{code:code},
			success: function(res){
				if(res.success){
					const data= res.data;
					console.log("Data", data);

					$('#CODE').val(data.code);
					$('#txtFreqName').val(data.name);
					$('#txtShortName').val(data.shortName);
					$('#Days').val(data.days);
					$('#IsActive').val(data.active);

					const toggle = document.getElementById('customToggle');
					const label = document.getElementById('statusLabel');
					if(data.active == 1){
						toggle.classList.add('active');
						label.textContent = 'Active';
						label.classList.add('active');
						label.classList.remove('inactive');
					} else {
						toggle.classList.remove('active');
						label.textContent = 'Inactive';
						label.classList.remove('active');
						label.classList.add('inactive');
					}
				} else{
					toastr.warning("Data load Failed");
				}
			},
			error:function(xhr){
			  let msg = xhr.responseText || "Unexpected error occurred";
	          toastr.error(msg);
			},
			complete: function () {
				//hide loader 
			 $('.circle-loader').css('display', 'none');
			}
		});
	}
</script>