@{
    ViewBag.Title = "Maintenance Status ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="circle-loader" style="display: none;">
    <div class="container">
        Loading...
        <div class="spinner-part"></div>
        <div class="spinner-part"></div>
        <div class="spinner-part"></div>
    </div>
</div>
<fieldset>
    <legend class="legend-field">Maintenance Status</legend>
    <div class="row">
        <div class="offset-md-8 col-md-4">
            <div class="button-right">
