</fieldset>
<script>
        // Section Radio Buttons and Dropdown
    const erpSelectedSection = document.querySelector("input[name='section'][value='selected']");
    const erpAllSection = document.querySelector("input[name='section'][value='all']");
    const erpDropdownSection = document.getElementById("erp-dropdown-section");

    // Place Radio Buttons and Dropdown
    const erpSelectedPlace = document.querySelector("input[name='place'][value='selected']");
    const erpAllPlace = document.querySelector("input[name='place'][value='all']");
    const erpDropdownPlace = document.getElementById("erp-dropdown-place");

    // Add event listeners for "Section" radio buttons
    erpSelectedSection.addEventListener("change", function() {
        if (erpSelectedSection.checked) {
            erpDropdownSection.style.display = "block";  // Show dropdown
        }
    });

    erpAllSection.addEventListener("change", function() {
        if (erpAllSection.checked) {
            erpDropdownSection.style.display = "none";  // Hide dropdown
        }
    });

    // Add event listeners for "Place" radio buttons
    erpSelectedPlace.addEventListener("change", function() {
        if (erpSelectedPlace.checked) {
            erpDropdownPlace.style.display = "block";  // Show dropdown
        }
    });

    erpAllPlace.addEventListener("change", function() {
        if (erpAllPlace.checked) {
            erpDropdownPlace.style.display = "none";  // Hide dropdown
        }
    });
</script>

<script>
    let activity = [];
    let checkList = [];
    let frequency = [];
    let category = [];

    let $activityTbody;
    let $sparesTbody;
    let $resourceTbody;

    $(document).ready(function () {

        $activityTbody = $('#tblActivityList tbody');
        $sparesTbody = $('#tblSparesDetails tbody');
        $resourceTbody = $('#tblResourceDetails tbody');

    });
    /* ================= ACTIVITY TABLE ================= */

    function addActivityRow(data = {}) {

        $activityTbody.find('.btn-add-action').remove();

        let activityOptions = '<option value="">--Select Activity--</option>';
        activity.forEach(function(item){
            activityOptions += '<option value="'+ item.value +'">'+ item.text +'</option>';
        });

        let checklistOptions = '<option value="">--Select Checklist--</option>';
        checkList.forEach(function(item){
            checklistOptions += '<option value="'+ item.value +'">'+ item.text +'</option>';
        });

        let frequencyOptions = '<option value="">--Select Frequency--</option>';
        frequency.forEach(function(item){
            frequencyOptions += '<option value="'+ item.value +'">'+ item.text +'</option>';
        });

        let CategoryOptions = '<option value="">--Select Category--</option>';
        category.forEach(function(item){
            CategoryOptions += '<option value="'+ item.value +'">'+ item.text +'</option>';
        });

        const row = `
            <tr>

                <td style="display:none;">${data.code || ''}</td>

                <td>
                   <select class="form-control ddlActivity">${activityOptions} </select>
                </td>

                <td>
                  <select class="form-control ddlCategory">${CategoryOptions} </select>
                </td>

                <td>
                   <select class="form-control ddlChecklist">${checklistOptions}</select>
                </td>

                <td>
                   <select class="form-control ddlFrequency">${frequencyOptions} </select>
                </td>

                <td>
                   <input type="date" class="form-control txtStartDate">
                </td>

                <td>
                   <input type="date" class="form-control txtEndDate">
                </td>

                <td>
                   <input type="text" class="form-control txtStatus">
                </td>

                <td>
                   <input type="text" class="form-control txtRemarks">
                </td>

                <td>
                    <i class="fa fa-plus btn-add-action text-success" style="cursor:pointer;"></i>
                    <i class="fa fa-trash btn-delete-action text-danger" style="cursor:pointer;margin-left:8px;"></i>
                </td>

            </tr>`;

        $activityTbody.append(row);

    }

    /* ================= SPARES TABLE ================= */

    function addSparesRow(data = {}) {

        $sparesTbody.find('.btn-add-action').remove();

        const row = `
            <tr>

                <td style="display:none;">${data.code || ''}</td>

                <td>
                   <select class="form-control ddlItemName" style="width:100%"></select>
               </td>

                <td>
                   <input type="number" class="form-control txtQty">
                </td>

                <td>
                   <input type="text" class="form-control txtRemarks">
                </td>

                <td>
                    <i class="fa fa-plus btn-add-action text-success" style="cursor:pointer;"></i>
                    <i class="fa fa-trash btn-delete-action text-danger" style="cursor:pointer;margin-left:8px;"></i>
                </td>

            </tr>`;

        $sparesTbody.append(row);
        initItemSearch();
    }
    /* ================= RESOURCE TABLE ================= */

    function addResourceRow(data = {}) {

        $resourceTbody.find('.btn-add-action').remove();

        const row = `
            <tr>

                <td style="display:none;">${data.code || ''}</td>

                    <td>
                       <select class="form-control ddlEmployee" style="width:100%"></select>
                    </td>

                    <td>
                       <input type="date" class="form-control txtStartDate">
                    </td>

                    <td>
                       <input type="date" class="form-control txtEndDate">
                    </td>

                    <td>
                       <input type="number" class="form-control txtHours">
                    </td>

                    <td>
                       <input type="text" class="form-control txtRemarks">
                    </td>

                <td>
                    <i class="fa fa-plus btn-add-action text-success" style="cursor:pointer;"></i>
                    <i class="fa fa-trash btn-delete-action text-danger" style="cursor:pointer;margin-left:8px;"></i>
                </td>

            </tr>`;

        $resourceTbody.append(row);
        initEmployeeSearch();
    }

    /* ================= ADD ROW EVENTS ================= */

    $(document).on('click', '#activity .btn-add-row, #activity .btn-add-action', function () {
        addActivityRow();
    });

    $(document).on('click', '#spares .btn-add-row, #spares .btn-add-action', function () {
        addSparesRow();
    });

    $(document).on('click', '#Resource .btn-add-row, #Resource .btn-add-action', function () {
        addResourceRow();
    });


    /* ================= DELETE ROW ================= */

    $(document).on('click', '.btn-delete-action', function () {

        const $row = $(this).closest('tr');
        const $tbody = $row.closest('tbody');
        const isLastRow = $row.is(':last-child');

        $row.remove();

        if (isLastRow) {

            const $lastRow = $tbody.find('tr:last');

            if ($lastRow.length > 0 && $lastRow.find('.btn-add-action').length === 0) {

                $lastRow.find('td:last').prepend(
                    `<i class="fa fa-plus btn-add-action text-success" style="cursor:pointer;"></i>`
                );

            }

        }

    });

</script>

@* Main Script *@
<script>
    let isEditMode = false;
    $(document).ready(function(){
      const urlParams = new URLSearchParams(location.search);
      const docId= urlParams.get('docId');
      const mode = new URLSearchParams(window.location.search).get('mode');

         setCurrentDate();
         if(mode === "view"){
              ReadOnlyMode();
         }

         //=====Load all dropdown========
         loadAllDropdowns().then(function(){
             addActivityRow();
             addSparesRow();
             addResourceRow();
             if(docId){
                 isEditMode = true;
                 loadListData(docId);
             } else {
                 GetVNo();
             }
         });
          
         //=========Save and Update Data=========
         $('#btnSave').on('click', function (e) {
            e.preventDefault();

            let activityDetails = [];
            let sparesDetails = [];
            let resourceDetails = [];

            //================= ACTIVITY TABLE =================
            $('#tblActivityList tbody tr').each(function () {
                let row = {
                    ACT_CODE: $(this).find('.ddlActivity').val(),
                    ACT_NAME: $(this).find('.ddlActivity option:selected').text(),
                    CAT_CODE: $(this).find('.ddlCategory').val(),
                    CAT_NAME: $(this).find('.ddlCategory option:selected').text(),
                    CHK_CODE: $(this).find('.ddlChecklist').val(),
                    CHK_NAME: $(this).find('.ddlChecklist option:selected').text(),
                    FREQUENCY: $(this).find('.ddlFrequency option:selected').text(),
                    AS_DATE: $(this).find('.txtStartDate').val(),
                    AE_DATE: $(this).find('.txtEndDate').val(),
                    STATUS: $(this).find('.txtStatus').val(),
                    AREMARKS: $(this).find('.txtRemarks').val()
                };
                activityDetails.push(row);
            });
            //================= SPARES TABLE =================
            $('#tblSparesDetails tbody tr').each(function () {
                let row = {
                    SITEM_CODE: $(this).find('.ddlItemName').val(),
                    SITEM_NAME: $(this).find('.ddlItemName option:selected').text(),
                    QUANTITY: $(this).find('.txtQty').val(),
                    SREMARKS: $(this).find('.txtRemarks').val()
                };
                sparesDetails.push(row);
            });
            //================= RESOURCE TABLE ================= 
            $('#tblResourceDetails tbody tr').each(function () {
                let row = {
                    EMP_CODE: $(this).find('.ddlEmployee').val(),
                    EMP_NAME: $(this).find('.ddlEmployee option:selected').text(),
                    FS_DATE: $(this).find('.txtStartDate').val(),
                    FE_DATE: $(this).find('.txtEndDate').val(),
                    HOUR: $(this).find('.txtHours').val(),
                    FREMARKS: $(this).find('.txtRemarks').val()
                };
                resourceDetails.push(row);
            });

            //================= MAIN MODEL =================
            let model = {
                DOC_ID: $('#docId').val(),
                V_TYPE: $('#ddlDocumentType').val(),
                V_NO: parseInt($('#NumDocNo').val()),
                V_DATE: $('#DtDocDate').val(),
                PLAN_CODE:$('#ddlPlanName').val(),
                PLAN_NAME: $('#ddlPlanName option:selected').text(),
                PLAN_NO: $('#NumPlanNo').val(),
                PLACE_CODE: $('#ddlPlace').val(),
                PLACE_NAME: $('#ddlPlace option:selected').text(),
                ITEM_NAME: $('#txtEquipment').val(),
                DEPT_CODE: $('#ddlPlanSendComplaintDept').val(),
                DEPT_NAME: $('#ddlPlanSendComplaintDept option:selected').text(),
                CLDEPT_CODE: $('#ddlResolvedDepartment').val(),
                S_DATE: $('#DtStartDate').val(),
                E_DATE: $('#DtEndDate').val(),
                CLOSE_REMARKS: $('#txtDepartmentremarks').val(),
                Action: isEditMode && $('#docId').val() ? "Update" : "Insert",

                ActivityList: activityDetails,   
                SparesList: sparesDetails,      
                FollowResource: resourceDetails
            };
               
            //================= SAVE AJAX =================
       
            $('.circle-loader').css('display', 'flex');
            $.ajax({
                url: '/MaintenanceStatus/SaveOrUpdateResult',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(model),
                success: function (res) {
                    if (res.success) {
                        if (res.isUpdate) {
                            showFlashMessageByKey('update', 'success');
                        } else {
                            showFlashMessageByKey('insert', 'success');
                        }
                        setTimeout(function(){
                            window.location.href = '/MaintenanceStatusList/Index';
                        },500)
                    }
                    else {
                        toastr.warning("Data Saved Failed");
                    }
                },
                error: function (xhr) {
                  let msg = xhr.responseText || "Unexpected error occurred";
                  toastr.error(msg);
                },
                complete: function () {
                    //====hide loader======
                   $('.circle-loader').css('display', 'none');
                }
            });

         });
    });
   
    //===Current Date=======
    function setCurrentDate() {
        let today = new Date().toISOString().split('T')[0];
        $("#DtDocDate").val(today);
    }

    //======Date Format========
    function formatDateForInput(dateStr) {
        if (!dateStr) return '';
        return dateStr.split('T')[0];
    }

    //=====Load Data on edit=======
    function loadListData(docId){
        //====show loader======
        $('.circle-loader').css('display', 'flex');
        $.ajax({
            url: '/MaintenanceStatus/LoadListData',
            type: 'GET',
            data: { docId: docId },
            success: function(res){
                if(res.success){
                    console.log("Edit Data", res);
                    const header = res.header;
                    const activity = res.activity;
                    const spares = res.spares;
                    const resources = res.resources;
                    // --- Header Fields ---
                     $('#docId').val(header.doC_ID);
                     console.log("Hidden DOC_ID after set:", $('#docId').val());
                     $('#NumDocNo').val(header.v_NO);
                     $('#DtDocDate').val(formatDateForInput(header.v_DATE));
                     $('#ddlDocumentType').val(header.v_TYPE);
                     $('#ddlPlanName').val(header.plaN_CODE);
                     $('#NumPlanNo').val(header.plaN_NO);
                     $('#ddlPlace').val(header.placE_CODE);
                     $('#txtEquipment').val(header.iteM_NAME);
                     $('#ddlPlanSendComplaintDept').val(header.depT_CODE);
                     $('#ddlResolvedDepartment').val(header.cldepT_CODE);
                     $('#DtStartDate').val(formatDateForInput(header.s_DATE));
                     $('#DtEndDate').val(formatDateForInput(header.e_DATE));
                     $('#txtDepartmentremarks').val(header.closE_REMARKS);

                    // --- Activity Table ---
                    $activityTbody.empty();
                    activity.forEach(function(a, index){
                        addActivityRow({
                            code: a.ACT_CODE,
                            ACT_CODE: a.ACT_CODE,
                            ACT_NAME: a.ACT_NAME,
                            CAT_CODE: a.CAT_CODE,
                            CAT_NAME: a.CAT_NAME,
                            CHK_CODE: a.CHK_CODE,
                            CHK_NAME: a.CHK_NAME,
                            FREQUENCY: a.FREQUENCY,
                            AS_DATE: a.AS_DATE,
                            AE_DATE: a.AE_DATE,
                            STATUS: a.STATUS,
                            AREMARKS: a.AREMARKS
                        });
                        const $row = $activityTbody.find('tr:last');
                         $row.find('.ddlActivity').val(a.acT_CODE);
                         $row.find('.ddlCategory').val(a.caT_CODE);
                         $row.find('.ddlChecklist').val(a.chK_CODE);
                         $row.find('.ddlFrequency').val(a.frequency.toString());
                         $row.find('.txtStartDate').val(formatDateForInput(a.aS_DATE));
                         $row.find('.txtEndDate').val(formatDateForInput(a.aE_DATE));
                         $row.find('.txtStatus').val(a.status);
                        $row.find('.txtRemarks').val(a.aremarks);
                    });

                    $sparesTbody.empty();
                    spares.forEach(function(s, index){
                        addSparesRow({code: s.SITEM_CODE});
                        const $row = $sparesTbody.find('tr:last');
                        const option = new Option(s.siteM_NAME, s.siteM_CODE, true, true);
                        $row.find('.ddlItemName').append(option).trigger('change');
                        $row.find('.txtQty').val(s.quantity);
                        $row.find('.txtRemarks').val(s.sremarks);
                    });

                    // --- Resource Table ---
                    $resourceTbody.empty();
                    resources.forEach(function(r, index){
                        addResourceRow({code: r.EMP_CODE});
                        const $row = $resourceTbody.find('tr:last');
                        const option = new Option(r.emP_NAME, r.emP_CODE, true, true);
                        $row.find('.ddlEmployee').append(option).trigger('change');
                        $row.find('.txtStartDate').val(formatDateForInput(r.fE_DATE));
                        $row.find('.txtEndDate').val(formatDateForInput(r.fS_DATE));
                        $row.find('.txtHours').val(r.hour);
                        $row.find('.txtRemarks').val(r.fremarks);
                    });
                }
                else{
                    console.warn("Failed to load edit data:", res.message || res);
                    toastr.error("Failed to load edit data");
                }
            },
            error: function(xhr){
                console.error("Error loading edit data:", xhr.responseText);
                toastr.error("Error loading edit data");
            },
            complete: function () {
                //====hide loader======
               $('.circle-loader').css('display', 'none');
            }
        });
    }

