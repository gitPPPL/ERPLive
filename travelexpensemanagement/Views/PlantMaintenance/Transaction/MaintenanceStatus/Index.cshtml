    function loadComplaintTable(vType) {
            //====show loader======
        $('.circle-loader').css('display', 'flex'); 
        $.ajax({
            url: '/MaintenanceStatus/GetCopyData',
            type: 'GET',
            data: { vType: vType},
            success: function (res) {
                if (res.success) {
                    let tbody = $("#tblMaintenanceStatus tbody");
                    tbody.empty();
                    $.each(res.data, function (index, item) {
                        let row = `<tr
                            data-vtype="${item.vType}"
                            data-vno="${item.vNo}"
                            data-vdate="${item.vDate}"
                            data-machine="${item.MachineName || ''}"
                            data-priority="${item.priority || ''}"
                            data-fault="${item.faultCode || ''}"
                            data-complaintdate="${item.complaintDate || ''}"
                            data-machstop="${item.machStop || ''}"
                            data-todept="${item.toDept || ''}"
                            data-todeptname="${item.to_Dept || ''}"
                            data-mcode="${item.mcode || ''}"
                            data-plancode="${item.plancode || ''}"
                            data-edate="${item.eDate || ''}"
                            data-fromdept="${item.fromDept || ''}"
                            data-prioritytext="${item.priorityText || ''}"
                            data-remarks="${item.complainT_REMARKS || ''}"
                            data-preparedby="${item.prepared_By || ''}"
                        >
                            <td><input type="checkbox" class="row-select"/></td>
                            <td>${item.vType}</td>
                            <td>${item.vNo}</td>
                            <td>${item.vDate}</td>
                            <td>${item.MachineName || ''}</td>
                            <td>${item.priority || ''}</td>
                            <td>${item.faultCode || ''}</td>
                            <td>${item.complaintDate || ''}</td>
                            <td>${item.machStop || ''}</td>
                            <td>${item.toDept || ''}</td>
                            <td>${item.to_Dept || ''}</td>
                            <td>${item.mcode || ''}</td>
                            <td>${item.plancode || ''}</td>
                            <td>${item.eDate || ''}</td>
                            <td>${item.fromDept || ''}</td>
                            <td>${item.priorityText || ''}</td>
                            <td>${item.complainT_REMARKS || ''}</td>
                            <td>${item.prepared_By || ''}</td>
                        </tr>`;
                        tbody.append(row);
                    });
                } else {
                    alert("Data load failed");
                }
            },
            error: function (xhr) {
               let msg = xhr.responseText || "Unexpected error occurred";
               toastr.error(msg);
            },
            complete: function () {
                //====hide loader======
               $('.circle-loader').css('display', 'none');
            }
        });
    }

    function getSelectedRows() {
        let selectedRow = $('.row-select:checked').closest('tr');
        if (selectedRow.length === 0) {
            toastr.warning("Please select a row");
            return;
        }
        const data = {
            vType: selectedRow.data('vtype'),
            vNo: selectedRow.data('vno'),
            vDate: selectedRow.data('vdate'),
            machine: selectedRow.data('machine'),
            priority: selectedRow.data('priority'),
            fault: selectedRow.data('fault'),
            complaintDate: selectedRow.data('complaintdate'),
            machStop: selectedRow.data('machstop'),
            toDept: selectedRow.data('todept'),
            toDeptName: selectedRow.data('todeptname'),
            mcode: selectedRow.data('mcode'),
            plancode: selectedRow.data('plancode'),
            eDate: selectedRow.data('edate'),
            fromDept: selectedRow.data('fromdept'),
            priorityText: selectedRow.data('prioritytext'),
            remarks: selectedRow.data('remarks'),
            preparedBy: selectedRow.data('preparedby')
        };

        $('#ddlDocumentType').val(data.vType);
        $('#NumDocNo').val(data.vNo);
        $('#DtDocDate').val(data.vDate);
        $('#txtEquipment').val(data.machine);
        $('#ddlPriority').val(data.priority);
        $('#DtComplaintDate').val(data.complaintDate);
        $('#NumStopDate').val(data.eDate);
        $('#txtcomplaintremarks').val(data.remarks);
        $('#ddlPreparedBy').val(data.preparedBy);
        $('#ddlPlanSendComplaintDept').val(data.fromDept);
        $('#ddlResolvedDepartment').val(data.toDept);
        $('#maintananceStatus').modal('hide');
    }
</script>

