    //====Bind DropDowns=====
    function DocTypeDDL(callback){
        return $.ajax({
            url:'/MaintenanceStatus/DocTypeDropdown',
            type:'GET',
            dataType:'json',
            success: function(res){
                if(res.success){
                    const docType = $('#ddlDocumentType');
                    docType.empty();

                    //docType.append('<option value="">--Select DocType--</option>');

                    $.each(res.data, function(index, item){
                        docType.append('<option value="' + item.value + '">' + item.text + '</option>');
                    });

                    const docIdVal = $('#docId').val();

                    if (!docIdVal) {
                        docType.prop('selectedIndex', 0); 
                        GetVNo();
                    }

                    $('#ddlDocumentType').off('change').on('change', function () {
                        const vType = $(this).val();
                        if (!vType) return;
                        GetVNo();
                    });

                    if(typeof callback==="function") callback();
                }
            },
            error:function(xhr){
                console.error("DocType Error:", xhr.responseText);
            }
        });
    }

