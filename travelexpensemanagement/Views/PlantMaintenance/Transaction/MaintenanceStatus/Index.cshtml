    function initItemSearch(){

        $('.ddlItemName').select2({

            placeholder: "Search Item",
            allowClear: true,

            ajax: {

                url: '/MaintenanceStatus/SearchItem',
                dataType: 'json',
                delay: 250,

                data: function (params) {
                    return {
                        search: params.term
                    };
                },

                processResults: function (data) {
                    return {
                        results: data.map(function(item){
                            return {
                                id: item.value,
                                text: item.text
                            };
                        })
                    };

                },
                cache: true
            }

        });

    }

    function initEmployeeSearch(){

        $('.ddlEmployee').select2({

            width:'100%',
            placeholder: "Search Employee",
            allowClear: true,

            ajax: {
                url: '/MaintenanceStatus/EmployeeDDL',
                dataType: 'json',
                delay: 250,

                data: function (params) {
                    return {
                        search: params.term
                    };
                },
                processResults: function (data) {
                    let results = [];
                    if(data.success && data.data){

                        data.data.forEach(function(item){
                            results.push({
                                id: item.value,
                                text: item.text
                            });
                        });

                    }
                    return { results: results };
                },

                cache: true
            }

        });

    }

    //====Generate VNo========
    async function GetVNo()
    {
       try
       {
          console.log("GetVNo called");
          const vType = $('#ddlDocumentType').val();
          const res = await fetch(`/MaintenanceStatus/GenerateVNo?vType=${vType}`);
          const data = await res.json();
            if (data.v_NO) {
               $('#NumDocNo').val(data.v_NO);
               const docId = vType + data.v_NO;
               console.log("DOC_ID:", docId);  
            } 
       }catch (e)
       {
         console.error(e);
       }
    }

    //======Read only mode==========
    function ReadOnlyMode() {
        $('#MaintenanceStatusForm input, #MaintenanceStatusForm textarea')
            .prop('readonly', true);

        $('#MaintenanceStatusForm select')
            .prop('disabled', true);

        $('#MaintenanceStatusForm input[type="radio"]')
            .prop('disabled', true);

        $('#tblActivityList tbody tr, #tblSparesDetails tbody tr, #tblResourceDetails tbody tr')
            .each(function () {

                $(this).find('input, textarea').prop('readonly', true);
                $(this).find('select').prop('disabled', true);
                $(this).find('select').each(function () {
                    if ($(this).hasClass('select2-hidden-accessible')) {
                        $(this).prop('disabled', true).trigger('change.select2');
                    }
                });
            });
        $('#btnSave').hide(); 
        $('#btnselectcomplaint').prop('disabled', true);
        $('.btn-add-row, .btn-add-action, .btn-delete-action').hide();
    }

</script>

