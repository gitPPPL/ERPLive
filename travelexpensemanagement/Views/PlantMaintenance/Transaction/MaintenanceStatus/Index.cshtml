<script>
    $(document).on('click', '#btnselectcomplaint', function () {
        var vType = $('#ddlDocumentType').val();
        console.log("Sending vType:", vType);
        var myModal = new bootstrap.Modal(document.getElementById('maintananceStatus'));
        myModal.show();
        loadComplaintTable(vType);
