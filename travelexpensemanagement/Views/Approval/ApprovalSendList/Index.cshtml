@{
    ViewBag.Title = "Approved List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .fixed-grid-table td {
        padding: 9px 8px !important;
    }
</style>
<div id="erp-toast-container"></div>
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>Approved List</span>
    </div>
    <div class="erppagelist-header-right">
        <button class="erppage-header-back" onclick="location.href='@Url.Action("Index", "Dashboard")'">
            <i class="fa fa-arrow-left"></i>Back to Dashboard
        </button>
    </div>
</div>
<div class="erppagelist-toolbar">
    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" id="searchBox" placeholder="Search by All Columns Name...." />
    </div>
</div>
<div class="erppagelist-container">
    <div class="excel-wrapper fixed-grid-wrapper">
        <table id="tblApprovedReceivedList" class="excel-table fixed-grid-table sortable-table resizable-table">
            <colgroup>
                <col style="display:none;"> 
                <col style="width: 125px;"> 
                <col style="width: 80px;"> 
                <col style="width: 65px;"> 
                <col style="width: 82px;"> 
                <col style="width: 121px;"> 
                <col style="width: 111px;"> 
                <col style="width: 73px;"> 
                <col style="width: 93px;"> 
                <col style="width: 91px;"> 
                <col style="width: 81px;"> 
                <col style="width: 90px;"> 
                <col style="width: 100px;"> 
            </colgroup>
            <thead>
                <tr>
                    <th style="display:none;">Code</th>
                    <th>Document Name</th>
                    <th>Voucher No</th>
                    <th>Sender</th>
                    <th>Send Date</th>
                    <th>Document Status</th>
                    <th>Approval Status</th>
                    <th>Remarks</th>
                    <th>New/Modify</th>
                    <th>Department</th>
                    <th>Originator</th>
                    <th>Origin Date</th>
                    <th>Voucher Type</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<script>
    $(document).ready(function () {
        loadDocumentStages();
        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadDocumentStages();
        });
    });
    // Load main grid
        function loadDocumentStages() {
        const searchTerm = $('#searchBox').val();
        $.ajax({
            url: '/ApprovalSendList/GetApprovalList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: searchTerm
            },
            success: function (res) {

                const docs = res.data || [];
                const tbody = $('#tblApprovedReceivedList tbody');
                tbody.empty();

                if (docs.length === 0) {
                    tbody.append(`<tr>
                        <td colspan="14" class="text-center text-muted">No records found.</td>
                    </tr>`);
                    return;
                }
                docs.forEach(doc => {

                    const formattedSendDate = doc.sendDate ? formatDate(doc.sendDate) : '';
                    const formattedOriginDate = doc.originDate ? formatDate(doc.originDate) : '';
                    tbody.append(`
                        <tr>
                            <td style="display:none;" class="usercode">${doc.user_code || ''}</td>
                            <td>${doc.docName || ''}</td>
                            <td class="vNo">${doc.vNo || ''}</td>
                            <td>${doc.sendName || ''}</td>
                            <td>${formattedSendDate}</td>
                            <td>${doc.documentStatus || 'N/A'}</td>
                            <td>${doc.approvalStatus || 'N/A'}</td>
                            <td>${doc.remarks || 'N/A'}</td>
                            <td>${doc.newModify || 'N/A'}</td>
                            <td>${doc.department || 'N/A'}</td>
                            <td>${doc.originName || ''}</td>
                            <td>${formattedOriginDate}</td>
                            <td style="display:none;">${doc.form_name || ''}</td>
                            <td class="vType">${doc.vType || ''}</td>
                        </tr>
                    `);
                });
            },
            error: function (xhr) {
                toastr.error('Error loading document stages: ' +
                    (xhr.responseJSON?.message || xhr.statusText));
            }
        });
    }
    function formatDate(date) {
        const d = new Date(date);
        const day = ("0" + d.getDate()).slice(-2);
        const month = ("0" + (d.getMonth() + 1)).slice(-2);
        const year = d.getFullYear();
        return `${day}/${month}/${year}`;
    }
</script>