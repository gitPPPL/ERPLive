@{
    ViewBag.Title = "Approved Received List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .btn-approved-action {
        position: relative;
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        border: none;
        font-size: 14px;
        cursor: pointer;
        outline: none;
        overflow: hidden;
        padding: 4px 6px;
    }
</style>
<fieldset>
    <legend class="legend-field">Approved Received List</legend>
    <div class="row">
        <div class="col-lg-6">
            <div class="input-group shadow-sm rounded-pill overflow-hidden">
                <input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
            </div>
        </div>
        <div class="col-lg-6">
            <div class="btn-rightalign">
                <button class="btn btn-draft" onclick="window.location.href='@Url.Action("Index", "Dashboard")'">
                    <i class="fas fa-chart-line"></i> Back to Dashboard
                </button>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="table-responsive">
            <table id="tblApprovedReceivedList" class="table-width">
                <thead class="table-head">
                    <tr>
                        <th style="display:none;">Code</th>
                        <td><input type="checkbox"></td>
                        <th>Document Name</th>
                        <th>Voucher No</th>
                        <th>Sender</th>
                        <th>Send Date</th>
                        <th>Document Status</th>
                        <th>Approval Status</th>
                        <th>Remarks</th>
                        <th>New/Modify</th>
                        <th>Department</th>
                        <th>Originator</th>
                        <th>Origin Date</th>
                        <th>Voucher Type</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <!-- Pagination container -->
        <div class="row">
            <div class="col-md-12">
                <div class="pagination-end">
                    <div class="custom-pagination" id="tablePagination"></div>
                </div>
            </div>
        </div>
    </div>
    @* Modal Popup *@
    <div class="modal fade" id="ApprovedModal" tabindex="-1" aria-labelledby="ApprovedLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content draggable-modal">
                <div class="popup-header">
                    <h5 class="popup-title" id="ApprovedLabel">Document Approval Window</h5>
                    <i class="fa fa-times" data-bs-dismiss="modal" style="cursor: pointer;" aria-label="Close"></i>
                </div>
                <div class="modal-body">
                    <fieldset>
                        <legend class="sub-legend">Approval User</legend>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="ddlApprovalStatus">Approval Status</label>
                                    <select class="form-control" id="ddlApprovalStatus">
                                        <option value="">Select Approval Status</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="ddlForwardTo">Forward to</label>
                                    <select class="form-control" id="ddlForwardTo">
                                        <option value="">Select Forward to</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="TxtRemarks">Remarks</label>
                                    <select class="form-control" id="ddlRemarks">
                                        <option value="">Select Forward to</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="offset-md-4 col-md-8">
                                <div class="button-right">
                                    <button type="button" class="btn btn-success" id="btn_sendapproval"><i class="fa fa-paper-plane"></i> Send Approval</button>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>
    </div>
</fieldset>

<script>
    let currentPage = 1;
    let pageSize = 10;
    $(document).ready(function () {
        loadDocumentStages();
        ddlApprovalStatus();
        ddlRemarks();
        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadDocumentStages();
        });
    });
    // Load main grid
    function loadDocumentStages() {
        const searchTerm = $('#searchBox').val();
        $.ajax({
            url: '/ApprovalReceivedList/GetApprovalList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                console.log('kks',res)
                const docs = res.data || []; 
                const totalCount = res.totalCount || 0;

                const tbody = $('#tblApprovedReceivedList tbody');
                tbody.empty();
                if (docs.length === 0) {
                    tbody.append(`<tr><td colspan="14" class="text-center text-muted">No records found.</td></tr>`);
                    renderPagination(0, pageSize, currentPage);
                    return;
                }
                docs.forEach(doc => {
                    const formattedSendDate = doc.sendDate ? formatDate(doc.sendDate) : '';
                    const formattedOriginDate = doc.originDate ? formatDate(doc.originDate) : '';
                    tbody.append(`
                        <tr>
                         <td style="display:none;" class="usercode">${doc.user_code || ''}</td>
                            <td><input type="checkbox"></td>
                            <td>${doc.docName || ''}</td>
                            <td class="vNo">${doc.vNo || ''}</td>
                            <td>${doc.sendName || ''}</td>
                            <td>${formattedSendDate}</td>
                            <td>${doc.documentStatus || 'N/A'}</td>
                            <td>${doc.approvalStatus || 'N/A'}</td>
                            <td>${doc.remarkName || 'N/A'}</td>
                            <td>${doc.newModify || 'N/A'}</td>
                            <td>${doc.department || 'N/A'}</td>
                            <td>${doc.originName || ''}</td>
                            <td>${formattedOriginDate}</td>
                            <td style="display:none;">${doc.form_name || ''}</td>
                            <td class="vType">${doc.vType || ''}</td>
                            <td>
                                <div class="action-icons">
                                    <i class="fa fa-check btn-view" title="View" onclick="Approvedpopup(this)"></i>
                                </div>
                            </td>
                        </tr>
                    `);
                });
                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                toastr.error('Error loading document stages: ' + (xhr.responseJSON?.message || xhr.statusText));
            }
        });
    }
    function formatDate(date) {
        const d = new Date(date);
        const day = ("0" + d.getDate()).slice(-2); 
        const month = ("0" + (d.getMonth() + 1)).slice(-2);
        const year = d.getFullYear();
        return `${day}/${month}/${year}`;
    }
    // Pagination rendering
    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const pagination = $('#tablePagination');
        pagination.empty();

        if (totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        const startPage = Math.max(1, currentPage - 2);
        const endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
            html += `
                <button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        pagination.html(html);
    }
    function goToPage(page) {
        currentPage = page;
        loadDocumentStages();
    }
    function Approvedpopup(button) {
        var isChecked = $('#tblApprovedReceivedList tbody input[type="checkbox"]:checked').length > 0;
        if (isChecked) {
        $('#ApprovedModal').modal('show');
        const row = $(button).closest('tr');
        const userCode = row.find('.usercode').text();
        const vNo = row.find('.vNo').text();
        const vType = row.find('.vType').text();
        $.ajax({
            url: '/ApprovalReceivedList/GetForwardto',
            type: 'GET',
            data: { vNo: vNo, userCode: userCode, vType: vType },
            success: function (data) {
                var ddl = $('#ddlForwardTo');
                ddl.empty();
                ddl.append('<option value="">-- Select Forward --</option>');

                $.each(data, function (index, item) {
                    ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                });
              
                if (typeof callback === "function") callback();
            },
            error: function (xhr, status, error) {
                console.error("Error loading module: ", xhr.responseText);
                toastr.error('Error loading module: ' + error);
            }
        });
        }
        else
        {
            toastr.warning('Please select at least one document.');
        }
    }
    function ddlApprovalStatus(callback) {
        $.ajax({
            url: '/ApprovalReceivedList/GetApprovalReceived',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var ddl = $('#ddlApprovalStatus');
                ddl.empty();
                ddl.append('<option value="">-- Select Approval Status --</option>');

                $.each(data, function (index, item) {
                    ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                });
                if (typeof callback === "function") callback();
            },
            error: function (xhr, status, error) {
                console.error("Error loading module: ", xhr.responseText);
                toastr.error('Error loading module: ' + error);
            }
        });
    }
    function ddlRemarks(callback) {
        $.ajax({
            url: '/ApprovalReceivedList/GetRemarks',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var ddl = $('#ddlRemarks');
                ddl.empty();
                ddl.append('<option value="">-- Select Remarks --</option>');

                $.each(data, function (index, item) {
                    ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                });
                if (typeof callback === "function") callback();
            },
            error: function (xhr, status, error) {
                console.error("Error loading module: ", xhr.responseText);
                toastr.error('Error loading module: ' + error);
            }
        });
    }
    $('#btn_sendapproval').click(function () {
        const selectedRows = [];  
        if (!validateRequiredField('#ddlApprovalStatus', 'Approval Status')) return;
        if (!validateRequiredField('#ddlForwardTo', 'Forward to')) return;
        if (!validateRequiredField('#ddlRemarks', 'Remarks')) return;

        $('#tblApprovedReceivedList tbody input[type="checkbox"]:checked').each(function () {
            var row = $(this).closest('tr'); 

            var rowData = {
                userCode: row.find('.usercode').text(),
                vNo: row.find('.vNo').text(),
                vType: row.find('.vType').text(),
                docName: row.find('td:nth-child(3)').text(), 
                sendName: row.find('td:nth-child(5)').text(),
                sendDate: row.find('td:nth-child(6)').text(), 
                documentStatus: row.find('td:nth-child(7)').text(),
                approvalStatus: $('#ddlApprovalStatus').val(), 
                remarks: $('#ddlRemarks').val(), 
                forwardTo: $('#ddlForwardTo').val(), 
                newModify: row.find('td:nth-child(10)').text(), 
                department: row.find('td:nth-child(11)').text(),
                originName: row.find('td:nth-child(12)').text(),
                originDate: row.find('td:nth-child(13)').text(), 
                form_name: row.find('td:nth-child(14)').text()
            };
            selectedRows.push(rowData);
        });
        if (selectedRows.length === 0) {
            toastr.warning('Please select at least one document.');
            return; 
        }

        console.log('Selected Row Data:', selectedRows); 
        $.ajax({
            url: '/ApprovalReceivedList/SaveApprovaldata', 
            type: 'POST',
            contentType: 'application/json', 
            data: JSON.stringify({ rows: selectedRows }), 
            success: function (response) {
                console.log('Server Response:', response);
                toastr.success('Data sent successfully');
            },
            error: function (xhr, status, error) {
                console.error('Error:', error);
                toastr.error('Error sending data');
            }
        });
    });

</script>
