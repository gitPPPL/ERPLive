@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Business Card Scanner</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/VisitorStyle.css" />

    <style>
        .media-box {
            width: 100%;
            min-height: 320px;
            border: 1px solid #ccc;
            border-radius: 8px;
            overflow: hidden;
        }

        video, img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .visiting_fieldset{
            background-color: #e9e4e4;
            margin-bottom: 10px;
            border-radius: 3px;
            padding: 10px;
        }

        .visiting_legend{
            background-color: #198754;
            color: #ffffff;
            font-size: 18px;
            border-radius: 2px;
            font-weight: 500 !important;
            padding: 0 1rem;
        }

        .loader-overlay {
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.85);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }

        .form-control:focus, .form-select:focus {
            border-color: #038119d9;
            outline: 0;
            box-shadow: 0 0 0 2px rgba(13, 110, 253, .25);
        }
         .btn-logout {
            border: 1px solid #dc3545;
            background-color: white;
            color: #dc3545;
            padding: 4px 16px;
            font-weight: 500;
            border-radius: 4px;
            text-decoration: none;
        }

            .btn-logout:hover {
                border: 1px solid #dc3545;
                background-color: #dc3545;
                color: #fff;
                padding: 4px 16px;
                font-weight: 500;
                 border-radius: 4px;
                  text-decoration: none;
            }
            .form-check-input[type=checkbox] {
                border: 1px solid #5c5c5c;
            }
    </style>
</head>

<body>
   @*  <header class="visitor_header">
        <div class="visitor_logo_container">
            <a href="/" class="visitor_logo">
                <img src="~/ProductPortfolio/images/web-logo.webp" alt="Pashupati Logo" />
            </a>
        </div>
    </header> *@
    <header class="visitor_header">
    <div class="visitor_logo_container">
        <a href="/" class="visitor_logo">
            <img src="~/ProductPortfolio/images/web-logo.webp" alt="Pashupati Logo" />
        </a>
    </div>
    <div class="visitor_logout_container">
        <a href="@Url.Action("Index", "HomeLogin")"  class="visitor_logout btn-logout">Logout</a>
    </div>
</header>

    <section class="main_body">
        <div class="container">

            <!-- 🔵 LOADER OVERLAY -->
            <div id="loaderOverlay" class="loader-overlay d-none">
                <div class="spinner-border text-success" role="status"></div>
                <div class="mt-3 fw-semibold">Saving data, please wait...</div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <select id="cameraSelect" class="form-select" onchange="switchCamera()">
                        <option value="environment">Back Camera</option>
                        <option value="user">Front Camera</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <a href="#" id="btndownloadfile">Download File</a>
                </div>
                <div class="col-md-3">
                    <input type="file" id="uploadImage" accept="image/*" class="form-control" />
                </div>
            </div>

            <section class="visiting_main_section">
                <div class="row">

                    <!-- Live Camera Feed -->
                    <div class="col-md-6">
                        <div class="camera-card">
                            <div class="camera-placeholder">
                                <video id="video" autoplay playsinline muted></video>
                                <div class="placeholder-content" id="videoPlaceholder">
                                    <i class="bi bi-camera"></i>
                                    <p>Live Camera Feed</p>
                                    <canvas id="canvas" class="d-none"></canvas>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-6">
                                <button id="cameraBtn" class="btn btn-primary" onclick="openOrCapture()">Open Camera</button>
                            </div>
                            <div class="col-6">
                                <button id="ReloadBtn" class="btn btn-primary" onclick="reloadPage()">Refresh</button>
                            </div>
                        </div>
                    </div>

                    <!-- Captured / Uploaded Image Preview -->
                    <div class="col-md-6 d-none" id="previewColumn">
                        <div class="camera-card">
                            <div class="camera-placeholder">
                                <img id="photo" />
                                <div class="placeholder-content" id="imagePlaceholder">
                                    <i class="bi bi-person-badge"></i>
                                    <p>Captured Image Preview</p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </section>

            <hr />

            <!-- Business Card Details Form -->
            <section class="visiting_main_section">
                <h5 class="main_visitor_heading"><i class="bi bi-person-badge"></i> Business Card Details</h5>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                        <input id="txtName" class="form-control" placeholder="Enter Name *" />
                        </div>
                        </div>
                    <div class="col-md-4">
                        <div class="form-group">
                        <input id="txtEmail" class="form-control" placeholder="Email Address" />
                        </div>
                        </div>
                    <div class="col-md-4">
                        <div class="form-group">
                        <input id="NumMobileNumber" class="form-control" placeholder="Mobile Number *" />
                        </div>
                        </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                        <input id="txtWeburl" class="form-control" placeholder="Website Url" />
                    </div>    
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                        <input id="txtCompany" class="form-control" placeholder="Company Name" />
                    </div>    
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                        <input id="txtAddress" class="form-control" placeholder="Address" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                        <select id="TradeType" class="form-select">
                            <option value="Manufacturer">Manufacturer</option>
                            <option value="RMSupplier">RMSupplier</option>
                            <option value="Service Provider">Service Provider</option>
                            <option value="Trader" selected>Trader</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                        <textarea id="txtOursUserFeedback" class="form-control" rows="2" placeholder="Our User Feedback"></textarea>
                    </div>
                    </div>
                </div>

                <!-- Customer / Supplier Products -->
                <div id="productTabsContent">
                    <div class="row">
                        <div class="col-md-6">
                            <fieldset class="visiting_fieldset" id="customer">
                                <legend class="visiting_legend">Customer</legend>
                                <div class="row">
                                    <div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="rGranuleschk"><label class="form-check-label">rGranules</label></div></div>
                                    <div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="rFlakeschk"><label class="form-check-label">rFlakes</label></div></div>
                                    <div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="rPSFchk"><label class="form-check-label">rPSF</label></div></div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="Fabricchk"><label class="form-check-label">Fabric</label></div></div>
                                    <div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="Sackschk"><label class="form-check-label">Sacks</label></div></div>
                                    <div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="FIBCchk"><label class="form-check-label">FIBC</label></div></div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="Polyolefinchk"><label class="form-check-label">Polyolefin</label></div></div>
                                    <div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="Otherschk"><label class="form-check-label">Others</label></div></div>
                                </div>
                            </fieldset>
                        </div>

                        <div class="col-md-6">
                            <fieldset class="visiting_fieldset" id="supplier">
                                <legend class="visiting_legend">Supplier</legend>
                                <div class="row">
                                    <div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="PetBottlechk"><label class="form-check-label">PetBottle</label></div></div>
                                    <div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="PetLumpschk"><label class="form-check-label">Pet Lumps</label></div></div>
                                    <div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="PetWastechk"><label class="form-check-label">Pet Waste</label></div></div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="PolyolefinRMchk"><label class="form-check-label">PolyolefinRM</label></div></div>
                                    <div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="Fillerchk"><label class="form-check-label">Filler</label></div></div>
                                    <div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="OtherschkSup"><label class="form-check-label">Others</label></div></div>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>

                <button class="btn btn-primary mt-3" onclick="saveData()">Submit</button>
            </section>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const video = document.getElementById("video");
        const canvas = document.getElementById("canvas");
        const photo = document.getElementById("photo");
        const cameraSelect = document.getElementById("cameraSelect");
        const cameraBtn = document.getElementById("cameraBtn");
        const previewColumn = document.getElementById("previewColumn");

        const imagePlaceholder = document.getElementById("imagePlaceholder");
        const videoPlaceholder = document.getElementById("videoPlaceholder");

        const txtName = document.getElementById("txtName");
        const NumMobileNumber = document.getElementById("NumMobileNumber");
        const txtEmail = document.getElementById("txtEmail");
        const txtCompany = document.getElementById("txtCompany");
        const txtAddress = document.getElementById("txtAddress");
        const TradeType = document.getElementById("TradeType");
        const txtOursUserFeedback = document.getElementById("txtOursUserFeedback");
        const txtWeburl = document.getElementById("txtWeburl");
        const uploadImage = document.getElementById("uploadImage");

        let stream = null;
        let opened = false;
        let ocrText = "";

        function showLoader() { document.getElementById("loaderOverlay").classList.remove("d-none"); }
        function hideLoader() { document.getElementById("loaderOverlay").classList.add("d-none"); }

        // ================= Camera Open / Capture =================
        async function openOrCapture() {
            try {
                if (!opened) {
                    clearForm();
                    previewColumn.classList.add("d-none");
                    imagePlaceholder.style.display = "flex";
                    videoPlaceholder.style.display = "block";

                    if (stream) stream.getTracks().forEach(t => t.stop());

                    const constraints = { video: { facingMode: cameraSelect.value, width: { ideal: 1920 }, height: { ideal: 1080 } } };
                    stream = await navigator.mediaDevices.getUserMedia(constraints);
                    video.srcObject = stream;
                    opened = true;
                    cameraBtn.innerText = "Take Photo";
                } else {
                    // Capture photo
                    canvas.width = video.videoWidth;
                    canvas.height = video.videoHeight;
                    canvas.getContext("2d").drawImage(video, 0, 0, canvas.width, canvas.height);

                    const base64 = canvas.toDataURL("image/jpeg", 1.0);
                    showCapturedImage(base64);
                }
            } catch (err) {
                alert("Camera access failed ❌");
                console.error(err);
            }
        }

        function switchCamera() {
            if (!opened) return;
            if (stream) stream.getTracks().forEach(t => t.stop());
            navigator.mediaDevices.getUserMedia({ video: { facingMode: cameraSelect.value } })
                .then(s => { stream = s; video.srcObject = s; });
        }

        function showCapturedImage(base64) {
            photo.src = base64;
            photo.style.display = "block";
            video.style.display = "none";
            videoPlaceholder.style.display = "none";
            imagePlaceholder.style.display = "none";
            previewColumn.classList.remove("d-none");
            if (stream) stream.getTracks().forEach(t => t.stop());
            opened = false;
            cameraBtn.innerText = "Open Camera";
            scanOCR(base64);
        }

        // ================= File Upload =================
        uploadImage.addEventListener("change", function () {
            const file = this.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (e) {
                const base64 = e.target.result;
                showCapturedImage(base64);
            };
            reader.readAsDataURL(file);
        });


         function formatMobileNumber(mobile) {
        if (!mobile) return "";

        // Remove space, +, -, (), etc.
        let digits = mobile.replace(/\D/g, "");

        // Take last 10 digits
        if (digits.length > 10) {
            digits = digits.slice(-10);
        }
        return digits;
    }

        // ================= OCR =================
        function scanOCR(img) {
            fetch('/Testpage/ScanBase64', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ imageData: img })
            })
            .then(r => r.json())
            .then(d => {
                txtName.value = d.name || "";
                txtCompany.value = d.company || "";
                txtEmail.value = d.email || "";
                // NumMobileNumber.value = d.phone || "";
                 NumMobileNumber.value = formatMobileNumber(d.phone);
                txtAddress.value = d.address || "";
                ocrText = d.ocrText || "";
            })
            .catch(err => { console.error(err); alert("OCR failed ❌"); });
        }

        // ================= Save Data =================
        function getCheckedValues(containerId) {
            return Array.from(document.querySelectorAll(`#${containerId} input[type="checkbox"]:checked`))
                        .map(cb => cb.id.replace('chk',''));
        }
        function saveData() {
            const name = txtName.value.trim();
            const mobile = NumMobileNumber.value.trim();
            const email = txtEmail.value.trim();

            if (!name) { alert("Name is required"); txtName.focus(); return; }
            if (!email) { alert("Email is required"); txtEmail.focus(); return; }
            if (!mobile) { alert("Mobile number is required"); NumMobileNumber.focus(); return; }
            if (!/^[6-9]\d{9}$/.test(mobile)) { alert("Enter valid 10-digit mobile number"); NumMobileNumber.focus(); return; }

            showLoader();

            const obj = {
                Name: name,
                MobileNo: mobile,
                Email: txtEmail.value || null,
                Company: txtCompany.value || null,
                Address: txtAddress.value || null,
                TradeType: TradeType.value || null,
                UserFeedback: txtOursUserFeedback.value || null,
                ImageBase64: photo.src || null,
                OcrText: ocrText || null,
                CustomerProducts: getCheckedValues("customer") || null,
                SupplierProducts: getCheckedValues("supplier") || null,
                DeviceId: getDeviceInfo().deviceId,
                DeviceName: getDeviceInfo().deviceName,
                Website: txtWeburl.value || null
            };

            fetch('/Testpage/SaveBusinessCard', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(obj)
            })
            .then(r => r.json())
            .then(d => { 
                hideLoader(); 
                alert(d.message); 
                clearForm();
                location.reload();

            })
            .catch(err => { hideLoader(); console.error(err); alert("Save failed ❌"); });
        }

       function clearForm() {
    txtName.value = "";
    NumMobileNumber.value = "";
    txtEmail.value = "";
    txtCompany.value = "";
    txtAddress.value = "";
    TradeType.value = "Trader";
    txtOursUserFeedback.value = "";
    txtWeburl.value = "";
    photo.src = "";
    ocrText = "";

    document
        .querySelectorAll('input[type="checkbox"]')
        .forEach(cb => cb.checked = false);
}


        function reloadPage() { location.reload(); }

        function getDeviceInfo() {
            let deviceId = localStorage.getItem("DEVICE_ID");
            if (!deviceId) { deviceId = 'DEV-' + crypto.randomUUID(); localStorage.setItem("DEVICE_ID", deviceId); }
            let deviceType = /Mobi/i.test(navigator.userAgent) ? "Mobile" : (/Tablet|iPad/i.test(navigator.userAgent) ? "Tablet" : "Desktop");
            return { deviceId: deviceId, deviceName: deviceType + " - " + navigator.platform, userAgent: navigator.userAgent };
        }

        // ================= Download Excel =================
        document.getElementById("btndownloadfile").addEventListener("click", function (e) {
            e.preventDefault();
            window.location.href = "/Testpage/DownloadBusinessCards";
        });

        video.addEventListener("loadedmetadata", () => { videoPlaceholder.style.display = "none"; });
    </script>
</body>
</html>
