            float: none !important;
        }

        .form-control:focus {
            color: var(--bs-body-color);
            background-color: var(--bs-body-bg);
            border-color: #038119d9;
            outline: 0;
            box-shadow: 0 0 0 2px rgba(13, 110, 253, .25);
