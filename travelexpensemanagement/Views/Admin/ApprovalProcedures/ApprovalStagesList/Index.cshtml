@{
	ViewBag.Title = "Approval Stages List";
	Layout = "~/Views/Shared/_Layout.cshtml";

}
<div id="erp-toast-container"></div>
<!-- HEADER -->
<div class="erppagelist-header">
	<div class="erppagelist-title">
		<i class="fa fa-list"></i>
		<span>Approval Stages List</span>
	</div>
	<div class="erppagelist-header-right">
		<button class="erppage-header-back" onclick="location.href='@Url.Action("Index", "ApprovalStages")'">
			<i class="fa fa-plus"></i>Add New
		</button>
	</div>
</div>
<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
	<div class="erppagelist-search-wrapper">
		<i class="fa fa-search"></i>
		<input type="text" id="searchBox" placeholder="Search by All Columns Name...." />
	</div>
	<div class="erppagelist-actions">
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" onclick="printCityMasterReport()">
			<i class="fa fa-print"></i> Print
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Export to Excel">
			<i class="fa fa-file-excel"></i> Export
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail">
			<i class="fa fa-envelope"></i>Mail
		</button>
		<button class="erppagelist-btn erppagelist-btn-approve tooltip-btn" data-tooltip="Approve Records">
			<i class="fa fa-check-circle"></i>Approved
		</button>
	</div>
</div>
<div class="erppagelist-container">
	<div class="excel-wrapper fixed-grid-wrapper">
		<table id="tblApprovalStagesList" class="excel-table fixed-grid-table resizable-table sortable-table">
			<colgroup>
				<col style="display:none;" />  <!-- Code (hidden) -->
				<col style="width: 120px;" />  <!-- Doc Code1 -->
				<col style="width: 200px;" />  <!-- Name -->
				<col style="width: 120px;" />  <!-- Action -->
			</colgroup>
			<thead>
				<tr>
					<th class="hidden-col" data-column="0">
						Code <span class="sort-icon"></span>
					</th>

					<th data-column="1">
						Doc Code1 <span class="sort-icon"></span>
					</th>

					<th data-column="2">
						Name <span class="sort-icon"></span>
					</th>
					<th class="action-col">
						Action
					</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>

	<div class="erppagelist-pagination">
		<div class="pagination-left">
			<select id="pageSizeSelect" onchange="changeRowsPerPage()">
				<option value="5">5</option>
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
			</select>
		</div>
		<div class="pagination-center">
			<button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
			<div id="pageNumbers" class="page-numbers"></div>

			<button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
		</div>
		<div class="pagination-right" id="pageInfoText">
			Results: 0 - 0 of 0
		</div>
	</div>
</div>



<script>

	let currentPage = 1;
	let pageSize = 10;

	$(document).ready(function () {
		loadAllMenus();

		$('#searchBox').on('keyup', function () {
			currentPage = 1;
			loadAllMenus();
		});
	});

	//Load main grid...............
	function loadAllMenus() {
			  const searchTerm = $('#searchBox').val();

			  $.ajax({
				url: '/ApprovalStagesList/GetDataList',
				type: 'GET',
				dataType: 'json',
				data: {
				  searchTerm: searchTerm,
				  pageNumber: currentPage,
				  pageSize: pageSize
				},
				success: function (res) {

				 if (!res.success) {
				toastr.error("Failed to load data.");
				return;
			}

				  const TemperatureList = res.lists;
				  const totalCount = res.totalCount;
				  console.log('ss', res.lists);

				  let tbody = $('#tblApprovalStagesList tbody');
				  tbody.empty();

				  if (TemperatureList.length === 0) {
					tbody.append('<tr><td colspan="8" class="text-center text-muted">No ?lIST found.</td></tr>');
				  } else {
				$.each(TemperatureList, function (index, item) {
			  $('#tblApprovalStagesList tbody').append(`
				<tr>

					<td>${item.doC_CODE}</td>
					<td>${item.fullname}</td>

				  <td class="action-col">
						<button class="act-btn edit" title="Edit Row" style="cursor:pointer;" onclick="AddOrEditFunction('${item.doC_CODE}')"><i class="fa fa-edit"></i></button>
						<button class="act-btn view" title="View Detail" style="cursor:pointer;"  onclick="viewMenuDetails('${item.doC_CODE}')"><i class="fa fa-eye"></i></button>
						<button class="act-btn delete  btn-delete" title="Delete Row" style="cursor:pointer;" onclick="deleteTemp('${item.doC_CODE}')"><i class="fa fa-trash"></i></button>
						
				  </td>
				</tr>
			  `);
			});

					renderPagination(totalCount, pageSize, currentPage);
				  }
				},
				error: function (xhr) {
				  toastr.error('Error loading menu list: ' + xhr.responseText);
				}
			  });
			}







	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const pagination = $('#tablePagination');
		pagination.empty();

		if (totalPages <= 1) return;

		let html = '';

		if (currentPage > 1) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		const startPage = Math.max(1, currentPage - 2);
		const endPage = Math.min(totalPages, currentPage + 2);

		for (let i = startPage; i <= endPage; i++) {
			html += `
				<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
		}

		if (currentPage < totalPages) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		pagination.html(html);
	}

	function goToPage(page) {
		currentPage = page;
		loadAllMenus();
	}

	function AddOrEditFunction(code)
	{
	 window.location.href = '/ApprovalStages/Index?id=' + encodeURIComponent(code);
	}

	function viewMenuDetails(code)
	{
	 window.location.href = '/ApprovalStages/Index?id=' + encodeURIComponent(code) + '&mode=view' ;
	}


	function deleteTemp(code) {
			if (!confirm('Are you sure you want to delete this  Approval Stage ?')) {
				return;
			}

			$.ajax({
				url: '/ApprovalStagesList/Delete',
				type: 'POST',
				data: { code: code },
				success: function (res) {
					if (res.success) {
						toastr.success('Deleted successfully.');
						loadAllMenus();
					} else {
						toastr.error(res.message || 'Failed to delete.');
					}
				},
				error: function () {
					toastr.error('Error deleting  Approval Stage.');
				}
			});
		}

</script>
