@{
    ViewBag.Title = "TaxCode";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentMenu = ViewBag.CurrentMenu as string;
    bool canAdd = false;
    bool canEdit = false;
    bool canDelete = false;
    bool canPrint = false;
    bool canExport = false;
    bool canMail = false;
    bool canApproval = false;
    bool canDocDetail = false;

    foreach (var permission in Model.UserMenuPermissions)
    {
        if (permission.DISPLAY_NAME == ViewBag.CurrentMenu)
        {
            canAdd = Model.UserLevel == 1 || permission._ADD == 1;
            canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
            canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
            canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
            canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
            canMail = Model.UserLevel == 1 || permission._MAIL == 1;
            canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
            canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
            break;  // Exit loop once found current menu permission
        }
    }
}
<fieldset>
    <legend class="legend-field">Tax Master List</legend>

    <div class="row">
        <div class="col-lg-6">
            <div class="input-group shadow-sm rounded-pill overflow-hidden">
                <input type="text" id="searchBox" class="form-control" placeholder="Search group name...">
            </div>
        </div>


        <div class="col-lg-6">
            <div class="btn-rightalign">
                @if (canAdd)
                {
                    <button id="btnSave" onclick="window.location.href='@Url.Action("Index", "TaxCode")'" type="submit" class="btn btn-add">
                        <i class="fa fa-plus"></i>Add
                    </button>
                }
                @if (canPrint)
                {
                    <button class="btn btn-print" onclick="callGetReportAsPdf()">
                        <i class="fa fa-print"></i> Print
                    </button>
                }
                @if (canExport)
                {
                    <button class="btn btn-export" onclick="exportToExcel()">
                        <i class="fas fa-file-export"></i> Export
                    </button>
                }
                @if (canMail)
                {
                    <button class="btn btn-mail">
                        <i class="fa fa-envelope"></i> Mail
                    </button>
                }
                @if (canApproval)
                {
                    <button class="btn btn-approved">
                        <i class="fa fa-check"></i> Approve
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table id="companyTable" class="table-width">
                <thead class="table-head">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Type</th>
                        <th>CGST%</th>
                        <th>SGST%</th>
                        <th>IGST%</th>
                        <th>TDS%</th>
                        <th>TCS%</th>
                        <th>OTH%</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
    <div id="pagination" class="mt-2">
        <button onclick="loadTaxCodeList(currentPage - 1)" id="prevPage">Previous</button>
        <span id="paginationPages"></span>
        <button onclick="loadTaxCodeList(currentPage + 1)" id="nextPage">Next</button>
    </div>
</fieldset>

<script>
    var canAdd = @canAdd.ToString().ToLower();
    var canEdit = @canEdit.ToString().ToLower();
    var canDelete = @canDelete.ToString().ToLower();
    var canPrint = @canPrint.ToString().ToLower();
    var canExport = @canExport.ToString().ToLower();
    var canMail = @canMail.ToString().ToLower();
    var canApproval = @canApproval.ToString().ToLower();
    var canDocDetail = @canDocDetail.ToString().ToLower();

    let currentPage = 1;
    const pageSize = 10;
    let totalRecords = 0;

    $(document).ready(function () {
        loadTaxCodeList();
    });

    function loadTaxCodeList(page = 1) {
        const searchTerm = $('#searchBox')?.val()?.trim() || null;

        $.ajax({
            url: '/TaxCodeList/GetTaxCodeList',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                NAME: searchTerm,
                PageNumber: page,
                PageSize: pageSize
            }),
            success: function (response) {
                console.log(response)
                if (response.success && response.data && response.data.length > 0) {
                    let rows = '';
                    $.each(response.data, function (index, item) {
                        rows += `
                        <tr>
                            <td>${item.srno}</td>
                            <td>${item.name}</td>
                            <td>${item.taX_DESCRIPTION}</td>
                            <td>${item.taX_TYPE}</td>
                            <td>${item.cgsT_PER ?? ''}</td>
                            <td>${item.sgsT_PER ?? ''}</td>
                            <td>${item.igsT_PER ?? ''}</td>
                            <td>${item.tdS_PER ?? ''}</td>
                            <td>${item.tcS_PER ?? ''}</td>
                            <td>${item.otH_PER ?? ''}</td>
                            <td>
                                ${canEdit ? `
                                    <i class="fa fa-edit editBtn btn-edit" data-code="${item.srno}" title="Edit"></i>` : ''}
                               
                                    <i class="fa fa-eye viewBtn btn-view" data-code="${item.srno}" title="View Detail"></i>
                               
                               ${canDelete ? `<i class="fa fa-trash btn-delete" data-code="${item.srno}" title="Delete"></i>` : ''}
                               ${canDocDetail ? ` <i class="fa fa-file btn-details btn-document" data-doc="${item.srno}" title="Details"></i>` : ''}
                            </td>
                        </tr>`;
                    });

                    $('#companyTable tbody').html(rows);
                    currentPage = page;
                    totalRecords = response.totalRecords;
                    updatePagination();
                } else {
                    $('#companyTable tbody').html(`<tr><td colspan="11" class="text-center text-muted">No records found.</td></tr>`);
                    $('#paginationPages').html('');
                }
            },
            error: function () {
                alert("Failed to fetch data.");
            }
        });
    }

    function updatePagination() {
        const totalPages = Math.ceil(totalRecords / pageSize);
        $('#prevPage').prop('disabled', currentPage <= 1);
        $('#nextPage').prop('disabled', currentPage >= totalPages);

        let pageButtonsHtml = '';
        for (let i = 1; i <= totalPages; i++) {
            pageButtonsHtml += `<button class="page-btn btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'}" onclick="loadTaxCodeList(${i})">${i}</button>`;
        }
        $('#paginationPages').html(pageButtonsHtml);
    }

    $(document).on('click', '.editBtn', function () {
        const code = $(this).data('code');
        window.location.href = '/TaxCode/index?srno=' + code;
    });

    $(document).on('click', '.viewBtn', function () {
        const code = $(this).data('code');
        window.location.href = '/TaxCode/index?srno=' + code + '&mode=view';
    });
    $(document).on('click', '.btn-details', function() {
        const docCode = $(this).data('doc');
        showDocumentPopup(docCode);  // Your popup function
    });

    // Optional: Delete action handler
    $(document).on('click', '.btn-delete', function () {
        const code = $(this).data('code');
        if (confirm('Are you sure you want to delete this tax code?')) {
            // You can implement AJAX call here to delete from server
            alert('Delete logic not implemented yet for ID: ' + code);
        }
    });

    // Optional: Search support if you want live filtering
    $(document).on('keyup', '#searchBox', function () {
        loadTaxCodeList(1);
    });

    // Optional: Previous/Next controls
    $(document).on('click', '#prevPage', function () {
        if (currentPage > 1) loadTaxCodeList(currentPage - 1);
    });

    $(document).on('click', '#nextPage', function () {
        const totalPages = Math.ceil(totalRecords / pageSize);
        if (currentPage < totalPages) loadTaxCodeList(currentPage + 1);
    });

    function exportToExcel() {
            fetch('/TaxCodeList/ExportAllDocs')
                .then(response => {
                    if (!response.ok) throw new Error("Network response was not ok");
                    return response.json();
                })
                .then(data => {
                    console.log("Export data:", data);
                    const filteredData = data.map(item => ({
                    Code: item.code,
                    Name: item.name,
                    Description: item.taxDescription,
                    Type: item.taxType,
                    CGST: item.cgst,
                    SGST: item.sgst,
                    IGST: item.igst,
                    TDS: item.tds,
                    TCS: item.tcs,
                    OTH: item.oth
                }));
                    const worksheet = XLSX.utils.json_to_sheet(filteredData);
                    const workbook = XLSX.utils.book_new();
                    XLSX.utils.book_append_sheet(workbook, worksheet, "AllDocs");

                    const pageName = "Tax Master";
                    const now = new Date();
                    const pad = n => String(n).padStart(2, '0');
                    const timestamp = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}_${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;

                    const fileName = `${pageName}_${timestamp}.xlsx`;
                    XLSX.writeFile(workbook, fileName);
                })
                .catch(error => {
                    console.error("Export failed:", error);
                    toastr.error("Failed to export data.");
                });
        }
    function callGetReportAsPdf() {
        var reportName = "Rpt_TaxMast";
        var now = new Date();
        var day = String(now.getDate()).padStart(2, '0');
        var month = String(now.getMonth() + 1).padStart(2, '0');
        var year = String(now.getFullYear()).slice(-2);
        var hours = String(now.getHours()).padStart(2, '0');
        var minutes = String(now.getMinutes()).padStart(2, '0');
        var seconds = String(now.getSeconds()).padStart(2, '0');
        var timestamp = `${day}${month}${year}_${hours}${minutes}${seconds}`;

        $.ajax({
            url: 'http://192.168.20.51:8082/Report/GetReportAsPdf',
            type: 'GET',
            data: { Reportname: reportName },
            xhrFields: {
                responseType: 'blob'
            },
            success: function (response) {
                console.log('PDF response:', response);
                var file = new Blob([response], { type: 'application/pdf' });
                var fileName = `${reportName}_${timestamp}.pdf`;

                var link = document.createElement('a');
                link.href = URL.createObjectURL(file);
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            },
            error: function (xhr, status, error) {
                console.error('Error generating report:', error);
            }
        });
    }
    function showDocumentPopup(docCode) {
        $.ajax({
            url: '/TaxCodeList/DocDetailsCode',
            type: 'POST',
            dataType: 'json',  // important
            data: { docCode: docCode },
            success: function(response) {
                if(response.success) {
                    showDocumentPopupjQuery(response.data, docCode);
                } else {
                    toastr.error("Failed to get document details.");
                }
            },
            error: function() {
                toastr.error("An error occurred while fetching document details.");
            }
        });
    }
</script>
