 // set vaule in textbox and dropdown list
function bindItemDeptForm(data) {
    console.log(data)
    $('#txtname').val(data?.name ?? '');
    $('#txtshortname').val(data?.shortname ?? '');
    $('#txtreporttype').val(data?.reporT_TYPE ?? '');
    $('#txtpositionno').val(data?.sorT_ON ?? '');
    $('#txtpurchasebudget').val(data?.mpurcH_BUDGET ?? '');
    $('#txtconsumpbudget').val(data?.mconsumP_BUDGET ?? '');
     ddlTransactionType().done(function () {
        $('#ddltranstype').val(data?.traN_TYPE ?? '');
    });
    ddlProductionPlace().done(function () {
        $('#ddlplacetype').val(data?.placE_TYPE ?? '');
    });
     ddlCost().done(function () {
        $('#ddlCost').val(data?.cost ?? '');
    });
    ddlPlace().done(function () {
        $('#ddlplace').val(data?.placE_CODE ?? '');
    });
     ddlUnitName().done(function () {
        $('#ddlunitytype').val(data?.uniT_TYPE ?? '');
    });
      ddlReportFilterType().done(function () {
        $('#ddlReportFilterType').val(data?.reporT_TYPE ?? '');
    });
    if (data?.active === 1) {
        $('#IsActive').val(1);
        $('#customToggle').addClass('active');
        $('#statusLabel').text('Active').addClass('active').removeClass('inactive');
    } else {
        $('#IsActive').val(0);
        $('#customToggle').removeClass('active');
        $('#statusLabel').text('Inactive').addClass('inactive').removeClass('active');
    }
}
function setFormReadOnly() {
        $('#itemForm input').prop('readonly', true);
        $('#itemForm select').prop('disabled', true);
        $('#customToggle').css('pointer-events', 'none');
        $('#btnSubmit').hide();
        $('#btnUpdate').hide();
 }
