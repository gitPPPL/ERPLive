                ACTIVE: ACTIVE,
				Cost: $('#ddlCost').val() ? parseInt($('#ddlCost').val()) : 0,
            };
			
            $.ajax({
                url: '/ItemDepartmentMaster/SaveItemDepartment',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (response) {
					if (response.success) {
