@* status check *@
<script>
	const toggle = document.getElementById('customToggle');
	const label = document.getElementById('statusLabel');

	toggle.addEventListener('click', () => {
	  toggle.classList.toggle('1');
	  const isActive = toggle.classList.contains('1');

	  label.textContent = isActive ? '1' : '0';
	  label.classList.toggle('1', isActive);
	  label.classList.toggle('0', !isActive);
	  document.getElementById('0').value = isActive ? '1' : '0';
	});
</script>
<script>
		document.addEventListener("DOMContentLoaded", function () {
		const toggle = document.getElementById('customToggle');
		const label = document.getElementById('statusLabel');
		const hiddenInput = document.getElementById('IsActive');

		// Handle toggle click
		toggle.addEventListener('click', function () {
			toggle.classList.toggle('active');
			const isActive = toggle.classList.contains('active');

			label.textContent = isActive ? 'Active' : 'Inactive';
			label.classList.toggle('active', isActive);
			label.classList.toggle('inactive', !isActive);

			hiddenInput.value = isActive ? '1' : '0';

			console.log("Toggle value:", hiddenInput.value); // Will show 1 or 0
		});
	});
	</Script>
@* Status Check end *@