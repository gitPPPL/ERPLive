@{
	ViewBag.Title = "ItemDepartmentMaster";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
	<legend class="legend-field">Item Department Master</legend>

	<div class="row">
		<div class="offset-md-10 col-md-2">
            <div class="btn-right">
			<button onclick="window.location.href='@Url.Action("Index", "ItemDepartmentList")'" type="submit" class="btn btn-primary">
				<i class="fa fa-list"></i>Back to list
			</button>
            </div>
		</div>
	</div>

<form id="itemForm" method="post">
   <input type="hidden" class="form-control" name="CODE" id="txtCODE">
   <div class="row">
      <div class="col-md-4">
         <div class="form-group">
            <label>Department Name<span class="required">*</span></label>
            <input type="text" maxlength="200" class="form-control" placeholder="Name" id="txtname">
         </div>
      </div>
      <div class="col-md-4">
         <div class="form-group">
            <label>Short Name<span class="required">*</span></label>
            <input type="text" class="form-control" maxlength="40" placeholder="Short Name" id="txtshortname">
         </div>
      </div>
      <div class="col-md-4">
         <div class="form-group">
            <label>Transaction  Type<span class="required">*</span></label>
            <select class="form-control" id="ddltranstype">
               <option value="">-- Select Option --</option>
               <option value="Production">Production</option>
               <option value="Store">Store</option>
            </select>
         </div>
      </div>
   </div>
   <div class="row">
      <div class="col-md-3">
         <div class="form-group">
            <label>Production Place<span class="required">*</span></label>
            <select class="form-control" id="ddlplacetype">
               <option value="">Select Place Type</option>
            </select>
         </div>
      </div>
      <div class="col-md-3">
         <div class="form-group">
            <label>Place Master</label>
            <select class="form-control" id="ddlplace" >
               <option value="">-- Select Option --</option>
            </select>
         </div>
      </div>
      <div class="col-md-3">
         <div class="form-group">
            <label>Unit Name</label>
            <select class="form-control" id="ddlunitytype" >
               <option value="">-- Select Option --</option>
            </select>
         </div>
      </div>
      <div class="col-md-3">
         <div class="form-group">
            <label>Cost</label>
            <select class="form-control" id="ddlCost">
               <option value="">Select Place Type</option>
            </select>
         </div>
      </div>
   </div>
   <div class="row">
      <div class="col-md-3">
         <div class="form-group">
            <label>Serial No</label>
            <input type="number" class="form-control limit-length" data-maxlength="4" placeholder="Position no" id="txtpositionno">
         </div>
      </div>
      <div class="col-md-3">
         <div class="form-group">
            <label>Report Filter Type</label>
            <select class="form-control" id="ddlReportFilterType" >
               <option value="">-- Select Option --</option>
            </select>
         </div>
      </div>
      <div class="col-md-3">
         <div class="form-group">
            <label>Monthly Budget(Purchase)</label>
            <input type="number" class="form-control limit-length" data-maxlength="9" placeholder="Purchase Budget" id="txtpurchasebudget">
         </div>
      </div>
      <div class="col-md-3">
         <div class="form-group">
            <label>Monthly Budget(Consumption)</label>
            <input type="number" class="form-control limit-length" data-maxlength="9" placeholder="Consump. Budget" id="txtconsumpbudget">
         </div>
      </div>
   </div>
   <div class="row">
      <div class="offset-md-8 col-md-2">
         <div class="form-group">
            <div class="toggle-wrapper justify-content-center" id="ddlActive">
               <input type="hidden" id="IsActive" name="IsActive" value="1" />
               <div id="customToggle" class="custom-toggle active"></div>
               <span id="statusLabel" class="status-label active">Active</span>
            </div>
         </div>
      </div>
      <div class="col-md-2">
         <div class="btn-last">
            <button type="submit" id="btnSubmit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
            <button type="button" id="btnUpdate" class="btn btn-primary"><i class="fa fa-refresh"></i>Update</button>
         </div>
      </div>
   </div>
</form>

</fieldset>

@* Check validation for all texbox start Block *@
<script>
  function limitInputLength() {
    const inputs = document.querySelectorAll('.limit-length');
    inputs.forEach(input => {
      const maxLength = parseInt(input.getAttribute('data-maxlength'), 10);
      input.addEventListener('input', () => {
        let value = input.value;
        if (input.type === 'number') {
          value = value.replace(/\D/g, '');
          if (value.length > maxLength) {
            value = value.slice(0, maxLength);
          }
          input.value = value;
        } else if (input.type === 'text') {
          if (value.length > maxLength) {
            input.value = value.slice(0, maxLength);
          }
        }
      });
    });
  }
  window.addEventListener('DOMContentLoaded', limitInputLength);
</script>
@* Check validation for all texbox End Block *@

