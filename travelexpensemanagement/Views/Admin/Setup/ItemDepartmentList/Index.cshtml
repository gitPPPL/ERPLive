@{
	ViewBag.Title = "ItemDepartmentMaster";
	Layout = "~/Views/Shared/_Layout.cshtml";
    var currentMenu = ViewBag.CurrentMenu as string;
    bool canAdd = false;
    bool canEdit = false;
    bool canDelete = false;
    bool canPrint = false;
    bool canExport = false;
    bool canMail = false;
    bool canApproval = false;
    bool canDocDetail = false;

    foreach (var permission in Model.UserMenuPermissions)
    {
        if (permission.DISPLAY_NAME == ViewBag.CurrentMenu)
        {
            canAdd = Model.UserLevel == 1 || permission._ADD == 1;
            canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
            canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
            canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
            canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
            canMail = Model.UserLevel == 1 || permission._MAIL == 1;
            canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
            canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
            break;  
        }
    }
}
<fieldset>
	<legend class="legend-field">Item Department List</legend>

    <div class="row">
        <div class="col-lg-6">
			<div class="search-input-field">
                <input type="text" id="searchBox" class="form-control" placeholder="Search Module..." aria-label="Search term">
			</div>
		</div>

        <div class="col-lg-6">
            <div class="btn-rightalign">
                @if (canAdd)
                {
                    <button onclick="window.location.href='@Url.Action("Index", "ItemDepartmentMaster")'" type="submit" class="btn btn-add">
                        <i class="fa fa-plus"></i> Add
                    </button>
                }
                @if (canPrint)
                {
                    <button class="btn btn-print" onclick="callGetReportAsPdf()">
                        <i class="fa fa-print"></i> Print
                    </button>
                }
                @if (canExport)
                {
                    <button class="btn btn-export" onclick="exportToExcel()">
                        <i class="fas fa-file-export"></i> Export
                    </button>
                }
                @if (canMail)
                {
                    <button class="btn btn-mail">
                        <i class="fa fa-envelope"></i> Mail
                    </button>
                }
                @if (canApproval)
                {
                    <button class="btn btn-approved">
                        <i class="fa fa-check"></i> Approve
                    </button>
                }
            </div>
        </div>

	</div>
	<div class="card">
		<div class="table-responsive">
			<table id="ItemGroupTable" class="table-width">
				<thead class="table-head">
					<tr>
						<th>Name</th>
						<th>Short Name</th>
						<th>Trans Type</th>
						<th>Place Type</th>
						<th>Report Type</th>
						<th>Unit Type</th>
						<th>Place</th>
						<th>Sorton</th>
						<th>Status</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
        <div class="row">
            <div class="col-md-12">
                <div class="pagination-end">
                    <div class="custom-pagination" id="tablePagination"></div>
                </div>
            </div>
        </div>
	</div>

</fieldset>
<script>
    var canAdd = @canAdd.ToString().ToLower()
    var canEdit = @canEdit.ToString().ToLower()
    var canDelete = @canDelete.ToString().ToLower()
    var canPrint = @canPrint.ToString().ToLower()
    var canExport = @canExport.ToString().ToLower()
    var canMail = @canMail.ToString().ToLower()
    var canApproval = @canApproval.ToString().ToLower()
    var canDocDetail = @canDocDetail.ToString().ToLower()

    let currentPage = 1;
    const pageSize = 10;

    $(document).ready(function () {
        loadAllDepartment(currentPage);
        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadAllDepartment(currentPage);
        });
    });

    function loadAllDepartment(page) {
        currentPage = page || 1;
        const searchTerm = $('#searchBox').val().trim();
        $.ajax({
            url: '/ItemDepartmentList/GetAllDepartment',
            type: 'GET',
            dataType: 'json',
            data: {
                pageNumber: currentPage,
                pageSize: pageSize,
                searchTerm: searchTerm
            },
            success: function (res) {
                if (res.error) {
                    alert('Error: ' + res.message);
                    return;
                }
                const groups = res.groups;
                const totalCount = res.totalCount;
                let tbody = $('#ItemGroupTable tbody');
                tbody.empty();

                if (!groups || groups.length === 0) {
                    tbody.append('<tr><td colspan="12" class="text-center text-muted">No item groups found.</td></tr>');
                    renderPagination(0, pageSize, currentPage);
                    return;
                }
                groups.forEach(group => {
                    const statusHtml = group.active === 1
                    ? '<span class="text-success fw-bold">Active</span>'
                    : '<span class="text-danger fw-bold">Inactive</span>';

                    let actionButtons = '';
                    if (canEdit) {
                        actionButtons += `<i class="fa fa-edit btn-edit" title="Edit" onclick="AddOrEditItemGroup(${group.code})"></i>`;
                    }
                    actionButtons += `<i class="fa fa-eye btn-view" title="View" onclick="viewItemGroupDetails(${group.code})"></i>`;
                    if (canDelete) {
                        actionButtons += `<i class="fa fa-trash btn-delete"  title="Delete" onclick="deleteItemGroup(${group.code})"></i>`;
                    }
                      if (canDocDetail) {
                          actionButtons += `<i class="fa fa-file btn-details btn-document" title="Details" onclick="getDocDetails('${group.code}')"></i>`;
                      }
                    tbody.append(`
                        <tr>
                            <td>${group.name || ''}</td>
                            <td>${group.shortname || ''}</td>
                            <td>${group.traN_TYPE || ''}</td>
                            <td>${group.placE_TYPE || ''}</td>
                            <td>${group.reporT_TYPE || ''}</td>
                            <td>${group.uniT_TYPE || ''}</td>
                            <td>${group.placE_CODE || ''}</td>
                            <td>${group.sorT_ON || ''}</td>
                            <td style="display:none;">${group.mpurcH_BUDGET !== null ? group.mpurcH_BUDGET : ''}</td>
                            <td style="display:none;">${group.mconsumP_BUDGET !== null ? group.mconsumP_BUDGET : ''}</td>
                            <td>${statusHtml}</td>
                            <td>${actionButtons}</td>
                        </tr>
                    `);
                });
                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                toastr.error('Error loading item group list: ' + xhr.responseText);
            }
        });
    }
    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const container = $('#tablePagination');
        container.empty();

        if (total === 0 || totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        if (currentPage <= 3) endPage = Math.min(5, totalPages);
        if (currentPage >= totalPages - 2) startPage = Math.max(totalPages - 4, 1);

        for (let i = startPage; i <= endPage; i++) {
            html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }
        container.html(html);
    }
    function goToPage(page) {
        currentPage = page;
        loadAllDepartment(currentPage);
    }
    function AddOrEditItemGroup(id) {
        window.location.href = '/ItemDepartmentMaster/Index?id=' + id;
    }
    function viewItemGroupDetails(id) {
        window.location.href = '/ItemDepartmentMaster/Index?id=' + id + '&mode=view';
    }
    function getDocDetails(docCode) {
        showDocumentPopup(docCode)
    }
    function deleteItemGroup(id) {
        confirmAction().then((confirmed) => {
            if (!confirmed) return; // User clicked "No" or dismissed

            // Proceed with delete
            $.ajax({
                url: '/ItemDepartmentList/DeleteDepartment', // Make this dynamic if needed
                type: 'POST',
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: 'Details have been successfully deleted.',
                            showConfirmButton: false,
                            timer: 2000,
                            timerProgressBar: true,
                            customClass: {
                                popup: 'swal-success-popup'
                            },
                            didOpen: () => {
                                Swal.getPopup().style.cssText +=
                                    'border: 1px solid #a5dc86; box-shadow: 0 0 15px rgba(165, 220, 134, 0.6);';
                            }
                        });

                        // Reload department data (assuming currentPage is available globally)
                        loadAllDepartment(currentPage);
                    } else {
                        Swal.fire('Error!', 'Error deleting item group: ' + res.message, 'error');
                    }
                },
                error: function (xhr) {
                    Swal.fire('Error!', 'Error deleting item group: ' + xhr.responseText, 'error');
                }
            });
        });
    }

     function exportToExcel() {
            fetch('/ItemDepartmentList/ExportAllDocs')
                .then(response => {
                    if (!response.ok) throw new Error("Network response was not ok");
                    return response.json();
                })
                .then(data => {
                    const filteredData = data.map(item => ({
                Code: item.code,
                Name: item.name,
                TranType: item.tranType,
                PlaceType: item.placeType,
                ReportType: item.reportType,
                UnitType: item.unitType,
                PlaceCode: item.placeCode,
                Active: item.active ? "Yes" : "No",
                Status: item.status
            }));
            console.log(filteredData)
                    const worksheet = XLSX.utils.json_to_sheet(filteredData);
                    const workbook = XLSX.utils.book_new();
                    XLSX.utils.book_append_sheet(workbook, worksheet, "AllDocs");

                    const pageName = "Item Department Master";
                    const now = new Date();
                    const pad = n => String(n).padStart(2, '0');
                    const timestamp = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}_${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;

                    const fileName = `${pageName}_${timestamp}.xlsx`;
                    XLSX.writeFile(workbook, fileName);
                })
                .catch(error => {
                    console.error("Export failed:", error);
                    toastr.error("Failed to export data.");
                });
        }
    function callGetReportAsPdf() {
        var reportName = "Rpt_Department_master";
        var now = new Date();
        var day = String(now.getDate()).padStart(2, '0');
        var month = String(now.getMonth() + 1).padStart(2, '0');
        var year = String(now.getFullYear()).slice(-2);
        var hours = String(now.getHours()).padStart(2, '0');
        var minutes = String(now.getMinutes()).padStart(2, '0');
        var seconds = String(now.getSeconds()).padStart(2, '0');
        var timestamp = `${day}${month}${year}_${hours}${minutes}${seconds}`;

        $.ajax({
            url: 'http://192.168.20.51:8082/Report/GetReportAsPdf',
            type: 'GET',
            data: { Reportname: reportName },
            xhrFields: {
                responseType: 'blob'
            },
            success: function (response) {
                console.log('PDF response:', response);
                var file = new Blob([response], { type: 'application/pdf' });
                var fileName = `${reportName}_${timestamp}.pdf`;

                var link = document.createElement('a');
                link.href = URL.createObjectURL(file);
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            },
            error: function (xhr, status, error) {
                console.error('Error generating report:', error);
            }
        });
    }
    function showDocumentPopup(docCode) {
        $.ajax({
            url: '/ItemDepartmentList/DocDetailsCode',
            type: 'POST',
            dataType: 'json',  // important
            data: { docCode: docCode },
            success: function(response) {
                if(response.success) {
                    showDocumentPopupjQuery(response.data, docCode);
                } else {
                    toastr.error("Failed to get document details.");
                }
            },
            error: function() {
                toastr.error("An error occurred while fetching document details.");
            }
        });
    }


</script>





