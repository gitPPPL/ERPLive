<script>
    let currentPage = 1;
    const pageSize = 10;

    $(document).ready(function () {
        loadAllAsset(currentPage);

        // Optional: Search with Enter key or delay
        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadAllAsset(currentPage);
        });
    });

    function loadAllAsset(page = 1) {
        currentPage = page;
        const searchTerm = $('#searchBox').val() || '';

        $.ajax({
            url: '/AssetsMasterList/GetAllAssets',
            type: 'GET',
            dataType: 'json',
            data: {
                pageNumber: currentPage,
                pageSize: pageSize,
                searchTerm: searchTerm
            },
            success: function (res) {
                console.log(res);
                const groups = res.groups || [];
                const totalCount = res.totalCount || 0;

                const tbody = $('#AssetTable tbody');
                tbody.empty();

                if (groups.length === 0) {
                    tbody.append(`
                        <tr>
                            <td colspan="9" class="text-center text-muted">No assets found.</td>
                        </tr>
                    `);
                    renderPagination(0, pageSize, currentPage);
                    return;
                }

                groups.forEach(group => {
                    tbody.append(`
                        <tr>
                            <td>${htmlEncode(group.aC_CODE)}</td>
                            <td>${htmlEncode(group.aC_NAME)}</td>
                            <td>${htmlEncode(group.oP_AMT)}</td>
                            <td>${htmlEncode(group.deP_AMT)}</td>
                            <td>${htmlEncode(group.deP_RATE)}</td>
                            <td>${htmlEncode(group.life)}</td>
                            <td>${htmlEncode(group.shifT_CALC)}</td>
                            <td style="display: none;">${htmlEncode(group.srno)}</td>
                            <td>
                                <i class="fas fa-edit text-primary" style="cursor: pointer;" title="Edit" onclick="AddOrEditItemGroup(${group.srno})"></i>
                                <i class="fas fa-eye text-secondary ms-2" style="cursor: pointer;" title="View" onclick="viewItemGroupDetails(${group.srno})"></i>
                            </td>
                        </tr>
                    `);
                });

                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                toastr.error('Error loading asset list: ' + xhr.responseText);
            }
        });
    }
    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const container = $('#pagination');
        container.empty();

        if (total === 0 || totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="loadAllAsset(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="loadAllAsset(${currentPage - 1})">Prev</button>`;
        }

        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        if (currentPage <= 3) endPage = Math.min(5, totalPages);
        if (currentPage >= totalPages - 2) startPage = Math.max(totalPages - 4, 1);

        for (let i = startPage; i <= endPage; i++) {
            html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="loadAllAsset(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="loadAllAsset(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="loadAllAsset(${totalPages})">Last</button>`;
        }
        container.html(html);
    }
    function AddOrEditItemGroup(id) {
        if (id != null) {
            window.location.href = '/AssetsMaster/Index?id=' + encodeURIComponent(id);
        }
    }
    function viewItemGroupDetails(id) {
        if (id != null) {
            window.location.href = '/AssetsMaster/Index?id=' + encodeURIComponent(id) + '&mode=view';
        }
    }
    function htmlEncode(value) {
        if (value == null) return '';
        return $('<div/>').text(value).html();
    }
</script>

