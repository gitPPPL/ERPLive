@{
	ViewBag.Title = "Production Place Master List";
	Layout = "~/Views/Shared/_Layout.cshtml";
	var currentMenu = ViewBag.CurrentMenu as string;
	bool canAdd = false;
	bool canEdit = false;
	bool canDelete = false;
	bool canPrint = false;
	bool canExport = false;
	bool canMail = false;
	bool canApproval = false;
	bool canDocDetail = false;

	foreach (var permission in Model.UserMenuPermissions)
	{
		if (permission.DISPLAY_NAME == ViewBag.CurrentMenu)
		{
			canAdd = Model.UserLevel == 1 || permission._ADD == 1;
			canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
			canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
			canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
			canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
			canMail = Model.UserLevel == 1 || permission._MAIL == 1;
			canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
			canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
			break;  // Exit loop once found current menu permission
		}
	}
}
<fieldset>
	<legend class="legend-field">Production Place Master List</legend>

	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control border-0" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>

		<div class="col-lg-6">
			<div class="btn-rightalign">
				@if (canAdd)
				{
					<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "ProductionPlaceMaster")'" type="submit" class="btn btn-add">
						<i class="fa fa-plus"></i>Add
					</button>
				}
				@if (canPrint)
				{
					<button class="btn btn-print" onclick="callGetReportAsPdf()">
						<i class="fa fa-print"></i> Print
					</button>
				}
				@if (canExport)
				{
					<button class="btn btn-export" onclick="exportToExcel()">
						<i class="fas fa-file-export"></i> Export
					</button>
				}
				@if (canMail)
				{
					<button class="btn btn-mail">
						<i class="fa fa-envelope"></i> Mail
					</button>
				}
				@if (canApproval)
				{
					<button class="btn btn-approved">
						<i class="fa fa-check"></i> Approve
					</button>
				}
			</div>
		</div>
		
	</div>



	<div class="card">
		<div class="table-responsive">
			<table id="tblPlaceMaster" class="table-width">
				<thead class="table-head">
					<tr>
						<th>Code</th>
						<th>Name</th>
						<th>Short Name</th>
						<th>Place</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>

		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
	</div>

</fieldset>


<script>
	var canAdd = @canAdd.ToString().ToLower();
	var canEdit = @canEdit.ToString().ToLower();
	var canDelete = @canDelete.ToString().ToLower();
	var canPrint = @canPrint.ToString().ToLower();
	var canExport = @canExport.ToString().ToLower();
	var canMail = @canMail.ToString().ToLower();
	var canApproval = @canApproval.ToString().ToLower();
	var canDocDetail = @canDocDetail.ToString().ToLower();

	let currentPage = 1;
	let pageSize = 10;
	let placeMap = {};

	$(document).ready(function () {
	   loadPlacesList();
	});

	function loadPlacesList() {
		$.ajax({
			url: '/ProductionPlaceMaster/GetPlaceList',
			type: 'GET',
			dataType: 'json',
			success: function (data) {
				placeMap = {}; 
				$.each(data, function (index, item) {
					placeMap[item.value] = item.text;
				});
				LoadPlaceMastData();
			},
			error: function (xhr, status, error) {
				console.error("Error loading module: ", xhr.responseText);
				alert('Error loading module: ' + error);
			}
		});
	}

	function LoadPlaceMastData() {
		const searchTerm = $('#searchBox').val();

		$.ajax({
			url: '/ProductionPlaceMasterList/GetAllProdPlaceMast', // Your controller
			type: 'GET',
			dataType: 'json',
			data: {
				searchTerm: searchTerm,
				pageNumber: currentPage,
				pageSize: pageSize
			},
			success: function (res) {
				const items = res.items;
				const totalCount = res.totalCount;
				console.log(items)

				let tbody = $('#tblPlaceMaster tbody');
				tbody.empty();

				if (!items || items.length === 0) {
					tbody.append('<tr><td colspan="5" class="text-center text-muted">No records found.</td></tr>');
					renderPagination(0, pageSize, currentPage);
					return;
				}

				$.each(items, function (index, item) {
					const placeName = placeMap[item.placE_CODE] || 'Unknown';

					tbody.append(`
						<tr>
							<td>${item.code || ''}</td>
							<td>${item.name || ''}</td>
							<td>${item.shortname || ''}</td>
							<td>${placeName}</td>
							<td>
								
								${canEdit ? `<i class="fa fa-edit btn-edit" data-doc="${item.code}" title="Edit" ></i>` : ''}
								<i class="fa fa-eye btn-view" data-doc="${item.code}" title="View" ></i>
								${canDelete ? `<i class="fa fa-trash btn-delete" data-doc="${item.code}" title="Delete" ></i>` : ''}
								${canDocDetail ? `<i class="fa fa-file btn-details btn-document" data-doc="${item.code}" title="Details" ></i>` : ''}

							</td>
						</tr>
					`);
				});

				renderPagination(totalCount, pageSize, currentPage);
			},
			error: function (xhr) {
				toastr.error('Error loading data: ' + xhr.responseText);
			}
		});
	}

	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const paginationContainer = $('#tablePagination');
		paginationContainer.empty();

		if (totalPages <= 1) return;

		let paginationHtml = '';

		if (currentPage > 1) {
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		let startPage = Math.max(1, currentPage - 2);
		let endPage = Math.min(totalPages, currentPage + 2);

		if (currentPage <= 3) {
			endPage = Math.min(5, totalPages);
		}
		if (currentPage >= totalPages - 2) {
			startPage = Math.max(totalPages - 4, 1);
		}

		for (let i = startPage; i <= endPage; i++) {
			paginationHtml += `
				<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1"
						onclick="goToPage(${i})">${i}</button>`;
		}

		if (currentPage < totalPages) {
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		paginationContainer.html(paginationHtml);
	}

	function goToPage(page) {
		currentPage = page;
		LoadPlaceMastData();
	}
	// Trigger on search input
	$('#searchBox').on('keyup', function () {
		currentPage = 1;
		LoadPlaceMastData();
	});


	 $(document).on('click', '.btn-edit', function() {
		const rowId = $(this).data('doc');
		editProdPlaceMaster(rowId);
	});

	$(document).on('click', '.btn-view', function() {
		const rowId = $(this).data('doc');
		viewProdPlaceMasterDetails(rowId);
	});

	$(document).on('click', '.btn-delete', function() {
		const code = $(this).data('doc');
		deleteProductionPlace(code);  // Make sure this function exists
	});

	$(document).on('click', '.btn-details', function() {
		const docCode = $(this).data('doc');
		showDocumentPopup(docCode);  // Your popup function
	});
	function editProdPlaceMaster(rowId) {
		window.location.href = '/ProductionPlaceMaster/Index?id=' + encodeURIComponent(rowId);
	}
	function viewProdPlaceMasterDetails(rowId) {
		window.location.href = '/ProductionPlaceMaster/Index?id=' + encodeURIComponent(rowId) + '&readOnly=true';
	}
	function deleteProductionPlace(code) {
		Swal.fire({
			title: 'Are you sure?',
			text: "This action will permanently delete the cost category.",
			icon: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#d33',
			cancelButtonColor: '#3085d6',
			confirmButtonText: 'Yes, delete it!',
			cancelButtonText: 'Cancel'
		}).then((result) => {
			if (result.isConfirmed) {
				$.ajax({
					url: '/ProductionPlaceMaster/DeleteProductionPlaceByCode',
					type: 'POST',
					data: { code: code },
					success: function (response) {
						if (response.success) {
							Swal.fire('Deleted!', response.message, 'success').then(() => {
								LoadPlaceMastData();
							});
						} else {
							Swal.fire('Failed', response.message, 'warning');
						}
					},
					error: function (xhr, status, error) {
						Swal.fire('Error!', 'An error occurred while deleting.', 'error');
					}
				});
			}
		});
	}
	function exportToExcel() {
			fetch('/ProductionPlaceMasterList/ExportAllDocs')
				.then(response => {
					if (!response.ok) throw new Error("Network response was not ok");
					return response.json();
				})
				.then(data => {
					console.log(data)
					 const filteredData = data.map(item => ({
				"Code": item.code,
				"Name": item.name,
				"Short Name": item.shortname,
				"Place": item.placE_CODE
			}));
					const worksheet = XLSX.utils.json_to_sheet(filteredData);
					const workbook = XLSX.utils.book_new();
					XLSX.utils.book_append_sheet(workbook, worksheet, "AllDocs");

					const pageName = "Production Place Master";
					const now = new Date();
					const pad = n => String(n).padStart(2, '0');
					const timestamp = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}_${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;

					const fileName = `${pageName}_${timestamp}.xlsx`;
					XLSX.writeFile(workbook, fileName);
				})
				.catch(error => {
					console.error("Export failed:", error);
					toastr.error("Failed to export data.");
				});
		}
	function callGetReportAsPdf() {
		var reportName = "rpt_city_master";
		var now = new Date();
		var day = String(now.getDate()).padStart(2, '0');
		var month = String(now.getMonth() + 1).padStart(2, '0');
		var year = String(now.getFullYear()).slice(-2);
		var hours = String(now.getHours()).padStart(2, '0');
		var minutes = String(now.getMinutes()).padStart(2, '0');
		var seconds = String(now.getSeconds()).padStart(2, '0');
		var timestamp = `${day}${month}${year}_${hours}${minutes}${seconds}`;

		$.ajax({
			url: 'http://192.168.20.51:8082/Report/GetReportAsPdf',
			type: 'GET',
			data: { Reportname: reportName },
			xhrFields: {
				responseType: 'blob'
			},
			success: function (response) {
				console.log('PDF response:', response);
				var file = new Blob([response], { type: 'application/pdf' });
				var fileName = `${reportName}_${timestamp}.pdf`;

				var link = document.createElement('a');
				link.href = URL.createObjectURL(file);
				link.download = fileName;
				document.body.appendChild(link);
				link.click();
				document.body.removeChild(link);
			},
			error: function (xhr, status, error) {
				console.error('Error generating report:', error);
			}
		});
	}
	function showDocumentPopup(docCode) {
		$.ajax({
			url: '/ProductionPlaceMasterList/DocDetailsCode',
			type: 'POST',
			dataType: 'json',  // important
			data: { docCode: docCode },
			success: function(response) {
				if(response.success) {
					showDocumentPopupjQuery(response.data, docCode);
				} else {
					toastr.error("Failed to get document details.");
				}
			},
			error: function() {
				toastr.error("An error occurred while fetching document details.");
			}
		});
	}

</script>