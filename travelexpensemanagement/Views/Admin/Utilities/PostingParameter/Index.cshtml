<script src="~/js/GlobalFunction.js" asp-append-version="true"></script>
<script>
 
    const allFieldIds = [
        "TxtDocId",
        "ddlVoucherType",
        "ddlDocType",
        "ddlCGSTAC",
        "ddlSGSTAC",
        "ddlIGSTAC",
        "ddlFreightAC",
        "ddlRoundAC",
        "ddlCGSTRCMAC",
        "ddlSGSTRCMAC",
        "ddlIGSTRCMAC",
        "ddlGSTHoldAC",
        "ddlBillHoldAC",
        "ddlTDS194QAC",
        "ddlTDSAC",
        "ddlTCSAC",
        "ddlQualityControlAC",
        "ddlQualityDebitAC",
        "ddlQuantityDebitAC",
        "ddlRateDiffAC",
        "ddlCessAC",
        "ddlImportPLAC"
    ];



    let docId = "",docType="", readOnly;

    function getQueryParam(param) {
      return new URLSearchParams(window.location.search).get(param);
    }

    $(document).ready(function () {
      initPage();
    });

    async function initPage() {
      try {
        await handleDocLoad();
        setEnterKeyFocus(allFieldIds);
        wireEvents();
    } catch (err) {
        toastr.error('Initialization failed: ' + err);
    }
    }

    function wireEvents() {


      $('#btn-save').on('click', async (e) => {
        e.preventDefault();


      if (!validateRequiredField('#ddlVoucherType','Voucher Type') ||
            !validateRequiredField('#ddlDocType','DocType') ||
            !validateRequiredField('#ddlCGSTAC','CGSTAC') ||
            !validateRequiredField('#ddlSGSTAC','SGSTAC') ||
            !validateRequiredField('#ddlFreightAC','FreightAC') ||
            !validateRequiredField('#ddlRoundAC','RoundAC')) return;

        try {
          const data = await collectFormData();
          console.log(data);
          docId ? UpdateData(data) : SaveData(data);
        } catch (err) {
          toastr.error("Error saving data: " + err);
        }


      });

    $(document).on('change', '#DtApplicable, #DtValidUpto', function () {
        var appDt = $('#DtApplicable').val();
        var validDt = $('#DtValidUpto').val();
         getTotalDays(appDt, validDt);
    });



    }

</script>

<script>
    
      async function handleDocLoad() {
               docId = getQueryParam('id');
               readOnly = getQueryParam('readOnly');
               docType=getQueryParam('docType');

               console.log(docId,docType, readOnly);
              if (docId) {                 
                  await GetDocData(docId,docType, readOnly);
                  $('#ddlVoucherType').prop('disabled', true);
                  $('#ddlDocType').prop('disabled', true);
              } else {
                    GetVTypeList();
                    GetDocTypeList();
                    GetPartyList('ddlCGSTAC');
                    GetPartyList('ddlSGSTAC');
                    GetPartyList('ddlIGSTAC');
                    GetPartyList('ddlFreightAC');
                    GetPartyList('ddlRoundAC');
                    GetPartyList('ddlCGSTRCMAC');
                    GetPartyList('ddlSGSTRCMAC');
                    GetPartyList('ddlIGSTRCMAC');
                    GetPartyList('ddlGSTHoldAC');
                    GetPartyList('ddlBillHoldAC');
                    GetPartyList('ddlTDS194QAC');
                    GetPartyList('ddlTDSAC');
                    GetPartyList('ddlTCSAC');
                    GetPartyList('ddlQualityControlAC');
                    GetPartyList('ddlQualityDebitAC');
                    GetPartyList('ddlQuantityDebitAC');
                    GetPartyList('ddlRateDiffAC');
                    GetPartyList('ddlCessAC');
                    GetPartyList('ddlImportPLAC');

              }
      }

      function SaveData(saveDt) {
                  $.ajax({
                      url: '@Url.Action("SaveOrUpdatePostingParameterEntry", "PostingParameter")',
                      type: 'POST',
                      contentType: 'application/json',
                      data: JSON.stringify(saveDt),
                      success: function (response) {
                          if (response?.status) {
                              toastr.success("Data Insert successfully");
                              setTimeout(() => {
                                  window.location.href = '/PostingParameterList/Index';
                              }, 1500);
                          } else {
                              toastr.error(response?.message || "Save failed. Please try again.");
                          }
                      },
                      error: function () {
                          toastr.error("Error occurred while saving. Please contact admin.");
                      }
                  });
      }

      function UpdateData(UpdateDt) {
          $.ajax({
              url: '@Url.Action("SaveOrUpdatePostingParameterEntry", "PostingParameter")',
              type: 'POST',
              contentType: 'application/json',
              data: JSON.stringify(UpdateDt),
              dataType: 'json',
              success: function (response) {
                  if (response?.status) {
                     toastr.success("Data Update successfully");
                      // showFlashMessageByKey('update', 'success');
                      setTimeout(() => {
                          window.location.href = '/PostingParameterList/Index';
                      }, 1500);
                  } else {
                      toastr.error("Update failed: " + (response?.message || "Unknown error."));
                  }
              },
              error: function (xhr, status, error) {
                  toastr.error("Data not updated: " + error);
              }
          });
      }

    function getTotalDays(appDt, validDt){
          if (appDt && validDt) {
                var startDate = new Date(appDt);
                var endDate = new Date(validDt);
                if (startDate > endDate) {
                    toastr.warning("Applicable Date should be earlier than Valid Upto Date.");
                    $('#NumTotalDays').val('');
                    return;
                }
                var timeDiff = endDate - startDate;
                var dayDiff = Math.floor(timeDiff / (1000 * 60 * 60 * 24)) + 1;
                $('#NumTotalDays').val(dayDiff);
          }
    }


       async function fillHeaderData(headerData) {
        const data = headerData[0];
        console.log(data);  // Logs the first item in headerData (the data object)

        // Call functions to populate dropdowns or lists based on the account IDs
        GetVTypeList(data.V_TYPE);
        GetDocTypeList(data.DOC_TYPE);
        GetPartyList('ddlCGSTAC', data.CGST_AC);        // Passing the CGST_AC value to each list
        GetPartyList('ddlSGSTAC', data.SGST_AC);
        GetPartyList('ddlIGSTAC', data.IGST_AC);
        GetPartyList('ddlFreightAC', data.FREIGHT_AC);
        GetPartyList('ddlRoundAC', data.ROUND_AC);
        GetPartyList('ddlCGSTRCMAC', data.CGST_AC_RCM);
        GetPartyList('ddlSGSTRCMAC', data.SGST_AC_RCM);
        GetPartyList('ddlIGSTRCMAC', data.IGST_AC_RCM);
        GetPartyList('ddlGSTHoldAC', data.GSTHOLD_AC);
        GetPartyList('ddlBillHoldAC', data.BILLHOLD_AC);
        GetPartyList('ddlTDS194QAC', data.TDS_194QAC);
        GetPartyList('ddlTDSAC', data.TDS_AC);
        GetPartyList('ddlTCSAC', data.TCS_AC);
        GetPartyList('ddlQualityControlAC', data.QCDR_AC);
        GetPartyList('ddlQualityDebitAC', data.QLTDR_AC);
        GetPartyList('ddlQuantityDebitAC', data.QTYDR_AC);
        GetPartyList('ddlRateDiffAC', data.RDDR_AC);
        GetPartyList('ddlCessAC', data.CESS_AC);
        GetPartyList('ddlImportPLAC', data.IMPORT_PL);
    }


    async function collectFormData() {
     const docType = toNullableString($("#ddlDocType").val());  
     const postType = toNullableString($("#ddlDocType option:selected").text());  
        return {            
            DOC_TYPE: docType,
            POST_TYPE: postType,
            V_TYPE: toNullableString($("#ddlVoucherType").val()),   
            FORM_CODE: 0, 
            SALE_AC: toNullableString($("#ddlSaleAC").val()),   
            DISC_AC: toNullableString($("#ddlDiscAC").val()),  
            CGST_AC: toNullableString($("#ddlCGSTAC").val()),
            SGST_AC: toNullableString($("#ddlSGSTAC").val()),
            IGST_AC: toNullableString($("#ddlIGSTAC").val()),
            FREIGHT_AC: toNullableString($("#ddlFreightAC").val()),
            ROUND_AC: toNullableString($("#ddlRoundAC").val()),
            INSU_AC: toNullableString($("#ddlInsuAC").val()),  
            TDS_AC: toNullableString($("#ddlTDSAC").val()),
            TCS_AC: toNullableString($("#ddlTCSAC").val()),
            QLTDR_AC: toNullableString($("#ddlQualityControlAC").val()),
            QCDR_AC: toNullableString($("#ddlQualityDebitAC").val()),
            QTYDR_AC: toNullableString($("#ddlQuantityDebitAC").val()),
            RDDR_AC: toNullableString($("#ddlRateDiffAC").val()),
            CGST_AC_RCM: toNullableString($("#ddlCGSTRCMAC").val()),
            SGST_AC_RCM: toNullableString($("#ddlSGSTRCMAC").val()),
            IGST_AC_RCM: toNullableString($("#ddlIGSTRCMAC").val()),
            CESS_AC: toNullableString($("#ddlCessAC").val()),
            PACK_AC: toNullableString($("#ddlPackAC").val()),
            IMPORT_PL: toNullableString($("#ddlImportPLAC").val()),
            GSTHOLD_AC: toNullableString($("#ddlGSTHoldAC").val()),
            BILLHOLD_AC: toNullableString($("#ddlBillHoldAC").val()),
            TDS_194QAC: toNullableString($("#ddlTDS194QAC").val()),
            LOADING_AC: toNullableString($("#ddlLoadingAC").val()),
            WB_AC: toNullableString($("#ddlWBAC").val()),
