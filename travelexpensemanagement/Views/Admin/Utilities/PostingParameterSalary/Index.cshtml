    async function initPage() {
      try {
        await handleDocLoad();
        setEnterKeyFocus(allFieldIds);
        wireEvents();
    } catch (err) {
        toastr.error('Initialization failed: ' + err);
    }
    }

    function wireEvents() {


      $('#btn-save').on('click', async (e) => {
        e.preventDefault();


      if (!validateRequiredField('#ddlSalaryAC','SalaryAC') ||
            !validateRequiredField('#ddlSalaryPayableAC','SalaryPayableAC') ||
            !validateRequiredField('#ddlHRAAC','HRAAC') ||
            !validateRequiredField('#ddlConveyanceAC','ConveyanceAC') ||
            !validateRequiredField('#ddlOtherAC','OtherAC') ||
            !validateRequiredField('#ddlWashingAC','WashingAC') ||
            !validateRequiredField('#ddlSpecialAC','SpecialAC') ||
            !validateRequiredField('#ddlEmployeeContributionPF','EmployeeContributionPF') ||
            !validateRequiredField('#ddlEmployeeContributionESI','EmployeeContributionESI') ||
            !validateRequiredField('#ddlEmployersContributionPF','EmployersContributionPF') ||
            !validateRequiredField('#ddlEmployersContributionESI','EmployersContributionESI') ||
            !validateRequiredField('#ddlAdvanceAC','AdvanceAC') ||
            !validateRequiredField('#ddlTDSPayableAC','TDSPayableAC') ||
            !validateRequiredField('#ddlQualityControlAC','QualityControlAC') ||
            !validateRequiredField('#ddlFamilyPensionAC','FamilyPensionAC') ||
            !validateRequiredField('#ddlEPFPayableAC','EPFPayableAC') ||  
            !validateRequiredField('#ddlESIPayableAC','ESIPayableAC') ||
            !validateRequiredField('#ddlWagesAC','WagesAC') ||
            !validateRequiredField('#ddlWagesPayableAC','WagesPayableAC') ||
            !validateRequiredField('#ddlProductionIncentiveAC','ProductionIncentiveAC') ||
            !validateRequiredField('#ddlProductionIncentivePayableAC','ProductionIncentivePayableAC')) return;

        try {
          const data = await collectFormData();
          console.log(data);
          SaveData(data);
          // docId ? UpdateData(data) : SaveData(data);
        } catch (err) {
          toastr.error("Error saving data: " + err);
        }


      });

    $(document).on('change', '#DtApplicable, #DtValidUpto', function () {
        var appDt = $('#DtApplicable').val();
        var validDt = $('#DtValidUpto').val();
         getTotalDays(appDt, validDt);
    });

    }

</script>

<script>

      async function handleDocLoad() {
               docId = getQueryParam('id');
               readOnly = getQueryParam('readOnly');
               console.log(docId, readOnly);
              if (docId) {
                  await GetDocData(docId, readOnly);
              } else {                    
                   allFieldIds.forEach(function(dropdownId) {
                   GetPartyList(dropdownId);
                   });

              }
      }

      function SaveData(saveDt) {
                  $.ajax({
                      url: '@Url.Action("SaveOrUpdatePostingParameterSalaryEntry", "PostingParameterSalary")',
                      type: 'POST',
                      contentType: 'application/json',
                      data: JSON.stringify(saveDt),
                      success: function (response) {
                          if (response?.status) {
                              toastr.success("Data Insert successfully");
                              setTimeout(() => {
                                  window.location.href = '/PostingParameterSalaryList/Index';
                              }, 1500);
                          } else {
                              toastr.error(response?.message || "Save failed. Please try again.");
                          }
                      },
                      error: function () {
                          toastr.error("Error occurred while saving. Please contact admin.");
                      }
                  });
      }
          

    function getTotalDays(appDt, validDt){
          if (appDt && validDt) {
                var startDate = new Date(appDt);
                var endDate = new Date(validDt);
                if (startDate > endDate) {
                    toastr.warning("Applicable Date should be earlier than Valid Upto Date.");
                    $('#NumTotalDays').val('');
                    return;
                }
                var timeDiff = endDate - startDate;
                var dayDiff = Math.floor(timeDiff / (1000 * 60 * 60 * 24)) + 1;
                $('#NumTotalDays').val(dayDiff);
          }
    }

