@{
    ViewBag.Title = "Production Incentive Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
    <legend class="legend-field">Production Incentive Master</legend>
    <form id="ProductionIncentiveMasterForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtName">Name</label>
                    <input type="text" class="form-control" id="TxtName" placeholder="Enter Name" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlPlace">Place</label>
                    <select class="form-control" id="ddlPlace">
                        <option value="">Unit-1</option>
                        <option value="">Unit-2</option>
                        <option value="">Both</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumIncRate">Inc. Rate</label>
                    <input type="number" class="form-control" id="NumIncRate" placeholder="Enter Inc Rate" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumProduction">Production(.kg)</label>
                    <input type="text" class="form-control" id="NumProduction" placeholder="Enter Production in kg" />
                </div>
            </div>
        </div>
       
        <div class="card">
            <div class="table-responsive">
                <table id="tblProductionIncentive" class="table-width">
                    <thead class="table-head">
                        <tr>
                            <th style="display:none;">Code</th>
                            <th>Range</th>
                            <th>Rate</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
           
            <div class="row">
                <div class="col-md-12">
                    <div class="btn-add-row-last">
                        <i class="fa fa-plus btn-add-row" title="Add Row"><span>Add New Row</span></i>
                    </div>
                    <div class="pagination-end">
                        <div class="custom-pagination" id="tablePagination"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="btn-mt">
                    <button onclick="window.location.href='@Url.Action("Index", "ProductionIncentiveMasterList")'" type="button" class="btn btn-draft">
                        <i class="fa fa-list"></i>Back to list
                    </button>
                </div>
            </div>
            <div class="offset-md-5 col-md-4">
                <div class="button-right btn-mt">
                    <button id="btn-save" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
                    <button id="btn_cancel" type="button" class="btn btn-danger"><i class="fa fa-close"></i>Cancel</button>
                </div>
            </div>
        </div>
    </form>
</fieldset>
<script>
    $(document).ready(function () {
        const $tbody = $('#tblProductionIncentive tbody');

        // Add a new row
        function addRow(data = {}) {
            const row = `
                <tr class="no-border-input">
                    <td><input type="text" class="form-control" value="${data.range || ''}" /></td>
                    <td><input type="text" class="form-control" value="${data.rate || ''}" /></td>
                    <td>
                        <i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer;"></i>
                        <i class="fa fa-trash btn-delete-action text-danger" title="Delete Row" style="cursor:pointer;"></i>
                    </td>
                </tr>
            `;
            $tbody.append(row);
            updateLastRow();
        }

        // Ensure the last row has the "Add Row" button and remove it from the previous row
        function updateLastRow() {
            const $rows = $tbody.find('tr');
            $rows.each(function (index) {
                const $row = $(this);
                if (index === $rows.length - 1) {
                    // Last row should have the Add Row button
                    $row.find('.btn-add-action').show();
                } else {
                    // Hide the Add Row button from the previous rows
                    $row.find('.btn-add-action').hide();
                }
            });
        }

        // Initial row
        addRow();

        // Add row on clicking plus icon or "Add New Row"
        $(document).on('click', '.btn-add-row, .btn-add-action', function () {
            addRow();
        });

        // Delete row
        $(document).on('click', '.btn-delete-action', function () {
            const $row = $(this).closest('tr');
            $row.remove();
            updateLastRow(); // Update the last row after deletion
        });
    });
</script>

<script>

    let currentPage = 1;
    let pageSize = 10;

    $(document).ready(function () {
        loadDocumentStages();

        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadDocumentStages();
        });
    });

    //Load main grid...............
    function loadDocumentStages() {
        const searchTerm = $('#searchBox').val();

        $.ajax({
            url: '/ApprovalStageMasterList/GetAllDocs',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                console.log(res);
                const docs = res.items || res.data || [];
                const totalCount = res.totalCount || 0;

                const tbody = $('#tblApprovalStageMaster tbody');
                tbody.empty();

                if (docs.length === 0) {
                    tbody.append(`<tr><td colspan="5" class="text-center text-muted">No records found.</td></tr>`);
                    renderPagination(0, pageSize, currentPage);
                    return;
                }

                docs.forEach(doc => {
                    tbody.append(`
                        <tr>
                            <td style="display:none;">${doc.code || doc.doC_CODE || ''}</td>
                            <td>${doc.doC_CODE || ''}</td>
                            <td>${doc.doC_NAME || ''}</td>
                            <td>${doc.useR_NO || '0'}</td>
                            <td>
                              <div class="action-icons">
                              <i class="fa fa-edit btn-edit" data-bs-toggle="tooltip" title="Edit" onclick="editDocStage('${doc.doC_CODE}')"></i>
                              <i class="fas fa-eye btn-view" data-bs-toggle="tooltip" title="View" onclick="viewDocStage('${doc.doC_CODE}')"></i>
                              <i class="fas fa-trash btn-delete" data-bs-toggle="tooltip" title="Delete" onclick="deleteDocStage('${doc.doC_CODE}')"></i>
                               <i class="fa fa-file btn-document" data-bs-toggle="tooltip" data-bs-title="Document Details" onclick="showDocumentPopup('${doc.doC_CODE}')"></i>
                              </div>

                            </td>
                        </tr>
                    `);
                });

                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                toastr.error('Error loading document stages: ' + (xhr.responseJSON?.message || xhr.statusText));
            }
        });
    }

        function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const pagination = $('#tablePagination');
        pagination.empty();

        if (totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        const startPage = Math.max(1, currentPage - 2);
        const endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
            html += `
                <button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        pagination.html(html);
    }

    function goToPage(page) {
        currentPage = page;
        loadDocumentStages();
    }

    function editDocStage(docCode) {
        window.location.href = `/ApprovalStageMaster/Index?docCode=${encodeURIComponent(docCode)}`;
    }

    function viewDocStage(docCode) {
        window.location.href = `/ApprovalStageMaster/Index?docCode=${encodeURIComponent(docCode)}&readOnly=true`;
    }

    function deleteDocStage(docCode) {
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this deletion!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/ApprovalStageMasterList/DeleteDocByCode',
                    type: 'POST',
                    data: { docCode: docCode },
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message || "Record deleted successfully.");
                            loadDocumentStages();
                        } else {
                            toastr.warning("Delete failed.");
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while deleting.");
                    }
                });
            }
        });
    }



</script>

