@{
	ViewBag.Title = "Mesh Conversion Master List";
	Layout = "~/Views/Shared/_Layout.cshtml";

}

<fieldset>
	<legend class="legend-field">Mesh Conversion Master List</legend>
	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>
		<div class="col-lg-6">
			<div class="btn-rightalign">
				<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "MeshConversionMaster")'" type="submit" class="btn btn-add">
					<i class="fa fa-plus"></i>Add
				</button>
				<button class="btn btn-print" onclick="printCityMasterReport()">
					<i class="fa fa-print"></i> Print
				</button>
				<button class="btn btn-export">
					<i class="fas fa-file-export"></i> Export
				</button>
				<button class="btn btn-mail">
					<i class="fa fa-envelope"></i> Mail
				</button>
				<button class="btn btn-approved">
					<i class="fa fa-check"></i> Approved
				</button>
			</div>
		</div>
	</div>
	<div class="card">
		<div class="table-responsive">
			<table id="tblMeshConversionList" class="table-width">
				<thead class="table-head">
					<tr>
						<th>Code</th>
						<th>Make Type</th>
						<th>Run No</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
	</div>
</fieldset>
<script>
    let currentPage = 1;
    let pageSize = 10;
    $(document).ready(function () {
        loadMakeConversionList();
        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadMakeConversionList(); 
        });
    });

    function loadMakeConversionList() {
        const searchTerm = $('#searchBox').val();
        $.ajax({
            url: '/MeshConversionMasterList/GetMeshConversionMasterList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                console.log('kks',res)
                const docs = res.items || [];
                const totalCount = res.totalCount || 0;
                const tbody = $('#tblMeshConversionList tbody');
                tbody.empty();

                if (docs.length === 0) {
                    tbody.append(`<tr><td colspan="3" class="text-center text-muted">No records found.</td></tr>`);
                    renderPagination(0, pageSize, currentPage);
                    return;
                }
                   docs.forEach(doc => {
                    tbody.append(`
                    <tr id="row-${doc.sno}">
                        <td>${doc.sno}</td>
                        <td class="mesHNAME">${doc.mesH_NAME}</td> <!-- Add class here -->
                        <td class="runNo">${doc.ruN_NO}</td> <!-- Add class here -->
                        <td>
                            <i class="fa fa-edit text-primary mx-2" onclick="editRow(${doc.sno})" style="cursor:pointer;"></i>
                            <i class="fa fa-trash text-danger" onclick="deleteRow(${doc.sno})" style="cursor:pointer;"></i>
                        </td>
                    </tr>
                  `);
                });
                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                toastr.error("Failed to load data!");
            }
        });
    }

    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const pagination = $('#tablePagination');
        pagination.empty();

        if (totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        const startPage = Math.max(1, currentPage - 2);
        const endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
            html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        pagination.html(html);
    }

    function goToPage(page) {
        currentPage = page;
        loadMakeConversionList();
    }
    function editRow(sno) {
        debugger
        const row = $(`#row-${sno}`);
        const mesH_NAME = row.find('.mesHNAME').text();
        const ruN_NO = row.find('.runNo').text();
        window.location.href = `/MeshConversionMaster/Index?sno=${sno}&mesH_NAME=${mesH_NAME}&runNo=${ruN_NO}`;
    }

    function deleteRow(sno) {
        const maketype = $(`#row-${sno} .makeType`).text();
        const Runno = $(`#row-${sno} .runNo`).text();
        Swal.fire({
            title: "Confirm Delete?",
            text: "This record will be permanently deleted!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, Delete",
            cancelButtonText: "Cancel"
        }).then((result) => {

            if (result.isConfirmed) {

                $.ajax({
                    url: '/MeshConversionMasterList/Delete',
                    type: 'POST',
                    data: { sno: sno, maketype: maketype, Runno: Runno },  
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message);
                            loadMakeConversionList();
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function () {
                        toastr.error("Error deleting record");
                    }
                });
            }
        });
    }
</script>
