<script>

      async function handleDocLoad() {
               docId = getQueryParam('id');
               readOnly = getQueryParam('readOnly');
               var posttype=getQueryParam('postType');
               var formid=getQueryParam('formCode');
               console.log(docId,posttype,formid, readOnly);
              if (docId) {
                  await GetDocData(docId,posttype,formid, readOnly);
              } else {
                    GetVTypeList();
                    // GetDocTypeList();
                    GetPostTypeList();
                    GetFormtypeList();
                   dropdownIds.forEach(function(dropdownId) {
                   GetPartyList(dropdownId);
                   });

              }
      }

      function SaveData(saveDt) {
                  $.ajax({
                      url: '@Url.Action("SaveOrUpdatePostingParameterSaleEntry", "PostingParameterSales")',
                      type: 'POST',
                      contentType: 'application/json',
                      data: JSON.stringify(saveDt),
                      success: function (response) {
                          if (response?.status) {
                              toastr.success("Data Insert successfully");
                              setTimeout(() => {
                                  window.location.href = '/PostingParameterSalesList/Index';
                              }, 1500);
                          } else {
                              toastr.error(response?.message || "Save failed. Please try again.");
                          }
                      },
                      error: function () {
                          toastr.error("Error occurred while saving. Please contact admin.");
                      }
                  });
      }

      function UpdateData(UpdateDt) {
          $.ajax({
              url: '@Url.Action("SaveOrUpdatePostingParameterSaleEntry", "PostingParameterSales")',
              type: 'POST',
              contentType: 'application/json',
              data: JSON.stringify(UpdateDt),
              dataType: 'json',
              success: function (response) {
                  if (response?.status) {
                     toastr.success("Data Update successfully");
                      // showFlashMessageByKey('update', 'success');
                      setTimeout(() => {
                          window.location.href = '/PostingParameterSalesList/Index';
                      }, 1500);
                  } else {
                      toastr.error("Update failed: " + (response?.message || "Unknown error."));
                  }
              },
              error: function (xhr, status, error) {
                  toastr.error("Data not updated: " + error);
              }
          });
      }

    function getTotalDays(appDt, validDt){
          if (appDt && validDt) {
                var startDate = new Date(appDt);
                var endDate = new Date(validDt);
                if (startDate > endDate) {
                    toastr.warning("Applicable Date should be earlier than Valid Upto Date.");
                    $('#NumTotalDays').val('');
                    return;
                }
                var timeDiff = endDate - startDate;
                var dayDiff = Math.floor(timeDiff / (1000 * 60 * 60 * 24)) + 1;
                $('#NumTotalDays').val(dayDiff);
          }
    }


