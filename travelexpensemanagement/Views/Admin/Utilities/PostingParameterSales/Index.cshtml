    async function collectFormData() {
        const docType = toNullableString($("#ddlDocType").val());
        const postType = toNullableString($("#ddlPostType").val());
        const vType = toNullableString($("#ddlVoucherType").val());
        const formCode = toNullableInt($("#ddlFormType").val());
        const saleAC = toNullableString($("#ddlSalesAC").val());
        const discAC = toNullableString($("#ddlDiscountAC").val());
        const cgstAC = toNullableString($("#ddlCGSTAC").val());
        const sgstAC = toNullableString($("#ddlSGSTAC").val());
        const igstAC = toNullableString($("#ddlIGSTAC").val());
        const freightAC = toNullableString($("#ddlFreightAC").val());
        const roundAC = toNullableString($("#ddlRoundAC").val());
        const insuAC = toNullableString($("#ddlInsuranceAC").val());
        const tdsAC = toNullableString($("#ddlTDSAC").val());
        const tcsAC = toNullableString($("#ddlTCSAC").val());
        const qltDrAC = toNullableString($("#ddlCommissionAC").val());  // Assuming CommissionAC corresponds to QLTDR_AC
        const qcDrAC = toNullableString($("#ddlCessAC").val());  // Assuming CessAC corresponds to QCDR_AC
        const qtyDrAC = toNullableString($("#ddlLoadingUnloadingAC").val());  // Assuming LoadingUnloadingAC corresponds to QTYDR_AC
        const rddrAC = toNullableString($("#ddlWBAC").val());  // Assuming WBAC corresponds to RDDR_AC
        const cgstACRCM = toNullableString($("#ddlCGSTAC").val());  // Assuming CGSTAC corresponds to CGST_AC_RCM
        const sgstACRCM = toNullableString($("#ddlSGSTAC").val());  // Assuming SGSTAC corresponds to SGST_AC_RCM
        const igstACRCM = toNullableString($("#ddlIGSTAC").val());  // Assuming IGSTAC corresponds to IGST_AC_RCM
        const cessAC = toNullableString($("#ddlCessAC").val());
        const packAC = toNullableString($("#ddlPackingAC").val());
        // const importPL = toNullableString($("#ddlFormType").val());  // Assuming FormType corresponds to IMPORT_PL
        // const gstHoldAC = toNullableString($("#ddlInsuranceAC").val());  // Assuming InsuranceAC corresponds to GSTHOLD_AC
        // const billHoldAC = toNullableString($("#ddlTDSAC").val());  // Assuming TDSAC corresponds to BILLHOLD_AC
        // const tds194QAC = toNullableString($("#ddlTDSAC").val());  // Assuming TDSAC corresponds to TDS_194QAC

        return {
            DOC_TYPE: docType,
            POST_TYPE: postType,
            V_TYPE: vType,
            FORM_CODE: formCode,
            SALE_AC: saleAC,
            DISC_AC: discAC,
            CGST_AC: cgstAC,
            SGST_AC: sgstAC,
            IGST_AC: igstAC,
            FREIGHT_AC: freightAC,
            ROUND_AC: roundAC,
            INSU_AC: insuAC,
            TDS_AC: tdsAC,
            TCS_AC: tcsAC,
            QLTDR_AC: qltDrAC,
            QCDR_AC: qcDrAC,
            QTYDR_AC: qtyDrAC,
            RDDR_AC: rddrAC,
            CGST_AC_RCM: cgstACRCM,
            SGST_AC_RCM: sgstACRCM,
            IGST_AC_RCM: igstACRCM,
            CESS_AC: cessAC,
            PACK_AC: packAC,
            IMPORT_PL: null,
            GSTHOLD_AC: null,
            BILLHOLD_AC: null,
            TDS_194QAC: null,
            LOADING_AC: null,   
            WB_AC: null,  
            SaveOrUpdate: (!docId || docId === "") ? "Save" : "Update"
        };
    }

 
      function GetVTypeList(selectedValue=null) {
          $.ajax({
              url: '@Url.Action("GetVTypeList", "PostingParameterSales")',
              type: 'GET',
              dataType: 'json',
              success: function (response) {
                  if (response.status) {
                      const $DropdownId = $('#ddlVoucherType');
                      $DropdownId.empty();
                      $DropdownId.append('<option value="">- Select Vtype -</option>');

                      $.each(response.data, function (index, item) {
                          $DropdownId.append(`
                              <option value="${item.CODE}">${item.CODE} || ${item.NAME}</option>
                          `);
                      });

                      $DropdownId.select2({
                          placeholder: "- Select -",
                          allowClear: true
                      });

                      if (selectedValue && $DropdownId.find(`option[value="${selectedValue}"]`).length > 0) {
                          $DropdownId.val(selectedValue).trigger('change');
                      }
                      else {
                          $DropdownId.val('').trigger('change');
                      }

                  } else {
                      toastr.error("data Load failed");
                  }
              },
              error: function (xhr, status, error) {
                  toastr.error("data Load failed", error);
              }
          });
      }


