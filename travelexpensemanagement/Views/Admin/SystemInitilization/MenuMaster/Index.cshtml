@{
	ViewBag.Title = "Menu Master Insert";
	Layout = "~/Views/Shared/_Layout.cshtml";
	var currentMenu = ViewBag.CurrentMenu as string;
	bool canAdd = false;
	bool canEdit = false;
	bool canDelete = false;
	bool canPrint = false;
	bool canExport = false;
	bool canMail = false;
	bool canApproval = false;
	bool canDocDetail = false;

	foreach (var permission in Model.UserMenuPermissions)
	{
		if (permission.MENU_NAME == ViewBag.CurrentMenu)
		{
			canAdd = Model.UserLevel == 1 || permission._ADD == 1;
			canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
			canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
			canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
			canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
			canMail = Model.UserLevel == 1 || permission._MAIL == 1;
			canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
			canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
			break;  // Exit loop once found current menu permission
		}
	}
}
<fieldset>
	<legend class="legend-field">Menu Master List</legend>

	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search Module..." aria-label="Search term">
			</div>
		</div>

		<div class="col-lg-6">
			<div class="btn-rightalign">
				@if (canAdd)
				{
					<button id="btnSave" onclick="window.location.href='@Url.Action("MenuMasterAddOrEditForm", "MenuMaster")'" type="submit" class="btn btn-add">
						<i class="fa fa-plus"></i>Add
					</button>
				}
				@if (canPrint)
				{
					<button class="btn btn-print" onclick="callGetReportAsPdf()">
						<i class="fa fa-print"></i> Print
					</button>
				}
				@if (canExport)
				{
					<button class="btn btn-export" onclick="exportToExcel()">
						<i class="fas fa-file-export"></i> Export
					</button>
				}
				@if (canMail)
				{
					<button class="btn btn-mail">
						<i class="fa fa-envelope"></i> Mail
					</button>
				}
				@if (canApproval)
				{
					<button class="btn btn-approved">
						<i class="fa fa-check"></i> Approve
					</button>
				}
			</div>
		</div>
	</div>


	<div class="card">
		<div class="table-responsive">
			<table id="menuMastTable" class="table-width">
				<thead class="table-head">
					<tr>
					<th>Code</th>
					<th>Position</th>
					<th>Menu Name</th>
					<th>Parent Name</th>
					<th>Module</th>
					<th>Web Form Name</th>
					<th>Active</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>
		
	<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
</div>
</fieldset>
<script>
	var canAdd = @canAdd.ToString().ToLower();
	var canEdit = @canEdit.ToString().ToLower();
	var canDelete = @canDelete.ToString().ToLower();
	var canPrint = @canPrint.ToString().ToLower();
	var canExport = @canExport.ToString().ToLower();
	var canMail = @canMail.ToString().ToLower();
	var canApproval = @canApproval.ToString().ToLower();
	var canDocDetail = @canDocDetail.ToString().ToLower();


	let currentPage = 1;
	let pageSize = 10;
	let moduleMap = {};
	let parentModuleMap = {};


	$(document).ready(function () { 
		$.when(
			ModuleDropdownList(),
			ParentModuleDropdownList()
		).done(function(){
			loadAllMenus();
		});
	});

	//Dropdown Loaders-------------------------------------
	function ModuleDropdownList() {
		$.ajax({
			url: '/MenuMaster/GetModuleMasterDdl',
			type: 'GET',
			dataType: 'json',
			success: function (data) {
				var ddl = $('#MODULE_CODE');
				ddl.empty();
				ddl.append('<option value="">-- Select Module --</option>');
				moduleMap = {}; // Clear and reload

				$.each(data, function (index, item) {
					ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
					moduleMap[item.value] = item.text;
				});
			}
		});
	}
	function ParentModuleDropdownList() {
		$.ajax({
			url: '/MenuMaster/GetParentFullListDdl',
			type: 'GET',
			dataType: 'json',
			success: function (data) {
				var ddl = $('#PARENTMODULE_CODE');
				ddl.empty();
				ddl.append('<option value="">-- Select Parent Module --</option>');
				parentModuleMap = {}; // Clear and reload

				$.each(data, function (index, item) {
					ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
					parentModuleMap[item.value] = item.text;
				});
			}
		});
	}



	//Load Full LIST START
	function loadAllMenus() {
		const searchTerm = $('#searchBox').val();

		$.ajax({
			url: '/MenuMaster/GetAllMenus',
			type: 'GET',
			dataType: 'json',
			data: {
				searchTerm: searchTerm,
				pageNumber: currentPage,
				pageSize: pageSize
			},
			success: function (res) {
				console.log(res);
				const menus = res.menus;
				const totalCount = res.totalCount;

				let tbody = $('#menuMastTable tbody');
				tbody.empty();
				if (menus.length === 0) {
					tbody.append('<tr><td colspan="8" class="text-center text-muted">No menus found.</td></tr>');
				}

				$.each(menus, function (index, menu) {
					tbody.append(`
						<tr>
							<td>${menu.code}</td>
							<td>${menu.securitY_TYPE}</td>
							<td>${menu.name}</td>
							<td>${parentModuleMap[menu.mainmenU_CODE] || menu.mainmenU_CODE}</td>
							<td>${moduleMap[menu.modulE_CODE] || menu.modulE_CODE}</td>
							<td>${menu.webFORM_NAME}</td>
							<td>${menu.active === 1 ? 'Yes' : 'No'}</td>
							<td>${canEdit ? `<i class="fa fa-edit btn-edit" title="Edit" onclick="AddOrEditFunction('${menu.code}')"></i>` : ''}
							<i class="fa fa-eye btn-view" title="View Detail" onclick="viewMenuDetails('${menu.code}')"></i>
							${canDelete ? `<i class="fa fa-trash btn-delete" title="Delete"></i>` : ''}
							${canDocDetail ? `<i class="fa fa-file btn-details btn-document" data-doc="${menu.code}" title="Details" style="cursor:pointer;"></i>` : ''}
							</td>

						</tr>
					`);
				});

				renderPagination(totalCount, pageSize, currentPage);
			},
			error: function (xhr) {
				toastr.error('Error loading menu list: ' + xhr.responseText);
			}
		});
	}
	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const paginationContainer = $('#tablePagination');

		// Clear previous pagination
		paginationContainer.empty();

		// No records case
		if (total === 0) {
			paginationContainer.html('<span class="text-muted"></span>');
			return;
		}

		// Don't render pagination if only one page
		if (totalPages <= 1) return;

		let paginationHtml = '';

		// First and Prev
		if (currentPage > 1) {
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		let startPage = Math.max(1, currentPage - 2);
		let endPage = Math.min(totalPages, currentPage + 2);

		if (currentPage <= 3) {
			endPage = Math.min(5, totalPages);
		}
		if (currentPage >= totalPages - 2) {
			startPage = Math.max(totalPages - 4, 1);
		}

		for (let i = startPage; i <= endPage; i++) {
			paginationHtml += `
				<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1"
						onclick="goToPage(${i})">${i}</button>`;
		}

		// Next and Last
		if (currentPage < totalPages) {
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		paginationContainer.html(paginationHtml);
	}
	function goToPage(page) {
		currentPage = page;
		loadAllMenus();
	}
	$('#searchBox').on('keyup', function () {
		currentPage = 1;
		loadAllMenus();
	});
	//Load Full LIST END
	//Redirect to EDIT AND VIEW FROM
	function AddOrEditFunction(rowId) {
		window.location.href = '/MenuMaster/MenuMasterAddOrEditForm?id=' + encodeURIComponent(rowId);
	}
	function viewMenuDetails(rowId) {
		window.location.href = '/MenuMaster/MenuMasterAddOrEditForm?id=' + encodeURIComponent(rowId) + '&readOnly=true';
	}

	 $(document).on('click', '.btn-details', function() {
		const docCode = $(this).data('doc');
		showDocumentPopup(docCode);  // Your popup function
	});


	function exportToExcel() {
			fetch('/MenuMaster/ExportAllDocs')
				.then(response => {
					if (!response.ok) throw new Error("Network response was not ok");
					return response.json();
				})
				.then(data => {
					console.log('kks',data)
				const filteredData = data.map(item => ({
					CODE: item.code,
					MENU_OPTION: item.menU_OPTION,
					NAME: item.name,
					DISPLAY_NAME: item.displaY_NAME,
					FORM_NAME: item.forM_NAME,
					MENU_TYPE: item.menU_TYPE,
					ACTIVE: item.active
				}));
					const worksheet = XLSX.utils.json_to_sheet(filteredData);
					const workbook = XLSX.utils.book_new();
					XLSX.utils.book_append_sheet(workbook, worksheet, "AllDocs");

					const pageName = "Menu Structure";
					const now = new Date();
					const pad = n => String(n).padStart(2, '0');
					const timestamp = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}_${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;

					const fileName = `${pageName}_${timestamp}.xlsx`;
					XLSX.writeFile(workbook, fileName);
				})
				.catch(error => {
					console.error("Export failed:", error);
					toastr.error("Failed to export data.");
				});
		}
	function callGetReportAsPdf() {
		var reportName = "MENU_MAST";
		var now = new Date();
		var day = String(now.getDate()).padStart(2, '0');
		var month = String(now.getMonth() + 1).padStart(2, '0');
		var year = String(now.getFullYear()).slice(-2);
		var hours = String(now.getHours()).padStart(2, '0');
		var minutes = String(now.getMinutes()).padStart(2, '0');
		var seconds = String(now.getSeconds()).padStart(2, '0');
		var timestamp = `${day}${month}${year}_${hours}${minutes}${seconds}`;

		$.ajax({
			url: 'http://192.168.20.51:8082/Report/GetReportAsPdf',
			type: 'GET',
			data: { Reportname: reportName },
			xhrFields: {
				responseType: 'blob'
			},
			success: function (response) {
				console.log('PDF response:', response);
				var file = new Blob([response], { type: 'application/pdf' });
				var fileName = `${reportName}_${timestamp}.pdf`;

				var link = document.createElement('a');
				link.href = URL.createObjectURL(file);
				link.download = fileName;
				document.body.appendChild(link);
				link.click();
				document.body.removeChild(link);
			},
			error: function (xhr, status, error) {
				console.error('Error generating report:', error);
			}
		});
	}
	function showDocumentPopup(docCode) {
		$.ajax({
			url: '/MenuMaster/DocDetailsCode',
			type: 'POST',
			dataType: 'json',  // important
			data: { docCode: docCode },
			success: function(response) {
				console.log(response)
				if(response.success) {
					showDocumentPopupjQuery(response.data, docCode);
				} else {
					toastr.error("Failed to get document details.");
				}
			},
			error: function() {
				toastr.error("An error occurred while fetching document details.");
			}
		});
	}

</script>
