@{
	ViewBag.Title = "Company Master Insert";
	// Layout = "~/Views/Shared/_Layout.cshtml";
	var currentMenu = ViewBag.CurrentMenu as string;
	bool canAdd = false;
	bool canEdit = false;
	bool canDelete = false;
	bool canPrint = false;
	bool canExport = false;
	bool canMail = false;
	bool canApproval = false;
	bool canDocDetail = false;

	foreach (var permission in Model.UserMenuPermissions)
	{
		if (permission.DISPLAY_NAME == ViewBag.CurrentMenu)
		{
			canAdd = Model.UserLevel == 1 || permission._ADD == 1;
			canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
			canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
			canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
			canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
			canMail = Model.UserLevel == 1 || permission._MAIL == 1;
			canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
			canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
			break;  // Exit loop once found current menu permission
		}
	}

}
<fieldset>
	<legend class="legend-field">Company Master List</legend>

	<div class="row"> 
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>

		<div class="col-lg-6">
			<div class="btn-rightalign">
				@if (canAdd)
				{
					<button id="btnSave" onclick="window.location.href='@Url.Action("AddOrEditForm", "CompanyMaster")'" type="submit" class="btn btn-add">
						<i class="fa fa-plus"></i>Add
					</button>
				}
				@if (canPrint)
				{
					<button class="btn btn-print" onclick="callGetReportAsPdf()">
						<i class="fa fa-print"></i> Print
					</button>
				}
				@if (canExport)
				{
					<button class="btn btn-export" onclick="exportToExcel()">
						<i class="fas fa-file-export"></i> Export
					</button>
				}
				@if (canMail)
				{
					<button class="btn btn-mail">
						<i class="fa fa-envelope"></i> Mail
					</button>
				}
				@if (canApproval)
				{
					<button class="btn btn-approved">
						<i class="fa fa-check"></i> Approve
					</button>
				}
			</div>
		</div>

	</div>


	<div class="card">
		<div class="table-responsive">
			<table id="companyTable" class="table-width">
				<thead class="table-head">
					<tr>
						<th>Code</th>
						<th>Name</th>
						<th>City Name</th>
						<th>Pincode</th>
						<th>PAN</th>
						<th>GSTIN</th>
						<th>Status</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="pagination"></div>
				</div>
			</div>
		</div>
	</div>

</fieldset>


<script>

	var canAdd = @canAdd.ToString().ToLower();
	var canEdit = @canEdit.ToString().ToLower();
	var canDelete = @canDelete.ToString().ToLower();
	var canPrint = @canPrint.ToString().ToLower();
	var canExport = @canExport.ToString().ToLower();
	var canMail = @canMail.ToString().ToLower();
	var canApproval = @canApproval.ToString().ToLower();
	var canDocDetail = @canDocDetail.ToString().ToLower();

		let compCurrentPage = 1;
		let compPageSize = 10;
		let CountryOptionsHtml = '';
		let StateOptionsHtml = '';
		let CityOptionsHtml = '';
		let CurrencyOptionsHtml = '';
		let LanguageOptionsHtml = '';
		let mapCity = {};

		$(document).ready(function () {
			$.when(
				loadCityDropdownOptions(),
				loadCurrencyDropdownOptions(),
				loadLanguageDropdownOptions()
			).done(function () {
			loadAllCompanies();
		});
	});

	// Load company data with pagination and search
	function loadAllCompanies() {
		const searchTerm = $('#searchBox').val();
		$.ajax({
			url: '/CompanyMaster/GetAllCompanies', 
			type: 'GET',
			dataType: 'json',
			data: {
				searchTerm: searchTerm,
				pageNumber: compCurrentPage,
				pageSize: compPageSize
			},
			success: function (res) {
				console.log(res);
				const companies = res.groups || res.companies || [];
				const totalCount = res.totalCount || 0;

				let tbody = $('#companyTable tbody');
				tbody.empty();

				if (companies.length === 0) {
					tbody.append('<tr><td colspan="7" class="text-center text-muted">No companies found.</td></tr>');
					renderCompPagination(0, compPageSize, compCurrentPage);
					return;
				}
				$.each(companies, function (index, comp) {
					tbody.append(`
						<tr>
							<td>${comp.code}</td>
							<td>${comp.name}</td>
							<td>${mapCity[comp.citY_CODE] || ''}</td>
							<td>${comp.pincode || ''}</td>
							<td>${comp.pan || ''}</td>
							<td>${comp.gstin || ''}</td>
							<td>${comp.active ? 'Active':'IsActive'}</td>
							
							 <td>
								${canEdit ? `<i class="fa fa-edit btn-edit" data-doc="${comp.code}" title="Edit"></i>` : ''}
								<i class="fa fa-eye btn-view" data-doc="${comp.code}" title="View"></i>
								${canDelete ? `<i class="fa fa-trash btn-delete" data-doc="${comp.code}" title="Delete"></i>` : ''}
								<i class="fa fa-file btn-details btn-document" data-doc="${comp.code}" title="Details"></i>
							</td>

						</tr>
					`);
				});

				renderCompPagination(totalCount, compPageSize, compCurrentPage);
			},
			error: function (xhr) {
				toastr.error('Error loading company list: ' + xhr.responseText);
			}
		});
	}

	// Render pagination for company table
	function renderCompPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const paginationContainer = $('#pagination');
		paginationContainer.empty();

		if (totalPages <= 1) return;

		let paginationHtml = '';

		if (currentPage > 1) {
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToCompPage(1)">First</button>`;
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToCompPage(${currentPage - 1})">Prev</button>`;
		}

		let startPage = Math.max(1, currentPage - 2);
		let endPage = Math.min(totalPages, currentPage + 2);

		if (currentPage <= 3) endPage = Math.min(5, totalPages);
		if (currentPage >= totalPages - 2) startPage = Math.max(totalPages - 4, 1);

		for (let i = startPage; i <= endPage; i++) {
			paginationHtml += `
				
					<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1"
							onclick="goToCompPage(${i})">${i}</button>
				`;
		}

		if (currentPage < totalPages) {
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToCompPage(${currentPage + 1})">Next</button>`;
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToCompPage(${totalPages})">Last</button>`;
		}

		paginationContainer.html(paginationHtml);
	}

	// Change page
	function goToCompPage(page) {
		compCurrentPage = page;
		loadAllCompanies();
	}

	// Search trigger
	$('#searchBox').on('keyup', function () {
		compCurrentPage = 1;
		loadAllCompanies();
	});


	 $(document).on('click', '.btn-edit', function() {
		const docCode = $(this).data('doc');
		editCompanyMaster(docCode);
	});

	$(document).on('click', '.btn-view', function() {
		const docCode = $(this).data('doc');
		viewCompanyMasterDetails(docCode);
	});

	$(document).on('click', '.btn-delete', function() {
		const docCode = $(this).data('doc');
		deleteCompany(docCode);  // Make sure this function exists
	});

	$(document).on('click', '.btn-details', function() {
		const docCode = $(this).data('doc');
		showDocumentPopup(docCode);  // Your popup function
	});


	function editCompanyMaster(rowId) {
		window.location.href = '/CompanyMaster/AddOrEditForm?id=' + encodeURIComponent(rowId);
	}
	function viewCompanyMasterDetails(rowId) {
		window.location.href = '/CompanyMaster/AddOrEditForm?id=' + encodeURIComponent(rowId) + '&readOnly=true';
	}

	function loadCityDropdownOptions() {
		return $.ajax({
			url: '/CompanyMaster/GetCityList',
			type: 'GET',
			success: function (data) {
				CityOptionsHtml = '<option value="">-- Select City --</option>';
				data.forEach(function (item) {
					CityOptionsHtml += `<option value="${item.value}">${item.text}</option>`;
					mapCity[item.value] = item.text;
				});
			}
		});
	}
	function loadCurrencyDropdownOptions() {
		return $.ajax({
			url: '/CompanyMaster/GetCurrencyList',
			type: 'GET',
			success: function (data) {
				CurrencyOptionsHtml = '<option value="">-- Select City --</option>';
				data.forEach(function (item) {
					 CurrencyOptionsHtml += `<option value="${item.value}">${item.text}</option>`;
				});
			}
		});
	}
	function loadLanguageDropdownOptions() {
		return $.ajax({
				url: '/CompanyMaster/GetLanguageList',
			type: 'GET',
			success: function (data) {
					LanguageOptionsHtml = '<option value="">-- Select City --</option>';
				data.forEach(function (item) {
					LanguageOptionsHtml += `<option value="${item.value}">${item.text}</option>`;
				});
			}
		});
	}


