@{
	ViewBag.Title = "Year Master List";
	Layout = "~/Views/Shared/_Layout.cshtml";
	var currentMenu = ViewBag.CurrentMenu as string;
	bool canAdd = false;
	bool canEdit = false;
	bool canDelete = false;
	bool canPrint = false;
	bool canExport = false;
	bool canMail = false;
	bool canApproval = false;
	bool canDocDetail = false;

	foreach (var permission in Model.UserMenuPermissions)
	{
		if (permission.DISPLAY_NAME == ViewBag.CurrentMenu)
		{
			canAdd = Model.UserLevel == 1 || permission._ADD == 1;
			canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
			canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
			canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
			canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
			canMail = Model.UserLevel == 1 || permission._MAIL == 1;
			canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
			canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
			break;  // Exit loop once found current menu permission
		}
	}
}
<fieldset>
	<legend class="legend-field">Year Master List</legend>

	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchInput" class="form-control" placeholder="Search Module..." aria-label="Search term">
			</div>
		</div>

		<div class="col-lg-6">
			<div class="btn-rightalign">
				@if (canAdd)
				{
					<button id="btnSave" onclick="window.location.href='@Url.Action("YearMast", "YearMaster")'" type="submit" class="btn btn-add">
						<i class="fa fa-plus"></i>Add
					</button>
				}
				@if (canPrint)
				{
					<button class="btn btn-print" onclick="callGetReportAsPdf()">
						<i class="fa fa-print"></i> Print
					</button>
				}
				@if (canExport)
				{
					<button class="btn btn-export" onclick="exportToExcel()">
						<i class="fas fa-file-export"></i> Export
					</button>
				}
				@if (canMail)
				{
					<button class="btn btn-mail">
						<i class="fa fa-envelope"></i> Mail
					</button>
				}
				@if (canApproval)
				{
					<button class="btn btn-approved">
						<i class="fa fa-check"></i> Approve
					</button>
				}
			</div>
		</div>

	</div>


	<div class="card">
		<div class="table-responsive">
			<table id="tabledt" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>Current Year</th>
						<th>Previous Year</th>
						<th>Start Date</th>
						<th>End Date</th>
						<th>TStart Date</th>
						<th>Prefix Year</th>
						<th style="display:none;">Current DSN</th>
						<th style="display:none;">Previous DSN</th>
						<th style="display:none;">Current Server</th>
						<th style="display:none;">Previous Server</th>
						<th style="display:none;">Current User</th>
						<th style="display:none;">Previous User</th>
						<th style="display:none;">Current Password</th>
						<th style="display:none;">Previous Password</th>
						<th>Database Avl</th>
						<th>Status</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>

		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="pagination"></div>
				</div>
			</div>
		</div>

	</div>
</fieldset>

<script>
var canAdd = @canAdd.ToString().ToLower();
var canEdit = @canEdit.ToString().ToLower();
var canDelete = @canDelete.ToString().ToLower();
var canPrint = @canPrint.ToString().ToLower();
var canExport = @canExport.ToString().ToLower();
var canMail = @canMail.ToString().ToLower();
var canApproval = @canApproval.ToString().ToLower();
var canDocDetail = @canDocDetail.ToString().ToLower();
let allMastData = [];
let filteredData = [];
let currentPage = 1;
const rowsPerPage = 10;
var yearMastDt=[];

// Fetch data on page load
$(document).ready(function () {
getYearMaster();
$(document).on('click', '.page-link', function (e) {
				e.preventDefault();
				const page = parseInt($(this).data('page'));
				const totalPages = Math.ceil(allMastData.length / rowsPerPage);

				if (page >= 1 && page <= totalPages) {
					currentPage = page;
					renderYearMasterTable();
					renderYearMasterPagination();
				}
			});
$('#searchInput').on('input', function () {
				const keyword = $(this).val().toLowerCase();
				filteredData = allMastData.filter(item => {
					return Object.values(item).some(val =>
						String(val).toLowerCase().includes(keyword)
					);
				});

				currentPage = 1;
				renderYearMasterTable();
				renderYearMasterPagination();
			});
$(document).on('click', '.btn-edit', function () {
		const $row = $(this).closest('tr');
		getDataOfRow($row);
		localStorage.setItem('editYearMast', JSON.stringify(yearMastDt));
		localStorage.setItem('Mode', 'Edit');
		window.location.href = '/YearMaster/YearMast';
	});
$(document).on('click', '.btn-view', function () {
		const $row = $(this).closest('tr');
		getDataOfRow($row);
		localStorage.setItem('editYearMast', JSON.stringify(yearMastDt));
		localStorage.setItem('Mode', 'View');
		window.location.href = '/YearMaster/YearMast';
	});
$(document).on('click', '.btn-delete', function() {
					const $row = $(this).closest('tr');
	const CodeforDel = $row.find('.code').text().trim();
	const sno = $row.find('.sno').text().trim();
	console.log(CodeforDel, sno);

				Swal.fire({
					title: 'Are you sure you want to delete?',
					text: "This action cannot be undone.",
					icon: 'warning',
					showCancelButton: true,
					confirmButtonText: 'Yes, delete it!',
					cancelButtonText: 'No, cancel!',
					reverseButtons: true
				}).then((result) => {
					if (result.isConfirmed) {
						$.ajax({
							url: '/YearMaster/DelYearDt',
							type: 'DELETE',
							data: { code: CodeforDel, sno:sno },
							success: function(data) {
								if (data.status === true) {
									Swal.fire(
										'Deleted!',
										'Your data has been deleted.',
										'success'
									);
									$row.remove();
									getYearMaster();
								} else {
									Swal.fire(
										'Error!',
										'There was an issue deleting the data.',
										'error'
									);
								}
							},
							error: function(xhr, status, error) {
								Swal.fire(
									'Error!',
									'Data could not be deleted: ' + error,
									'error'
								);
							}
						});
					}
				});
			});
$(document).on('click', '.btn-details', function() {
	const docCode = $(this).data('doc');
	showDocumentPopup(docCode);  // Your popup function
});

});

function getDataOfRow($row) {
	     yearMastDt = {
		  code: $row.find('.code').text().trim(),
		  currentYear: $row.find('.currentYear').text().trim(),
		  previousYear: $row.find('.previousYear').text().trim(),
		  startDt: $row.find('.startDt').text().trim(),
		  endDt: $row.find('.endDt').text().trim(),
		  tStartDt: $row.find('.tStartDt').text().trim(),
		  prefixYear: $row.find('.prefixYear').text().trim(),
		  currentDsn: $row.find('.currentDsn').text().trim(),
		  previousDsn: $row.find('.previousDsn').text().trim(),
		  currentServer: $row.find('.currentServer').text().trim(),
		  previousServer: $row.find('.previousServer').text().trim(),
		  currentUser: $row.find('.currentUser').text().trim(),
		  previousUser: $row.find('.previousUser').text().trim(),
		  currentPassword:$row.find('.currentPassword').text().trim(),
		  prevPasswrd:$row.find('.prevPasswrd').text().trim(),
		  databaseAvl: $row.find('.databaseAvl').text().trim(),
		  status: $row.find('.status').text().trim()
	   };


	}
function getYearMaster() {
				debugger;
				$.ajax({
					url:'@Url.Action("getYearMaster", "YearMaster")',
					type: 'GET',
					dataType: 'json',
					success: function (data) {
						if (data.status === true) {
							 allMastData = data.data;
							filteredData=allMastData;
							console.log(filteredData);
							currentPage = 1;
							renderYearMasterTable();
							renderYearMasterPagination();

						} else {
							alert("Data Load Failed");
						}
					},
					error: function (xhr, status, error) {
						console.error('Error: ' + xhr.responseText);
						alert('Data Load Failed: ' + error);
					}
				});
			}
function renderYearMasterTable() {
				const tbody = $('#tabledt tbody');
				tbody.empty();
				const start = (currentPage - 1) * rowsPerPage;
				const end = start + rowsPerPage;
				const pageData = filteredData.slice(start, end);
				pageData.forEach(item => {
					const row = `<tr>
					<td class="code d-none">${item.code}</td>
					<td class="currentYear">${item.currentYear}</td>
					<td class="previousYear">${item.previousYear}</td>
					<td class="startDt">${item.startDt}</td>
					<td class="endDt">${item.endDt}</td>
					<td class="tStartDt">${item.tStartDt}</td>
					<td class="prefixYear">${item.prefixYear}</td>
					<td class="currentDsn d-none">${item.currentDsn}</td>
					<td class="previousDsn d-none">${item.previousDsn}</td>
					<td class="currentServer d-none">${item.currentServer}</td>
					<td class="previousServer d-none">${item.previousServer}</td>
					<td class="previousServer d-none">${item.previousServer}</td>
					<td class="currentUser d-none">${item.currentUser}</td>
					<td class="previousUser d-none">${item.previousUser}</td>
					<td class="currentPassword d-none">${item.currentPassword}</td>
					<td class="prevPasswrd d-none">${item.prevPasswrd}</td>
					<td class="databaseAvl">${item.databaseAvl}</td>
					<td class="status">${item.status}</td>
									<td>
										 ${canEdit ? `<i class="fas fa-edit btn-edit" title="Edit"></i>` : ''}
									
										<i class="fas fa-eye btn-view" title="View"></i>
									
									 ${canDelete ? `<i class="fa fa-trash btn-delete" title="Delete"></i>` : ''}
									 ${canDocDetail ? `<i class="fa fa-file btn-details btn-document" data-doc="${item.code}" title="Details"></i>` : ''}

									</td>

					</tr>`;
					tbody.append(row);
				});
			}
function renderYearMasterPagination() {
				const totalPages = Math.ceil(filteredData.length / rowsPerPage);
				const pagination = $('#pagination');
				pagination.empty();

				if (totalPages <= 1) return;

				const maxVisiblePages = 7;
				const ellipsis = '<li class="page-item disabled"><span class="page-link">...</span></li>';

				pagination.append(`<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
					<a class="page-link" href="#" data-page="${currentPage - 1}">Prev</a>
				</li>`);

				let startPage = Math.max(1, currentPage - 2);
				let endPage = Math.min(totalPages, currentPage + 2);

				if (currentPage <= 4) {
					startPage = 1;
					endPage = Math.min(totalPages, maxVisiblePages - 2);
				} else if (currentPage >= totalPages - 3) {
					startPage = Math.max(1, totalPages - (maxVisiblePages - 3));
					endPage = totalPages;
				}

				if (startPage > 1) {
					pagination.append(`<li class="page-item"><a class="page-link" href="#" data-page="1">1</a></li>`);
					if (startPage > 2) pagination.append(ellipsis);
				}

				for (let i = startPage; i <= endPage; i++) {
					pagination.append(`<li class="page-item ${i === currentPage ? 'active' : ''}">
						<a class="page-link" href="#" data-page="${i}">${i}</a>
					</li>`);
				}

				if (endPage < totalPages) {
					if (endPage < totalPages - 1) pagination.append(ellipsis);
					pagination.append(`<li class="page-item"><a class="page-link" href="#" data-page="${totalPages}">${totalPages}</a></li>`);
				}

				// Next button
				pagination.append(`<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
					<a class="page-link" href="#" data-page="${currentPage + 1}">Next</a>
				</li>`);
			}

function exportToExcel() {
					fetch('/YearMaster/ExportAllDocs')
					.then(response => {
						if (!response.ok) throw new Error("Network response was not ok");
						return response.json();
					})
					.then(data => {
							const filteredData = data.map(item => ({
					"Code": item.code,
					"Previous Year": item.preV_YEAR,
					"Start Date": item.starT_DATE,
					"End Date": item.enD_DATE,
					"T-Start Date": item.tstarT_DATE,
					"Prefix Year": item.prefiXYR,
					"Database Available": item.databasE_AVL,
					"Status": item.status
				}));
						const worksheet = XLSX.utils.json_to_sheet(filteredData);
						const workbook = XLSX.utils.book_new();
						XLSX.utils.book_append_sheet(workbook, worksheet, "AllDocs");

							const pageName = "Posting Periods";
						const now = new Date();
						const pad = n => String(n).padStart(2, '0');
						const timestamp = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}_${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;

						const fileName = `${pageName}_${timestamp}.xlsx`;
						XLSX.writeFile(workbook, fileName);
					})
					.catch(error => {
						console.error("Export failed:", error);
						toastr.error("Failed to export data.");
					});
			}
function callGetReportAsPdf() {
				var reportName = "POSTING_PERIOD";
			var now = new Date();
			var day = String(now.getDate()).padStart(2, '0');
			var month = String(now.getMonth() + 1).padStart(2, '0');
			var year = String(now.getFullYear()).slice(-2);
			var hours = String(now.getHours()).padStart(2, '0');
			var minutes = String(now.getMinutes()).padStart(2, '0');
			var seconds = String(now.getSeconds()).padStart(2, '0');
			var timestamp = `${day}${month}${year}_${hours}${minutes}${seconds}`;

			$.ajax({
				url: 'http://192.168.20.51:8082/Report/GetReportAsPdf',
				type: 'GET',
				data: { Reportname: reportName },
				xhrFields: {
					responseType: 'blob'
				},
				success: function (response) {
					console.log('PDF response:', response);
					var file = new Blob([response], { type: 'application/pdf' });
					var fileName = `${reportName}_${timestamp}.pdf`;

					var link = document.createElement('a');
					link.href = URL.createObjectURL(file);
					link.download = fileName;
					document.body.appendChild(link);
					link.click();
					document.body.removeChild(link);
				},
				error: function (xhr, status, error) {
					console.error('Error generating report:', error);
				}
			});
		}
function showDocumentPopup(docCode) {
			$.ajax({
					url: '/YearMaster/DocDetailsCode',
				type: 'POST',
				dataType: 'json',  // important
				data: { docCode: docCode },
				success: function(response) {
					if(response.success) {
						showDocumentPopupjQuery(response.data, docCode);
					} else {
						toastr.error("Failed to get document details.");
					}
				},
				error: function() {
					toastr.error("An error occurred while fetching document details.");
				}
			});
		}
</script>




