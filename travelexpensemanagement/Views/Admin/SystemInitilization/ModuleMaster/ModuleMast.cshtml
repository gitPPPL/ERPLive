@{
	ViewBag.Title = "Master Insert";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
	<fieldset>
		<legend class="legend-field">Module Master</legend>
		<div class="row">
			<div class="offset-md-10 col-md-2">
			<div class="btn-right">
				<button onclick="window.location.href='@Url.Action("Index", "ModuleMaster")'" type="submit" class="btn btn-primary">
					<i class="fa fa-list"></i>Back to list
				</button>
			</div>
			</div>
		</div>
		<form>
			<div class="row">
				<div class="col-md-4">
					<div class="form-group">
					<label>Name<span class="required">*</span></label>
					<input type="text" class="form-control" id="Txtname" placeholder="Name" name="Name">
					</div>
				</div>
				<div class="col-md-4">
					<div class="form-group">
					<label>Display Name<span class="required">*</span></label>
					<input type="text" class="form-control" placeholder="Display Name" id="TxtDisplayname" name="Short Name">
					</div>
				</div>
				<div class="col-md-4">
					<div class="form-group">
					<label> Position No<span class="required">*</span></label>
					<input type="number" class="form-control" placeholder="Position No" id="TxtPositionNo" name="Short Name">
					</div>
				</div>
			</div>

			<div class="row">
				<div class="offset-md-8 col-md-2">
					<div class="form-group">
						<div class="toggle-wrapper justify-content-center" id="">
							<input type="hidden" id="DdActive" name="IsActive" value="1" />

							<div id="customToggle" class="custom-toggle active"></div>
							<span id="statusLabel" class="status-label active">Active</span>

						</div>
					</div>
				</div>
				<div class="col-md-2">
					<div class="btn-last">
					<button type="submit" class="btn btn-primary" id="btn-save"><i class="fa fa-save"></i>Save</button>
				</div>
			</div>
			</div>
		</form>
	</fieldset>


<script>

	const toggle = document.getElementById("customToggle");
	 const statusLabel = document.getElementById("statusLabel");
	 const hiddenInput = document.getElementById("DdActive");

	 toggle.addEventListener("click", function () {
	   if (toggle.classList.contains("disabled")) return;

	   toggle.classList.toggle("active");
	   const isActive = toggle.classList.contains("active");

	   hiddenInput.value = isActive ? "1" : "0";
	   statusLabel.textContent = isActive ? "Active" : "Inactive";
	   statusLabel.classList.toggle("active", isActive);
	   statusLabel.classList.toggle("inactive", !isActive);
	 });

	 function disableToggle() {
	   toggle.classList.add("disabled");
	 }

	 function enableToggle() {
	   toggle.classList.remove("disabled");
	 }

	function setToggleState(value) {
	  const toggle = document.getElementById("customToggle");
	  const label = document.getElementById("statusLabel");
	  const hiddenInput = document.getElementById("DdActive");
	  const isActive = Number(value) === 1;
	  toggle.classList.toggle("active", isActive);
	  label.textContent = isActive ? "Active" : "Inactive";
	  label.classList.toggle("active", isActive);
	  label.classList.toggle("inactive", !isActive);
	  hiddenInput.value = isActive ? "1" : "0";

	}

</script>
<script>

		let lanageModuleCode=0;
		let PreviousInputDt = "";
		let allMastData = [];
		let filteredData = [];
		let currentPage = 1;
		const rowsPerPage = 10;
		let ModeOfControl="";
		let getModuleMastDt=[];

		const storedData = localStorage.getItem('editModule');
		ModeOfControl = localStorage.getItem('Mode');
		  localStorage.removeItem('Mode');
		  console.log(storedData);

		$(document).ready(function(){
		if (storedData && ModeOfControl === 'Edit') {
		  getModuleMastDt = JSON.parse(storedData);
		 lanageModuleCode = getModuleMastDt.code;
		 PreviousInputDt = getModuleMastDt.name;


		  $('#Txtname').val(getModuleMastDt.name);
		  $('#TxtDisplayname').val(getModuleMastDt.displayName);
		  $('#TxtPositionNo').val(getModuleMastDt.positionNo);

		 setToggleState(getModuleMastDt.active);

		  $('input').prop('readonly', false);
		  $('#btn-save').show();
		  $('#cancelBtn').show();
		  localStorage.removeItem('editModule');

		}
		else if (storedData && ModeOfControl === 'View') {
			$('#btn-save').hide();
			$('#cancelBtn').hide();
			getModuleMastDt = JSON.parse(storedData);
		  $('#Txtname').val(getModuleMastDt.name);
		  $('#TxtDisplayname').val(getModuleMastDt.displayName);
		  $('#TxtPositionNo').val(getModuleMastDt.positionNo);
		  $('#DdActive').val(getModuleMastDt.active);

		  setToggleState(getModuleMastDt.active);
		   $('input').prop('readonly', true);
			disableToggle();
		  localStorage.removeItem('editModule');
		}

		});

		// Event: Save new Module
		$('#btn-save').on('click', function (e) {
			e.preventDefault();
			if (!validateRequiredField('#Txtname', 'Name')) return;
			if (!validateRequiredField('#TxtDisplayname', 'Display Name')) return;
			if (!validateRequiredField('#TxtPositionNo', 'Position No')) return;

			if(ModeOfControl=='Edit')
			{
				const ModuleData = {
					code: lanageModuleCode,
					Name: name,
					displayname: displayname,
					positionNo: positionNo,
					Active: active
				};
				 EditModulemast(ModuleData, name)
			}
			else
			{
				const ModuleData = {
					Name: name,
					displayname: displayname,
					positionNo: positionNo,
					Active: active
				};
			 saveModuleMastDt(ModuleData, name);
			}
		});
	function saveModuleMastDt(ModuleData, name)
	{
			checkExistOrNot(name).done(function (data) {
					if (data.status === true && data.exists === true) {
						toastr.warning("Duplicate Module Name");
						return;
					}
						$.ajax({
						url: '@Url.Action("SaveModuleMastDt", "ModuleMaster")',
						type: 'POST',
						contentType: 'application/json',
						data: JSON.stringify(ModuleData),
						success: function (response) {
							if (response.status === true) {								 
								toastr.success('Data inserted successfully!');
								resetFields();
						setTimeout(function () {
						 window.location.href ='/ModuleMaster/Index';
						}, 1500);
								
							} else {
								toastr.error(response.message || "Save failed");
							}
						},
						error: function (xhr) {
							console.error(xhr.responseText);
							toastr.error("Error occurred while saving.");
						}
					});

				}).fail(function (xhr, status, error) {
					toastr.error("Error while checking Module.");
				});
	}
	function EditModulemast(ModuleData, name){
		if (PreviousInputDt !== name) {
				checkExistOrNot(name)
					.done(function (data) {
						if (data.status === true && data.exists === true) {
							toastr.warning("Duplicate Module Name");
							return;
						}
						updateModuleData(ModuleData, name);
					})
					.fail(function (xhr, status, error) {
						toastr.error("Error while checking Module.");
					});
			} else {
				updateModuleData(ModuleData);
			}
	}
		// Helper Functions
		function resetFields() {
			$('#Txtname').val('');
			$('#TxtDisplayname').val('');
			$('#TxtPositionNo').val('');
			 setToggleState(1);
			$('#searchInput').val('');
		}
		function updateModuleData(updatedData) {
			$.ajax({
				url: '/ModuleMaster/UpdateModuleDt',
				type: 'POST',
				data: JSON.stringify(updatedData),
				contentType: 'application/json',
				dataType: 'json',
				success: function (response) {
					if (response.status === true) {						 
						toastr.success('Data update successfully!');
						resetFields();
						setTimeout(function () {
	                  	window.location.href = '/ModuleMaster/Index';
	                    }, 1500);
						  
					} else {
						toastr.error("Update failed: " + response.message);
					}
				},
				error: function (xhr) {
					toastr.error("Data not updated.");
				}
			});
		}
		function checkExistOrNot(inputData) {
			return $.ajax({
				url: '@Url.Action("getExitOrNot", "ModuleMaster")',
				type: 'GET',
				dataType: 'json',
				data: { doctype: inputData }
			});
		}

		$('#Txtname').on('keydown', function (e) {
			if (e.key === 'Enter') {
				e.preventDefault();
				$('#TxtDisplayname').focus();
			}
		});
		$('#TxtDisplayname').on('keydown', function (e) {
			if (e.key === 'Enter') {
				e.preventDefault();
				$('#TxtPositionNo').focus();
			}
		});
		$('#TxtPositionNo').on('keydown', function (e) {
			if (e.key === 'Enter') {
				e.preventDefault();
				$('#btn-save').focus();
			}
		});
	document.getElementById("cancelBtn").addEventListener("click", function () {
	  Swal.fire({
		title: 'Are you sure?',
		text: "Do you want to cancel all the changes?",
		icon: 'warning',
		showCancelButton: true,
		confirmButtonText: 'Yes, cancel it!',
		cancelButtonText: 'No, keep it',
		reverseButtons: true
	  }).then((result) => {
		if (result.isConfirmed) {
		  Swal.fire(
			'Cancelled!',
			'Your action has been cancelled.',
			'success'
		  )
		 if(ModeOfControl=='Edit')
		 {
		$('#Txtname').val(getModuleMastDt.name);
		$('#TxtDisplayname').val(getModuleMastDt.displayName)
		$('#TxtPositionNo').val(getModuleMastDt.positionNo);
		  setToggleState(getModuleMastDt.active);
	}
	else
	{
	resetFields();
	}
		} else if (result.dismiss === Swal.DismissReason.cancel) {
		  Swal.fire(
			'Resumed',
			'Your action is still in progress.',
			'info'
		  )
		}
	  });
	});

</script>