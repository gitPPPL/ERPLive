@{
    ViewBag.Title = "Master Insert";
    Layout = "~/Views/Shared/_Layout.cshtml";
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <script>
        function redirectToDashboard() {
            window.location.href = '@Url.Action("Index", "Dashboard")';
        }
    </script>
    <style>
        .table th, .table td {
            vertical-align: middle;
            font-size: 12px;
        }

        .table thead th i {
            margin-right: 6px;
        }
        .table-hover tbody tr:hover {
            background-color: #f9f9f9;
        }
        .btn-sm {
            padding: 2px 6px;
        }

        .editBtn, .updateBtn {
            margin-right: 4px;
        }

        select.form-control {
            font-size: 12px;
            height: 25px !important;
            padding: 0 5px;
        }

        .table td, .table th {
            padding: .35rem !important;
        }

        .bg-warning {
            background-color: gray !important;
            color: #fff;
        }

        #rowContainerReturn .form-control,
        #rowContainerReturn .form-select {
            min-height: 33px !important;
            width: 100% !important;
            font-size: 12px !important;
        }

        #rowContainerReturn .btn {
            padding: 6px 10px;
        }
    </style>
}

<div class="row">
    <div class="col-md-4">
        <h5 class="mb-3 font-weight-bold text-dark">Employee Details List</h5>
    </div>
    <div class="col-md-4">
    </div>
    <div class="col-md-4">
        <button id="btnSave" onclick="window.location.href='@Url.Action("Index", "Employee")'" style="font-size: 9px;height: 28px; line-height: 1px; float: right;" type="submit" class="btn btn-primary">
            Add Employee
        </button>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-bordered table-hover mb-0" id="travelRequestTable">
            <thead style="background-color: #1f4e79; color: white;">
                <tr>
                    <th style="font-size: 12px;"><i class="fas fa-sort"></i>Emp ID</th>
                    <th style="font-size: 12px;"><i class="fas fa-sort"></i> Employee</th>
                    <th style="font-size: 12px;"><i class="fas fa-sort"></i> Mobile</th>
                    <th style="font-size: 12px;"><i class="fas fa-sort"></i> Email</th>
                    <th style="font-size: 12px;"><i class="fas fa-sort"></i> Address</th>
                    <th style="font-size: 12px;"><i class="fas fa-sort"></i> Department</th>
                    <th style="font-size: 12px;"><i class="fas fa-sort"></i> Designation</th>
                    <th style="font-size: 12px;"><i class="fas fa-sort"></i> Date</th>
                    <th style="font-size: 12px;"><i class="fas fa-sort"></i> Edit</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>

    </div>
</div>

<script>
    let currentPage = 1;
    const pageSize = 10;
    let DepartmentOptionsHtml = '';
    let DesignationOptionsHtml = '';

    $(document).ready(function () {
        $.when(
            loadDepartmentDropdownOptions(),
            loadDesignationDropdownOptions()
        ).done(function () {
            loadEmployeeList(currentPage);
        });
        function loadEmployeeList(page) {
            $.ajax({
                url: '/EmployeeDetailsList/GetPagedTravelRequests',
                type: 'GET',
                data: { page: page, pageSize: pageSize },
                success: function (response) {
                    if (response.success && response.employeeList.length > 0) {
                        const tbody = $('#travelRequestTable tbody');
                        tbody.empty();
                        response.employeeList.forEach(function (row) {
                            tbody.append(`
                                <tr data-id="${row.empID}">
                                    <td style="font-size: 12px;">${row.empID}</td>
                                    <td style="font-size: 12px;" contenteditable="false" class="editable">${row.name}</td>
                                    <td style="font-size: 12px;" contenteditable="false" class="editable">${row.mobileNo}</td>
                                     <td style="font-size: 12px;" contenteditable="false" class="editable">${row.email}</td>
                                     <td style="font-size: 12px;" contenteditable="false" class="editable">${row.address}</td>
                                    <td style="font-size: 12px;" class="editable departmentDropdownCell" data-value="${row.department}"></td>
                                    <td style="font-size: 12px;" class="editable designationDropdownCell" data-value="${row.designation}"></td>
                                    <td style="font-size: 12px;" contenteditable="false" class="editable">${row.date}</td>
                                    <td>
                                        <button class="btn btn-sm btn-light editBtn" title="Edit">
                                            <i class="fas fa-edit text-primary" style="font-size: 15px;"></i>
                                        </button>
                                        <button class="btn btn-sm btn-light updateBtn" title="Update" style="display:none;">
                                            <i class="fas fa-check text-success" style="font-size: 15px;"></i>
                                        </button>
                                        <button class="btn btn-sm btn-light cancelBtn" title="Cancel" style="display:none;">
                                            <i class="fas fa-times text-danger" style="font-size: 15px;"></i>
                                        </button>
                                    </td>
                                </tr>
                            `);
                        });
                        populateDropdowns();
                        renderPagination(response.totalCount, page);
                    } else {
                        $('#travelRequestTable tbody').html('<tr><td colspan="10">No data available.</td></tr>');
                        $('#pagination').empty();
                    }
                }
            });
        }
        function loadDepartmentDropdownOptions() {
            return $.ajax({
                url: '/EmployeeDetailsList/GetDepartmentsList',
                type: 'GET',
                success: function (data) {
                    DepartmentOptionsHtml = '<option value="">-- Select Department --</option>';
                    data.forEach(function (item) {
                        DepartmentOptionsHtml += `<option value="${item.value}">${item.text}</option>`;
                    });
                }
            });
        }
        function loadDesignationDropdownOptions() {
            return $.ajax({
                url: '/EmployeeDetailsList/GetDesignationList',
                type: 'GET',
                success: function (data) {
                    DesignationOptionsHtml = '<option value="">-- Select Designation --</option>';
                    data.forEach(function (item) {
                        DesignationOptionsHtml += `<option value="${item.value}">${item.text}</option>`;
                    });
                }
            });
        }
        function populateDropdowns() {
            $('#travelRequestTable .departmentDropdownCell').each(function () {
                const selectedValue = $(this).data('value');
                const select = $('<select class="form-control fromDropdown" disabled></select>').html(DepartmentOptionsHtml);
                select.val(selectedValue);
                $(this).html(select);
            });

            $('#travelRequestTable .designationDropdownCell').each(function () {
                const selectedValue = $(this).data('value');
                const select = $('<select class="form-control toDropdown" disabled></select>').html(DesignationOptionsHtml);
                select.val(selectedValue);
                $(this).html(select);
            });
        }
        function renderPagination(totalCount, currentPage) {
            const totalPages = Math.ceil(totalCount / pageSize);
            let html = '';
            for (let i = 1; i <= totalPages; i++) {
                html += `<button class="btn btn-sm ${i === currentPage ? 'btn-dark' : 'btn-light'}" data-page="${i}">${i}</button> `;
            }
            $('#pagination').html(html);
        }
        $(document).on('click', '#pagination button', function () {
            currentPage = parseInt($(this).data("page"));
            loadEmployeeList(currentPage);
        });

        $(document).on('click', '.editBtn', function () {
            const row = $(this).closest('tr');
            row.data('original', {
                name: row.find('td:eq(1)').text().trim(),
                department: row.find('.fromDropdown').val(),
                designation: row.find('.toDropdown').val(),
                date: row.find('td:eq(7)').text().trim(),
                mobileNo: row.find('td:eq(2)').text().trim(),
                email: row.find('td:eq(3)').text().trim(),
                address: row.find('td:eq(4)').text().trim()
            });

            row.find('.editable').not('.departmentDropdownCell, .designationDropdownCell')
                .attr('contenteditable', 'true')
                .addClass('bg-warning');
            row.find('.fromDropdown, .toDropdown').prop('disabled', false);
            row.find('.editBtn').hide();
            row.find('.updateBtn').show();
            row.find('.cancelBtn').show();
        });

        $(document).on('click', '.cancelBtn', function () {
            const row = $(this).closest('tr');
            const original = row.data('original');

            row.find('td:eq(1)').text(original.name);
            row.find('.fromDropdown').val(original.department).prop('disabled', true);
            row.find('.toDropdown').val(original.designation).prop('disabled', true);
            row.find('td:eq(7)').text(original.date);
            row.find('td:eq(2)').text(original.mobileNo);
            row.find('td:eq(3)').text(original.email);
            row.find('td:eq(4)').text(original.address);

            row.find('.editable').attr('contenteditable', 'false').removeClass('bg-warning');
            row.find('.editBtn').show();
            row.find('.updateBtn, .cancelBtn').hide();
        });

        $(document).on('click', '.updateBtn', function () {
            const row = $(this).closest('tr');
            const id = row.data('id');

            const updatedData = {
                empID: id,
                name: row.find('td:eq(1)').text().trim(),
                mobileNo: row.find('td:eq(2)').text().trim(),
                email: row.find('td:eq(3)').text().trim(),
                address: row.find('td:eq(4)').text().trim(),
                department: row.find('.fromDropdown').val(),
                designation: row.find('.toDropdown').val(),
                date: row.find('td:eq(7)').text().trim()
            };

            $.ajax({
                url: '/EmployeeDetailsList/UpdateEmployeeDetailsList',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(updatedData),
                success: function (res) {
                    if (res.success) {
                        // alert("Update successful!");
                        toastr.success("Update successful!");
                        row.find('.editable').attr('contenteditable', 'false').removeClass('bg-warning');
                        row.find('.fromDropdown, .toDropdown').prop('disabled', true);
                        row.find('.editBtn').show();
                        row.find('.updateBtn, .cancelBtn').hide();
                    } else {
                        // alert("Update failed: " + res.message);
                        toastr.error("Update failed: " + res.message);
                    }
                }
            });
        });
    });
</script>
