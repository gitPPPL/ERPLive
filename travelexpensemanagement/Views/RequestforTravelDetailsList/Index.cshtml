                FromOneWay: parseInt(row.find('select[name="FromReturn"]').val()) || null,
                ToOneWay: parseInt(row.find('select[name="ToReturn"]').val()) || null,
                TravelDate: row.find('input[name="TravelDateReturn"]').val() || null,
