		function redirectToDashboard() {
			window.location.href = '@Url.Action("Index", "Dashboard")';
		}
	</script>
    <style>
        .table th, .table td {
            vertical-align: middle;
            font-size: 12px;
        }
        .table thead th i {
            margin-right: 6px;
        }
        .table-hover tbody tr:hover {
            background-color: #f9f9f9;
        }
