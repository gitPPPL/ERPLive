@* Send for approval Start Block *@
<!-- Modal -->
<div class="modal fade" id="approvalModal" tabindex="-1" aria-labelledby="approvalModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="approvalModalLabel">Send for Approval</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">x</button>
            </div>
            <div >
                <table class="table table-bordered table-sm">
                        <tr>
                            <th>User</th>
                            <th>Remark</th>
                        </tr>
                        <tr>
                            <td>
                            <select id="ddlUser" name="User" style="font-size:12px;" class="form-control">
                                    <option value="">-- Select User --</option>
                                </select>
                            </td>
                            <td>
                            <select id="ddlDocument" name="Document" style="font-size:12px;" class="form-control">
                                    <option value="">-- Select Document --</option>
                                </select>
                            </td>
                            <td>
                            <input type="text" class="form-control" style="font-size:12px; height: 29px;" placeholder="Enter remark...">
                            </td>
                        </tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" style="font-size: 12px; height: 30px;line-height: 1px;" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" style="font-size: 12px; height: 30px;line-height: 1px;" class="btn btn-success" id="confirmSend">Yes, Send</button>
                <input type="hidden" id="popupRequestID" />
                <input type="hidden" id="UserIDsendtomail" />
            </div>
        </div>
    </div>
</div>

<script>
        $(document).on("click", ".sendApprovalBtn", function () {
        var requestId = $(this).data("requestid");
        var $row = $(this).closest("tr"); // ✅ Define the row
        var employeeName = $row.find('td').eq(2).text().trim(); // Or use a class like .employeeNameCell if added

        $("#popupRequestID").val(requestId);
        $("#UserIDsendtomail").val(employeeName);

        GetUserdll();
    });

    function GetUserdll() {
        $.ajax({
            url: '/RequestforTravelDetailsList/GetUserddl',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                console.log(data); // Inspect the data
                var ddl = $('#ddlUser');
                ddl.empty();
                ddl.append('<option value="">-- Select Users --</option>');

                $.each(data, function (index, item) {
                    ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                });
            },
            error: function (xhr, status, error) {
                console.error("Error: ", xhr.responseText);
                alert('Error loading Users: ' + error);
            }
        });
    }
       $('#ddlUser').on('change', function () {
        GetddlDocument()    
    });
    function GetddlDocument() {
        $.ajax({
            url: '/RequestforTravelDetailsList/GetDocumentddl',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var ddl = $('#ddlDocument');
                ddl.empty();
                ddl.append('<option value="">-- Select Document --</option>');

                $.each(data, function (index, item) {
                    ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                });

                // ✅ Automatically select the first document (after "-- Select Document --")
                if (data.length > 0) {
                    $('#ddlDocument').val(data[0].value);
                }
            },
            error: function (xhr, status, error) {
                alert('Error loading Document: ' + error);
            }
        });
    }
    $('#confirmSend').click(function () {
        var approvalData = [];
        var RequestId = $('#popupRequestID').val(); // get requestId from hidden field
        var SendUserName = $('#UserIDsendtomail').val(); // get requestId from hidden field
        var user = $('#ddlUser').val();
        var document = $('#ddlDocument').val();
        var remark = $('#ddlDocument').closest('tr').find('input[type="text"]').val(); // Get remark input
        // Push data to array
        approvalData.push({
            RequestId: RequestId,
            User: user,
            Document: document,
            Remark: remark,
            SendUserName: SendUserName
        });
        if (!user || !document) {
            alert("Please select both user and document.");
            return;
        }
        // Send to server
        $.ajax({
            type: "POST",
            url: '/RequestforTravelDetailsList/SendApproval',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify(approvalData),
            success: function (response) {
                alert("Approval sent successfully!");
                $('#approvalModal').modal('hide');
                 location.reload();
            },
            error: function (xhr) {
                alert("Error while sending approval!");
            }
        });
    });
</script>

@* Send for approval Start Block *@

<script>
    $(document).ready(function () {
     // Toggle Journey Details card on click
        $('#ShowJourneyDetails').click(function (e) {
         e.preventDefault(); 
         $('#JourneyDetailsCard').slideToggle(); 
         const checkedBox = $('.rowCheckbox:checked');
         if (checkedBox.length === 0) {
           alert("Please select Checkbox");
           return;
        }
               
    const SRNO = checkedBox.data('requestid');
    let currentPageJourneyDetails = 1;
    const pageSizeJourneyDetails = 10;
    let cityFromOptionsHtmlJourneyDetails = '';
     let cityToOptionsHtmlJourneyDetails = '';
     let travelTypeOptionsHtmlJourneyDetails = '';
    $(document).ready(function () {
        $.when(
            loadCityDropdownOptionsJourneyDetails(),
            loadCityDropdownOptionstoJourneyDetails(),
            loadCityDropdownOptionstravelTypeJourneyDetails()
        ).done(function () {
            loadTravelRequestsJourneyDetails(currentPageJourneyDetails);
        });

        function loadTravelRequestsJourneyDetails(page) {
            $.ajax({
                url: '/RequestforTravelDetailsList/GetPagedTravelRequestsJourneyDetails',
                type: 'GET',
                data: { page: page, pageSizeJourneyDetails: pageSizeJourneyDetails, SRNO:SRNO },
                success: function (response) {

                    console.log('sjdf', response)
                    if (response.success && response.travelRequests.length > 0) {
                        const tbody = $('#travelJourneyDetails tbody');
                        tbody.empty();
                        response.travelRequests.forEach(function (row) {
                            tbody.append(`
                                <tr data-id="${row.code}">
                                    <td style="font-size: 12px;">${row.code}</td>
                                    <td style="font-size: 12px;" contenteditable="false" class="editable">${row.srno}</td>
                                    <td style="font-size: 12px;" class="editable fromDropdownCellJourneyDetails" data-value="${row.travelFrom}"></td>
                                    <td style="font-size: 12px;" class="editable toDropdownCellJourneyDetails" data-value="${row.travelTo}"></td>
                                    <td style="font-size: 12px;" contenteditable="false" class="editable">${row.travelDate}</td>
                                    <td style="font-size: 12px;" contenteditable="false" class="editable">${row.totalCost}</td>
                                    <td style="font-size: 12px;" contenteditable="false" class="editable">${row.purpose}</td>
                                    <td style="font-size: 12px;" class="editable travelTypeDropdownCellJourneyDetails" data-value="${row.travelType}"></td>
                                    <td style="font-size: 12px;" contenteditable="false" class="editable">${row.journeytype}</td>
                                    <td>
                                        <button class="btn btn-sm btn-light editBtnJourneyDetails" title="Edit">
                                            <i class="fas fa-edit text-primary" style="font-size: 15px;"></i>
                                        </button>
                                        <button class="btn btn-sm btn-light updateBtnJourneyDetails" title="Update" style="display:none;">
                                            <i class="fas fa-check text-success" style="font-size: 15px;"></i>
                                        </button>
                                        <button class="btn btn-sm btn-light cancelBtnJourneyDetails" title="Cancel" style="display:none;">
                                            <i class="fas fa-times text-danger" style="font-size: 15px;"></i>
                                        </button>
                                    </td>
                                </tr>
                            `);
                        });

                        populateDropdownsJourneyDetails();
                        renderPaginationJourneyDetails(response.totalCount, page);
                    } else {
                        $('#travelJourneyDetails tbody').html('<tr><td colspan="10">No data available.</td></tr>');
                        $('#pagination').empty();
                    }
                }
            });
        }
        function loadCityDropdownOptionsJourneyDetails() {
            return $.ajax({
                url: '/RequestforTravelDetailsList/GetFromCityMasterddl1',
                type: 'GET',
                success: function (data) {
                    cityFromOptionsHtmlJourneyDetails = '<option value="">-- Select From --</option>';
                    data.forEach(item => {
                        cityFromOptionsHtmlJourneyDetails += `<option value="${item.value}">${item.text}</option>`;
                    });
                }
            });
        }
        function loadCityDropdownOptionstoJourneyDetails() {
            return $.ajax({
                url: '/RequestforTravelDetailsList/GetFromCityMasterddlto',
                type: 'GET',
                success: function (data) {
                    cityToOptionsHtmlJourneyDetails = '<option value="">-- Select To --</option>';
                    data.forEach(item => {
                        cityToOptionsHtmlJourneyDetails += `<option value="${item.value}">${item.text}</option>`;
                    });
                }
            });
        }

        function loadCityDropdownOptionstravelTypeJourneyDetails() {
            return $.ajax({
                url: '/RequestforTravelDetailsList/GetTransportationModeMasterList',
                type: 'GET',
                success: function (data) {
                    travelTypeOptionsHtmlJourneyDetails = '<option value="">-- Select Mode --</option>';
                    data.forEach(item => {
                        travelTypeOptionsHtmlJourneyDetails += `<option value="${item.value}">${item.text}</option>`;
                    });
                }
            });
        }

        function populateDropdownsJourneyDetails() {
            $('#travelJourneyDetails .fromDropdownCellJourneyDetails').each(function () {
                const selectedValue = $(this).data('value');
                const select = $('<select class="form-control fromDropdown" disabled></select>').html(cityFromOptionsHtmlJourneyDetails);
                select.val(selectedValue);
                $(this).html(select);
            });

            $('#travelJourneyDetails .toDropdownCellJourneyDetails').each(function () {
                const selectedValue = $(this).data('value');
                const select = $('<select class="form-control toDropdown" disabled></select>').html(cityToOptionsHtmlJourneyDetails);
                select.val(selectedValue);
                $(this).html(select);
            });

            $('#travelJourneyDetails .travelTypeDropdownCellJourneyDetails').each(function () {
                const selectedValue = $(this).data('value');
                const select = $('<select class="form-control travelTypeDropdown" disabled></select>').html(travelTypeOptionsHtmlJourneyDetails);
                select.val(selectedValue);
                $(this).html(select);
            });
        }

        function renderPaginationJourneyDetails(totalCount, currentPageJourneyDetails) {
            const totalPages = Math.ceil(totalCount / pageSizeJourneyDetails);
            let html = '';
            for (let i = 1; i <= totalPages; i++) {
                html += `<button class="btn btn-sm ${i === currentPageJourneyDetails ? 'btn-dark' : 'btn-light'}" data-page="${i}">${i}</button> `;
            }
            $('#pagination').html(html);
        }

        $(document).on('click', '#pagination button', function () {
            currentPageJourneyDetails = parseInt($(this).data("page"));
            loadTravelRequestsJourneyDetails(currentPageJourneyDetails);
        });

        $(document).on('click', '.editBtnJourneyDetails', function () {
            const row = $(this).closest('tr');
            row.data('original', {
                TravelFrom: row.find('.fromDropdown').val(),
                TravelTo: row.find('.toDropdown').val(),
                TravelDate: row.find('td:eq(4)').text().trim(),
                TotalCost: row.find('td:eq(5)').text().trim(),
                Purpose: row.find('td:eq(6)').text().trim(),
                TravelType: row.find('.travelTypeDropdown').val(),
                Journeytype: row.find('td:eq(8)').text().trim()
            });

            row.find('.editable').attr('contenteditable', 'true').addClass('bg-warning');
            row.find('select').prop('disabled', false);
            row.find('.editBtnJourneyDetails').hide();
            row.find('.updateBtnJourneyDetails').show();
            row.find('.cancelBtnJourneyDetails').show();
        });

        $(document).on('click', '.cancelBtnJourneyDetails', function () {
            const row = $(this).closest('tr');
            const original = row.data('original');

            row.find('.fromDropdown').val(original.TravelFrom).prop('disabled', true);
            row.find('.toDropdown').val(original.TravelTo).prop('disabled', true);
            row.find('td:eq(4)').text(original.TravelDate);
            row.find('td:eq(5)').text(original.TotalCost);
            row.find('td:eq(6)').text(original.Purpose);
            row.find('.travelTypeDropdown').val(original.TravelType).prop('disabled', true);
            row.find('td:eq(8)').text(original.Journeytype);

            row.find('.editable').attr('contenteditable', 'false').removeClass('bg-warning');
            row.find('.editBtnJourneyDetails').show();
            row.find('.updateBtnJourneyDetails, .cancelBtnJourneyDetails').hide();
        });
        $(document).on('click', '.updateBtnJourneyDetails', function () {
            const row = $(this).closest('tr');
            const id = row.data('id');
            
            const updatedData1 = {
                JourneyID: id,
                TravelFrom: row.find('.fromDropdown').val(),
                TravelTo: row.find('.toDropdown').val(),
                TravelDate: row.find('td:eq(4)').text().trim(),
                TotalCost: row.find('td:eq(5)').text().trim(),
                Purpose: row.find('td:eq(6)').text().trim(),
                TravelType: row.find('.travelTypeDropdown').val(),
                Journeytype: row.find('td:eq(8)').text().trim()
            };
            $.ajax({
                url: '/RequestforTravelDetailsList/UpdateTravelRequestJourneyDetails',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(updatedData1),
                success: function (res) {
                    if (res.success) {
                        alert("Update successful!");
                        row.find('.editable').attr('contenteditable', 'false').removeClass('bg-warning');
                        row.find('select').prop('disabled', true);
                        row.find('.editBtnJourneyDetails').show();
                        row.find('.updateBtnJourneyDetails, .cancelBtnJourneyDetails').hide();
                    } else {
                        alert("Update failed: " + res.message);
                    }
                }
            });
        });
    });
        });
    });
</script>


<!-- Pagination -->
<script>
    let currentPage = 1;
    const pageSize = 10;
    let cityFromOptionsHtml = '';
    let cityToOptionsHtml = '';
    let travelTypeOptionsHtml = '';
    $(document).ready(function () {
        $.when(
            loadCityDropdownOptions(),
            loadCityDropdownOptionsto(),
            loadCityDropdownOptionstravelType()
        ).done(function () {
            loadTravelRequests(currentPage);
        });
        function loadTravelRequests(page) {
            $.ajax({
                url: '/RequestforTravelDetailsList/GetPagedTravelRequests',
                type: 'GET',
                data: { page: page, pageSize: pageSize },
                success: function (response) {
                    console.log("kks",response)

                    if (response.success && response.travelRequests.length > 0) {
                        const tbody = $('#travelRequestTable tbody');
                        tbody.empty();
                        response.travelRequests.forEach(function (row) {
                            const isPending = row.status === "1";
                            const buttonLabel = isPending ? "Pending" : "Send";
                            const isDisabled = isPending ? "disabled" : "";
                            const isEditDisabled = isPending ? "disabled" : "";
                            tbody.append(`
                                <tr data-id="${row.srno}">
                                    <td style="font-size: 12px;">${row.srno}</td>
                                    <td style="font-size: 12px;"><input type="checkbox" class="rowCheckbox" data-requestid="${row.srno}" /></td>
                                    <td style="font-size: 12px;" contenteditable="false" class="editable">${row.employeeName}</td>
                                    <td style="font-size: 12px;" class="editable fromDropdownCell" data-value="${row.travelFrom}"></td>
                                    <td style="font-size: 12px;" class="editable toDropdownCell" data-value="${row.travelTo}"></td>
                                    <td style="font-size: 12px;" contenteditable="false" class="editable">${row.travelDate}</td>
                                    <td style="font-size: 12px;" contenteditable="false" class="editable">${row.totalCost}</td>
                                    <td style="font-size: 12px;" contenteditable="false" class="editable">${row.purpose}</td>
                                    <td style="font-size: 12px;" class="editable travelTypeDropdownCell" data-value="${row.travelType}"></td>
                                    <td style="font-size: 12px;" contenteditable="false" class="editable">${row.journeytype}</td>
                                    <td>
                                        <button class="btn btn-sm btn-light editBtn" title="Edit" ${isEditDisabled}>
                                        <i class="fas fa-edit text-primary" style="font-size: 15px;"></i>
                                        </button>
                                        <button class="btn btn-sm btn-light updateBtn" title="Update" style="display:none;">
                                            <i class="fas fa-check text-success" style="font-size: 15px;"></i>
                                        </button>
                                        <button class="btn btn-sm btn-light cancelBtn" title="Cancel" style="display:none;">
                                            <i class="fas fa-times text-danger" style="font-size: 15px;"></i>
                                        </button>
                                    </td>
                                    <td style="font-size: 12px;" contenteditable="false" class="editable">
                                        <button class="btn btn-primary sendApprovalBtn" style="font-size: 12px; padding: 5px;"
                                            data-bs-toggle="modal" data-bs-target="#approvalModal"
                                            data-requestid="${row.requestID}" ${isDisabled}>
                                            ${buttonLabel}
                                        </button>
                                    </td>
                                </tr>
                            `);
                        });
                        populateDropdowns();
                        renderPagination(response.totalCount, page);
                    } else {
                        $('#travelRequestTable tbody').html('<tr><td colspan="10">No data available.</td></tr>');
                        $('#pagination').empty();
                    }
                }
            });
        }
        function loadCityDropdownOptions() {
            return $.ajax({
                url: '/RequestforTravelDetailsList/GetFromCityMasterddl1',
                type: 'GET',
                success: function (data) {
                    cityFromOptionsHtml = '<option value="">-- Select From --</option>';
                    data.forEach(function (item) {
                        cityFromOptionsHtml += `<option value="${item.value}">${item.text}</option>`;
                    });
                }
            });
        }
        function loadCityDropdownOptionsto() {
            return $.ajax({
                url: '/RequestforTravelDetailsList/GetFromCityMasterddlto',
                type: 'GET',
                success: function (data) {
                    cityToOptionsHtml = '<option value="" style="font-size: 12px;">-- Select To --</option>';
                    data.forEach(function (item) {
                        cityToOptionsHtml += `<option value="${item.value}" style="font-size: 12px;">${item.text}</option>`;
                    });
                }
            });
        }
        function loadCityDropdownOptionstravelType() {
            return $.ajax({
                url: '/RequestforTravelDetailsList/GetTransportationModeMasterList',
                type: 'GET',
                success: function (data) {
                    travelTypeOptionsHtml = '<option value="" style="font-size: 12px;">-- Select Mode --</option>';
                    data.forEach(function (item) {
                        travelTypeOptionsHtml += `<option value="${item.value}" style="font-size: 12px;">${item.text}</option>`;
                    });
                }
            });
        }
        function populateDropdowns() {
            $('#travelRequestTable .fromDropdownCell').each(function () {
                const selectedValue = $(this).data('value');
                const select = $('<select class="form-control fromDropdown" disabled></select>').html(cityFromOptionsHtml);
                select.val(selectedValue);
                $(this).html(select);
            });
            $('#travelRequestTable .toDropdownCell').each(function () {
                const selectedValue = $(this).data('value');
                const select = $('<select class="form-control toDropdown" disabled></select>').html(cityToOptionsHtml);
                select.val(selectedValue);
                $(this).html(select);
            });

            $('#travelRequestTable .travelTypeDropdownCell').each(function () {
                const selectedValue = $(this).data('value');
                const select = $('<select class="form-control travelTypeDropdown" disabled></select>').html(travelTypeOptionsHtml);
                select.val(selectedValue);
                $(this).html(select);
            });
        }
        function renderPagination(totalCount, currentPage) {
            const totalPages = Math.ceil(totalCount / pageSize);
            let html = '';
            for (let i = 1; i <= totalPages; i++) {
                html += `<button class="btn btn-sm ${i === currentPage ? 'btn-dark' : 'btn-light'}" data-page="${i}">${i}</button> `;
            }
            $('#pagination').html(html);
        }

        $(document).on('click', '#pagination button', function () {
            currentPage = parseInt($(this).data("page"));
            loadTravelRequests(currentPage);
        });

        $(document).on('click', '.editBtn', function () {
            const row = $(this).closest('tr');
            row.data('original', {
                EmployeeName: row.find('td:eq(1)').text().trim(),
                TravelFrom: row.find('.fromDropdown').val(),
                TravelTo: row.find('.toDropdown').val(),
                TravelDate: row.find('td:eq(4)').text().trim(),
                TotalCost: row.find('td:eq(5)').text().trim(),
                Purpose: row.find('td:eq(6)').text().trim(),
                TravelType: row.find('.travelTypeDropdown').val(),
                Journeytype: row.find('td:eq(8)').text().trim()
            });

            row.find('.editable').attr('contenteditable', 'true').addClass('bg-warning');
            row.find('select').prop('disabled', false);
            row.find('.editBtn').hide();
            row.find('.updateBtn').show();
            row.find('.cancelBtn').show();
        });

        $(document).on('click', '.cancelBtn', function () {
            const row = $(this).closest('tr');
            const original = row.data('original');

            row.find('td:eq(1)').text(original.EmployeeName);
            row.find('.fromDropdown').val(original.TravelFrom).prop('disabled', true);
            row.find('.toDropdown').val(original.TravelTo).prop('disabled', true);
            row.find('td:eq(4)').text(original.TravelDate);
            row.find('td:eq(5)').text(original.TotalCost);
            row.find('td:eq(6)').text(original.Purpose);
            row.find('.travelTypeDropdown').val(original.TravelType).prop('disabled', true);
            row.find('td:eq(8)').text(original.Journeytype);

            row.find('.editable').attr('contenteditable', 'false').removeClass('bg-warning');
            row.find('.editBtn').show();
            row.find('.updateBtn, .cancelBtn').hide();
        });
       $(document).on('click', '.updateBtn', function () {
        const row = $(this).closest('tr');
        const id = row.data('id');
        alert(id)
        const updatedData = {
            SRNO: id,
            EmployeeName: row.find('td:eq(2)').text().trim(), // Or assign a class like `.employeeName` to avoid index issues
            TravelFrom: row.find('.fromDropdown').val(),
            TravelTo: row.find('.toDropdown').val(),
            TravelDate: row.find('td:eq(5)').text().trim(),
            TotalCost: row.find('td:eq(6)').text().trim(),
            Purpose: row.find('td:eq(7)').text().trim(),
            TravelType: row.find('.travelTypeDropdown').val(),
            Journeytype: row.find('td:eq(9)').text().trim()
        };
        console.log(updatedData); // Debug
        $.ajax({
            url: '/RequestforTravelDetailsList/UpdateTravelRequest',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(updatedData),
            success: function (res) {
                if (res.success) {
                    alert("Update successful!");
                    row.find('.editable').attr('contenteditable', 'false').removeClass('bg-warning');
                    row.find('select').prop('disabled', true);
                    row.find('.editBtn').show();
                    row.find('.updateBtn, .cancelBtn').hide();
                } else {
                    alert("Update failed: " + res.message);
                }
            }
        });
    });

    });
</script>
