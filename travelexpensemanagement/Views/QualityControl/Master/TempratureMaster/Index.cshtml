@{
    ViewBag.Title = "Temprature Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<fieldset>
    <legend class="legend-field">Temprature Master</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="window.location.href='@Url.Action("Index", "TempratureMasterList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>

    <form id="TempratureMasterForm">
        <input type="hidden" class="form-control" id="CODE" name="CODE">


        <div class="col-md-3">
            <div class="form-group">
                <label for="CategoryType">V Type</label>
                <select id="CategoryType" name="CategoryType" class="form-control">
                    <option value="">-- Select Type --</option>
                    <option value="ROOM">ROOM</option>
                    <option value="SPED">SPED</option>
                    <option value="TEMP">TEMP</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtName">Name</label>
                    <input type="text" class="form-control" id="TxtName" name="Name" placeholder="Enter Name">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtShortName">Short Name</label>
                    <input type="text" class="form-control" id="TxtShortName" name="ShortName" placeholder="Enter Short Name">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumSortSrNo">Sort Sr No</label>
                    <input type="number" class="form-control" id="NumSortSrNo" name="ShortName" placeholder="Enter Sort Sr No">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="offset-md-7 col-md-2">
                <div class="active-toggle btn-align">
                    <label class="toggle-switch">
                        <input type="checkbox" id="ACTIVE" name="ACTIVE" checked>
                        <span class="slider"></span>
                    </label>
                    <span class="label-status" id="statusText">Active</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="btn-last">
                    <button id="btnSaves" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Submit</button>
                    <button type="button" id="cancelBtn" class="btn btn-danger"><i class="fa fa-close"></i>Cancel</button>
                </div>
            </div>
        </div>
    </form>
</fieldset>


<script>
    $(document).ready(function () {
        const urlParams = new URLSearchParams(location.search);
        const rowId = parseInt(urlParams.get('id'));
        const isReadOnly = urlParams.get('readOnly') === 'true';

        // Handle Active/Inactive toggle
        $('#ACTIVE').on('change', function () {
            let isChecked = $(this).is(':checked');
            let status = isChecked ? 'Active' : 'Inactive';
            $('#statusText')
                .text(status)
                .removeClass('active inactive')
                .addClass(isChecked ? 'active' : 'inactive');

  
        });

        // Load category by ID if editing
        if (!isNaN(rowId) && rowId > 0) {
            loadCoategaryById(rowId);
            if (isReadOnly) {
                setFormReadOnly();
            }
        }

        // Save button click
        $("#btnSaves").click(function (e) {
            e.preventDefault();
            alert('hiii');
            var Name = $("#TxtName").val().trim();
            var ShortName = $("#TxtShortName").val().trim();
            var sortNo = $("#NumSortSrNo").val().trim();
            var CODE = $("#CODE").val().trim();
            var isActive = $('#ACTIVE').is(':checked') ? 1 : 0;
            var action = (isNaN(CODE) || CODE <= 0) ? 'INSERT' : 'UPDATE';
             var Vtype = $("#CategoryType").val().trim();
               // Validation


                if (!Vtype) {
                        toastr.warning("Please select a Category Type");
                        $("#CategoryType").focus();
                        return;
                }


            if (!Name) {
                toastr.warning("Please enter a Name.");
                $("#TxtName").focus();
                return;
            }

            if (!ShortName) {
                toastr.warning("Please enter a Short Name.");
                $("#TxtShortName").focus();
                return;
            }

              if (!NumSortSrNo) {
                toastr.warning("Please enter a Sort No");
                $("#NumSortSrNo").focus();
                return;
            }


             var formData = {
                NAME: Name || '',
                SHORTNAME: ShortName || '',
                sortNo: (sortNo && !isNaN(sortNo)) ? sortNo : null,
                CODE: (CODE && !isNaN(CODE)) ? CODE : null,
                ACTIVE: isActive,
                ACTION: action || '' ,
                Vtype : Vtype || ''

            };

            console.log("Submitting: ", formData);
            $("#btnSaves").prop("disabled", true);

            $.ajax({
                url: '/TempratureMaster/SaveTempMaster',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (response) {
                    toastr.success(response.message || "Saved successfully!");
                    $("#CategoryMasterform")[0].reset();
                    $('#statusText').text('Inactive').removeClass('active').addClass('inactive');
                },
                error: function (xhr, status, error) {
                    console.error("Error: ", xhr.responseText);
                    toastr.error("Something went wrong.");
                },
                complete: function () {
                    $("#btnSaves").prop("disabled", false);
                }
            });
        });
    });
        // Load category by ID
    function loadCoategaryById(code) {
        $.ajax({
            url: '/TempratureMasterList/GetCategoryCode',
            type: 'GET',
            data: { code },
            success: function (res) {
                if (!res.success || !res.data) {
                    toastr.warning("No Category found for the given ID.");
                    return;
                }

                const data = res.data;
                console.log('Selected data', data);

                $("#TxtName").val($.trim(data.name));
                $("#TxtShortName").val($.trim(data.shortName));
                $("#NumSortSrNo").val($.trim(data.sortNo));
                                
                $("#CODE").val($.trim(data.code));


                if (data.vType) {
                $("#CategoryType").val(data.vType);  
                } else {
                $("#CategoryType").val(''); 
                }



                const isActive = data.active === 1 || data.active === true;
                $('#ACTIVE').prop('checked', isActive);
                $('#statusText')
                    .text(isActive ? 'Active' : 'Inactive')
                    .removeClass('active inactive')
                    .addClass(isActive ? 'active' : 'inactive');
            },
            error: function (xhr) {
                toastr.error("Error loading data: " + xhr.responseText);
            }
        });
    }

    // Set form to read-only
    function setFormReadOnly() {
        const form = $('#CategoryMasterform'); // corrected ID
        form.find('input, select, textarea, button').prop('disabled', true);
    }

</script>
