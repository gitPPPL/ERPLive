@{
	ViewBag.Title = "UOM Master List";
	Layout = "~/Views/Shared/_Layout.cshtml";

    var currentMenu = ViewBag.CurrentMenu as string;
    bool canAdd = false;
    bool canEdit = false;
    bool canDelete = false;
    bool canPrint = false;
    bool canExport = false;
    bool canMail = false;
    bool canApproval = false;
    bool canDocDetail = false;

    foreach (var permission in Model.UserMenuPermissions)
    {
        if (permission.DISPLAY_NAME == ViewBag.CurrentMenu)
        {
            canAdd = Model.UserLevel == 1 || permission._ADD == 1;
            canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
            canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
            canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
            canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
            canMail = Model.UserLevel == 1 || permission._MAIL == 1;
            canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
            canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
            break;
        }
    }

    var globalVariables = ViewBag.GlobalVariables as Models.UserSessionData;
}
<div id="erp-toast-container"></div>

<fieldset>
	<legend class="legend-field">UOM Master List</legend>
	<div class="row">
		<div class="col-lg-4">
			<div class="input-group">
				<input type="text" id="searchBox" class="form-control" placeholder="Search Module..." aria-label="Search term">
			</div>
		</div>
		<div class="col-lg-8 btn-align">
            @if (canAdd)
            {
                <button id="btnSave" onclick="window.location.href='@Url.Action("Index", "UOMMaster")'" type="submit" class="btn btn-primary">
                    <i class="fa fa-plus"></i>Add UOM
                </button>
            }
            @if (canPrint)
            {
                <button class="btn btn-print" onclick="QCUOMMasterReport()"><i class="fa fa-print"></i> Print </button>
            }
            @if (canExport)
            {
                <button class="btn btn-export" id="btn-Export-Excel"><i class="fas fa-file-export"></i> Export</button>
            }
            @if (canMail)
            {
                <button class="btn btn-mail"><i class="fa fa-envelope"></i> Mail</button>
            }
            @if (canApproval)
            {
                <button class="btn btn-send"><i class="fa fa-paper-plane"></i> Approval Send</button>
                <button class="btn btn-approved"><i class="fa fa-check"></i> Approved</button>
            }
		</div>
	</div>
	<div class="card">
		<div class="table-responsive">
			<table id="tblUOMMaster" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>QC Unit Name</th>
						<th>Short Name</th>
						<th>Status</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
	</div>
	@* <div class="pagination-wrapper">
		<ul class="pagination" id="tablePagination"></ul>
	</div> *@
    <div class="erppagelist-pagination">
        <div class="pagination-left">
            <select id="pageSizeSelect" onchange="changeRowsPerPage()">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="pagination-center">
            <button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
            <div id="pageNumbers" class="page-numbers"></div>

            <button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
        </div>
        <div class="pagination-right" id="pageInfoText">
            Results: 0 - 0 of 0
        </div>
    </div>
</fieldset>
<script src="~/common/delete.js"></script>
<script src="~/common/pagination.js"></script>


<script>
    var permissions = {
        canEdit: @canEdit.ToString().ToLower(),
        canDelete: @canDelete.ToString().ToLower()
    };
    window.globalVariables = {
        compCode: "@globalVariables?.PubCompCode",
        yearCode: "@globalVariables?.PubFYearCode",
        branchCode: "@globalVariables?.PubBranchCode",
        companyName: "@globalVariables?.CompanyName",
        add1: "@globalVariables?.Address1",
        add2: "@globalVariables?.Address2",
    };
    window.database = {
        db: "@ViewBag.DatabaseName"
    }

    //=============Page Load=========
    let QCPUOMMasterPagination;
    $(document).ready(function () {
        QCPUOMMasterPagination = Pagination.create({
            pageSize: 10,
            paginationContainer: '#pageNumbers',
            infoContainer: '#pageInfoText',
            loader: function (params) {
                $.ajax({
                    url: '/UOMMasterList/GetAllUOMs',
                    type: 'GET',
                    dataType: 'json',
                    data: {
                        searchTerm: $('#searchBox').val(),
                        pageNumber: params.pageNumber,
                        pageSize: params.pageSize
                    },
                    success: function (res) {
                        params.callback({
                            data: res.lists,
                            totalCount: res.totalCount
                        });
                    },
                    error: function (xhr) {
                        // toastr.error('Error loading data');
                        showToast('Error loading data', { type: "error" });
                    }
                });
            },
            render: function (docs) {
                const tbody = $('#tblUOMMaster tbody');
                tbody.empty();
                if (!docs.length) {
                    tbody.append(`<tr><td colspan="5" class="text-center text-muted">No records found.</td></tr>`);
                    return;
                }

                $.each(docs, function (index, item) {
                    let actions = '';
                    if (permissions.canEdit) {
                        actions += `<button class="act-btn edit" title="Edit" style="cursor:pointer;" onclick="editUOM(${item.code})"><i class="fa fa-edit"></i></button>`;
                    }
                    actions += `<button class="act-btn view" title="View" style="cursor:pointer;" onclick="viewUOM(${item.code})"><i class="fa fa-eye"></i></button>`;
                    if (permissions.canDelete) {
                        actions += `<button class="act-btn delete" title="Delete" style="cursor:pointer;" onclick="deleteUOM(${item.code})"><i class="fa fa-trash"></i></button>`;
                    }
                    tbody.append(`
                         <tr>
                            <td style="display:none;">${item.code}</td>
                            <td>${item.name || ''}</td>
                            <td>${item.shortname || ''}</td>
                            <td>${item.active === 1 ? 'Active' : 'Inactive'}</td>
                            <td class="action-col">${actions}</td>
                        </tr>
                    `);
                });

            }
        });
        // First Load
        QCPUOMMasterPagination.load();
        // Search
        $('#searchBox').keyup(function () {
            QCPUOMMasterPagination.load();
        });
    });

    // Page Size Change
    function changeRowsPerPage() {
        QCPUOMMasterPagination.setPageSize(parseInt($('#pageSizeSelect').val()));
        QCPUOMMasterPagination.load();
    }
    
    //==============Edit==============
    function editUOM(code) {
        window.location.href = '/UOMMaster/Index?id=' + encodeURIComponent(code);
    }

    //==============View==============
    function viewUOM(code) {
        window.location.href = '/UOMMaster/Index?id=' + encodeURIComponent(code) + '&readOnly=true';
    }

    //=================Delete================
    function deleteUOM(docId) {
       deleteRecord("UOMMaster", docId, {
           action: "DeleteUOMByCode",
           text: "This will permanently delete the QC Unit.",
           successCallback: QCPUOMMasterPagination.load
       });
    }
    
    // ================= Download Excel =================
    document.getElementById("btn-Export-Excel").addEventListener("click", function (e) {
        e.preventDefault();
        window.location.href = "/UOMMasterList/ExportAllDocs";
    });

    // ================= Download Pdf =================
    function QCUOMMasterReport() {

        var reportName = "rptQCUOM";

        var formulaFields = {
            Reportname: reportName,
            selectionFormula: "",
            Database: window.database.db,
            Parameters: {
                comp_name: window.globalVariables.companyName,
                comp_add1: window.globalVariables.add1,
                comp_add2: window.globalVariables.add2,
                RPTNAME: "QC UOM Report"
            }
        };

        var now = new Date();
        var day = String(now.getDate()).padStart(2, '0');
        var month = String(now.getMonth() + 1).padStart(2, '0');
        var year = String(now.getFullYear()).slice(-2);
        var hours = String(now.getHours()).padStart(2, '0');
        var minutes = String(now.getMinutes()).padStart(2, '0');
        var seconds = String(now.getSeconds()).padStart(2, '0');
        var timestamp = `${day}${month}${year}_${hours}${minutes}${seconds}`;

        $.ajax({
            url: 'http://localhost:34088/Report/PendingQCReport',
            type: 'POST',
            data: JSON.stringify(formulaFields),
            contentType: "application/json",
            xhrFields: {
                responseType: 'blob'
            },
            success: function (response) {
                console.log('PDF response:', response);
                var file = new Blob([response], { type: 'application/pdf' });
                var fileName = `${reportName}_${timestamp}.pdf`;

                var link = document.createElement('a');
                link.href = URL.createObjectURL(file);
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            },
            error: function (xhr, status, error) {
                console.error('Error generating report:', error);
            }
        });
    }
</script>