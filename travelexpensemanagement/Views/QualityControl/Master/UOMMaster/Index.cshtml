@{
    ViewBag.Title = "UOM Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<fieldset>
    <legend class="legend-field">UOM Master</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="window.location.href='@Url.Action("Index", "UOMMasterList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>

    <form id="UOMMasterForm"> 
        <input type="hidden" class="form-control" id="CODE" name="CODE">

        <div class="row">
            <!-- QC Unit Name -->
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtQCUnitName">QC Unit Name</label>
                    <input type="text" class="form-control" id="TxtQCUnitName" name="QCUnitName" placeholder="Enter QC Unit Name">
                </div>
            </div>

            <!-- Short Name -->
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtShortName">Short Name</label>
                    <input type="text" class="form-control" id="TxtShortName" name="ShortName" placeholder="Enter Short Name">
                </div>
            </div>
       </div>
        <div class="row">
            <div class="offset-md-7 col-md-2">
                <div class="active-toggle btn-align">
                    <label class="toggle-switch">
                        <input type="checkbox" id="ACTIVE" name="ACTIVE" checked>
                        <span class="slider"></span>
                    </label>
                    <span class="label-status" id="statusText">Active</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="btn-last">
                    <button id="btnSave" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Submit</button>
                    <button type="button" id="cancelBtn" class="btn btn-danger"><i class="fa fa-close"></i>Cancel</button>
                </div>
            </div>
        </div>
    </form>
</fieldset>
<script>
    $(document).ready(function () {
        const urlParams = new URLSearchParams(location.search);
        const rowId = parseInt(urlParams.get('id'));
        const isReadOnly = urlParams.get('readOnly') === 'true';

        if (!isNaN(rowId) && rowId > 0) {
            loadUOMById(rowId);

            if (isReadOnly) {
                setUOMFormReadOnly();
            }
        }

        $('#cancelBtn').on('click', function () {
            window.location.href = '/UOMMasterList/Index';
        });

        $('#ACTIVE').on('change', function () {
            let status = $(this).is(':checked') ? 'Active' : 'Inactive';
            $('#statusText').text(status);
        });
    });

    $('#UOMMasterForm').on('submit', function (e) {
        e.preventDefault();

        const code = parseInt($('#CODE').val()) || 0;
        const name = $('#TxtQCUnitName').val().trim();
        const shortName = $('#TxtShortName').val().trim();
        const isActive = $('#ACTIVE').is(':checked') ? 1 : 0;

        if (!name) {
            toastr.warning('Please enter QC Unit Name.');
            $('#TxtQCUnitName').focus();
            return;
        }

        if (!shortName) {
            toastr.warning('Please enter Short Name.');
            $('#TxtShortName').focus();
            return;
        }

        const payload = {
            CODE: code,
            NAME: name,
            SHORTNAME: shortName,
            ACTIVE: isActive,
            UDATE: new Date().toISOString(),
            EDATE: new Date().toISOString(),
            AED: code > 0 ? 'U' : 'A',
            ACTION: code > 0 ? 'UPDATE' : 'INSERT',
            WSID: 'WEB',
            UUSER: 1,
            EUSER: 1
        };

        $.ajax({
            url: '/UOMMaster/SaveUOM',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (response) {
                if (response.success) {
                    toastr.success("UOM saved successfully!");
                    $('#UOMMasterForm')[0].reset();
                    setTimeout(function () {
                        window.location.href = '/UOMMasterList/Index';
                    }, 1000);
                } else {
                    toastr.warning(response.message || "Something went wrong while saving.");
                }
            },
            error: function (xhr) {
                const errorMsg = xhr.responseJSON?.message || xhr.responseText || "An error occurred.";
                toastr.error("Error: " + errorMsg);
            }
        });
    });

    function loadUOMById(code) {
        $.ajax({
            url: '/UOMMasterList/GetUOMByCode',
            type: 'GET',
            data: { code },
            success: function (response) {
                const data = response.data;
                if (!data) {
                    toastr.warning("No data found.");
                    return;
                }

                $('#CODE').val(data.code);
                $('#TxtQCUnitName').val(data.name);
                $('#TxtShortName').val(data.shortname);
                $('#ACTIVE').prop('checked', data.active === 1 || data.active === true);
                $('#statusText').text(data.active ? 'Active' : 'Inactive');
            },
            error: function (xhr) {
                console.error("Error loading UOM by ID:", xhr);
                toastr.error('Error: ' + xhr.responseText);
            }
        });
    }

    function setUOMFormReadOnly() {
        const form = $('#UOMMasterForm');
        form.find('input, select, textarea, button').prop('disabled', true);
        $('#ACTIVE').prop('disabled', true);
        $('#statusText').addClass('text-muted');
    }

</script>

