@{
    ViewBag.Title = "QC Master List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<fieldset>
    <legend class="legend-field">QC Master List</legend>
    <div class="row">
        <div class="col-lg-4">
            <div class="input-group">
                <input type="text" id="searchBox" class="form-control" placeholder="Search Module..." aria-label="Search term">
            </div>
        </div>
        <div class="col-lg-8 btn-align">
            <button id="btnSave" onclick="window.location.href='@Url.Action("Index", "QCMaster")'" type="submit" class="btn btn-primary">
                <i class="fa fa-plus"></i>Add QC
            </button>
            <button class="btn btn-print">
                <i class="fa fa-print"></i> Print
            </button>
            <button class="btn btn-export">
                <i class="fas fa-file-export"></i> Export
            </button>
            <button class="btn btn-mail">
                <i class="fa fa-envelope"></i> Mail
            </button>
            <button class="btn btn-send">
                <i class="fa fa-paper-plane"></i> Approval Send
            </button>
            <button class="btn btn-approved">
                <i class="fa fa-check"></i> Approved
            </button>
        </div>
    </div>
    <div class="card">
        <div class="table-responsive">
            <table id="tblQCMaster" class="table-width">
                <thead class="table-head">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Short Name</th>
                        <th>QC Type</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>


    <div class="row p-3">
        <div class="col-md-12 d-flex justify-content-center" id="tablePagination"></div>
    </div>
</fieldset>
<script>
    let currentPage = 1;
    let pageSize = 10;

    $(document).ready(function () {
        loadAlQcMasterList();
    });

    // Load the QC Master List
    function loadAlQcMasterList() {
        const searchTerm = $('#searchBox').val();

        $.ajax({
            url: '/QCMasterList/GetQCMasterLList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                const menus = res.groups || [];
                const totalCount = res.totalCount || 0;
                console.log("check data",res)

                let tbody = $('#tblQCMaster tbody');
                tbody.empty();

                if (menus.length === 0) {
                    tbody.append('<tr><td colspan="8" class="text-center text-muted">No menus found.</td></tr>');
                } else {
                    $.each(menus, function (index, menu) {
                        tbody.append(`
                            <tr>
                                <td>${menu.code}</td>
                                <td>${menu.name}</td>
                                <td>${menu.shortName}</td>
                                <td>${menu.qcGroup}</td>
                                <td>${menu.active === 1 ? 'Yes' : 'No'}</td>
                                <td>
                                <i class="fas fa-edit text-primary" style="cursor:pointer" title="Edit" onclick="AddOrEditItemGroup(${menu.code})"></i>
                                <i class="fas fa-eye text-secondary ms-2" style="cursor:pointer" title="View" onclick="viewItemGroupDetails(${menu.code})"></i>
                                    <button class="btn btn-sm btn-light btn-delete" data-code="${menu.code}">
                                        <i class="fas fa-trash text-danger" title="Delete"></i>
                                    </button>
                                </td>
                            </tr>
                        `);
                    });
                }

                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                toastr.error('Error loading menu list: ' + xhr.responseText);
            }
        });
    }
    // Render pagination
    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const paginationContainer = $('#tablePagination');
        paginationContainer.empty();

        if (total === 0) {
            paginationContainer.html('<span class="text-muted">No records to display</span>');
            return;
        }
        if (totalPages <= 1) return;

        let html = '';

        // First and Prev
        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        if (currentPage <= 3) endPage = Math.min(5, totalPages);
        if (currentPage >= totalPages - 2) startPage = Math.max(totalPages - 4, 1);

        for (let i = startPage; i <= endPage; i++) {
            html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
        }

        // Next and Last
        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }
        paginationContainer.html(html);
    }

    function goToPage(page) {
        currentPage = page;
        loadAlQcMasterList();
    }

    // Debounced search input
    let searchTimeout;
    $('#searchBox').on('keyup', function () {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
            currentPage = 1;
            loadAlQcMasterList();
        }, 300);
    });

    // Delegated events for buttons
    $(document).on('click', '.btn-edit', function () {
        const code = $(this).data('code');
        window.location.href = '/QCMaster/Index?id=' + encodeURIComponent(code);
    });

    // $(document).on('click', '.btn-view', function () {
    // 	const code = $(this).data('code');
    // 	window.location.href = '/QCMaster/Index?id=' + encodeURIComponent(code) + '&readOnly=true';
    // });

    // $(document).on('click', '.btn-delete', function () {
    // 	const code = $(this).data('code');
    // 	if (confirm(`Are you sure you want to delete "${code}"?`)) {
    // 		deleteQcMaster(code);
    // 	}
    // });

    function AddOrEditItemGroup(id) {
      window.location.href = '/QCMaster/Index?id=' + id;
    }
    function viewItemGroupDetails(id) {
      window.location.href = '/QCMaster/Index?id=' + id + '&mode=view';
    }
    // Delete function
    function deleteQcMaster(code) {
        $.ajax({
            url: '/QCMasterList/DeleteQcMaster',
            type: 'POST',
            data: { code },
            success: function () {
                toastr.success('Deleted successfully');
                loadAlQcMasterList();
            },
            error: function (xhr) {
                toastr.error('Failed to delete: ' + xhr.responseText);
            }
        });
    }
</script>
