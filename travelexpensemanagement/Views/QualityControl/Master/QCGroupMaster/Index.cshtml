@{
    ViewBag.Title = "QC Group Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-check-square"></i>
        </div>
        <div class="erppage-header-title">QC Group Master</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "QCGroupMasterList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="QCGroupMasterform">
    <input type="hidden" class="form-control" id="CODE" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">QCG Name</label>
                    <input type="text" class="erppage-input" id="TxtQCGName" placeholder="Enter QCG Name">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">QC Type</label>
                    <select class="erppage-input erppage-select" id="ddlQCType">
                        <option value="">Select QC Type</option>
                        <option value="RMG">RMG</option>
                        <option value="STORE">STORE</option>
                        <option value="FINISH">FINISH</option>
                        <option value="WASTE">WASTE</option>
                        <option value="SCRAP">SCRAP</option>
                        <option value="FULE">FULE</option>
                        <option value="SFG">SFG</option>
                        <option value="OTHERS">OTHERS</option>
                    </select>
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label"></label>
                    <div class="erppage-toggle-container">
                        <span class="erppage-toggle-text active" id="statusText">Active</span>
                        <label class="erppage-toggle">
                            <input type="checkbox" id="ACTIVE" checked>
                            <span class="erppage-toggle-slider"></span>
                        </label>
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="erppage-actions">
            <button id="btnSave" type="submit" class="erppage-btn erppage-btn-save">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>
        </div>
    </div>
</div>

<script>
        $('#ChkActive').on('change', function () {
        if ($(this).is(':checked')) {
            $('#lblStatus')
                .text('Active')
                .removeClass('inactive')
                .addClass('active');
        } else {
            $('#lblStatus')
                .text('Inactive')
                .removeClass('active')
                .addClass('inactive');
        }
    });
    </script>



<script>
    $(document).ready(function () {
        const urlParams = new URLSearchParams(location.search);
        const rowId = parseInt(urlParams.get('id'));
        const isReadOnly = urlParams.get('readOnly') === 'true';

        if (!isNaN(rowId) && rowId > 0) {
            loadQCGroupById(rowId);

            if (isReadOnly) {
                setQCGroupFormReadOnly();
            }
        }

        $('#cancelBtn').on('click', function () {
            window.location.href = '/QCGroupMasterList/Index';
        });

        $('#ACTIVE').on('change', function () {
            let status = $(this).is(':checked') ? 'Active' : 'Inactive';
            $('#statusText').text(status);
        });
    });

    $('#QCGroupMasterform').on('submit', function (e) {
        e.preventDefault();

        const code = parseInt($('#CODE').val()) || 0;
        const name = $('#TxtQCGName').val().trim();
        const qcType = $('#ddlQCType').val();
        const isActive = $('#ACTIVE').is(':checked') ? 1 : 0;

        if (!name) {
            toastr.warning('Please enter QCG Name.');
            $('#TxtQCGName').focus();
            return;
        }

        if (!qcType) {
            toastr.warning('Please select QC Type.');
            $('#ddlQCType').focus();
            return;
        }

        const payload = {
            CODE: code,
            NAME: name,
            QC_TYPE: qcType,
            ACTIVE: isActive,
            UDATE: new Date().toISOString(),
            EDATE: new Date().toISOString(),
            AED: code > 0 ? 'U' : 'A',
            ACTION: code > 0 ? 'UPDATE' : 'INSERT',
            WSID: 'WEB',
            UUSER: 1,
            EUSER: 1
        };

        $.ajax({
            url: '/QCGroupMaster/SaveQCGroup',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (response) {
                if (response.success) {
                    toastr.success("QC Group saved successfully!");
                    $('#QCGroupMasterform')[0].reset();
                    setTimeout(function () {
                        window.location.href = '/QCGroupMasterList/Index';
                    }, 1000);
                } else {
                    toastr.warning(response.message || "Something went wrong while saving.");
                }
            },
            error: function (xhr) {
                const errorMsg = xhr.responseJSON?.message || xhr.responseText || "An error occurred.";
                toastr.error("Error: " + errorMsg);
            }
        });
    });

    function loadQCGroupById(code) {
        $.ajax({
            url: '/QCGroupMasterList/GetQCGroupByCode',
            type: 'GET',
            data: { code },
            success: function (response) {
                const data = response.data;
                if (!data) {
                    toastr.warning("No data found.");
                    return;
                }

                $('#CODE').val(data.code);
                $('#TxtQCGName').val(data.name);
                $('#ddlQCType').val(data.qC_TYPE);
                $('#ACTIVE').prop('checked', data.active === 1 || data.active === true);
                $('#statusText').text(data.active ? 'Active' : 'Inactive');
            },
            error: function (xhr) {
                console.error("Error loading QC Group by ID:", xhr);
                toastr.error('Error: ' + xhr.responseText);
            }
        });
    }

    function setQCGroupFormReadOnly() {
        const form = $('#QCGroupMasterform');
        form.find('input, select, textarea, button').prop('disabled', true);
        $('#ACTIVE').prop('disabled', true);
        $('#statusText').addClass('text-muted');
    }

</script>

