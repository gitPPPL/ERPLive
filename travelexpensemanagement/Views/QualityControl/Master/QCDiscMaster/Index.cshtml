@{
    ViewBag.Title = "QC Disc Master";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-clipboard-check"></i>
        </div>
        <div class="erppage-header-title">QC Disc Master</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "QCDiscMasterList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="QCDiscMasterForm">
    <input type="hidden" class="form-control" id="CODE" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Item Name</label>
                    <select class="erppage-input erppage-select" id="ddlItemName">
                        <option value="">Select Item Name</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Parameter</label>
                    <select class="erppage-input erppage-select" id="ddlParameter">
                        <option value="">Select Parameter Name</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Rate</label>
                    <input type="number" class="erppage-input" id="TxtRate" placeholder="Enter Rate">
                </div>
                
            </div>
        </fieldset>
        <div class="erppage-actions">
            <button id="btnSave" type="button" class="erppage-btn erppage-btn-save">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>
        </div>
    </div>
</div>



<script>
    $(document).ready(async function(){
        const urlParams = new URLSearchParams(location.search);
        const rowId = parseInt(urlParams.get('id'));
        isReadOnly = urlParams.get('readOnly') === 'true';
       
        await LoadAllDropDowns();

        if (rowId > 0) {
            loadDataOnEdit(rowId);
        }

        $('#btnSave').click(function (e) {
            e.preventDefault();
            SaveData();
        });
    });

    async function LoadAllDropDowns(){
        await Promise.all([

            bindDropdown("QCDiscMaster", "ITEM", "#ddlItemName","Select Item Name", null, null, false, null, true),

            bindDropdown("QCDiscMaster", "PARAMETER", "#ddlParameter", "Select Parameter", null, null, false, null,true),

        ]);
    }

    async function SaveData(){
        let ITEM_CODE = $('#ddlItemName').val();
        let ITEM_NAME = $('#ddlItemName option:selected').text();
        let QCP_CODE = $('#ddlParameter').val();
        let QCP_DIFF = parseFloat($('#TxtRate').val()) || 0;
    
        try {
            const response = await $.ajax({
                url: '/QCDiscMaster/SaveAndUpdateData',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ITEM_CODE: ITEM_CODE,
                    ITEM_NAME: ITEM_NAME,
                    QCP_CODE: QCP_CODE,
                    QCP_DIFF: QCP_DIFF
                })
            });
            if (response.success) {
                console.log("Response Saved",response);
                toastr.success("Data saved successfully.");
                // setTimeout(() => {
                //     window.location.href = '/QCDiscMasterList/Index';
                // }, 1000);
            } else {
                toastr.error(response.message || "Save failed.");
            }
        } catch (error) {
            toastr.error('An error occurred while saving data: ' + error);
        }
    }

    async function loadDataOnEdit(itemCode) {
        try {
            const res = await $.ajax({
                url: '/QCDiscMaster/GetQcDiscOnChange',
                type: 'GET',
                data: { itemCode: itemCode }
            });

            if (res.success && res.lists.length > 0) {

                let first = res.lists[0];
                console.log("List data", first);

                $('#ddlItemName').val(first.iteM_CODE).trigger('change.select2');
                $('#ddlParameter').val(first.qcP_CODE).trigger('change.select2');
                $('#TxtRate').val(first.qcP_DIFF);

            } else {
                toastr.info("No data found for selected item");
            }

        } catch (error) {
            toastr.error("Error loading data");
        }
    }

</script>

