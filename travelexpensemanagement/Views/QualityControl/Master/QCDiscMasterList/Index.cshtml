@{
	ViewBag.Title = "QC Disc Master List";
	Layout = "~/Views/Shared/_Layout.cshtml";

    var currentMenu = ViewBag.CurrentMenu as string;
    bool canAdd = false;
    bool canEdit = false;
    bool canDelete = false;
    bool canPrint = false;
    bool canExport = false;
    bool canMail = false;
    bool canApproval = false;
    bool canDocDetail = false;

    foreach (var permission in Model.UserMenuPermissions)
    {
        if (permission.DISPLAY_NAME == ViewBag.CurrentMenu)
        {
            canAdd = Model.UserLevel == 1 || permission._ADD == 1;
            canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
            canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
            canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
            canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
            canMail = Model.UserLevel == 1 || permission._MAIL == 1;
            canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
            canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
            break;
        }
    }
    var globalVariables = ViewBag.GlobalVariables as Models.UserSessionData;

}
<div id="erp-toast-container"></div>
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>QC Disc Master List</span>
    </div>
    <div class="erppagelist-header-right">
        @if (canAdd)
        {
            <button class="erppage-header-back" onclick="location.href='@Url.Action("Index", "QCDiscMaster")'">
                <i class="fa fa-plus"></i>Add New
            </button>
        }
    </div>
</div>
<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" id="searchBox" placeholder="Search by All Columns Name...." />
    </div>
    <div class="erppagelist-actions">
        @if (canPrint)
        {
            <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" onclick="QCGMasterReport()">
                <i class="fa fa-print"></i> Print
            </button>
        }
        @if (canExport)
        {
            <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Export to Excel" id="btn-Export-Excel">
                <i class="fa fa-file-excel"></i> Export
            </button>
        }
        @if (canMail)
        {
            <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail">
                <i class="fa fa-envelope"></i>Mail
            </button>
        }
        @if (canApproval)
        {
            <button class="erppagelist-btn erppagelist-btn-approve tooltip-btn" data-tooltip="Approve Records">
                <i class="fa fa-check-circle"></i>Approved
            </button>
        }
    </div>
</div>
<div class="erppagelist-container">
    <div class="excel-wrapper fixed-grid-wrapper">
        <table id="tblQCDiscMaster" class="excel-table fixed-grid-table resizable-table">
            <colgroup>
                <col style="width:80px;" />    
                <col style="width:300px;" />   
                <col style="width:180px;" />   
                <col style="width:120px;" />   
            </colgroup>
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>No of QC Discount</th>
                    <th class="action-col">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    <div class="erppagelist-pagination">
        <div class="pagination-left">
            <select id="pageSizeSelect" onchange="changeRowsPerPage()">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="pagination-center">
            <button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
            <div id="pageNumbers" class="page-numbers"></div>

            <button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
        </div>
        <div class="pagination-right" id="pageInfoText">
            Results: 0 - 0 of 0
        </div>
    </div>
</div>

<script>
    let currentPage = 1;
    let pageSize = 10;

    $(document).ready(function () {
        loadAllQCDiscSummary();
    });

    function loadAllQCDiscSummary() {
        const searchTerm = $('#searchBox').val();
        $.ajax({
            url: '/QCDiscMasterList/GetAllQCDisc',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {

                const lists = res.lists;
                const totalCount = res.totalCount;

                let tbody = $('#tblQCDiscMaster tbody');
                tbody.empty();

                if (!lists || lists.length === 0) {
                    tbody.append('<tr><td colspan="5" class="text-center text-muted">No records found.</td></tr>');
                    renderPagination(0, pageSize, currentPage);
                    return;
                }

                $.each(lists, function (index, item) {
                    tbody.append(`
                        <tr>
                            <td style="display:none;">${item.item_Code}</td>
                            <td>${item.item_Code || ''}</td>
                            <td>${item.item_Name || ''}</td>
                            <td>${item.item_Count || 0}</td>
                            <td>
                                <i class="fas fa-edit text-primary" style="cursor:pointer;" title="Edit" onclick="editQCDisc(${item.item_Code})"></i>
                                <i class="fas fa-eye text-primary" style="cursor:pointer;" title="View" onclick="viewQCDisc(${item.item_Code})"></i>
                                <i class="fas fa-trash text-danger ms-2" style="cursor:pointer;" title="Delete" onclick="deleteQCDisc(${item.item_Code})"></i>
                            </td>
                        </tr>
                    `);
                });

                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                toastr.success('Error loading QC Disc data: ' + xhr.responseText);
            }
        });
    }

    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const paginationContainer = $('#tablePagination');
        paginationContainer.empty();

        if (totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<li><button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button></li>`;
            html += `<li><button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button></li>`;
        }

        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        if (currentPage <= 3) endPage = Math.min(5, totalPages);
        if (currentPage >= totalPages - 2) startPage = Math.max(totalPages - 4, 1);

        for (let i = startPage; i <= endPage; i++) {
            html += `<li><button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button></li>`;
        }

        if (currentPage < totalPages) {
            html += `<li><button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button></li>`;
            html += `<li><button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button></li>`;
        }

        paginationContainer.html(html);
    }

    function goToPage(page) {
        currentPage = page;
        loadAllQCDiscSummary();
    }

    $('#searchBox').on('keyup', function () {
        currentPage = 1;
        loadAllQCDiscSummary();
    });

    function editQCDisc(code) {
        window.location.href = '/QCDiscMaster/Index?id=' + encodeURIComponent(code);
    }

    function viewQCDisc(code) {
        window.location.href = '/QCDiscMaster/Index?id=' + encodeURIComponent(code) + '&readOnly=true';;
    }

    function deleteQCDisc(code) {
        Swal.fire({
            title: 'Are you sure?',
            text: "This will permanently delete the QC Disc entry.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/QCDiscMaster/DeleteQcDiscByCode',
                    type: 'POST',
                    data: { code: code },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Deleted!', response.message, 'success').then(() => {
                                loadAllQCDiscSummary();
                            });
                        } else {
                            Swal.fire('Failed', response.message, 'warning');
                        }
                    },
                    error: function () {
                        Swal.fire('Error!', 'An error occurred while deleting the record.', 'error');
                    }
                });
            }
        });
    }

</script>