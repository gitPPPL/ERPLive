@{
    ViewBag.Title = "QC Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .btn-plus {
        padding: 5px !important;
    }

        .btn-plus i {
            margin: 0px !important;
        }
</style>
<div id="erp-toast-container"></div>
<fieldset>
    <legend class="legend-field">QC Master</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="window.location.href='@Url.Action("Index", "QCMasterList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>

    <!-- 📝 Form starts -->
    <form id="QCMasterform">
        <input type="hidden" class="form-control" id="CODE" name="CODE">

        <!-- Row 1 -->
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtName">Name</label>
                    <input type="text" class="form-control" id="TxtName" name="Name" placeholder="Enter Name">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtShortName">Short Name</label>
                    <input type="text" class="form-control" id="TxtShortName" name="Short Name" placeholder="Enter Short Name">
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlQCGroup">QC Group</label>
                    <select class="form-control" id="ddlQCGroup" name="QCGroup">
                        <option value="">--Select QC Group--</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtMaxPPM">Max PPM</label>
                    <input type="number" class="form-control" id="TxtMaxPPM" name="Max PPM" placeholder="Enter Max PPM">
                </div>
            </div>
        </div>

        <!-- Trigger Button -->
        <div class="row">
            <div class="offset-md-7 col-md-2">
                <div class="active-toggle btn-align">
                    <label class="toggle-switch">
                        <input type="checkbox" id="ACTIVE" name="ACTIVE" checked>
                        <span class="slider"></span>
                    </label>
                    <span class="label-status" id="statusText">Active</span>
                </div>
            </div>

            <div class="col-md-10">
                <div class="btn-align">
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#qcReportModal">
                        <i class="fa fa-file-alt"></i> Print Report
                    </button>
                </div>
            </div>
        </div>

        <div class="card mt-2">
            <div class="table-responsive">
                <table id="tblQCMasteradd" class="table-width">
                    <thead class="table-head">
                        <tr>
                            <th style="display:none;">Code</th>
                            <th>Parameter</th>
                            <th>Unit</th>
                            <th>Std Result</th>
                            <th>Deduct Qty</th>
                            <th>Deduct Type</th>
                            <th>Ppm Yes/No</th>
                            <th>Base Price</th>
                            <th>Remarks</th>
                            <th colspan="2">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- Final Buttons Row -->
        <div class="row">
            <div class="offset-md-7 col-md-2">

            </div>
            <div class="col-md-3">
                <div class="btn-last">
                    <button id="btnSave" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Submit</button>
                </div>
            </div>
        </div>
    </form>
    <!-- 📝 Form ends -->
</fieldset>

<!-- 🧾 Modal Moved Outside the Form -->
<div class="modal fade" id="qcReportModal" tabindex="-1" aria-labelledby="qcReportModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="popup-header">
                <h5 class="popup-title" id="qcReportModalLabel">Print Report</h5>
                <i class="fa fa-close btn-close" data-bs-dismiss="modal"></i>
            </div>
            <div class="modal-body">
                <form id="qcReportForm">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group-text">
                                <label>QC Group</label>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <select class="form-control" id="ddlQCGroupPR" name="QCGroupPR">
                                <option value="">--Select Group--</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 radio-text">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="reportType" id="report1" value="Report 1" style="gap:10px;" checked>
                                <label class="form-check-label" for="report1">Report 1</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="reportType" id="report2" value="Report 2">
                                <label class="form-check-label" for="report2">Report 2</label>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="table-responsive">
                            <table id="tblPrintReport" class="table-width">
                                <thead class="table-head">
                                    <tr>
                                        <th>Code</th>
                                        <th>QC Group</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="pagination-wrapper">
                        <ul class="pagination" id="tablePagination"></ul>
                    </div>

                    <div class="custom-footer-btn btn-last">
                        <button type="button" class="btn btn-print">
                            <i class="fa fa-print"></i> Print
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!--Parameter Popup-->
<div class="modal fade" id="qcparameterbtnadd" tabindex="-1" aria-labelledby="qcparameterbtnaddLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="popup-header">
                <h5 class="popup-title" id="qcparameterbtnaddLabel">QC Deduct Rate</h5>
                <i class="fa fa-close btn-close" data-bs-dismiss="modal"></i>
            </div>
            <div class="modal-body">
                <form id="qcDeductRateForm">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Parameter: <span id="lblParameterText" class="fw-bold text-primary"></span></label>

                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Deduct Type: <span id="lblDeductTypeText" class="fw-bold text-primary"></span></label>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="table-responsive">
                            <table id="tblParameterDR" class="table-width">
                                <thead class="table-head">
                                    <tr>
                                        <th>From</th>
                                        <th>To</th>
                                        <th>Rate</th>
                                        <th>Type</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><input type="number" class="form-control form-control-sm" placeholder="From"></td>
                                        <td><input type="number" class="form-control form-control-sm" placeholder="To"></td>
                                        <td><input type="number" class="form-control form-control-sm" placeholder="Type"></td>
                                        <td>
                                            <select class="form-control form-control-sm">
                                                <option value="Base">Base</option>
                                                <option value="Percent">Percent</option>
                                            </select>
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-success btn-sm btn-add-row">
                                                <i class="fa fa-plus"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="pagination-wrapper">
                        <ul class="pagination" id="tablePagination"></ul>
                    </div>

                    <div class="col-md-12">
                        <div class="btn-last">
                            <button id="btnSaveQCDeductRate" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Submit</button>
                            <button type="button" id="cancelBtnQCDeductRate" class="btn btn-danger"><i class="fa fa-close"></i>Cancel</button>
                        </div>
                    </div>

                    <input type="hidden" id="hdnCode" />
                    <input type="hidden" id="hdnnextQcpCode" />
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/js/erpjs/qualitycontrol/master/qcmaster/qcmaster.js"></script>
