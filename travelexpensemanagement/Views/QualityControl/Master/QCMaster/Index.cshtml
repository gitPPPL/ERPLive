@{
    ViewBag.Title = "QC Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-check-circle"></i>
        </div>
        <div class="erppage-header-title">QC Master</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "QCMasterList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="QCMasterform">
    <input type="hidden" class="form-control" id="CODE" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Name</label>
                    <input type="text" class="erppage-input" id="TxtName" placeholder="Enter Name">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Short Name</label>
                    <input type="text" class="erppage-input" id="TxtShortName" placeholder="Enter Short Name">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">QC Type</label>
                    <select class="erppage-input erppage-select" id="ddlQCGroup">
                        <option value="">Select QC Type</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Max PPM</label>
                    <input type="text" class="erppage-input" id="TxtMaxPPM" placeholder="Enter Max PPM">
                </div>
            </div>
            <div class="erppage-grid1">
                <div class="erppage-divfield erppage-col-span-3">
                    <label class="erppage-label"></label>
                    <div class="erppage-toggle-container">
                        <span class="erppage-toggle-text active" id="statusText">Active</span>
                        <label class="erppage-toggle">
                            <input type="checkbox" id="ACTIVE" name="ACTIVE" checked>
                            <span class="erppage-toggle-slider"></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="erppagelist-container">
                <div class="excel-wrapper fixed-grid-wrapper">
                    <table id="tblQCMasteradd" class="excel-table fixed-grid-table resizable-table">
                        <colgroup>
                            <col style="width:80px;" />    
                            <col style="width:220px;" />   
                            <col style="width:120px;" />   
                            <col style="width:120px;" />   
                            <col style="width:120px;" />   
                            <col style="width:140px;" />   
                            <col style="width:120px;" />   
                            <col style="width:120px;" />   
                            <col style="width:250px;" />   
                            <col style="width:120px;" />   
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Parameter</th>
                                <th>Unit</th>
                                <th>Std Result</th>
                                <th>Deduct Qty</th>
                                <th>Deduct Type</th>
                                <th>Ppm Yes/No</th>
                                <th>Base Price</th>
                                <th>Remarks</th>
                                <th class="action-col">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </fieldset>
        <div class="erppage-actions">
            <button id="btnSave" type="button" class="erppage-btn erppage-btn-save">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>
        </div>
    </div>
</div>


<style>
    .btn-plus {
        padding: 5px !important;
    }
    .btn-plus i {
        margin: 0px !important;
    }
</style>

