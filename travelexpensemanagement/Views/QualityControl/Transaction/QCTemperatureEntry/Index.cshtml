@{
    ViewBag.Title = "QC Temperature Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa-solid fa-temperature-half"></i>
        </div>
        <div class="erppage-header-title">QC Temperature Entry</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "QCTemperatureEntryList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="QCTemperatureEntryForm">
    <input type="hidden" class="form-control" id="TxtDocId" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Document No</label>
                    <input type="number" class="erppage-redinput" id="NumDocNo" placeholder="Enter Doc No" readonly>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-redinput" id="DtDocDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Shift</label>
                    <select class="erppage-input erppage-required" id="ddlShift">
                        <option value="">Select Shift</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Time</label>
                    <input type="time" class="erppage-redinput" id="TmTime">
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Denier</label>
                    <select class="erppage-input erppage-required" id="ddlDenier">
                        <option value="">Select Denier</option>
                    </select>
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Incharge</label>
                    <select id="ddlIncharge" class="erppage-input erppage-select">
                        <option value="">Select Incharge</option>
                    </select>
                </div>
                
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Operator</label>
                    <select id="ddlOperator" class="erppage-input erppage-select">
                        <option value="">Select Operator</option>
                    </select>
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Supervisor</label>
                    <select id="ddlSupervisor" class="erppage-input erppage-select">
                        <option value="">Select Supervisor</option>
                    </select>
                </div>
                </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Plant Name</label>
                    <select class="erppage-input erppage-required" id="ddlPlantName">
                        <option value="">Select Plant Name</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Incharge</label>
                    <textarea typeof="text" class="erppage-textarea" id="TxtRemarks" maxlength="500" placeholder="Enter Remarks"></textarea>
                </div>
            </div>
            <fieldset class="erppage-subfieldset">
                <legend>Select Reading Details</legend>
                <div class="erppage-subheader">Select Reading Details</div>
                <div class="erppage-grid3">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Select Reading</label>
                        <select class="erppage-input erppage-required" id="ddlSelectReading">
                            <option selected disabled>Select Reading</option>
                            <option value="temperature">Temperature</option>
                            <option value="speed">Speed</option>
                            <option value="winder">Winder</option>
                        </select>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Import Interval</label>
                        <input type="text" class="erppage-input" id="TxtImport" placeholder="Enter Import Interval (in Min)" />
                    </div>
                    <div class="erppage-divfield">
                        <div class="erppagelist-toolbar-end" style="margin: 0px; padding: 0px;">
                            <div class="erppage-internalaction" style="margin: 0;">
                                <button type="button" id="btn_import" class="erppage-btn erppage-btn-common">
                                    <i class="fa fa-download"></i>
                                    <span>Import</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>
            <div class="table-row-layout">
                <div class="erppagelist-container" style="margin:0px;">
                    <div class="excel-wrapper fixed-grid-wrapper special-6x6-table">
                        <table id="tblPlantZone" class="excel-table fixed-grid-table">
                            <colgroup>
                                <col style="width: 150px;">
                                <col style="width: 120px;">
                                <col style="width: 200px;">
                                <col style="width: 150px;">
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Plant Zone</th>
                                    <th>Temperature('C)</th>
                                    <th>Remarks</th>
                                    <th>Date Time</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
                <div class="erppagelist-container" style="margin:0px;">
                    <div class="excel-wrapper fixed-grid-wrapper special-6x6-table">
                        <table id="tblScrew" class="excel-table fixed-grid-table">
                            <colgroup>
                                <col style="width: 150px;">
                                <col style="width: 100px;">
                                <col style="width: 200px;">
                                <col style="width: 150px;">
                            </colgroup>
                            <thead class="table-head">
                                <tr>
                                    <th>Screw</th>
                                    <th>Speed</th>
                                    <th>Remarks</th>
                                    <th>Date Time</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="table-row-layout">
                <div class="erppagelist-container" style="margin:0px;">
                    <div class="excel-wrapper fixed-grid-wrapper special-6x6-table">
                        <table id="tblWinder" class="excel-table fixed-grid-table">
                            <colgroup>
                                <col style="display:none;">
                                <col style="width: 100px;">
                                <col style="width: 100px;">
                                <col style="width: 100px;">
                                <col style="width: 130px;">
                                <col style="width: 130px;">
                                <col style="width: 100px;">
                                <col style="width: 100px;">
                            </colgroup>
                            <thead>
                                <tr>
                                    <th style="display:none;">Code</th>
                                    <th>Winder No.</th>
                                    <th>Width(Mm)</th>
                                    <th>Denier</th>
                                    <th>Breaking Load(Kgf)</th>
                                    <th>Tenacity (Gpd.)</th>
                                    <th>Elongation</th>
                                    <th class="action-col">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <div class="erppagelist-toolbar-end" style="margin: 0px; padding: 0px;">
                        <div class="erppage-internalaction" style="margin: 0;">
                            <button type="button" class="erppage-btn erppage-btn-add btn-add-row" onclick="addWinderRecordRow()">
                                <i class="fa fa-plus"></i>
                                <span>Add New Row</span>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="erppagelist-container" style="margin:0px;">
                    <div class="excel-wrapper fixed-grid-wrapper special-6x6-table">
                        <table id="tblMaterial" class="excel-table fixed-grid-table">
                            <colgroup>
                                <col style="display:none;">
                                <col style="width: 150px;">
                                <col style="width: 120px;">
                                <col style="width: 120px;">
                                <col style="width: 100px;">
                                <col style="width: 100px;">
                            </colgroup>
                            <thead class="table-head">
                                <tr>
                                    <th style="display:none;">Code</th>
                                    <th>Material</th>
                                    <th>Lot No.</th>
                                    <th>No. of Bags</th>
                                    <th>Percent(%)</th>
                                    <th class="action-col">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <div class="erppagelist-toolbar-end" style="margin: 0px; padding: 0px;">
                        <div class="erppage-internalaction" style="margin: 0;">
                            <button type="button" class="erppage-btn erppage-btn-add btn-add-row" onclick="addMaterialRecordRow()">
                                <i class="fa fa-plus"></i>
                                <span>Add New Row</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
           
        </fieldset>
        <div class="erppage-actions">
            <button id="btn-save" type="submit" class="erppage-btn erppage-btn-save">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>
        </div>
    </div>
</div>




