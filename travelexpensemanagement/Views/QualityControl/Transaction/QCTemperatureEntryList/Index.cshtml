@{
	ViewBag.Title = "QC Temperature Entry List";
	Layout = "~/Views/Shared/_Layout.cshtml";

	var currentMenu = ViewBag.CurrentMenu as string;
	bool canAdd = false;
	bool canEdit = false;
	bool canDelete = false;
	bool canPrint = false;
	bool canExport = false;
	bool canMail = false;
	bool canApproval = false;
	bool canDocDetail = false;

	foreach (var permission in Model.UserMenuPermissions)
	{
		if (permission.MENU_NAME == ViewBag.CurrentMenu)
		{
			canAdd = Model.UserLevel == 1 || permission._ADD == 1;
			canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
			canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
			canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
			canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
			canMail = Model.UserLevel == 1 || permission._MAIL == 1;
			canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
			canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
			break;
		}
	}

}
@{
	ViewBag.Title = "QC Temperature Entry List";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<!-- HEADER -->
<div class="erppagelist-header">
	<div class="erppagelist-title">
		<i class="fa fa-list"></i>
		<span>QC Temperature Entry List</span>
	</div>
	<div class="erppagelist-header-right">
		<button class="erppage-header-back" onclick="location.href='@Url.Action("Index", "QCTemperatureEntry")'">
			<i class="fa fa-plus"></i>Add New
		</button>
	</div>
</div>
<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
	<div class="erppagelist-search-wrapper">
		<i class="fa fa-search"></i>
		<input type="text" id="searchBox" placeholder="Search by All Columns Name...." />
	</div>
	<div class="erppagelist-actions">
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" onclick="callGetReportAsPdf()">
			<i class="fa fa-print"></i> Print
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Export to Excel" onclick="exportToExcel()">
			<i class="fa fa-file-excel"></i> Export
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail" onclick="mailReport()">
			<i class="fa fa-envelope"></i>Mail
		</button>
		<button class="erppagelist-btn erppagelist-btn-approve tooltip-btn" data-tooltip="Approve Records">
			<i class="fa fa-check-circle"></i>Approved
		</button>
	</div>
</div>
<div class="erppagelist-container">
	<div class="excel-wrapper fixed-grid-wrapper">
		<table id="tblQCTemperatureList" class="excel-table fixed-grid-table">
			<colgroup>
				<col style="display:none;" /> <!-- Code -->
				@* <col style="width: 120px;" /> <!-- Voucher Type --> *@
				<col style="width: 120px;" /> <!-- Voucher No -->
				<col style="width: 120px;" /> <!-- Voucher Date -->
				@* <col style="width: 100px;" /> <!-- Inch_Code -->
				<col style="width: 140px;" /> <!-- Inch_Name -->
				<col style="width: 120px;" /> <!-- Operatore_Code -->
				<col style="width: 140px;" /> <!-- Operate_Name --> *@
				<col style="width: 80px;" />  <!-- Shift -->
				<col style="width: 120px;" /> <!-- Voucher Time -->
				@* <col style="width: 80px;" />  <!-- Denier --> *@
				<col style="width: 140px;" /> <!-- Denier Name -->
				@* <col style="width: 120px;" /> <!-- Sup_Code --> *@
				@* <col style="width: 160px;" /> <!-- Sup_Name --> *@
				@* <col style="width: 120px;" /> <!-- Uuser --> *@
				@* <col style="width: 120px;" /> <!-- Udate --> *@
				<col style="width: 140px;" /> <!-- Plant Name -->
				@* <col style="width: 180px;" /> <!-- Remark --> *@
				<col style="width: 140px;" /> <!-- Action -->
			</colgroup>
			<thead>
				<tr>
					<th style="display:none;">Code</th>
					@* <th>Voucher Type</th> *@
					<th>Doc @* Voucher *@ No</th>
					<th>Doc @* Voucher *@ Date</th>
					@* <th>Inch_Code</th> *@
					@* <th>Inch_Name</th> *@
					@* <th>Operatore_Code</th> *@
					@* <th>Operate_Name</th> *@
					<th>Shift</th>
					<th>Voucher Time</th>
					@* <th>Denier</th> *@
					<th>Denier Name</th>
					@* <th>Sup_Code</th> *@
					@* <th>Sup_Name</th> *@
					@* <th>Uuser</th> *@
					@* <th>Udate</th> *@
					<th>Plant Name</th>
					@* <th>Remark</th> *@
					<th class="action-col">Action</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>

	<div class="erppagelist-pagination">
		<div class="pagination-left">
			<select id="pageSizeSelect" onchange="changeRowsPerPage()">
				<option value="5">5</option>
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
			</select>
		</div>
		<div class="pagination-center">
			<button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
			<div id="pageNumbers" class="page-numbers"></div>

			<button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
		</div>
		<div class="pagination-right" id="pageInfoText">
			Results: 0 - 0 of 0
		</div>
	</div>
</div>


