@{
	ViewBag.Title = "QC Temperature Entry List";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<!-- HEADER -->
<div class="erppagelist-header">
	<div class="erppagelist-title">
		<i class="fa fa-list"></i>
		<span>QC Temperature Entry List</span>
	</div>
	<div class="erppagelist-header-right">
		<button class="erppage-header-back" onclick="location.href='@Url.Action("Index", "QCTemperatureEntry")'">
			<i class="fa fa-plus"></i>Add New
		</button>
	</div>
</div>
<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
	<div class="erppagelist-search-wrapper">
		<i class="fa fa-search"></i>
		<input type="text" id="searchBox" placeholder="Search by All Columns Name...." />
	</div>
	<div class="erppagelist-actions">
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" onclick="printCityMasterReport()">
			<i class="fa fa-print"></i> Print
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Export to Excel">
			<i class="fa fa-file-excel"></i> Export
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail" onclick="mailReport()">
			<i class="fa fa-envelope"></i>Mail
		</button>
		<button class="erppagelist-btn erppagelist-btn-approve tooltip-btn" data-tooltip="Approve Records">
			<i class="fa fa-check-circle"></i>Approved
		</button>
	</div>
</div>
<div class="erppagelist-container">
	<div class="excel-wrapper fixed-grid-wrapper">
		<table id="tblQCTemperatureList" class="excel-table fixed-grid-table">
			<colgroup>
				<col style="display:none;" /> <!-- Code -->
				<col style="width: 120px;" /> <!-- Voucher Type -->
				<col style="width: 120px;" /> <!-- Voucher No -->
				<col style="width: 120px;" /> <!-- Voucher Date -->
				<col style="width: 100px;" /> <!-- Inch_Code -->
				<col style="width: 140px;" /> <!-- Inch_Name -->
				<col style="width: 120px;" /> <!-- Operatore_Code -->
				<col style="width: 140px;" /> <!-- Operate_Name -->
				<col style="width: 80px;" />  <!-- Shift -->
				<col style="width: 120px;" /> <!-- Voucher Time -->
				<col style="width: 80px;" />  <!-- Denier -->
				<col style="width: 140px;" /> <!-- Denier Name -->
				<col style="width: 120px;" /> <!-- Sup_Code -->
				<col style="width: 160px;" /> <!-- Sup_Name -->
				<col style="width: 120px;" /> <!-- Uuser -->
				<col style="width: 120px;" /> <!-- Udate -->
				<col style="width: 180px;" /> <!-- Remark -->
				<col style="width: 140px;" /> <!-- Plant Name -->
				<col style="width: 140px;" /> <!-- Action -->
			</colgroup>
			<thead>
				<tr>
					<th style="display:none;">Code</th>
					<th>Voucher Type</th>
					<th>Voucher No</th>
					<th>Voucher Date</th>
					<th>Inch_Code</th>
					<th>Inch_Name</th>
					<th>Operatore_Code</th>
					<th>Operate_Name</th>
					<th>Shift</th>
					<th>Voucher Time</th>
					<th>Denier</th>
					<th>Denier Name</th>
					<th>Sup_Code</th>
					<th>Sup_Name</th>
					<th>Uuser</th>
					<th>Udate</th>
					<th>Remark</th>
					<th>Plant Name</th>
					<th class="action-col">Action</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>

	<div class="erppagelist-pagination">
		<div class="pagination-left">
			<select id="pageSizeSelect" onchange="changeRowsPerPage()">
				<option value="5">5</option>
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
			</select>
		</div>
		<div class="pagination-center">
			<button onclick="prevPage()" class="page-nav" id="prevBtn">‹</button>
			<div id="pageNumbers" class="page-numbers"></div>

			<button onclick="nextPage()" class="page-nav" id="nextBtn">›</button>
		</div>
		<div class="pagination-right" id="pageInfoText">
			Results: 0 - 0 of 0
		</div>
	</div>
</div>



<script>
	let currentPage = 1;
	let pageSize = 10;

	$(document).ready(function () {
		loadDocumentStages();

		$('#searchBox').on('keyup', function () {
			currentPage = 1;
			loadDocumentStages();
		});
	});

	//Load main grid...............
	function loadDocumentStages() {
		const searchTerm = $('#searchBox').val();

		$.ajax({
			url: '/ApprovalStageMasterList/GetAllDocs',
			type: 'GET',
			dataType: 'json',
			data: {
				searchTerm,
				pageNumber: currentPage,
				pageSize: pageSize
			},
			success: function (res) {
				console.log(res);
				const docs = res.items || res.data || [];
				const totalCount = res.totalCount || 0;

				const tbody = $('#tblApprovalStageMaster tbody');
				tbody.empty();

				if (docs.length === 0) {
					tbody.append(`<tr><td colspan="5" class="text-center text-muted">No records found.</td></tr>`);
					renderPagination(0, pageSize, currentPage);
					return;
				}

				docs.forEach(doc => {
					tbody.append(`
						<tr>
							<td style="display:none;">${doc.code || doc.doC_CODE || ''}</td>
							<td>${doc.doC_CODE || ''}</td>
							<td>${doc.doC_NAME || ''}</td>
							<td>${doc.useR_NO || '0'}</td>
							<td>
							  <div class="action-icons">
							  <i class="fa fa-edit btn-edit" data-bs-toggle="tooltip" title="Edit" onclick="editDocStage('${doc.doC_CODE}')"></i>
							  <i class="fa fa-eye btn-view" data-bs-toggle="tooltip" title="View" onclick="viewDocStage('${doc.doC_CODE}')"></i>
							  <i class="fa fa-trash btn-delete" data-bs-toggle="tooltip" title="Delete" onclick="deleteDocStage('${doc.doC_CODE}')"></i>
							  <i class="fa fa-file btn-document" data-bs-toggle="tooltip" data-bs-title="Document Details" onclick="showDocumentPopup('${doc.doC_CODE}')"></i>
							  </div>

							</td>
						</tr>
					`);
				});

				renderPagination(totalCount, pageSize, currentPage);
			},
			error: function (xhr) {
				toastr.error('Error loading document stages: ' + (xhr.responseJSON?.message || xhr.statusText));
			}
		});
	}

	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const pagination = $('#tablePagination');
		pagination.empty();

		if (totalPages <= 1) return;

		let html = '';

		if (currentPage > 1) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		const startPage = Math.max(1, currentPage - 2);
		const endPage = Math.min(totalPages, currentPage + 2);

		for (let i = startPage; i <= endPage; i++) {
			html += `
				<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
		}

		if (currentPage < totalPages) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		pagination.html(html);
	}

	function goToPage(page) {
		currentPage = page;
		loadDocumentStages();
	}

	function editDocStage(docCode) {
		window.location.href = `/ApprovalStageMaster/Index?docCode=${encodeURIComponent(docCode)}`;
	}

	function viewDocStage(docCode) {
		window.location.href = `/ApprovalStageMaster/Index?docCode=${encodeURIComponent(docCode)}&readOnly=true`;
	}

	function deleteDocStage(docCode) {
		Swal.fire({
			title: 'Are you sure?',
			text: "You won't be able to revert this deletion!",
			icon: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#d33',
			cancelButtonColor: '#3085d6',
			confirmButtonText: 'Yes, delete it!'
		}).then((result) => {
			if (result.isConfirmed) {
				$.ajax({
					url: '/ApprovalStageMasterList/DeleteDocByCode',
					type: 'POST',
					data: { docCode: docCode },
					success: function (response) {
						if (response.success) {
							toastr.success(response.message || "Record deleted successfully.");
							loadDocumentStages();
						} else {
							toastr.warning("Delete failed.");
						}
					},
					error: function () {
						toastr.error("An error occurred while deleting.");
					}
				});
			}
		});
	}


</script>
