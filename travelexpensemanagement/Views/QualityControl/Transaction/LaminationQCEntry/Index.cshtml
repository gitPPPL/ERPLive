    function wireEvents() {

        $('#btn_update').on('click', async (e) => {
          e.preventDefault();

            if (!validateRequiredField('#DtDocDate', 'Doc Date') ||
                !validateRequiredField('#ddlPlace', 'Place Type')) return;

            try {
              const data = await collectFormData();  
              console.log(data,data.LaminationDetails.length);
              if (data.LaminationDetails && data.LaminationDetails.length > 0) {
                  UpdateData(data);
              }else{
                  toastr.warning("Please fill weftWay and warpWay");
                  return;
              }

            
            } catch (err) {
              toastr.error("Error saving data: " + err);
            }
        });

