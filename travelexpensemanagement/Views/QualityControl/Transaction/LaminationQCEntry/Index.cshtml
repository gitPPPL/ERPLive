<script>

    function fillShiftForSameLamination(laminationName, shiftId) {
         if (laminationName !== "" && shiftId != "") {
             const $rows = $('#tblLaminationQCEntry tbody tr');
             $rows.each(function () {
                 const $row = $(this); 
                 const rowLaminationName = $row.find("input[id^='TxtLamination']").val();

                 if (rowLaminationName === laminationName) {
                     $row.find("select[id^='ddlShift']").val(shiftId);
                     // $row.find("input[id^='TxtSupervisor']").val(supervisorId);
                 }
             });
         } else {
             toastr.info("No data found.");
         }
     }

     function fillSupervisorForSameLamination(laminationName, supervisorId) {
         if (laminationName !== "" && supervisorId > 0) {
             const $rows = $('#tblLaminationQCEntry tbody tr');
             $rows.each(function () {
                 const $row = $(this);

                 // const rowLaminationName = $row.find("input[id^='TxtLamination']").val()
                 //     || $row.find(".TxtLamination").val()
                 //     || $row.find("td.TxtLamination").text().trim();
                 const rowLaminationName = $row.find("input[id^='TxtLamination']").val();

                 if (rowLaminationName === laminationName) {                     
                     $row.find("select[id^='ddlSupervisor']").val(supervisorId);
                     $row.find("input[id^='TxtSupervisor']").val(supervisorId);
                 }
             });
         } else {        
             toastr.info("No data found.");
         }
     }


     function fillOperatorForSameLamination(laminationName, operatorId) {
         if (laminationName !== "" && operatorId > 0) {
             const $rows = $('#tblLaminationQCEntry tbody tr');

             $rows.each(function() {
                 const $row = $(this);
                 const rowLaminationName = $row.find("input[id^='TxtLamination']").val()
                     || $row.find(".TxtLamination").val()
                     || $row.find("td.TxtLamination").text().trim();

                 if (rowLaminationName === laminationName) {                   
                     $row.find("select[id^='ddlOperator']").val(operatorId);
                     $row.find("select[id^='TxtOperator'], input[id^='TxtOperator']").val(operatorId);
                 }
             });
         } else {
             toastr.info("No data found.");
         }
     }

     async function GetdataBasedOnQC(selectedValue, placeCode, date) {
         $.ajax({
             url: '/LaminationQCEntry/GetQCDataList',
             type: 'GET',
             data: {
                 QcAllOrPending: selectedValue,
                 PlaceCode: placeCode,
                 date:date
             },
             success: async function (response) {
                 if (response.status && response.data.length > 0) {
                     const data = response.data;
                      const Docid = data[0].DOC_ID || 0;
                       $('#TxtDocId').val(Docid);

                     const $tbody = $('#tblLaminationQCEntry tbody');
                     $tbody.empty();

                     for (let i = 0; i < data.length; i++) {
                         const html = buildRowHTML(i + 1, data[i]);
                         $tbody.append(html);
                     }
                     for (let i = 0; i < data.length; i++) {
                         await bindDropdownData(i + 1);                        
                     }
                     // for(let i=0; i < data.length; i++){
                     //  setEnterKeyFocusOnTable?.(i + 1);
                     // }
                     
                 } else {
                     $('#tblLaminationQCEntry tbody').empty();
                     toastr.info("No data found.");
                 }
             },
             error: function (xhr, status, error) {
                 toastr.error("Failed to load data.");
             }
         });
     }

