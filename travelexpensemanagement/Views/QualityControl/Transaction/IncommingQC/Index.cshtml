@{
    ViewBag.Title = "Incomming QC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-check-circle"></i>
        </div>
        <div class="erppage-header-title">Incomming QC</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "IncommingQCList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="IncommingQCForm">
    <input type="hidden" class="form-control" id="TxtDocId" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Type</label>
                    <select class="erppage-input erppage-select" id="ddlDocType">
                        <option value="">Select Document Type</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Document No</label>
                    <input type="number" class="erppage-redinput" id="NumDocNo" placeholder="Enter Doc No" readonly>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-input" id="DtDocDate">
                </div>
                <div class="erppage-internalaction">
                    <button type="button" id="btn-pending" class="erppage-btn erppage-btn-danger">
                        <i class="fa fa-hourglass-half"></i>
                        <span>Pending QC</span>
                    </button>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">MRN No</label>
                    <div class="erppage-inputgroup">
                        <select class="erppage-input" id="ddlMRNNo">
                            <option value="0">Select MRN No</option>
                        </select>
                        <button type="button" class="erppage-btn-inline erppage-btn-common" id="Btn-fill">
                            <i class="fa fa-file-signature"></i> Fill
                        </button>
                    </div>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">MRN Date</label>
                    <input type="date" class="erppage-input" id="DtMRNDate" />
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Party Name</label>
                    <select class="erppage-input erppage-select" id="ddlPartyName">
                        <option value="">Select Party Name</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Bill No</label>
                    <input type="text" class="erppage-input" id="TxtBillNo" placeholder="Enter Bill No" />
                </div>
                <div class="erppage-divfield erppage-datefield">
                    <label class="erppage-label">Bill Date</label>
                    <div class="erppage-datebox">
                        <input type="date" class="erppage-input erppage-dateinput" id="DtBillDate">
                        <label class="erppage-checkbox-inside">
                            <input type="checkbox" id="chkBillDate">
                        </label>
                    </div>
                </div>
            </div>
            <div class="erppage-grid4">

                <div class="erppage-divfield">
                    <label class="erppage-label">Invoice Qty</label>
                    <input type="text" class="erppage-input" id="TxtInvoiceQty" placeholder="Enter Invoice Qty" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Received Qty</label>
                    <input type="text" class="erppage-input" id="TxtRecordedQty" placeholder="Enter Received Qty" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Shortage</label>
                    <input type="text" class="erppage-input" id="TxtShortage" placeholder="Enter Shortage" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Truck No</label>
                    <input type="text" class="erppage-input" id="TxtTruckNo" placeholder="Enter Truck No" />
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">QC Incharge</label>
                    <select class="erppage-input erppage-select" id="ddlQCIncharge">
                        <option value="">Select QC Incharge</option>
                    </select>
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Chemist</label>
                    <select class="erppage-input erppage-select" id="ddlChem">
                        <option value="">Select Chemist</option>
                    </select>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Transport</label>
                    <input type="text" class="erppage-input" id="TxtTransport" placeholder="Enter Transport" />
                </div>

                <div class="erppage-divfield">
                    <label class="erppage-label">Remarks</label>
                    <input class="erppage-input" id="TxtRemarks" placeholder="Enter Remarks" />
                </div>
            </div>
            <div class="erppage-grid4" style="display:none;">

                <div class="erppage-divfield" style="display:none;">
                    <label class="erppage-label">Purchase Type</label>
                    <input type="text" class="erppage-input" id="TxtPurchaseType" placeholder="Enter Purchase Type" />
                </div>
                <div class="erppage-divfield" style="display:none;">
                    <label class="erppage-label">Wastage</label>
                    <input type="text" class="erppage-input" id="TxtWastage" placeholder="Enter Wastage" />
                </div>
                <div class="erppage-divfield" style="display:none;">
                    <label class="erppage-label">Bales</label>
                    <input type="text" class="erppage-input" id="TxtBales" placeholder="Enter Bales" />
                </div>
            </div>
            <div class="erppage-grid4" id="field_hide">
                <div class="erppage-divfield">
                    <label class="erppage-label">Deduction Amount</label>
                    <input type="text" class="erppage-input" id="TxtDeductionAmount" placeholder="Enter Deduction Amount" />
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Deduction Narration</label>
                    <div class="erppage-inputgroup">
                        <input class="erppage-input" id="TxtDeductionNarration" placeholder="Enter Deduction Narration" />
                        <button type="button" class="erppage-btn erppage-btn-common" id="btn-calculate">
                            <i class="fa fa-calculator"></i> Calculate
                        </button>
                    </div>
                </div>

            </div>

            <div class="erppagelist-container">
                <div class="excel-wrapper fixed-grid-wrapper">
                    <table id="tblIncommingQC" class="excel-table fixed-grid-table">
                        <colgroup>
                            <col style="display:none;">      <!-- Code (hidden) -->
                            <col style="width:300px;">       <!-- Item Name -->
                            <col style="width:180px;">       <!-- Particulars -->
                            <col style="width:100px;">       <!-- Unit -->
                            <col style="width:100px;">       <!-- Level -->
                            <col style="width:120px;">       <!-- Result -->
                            <col style="width:200px;">       <!-- Remarks -->
                            <col style="width:140px;">       <!-- Deduction Amount -->
                            <col style="width:140px;">       <!-- Allow Amount -->
                            <col style="width:220px;">       <!-- Deduction Narration -->
                            <col style="width:120px;">       <!-- Action -->
                        </colgroup>
                        <thead class="table-head">
                            <tr>
                                <th style="display:none;">Code</th>
                                <th>Item Name</th>
                                <th>Particulars</th>
                                <th>Unit</th>
                                <th>Level</th>
                                <th>Result</th>
                                <th>Remarks</th>
                                <th>Deduction Amount</th>
                                <th>Allow Amount</th>
                                <th>Deduction Narration</th>
                                @* <th class="action-col">Action</th> *@
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="erppagelist-pagination">
                    <div class="pagination-left">
                        <select id="pageSizeSelect" onchange="changeRowsPerPage()">
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                    </div>
                    <div class="pagination-center">
                        <button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
                        <div id="pageNumbers" class="page-numbers"></div>

                        <button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
                    </div>
                    <div class="pagination-right" id="pageInfoText">
                        Results: 0 - 0 of 0
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="erppage-actions">
            <button id="btn-save" type="submit" class="erppage-btn erppage-btn-save">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        function getQueryParam(param) {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(param);
    }
    const vType = getQueryParam('vType');
    const vNo = getQueryParam('vNo');
    if (vNo) {
        $.ajax({
            url: '/IncommingQC/GetAllDatadetails',
            type: 'POST',
            contentType: 'application/json',
            dataType: 'json',
            data: JSON.stringify({ vNo: vNo, vType: vType }),
            success: function (response) {
                 GetallDataIncommingQC(response);
            },
            error: function (xhr) {
                toastr.error('Error: ' + xhr.responseText);
            }
        });
    }
    const $tbody = $('#tblIncommingQC tbody');
    function ddlItemMaster($ddl, selectedValue = '') {
        $.ajax({
            url: '/IncommingQC/GetItemMaster',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                $ddl.empty().append('<option value="">-- Select Item --</option>');
                $.each(data, function (index, item) {
                    $ddl.append(`<option value="${item.value}">${item.text}</option>`);
                });
                // ✅ set selected AFTER options are loaded
                if (selectedValue !== '' && selectedValue !== null) {
                    $ddl.val(selectedValue);
                }
            }
        });
    }
    function Particulars($ddl, selectedValue = '') {
        $.ajax({
            url: '/IncommingQC/GetParticulars',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                $ddl.empty().append('<option value="">-- Select Particular --</option>');
                $.each(data, function (index, item) {
                    $ddl.append(`<option value="${item.value}">${item.text}</option>`);
                });
                if (selectedValue !== '' && selectedValue !== null) {
                    $ddl.val(selectedValue);
                }
            }
        });
    }
    function Units($ddl, selectedValue = '') {
        $.ajax({
            url: '/IncommingQC/GetUnits',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                $ddl.empty().append('<option value="">-- Select Unit --</option>');
                $.each(data, function (index, item) {
                    $ddl.append(`<option value="${item.value}">${item.text}</option>`);
                });
                if (selectedValue !== '' && selectedValue !== null) {
                    $ddl.val(selectedValue);
                }
            }
        });
    }
    function addRow(data = {}) {
        // remove previous "+" buttons
        $tbody.find('.btn-add-action').remove();

        const row = `
            <tr>
                <td style="display:none;">${data.code || ''}</td>
                <td><select class="form-control ddlItemName"></select></td>
                <td><select class="form-control ddlParticulars"></select></td>
                <td><select class="form-control ddlUnits"></select></td>
                <td><input type="number" class="form-control" value="${data.level || ''}" /></td>
                <td><input type="text" class="form-control" value="${data.result || ''}" /></td>
                <td><input type="text" class="form-control" value="${data.remarks || ''}" /></td>
                <td><input type="number" class="form-control" value="${data.deductionAmount || ''}" /></td>
                <td><input type="number" class="form-control" value="${data.allowAmount || ''}" /></td>
                <td><input type="text" class="form-control" value="${data.deductionNarration || ''}" /></td>
                <td>
                    <i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer;"></i>
                    <i class="fa fa-trash btn-delete-action text-danger" title="Delete Row" style="cursor:pointer;"></i>
                </td>
            </tr>
        `;

        $tbody.append(row);

        // Bind dropdowns for this row
        const $lastRow = $tbody.find('tr:last');
        ddlItemMaster($lastRow.find('.ddlItemName'));
        Particulars($lastRow.find('.ddlParticulars'));
        Units($lastRow.find('.ddlUnits'));
    }
    addRow();
    $(document).on('click', '.btn-add-row', function () {
        addRow();
    });
    $(document).on('click', '.btn-delete-action', function () {
        const $row = $(this).closest('tr');
        const isLastRow = $row.is(':last-child');
        $row.remove();

        if (isLastRow) {
            const $lastRow = $tbody.find('tr:last');
            if ($lastRow.length && !$lastRow.find('.btn-add-action').length) {
                $lastRow.find('td:last').prepend(
                    `<i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer;"></i>`
                );
            }
        }
    });
    $('#btnAddRow').on('click', function () {
        addRow();
    });
    ddlDocType();
    ddlQCIncharge();
    ddlCheme();
    ddlPartyName();
    const now = new Date();
    const formattedDate = now.toISOString().split('T')[0];
    $("#DtDocDate").val(formattedDate);
    $('#ddlDocType').on('change', function () {
            const selectedValue = $(this).val();
            const selectedText = $(this).find("option:selected").text();
            $('#NumDocNo').prop('readonly', true);

            if (selectedValue !== "") {
                sendDocType(selectedValue, selectedText);
            } else {
                $('#NumDocNo').val('');
            }
        });
    $('#ddlMRNNo').on('change', function () {
            var selectedNo = $(this).val();
            const selectedText = $(this).find('option:selected').text();

            if (selectedNo !== "0" && selectedNo !== "") {
                $.ajax({
                    url: '/IncommingQC/GetGatDetailsList',
                    type: 'POST',
                    data: {
                        StrVNo: selectedNo,
                        StrV_type: selectedText
                    },
                    success: function (response) {
                        GetalldatafetchGatonchange(response);
                    },
                    error: function (xhr) {
                        console.error("Error:", xhr.responseText);
                    }
                });
            }
        });
    $('#Btn-fill').on('click', function () {

        $("#field_hide").hide();
        var DocType = $('#ddlDocType').val();
        var mrnText = $('#ddlMRNNo option:selected').text();
        var VNo = $('#ddlMRNNo').val();

        $.ajax({
            url: '/IncommingQC/SendDropdownData',
            type: 'POST',
            data: {
                DocType: DocType,
                MRNText: mrnText,
                VNo: VNo
            },
            success: function (response) {
                if (response.success === false) {
                    toastr.warning(response.message);
                }
                console.log('response Btn-fill', response);
                if (response.headerData && response.headerData.length > 0) {
                    const header = response.headerData[0];

                    // Fill header fields
                    $('#ddlPartyName').append(`<option value="${header.partY_CODE}" selected>${header.name}</option>`);
                    $('#TxtTransport').val(safeValue(header.transporT_NAME));
                    $('#TxtInvoiceQty').val(safeValue(header.bilL_QTY));
                    $('#TxtRecordedQty').val(safeValue(header.recD_QTY));
                    $('#TxtPurchaseType').val(safeValue(header.documenT_NAME));
                    $('#DtMRNDate').val(convertToISODate(header.v_DATE));
                    $('#TxtBillNo').val(safeValue(header.bilL_NO));
                    $('#DtBillDate').val(convertToISODate(header.bilL_DATE));
                    $('#TxtTruckNo').val(safeValue(header.trucK_NO));
                }

                // Clear previous table rows
                $tbody.empty();

                // Fill table rows using itemData
                if (response.itemData && response.itemData.length > 0) {
                    response.itemData.forEach(item => {
                        addRow({
                            code: item.iteM_CODE,
                            itemName: item.iteM_NAME,
                            particulars: item.particulaR_NAME,
                            unit: item.uniT_NAME || '',
                            level: item.stD_LEVEL,
                            deductionAmount: item.deduction_amt,
                            allowAmount: item.allow_amt,
                            deductionNarration: item.deduction_narration
                        });
                    });
                }
            },
            error: function (xhr, status, error) {
                console.error('Error:', error);
                toastr.error('Error sending data.');
            }
        });

        function safeValue(value) {
            if (value === null || value === undefined) return '';
            if (typeof value === 'object') return '';
            return value;
        }

        function convertToISODate(dateStr) {
            if (!dateStr) return '';
            const parts = dateStr.split('/');
            if (parts.length === 3) {
                return `${parts[2]}-${parts[1]}-${parts[0]}`;
            }
            return '';
        }
    });
    function addRow(data = {}) {
        $tbody.find('.btn-add-action').remove();
        const row = `
            <tr>
                <td style="display:none;">${data.code || ''}</td>
                <td><select class="form-control ddlItemName"></select></td>
                <td><select class="form-control ddlParticulars"></select></td>
                <td><select class="form-control ddlUnits"></select></td>
                <td><input type="number" class="form-control" value="${data.level || '0.0000'}" /></td>
                <td><input type="text" class="form-control" value="${data.result || ''}" /></td>
                <td><input type="text" class="form-control" value="${data.remarks || ''}" /></td>
                <td><input type="number" class="form-control" value="${data.deductionAmount || '0.00'}" /></td>
                <td><input type="number" class="form-control" value="${data.allowAmount || '0.00'}" /></td>
                <td><input type="text" class="form-control" value="${data.deductionNarration || ''}" /></td>
                <td>
                    <i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer;"></i>
                    <i class="fa fa-trash btn-delete-action text-danger" title="Delete Row" style="cursor:pointer;"></i>
                </td>
            </tr>
        `;

        $tbody.append(row);

        const $lastRow = $tbody.find('tr:last');

        // Bind dropdowns
        ddlItemMaster($lastRow.find('.ddlItemName'), data.itemName);
        Particulars($lastRow.find('.ddlParticulars'), data.particulars);
        Units($lastRow.find('.ddlUnits'), data.unit);
    }

     function GetalldatafetchGatonchange(response) {
               if (!response || response.length === 0) return;

               const data = response[0];

               // Format date function (optional reuse)
               const formatDate = (dateStr) => {
                   if (!dateStr) return "";
                   const parts = dateStr.split('/');
                   if (parts.length !== 3) return "";
                   return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
               };
                $('#DtGateDate').val(formatDate(data.v_DATE)).prop('readonly', true);
                $('#TxtPartyName').val(data.partyName || '').prop('readonly', true);
                $('#TxtTruckNo').val(data.trucK_NO || '').prop('readonly', true);
                $('#NumBillNo').val(data.bilL_NO || '').prop('readonly', true);
                $('#DtBillDate').val(formatDate(data.bilL_DATE)).prop('readonly', true);
                $('#TxtInvoiceQty').val(data.qty || '').prop('readonly', true);
                $('#TxtRecordedQty').val(data.qty || '').prop('readonly', true);
                $('#TxtShortage').val('0');
                $('#TxtWastage').val('0');
                $('#TxtTransport').val('');
                $('#TxtContainerNo').val('');

               // ✅ Populate itemTable
               const itemCode = data.iteM_CODE || '';
               const itemName = data.iteM_NAME || '';

               $('#itemTable thead tr').empty();
               $('#itemTable tbody').empty();
               // Add table row
               $('#itemTable tbody').append(`
                   <tr class="text-left">
                       <td>${itemCode}</td>
                       <td>${itemName}</td>
                   </tr>
               `);
         }

    $('#btn-save').on('click', function (e) {
        e.preventDefault();

        // 1️⃣ Collect table items
        let tableData = [];
        $('#tblIncommingQC tbody tr').each(function () {
            const $row = $(this);

            tableData.push({
                iteM_CODE: parseInt($row.find('.ddlItemName').val()) || 0,
                particulaR_NAME: $row.find('.ddlParticulars').val(),
                uniT_NAME: $row.find('.ddlUnits').val() || "",
                stD_LEVEL: parseFloat($row.find('input[type="number"]').eq(0).val()) || 0,
                result: $row.find('input[type="text"]').eq(0).val() || "",
                remarks: $row.find('input[type="text"]').eq(1).val() || "",
                deduction_amt: parseFloat($row.find('input[type="number"]').eq(1).val()) || 0,
                allow_amt: parseFloat($row.find('input[type="number"]').eq(2).val()) || 0,
                deduction_narration: $row.find('input[type="text"]').eq(2).val() || "",
                qcP_CODE: parseInt($row.find('.ddlQCPCode').val()) || 0,
                nos: parseInt($row.find('.txtNos').val()) || 0
            });
        });

        console.log('item',tableData)
        // 2️⃣ Collect header
        const headerData = {
            DocType: $('#ddlDocType').val(),
            MRNNo: $('#ddlMRNNo option:selected').text(),
            V_TYPE: $('#ddlVType').val(),
            v_NO:  $('#ddlMRNNo').val(),
            DocNo: $('#NumDocNo').val(),
            DocDate: new Date($('#DtDocDate').val()).toISOString(),
            QCIncharge: $('#ddlQCIncharge').val(),
            Chemist: $('#ddlChem').val(),
            PartyCode: parseInt($('#ddlPartyName').val()) || 0,
            Transport: $('#TxtTransport').val(),
            InvoiceQty: parseFloat($('#TxtInvoiceQty').val()) || 0,
            RecordedQty: parseFloat($('#TxtRecordedQty').val()) || 0,
            PurchaseType: $('#TxtPurchaseType').val(),
            Wastage: parseFloat($('#TxtWastage').val()) || 0,
            MRNDate: new Date($('#DtMRNDate').val()).toISOString(),
            Bales: parseFloat($('#TxtBales').val()) || 0,
            BillNo: $('#TxtBillNo').val(),
            BillDate: new Date($('#DtBillDate').val()).toISOString(),
            TruckNo: $('#TxtTruckNo').val(),
            Shortage: parseFloat($('#TxtShortage').val()) || 0,
            DeductionAmount: parseFloat($('#TxtDeductionAmount').val()) || 0,
            DeductionNarration: $('#TxtDeductionNarration').val(),
            Remarks: $('#TxtRemarks').val(),
             ACTION: vNo > 0 ? "UPDATE" : "INSERT",
        };
        console.log('headerData',headerData)

        // 3️⃣ Send via AJAX
        $.ajax({
            url: '/IncommingQC/SaveQCData',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ header: headerData, items: tableData }),
            success: function (response) {
                if (response.success) {
                    toastr.success('Data saved successfully!');
                } else {
                    toastr.error(response.message || 'Something went wrong.');
                }
            },
            error: function (xhr, status, error) {
                toastr.error('Error saving data.');
                console.error(error);
            }
        });
    });
    function GetallDataIncommingQC(response) {
        console.log('response', response);
        if (!response || !response.header || response.header.length === 0) {
            toastr.warning('No record found.');
            return;
        }
        const header = response.header[0];
        const items = response.items || [];
        $('#ddlDocType').val(header.DocType);
