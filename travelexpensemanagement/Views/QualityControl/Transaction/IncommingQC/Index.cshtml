@{
    ViewBag.Title = "Incomming QC";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var globalVariables = ViewBag.GlobalVariables as Models.UserSessionData;
}
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-check-circle"></i>
        </div>
        <div class="erppage-header-title">Incomming QC</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "IncommingQCList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="IncommingQCForm">
    <input type="hidden" class="form-control" id="TxtDocId" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Type</label>
                    <select class="erppage-input erppage-select" id="ddlDocType">
                        <option value="">Select Document Type</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Document No</label>
                    <input type="number" class="erppage-redinput" id="NumDocNo" placeholder="Enter Doc No" readonly>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-input" id="DtDocDate">
                </div>
                <div class="erppage-internalaction">
                    <button type="button" id="btn-pending" onclick="PendingQCReport()" class="erppage-btn erppage-btn-danger">
                        <i class="fa fa-hourglass-half"></i>
                        <span>Pending QC Report</span>
                    </button>
                </div>
            </div>
