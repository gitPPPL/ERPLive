                docName: docName
            },
            success: function (response) {
                if (response.success) {
                    const vNo = response.nextVNo;
                    const vType = response.docType;

                    $('#NumDocNo').val(vNo);
                    ddlMRNNo(vNo, vType);
                }
            },
            error: function (xhr) {
                console.error("Error:", xhr.responseText);
            }
        });
    }
