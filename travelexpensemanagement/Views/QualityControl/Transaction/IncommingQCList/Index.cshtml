@{
	ViewBag.Title = "Incomming QC List";
	Layout = "~/Views/Shared/_Layout.cshtml";

}

<fieldset>
	<legend class="legend-field">Incomming QC List</legend>
	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>
		<div class="col-lg-6">
			<div class="btn-rightalign">
				<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "IncommingQC")'" type="submit" class="btn btn-add">
					<i class="fa fa-plus"></i>Add
				</button>
				<button class="btn btn-print" onclick="printCityMasterReport()">
					<i class="fa fa-print"></i> Print
				</button>
				<button class="btn btn-export">
					<i class="fas fa-file-export"></i> Export
				</button>
				<button class="btn btn-mail">
					<i class="fa fa-envelope"></i> Mail
				</button>
				<button class="btn btn-approved">
					<i class="fa fa-check"></i> Approved
				</button>
			</div>
		</div>
	</div>
	<div class="card">
		<div class="table-responsive">
			<table id="tblIncommingQCList" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>V_Type</th>
						<th>Name</th>
						<th>V_No</th>
						<th>V_Date</th>
						<th>Mrn_No</th>
						<th>Mrn_Type</th>
						<th>Mrn_Date</th>
						<th>Bales</th>
						<th>Party_Code</th>
						<th>Party Name</th>
						<th>Bill_No</th>
						<th>Bill_Date</th>
						<th>Transport</th>
						<th>Truck_No</th>
						<th>Inv_Qty</th>
						<th>Recd_Qty</th>
						<th>Short_Qty</th>
						<th>Remarks</th>
						<th>Deduct_Amt</th>
						<th>Deduct_Narr</th>
						<th>Pur_Type</th>
						<th>Waste_Wgt</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
	</div>
</fieldset>
<script>
    let currentPage = 1;
    let pageSize = 10;

    $(document).ready(function () {
        loadIncommingQCList();

        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadIncommingQCList();
        });
    });

    function loadIncommingQCList() {
        const searchTerm = $('#searchBox').val();
        $.ajax({
            url: '/IncommingQCList/GetQCIncommingQCEntryList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                console.log(res);
                const docs = res.items || [];
                const totalCount = res.totalCount || 0;
                const tbody = $('#tblIncommingQCList tbody');
                tbody.empty();
                if (docs.length === 0) {
                    tbody.append(`<tr><td colspan="22" class="text-center text-muted">No records found.</td></tr>`);
                    renderPagination(0, pageSize, currentPage);
                    return;
                }
                docs.forEach(doc => {
                    tbody.append(`
                        <tr>
                            <td style="display:none;">${doc.searchCode || ''}</td>
                            <td>${doc.v_TYPE || ''}</td>
                            <td>${doc.docTypeName || ''}</td>
                            <td>${doc.v_NO || ''}</td>
                            <td>${doc.v_DATE || ''}</td>
                            <td>${doc.mrN_NO || ''}</td>
                            <td>${doc.mrN_TYPE || ''}</td>
                            <td>${doc.mrnDate || ''}</td>
                            <td>${doc.bales || ''}</td>
                            <td>${doc.partY_CODE || ''}</td>
                            <td>${doc.partyName || ''}</td>
                            <td>${doc.billNo || ''}</td>
                            <td>${doc.billDate || ''}</td>
                            <td>${doc.transportName || ''}</td>
                            <td>${doc.truckNo || ''}</td>
                            <td>${doc.inV_QTY || ''}</td>
                            <td>${doc.recD_QTY || ''}</td>
                            <td>${doc.shorT_QTY || ''}</td>
                            <td>${doc.remarks || ''}</td>
                            <td>${doc.deducT_AMT || ''}</td>
                            <td>${doc.deducT_NARR || ''}</td>
                            <td>${doc.puR_TYPE || ''}</td>
                            <td>${doc.wastE_WGT || ''}</td>
                            <td>
                                <div class="action-icons">
                                    <i class="fa fa-edit btn-edit"
                                        data-vtype="${doc.v_TYPE}"
                                        data-vno="${doc.v_NO}"
                                        onclick="editEntry(this)">
                                    </i>
                                    <i class="fa fa-eye btn-view"
                                        onclick="viewEntry('${doc.searchCode}')">
                                    </i>
                                    <i class="fa fa-trash btn-delete"
                                        onclick="deleteDocStage('${doc.searchCode}')">
                                    </i>
                                </div>
                            </td>
                        </tr>
                    `);
                });
                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                toastr.error('Error loading data: ' + (xhr.responseJSON?.message || xhr.statusText));
            }
        });
    }
    function editEntry(el) {
        const vType = $(el).data("vtype");
        const vNo = $(el).data("vno");
        window.location.href = `/IncommingQC/Index?vType=${encodeURIComponent(vType)}&vNo=${encodeURIComponent(vNo)}`;
    }
    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const pagination = $('#tablePagination');
        pagination.empty();
        if (totalPages <= 1) return;
        let html = '';
        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        const startPage = Math.max(1, currentPage - 2);
        const endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
            html += `
                <button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1"
                        onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        pagination.html(html);
    }
    function goToPage(page) {
        currentPage = page;
        loadIncommingQCList();
    }
    function viewEntry(docCode) {
        window.location.href = `/IncommingQC/Index?docCode=${encodeURIComponent(docCode)}&readOnly=true`;
    }
    function deleteDocStage(docCode) {
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this deletion!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/IncommingQC/DeleteDocByCode',
                    type: 'POST',
                    data: { docCode: docCode },
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message || "Record deleted successfully.");
                            loadIncommingQCList();
                        } else {
                            toastr.warning("Delete failed.");
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while deleting.");
                    }
                });
            }
        });
    }
</script>
