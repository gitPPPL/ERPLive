@{
	ViewBag.Title = "Incomming QC List";
	Layout = "~/Views/Shared/_Layout.cshtml";

}
<div id="erp-toast-container"></div>
<!-- HEADER -->
<div class="erppagelist-header">
	<div class="erppagelist-title">
		<i class="fa fa-list"></i>
		<span>QC Temperature Entry List</span>
	</div>
	<div class="erppagelist-header-right">
		<button class="erppage-header-back" onclick="location.href='@Url.Action("Index", "IncommingQC")'">
			<i class="fa fa-plus"></i>Add New
		</button>
	</div>
</div>
<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
	<div class="erppagelist-search-wrapper">
		<i class="fa fa-search"></i>
		<input type="text" id="searchBox" placeholder="Search by All Columns Name...." />
	</div>
	<div class="erppagelist-actions">
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" onclick="printCityMasterReport()">
			<i class="fa fa-print"></i> Print
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Export to Excel">
			<i class="fa fa-file-excel"></i> Export
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail">
			<i class="fa fa-envelope"></i>Mail
		</button>
		<button class="erppagelist-btn erppagelist-btn-approve tooltip-btn" data-tooltip="Approve Records">
			<i class="fa fa-check-circle"></i>Approved
		</button>
	</div>
</div>
<div class="erppagelist-container">
	<div class="excel-wrapper fixed-grid-wrapper">
		<table id="tblIncommingQCList" class="excel-table fixed-grid-table">
			<colgroup>
				<col style="display:none;" /> <!-- Code -->
				<col style="width: 120px;" /> <!-- Voucher Type -->
				<col style="width: 140px;" /> <!-- Name -->
				<col style="width: 120px;" /> <!-- Voucher No -->
				<col style="width: 120px;" /> <!-- Voucher Date -->
				<col style="width: 120px;" /> <!-- Mrn No -->
				<col style="width: 120px;" /> <!-- Mrn Type -->
				<col style="width: 120px;" /> <!-- Mrn Date -->
				<col style="width: 80px;" />  <!-- Bales -->
				<col style="width: 120px;" /> <!-- Party Code -->
				<col style="width: 180px;" /> <!-- Party Name -->
				<col style="width: 120px;" /> <!-- Bill No -->
				<col style="width: 120px;" /> <!-- Bill Date -->
				<col style="width: 140px;" /> <!-- Transport -->
				<col style="width: 120px;" /> <!-- Truck No -->
				<col style="width: 140px;" /> <!-- Invoice Quantity -->
				<col style="width: 140px;" /> <!-- Received Quantity -->
				<col style="width: 140px;" /> <!-- Shortage Quantity -->
				<col style="width: 180px;" /> <!-- Remarks -->
				<col style="width: 140px;" /> <!-- Deduction Amount -->
				<col style="width: 180px;" /> <!-- Deduction Narration -->
				<col style="width: 140px;" /> <!-- Purchase Type -->
				<col style="width: 120px;" /> <!-- Waste Weight -->
				<col style="width: 140px;" /> <!-- Action -->
			</colgroup>
			<thead>
				<tr>
					<th style="display:none;">Code</th>
					<th>Voucher Type</th>
					<th>Name</th>
					<th>Voucher No</th>
					<th>Voucher Date</th>
					<th>Mrn No</th>
					<th>Mrn Type</th>
					<th>Mrn Date</th>
					<th>Bales</th>
					<th>Party Code</th>
					<th>Party Name</th>
					<th>Bill No</th>
					<th>Bill Date</th>
					<th>Transport</th>
					<th>Truck No</th>
					<th>Invoice Quantity</th>
					<th>Received Quantity</th>
					<th>Shortage Quantity</th>
					<th>Remarks</th>
					<th>Deduction Amount</th>
					<th>Deduction Narration</th>
					<th>Purchase Type</th>
					<th>Waste Weight</th>
					<th class="action-col">Action</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>

	<div class="erppagelist-pagination">
		<div class="pagination-left">
			<select id="pageSizeSelect" onchange="changeRowsPerPage()">
				<option value="5">5</option>
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
			</select>
		</div>
		<div class="pagination-center">
			<button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
			<div id="pageNumbers" class="page-numbers"></div>

			<button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
		</div>
		<div class="pagination-right" id="pageInfoText">
			Results: 0 - 0 of 0
		</div>
	</div>
</div>




<script>
    let currentPage = 1;
    let pageSize = 10;

    $(document).ready(function () {
        loadIncommingQCList();

        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadIncommingQCList();
        });
    });

    function loadIncommingQCList() {
        const searchTerm = $('#searchBox').val();
        $.ajax({
            url: '/IncommingQCList/GetQCIncommingQCEntryList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                console.log(res);
                const docs = res.items || [];
                const totalCount = res.totalCount || 0;
                const tbody = $('#tblIncommingQCList tbody');
                tbody.empty();
                if (docs.length === 0) {
                    tbody.append(`<tr><td colspan="22" class="text-center text-muted">No records found.</td></tr>`);
                    renderPagination(0, pageSize, currentPage);
                    return;
                }
                docs.forEach(doc => {
                    tbody.append(`
                        <tr>
                            <td style="display:none;">${doc.searchCode || ''}</td>
                            <td>${doc.v_TYPE || ''}</td>
                            <td>${doc.docTypeName || ''}</td>
                            <td>${doc.v_NO || ''}</td>
                            <td>${doc.v_DATE || ''}</td>
                            <td>${doc.mrN_NO || ''}</td>
                            <td>${doc.mrN_TYPE || ''}</td>
                            <td>${doc.mrnDate || ''}</td>
                            <td>${doc.bales || ''}</td>
                            <td>${doc.partY_CODE || ''}</td>
                            <td>${doc.partyName || ''}</td>
                            <td>${doc.billNo || ''}</td>
                            <td>${doc.billDate || ''}</td>
                            <td>${doc.transportName || ''}</td>
                            <td>${doc.truckNo || ''}</td>
                            <td>${doc.inV_QTY || ''}</td>
                            <td>${doc.recD_QTY || ''}</td>
                            <td>${doc.shorT_QTY || ''}</td>
                            <td>${doc.remarks || ''}</td>
                            <td>${doc.deducT_AMT || ''}</td>
                            <td>${doc.deducT_NARR || ''}</td>
                            <td>${doc.puR_TYPE || ''}</td>
                            <td>${doc.wastE_WGT || ''}</td>
                            <td>
                                <div class="action-icons">
                                    <i class="fa fa-edit btn-edit"
                                        data-vtype="${doc.v_TYPE}"
                                        data-vno="${doc.v_NO}"
                                        onclick="editEntry(this)">
                                    </i>
                                    <i class="fa fa-eye btn-view"
                                        onclick="viewEntry('${doc.searchCode}')">
                                    </i>
                                    <i class="fa fa-trash btn-delete"
                                        onclick="deleteDocStage('${doc.searchCode}')">
                                    </i>
                                </div>
                            </td>
                        </tr>
                    `);
                });
                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                toastr.error('Error loading data: ' + (xhr.responseJSON?.message || xhr.statusText));
            }
        });
    }
    function editEntry(el) {
        const vType = $(el).data("vtype");
        const vNo = $(el).data("vno");
        window.location.href = `/IncommingQC/Index?vType=${encodeURIComponent(vType)}&vNo=${encodeURIComponent(vNo)}`;
    }
    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const pagination = $('#tablePagination');
        pagination.empty();
        if (totalPages <= 1) return;
        let html = '';
        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        const startPage = Math.max(1, currentPage - 2);
        const endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
            html += `
                <button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1"
                        onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        pagination.html(html);
    }
    function goToPage(page) {
        currentPage = page;
        loadIncommingQCList();
    }
    function viewEntry(docCode) {
        window.location.href = `/IncommingQC/Index?docCode=${encodeURIComponent(docCode)}&readOnly=true`;
    }
    function deleteDocStage(docCode) {
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this deletion!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/IncommingQC/DeleteDocByCode',
                    type: 'POST',
                    data: { docCode: docCode },
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message || "Record deleted successfully.");
                            loadIncommingQCList();
                        } else {
                            toastr.warning("Delete failed.");
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while deleting.");
                    }
                });
            }
        });
    }
</script>
