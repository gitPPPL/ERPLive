@{
    ViewBag.Title = "Incomming QC RM List";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<div id="erp-toast-container"></div>
<!-- HEADER -->
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>Incomming QC RM List</span>
    </div>
    <div class="erppagelist-header-right">
        <button class="erppage-header-back" onclick="location.href='@Url.Action("Index", "IncommingQCRM")'">
            <i class="fa fa-plus"></i>Add New
        </button>
    </div>
</div>
<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" id="searchBox" placeholder="Search by All Columns Name...." />
    </div>
    <div class="erppagelist-actions">
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" onclick="printCityMasterReport()">
            <i class="fa fa-print"></i> Print
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Export to Excel">
            <i class="fa fa-file-excel"></i> Export
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail">
            <i class="fa fa-envelope"></i>Mail
        </button>
        <button class="erppagelist-btn erppagelist-btn-approve tooltip-btn" data-tooltip="Approve Records">
            <i class="fa fa-check-circle"></i>Approved
        </button>
    </div>
</div>
<div class="erppagelist-container">
    <div class="excel-wrapper fixed-grid-wrapper">
        <table id="tblIncommingQCRMList" class="excel-table fixed-grid-table resizable-table sortable-table">
            <colgroup>
                <col style="display:none;" />
                <col style="width:120px;" />
                <col style="width:100px;" />
                <col style="width:120px;" />
                <col style="width:100px;" />
                <col style="width:120px;" />
                <col style="width:250px;" />
                <col style="width:120px;" />
                <col style="width:120px;" />
                <col style="width:180px;" />
                <col style="width:150px;" />
                <col style="width:140px;" />
                <col style="width:140px;" />
                <col style="width:140px;" />
                <col style="width:250px;" />
                <col style="width:140px;" />
                <col style="width:250px;" />
                <col style="width:120px;" />
                <col style="width:140px;" />
                <col style="width:120px;" />
            </colgroup>
            <thead>
                <tr>
                    <th class="hidden-col" data-column="0">
                        Code <span class="sort-icon"></span>
                    </th>
                    <th data-column="1">
                        Doc Type <span class="sort-icon"></span>
                    </th>
                    <th data-column="3">
                        Doc No <span class="sort-icon"></span>
                    </th>
                    <th data-column="4">
                        Doc Date <span class="sort-icon"></span>
                    </th>
                    <th data-column="5">
                        Mrn No <span class="sort-icon"></span>
                    </th>
                    <th data-column="6">
                        Mrn Type <span class="sort-icon"></span>
                    </th>
                    <th data-column="10">
                        Party Name <span class="sort-icon"></span>
                    </th>
                    <th data-column="11">
                        Bill No <span class="sort-icon"></span>
                    </th>
                    <th data-column="12">
                        Bill Date <span class="sort-icon"></span>
                    </th>
                    <th data-column="13">
                        Transport <span class="sort-icon"></span>
                    </th>
                    <th data-column="14">
                        Truck No <span class="sort-icon"></span>
                    </th>
                    <th data-column="15">
                        Invoice Quantity <span class="sort-icon"></span>
                    </th>
                    <th data-column="16">
                        Received Quantity <span class="sort-icon"></span>
                    </th>
                    <th data-column="17">
                        Short Quantity <span class="sort-icon"></span>
                    </th>
                    <th data-column="18">
                        Remarks <span class="sort-icon"></span>
                    </th>
                    <th data-column="19">
                        Deduction Amount <span class="sort-icon"></span>
                    </th>
                    <th data-column="20">
                        Deduction Narration <span class="sort-icon"></span>
                    </th>
                    <th data-column="21">
                        Pur_Type <span class="sort-icon"></span>
                    </th>
                    <th data-column="22">
                        Waste Weight <span class="sort-icon"></span>
                    </th>
                    <th class="action-col">
                        Action
                    </th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div class="erppagelist-pagination">
        <div class="pagination-left">
            <select id="pageSizeSelect" onchange="changeRowsPerPage()">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="pagination-center">
            <button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
            <div id="pageNumbers" class="page-numbers"></div>

            <button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
        </div>
        <div class="pagination-right" id="pageInfoText">
            Results: 0 - 0 of 0
        </div>
    </div>
</div>
<script src="/common/pagination.js"></script>
<script src="/common/delete.js"></script>

<script>
      let qcPagination;

      $(document).ready(function () {

          qcPagination = Pagination.create({

              pageSize: parseInt($('#pageSizeSelect').val()) || 10,
              paginationContainer: '#pageNumbers',
              infoContainer: '#pageInfoText',

              loader: function (params) {

                  $.ajax({
                      url: '/IncommingQCRMList/GetQCIncommingQCEntryList',
                      type: 'GET',
                      dataType: 'json',
                      data: {
                          searchTerm: $('#searchBox').val(),
                          pageNumber: params.pageNumber,
                          pageSize: params.pageSize
                      },
                      success: function (res) {
                          console.log('khushahal', res)

                          params.callback({
                              data: res.items || [],
                              totalCount: res.totalCount || 0
                          });
                      },
                      error: function () {
                          toastr.error('Error loading data');
                      }
                  });
              },

              render: function (docs) {

                  const tbody = $('#tblIncommingQCRMList tbody');
                  tbody.empty();

                  if (!docs || docs.length === 0) {

                      tbody.append(`
                          <tr>
                              <td colspan="20" class="text-center">
                                  No records found
                              </td>
                          </tr>
                      `);

                      return;
                  }

                  docs.forEach(doc => {

                      tbody.append(`
                          <tr>
                              <td style="display:none;">${doc.searchCode || ''}</td>
                              <td>${doc.v_TYPE || ''}</td>
                              <td>${doc.v_NO || ''}</td>
                              <td>${doc.v_DATE || ''}</td>
                              <td>${doc.mrN_NO || ''}</td>
                              <td>${doc.mrN_TYPE || ''}</td>
                              <td>${doc.partyName || ''}</td>
                              <td>${doc.billNo || ''}</td>
                              <td>${doc.billDate || ''}</td>
                              <td>${doc.transportName || ''}</td>
                              <td>${doc.truckNo || ''}</td>
                              <td>${doc.inV_QTY || ''}</td>
                              <td>${doc.recD_QTY || ''}</td>
                              <td>${doc.shorT_QTY || ''}</td>
                              <td>${doc.remarks || ''}</td>
                              <td>${doc.deducT_AMT || ''}</td>
                              <td>${doc.deducT_NARR || ''}</td>
                              <td>${doc.puR_TYPE || ''}</td>
                              <td>${doc.wastE_WGT || ''}</td>

                              <td class="action-col">

                                  <button class="act-btn edit btn-edit"
                                          title="Edit"
                                          style="cursor:pointer;"
                                          data-vtype="${doc.v_TYPE}"
                                          data-vno="${doc.v_NO}"
                                          onclick="editEntry(this)">
                                      <i class="fa fa-edit"></i>
                                  </button>

                                  <button class="act-btn view btn-view"
                                              title="View"
                                            style="cursor:pointer;"
                                            data-vtype="${doc.v_TYPE}"
                                            data-vno="${doc.v_NO}"
                                              onclick="viewEntry(this)">
                                          <i class="fa fa-eye"></i>
                                    </button>


                                  <button class="act-btn delete btn-delete"
                                          title="Delete"
                                          style="cursor:pointer;"
                                          data-vtype="${doc.v_TYPE}"
                                          data-vno="${doc.v_NO}"
                                          onclick="deleteDocStage(this)">
                                      <i class="fa fa-trash"></i>
                                  </button>

                              </td>
                          </tr>
                      `);

                  });
              }
          });

          // Initial Load
          qcPagination.load();

          // Search
          $('#searchBox').on('keyup', function () {
              qcPagination.load();
          });

          // Page Size Change
          $('#pageSizeSelect').on('change', function () {

              qcPagination.setPageSize(
                  parseInt($(this).val())
              );

              qcPagination.load();
          });

      });

      // Edit
      function editEntry(el) {
          const vType = $(el).data("vtype");
          const vNo = $(el).data("vno");
          window.location.href = `/IncommingQCRM/Index?vType=${encodeURIComponent(vType)}&vNo=${encodeURIComponent(vNo)}`;
      }

  
    function viewEntry(el) {
    const vType = $(el).data("vtype");
    const vNo = $(el).data("vno");
        window.location.href = `/IncommingQCRM/Index?vType=${encodeURIComponent(vType)}&vNo=${encodeURIComponent(vNo)}&mode=view`;
      }


      // Delete
      function deleteDocStage(el) {

          const vType = $(el).data("vtype");
          const vNo = $(el).data("vno");

          Swal.fire({
              title: 'Are you sure?',
              text: "This record will be permanently deleted!",
              icon: 'warning',
              showCancelButton: true,
              confirmButtonColor: '#d33',
              cancelButtonColor: '#3085d6',
              confirmButtonText: 'Yes, Delete'
          }).then((result) => {

              if (result.isConfirmed) {

                  $.ajax({
                      url: '/IncommingQCRMList/Delete',
                      type: 'POST',
                      data: {
                          vNo: vNo,
                          docType: vType
                      },

                      success: function (response) {

                          if (response.status) {

                              toastr.success(response.message);

                              if (qcPagination) {
                                  qcPagination.load();
                              }

                          } else {

                              toastr.error(response.message);
                          }
                      },

                      error: function () {

                          toastr.error('Error while deleting record.');
                      }
                  });
              }
          });
      }

</script>

