@{
    ViewBag.Title = "Incomming QC RM List";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<div id="erp-toast-container"></div>
<!-- HEADER -->
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>Incomming QC RM List</span>
    </div>
    <div class="erppagelist-header-right">
        <button class="erppage-header-back" onclick="location.href='@Url.Action("Index", "IncommingQCRM")'">
            <i class="fa fa-plus"></i>Add New
        </button>
    </div>
</div>
<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" id="searchBox" placeholder="Search by All Columns Name...." />
    </div>
    <div class="erppagelist-actions">
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" onclick="printCityMasterReport()">
            <i class="fa fa-print"></i> Print
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Export to Excel">
            <i class="fa fa-file-excel"></i> Export
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail">
            <i class="fa fa-envelope"></i>Mail
        </button>
        <button class="erppagelist-btn erppagelist-btn-approve tooltip-btn" data-tooltip="Approve Records">
            <i class="fa fa-check-circle"></i>Approved
        </button>
    </div>
</div>
<div class="erppagelist-container">
    <div class="excel-wrapper fixed-grid-wrapper">
        <table id="tblIncommingQCRMList" class="excel-table fixed-grid-table resizable-table sortable-table">
            <colgroup>
                <col style="display:none;" /> 
                <col style="width:120px;" />  
                <col style="width:150px;" />  
                <col style="width:120px;" />  
                <col style="width:120px;" />  
                <col style="width:120px;" />  
                <col style="width:120px;" />  
                <col style="width:120px;" />  
                <col style="width:80px;" />   
                <col style="width:120px;" />  
                <col style="width:180px;" />  
                <col style="width:120px;" />  
                <col style="width:120px;" />  
                <col style="width:150px;" />  
                <col style="width:120px;" />  
                <col style="width:140px;" />  
                <col style="width:140px;" />  
                <col style="width:140px;" />  
                <col style="width:180px;" />  
                <col style="width:140px;" />  
                <col style="width:180px;" />  
                <col style="width:120px;" />  
                <col style="width:120px;" />  
                <col style="width:120px;" />  
            </colgroup>
            <thead>
                <tr>
                    <th class="hidden-col" data-column="0">
                        Code <span class="sort-icon"></span>
                    </th>
                    <th data-column="1">
                        Doc Type <span class="sort-icon"></span>
                    </th>
                    @* <th data-column="2">
                        Name <span class="sort-icon"></span>
                    </th> *@
                    <th data-column="3">
                        Doc No <span class="sort-icon"></span>
                    </th>
                    <th data-column="4">
                        Doc Date <span class="sort-icon"></span>
                    </th>
                    <th data-column="5">
                        Mrn No <span class="sort-icon"></span>
                    </th>
                    <th data-column="6">
                        Mrn Type <span class="sort-icon"></span>
                    </th>
                    @* <th data-column="7">
                        Mrn Date <span class="sort-icon"></span>
                    </th> *@
                    @* <th data-column="8">
                        Bales <span class="sort-icon"></span>
                    </th> *@
                    @* <th data-column="9">
                        Party Code <span class="sort-icon"></span>
                    </th> *@
                    <th data-column="10">
                        Party Name <span class="sort-icon"></span>
                    </th>
                    <th data-column="11">
                        Bill No <span class="sort-icon"></span>
                    </th>
                    <th data-column="12">
                        Bill Date <span class="sort-icon"></span>
                    </th>
                    <th data-column="13">
                        Transport <span class="sort-icon"></span>
                    </th>
                    <th data-column="14">
                        Truck No <span class="sort-icon"></span>
                    </th>
                    <th data-column="15">
                        Invoice Quantity <span class="sort-icon"></span>
                    </th>
                    <th data-column="16">
                        Received Quantity <span class="sort-icon"></span>
                    </th>
                    <th data-column="17">
                        Short Quantity <span class="sort-icon"></span>
                    </th>
                    <th data-column="18">
                        Remarks <span class="sort-icon"></span>
                    </th>
                    <th data-column="19">
                        Deduction Amount <span class="sort-icon"></span>
                    </th>
                    <th data-column="20">
                        Deduction Narration <span class="sort-icon"></span>
                    </th>
                    <th data-column="21">
                        Pur_Type <span class="sort-icon"></span>
                    </th>
                    <th data-column="22">
                        Waste Weight <span class="sort-icon"></span>
                    </th>
                    <th class="action-col">
                        Action
                    </th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div class="erppagelist-pagination">
        <div class="pagination-left">
            <select id="pageSizeSelect" onchange="changeRowsPerPage()">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="pagination-center">
            <button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
            <div id="pageNumbers" class="page-numbers"></div>

            <button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
        </div>
        <div class="pagination-right" id="pageInfoText">
            Results: 0 - 0 of 0
        </div>
    </div>
</div>

<script>
    let currentPage = 1;
    let pageSize = 10;

    $(document).ready(function () {
        loadIncommingQCList();

        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadIncommingQCList();
        });
    });

    function loadIncommingQCList() {
        const searchTerm = $('#searchBox').val();
        $.ajax({
            url: '/IncommingQCRMList/GetQCIncommingQCEntryList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                console.log(res);
                const docs = res.items || [];
                const totalCount = res.totalCount || 0;
                const tbody = $('#tblIncommingQCRMList tbody');
                tbody.empty();
                if (docs.length === 0) {
                    tbody.append(`<tr><td colspan="22" class="text-center text-muted">No records found.</td></tr>`);
                    renderPagination(0, pageSize, currentPage);
                    return;
                }
                docs.forEach(doc => {
                    tbody.append(`
                        <tr>
                            <td style="display:none;">${doc.searchCode || ''}</td>
                            <td>${doc.v_TYPE || ''}</td>
                            <td>${doc.docTypeName || ''}</td>
                            <td>${doc.v_NO || ''}</td>
                            <td>${doc.v_DATE || ''}</td>
                            <td>${doc.mrN_NO || ''}</td>
                            <td>${doc.mrN_TYPE || ''}</td>
                            <td>${doc.mrnDate || ''}</td>
                            <td>${doc.bales || ''}</td>
                            <td>${doc.partY_CODE || ''}</td>
                            <td>${doc.partyName || ''}</td>
                            <td>${doc.billNo || ''}</td>
                            <td>${doc.billDate || ''}</td>
                            <td>${doc.transportName || ''}</td>
                            <td>${doc.truckNo || ''}</td>
                            <td>${doc.inV_QTY || ''}</td>
                            <td>${doc.recD_QTY || ''}</td>
                            <td>${doc.shorT_QTY || ''}</td>
                            <td>${doc.remarks || ''}</td>
                            <td>${doc.deducT_AMT || ''}</td>
                            <td>${doc.deducT_NARR || ''}</td>
                            <td>${doc.puR_TYPE || ''}</td>
                            <td>${doc.wastE_WGT || ''}</td>
                            <td class="action-col">
                                <div class="action-icons">
                                    <i class="fa fa-edit btn-edit"
                                        data-vtype="${doc.v_TYPE}"
                                        data-vno="${doc.v_NO}"
                                        onclick="editEntry(this)">
                                    </i>
                                    <i class="fa fa-eye btn-view"
                                        onclick="viewEntry('${doc.searchCode}')">
                                    </i>
                                    <i class="fa fa-trash btn-delete"
                                        onclick="deleteDocStage('${doc.searchCode}')">
                                    </i>
                                </div>
                            </td>
                        </tr>
                    `);
                });
                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                toastr.error('Error loading data: ' + (xhr.responseJSON?.message || xhr.statusText));
            }
        });
    }
    function editEntry(el) {
        const vType = $(el).data("vtype");
        const vNo = $(el).data("vno");
        window.location.href = `/IncommingQCRM/Index?vType=${encodeURIComponent(vType)}&vNo=${encodeURIComponent(vNo)}`;
    }
    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const pagination = $('#tablePagination');
        pagination.empty();
        if (totalPages <= 1) return;
        let html = '';
        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        const startPage = Math.max(1, currentPage - 2);
        const endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
            html += `
                <button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1"
                        onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        pagination.html(html);
    }
    function goToPage(page) {
        currentPage = page;
        loadIncommingQCRMList();
    }
    function viewEntry(docCode) {
        window.location.href = `/IncommingQC/Index?docCode=${encodeURIComponent(docCode)}&readOnly=true`;
    }
    function deleteDocStage(docCode) {
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this deletion!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/IncommingQC/DeleteDocByCode',
                    type: 'POST',
                    data: { docCode: docCode },
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message || "Record deleted successfully.");
                            loadIncommingQCRMList();
                        } else {
                            toastr.warning("Delete failed.");
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while deleting.");
                    }
                });
            }
        });
    }
</script>
