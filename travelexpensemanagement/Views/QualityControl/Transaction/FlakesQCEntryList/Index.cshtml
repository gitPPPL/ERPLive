@{
    ViewBag.Title = "Flakes QC Entry List";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<div id="erp-center-toast-container"></div>
<!-- HEADER -->
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>Flakes QC Entry List</span>
    </div>
    <div class="erppagelist-header-right">
        <button class="erppage-header-back" onclick="location.href='@Url.Action("Index", "FlakesQCEntry")'">
            <i class="fa fa-plus"></i>Add New
        </button>
    </div>
</div>
<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" id="searchBox" placeholder="Search by All Columns Name...." />
    </div>
    <div class="erppagelist-actions">
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" onclick="printCityMasterReport()">
            <i class="fa fa-print"></i>Print
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Export to Excel">
            <i class="fa fa-file-excel"></i>Export
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail">
            <i class="fa fa-envelope"></i>Mail
        </button>
        <button class="erppagelist-btn erppagelist-btn-approve tooltip-btn" data-tooltip="Approve Records">
            <i class="fa fa-check-circle"></i>Approved
        </button>
    </div>
</div>
<div class="erppagelist-container">
    <div class="excel-wrapper fixed-grid-wrapper">
        <table id="tblFlakesQCList" class="excel-table fixed-grid-table">
            <colgroup>
                <col style="display:none;" />   <!-- Code -->
                <col style="width:140px;" />    <!-- Voucher No -->
                <col style="width:140px;" />    <!-- Voucher Type -->
                <col style="width:150px;" />    <!-- Voucher Date -->
                <col style="width:150px;" />    <!-- Employee -->
                <col style="width:150px;" />    <!-- Place -->
                <col style="width:100px;" />    <!-- Shift -->
                <col style="width:200px;" />    <!-- Remarks -->
                <col style="width:120px;" />    <!-- Action -->
            </colgroup>
            <thead>
                <tr>
                    <th style="display:none;">Code</th>
                    <th>Voucher No</th>
                    <th>Voucher Type</th>
                    <th>Voucher Date</th>
                    <th>Employee</th>
                    <th>Place</th>
                    <th>Shift</th>
                    <th>Remarks</th>
                    <th class="action-col">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>

    </div>

    <div class="erppagelist-pagination">
        <div class="pagination-left">
            <select id="pageSizeSelect" onchange="changeRowsPerPage()">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="pagination-center">
            <button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
            <div id="pageNumbers" class="page-numbers"></div>

            <button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
        </div>
        <div class="pagination-right" id="pageInfoText">
            Results: 0 - 0 of 0
        </div>
    </div>
</div>


<script>
    let currentPage = 1;
    let pageSize = 10;

    $(document).ready(function () {
        loadAllMenus();
    });

    function loadAllMenus() {
        const searchTerm = $('#searchBox').val();
        $.ajax({
            url: '/FlakesQCEntryList/GetList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                if (!res.success) {
                    toastr.error("Failed to load data.");
                    return;
                }
                const list = res.lists;
                const totalCount = res.totalCount;
                let tbody = $('#tblFlakesQCList tbody');
                tbody.empty();
                if (list.length === 0) {
                    tbody.append('<tr><td colspan="11" class="text-center text-muted">No list found.</td></tr>');
                } else {
                    $.each(list, function (index, item) {
                        tbody.append(`
                            <tr>
                                <td>${item.header.v_NO}</td>
                                <td>${item.header.v_TYPE}</td>
                                <td>${formatDate(item.header.v_DATE)}</td>
                                <td>${item.header.enmpName}</td>
                                <td>${item.header.place || ''}</td>
                                <td>${item.header.shift}</td>
                                <td>${item.header.remarks}</td>
                                <td>
                                    <button class="btn btn-sm btn-light" onclick="AddOrEditFunction('${item.header.v_NO}')">
                                        <i class="fas fa-edit" title="Edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-light" onclick="viewMenuDetails('${item.header.v_NO}')">
                                        <i class="fas fa-eye" title="View Detail"></i>
                                    </button>
                                    <button class="btn btn-sm btn-light btn-delete" onclick="deleteTemp('${item.header.v_NO}')">
                                        <i class="fas fa-trash text-danger" title="Delete"></i>
                                    </button>
                                </td>
                            </tr>
                        `);
                    });
                    renderPagination(totalCount, pageSize, currentPage);
                }
            },
            error: function (xhr) {
                toastr.error('Error loading menu list: ' + xhr.responseText);
            }
        });
    }

    function formatDate(dateStr) {
            if (!dateStr) return null;
            const date = new Date(dateStr);
            if (isNaN(date)) return null;
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${day}-${month}-${year}`;
        }

    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const pagination = $('#tablePagination');
        pagination.empty();

        if (totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        const startPage = Math.max(1, currentPage - 2);
        const endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
            html += `
                <button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        pagination.html(html);
    }

    function goToPage(page) {
        currentPage = page;
        loadDocumentStages();
    }

    function AddOrEditFunction(code) {
        window.location.href = '/FlakesQCEntry/Index?id=' + encodeURIComponent(code);
    }

    function viewMenuDetails(code) {
        window.location.href = '/FlakesQCEntry/Index?id=' + encodeURIComponent(code) + '&mode=view';
    }

    function deleteTemp(code) {
        if (!confirm('Are you sure you want to delete this Flakes QC Entry?')) return;
        $.ajax({
            url: '/FlakesQCEntryList/Delete',
            type: 'POST',
            data: { code: code },
            success: function (res) {
                if (res.success) {
                    toastr.success('Deleted successfully.');
                    loadAllMenus();
                } else {
                    toastr.error(res.message || 'Failed to delete.');
                }
            },
            error: function () {
                toastr.error('Error deleting Purchase Request .');
            }
        });
    }

</script>
