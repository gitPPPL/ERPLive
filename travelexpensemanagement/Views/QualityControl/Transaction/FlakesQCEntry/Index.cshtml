                    </div>
                    <div class="pagination-right" id="pageInfoText">
                        Results: 0 - 0 of 0
                    </div>
                </div> *@
            </div>
        </fieldset>
        <div class="erppage-actions">
            <button id="btn-saves" type="submit" class="erppage-btn erppage-btn-save">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>
        </div>
        @* Modal Popup *@
        <div class="modal fade" id="CopyFromModal" tabindex="-1" aria-labelledby="CopyFromLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg erppagesmodal">
                <div class="modal-content erppagesmodal-content">
                    <div class="erppagesmodal-header">
                        <div class="erppagesmodal-header-left">
                            <div class="erppagesmodal-header-icon"><i class="fa fa-copy"></i></div>
                            <h5 class="erppagesmodal-title" id="CopyFromLabel">Copy From</h5>
                        </div>
                        <button type="button" class="erppagesmodal-close" data-bs-dismiss="modal">
                            <i class="fa fa-times"></i>
                        </button>
                    </div>
                    <div class="erppagesmodal-body">
                        <div class="erppagesrow erppagesmodal-topbar">
                            <div class="erppagescol-4">
                                <div class="erppagesmodal-group">
                                    <input type="text" id="searchBoxCF" class="erppagesmodal-input" placeholder="Search Module..." />
                                </div>
                            </div>
                            <div class="erppagescol-4 erppagesmodal-checkbox-col">
                                <div class="erppagesmodal-checkbox-wrap">
                                    <input type="checkbox" id="chkAppendFYModal">
                                    <label for="chkAppendFYModal">Append</label>
                                </div>
                            </div>
                            <div class="erppagescol-4">
                                <div class="erppagesmodal-action">
                                    <button type="button" class="erppagesmodal-btn" id="CopyData">
                                        <i class="fa fa-copy"></i> Copy
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="erppagelist-container">
                            <div class="excel-wrapper fixed-grid-wrapper">
                                <table id="tblCopyFrommodal" class="excel-table fixed-grid-table">
                                    <thead>
                                        <tr>
                                            <th><input type="checkbox" id="selectAllPR" /></th>
                                            <th>Bag No</th>
                                            <th class="col-item-name">Item Name</th>
                                            <th>Prod Place</th>
                                            <th>Lot No</th>
                                            <th>WB Quantity</th>
                                            <th>Gross Quantity</th>
                                            <th>Tare Quantity</th>
                                            <th>Quantity</th>
                                            <th>Voucher Type</th>
                                            <th>Voucher No</th>
                                            <th hidden>Item Code</th>
                                            <th hidden>Dept code</th>
                                            <th hidden>Dept</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/erpjs/qualitycontrol/flakesqcentry/flakesqcentry.init.js"></script>
