    function CheckConditionCpyFrm(DeptCode, Shifttype, v_date) {
        const formattedDate = new Date(v_date).toISOString().split('T')[0];
        $.ajax({
            type: 'GET',
            url: '/FlakesQCEntryList/CheackConditionCpyFrm',
            data: {
                DeptCode: DeptCode,
                Shifttype: Shifttype,
                v_date: formattedDate
            },
            success: function(data) { 
               
                console.log("data",data);
                
                if (data.success == true) {
                    $('#CopyFromModal').modal('show');
                      $('#tblCopyFrommodal tbody').empty();
                       fetchData(DeptCode,Shifttype,v_date);
                } else if (data.success == false) {
                    toastr.info("No Bags are Pending for QC of Date: " + v_date + ", Shift: " + Shifttype);
                }
            },
            error: function(xhr, status, error) {
                console.error("Request failed:", error);
            }
        });
    }
    
