@{
    ViewBag.Title = "Flakes QC Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var logindate = Convert.ToDateTime(TempData["LoginDate"]).ToString("yyyy-MM-dd");
    var PubUserLevel = Convert.ToInt32(TempData["PubUserLevel"]);

}

<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa-solid fa-cubes"></i>
        </div>
        <div class="erppage-header-title">Flakes QC Entry</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "FlakesQCEntryList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="FlakesQCEntryForm">
    <input type="hidden" class="form-control" id="TxtCode" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Document No</label>
                    <input type="number" class="erppage-redinput" id="NumDocNo" placeholder="Enter Doc No" readonly>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-redinput" id="DtDocDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Shift</label>
                    <select class="erppage-input erppage-required" id="ddlShift">                 
                        <option value="A"> A </option>
                        <option value="B"> B </option>
                        <option value="C"> C </option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Time</label>
                    <input type="time" class="erppage-redinput" id="DtTime" />
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">QC Incharge</label>
                    <select class="erppage-input erppage-required" id="ddlQCIncharge">
                        <option value="">Select QC Incharge</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Chemist</label>
                    <select class="erppage-input erppage-required" id="ddlChemist">
                        <option value="">Select Chemist</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Insp. By</label>
                    <select class="erppage-input erppage-select" id="ddlInspBy">
                        <option value="">Select Insp. By</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Prod. Place</label>
                    <select class="erppage-input erppage-required" id="ddlProdPlace">
                        <option value="">Select Prod. Place</option>
                    </select>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Remarks</label>
                    <textarea typeof="text" class="erppage-textarea" id="TxtRemarks" placeholder="Enter Remarks"></textarea>
                </div>
                <div class="erppagelist-toolbar-end" style="margin: 0px; padding: 0px;justify-content: flex-start;">
                    <div class="erppage-internalaction" style="margin: 0;">
                        <button type="button" id="btn_Copy" class="erppage-btn erppage-btn-common">
                            <i class="fa fa-copy"></i>
                            <span>Copy From</span>
                        </button>
                    </div>
                </div>
            </div>
            @* <fieldset class="erppage-subfieldset">
                <legend>Print Details</legend>
                <div class="erppage-subheader">Print Details</div>
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label">From Date</label>
                        <input type="date" class="erppage-input" id="DtFrom">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">To Date</label>
                        <input type="date" class="erppage-input" id="DtTo">
                    </div>
                    <div class="erppage-divfield erppage-col-span-2">
                        <label class="erppage-label">Item Name</label>
                        <select class="erppage-redinput erppage-required" id="ddlItem">
                            <option value="">Select Item Name</option>
                        </select>
                        <div class="erppagesmodal-checkbox-wrap">
                            <input type="checkbox" id="chkFullName">
                            <label>Full Name</label>
                        </div>
                    </div>
                </div>
                <div class="erppagelist-toolbar-end" style="margin: 0px; padding: 0px;">
                    <div class="erppage-internalaction" style="margin: 0;">
                        <button type="button" id="btn_summary" class="erppage-btn erppage-btn-print">
                            <i class="fa fa-print"></i>
                            <span>Summary</span>
                        </button>
                        <button type="button" id="btn_detail" class="erppage-btn erppage-btn-print">
                            <i class="fa fa-print"></i>
                            <span>Detail</span>
                        </button>
                    </div>
                </div>
            </fieldset> *@
            <div class="erppagelist-container">
                <div class="excel-wrapper fixed-grid-wrapper">
                    <table id="tblFlakesQCEntry" class="excel-table fixed-grid-table">
                        <colgroup>
                            <col style="display:none;">  <!-- Code -->
                            <col style="width:80px;">   <!-- Item Code -->
                            <col style="width:350px;">   <!-- Item Name -->
                            <col style="width:200px;">   <!-- Dept -->
                            <col style="width:140px;">   <!-- Batch No -->
                            <col style="width:120px;">   <!-- Bag No -->
                            <col style="width:100px;">   <!-- WB. Wt. -->
                            <col style="width:100px;">   <!-- Gr. Wt. -->
                            <col style="width:100px;">   <!-- Tr. Wt. -->
                            <col style="width:100px;">   <!-- Net Wt. -->
                            <col style="width:100px;">   <!-- HDPE -->
                            <col style="width:120px;">   <!-- PVC/PPM -->
                            <col style="width:130px;">   <!-- PC/Low Melt -->
                            <col style="width:100px;">   <!-- Wrapper -->
                            <col style="width:100px;">   <!-- Metal -->
                            <col style="width:100px;">   <!-- Stone -->
                            <col style="width:100px;">   <!-- Rubber -->
                            <col style="width:100px;">   <!-- Glue -->
                            <col style="width:100px;">   <!-- Other -->
                            <col style="width:100px;">   <!-- Total -->
                            <col style="width:80px;">    <!-- Grd -->
                            <col style="width:100px;">   <!-- Yellow % -->
                            <col style="width:100px;">   <!-- Blue % -->
                            <col style="width:100px;">   <!-- Other % -->
                            <col style="width:120px;">   <!-- Color Mix -->
                            <col style="width:130px;">   <!-- Yellow 160C -->
                            <col style="width:120px;">   <!-- Moisture -->
                            <col style="width:140px;">   <!-- Bulk Density -->
                            <col style="width:80px;">    <!-- PH -->
                            <col style="width:120px;">   <!-- Over Sized -->
                            <col style="width:200px;">   <!-- Remarks -->
                            <col style="display:none;">  <!-- Ref Type -->
                            <col style="display:none;">  <!-- Ref No -->
                            <col style="display:none;">  <!-- DeptCode -->
                        </colgroup>
                        <thead class="table-head">
                            <tr>
                                <th style="display:none;">Code</th>
                                <th>Item Code</th>
                                <th>Item Name</th>
                                <th>Dept</th>
                                <th>Batch No</th>
                                <th>Bag No</th>
                                <th>WB. Wt.</th>
                                <th>Gr. Wt.</th>
                                <th>Tr. Wt.</th>
                                <th>Net Wt.</th>
                                <th>HDPE</th>
                                <th>PVC/PPM</th>
                                <th>PC/Low Melt</th>
                                <th>Wrapper</th>
                                <th>Metal</th>
                                <th>Stone</th>
                                <th>Rubber</th>
                                <th>Glue</th>
                                <th>Other</th>
                                <th>Total</th>
                                <th>Grd</th>
                                <th>Yellow %</th>
                                <th>Blue %</th>
                                <th>Other %</th>
                                <th>Color Mix</th>
                                <th>Yellow 160C</th>
                                <th>Moisture</th>
                                <th>Bulk Density</th>
                                <th>PH</th>
                                <th>Over Sized</th>
                                <th>Remarks</th>
                                <th style="display:none;">Ref Type</th>
                                <th style="display:none;">Ref No</th>
                                <th style="display:none;">DeptCode</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
               @*  <div class="erppagelist-pagination">
                    <div class="pagination-left">
                        <select id="pageSizeSelect" onchange="changeRowsPerPage()">
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
