@{
	ViewBag.Title = "Sample QC List";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
	<legend class="legend-field">Sample QC List</legend>
	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>
		<div class="col-lg-6">
			<div class="btn-rightalign">
				<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "SampleQC")'" type="submit" class="btn btn-add">
					<i class="fa fa-plus"></i>Add
				</button>
				<button class="btn btn-print" onclick="printCityMasterReport()">
					<i class="fa fa-print"></i> Print
				</button>
				<button class="btn btn-export">
					<i class="fas fa-file-export"></i> Export
				</button>
				<button class="btn btn-mail">
					<i class="fa fa-envelope"></i> Mail
				</button>
				<button class="btn btn-approved">
					<i class="fa fa-check"></i> Approved
				</button>
			</div>
		</div>
	</div>
	<div class="card">
		<div class="table-responsive">
			<table id="tblSampleQCList" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>Doc Type</th>
						<th>Doc No</th>
						<th>QC Incharge</th>
						<th>Chem.</th>
						<th>Party Name</th>
						<th>QC Code</th>
						<th>Party Sample Code</th>
						<th>Received Qty(in gm)</th>
						<th>Add L1</th>
						<th>Sample Received By</th>
						<th>Scrap No</th>
						<th>Item Name</th>
						<th>Remarks</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
	</div>
</fieldset>
<script>
	//
     
    
    const jsQcSampleEntryList = {

        currentPage :1,
        pageSize : 10,

        //Load main grid...............
         loadDocumentData : function() {
            const searchTerm = $('#searchBox').val();

            $.ajax({
                url: '/SampleQCList/GetQCTemperatureEntryList',
                type: 'GET',
                dataType: 'json',
                data: {
                    searchTerm,
                    pageNumber: jsQcSampleEntryList.currentPage,
                    pageSize: jsQcSampleEntryList.pageSize
                },
                success: function (res) {
                    console.log(res);
                    const docs = res.items || res.data || [];
                    const totalCount = res.totalCount || 0;

                    const tbody = $('#tblSampleQCList tbody');
                    tbody.empty();

                    if (docs.length === 0) {
                        tbody.append(`<tr><td colspan="5" class="text-center text-muted">No records found.</td></tr>`);
                        jsQcSampleEntryList.renderPagination(0, this.pageSize, this.currentPage);
                        return;
                    }
                    debugger;
                    docs.forEach(doc => {
                        tbody.append(`
                            <tr>
                                <td style="display:none;">${doc.vno || doc.vno || ''}</td>
                                <td>${doc.docTypeName || ''}</td>                  
                                <td>${doc.v_NO || ''}</td>                                  
                                <td>${doc.qC_INCHARGENAME || ''}</td>                      
                                <td>${doc.chemistname || ''}</td>                           
                                <td>${doc.partyName || ''}</td>                             
                                <td>${doc.searchCode || ''}</td>                            
                                <td>${doc.mrN_NO || ''}</td>                                
                                <td>${doc.recD_QTY ?? ''}</td>                            
                                <td>${doc.transportName || ''}</td>                         
                                <td>${doc.samplE_RECDBY || ''}</td>                         
                                <td>${doc.truckNo || ''}</td>                              
                                <td>${doc.containeR_NO || ''}</td>                         
                                <td>${doc.remarks || ''}</td>
                                <td>
                                  <div class="action-icons">
                                  <i class="fa fa-edit btn-edit" data-bs-toggle="tooltip" title="Edit" onclick="jsQcSampleEntryList.editDocStage('${doc.v_NO}')"></i>
                                  <i class="fa fa-eye btn-view" data-bs-toggle="tooltip" title="View" onclick="jsQcSampleEntryList.viewDocStage('${doc.v_NO}')"></i>
                                  <i class="fa fa-trash btn-delete" data-bs-toggle="tooltip" title="Delete" onclick="jsQcSampleEntryList.deleteDocStage('${doc.v_NO}')"></i>
                                  <i class="fa fa-file btn-document" data-bs-toggle="tooltip" data-bs-title="Document Details" onclick="jsQcSampleEntryList.showDocumentPopup('${doc.v_NO}')"></i>
                                  </div>

                                </td>
                            </tr>
                        `);
                    });

                    jsQcSampleEntryList.renderPagination(totalCount, jsQcSampleEntryList.pageSize, jsQcSampleEntryList.currentPage);
                },
                error: function (xhr) {
                    toastr.error('Error loading document stages: ' + (xhr.responseJSON?.message || xhr.statusText));
                }
            });
        },

        renderPagination : function(total, pageSize, currentPage) {
            const totalPages = Math.ceil(total / pageSize);
            const pagination = $('#tablePagination');
            pagination.empty();

            if (totalPages <= 1) return;

            let html = '';

            if (currentPage > 1) {
                html += `<button class="btn btn-sm btn-light mx-1" onclick="jsQcSampleEntryList.goToPage(1)">First</button>`;
                html += `<button class="btn btn-sm btn-light mx-1" onclick="jsQcSampleEntryList.goToPage(${currentPage - 1})">Prev</button>`;
            }

            const startPage = Math.max(1, currentPage - 2);
            const endPage = Math.min(totalPages, currentPage + 2);

            for (let i = startPage; i <= endPage; i++) {
                html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="jsQcSampleEntryList.goToPage(${i})">${i}</button>`;
            }

            if (currentPage < totalPages) {
                html += `<button class="btn btn-sm btn-light mx-1" onclick="jsQcSampleEntryList.goToPage(${currentPage + 1})">Next</button>`;
                html += `<button class="btn btn-sm btn-light mx-1" onclick="jsQcSampleEntryList.goToPage(${totalPages})">Last</button>`;
            }

            pagination.html(html);
        },

        goToPage : function(page) {
            this.currentPage = page;
            this.loadDocumentData();
        },

        editDocStage : function (docCode) {
            window.location.href = `/SampleQC/Index?id=${encodeURIComponent(docCode)}`;
        },

        viewDocStage : function (docCode) {
            window.location.href = `/SampleQC/Index?id=${encodeURIComponent(docCode)}&readOnly=true`;
        },

        deleteDocStage : function (docNo) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this deletion!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/SampleQCList/DeleteDocByCode',
                        type: 'POST',
                        data: { DocNo: docNo },
                        success: function (response) {
                            if (response.success) {
                                toastr.success(response.message || "Record deleted successfully.");
                                jsQcSampleEntryList.loadDocumentData();
                            } else {
                                toastr.warning("Delete failed."+ response.message);
                            }
                        },
                        error: function () {
                            toastr.error("An error occurred while deleting.");
                        }
                    });
                }
            });
        }

    };


    $(document).ready(function () {
        debugger;
        jsQcSampleEntryList.loadDocumentData();
        $('#searchBox').on('keyup', function () {
            jsQcSampleEntryList.currentPage = 1;
            jsQcSampleEntryList.loadDocumentData();
        });

    });


</script>
