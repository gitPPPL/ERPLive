@{
	ViewBag.Title = "EremaBag QC Entry List";
	Layout = "~/Views/Shared/_Layout.cshtml";

}
<fieldset>
	<legend class="legend-field">EremaBag QC Entry List</legend>
	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>
		<div class="col-lg-6">
			<div class="btn-rightalign">
				<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "EremaBagQCEntry")'" type="submit" class="btn btn-add">
					<i class="fa fa-plus"></i>Add
				</button>
				<button class="btn btn-print" onclick="printCityMasterReport()">
					<i class="fa fa-print"></i> Print
				</button>
				<button class="btn btn-export">
					<i class="fas fa-file-export"></i> Export
				</button>
				<button class="btn btn-mail">
					<i class="fa fa-envelope"></i> Mail
				</button>
				<button class="btn btn-approved">
					<i class="fa fa-check"></i> Approved
				</button>
			</div>
		</div>
	</div>
	<div class="card">
		<div class="table-responsive">
			<table id="tblEremaBagQCEntryList" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>Vno</th>
						<th>Vtype</th>
						<th>Vdate</th>
						<th>Employee</th>
						<th>Place</th>
						<th>Shift</th>
						<th>Remarks</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
	</div>
</fieldset>
<script>
	let currentPage = 1;
	let pageSize = 10;
		
	$(document).ready(function () {
		loadAllMenus();
	});

	function loadAllMenus() {
		const searchTerm = $('#searchBox').val();
		$.ajax({
			url: '/EremaBagQCEntryList/GetList',
			type: 'GET',
			dataType: 'json',
			data: {
				searchTerm: searchTerm,
				pageNumber: currentPage,
				pageSize: pageSize
			},
			success: function (res) {
				if (!res.success) {
					toastr.error("Failed to load data.");
					return;
				}

				const list = res.lists;
				const totalCount = res.totalCount;

				console.log('list', list);

				let tbody = $('#tblEremaBagQCEntryList tbody');
				tbody.empty();

				if (!list || list.length === 0) {
					tbody.append('<tr><td colspan="11" class="text-center text-muted">No list found.</td></tr>');
				} else {
					$.each(list, function (index, item) {
						const header = item.header || {};

						tbody.append(`
							<tr>
								<td>${header.v_NO || ''}</td>
								<td>${header.v_TYPE || ''}</td>
								<td>${formatDate(header.v_DATE) || '' }</td>
								<td>${header.enmpName || ''}</td>
								<td>${header.place || ''}</td>
								<td>${header.shift || ''}</td>
								<td>${header.remarks || ''}</td>
								<td>
									<button class="btn btn-sm btn-light" onclick="AddOrEditFunction('${header.v_NO}')">
										<i class="fas fa-edit" title="Edit"></i>
									</button>
									<button class="btn btn-sm btn-light" onclick="viewMenuDetails('${header.v_NO}')">
										<i class="fas fa-eye" title="View Detail"></i>
									</button>
									<button class="btn btn-sm btn-light btn-delete" onclick="deleteTemp('${header.v_NO}')">
										<i class="fas fa-trash text-danger" title="Delete"></i>
									</button>
								</td>
							</tr>
						`);
					});
					renderPagination(totalCount, pageSize, currentPage);
				}
			},
			error: function (xhr) {
				toastr.error('Error loading menu list: ' + xhr.responseText);
			}
		});
	}

	function formatDate(dateStr) {
			if (!dateStr) return null;
			const date = new Date(dateStr);
			if (isNaN(date)) return null;
			const year = date.getFullYear();
			const month = String(date.getMonth() + 1).padStart(2, '0');
			const day = String(date.getDate()).padStart(2, '0');

			return `${day}-${month}-${year}`;
		}

	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const pagination = $('#tablePagination');
		pagination.empty();

		if (totalPages <= 1) return;

		let html = '';

		if (currentPage > 1) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		const startPage = Math.max(1, currentPage - 2);
		const endPage = Math.min(totalPages, currentPage + 2);

		for (let i = startPage; i <= endPage; i++) {
			html += `
				<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
		}

		if (currentPage < totalPages) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		pagination.html(html);
	}

	function goToPage(page) {
		currentPage = page;
		loadDocumentStages();
	}

    function AddOrEditFunction(code) {
		window.location.href = '/EremaBagQCEntry/Index?id=' + encodeURIComponent(code);
	}

	function viewMenuDetails(code) {
		window.location.href = '/EremaBagQCEntry/Index?id=' + encodeURIComponent(code) + '&mode=view';
	}

	function deleteTemp(code) {
		if (!confirm('Are you sure you want to delete this EremaBag QC Entry?')) return;
		$.ajax({
			url: '/EremaBagQCEntry/Delete',
			type: 'POST',
			data: { code: code },
			success: function (res) {
				if (res.success) {
					toastr.success('Deleted successfully.');
					loadAllMenus();
				} else {
					toastr.error(res.message || 'Failed to delete.');
				}
			},
			error: function () {
				toastr.error('Error deleting Purchase Request .');
			}
		});
	}

</script>
