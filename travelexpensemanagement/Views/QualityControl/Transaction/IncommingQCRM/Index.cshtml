@{
    ViewBag.Title = "Incomming QC RM";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .col-color-1 {
        background-color: #e8f7e4;
    }
    .col-color-2 {
        background-color: #f0f0f0;
    }
    .readonly-cell {
        display: none !important;
    }
    input[readonly] {
        background-color: #CCC !important;
        cursor: not-allowed;
    }
</style>
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-clipboard-check"></i>
        </div>
        <div class="erppage-header-title">Incomming QC RM</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-btn erppage-btn-danger" data-bs-toggle="modal" data-bs-target="#pendingQCModal" id="btn_PendingQC">
            <i class="fa fa-hourglass-half"></i>
            <span>Pending QC</span>
        </button>
        <button type="button" class="erppage-header-back" onclick="location.href='@Url.Action("Index", "IncommingQCRMList")'">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="PreIncommingQCRMForm">
    <input type="hidden" class="form-control" id="TxtCode" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Type</label>
                    <select class="erppage-input" id="ddlDocType">
                        <option value="">Select Doc Type</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Document No</label>
                    <input type="number" class="erppage-input" id="NumDocNo" placeholder="Enter Doc No">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-input" id="DtDate">
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">MRN No</label>
                    <select class="erppage-input" id="ddlGateNo">
                        <option value="0">Select MRN No</option>
                    </select>
                </div>
                <div class="erppage-divfield erppage-datefield">
                    <label class="erppage-label">MRN Date</label>
                    <div class="erppage-datebox">
                        <input type="date" class="erppage-input erppage-dateinput" id="MRNDate">
                        <label class="erppage-checkbox-inside">
                            <input type="checkbox" id="chkBillDate">
                        </label>
                    </div>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Party Name</label>
                    <input type="text" class="erppage-input" id="TxtPartyName" placeholder="Enter Party Name">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Bill No</label>
                    <input type="text" class="erppage-input" id="NumBillNo" placeholder="Enter Bill No" />
                </div>
                <div class="erppage-divfield erppage-datefield">
                    <label class="erppage-label">Bill Date</label>
                    <div class="erppage-datebox">
                        <input type="date" class="erppage-input erppage-dateinput" id="DtBillDate">
                        <label class="erppage-checkbox-inside">
                            <input type="checkbox" id="chkBillDate">
                        </label>
                    </div>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Truck No</label>
                    <input type="text" class="erppage-input" id="TxtTruckNo" placeholder="Enter Truck No" />
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Container No</label>
                    <input type="text" class="erppage-input" id="TxtContainerNo" placeholder="Enter Container No" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Bales</label>
                    <input type="text" class="erppage-input" id="TxtBales" placeholder="Enter Bales" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Inv. Quantity</label>
                    <input type="text" class="erppage-input" id="TxtInvoiceQty" placeholder="Enter Invoice Qty" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Received Qty</label>
                    <input type="text" class="erppage-input" id="TxtRecordedQty" placeholder="Enter Received Qty" />
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Shortage /Excess</label>
                    <input type="text" class="erppage-input" id="TxtShortage" placeholder="Enter Shortage" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">QC Incharge</label>
                    <select class="erppage-input" id="ddlQCIncharge">
                        <option value="">Select QC Incharge</option>
                    </select>
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Chemist</label>
                    <select class="erppage-input" id="ddlChem">
                        <option value="">Select Chemist</option>
                    </select>
                </div>
            </div>
            <div class="erppage-grid4" style="display:none;">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Transport</label>
                    <input type="text" class="erppage-input" id="TxtTransport" placeholder="Enter Transport">
                </div>
            </div>
           
           
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group" style="display:none;">
                        <label for="TxtInvoiceQty">Invoice Qty</label>
                        <input type="text" class="form-control" id="TxtInvoiceQty" placeholder="Enter Invoice Qty">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group" style="display:none;">
                        <label for="TxtRecordedQty">Recorded Qty</label>
                        <input type="text" class="form-control" id="TxtRecordedQty" placeholder="Enter Recorded Qty">
                    </div>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2" style="display:none;">
                    <label class="erppage-label">Purch Type</label>
                    <input type="text" class="erppage-input" id="TxtPurType" placeholder="Enter PurType" />
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Remarks</label>
                    <input type="text" class="erppage-input" id="TxtRemarks1" placeholder="Enter Remarks" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group" style="display:none;">
                        <label for="TxtWastage">Wastage</label>
                        <input type="text" class="form-control" id="TxtWastage" placeholder="Enter Wastage" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group position-relative" style="display:none;">
                        <label for="DtGateDate">Gate Date</label>
                        <div class="calender-check">
                            <input type="date" class="form-control" id="DtGateDate" style="padding-left: 30px;">
                            <input type="checkbox" id="chkGateDate" class="checkbox-inside">
                        </div>
                    </div>
                </div>
            </div>
            <fieldset class="erppage-fieldset">
                <div class="erppage-section-header">MRN Details</div>
                <div class="erppage-body">
                    <div class="erppage-grid4">

                        <div class="erppage-divfield erppage-col-span-2">
                            <label class="erppage-label">Item Name</label>
                            <select class="erppage-input" id="ddlItemName">
                                <option value="">Select Item Name</option>
                            </select>
                        </div>
                    </div>
                    <div class="erppagelist-container" style="margin:0px;">
                        <div class="excel-wrapper fixed-grid-wrapper">
                            <table id="itemTable" class="excel-table fixed-grid-table">
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="erppage-col-span-2">
                        <div class="erppage-actions" style="margin: 0px;padding: 4px 0px;">
                            <button type="button" class="erppage-btn erppage-btn-save" id="btn_fill">
                                <i class="fa fa-fill"></i>
                                <span>Fill</span>
                            </button>
                            <button type="button" class="erppage-btn erppage-btn-common" id="btn_calculate">
                                <i class="fa fa-calculator"></i>
                                <span>Calculate</span>
                            </button>
                        </div>
                    </div>
                </div>
            </fieldset>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Deduc Amt</label>
                    <input type="number" class="erppage-input" id="NumDeductAmount" placeholder="Enter Deduction Amount" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Narration</label>
                    <input type="text" class="erppage-input" id="TxtNarration" placeholder="Enter Narration" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Remarks1</label>
                    <input type="text" class="erppage-input" id="TxtRemarks" placeholder="Enter Remarks" />
                </div>
                <div class="erppage-internalaction" style="margin:0px;">
                   
                </div>
            </div>
            <!-- Pending QC Modal -->
            <div class="modal fade" id="pendingQCModal" tabindex="-1" aria-labelledby="pendingQCLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content erppagesmodal-content">
                        <div class="erppagesmodal-header">
                            <div class="erppagesmodal-header-left">
                                <div class="erppagesmodal-header-icon">
                                    <i class="fa fa-clipboard-check"></i>
                                </div>
                                <h5 class="erppagesmodal-title" id="pendingQCLabel">
                                    Pending Gate Data for Pre QC
                                </h5>
                            </div>
                            <button type="button" class="erppagesmodal-close" data-bs-dismiss="modal" aria-label="Close">
                                <i class="fa fa-times"></i>
                            </button>
                        </div>
                        <div class="erppagelist-container">
                            <div class="excel-wrapper fixed-grid-wrapper">
                                <table id="tblpendingQC" class="excel-table fixed-grid-table resizable-table">
                                    <colgroup>
                                        <col style="display:none;" />
                                        <col style="width:120px;" />
                                        <col style="width:120px;" />
                                        <col style="width:250px;" />
                                        <col style="width:150px;" />
                                        <col style="width:120px;" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th class="hidden-col">Select</th>
                                            <th>Gate No</th>
                                            <th>Gate Date</th>
                                            <th>Party Name</th>
                                            <th>Vehicle No</th>
                                            <th class="action-col">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
            <div class="erppagelist-container">
                <div class="excel-wrapper fixed-grid-wrapper">
                    <table id="tblPreIncomming" class="excel-table fixed-grid-table resizable-table">
                        <colgroup id="tblPreIncommingColGroup">
                        </colgroup>
                        <thead>
                            <tr id="tblPreIncommingHeader" class="table-head"></tr>
                        </thead>
                        <tbody id="tblPreIncommingBody"></tbody>
                    </table>
                </div>
            </div>
        </fieldset>

        <div class="erppage-actions">
            <button id="btn-save" type="submit" class="erppage-btn erppage-btn-save">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>
        </div>
    </div>
</div>

<script>
         $(document).ready(function () {
           ddlDocType();
           ddlQCIncharge();
           ddlCheme();
           ddlItemName();
           let Headerdata = [];
           let Itemdata = [];
           let ddlGateNoInitialized = false;
           const today = new Date().toISOString().split('T')[0];
           document.getElementById('DtDate').value = today;
              function getQueryParam(param) {
                 const urlParams = new URLSearchParams(window.location.search);
                 return urlParams.get(param);
              }
              // Read values from query string
              const vType = getQueryParam('vType');
              const vNo = getQueryParam('vNo');
               if (vNo) {
                 $.ajax({
                     url: '/IncommingQCRM/GetAllDatadetails',
                     type: 'POST',
                     contentType: 'application/json',
                     data: JSON.stringify({ vNo: vNo, vType: vType }),
                     success: function (response) {
                         const $attachmentTbody = $('#tblAttachmentPRE tbody');
                           GetallDataPreIncommingQCRM(response);
                     },
                     error: function (xhr) {
                             toastr.error('Error: ' + xhr.responseText);
                     }
                 });
             }

            $('#ddlDocType').on('change', function () {
                const selectedValue = $(this).val();
                const selectedText = $(this).find("option:selected").text();
                $('#NumDocNo').prop('readonly', true);

                if (selectedValue !== "") {
                    sendDocType(selectedValue, selectedText);
                } else {
                    $('#NumDocNo').val('');
                }
            });
            $('#ddlGateNo').on('change', function () {
                 alert("ok")
               //   if (!ddlGateNoInitialized) {
               //    ddlGateNoInitialized = true;
               //    return;
               // }
              
               var selectedNo = $(this).val(); // Gets the selected value
               const selectedText = $(this).find('option:selected').text(); 

               if (selectedNo !== "0" && selectedNo !== "") {
                   $.ajax({
                       url: '/IncommingQCRM/GetGatDetailsList',
                       type: 'POST',
                       data: {
                           StrVNo: selectedNo,
                           StrV_type: selectedText
                       },
                       success: function (response) {
                         if (!response.success) {
                          toastr.warning(response.message, "Warning");
                            return;
                          }
                           GetalldatafetchGatonchange(response); // Passes response to a function
                       },
                       error: function (xhr) {
                           console.error("Error:", xhr.responseText);
                       }
                   });
               }
           });
        // ===========================================================================================
           $('#ddlItemName').on('change', function () {
             var selectedNo = $(this).val(); // item code
             var selectedText = $(this).find('option:selected').text(); // item name


             if (selectedNo) {
                 $('#itemTable tbody').append(
                     '<tr class="text-left"><td>' + selectedNo + '</td><td>' + selectedText + '</td></tr>'
                 );
             }
             $(this).val('');
             console.log('Selected Item Code:', selectedNo);
             console.log('Selected Item Name:', selectedText);
         });
           $('#btn_fill').on('click', function () {
        const rows = $('#itemTable tbody tr');
        if (rows.length === 0) {
            alert("No item data found.");
            return;
        }

        let dataToSend;
        let itemsToAdd = []; // define here so it's accessible

        rows.each(function () {
            const itemCode = $(this).find('td:first').text().trim();
            const itemName = $(this).find('td:eq(1)').text().trim();
            itemsToAdd.push({ itemCode: itemCode, itemName: itemName });
        });
        console.log('total column',itemsToAdd)

        if (vNo) {
            // Add columns only if vNo exists
            AddColumnsOnly(itemsToAdd);
        } else {
            // Prepare JSON to send
            dataToSend = JSON.stringify(itemsToAdd);
        }

        if (!vNo) {
            $.ajax({
                url: '/IncommingQCRM/GetItemDetails',
                type: 'POST',
                contentType: 'application/json',
                data: dataToSend,
                success: function (response) {
                    GetalldataClickonFill(response, itemsToAdd);
                },
                error: function (xhr) {
                    console.error('Error:', xhr.responseText);
                }
            });
        }
    });
         function AddColumnsOnly(itemsToAdd) {
        const theadRow = $('#tblPreIncomming thead tr');
        const tbodyRows = $('#tblPreIncomming tbody tr');
        itemsToAdd.forEach(item => {
            // Avoid adding duplicate columns
            if ($('#' + item.itemCode).length === 0) {
                // Add new <th> to header
                theadRow.append(`<th id="${item.itemCode}">${item.itemName}</th>`);

                // Add new <td> to each existing row
                tbodyRows.each(function () {
                    const bgColor = '#d4edda'; // background color
                    $(this).append(`
                        <td style="background-color: ${bgColor};">
                            <input type="text"
                                   class="form-control"
                                   name="Item_${item.itemCode}"
                                   style="background-color: ${bgColor};" />
                        </td>
                    `);
                });
            }
        });
     }
         function GetalldataClickonFill(response, dataToSend) {
             const tbody = $('#tblPreIncomming tbody');
             tbody.empty();
              console.log('response', response)
              console.log('dataToSend', dataToSend)
              debugger
             let itemList = [];

             if (Array.isArray(dataToSend)) {
                 itemList = dataToSend;
             } else if (dataToSend.itemCodes) {
                 itemList = dataToSend.itemCodes.map(code => ({
                     itemCode: code,
                     itemName: code
                 }));
             } else if (dataToSend.itemCode) {
                 itemList = [{
                     itemCode: dataToSend.itemCode,
                     itemName: dataToSend.itemName || dataToSend.itemCode
                 }];
             }

             const hasItems = itemList.length > 0;
             // --- Header HTML ---
             let theadHTML = `
                 <tr class="table-head">
                     <th style="display:none;">Code</th>
                     <th>Qcid</th>
                     <th>Qcpid</th>
                     <th>Parameter</th>
                     <th>Unit</th>
                     <th>Level</th>
                     <th>Allow Amount</th>
                     <th>Deduction Amount</th>
                     <th>Deduction Narration</th>`;

             if (hasItems) {
                 itemList.forEach(item => {
                     theadHTML += `<th id="${item.itemCode}">${item.itemName}</th>`;
                 });
             }

             theadHTML += `</tr>`;

             $('#tblPreIncomming thead').html(theadHTML);

             // if (Array.isArray(response) && response.length > 0) {
             if (Array.isArray(response.data) && response.data.length > 0) {
                 const colorPalette = ['#d4edda', '#fff9c4', '#f28b82', '#f8bbd0', '#ce93d8', '#81d4fa','#ffcc80'];
                 const qcCodeColorMap = {};
                 let qcColorIndex = 0;

                 response.data.forEach((item, index) => {
                     const qcCode = item.qC_CODE;

                     if (!qcCodeColorMap.hasOwnProperty(qcCode)) {
                         qcCodeColorMap[qcCode] = colorPalette[qcColorIndex % colorPalette.length];
                         qcColorIndex++;
                     }
                     const dynamicTDColor = qcCodeColorMap[qcCode];

                     let newRow = `
                         <tr>
                             <td style="display:none;">${item.qC_CODE || ''}</td>
                             <td>${item.qC_CODE || ''}</td>
                             <td>${item.qcP_CODE || ''}</td>
                             <td>${item.parameter || ''}</td>
                             <td>${item.unit || ''}</td>
                             <td>${item.qcP_STD || ''}</td>
                             <td><input type="text" class="form-control" name="AllowAmt" /></td>
                             <td><input type="text" class="form-control" name="DeductAmt" /></td>
                             <td><input type="text" class="form-control" name="DeductNarr" /></td>`;

                     if (hasItems) {
                         itemList.forEach(it => {
                             // Editable if first row or matching item code
                             const isFirstRow = index === 0;
                             const isEditable = isFirstRow || (item.item_Code === it.itemCode);
                             const bgColor = dynamicTDColor;

                             newRow += `
                                 <td style="background-color: ${bgColor};">
                                     <input type="text"
                                            class="form-control"
                                            name="Item_${it.itemCode}"
                                            ${!isEditable ? 'readonly' : ''}
                                            style="background-color: ${bgColor};" />
                                 </td>`;
                         });
                     }

                     newRow += `</tr>`;
                     tbody.append(newRow);
                 });

             } else {
                 const colspan = 9 + (hasItems ? itemList.length : 0);
                 tbody.append(`<tr><td colspan="${colspan}" class="text-center">No data found</td></tr>`);
             }
         }

         $('#btn-save').on('click', function () {
             debugger
             function parseDecimal(val) {
                 val = val.trim();
                 return val === "" ? null : parseFloat(val);
             }
             function parseIntOrNull(val) {
                 val = val.trim();
                 return val === "" ? null : parseInt(val);
             }
             // Step 1: Collect Form Data
             let formData = {
                 docType: $('#ddlDocType').val(),
                 docNo: $('#NumDocNo').val(),
                 date: $('#DtDate').val(),
                 gateNo: $('#ddlGateNo option:selected').text(),
                 qcIncharge: $('#ddlQCIncharge').val(),
                 chem: $('#ddlChem').val(),
                 partyName: $('#TxtPartyName').val(),
                 transport: $('#TxtTransport').val(),
                 truckNo: $('#TxtTruckNo').val(),
                 containerNo: $('#TxtContainerNo').val(),
                 invoiceQty: parseDecimal($('#TxtInvoiceQty').val()),
                 recordedQty: parseDecimal($('#TxtRecordedQty').val()),
                 purType: $('#TxtPurType').val(),
                 shortage: parseDecimal($('#TxtShortage').val()),
                 billNo: parseIntOrNull($('#NumBillNo').val()),
                 billDate: $('#DtBillDate').val(),
                 billDateChecked: $('#chkBillDate').is(':checked'),
                 wastage: parseDecimal($('#TxtWastage').val()),
                 gateDate: $('#DtGateDate').val(),
                 gateDateChecked: $('#chkGateDate').is(':checked'),
                 bales: parseIntOrNull($('#TxtBales').val()),
                 remarks: $('#TxtRemarks').val(),
                 MRNDate: $('#MRNDate').val(),
                 DeductAmount: $('#NumDeductAmount').val(),
                 Narration: $('#TxtNarration').val(),
                 ACTION: vNo > 0 ? "UPDATE" : "INSERT",
             };
             debugger
             // Step 3: Collect Table Data
             let preIncomingData = [];
             let combinedItems = {};

             $('#tblPreIncomming tbody tr').each(function (index) {
                 const $row = $(this);

                 // Store the row data in sequence (with RowIndex as Rid)
                 const rowData = {
                     RowIndex: index + 1,  // To keep the sequence starting from 1
                     QC_CODE: $row.find('td:eq(1)').text().trim(),
                     QCP_CODE: $row.find('td:eq(2)').text().trim(),
                     Parameter: $row.find('td:eq(3)').text().trim(),
                     Unit: $row.find('td:eq(4)').text().trim(),
                     QCP_STD: $row.find('td:eq(5)').text().trim(),
                     AllowAmt: $row.find('input[name="AllowAmt"]').val(),
                     DeductAmt: $row.find('input[name="DeductAmt"]').val(),
                     DeductNarr: $row.find('input[name="DeductNarr"]').val(),
                     Items: []   // This will be an array of item objects
                 };

                 // Loop through item inputs and maintain their values
                 $row.find('input[name^="Item_"]').each(function () {
                     const inputName = $(this).attr('name');
                     const value = $(this).val();

                     const itemCodeMatch = inputName.match(/^Item_(.+)$/);
                     if (itemCodeMatch) {
                         const itemCode = itemCodeMatch[1];
                         rowData.Items.push({ [itemCode]: value });

                         // Build combinedItems for each itemCode
                         if (!combinedItems[itemCode]) {
                             combinedItems[itemCode] = [];
                         }
                         combinedItems[itemCode].push(value);
                     }
                 });
                 preIncomingData.push(rowData);
             });
             debugger
             // Step 4: Final Object to send in the AJAX request
             let dataToSend = {
                 Header: formData,
                 Details: preIncomingData
             };

             console.log("📦 Data to send:", dataToSend);
             debugger
             // Step 5: Send Data to the Server via AJAX
             $.ajax({
                 url: '/IncommingQCRM/SaveAllData',
                 method: 'POST',
                 contentType: 'application/json',
                 data: JSON.stringify(dataToSend),
                 success: function (response) {
                     alert('✅ Data saved successfully!');
                 },
                 error: function (xhr) {
                     alert('❌ Failed to save data: ' + xhr.responseText);
