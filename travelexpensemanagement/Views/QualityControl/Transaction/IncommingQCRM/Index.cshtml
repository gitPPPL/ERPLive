          function GetallDataPreIncommingQCRM(response) {
             const Headerdata = response.header;
             const Itemdata = response.items;

             console.log('Headerdata',Headerdata)
             console.log('Itemdata',Itemdata)

             // --- 1. Fill Header fields
             if (Headerdata && Headerdata.length > 0) {
                 const header = Headerdata[0];

                 ddlDocType(() => {
                     $('#ddlDocType').val(header.V_TYPE);
                 });
                 $('#NumDocNo').val(header.DOC_ID);

                 ddlQCIncharge(() => {
                     $('#ddlQCIncharge').val(header.QC_INCHARGE);
                 });
                 ddlCheme(() => {
                     $('#ddlChem').val(header.CHEMIST);
                 });
                 ddlItemName(() => {
                     $('#ddlItemName').val(header.ITEM_CODE);
                 });
                  if (header.MRN_TYPE && header.MRN_NO) {
                    ddlGateNo(header.MRN_NO, header.MRN_TYPE, header.MRN_NO);
                  }
                  else
                  {
                    ddlGateNo('', header.V_TYPE);
                  }
                 $('#MRNDate').val(convertToDateInputFormat(header.MRN_DATE));
                 $('#DtDate').val(convertToDateInputFormat(header.V_DATE));
                 $('#TxtTransport').val(header.TRANSPORT);
                 $('#TxtTruckNo').val(header.TRUCK_NO);
                 $('#TxtContainerNo').val(header.CONTAINER_NO);
                 $('#TxtInvoiceQty').val(header.INV_QTY);
                 $('#TxtRecordedQty').val(header.RECD_QTY);
                 $('#TxtPurType').val(header.PUR_TYPE);
                 $('#TxtShortage').val(header.SHORT_QTY);
                 $('#NumBillNo').val(header.BILL_NO);
                 $('#DtBillDate').val(convertToDateInputFormat(header.BILL_DATE));
                 $('#TxtWastage').val(header.WASTE_WGT);
                 $('#NumDeductAmount').val(header.DEDUCT_AMT);
                 $('#TxtNarration').val(header.DEDUCT_NARR);
                 $('#TxtRemarks').val(header.REMARKS);
             }

             // --- 2. Build Item Table
             if (Itemdata && Itemdata.length > 0) {
                 const tableHeader = document.getElementById("tblPreIncommingHeader");
                 const tableBody = document.getElementById("tblPreIncommingBody");
                 tableHeader.innerHTML = '';
                 tableBody.innerHTML = '';

                 const columns = Object.keys(Itemdata[0]);

                 let itemCodes = [];
                 let columnDisplayNames = [];
                 let itemMappings = [];

                     columns.forEach(col => {
                 const parts = col.split('_');
                 if (parts.length >= 3) {
                     const rn = parts.pop(); // remove row number (last part)
                     const itemCode = parts.pop(); // remove item code (second last part)
                     const itemName = parts.join('_') + '_' + itemCode; // reconstruct full item name with code

                     columnDisplayNames.push(col); // use full column name
                     itemCodes.push(itemCode);
                     itemMappings.push({ itemName, itemCode });
                 } else {
                     columnDisplayNames.push(col); // non-item columns
                 }
             });


                 // --- 3. Build Item Code/Name Table
                 $('#itemTable thead tr').empty();
                 $('#itemTable tbody').empty();

                 $('#itemTable thead tr').append(`
                     <th>Item Code</th>
                     <th>Item Name</th>
                 `);

                 itemMappings.forEach(item => {
                     $('#itemTable tbody').append(`
                         <tr class="text-left">
                             <td>${item.itemCode}</td>
                             <td>${item.itemName}</td>
                         </tr>
                     `);
                 });

                 // --- 4. Build dynamic table headers
                 columnDisplayNames.forEach(displayName => {
                     const th = document.createElement("th");
                     th.textContent = displayName;
                     tableHeader.appendChild(th);
                 });

                 // --- 5. Build dynamic table body
                 Itemdata.forEach(row => {
                     const tr = document.createElement("tr");
                     columns.forEach((col, index) => {
                         const td = document.createElement("td");

                         if (index >= 5) {
                             // Editable input for dynamic columns
                             const input = document.createElement("input");
                             input.type = "text";
                             input.value = row[col] !== null && row[col] !== undefined ? row[col] : '';
                             input.className = "form-control";
                             input.dataset.col = col;
                             td.appendChild(input);
                         } else {
                             // Static display for fixed columns
                             td.textContent = row[col] !== null && row[col] !== undefined ? row[col] : '';
                         }

                         tr.appendChild(td);
                     });
                     tableBody.appendChild(tr);
                 });
             }
         }

      function convertToDateInputFormat(dateStr) {
        if (!dateStr) return '';

        // Check if date is in dd/MM/yyyy format
        if (dateStr.includes('/')) {
            const [day, month, year] = dateStr.split('/');
            return `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`;
        }

        // Handle ISO format: 2025-08-16T00:00:00
        const date = new Date(dateStr);
        if (isNaN(date)) return '';

        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');

        return `${year}-${month}-${day}`;
    }


