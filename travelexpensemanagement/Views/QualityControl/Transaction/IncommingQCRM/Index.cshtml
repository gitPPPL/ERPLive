@{
    ViewBag.Title = "Incomming QC RM";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .col-color-1 {
        background-color: #e8f7e4;
    }

    .col-color-2 {
        background-color: #f0f0f0;
    }

    .readonly-cell {
        display: none !important;
    }

    input[readonly] {
        background-color: #CCC !important;
        cursor: not-allowed;
    }
</style>
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-clipboard-check"></i>
        </div>
        <div class="erppage-header-title">Incomming QC RM</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-btn erppage-btn-danger" data-bs-toggle="modal" data-bs-target="#pendingQCModal" id="btn_PendingQC">
            <i class="fa fa-hourglass-half"></i>
            <span>Pending QC</span>
        </button>

        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "IncommingQCRMList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>

    </div>
</div>
<div id="PreIncommingQCRMForm">
    <input type="hidden" class="form-control" id="TxtCode" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Type</label>
                    <select class="erppage-input" id="ddlDocType">
                        <option value="">Select Doc Type</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Document No</label>
                    <input type="number" class="erppage-input" id="NumDocNo" placeholder="Enter Doc No">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-input" id="DtDate">
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">MRN No</label>
                    <select class="erppage-input" id="ddlGateNo">
                        <option value="0">Select MRN No</option>
                    </select>
                </div>
                <div class="erppage-divfield erppage-datefield">
                    <label class="erppage-label">MRN Date</label>
                    <input type="date" class="erppage-input erppage-dateinput" id="MRNDate">
                    @* <div class="erppage-datebox">
                        <label class="erppage-checkbox-inside">
                            <input type="checkbox" id="chkBillDate">
                        </label>
                    </div> *@
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Party Name</label>
                    @* <input type="text" class="erppage-input" id="TxtPartyName" placeholder="Enter Party Name"> *@
                    <select class="erppage-input" id="ddlPartyName">
                        <option value="">Select Party Name</option>
                    </select>

                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Bill No</label>
                    <input type="text" class="erppage-input" id="NumBillNo" placeholder="Enter Bill No" />
                </div>
                <div class="erppage-divfield erppage-datefield">
                    <label class="erppage-label">Bill Date</label>
                    <input type="date" class="erppage-input erppage-dateinput" id="DtBillDate">
                    @* <div class="erppage-datebox">
                        <label class="erppage-checkbox-inside">
                            <input type="checkbox" id="chkBillDate">
                        </label>
                    </div> *@
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Truck No</label>
                    <input type="text" class="erppage-input" id="TxtTruckNo" placeholder="Enter Truck No" />
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Container No</label>
                    <input type="text" class="erppage-input" id="TxtContainerNo" placeholder="Enter Container No" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Bales</label>
                    <input type="text" class="erppage-input" id="TxtBales" placeholder="Enter Bales" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Inv. Quantity</label>
                    <input type="text" class="erppage-input" id="TxtInvoiceQty" placeholder="Enter Invoice Qty" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Received Qty</label>
                    <input type="text" class="erppage-input" id="TxtRecordedQty" placeholder="Enter Received Qty" />
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Shortage /Excess</label>
                    <input type="text" class="erppage-input" id="TxtShortage" placeholder="Enter Shortage" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">QC Incharge</label>
                    <select class="erppage-input" id="ddlQCIncharge">
                        <option value="">Select QC Incharge</option>
                    </select>
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Chemist</label>
                    <select class="erppage-input" id="ddlChem">
                        <option value="">Select Chemist</option>
                    </select>
                </div>
            </div>
            <div class="erppage-grid4" style="display:none;">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Transport</label>
                    <input type="text" class="erppage-input" id="TxtTransport" placeholder="Enter Transport">
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group" style="display:none;">
                        <label for="TxtInvoiceQty">Invoice Qty</label>
                        <input type="text" class="form-control" id="TxtInvoiceQty" placeholder="Enter Invoice Qty">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group" style="display:none;">
                        <label for="TxtRecordedQty">Recorded Qty</label>
                        <input type="text" class="form-control" id="TxtRecordedQty" placeholder="Enter Recorded Qty">
                    </div>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2" style="display:none;">
                    <label class="erppage-label">Purch Type</label>
                    <input type="text" class="erppage-input" id="TxtPurType" placeholder="Enter PurType" />
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Remarks</label>
                    <input type="text" class="erppage-input" id="TxtRemarks1" placeholder="Enter Remarks" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group" style="display:none;">
                        <label for="TxtWastage">Wastage</label>
                        <input type="text" class="form-control" id="TxtWastage" placeholder="Enter Wastage" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group position-relative" style="display:none;">
                        <label for="DtGateDate">Gate Date</label>
                        <div class="calender-check">
                            <input type="date" class="form-control" id="DtGateDate" style="padding-left: 30px;">
                            <input type="checkbox" id="chkGateDate" class="checkbox-inside">
                        </div>
                    </div>
                </div>
            </div>
            <fieldset class="erppage-fieldset">
                <div class="erppage-section-header">MRN Details</div>
                <div class="erppagesrow">
                    <div class="erppagescol-6">
                        <div class="erppage-grid1">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label">Item Name</label>
                                <select class="erppage-input" id="ddlItemName">
                                    <option value="">Select Item Name</option>
                                </select>
                            </div>
                        </div>
                        <div id="lastUpdatedInfo" style="display:none;margin-bottom:8px;padding:8px 12px;background:#e8f7e4;border:1px solid #28a745; border-radius:4px;font-weight:600;">
                        </div>
                        <div class="erppagelist-container" style="margin:0px;">
                            <div class="erppagetabledynamic-wrapper">
                                <table id="itemTable" class="erppagetabledynamic-table">
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="erppagescol-6">
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Deduc Amt</label>
                                <input type="number" class="erppage-input" id="NumDeductAmount" placeholder="Enter Deduction Amount" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Narration</label>
                                <input type="text" class="erppage-input" id="TxtNarration" placeholder="Enter Narration" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Remarks1</label>
                                <input type="text" class="erppage-input" id="TxtRemarks" placeholder="Enter Remarks" />
                            </div>
                            <div class="erppage-actions" style="margin:0;padding:4px 0;">

                                <button type="button" class="erppage-btn erppage-btn-common" id="btn_calculate">
                                    <span>Calculate</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>

            <!-- Pending QC Modal -->
            <div class="modal fade" id="pendingQCModal" tabindex="-1" aria-labelledby="pendingQCLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content erppagesmodal-content">
                        <div class="erppagesmodal-header">
                            <div class="erppagesmodal-header-left">
                                <div class="erppagesmodal-header-icon">
                                    <i class="fa fa-clipboard-check"></i>
                                </div>
                                <h5 class="erppagesmodal-title" id="pendingQCLabel">
                                    Pending Gate Data for Pre QC
                                </h5>
                            </div>
                            <button type="button" class="erppagesmodal-close" data-bs-dismiss="modal" aria-label="Close">
                                <i class="fa fa-times"></i>
                            </button>
                        </div>
                        <div class="erppagelist-container">
                            <div class="excel-wrapper fixed-grid-wrapper">
                                <table id="tblpendingQC" class="excel-table fixed-grid-table resizable-table">
                                    <colgroup>
                                        <col style="display:none;" />
                                        <col style="width:120px;" />
                                        <col style="width:120px;" />
                                        <col style="width:250px;" />
                                        <col style="width:150px;" />
                                        <col style="width:120px;" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th class="hidden-col">Select</th>
                                            <th>Gate No</th>
                                            <th>Gate Date</th>
                                            <th>Party Name</th>
                                            <th>Vehicle No</th>
                                            <th class="action-col">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
            <div class="erppagelist-container">
                <div class="excel-wrapper fixed-grid-wrapper">
                    <table id="tblPreIncomming" class="excel-table fixed-grid-table resizable-table">
                        <colgroup id="tblPreIncommingColGroup">
                        </colgroup>
                        <thead>
                            <tr id="tblPreIncommingHeader" class="table-head"></tr>
                        </thead>
                        <tbody id="tblPreIncommingBody"></tbody>
                    </table>
                </div>
            </div>
        </fieldset>

        <div class="erppage-actions">
            <button id="btn-save" type="submit" class="erppage-btn erppage-btn-save">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>
        </div>
    </div>
    @* Modal Popup *@
    <div class="modal fade" id="qcParameterModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog erppagesmodal large-modal">
            <div class="modal-content erppagesmodal-content">
                <div class="erppagesmodal-header">
                    <div class="erppagesmodal-header-left">
                        <div class="erppagesmodal-header-icon">
                            <i class="fa fa-flask"></i>
                        </div>
                        <h5 class="erppagesmodal-title" id="qcModalTitle">
                            QC Parameter Details
                        </h5>
                    </div>
                    <button type="button" class="erppagesmodal-close" data-bs-dismiss="modal">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
                <div class="erppagesmodal-body" style="max-height: none;overflow-y: hidden;overflow-x: hidden;">
                    <div class="erppagelist-container">
                        <div class="excel-wrapper fixed-grid-wrapper" style="max-height: 65vh;overflow-y: auto;overflow-x: hidden;">
                            <table id="tblQCParameter" class="excel-table fixed-grid-table">
                                <thead>
                                    <tr>
                                        <th style="width:90px;">ItemName</th>
                                        <th style="width:100px;">Parameter</th>
                                        <th style="width:80px;">Unit</th>
                                        <th style="width:80px;">Level</th>
                                        <th style="width:150px;">Result</th>
                                        <th style="width:150px;">Deduct Amount</th>
                                        <th style="width:150px;">Deduct Narr</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><input type="text" class="form-control"></td>
                                        <td><input type="text" class="form-control"></td>
                                        <td><input type="text" class="form-control"></td>
                                        <td><input type="text" class="form-control"></td>
                                        <td><input type="text" class="form-control"></td>
                                        <td><input type="text" class="form-control"></td>
                                        <td><input type="text" class="form-control"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="erppage-actions" style="padding:0px;margin:0px;">
                        <button type="button" id="btnUpdateQCParameter" class="erppage-btn erppage-btn-save">
                            <i class="fa fa-save"></i><span>Update</span>
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

<script>
  let isReadOnly=false;
   $(document).ready(function () {
       let selectedItemCode = '';
       let selectedItemName = '';
       let qcDataStore = [];
       var selectedRowId = "";
       ddlDocType();
       ddlQCIncharge();
       ddlCheme();
       ddlPartyName();
       ddlItemName();
       let Headerdata = [];
       let Itemdata = [];
       let ddlGateNoInitialized = false;
       const today = new Date().toISOString().split('T')[0];
       document.getElementById('DtDate').value = today;
       function getQueryParam(param) {
             const urlParams = new URLSearchParams(window.location.search);
             return urlParams.get(param);
          }
       // Read values from query string
       const vType = getQueryParam('vType');
       const vNo = getQueryParam('vNo');
       const mode = getQueryParam('mode');

       isReadOnly = (mode === 'view');
       window.isReadOnly = isReadOnly;
       if (mode === 'view') {
          setViewMode();
       }
       if (vNo) {
                 $.ajax({
                     url: '/IncommingQCRM/GetAllDatadetails',
                     type: 'POST',
                     contentType: 'application/json',
                     data: JSON.stringify({ vNo: vNo, vType: vType }),
                     success: function (response) {
                         const $attachmentTbody = $('#tblAttachmentPRE tbody');
                           GetallDataPreIncommingQCRM(response);
                     },
                     error: function (xhr) {
                             toastr.error('Error: ' + xhr.responseText);
                     }
                 });
             }
       $('#ddlDocType').on('change', function () {
                const selectedValue = $(this).val();
                const selectedText = $(this).find("option:selected").text();
                $('#NumDocNo').prop('readonly', true);

                if (selectedValue !== "") {
                    sendDocType(selectedValue, selectedText);
                } else {
                    $('#NumDocNo').val('');
                }
            });
       $('#ddlGateNo').on('change', function () {
               var selectedNo = $(this).val(); 
               const selectedText = $(this).find('option:selected').text();
               const parts = selectedText.split('|');
               if (parts.length > 1) {
                   const dateStr = parts[1].trim(); // 25/04/2025
                   const [day, month, year] = dateStr.split('/');
                   const formattedDate = `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`;
                   $('#MRNDate').val(formattedDate).trigger('change');
               }              

               if (selectedNo !== "0" && selectedNo !== "") {
                   $.ajax({
                       url: '/IncommingQCRM/GetGatDetailsList',
                       type: 'POST',
                       data: {
                           StrVNo: selectedNo,
                           StrV_type: selectedText
                       },
                       success: function (response) {
                         if (!response.success) {
                             if (vNo) {
                                return;
                             }
                             else
                             {
                              toastr.warning(response.message, "Warning");
                              return;
                             }
                          }
                             ddlMrnChange(response);
                       },
                       error: function (xhr) {
                           console.error("Error:", xhr.responseText);
                       }
                   });
               }
           });
       $('#ddlItemName').on('change', function () {
        var v_no = $('#ddlGateNo').val();
        var v_type = $('#ddlDocType').val();
        var item_code = $('#ddlItemName').val();
        $.ajax({
            url: '/IncommingQCRM/OnchangeItem',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                V_NO: parseInt(v_no),
                V_TYPE: v_type,
                ITEM_CODE: item_code
            }),
            success: function (response) {

                if (!response.success) {
                    toastr.warning(response.message);
                    $('#ddlItemName').val('');
                    return;
                }
                // var item_name = $('#ddlItemName option:selected').text();
                // $('#itemTable tbody').append(
                //     '<tr>' +
                //         '<td>' + item_code + '</td>' +
                //         '<td>' + item_name + '</td>' +
                //         '<td><input type="text" class="form-control txtQty" /></td>' +
                //           '<td>' +
                //               '<button type="button" class="act-btn add btnQCParameter" title="Add Parameter">' +
                //                   '<i class="fa fa-plus"></i>' +
                //               '</button>' +
                //               '<button type="button" class="act-btn view btnQCView" title="View">' +
                //                   '<i class="fa fa-eye"></i>' +
                //               '</button>' +
                //               '<button type="button" class="act-btn delete" title="Delete" onclick="$(this).closest(\'tr\').remove();">' +
                //                   '<i class="fa fa-trash"></i>' +
                //               '</button>' +
                //           '</td>' +
                //     '</tr>'
                // );
                    var item_name = $('#ddlItemName option:selected').text();
                    let rowId = Date.now() + "_" + Math.floor(Math.random() * 100000);
                    $('#itemTable tbody').append(
                        '<tr data-rowid="' + rowId + '">' +
                            '<td>' + item_code + '</td>' +
                            '<td>' + item_name + '</td>' +
                            '<td><input type="text" class="form-control txtQty" /></td>' +
                            '<td>' +
                                '<button type="button" class="act-btn add btnQCParameter" title="Add Parameter">' +
                                    '<i class="fa fa-plus"></i>' +
                                '</button>' +
                                '<button type="button" class="act-btn view btnQCView" title="View">' +
                                    '<i class="fa fa-eye"></i>' +
                                '</button>' +
                                '<button type="button" class="act-btn delete" title="Delete" onclick="$(this).closest(\'tr\').remove();">' +
                                    '<i class="fa fa-trash"></i>' +
                                '</button>' +
                            '</td>' +
                        '</tr>'
                    );


                $('#ddlItemName').val('');
            }
        });
    });
       $(document).on('click', '.btnQCParameter', function () {

        const row = $(this).closest('tr');

        selectedRowId = row.attr('data-rowid');
        selectedItemCode = row.find('td:eq(0)').text().trim();
        selectedItemName = row.find('td:eq(1)').text().trim();

        // Item Grid Qty
        let selectedQty = row.find('.txtQty').val() || 0;

        $('#qcModalTitle').text(
            selectedItemName + ' (' + selectedItemCode + ')'
        );

        let existingItem = qcDataStore.find(
            x => x.RowId == selectedRowId
        );
        // Existing Saved QC Data
        if (existingItem) {

            let tbody = $('#tblQCParameter tbody');
            tbody.empty();

            $.each(existingItem.Details, function (i, item) {
                let isWeight =(item.Parameter || '').toLowerCase() === 'weight';
                tbody.append(`
                    <tr>

                        <td>
                            <input type="hidden" class="itemCode" value="${item.ItemCode}">
                            <input type="hidden" class="itemNameHidden" value="${item.ItemName}">
                            <input type="hidden" class="qcCode" value="${item.QC_CODE}">
                            <input type="hidden" class="qcpCode" value="${item.QCP_CODE}">
                            <input type="hidden" class="qty" value="${item.Qty}">

                            <input type="text"
                                   class="form-control itemName"
                                   value="${selectedItemName}"
                                   readonly>
                        </td>

                        <td>
                            <input type="text"
                                   class="form-control parameter"
                                   value="${item.Parameter}"
                                   readonly>
                        </td>

                        <td>
                            <input type="text"
                                   class="form-control unit"
                                   value="${item.Unit}"
                                   readonly>
                        </td>

                        <td>
                            <input type="text"
                                   class="form-control level"
                                   value="${item.Level}"
                                   readonly>
                        </td>

                        <td>
                            <input type="text"
                                   class="form-control result"
                                   value="${isWeight ? selectedQty : (item.Result || '')}"
                                   ${isWeight ? 'readonly' : ''}>
                        </td>

                        <td>
                            <input type="text"
                                   class="form-control deductAmount"
                                   value="${item.DeductAmont || ''}">
                        </td>

                        <td>
                            <input type="text"
                                   class="form-control deductNarr"
                                   value="${item.DeductNarr || ''}">
                        </td>

                    </tr>
                `);
            });

            $('#qcParameterModal').modal('show');
            return;
    }

        //============================
        // First Time Load From DB
        //============================
        $.ajax({
            url: '/IncommingQCRM/GetItemDetails',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify([
                {
                    ItemCode: selectedItemCode,
                    V_TYPE: vType || null,
                    V_NO: vNo ? parseInt(vNo) : null
                }
            ]),
            success: function (response) {

                if (!response.data || response.data.length === 0) {
                    toastr.warning('QC is not defined for this item.');
                    return;
                }

                let tbody = $('#tblQCParameter tbody');
                tbody.empty();

                $.each(response.data, function (i, item) {

                    let isWeight =
                        (item.parameter || '').toLowerCase() === 'weight';

                    tbody.append(`
                        <tr>

                            <td>
                                <input type="hidden" class="itemCode" value="${item.item_Code}">
                                <input type="hidden" class="itemNameHidden" value="${item.item_Name}">
                                <input type="hidden" class="qcCode" value="${item.qC_CODE}">
                                <input type="hidden" class="qcpCode" value="${item.qcP_CODE}">
                                <input type="hidden" class="qty" value="${item.qty}">

                                <input type="text"
                                       class="form-control itemName"
                                       value="${item.item_Name}"
                                       readonly>
                            </td>

                            <td>
                                <input type="text"
                                       class="form-control parameter"
                                       value="${item.parameter}"
                                       readonly>
                            </td>

                            <td>
