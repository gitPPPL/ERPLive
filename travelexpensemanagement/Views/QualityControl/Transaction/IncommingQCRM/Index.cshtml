       $('#btnUpdateQCParameter').off('click').on('click', function () {

        let details = [];

        $('#tblQCParameter tbody tr').each(function () {

            details.push({

                ItemCode: $(this).find('.itemCode').val(),
                ItemName: $(this).find('.itemNameHidden').val(),

                QC_CODE: $(this).find('.qcCode').val(),
                QCP_CODE: $(this).find('.qcpCode').val(),

                Qty: parseInt($(this).find('.qty').val()) || 0,

                Parameter: $(this).find('.parameter').val(),
                Unit: $(this).find('.unit').val(),
                Level: $(this).find('.level').val(),

                Result: $(this).find('.result').val(),

                DeductAmont:
                    $(this).find('.deductAmount').val() === ''
                        ? null
                        : parseFloat($(this).find('.deductAmount').val()),

                DeductNarr: $(this).find('.deductNarr').val()
            });
        });

        let existingIndex = qcDataStore.findIndex(
            x => x.RowId == selectedRowId
        );

        if (existingIndex > -1) {

            qcDataStore[existingIndex].Details = details;
        }
        else {

            qcDataStore.push({

                RowId: selectedRowId,
                ItemCode: selectedItemCode,
                ItemName: selectedItemName,
                Details: details
            });
        }

        console.log("QC STORE AFTER UPDATE");
        console.log(qcDataStore);

        toastr.success('QC Data Updated');

        $('#qcParameterModal').modal('hide');
    });
       $('#btn-save').click(function (e) {
        e.preventDefault();
        function parseDecimal(val) {
            if (!val) return null;
            val = val.toString().trim();
            return val === "" ? null : parseFloat(val);
        }

        function parseIntOrNull(val) {
            if (!val) return null;
            val = val.toString().trim();
            return val === "" ? null : parseInt(val);
        }

        let qcData = [];
        $('#itemTable tbody tr').each(function () {

            let row = $(this);

            let rowId = row.attr('data-rowid') || '';
            // UPDATE page me RID hidden hai
            let itemCode;
            let itemName;

            if (vNo) {

                itemCode = row.find('td:eq(1)').text().trim();
                itemName = row.find('td:eq(2)').text().trim();

            } else {

                itemCode = row.find('td:eq(0)').text().trim();
                itemName = row.find('td:eq(1)').text().trim();
            }

            let qty = parseFloat(row.find('.txtQty').val()) || 0;
            let existingItem = qcDataStore.find(
                x => x.RowId == rowId
            );

            console.log("================================");
            console.log("rowId =", rowId);
            console.log("itemCode =", itemCode);
            console.log("itemName =", itemName);
            console.log("existingItem =", existingItem);

            qcData.push({
                RowId: rowId,
                ItemCode: itemCode,
                ItemName: itemName,
                Qty: qty,
                Details: existingItem ? existingItem.Details : []

            });
        });

        let formData = {

            docType: $('#ddlDocType').val(),
            docNo: $('#NumDocNo').val(),
            date: $('#DtDate').val(),

            gateNo: $('#ddlGateNo option:selected').text(),

            qcIncharge: $('#ddlQCIncharge').val(),
            chem: $('#ddlChem').val(),
            partyName: $('#ddlPartyName').val(),

            transport: $('#TxtTransport').val(),
            truckNo: $('#TxtTruckNo').val(),
            containerNo: $('#TxtContainerNo').val(),

            invoiceQty: parseDecimal($('#TxtInvoiceQty').val()),
            recordedQty: parseDecimal($('#TxtRecordedQty').val()),

            purType: $('#TxtPurType').val(),

            shortage: parseDecimal($('#TxtShortage').val()),

            billNo: $('#NumBillNo').val(),
            billDate: $('#DtBillDate').val(),

            billDateChecked: $('#chkBillDate').is(':checked'),

            wastage: parseDecimal($('#TxtWastage').val()),

            gateDate: $('#DtGateDate').val(),
            gateDateChecked: $('#chkGateDate').is(':checked'),

            bales: parseIntOrNull($('#TxtBales').val()),

            remarks: $('#TxtRemarks').val(),

            MRNDate: $('#MRNDate').val(),

            DeductAmount: parseDecimal($('#NumDeductAmount').val()),
            Narration: $('#TxtNarration').val(),

            ACTION: vNo ? "UPDATE" : "INSERT"
        };

        let requestData = {

            Header: formData,
            QCData: qcData

        };

        console.log("========== QC DATA ==========");
        console.log(qcData);

        console.log("========== QC DATA STORE ==========");
        console.log(qcDataStore);

        console.log("========== FINAL JSON ==========");
        console.log(JSON.stringify(requestData, null, 2));

        $.ajax({
            url: '/IncommingQCRM/SaveQCData',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            data: JSON.stringify(requestData),
            success: function (response) {
                if (response.success) {
                    toastr.success(response.message);
                } else {
                    toastr.error(response.message);
                }
            },
            error: function (xhr) {

                console.log(xhr.responseText);

                toastr.error('Error while saving');
            }
        });

   });
