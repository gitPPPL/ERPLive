   function GetallDataPreIncommingQCRM(response) {
            console.log('List page', response);
            const Headerdata = response.header;
            const Itemdata = response.items;
            const itemResults = response.itemResults || [];

            // -------------------------
            // 1. HEADER FILL
            // -------------------------
            if (Headerdata && Headerdata.length > 0) {
                const header = Headerdata[0];

                ddlDocType(() => {
                    $('#ddlDocType').val(header.V_TYPE);
                });

                $('#NumDocNo').val(header.V_NO);

                ddlPartyName(() => {
                    $('#ddlPartyName').val(header.PARTY_CODE);
                });

                ddlQCIncharge(() => {
                    $('#ddlQCIncharge').val(header.QC_INCHARGE);
                });

                ddlCheme(() => {
                    $('#ddlChem').val(header.CHEMIST);
                });

                ddlItemName(() => {
                    $('#ddlItemName').val(header.ITEM_CODE);
                });

                if (header.MRN_TYPE && header.MRN_NO) {
                    ddlGateNo(header.MRN_NO, header.MRN_TYPE, header.MRN_NO);
                } else {
                    ddlGateNo('', header.V_TYPE);
                }

                $('#MRNDate').val(convertToDateInputFormat(header.MRN_DATE));
                $('#DtDate').val(convertToDateInputFormat(header.V_DATE));

                $('#TxtTransport').val(header.TRANSPORT);
                $('#TxtTruckNo').val(header.TRUCK_NO);
                $('#TxtContainerNo').val(header.CONTAINER_NO);
                $('#TxtInvoiceQty').val(header.INV_QTY);
                $('#TxtRecordedQty').val(header.RECD_QTY);
                $('#TxtPurType').val(header.PUR_TYPE);
                $('#TxtShortage').val(header.SHORT_QTY);
                $('#NumBillNo').val(header.BILL_NO);
                $('#DtBillDate').val(convertToDateInputFormat(header.BILL_DATE));
                $('#TxtWastage').val(header.WASTE_WGT);
                $('#NumDeductAmount').val(header.DEDUCT_AMT);
                $('#TxtNarration').val(header.DEDUCT_NARR);
                $('#TxtRemarks').val(header.REMARKS);
                $('#TxtBales').val(header.BALES);
            }

            // -------------------------
            // 2. ITEM TABLE BUILD
            // -------------------------
            if (Itemdata && Itemdata.length > 0) {

                const tableHeader = document.getElementById("tblPreIncommingHeader");
                const tableBody = document.getElementById("tblPreIncommingBody");

                tableHeader.innerHTML = '';
                tableBody.innerHTML = '';

                const columns = Object.keys(Itemdata[0]);

                let itemMappings = [];

