@{
	ViewBag.Title = "Cost Master List";
	Layout = "~/Views/Shared/_Layout.cshtml";

}

<fieldset>
	<legend class="legend-field">Cost Master List</legend>

	<div class="row">
		<div class="col-lg-4">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control border-0" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>

		<div class="">
			<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "CostMaster")'" type="submit" class="btn btn-primary">
				<i class="fa fa-plus"></i>Add Cost
			</button>
			<button class="btn btn-print">
				<i class="fa fa-print"></i> Print
			</button>
			<button class="btn btn-export">
				<i class="fas fa-file-export"></i> Export
			</button>
			<button class="btn btn-mail">
				<i class="fa fa-envelope"></i> Mail
			</button>
			<button class="btn btn-send">
				<i class="fa fa-paper-plane"></i> Approval Send
			</button>
			<button class="btn btn-approved">
				<i class="fa fa-check"></i> Approved
			</button>

		</div>
	</div>



	<div class="card shadow-sm border-0 mt-2">
		<div class="table-responsive">
			<table id="" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>Cost Type</th>
						<th>Cost Code</th>
						<th>Department</th>
						<th>%</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
	</div>

</fieldset>