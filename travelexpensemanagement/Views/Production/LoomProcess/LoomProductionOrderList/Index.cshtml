@{
    ViewBag.Title = "Loom Production Order List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentMenu = ViewBag.CurrentMenu as string;
    bool canAdd = false;
    bool canEdit = false;
    bool canDelete = false;
    bool canPrint = false;
    bool canExport = false;
    bool canMail = false;
    bool canApproval = false;
    bool canDocDetail = false;

    foreach (var permission in Model.UserMenuPermissions)
    {
        if (permission.DISPLAY_NAME == ViewBag.CurrentMenu)
        {
            canAdd = Model.UserLevel == 1 || permission._ADD == 1;
            canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
            canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
            canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
            canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
            canMail = Model.UserLevel == 1 || permission._MAIL == 1;
            canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
            canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
            break;
        }
    }
}
<fieldset>
    <legend class="legend-field">Loom Production Order List</legend>

    <div class="row">
        <div class="col-lg-3">
            <div class="input-group shadow-sm rounded-pill overflow-hidden">
                <input type="text" id="searchBox" class="form-control border-0" placeholder="Search Module..." aria-label="Search term">
            </div>
        </div>
        <div class="col-lg-9">
            <div class="btn-rightalign">
                @if (canAdd)
                {
                    <button id="btnSave" onclick="window.location.href='@Url.Action("Index", "LoomProductionOrder")'" type="button" class="btn btn-add">
                        <i class="fa fa-plus"></i>Add
                    </button>
                }
                @if (canPrint)
                {
                    <button class="btn btn-print" onclick="callGetReportAsPdf()">
                        <i class="fa fa-print"></i> Print
                    </button>
                }
                @if (canExport)
                {
                    <button class="btn btn-export" onclick="exportToExcel()">
                        <i class="fas fa-file-export"></i> Export
                    </button>
                }
                @if (canMail)
                {
                    <button class="btn btn-info">
                        <i class="fa fa-envelope"></i> Mail
                    </button>
                }
                @if (canApproval)
                {
                    <button class="btn btn-export" onclick="Approval()">
                        <i class="fas fa-file-export"></i> Export
                    </button>
                }
            </div>
        </div>
    </div>
    <div class="card">
        <div class="table-responsive">
            <table id="tblLoomProductionOrderList" class="table-width">
                <thead class="table-head">
                    <tr>
                        <th>DocName</th>
                        <th>VType</th>
                        <th>VNo</th>
                        <th>VDate</th>
                        <th>docId1</th>
                        <th>Eff_Date</th>
                        <th>Comp_Date</th>
                        <th>Item_Code</th>
                        <th>Item_Name</th>
                        <th>Prod_Qty</th>
                        <th>Approx_Mtr</th>
                        <th>Approx_Kg</th>
                        <th>No of Loom</th>
                        <th>Remarks</th>
                        <th>Uuser</th>
                        <th>UDate</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="pagination-end">
                    <div class="custom-pagination" id="tablePagination"></div>
                </div>
            </div>
        </div>
    </div>
</fieldset>
<script>
    let currentPage = 1;
    const pageSize = 10;

    $(document).ready(function(){
        loadListData();
        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadListData();
        });
    });

    async function loadListData() {
        try {
            $('.circle-loader').show();

            const response = await $.ajax({
                url: '/LoomProductionOrderList/loadListData',
                type: 'GET',
                data: {
                    pageNumber: currentPage,
                    pageSize: pageSize,
                    searchTerm: $('#searchBox').val()
                }
            });
            console.log("List data", response);

            if (!response.success) {
                toastr.warning("Failed to load data");
                return;
            }

            const tbody = $("#tblLoomProductionOrderList tbody");
            tbody.empty();

            const list = response.data;
            const totalCount = response.totalCount;

            if (!list || list.length === 0) {
                tbody.html(`
                    <tr>
                        <td colspan="22" class="text-center text-muted">No records found</td>
                    </tr>`);
                renderPagination(0);
                return;
            }

            list.forEach(item => {
                const row = `
                <tr>
                    <td>${item.doc_name || ''}</td>
                    <td>${item.vType || ''}</td>
                    <td>${item.vNo || ''}</td>
                    <td>${item.vDate || ''}</td>
                    <td>${item.docId || ''}</td>
                    <td>${item.effDate || ''}</td>
                    <td>${item.compDate || ''}</td>
                    <td>${item.itemCode || ''}</td>
                    <td>${item.itemName || ''}</td>
                    <td>${item.prodQty || ''}</td>
                    <td>${item.approX_MTR || ''}</td>
                    <td>${item.approxKg || ''}</td>
                    <td>${item.noOfLoom  || ''}</td>
                    <td>${item.remark || ''}</td>
                    <td>${item.uUser || ''}</td>
                    <td>${item.uDate || ''}</td>
                    <td>
                        <i class="fa fa-edit btn-edit" onclick='editLoomProductionOrder("${item.docId}")'></i>
                        <i class="fa fa-eye btn-view" onclick='viewLoomProductionOrder("${item.docId}")'></i>
                        <i class="fa fa-trash btn-delete" onclick='deleteLoomProductionOrderData("${item.docId}")'></i>
                    </td>
                </tr>`;

                tbody.append(row); 
            });

            renderPagination(totalCount);

        } catch (err) {
            toastr.error(err.message || "Unexpected Error Occurred");
        } finally {
            $('.circle-loader').hide();
        }
    }

     //=============Render Pagination =================
     function renderPagination(totalCount) {

         const totalPages = Math.ceil(totalCount / pageSize);
         const paginationContainer = $('#tablePagination');
         paginationContainer.empty();

         if (totalPages <= 1) return;

         let html = '';

         if (currentPage > 1) {
             html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
             html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
         }

         let startPage = Math.max(1, currentPage - 2);
         let endPage = Math.min(totalPages, currentPage + 2);

         for (let i = startPage; i <= endPage; i++) {

             html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1"onclick="goToPage(${i})">${i}</button>`;
         }

         if (currentPage < totalPages) {

             html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
             html += `<button class="btn btn-sm btn-light mx-1"  onclick="goToPage(${totalPages})">Last</button>`;

         }
         paginationContainer.html(html);
     }

     function goToPage(page) {
         currentPage = page;
         loadListData();
     }

    //=========Edit==========
    function editLoomProductionOrder(docId){
        window.location.href='/LoomProductionOrder/Index?docId=' + docId;
    }
    
    //=========View==========
    function viewLoomProductionOrder(docId){
        window.location.href='/LoomProductionOrder/Index?docId=' + docId + '&mode=view';
    }

    function deleteLoomProductionOrderData(docId){
        Swal.fire({
           title: 'Are you sure?',
           html: `You are about to delete this record:<br><b>${docId}</b>`,
           icon: 'warning',
           showCancelButton: true,
           confirmButtonColor: '#d33',
           cancelButtonColor: '#3085d6',
           confirmButtonText: 'Yes, delete it!',
           cancelButtonText: 'Cancel'
        }).then((result)=>{
            if(result.isConfirmed){
                $.ajax({
                     url:'/LoomProductionOrderList/DeleteData',
                     type:'Post',
                     data:{docId:docId},
                     success: function(res){
                         if(res.success){
                             Swal.fire('Deleted','Data has been deleted successfully','success');
                             loadListData();
                         }
                         else{
                             Swal.fire('Failed','Data Deleted Failed !!', 'error');
                         }
                     },
                     error:function(){
                         Swal.fire('Error','An error occured while deleting','error');
                     }
                });
            }
        });
    }
</script>