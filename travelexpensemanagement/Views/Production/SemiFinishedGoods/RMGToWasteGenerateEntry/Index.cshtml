                        </div>
                        <div class="card">
                            <div class="table-responsive">
                                <table id="tblRMPurchaseModal" class="table-width">
                                    <thead class="table-head">
                                        <tr>
                                            <th><input type="checkbox" id="selectAllQM" /></th>
                                            <th>Pono</th>
                                            <th>Potype</th>
                                            <th>Vdate</th>
                                            <th>Item Code</th>
                                            <th>Item Name</th>
                                            <th>Unit</th>

                                            <th style="display:none;">Action</th>
