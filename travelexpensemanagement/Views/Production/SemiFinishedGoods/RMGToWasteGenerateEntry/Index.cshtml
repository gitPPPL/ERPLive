    <div class="container">
        Loading...
        <div class="spinner-part"></div>
        <div class="spinner-part"></div>
        <div class="spinner-part"></div>
    </div>
</div>
<fieldset>
    <legend class="legend-field">RMGTo Waste GenerateEntry</legend>
    <div class="row">
