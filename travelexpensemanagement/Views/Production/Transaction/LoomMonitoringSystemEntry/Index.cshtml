            toastr.warning('No PPM data to save.');
            return;
        }

        $.ajax({
            url: '/LoomMonitoringSystemEntry/UpdatePpmBatch',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(ppmUpdates),
            success: function (response) {
                if (response.success) {
                    toastr.success('PPM data updated successfully!');
                    $('#DtDatePPM').prop('disabled', false);
                    $('#ddlShiftPPM').prop('disabled', false);
                    $('#TxtBlockNoPPM').prop('disabled', false);
                    
                    $('#DtDatePPM').val(new Date().toISOString().split('T')[0]);
                    $('#ddlShiftPPM')[0].selectedIndex = 0;
                    $('#TxtBlockNoPPM')[0].selectedIndex = 1;

                    setTimeout(function () {
                        loadPpmInfo();
                    }, 1000);
                } else {
                    toastr.error('Error updating data: ' + response.message);
                }
            },
            error: function (xhr, status, error) {
                toastr.error('AJAX error: ' + error);
            }
        });
    });



    $('#btn_saveWE').click(function () {
    let wastageUpdates = [];
    let validationFailed = false;

    $('#tblWE tbody tr').each(function () {
        let row = $(this);

        let loomCode = row.find('input.Loom_Code').val();
        let vNo = row.find('input.V_No').val();
        let vType = row.find('input.V_Type').val();
        let docId = row.find('input.Doc_Id').val();
        let wastageRaw = row.find('input.Wastage').val();
        let wastageValue = parseFloat(wastageRaw);

        let shiftCode = $('#ddlShiftWE').val() || '';
        let groupCode = $('#TxtBlockNoWE').val() || '';
        let date = $('#DtDateWE').val();

        if (!vNo || !vType || !docId) {
            toastr.warning(`First you need to add Loom Allocation for same Date,Time,Block.`);
            validationFailed = true;
            return false; 
        }

        if (!isNaN(wastageValue) && loomCode) {
            wastageUpdates.push({
                LOOM_CODE: loomCode,
                V_NO: parseInt(vNo),
                V_TYPE: vType,
                DOC_ID: docId,
                WASTAGE: wastageValue,
                SCH_SHIFT: shiftCode,
                GROUP_CODE: groupCode,
                V_DATE: date
            });
        }
    });

    if (validationFailed) {
        return;
    }

    if (wastageUpdates.length === 0) {
        alert('No Wastage data to save.');
        return;
    }

    $.ajax({
        url: '/LoomMonitoringSystemEntry/UpdateWastageBatch',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(wastageUpdates),
        success: function (response) {
            if (response.success) {
                toastr.success('Wastage data updated successfully!');
                $('#DtDateWE').prop('disabled', false);
                $('#ddlShiftWE').prop('disabled', false);
                $('#TxtBlockNoWE').prop('disabled', false);

                $('#DtDateWE').val(new Date().toISOString().split('T')[0]);
                $('#ddlShiftWE')[0].selectedIndex = 0;
                $('#TxtBlockNoWE')[0].selectedIndex = 1;


                setTimeout(function () {
                    loadWastageInfo();
                }, 1000);
            } else {
                toastr.error('Error updating data: ' + response.message);
            }
        },
        error: function (xhr, status, error) {
            toastr.error('AJAX error: ' + error);
        }
    });
});

</script>



