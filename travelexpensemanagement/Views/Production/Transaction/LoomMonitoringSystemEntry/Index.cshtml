    function loadHPInfo() {
        var shiftCode = $('#ddlShiftHP').val();
        var groupCode = $('#TxtBlockNoHP').val();
        var selectedDate = document.getElementById('DtDateHP').value;
        var selectedTime = $('#ddlTimeHP').val().substring(0, 2);

        if (!shiftCode) {
            shiftCode = 'A';
            groupCode = 'A';
        }

        fetchItemList(() => {
            fetchMashList(() => {
                $.ajax({
                    url: '/LoomMonitoringSystemEntry/GetHPInfo',
                    type: 'GET',
                    data: {
                        sCode: shiftCode,
                        gCode: groupCode,
                        sdate: selectedDate,
                        stime: selectedTime
                    },
                    success: function (response) {
                        console.log(response);
                        if (response.success) {
                            var tbody = $('#tblHourProduction tbody');
                            tbody.empty();
                            let loomRowIndex = 0;

                            $.each(response.data, function (index, item) {
                                loomRowIndex++;

                                const opReading = item.oP_READING != null ? parseFloat(item.oP_READING) : null;
                                const clReading = item.cL_READING != null ? parseFloat(item.cL_READING) : null;

                                let diff = 0;
                                if (clReading === 0 || clReading == null) {
                                    diff = 0;
                                } else if (opReading != null && clReading != null) {
                                    diff = opReading > clReading
                                        ? (clReading + 10000 - opReading).toFixed(2)
                                        : (clReading - opReading).toFixed(2);
                                }

                                let newRow = `
                                    <tr id="${loomRowIndex}" data-row-index="${loomRowIndex}">
                                        <td style="display:none;" class="text-center">${loomRowIndex}</td>
                                        <td style="display:none;">
                                            <input type="hidden" id="loomCode_${loomRowIndex}" name="loomCode[${loomRowIndex}]" class="form-control Loom_Code" value="${item.looM_CODE}"/>
                                        </td>
                                        <td style="display:none;">
                                            <input type="hidden" id="vNo_${loomRowIndex}" name="vNo[${loomRowIndex}]" class="form-control V_No" value="${item.v_NO}" />
                                        </td>
                                        <td style="display:none;">
                                            <input type="hidden" id="vType_${loomRowIndex}" name="vType[${loomRowIndex}]" class="form-control V_Type" value="${item.v_TYPE}" />
                                        </td>
                                        <td style="display:none;">
                                            <input type="hidden" id="docId_${loomRowIndex}" name="docId[${loomRowIndex}]" class="form-control Doc_Id" value="${item.doC_ID ?? ''}" />
                                        </td>
                                        <td>
                                            <input type="text" id="machineName_${loomRowIndex}" name="machineName[${loomRowIndex}]" class="form-control Machine_Name" value="${item.looM_NAME}" readonly/>
                                        </td>
                                        <td>
                                            <input type="number" id="opReading_${loomRowIndex}" name="opReading[${loomRowIndex}]" class="form-control OpReading" value="${opReading != null ? opReading : ''}" />
                                        </td>
                                        <td>
                                            <input type="number" id="clReading_${loomRowIndex}" name="clReading[${loomRowIndex}]" class="form-control CpClosing" value="${clReading != null ? clReading : ''}" />
                                        </td>
                                        <td>
                                            <input type="number" id="diff_${loomRowIndex}" name="diff[${loomRowIndex}]" class="form-control diff" data-row-id="${loomRowIndex}" value="${diff}" readonly />
                                        </td>
                                    </tr>
                                `;

                                tbody.append(newRow);
                            });

                            // Recalculate diff on input
                            $('#tblHourProduction').off('input', '.OpReading, .CpClosing').on('input', '.OpReading, .CpClosing', function () {
                                const row = $(this).closest('tr');

                                const opVal = parseFloat(row.find('.OpReading').val());
                                const clVal = parseFloat(row.find('.CpClosing').val());

                                if (!isNaN(opVal) && !isNaN(clVal)) {
                                    let diffVal = opVal > clVal
                                        ? clVal + 10000 - opVal
                                        : clVal - opVal;
                                    row.find('.diff').val(diffVal.toFixed(2));
                                } else {
                                    row.find('.diff').val('');
                                }
                            });

                            // Tab diff validation
                            $('#tblHourProduction').off('keydown', '.CpClosing').on('keydown', '.CpClosing', function (e) {
                                if (e.key === 'Tab') {
                                    const currentRow = $(this).closest('tr');
                                    const opVal = parseFloat(currentRow.find('.OpReading').val());
                                    const clVal = parseFloat(currentRow.find('.CpClosing').val());

                                    if (!isNaN(opVal) && !isNaN(clVal)) {
                                        let diffVal = opVal > clVal
                                            ? clVal + 10000 - opVal
                                            : clVal - opVal;

                                        if (diffVal > 500) {
                                            e.preventDefault();
                                            toastr.warning('Reading difference cannot be more than 500 units. Please check...');
                                            $(this).focus().select();
                                            return;
                                        }
                                    }

                                    // Move focus to next row
                                    setTimeout(() => {
                                        const nextRow = currentRow.next('tr');
                                        const nextInput = nextRow.find('.CpClosing');
                                        if (nextInput.length) {
                                            nextInput.focus().select();
                                        }
                                    }, 0);
                                }
                            });

                        } else {
                                 toastr.error('Error: ' + response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        toastr.error('AJAX error: ' + error);
                    }
                });
            });
        });
    }

