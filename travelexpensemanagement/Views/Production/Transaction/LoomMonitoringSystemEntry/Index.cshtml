<script>
    function showForm(id, btn) {
      // hide all forms
      document.querySelectorAll(".mf-form-box").forEach(f => f.classList.remove("active"));
      document.getElementById(id).classList.add("active");

      // reset all buttons
      document.querySelectorAll(".mf-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
    }
</script>


<script>

    var compCode = '@ViewBag.CompCode';
    var branchCode = '@ViewBag.BranchCode';
    var yearCode = '@ViewBag.YearCode';

    var itemListCache = [];
    var mashListCache = [];
    let isAllEmpCodeEmpty = true;


    $(document).ready(function () {
        const today = new Date().toISOString().split('T')[0];
        document.getElementById("DtDateMA").setAttribute("max", today);

        $('#DtDateMA').val(new Date().toISOString().split('T')[0]);
        $('#DtDateHP').val(new Date().toISOString().split('T')[0]);
        $('#DtDatePPM').val(new Date().toISOString().split('T')[0]);
        $('#DtDateWE').val(new Date().toISOString().split('T')[0]);

        getshiftList('#ddlShiftMA');
        getBlockList('#TxtBlockMA');
        getshiftList('#ddlShiftHP');
        getBlockList('#TxtBlockNoHP');
        getshiftList('#ddlShiftPPM');
        getBlockList('#TxtBlockNoPPM');
        getshiftList('#ddlShiftWE');
        getBlockList('#TxtBlockNoWE');

        fetchItemList(() => {
            loadLoomProductionInfo();
        });
    });


    $('#tblAllocation tbody tr').each(function () {
        const empCode = $(this).find('.Emp_Code').val()?.trim();
        if (empCode && empCode !== '') {
            isAllEmpCodeEmpty = false;
            return false;
        }
    });

    window.isAllEmpCodeEmpty = isAllEmpCodeEmpty;

    function getBlockList(targetSelector) {
        return $.ajax({
            url: '/LoomMonitoringSystemEntry/getBlocksList',
            type: 'GET',
            dataType: 'json',
            success: function (response) {
                var ddl = $(targetSelector);
                ddl.empty();
                ddl.append('<option value="">-- Select Block --</option>');

                $.each(response.data, function (index, block) {
                    ddl.append('<option value="' + block + '">' + block + '</option>');
                });
                if (response.data.length > 0) {
                    ddl.val(response.data[0]);
                }
            },
            error: function (xhr, status, error) {
                toastr.error('Error loading Block list: ' + error);
            }
        });
    }

    function fetchItemList(callback) {
        if (itemListCache.length > 0) {
            callback(); // Use cached data
            return;
        }
        $.ajax({
            url: '/LoomMonitoringSystemEntry/itemList',
            type: 'GET',
            data: { cCode: 5 },
            success: function (response) {
                itemListCache = response;
                callback();
            },
            error: function (xhr, status, error) {
                console.error('Failed to fetch item list:', error);
            }
        });
    }

    function getshiftList(targetSelector) {
        return $.ajax({
            url: '/LoomMonitoringSystemEntry/shiftList',
            type: 'GET',
            data: { cCode: compCode },
            dataType: 'json',
            success: function (data) {
                var ddl = $(targetSelector);
                ddl.empty();

                $.each(data, function (index, item) {
                    ddl.append('<option value="' + item.value + '">' + item.value + '</option>');
                });

                if (data.length > 0) {
                    ddl.val(data[0].value);
                }
            },
            error: function (xhr, status, error) {
                toastr.error('Error loading Shift list: ' + error);
            }
        });
    }

    function fetchMashList(callback) {
        if (mashListCache.length > 0) {
            callback();
            return;
        }
        $.ajax({
            url: '/LoomMonitoringSystemEntry/meshList',
            type: 'GET',
            data: { cCode: compCode },
            success: function(response) {
                mashListCache = response;
                callback();
            },
            error: function(xhr, status, error) {
                console.error('Failed to fetch mash list:', error);
            }
        });
    }



    $('#btn_fillMA').click(function () {
        $('#DtDateMA').prop('disabled', true);
        $('#ddlShiftMA').prop('disabled', true);
        $('#TxtBlockMA').prop('disabled', true);
        fetchItemList(() => {
            loadLoomProductionInfo();
        });
    });

    $('#btn_cancelMA').click(function () {
        $('#DtDateMA').prop('disabled', false);
        $('#ddlShiftMA').prop('disabled', false);
        $('#TxtBlockMA').prop('disabled', false);

        $('#DtDateMA').val(new Date().toISOString().split('T')[0]);
        $('#ddlShiftMA')[0].selectedIndex = 0;
        $('#TxtBlockMA')[0].selectedIndex = 1;

        fetchItemList(() => {
            loadLoomProductionInfo();
        });
    });

    function loadLoomProductionInfo() {
        var shiftCode = $('#ddlShiftMA').val();
        var groupCode = $('#TxtBlockMA').val();
        var selectedDate = document.getElementById('DtDateMA').value;

        if (!shiftCode) {
            shiftCode = 'A';
            groupCode = 'A';
        }

        fetchItemList(() => {
            fetchMashList(() => {
                $.ajax({
                    url: '/LoomMonitoringSystemEntry/GetLoomProductionInfo',
                    type: 'GET',
                    data: {
                        sCode: shiftCode,
                        gCode: groupCode,
                        sdate: selectedDate
                    },
                    success: function (response) {
                                console.log('GetLoomProductionInfo', response)
                        if (response.success) {
                            var tbody = $('#tblAllocation tbody');
                            tbody.empty();

                            let loomRowIndex = 0;

                            $.each(response.data, function (index, item) {
                                loomRowIndex++;

                                // Build options for Item dropdown
                                let itemOptions = '';
                                if (itemListCache.length === 0) {
                                    itemOptions = '<option disabled selected>No items available</option>';
                                } else {
                                    $.each(itemListCache, function (i, itm) {
                                        let selected = itm.value == item.iteM_CODE ? 'selected' : '';
                                        itemOptions += `<option value="${itm.value}" ${selected}>${itm.text}</option>`;
                                    });
                                }

                                // Build options for Mash dropdown
                                let mashOptions = '';
                                if (mashListCache.length === 0) {
                                    mashOptions = '<option disabled selected>No mash available</option>';
                                } else {
                                    $.each(mashListCache, function (i, mash) {
                                        let selected = mash.value == item.mesH_CODE ? 'selected' : '';
                                        mashOptions += `<option value="${mash.value}" ${selected}>${mash.text}</option>`;
                                    });
                                }

                                let newRow = `
                                    <tr id="${loomRowIndex}" data-row-index="${loomRowIndex}">
                                        <td style="display:none;" class="text-center">${loomRowIndex}</td>
                                        <td style="display:none;">
                                            <input type="hidden" id="loomCode_${loomRowIndex}" name="loomCode[${loomRowIndex}]" class="form-control Loom_Code" value="${item.looM_CODE}"/>
                                        </td>
                                        <td style="display:none;">
                                            <input type="hidden" id="vNo_${loomRowIndex}" name="vNo[${loomRowIndex}]" class="form-control V_No" value="${item.v_NO}" />
                                        </td>
                                        <td style="display:none;">
                                            <input type="hidden" id="vType_${loomRowIndex}" name="vType[${loomRowIndex}]" class="form-control V_Type" value="${item.v_TYPE}" />
                                        </td>
                                        <td style="display:none;">
                                            <input type="hidden" id="docId_${loomRowIndex}" name="docId[${loomRowIndex}]" class="form-control Doc_Id" value="${item.doC_ID ?? ''}" />
                                        </td>
                                        <td>
                                            <input type="text" id="machineName_${loomRowIndex}" name="machineName[${loomRowIndex}]" class="form-control Machine_Name" value="${item.machinE_NAME}" readonly/>
                                        </td>
                                        <td>
                                            <input type="text" id="empCode_${loomRowIndex}" name="empCode[${loomRowIndex}]" class="form-control Emp_Code"  data-row-id="${loomRowIndex}" value="${item.emP_CODE}" data-original-value="${item.emP_CODE}" />
                                        </td>
                                        <td>
                                            <select id="itemCode_${loomRowIndex}" name="itemCode[${loomRowIndex}]" class="form-control Item_Code">
                                                ${itemOptions}
                                            </select>
                                        </td>
                                        <td>
                                            <input type="text" id="denier_${loomRowIndex}" name="denier[${loomRowIndex}]" class="form-control Denier" value="${item.denier}" />
                                        </td>
                                        <td style="width:100px;">
                                            <select id="mashName_${loomRowIndex}" name="mashName[${loomRowIndex}]" class="form-control Mash_Name">
                                                ${mashOptions}
                                            </select>
                                        </td>
                                        <td>
                                            <input type="text" id="empName_${loomRowIndex}" name="empName[${loomRowIndex}]" class="form-control Emp_Name" value="${item.emP_NAME}"/>
                                        </td>
                                    </tr>
                                `;

                                tbody.append(newRow);
                            });

                            let isAllEmpCodeEmpty = true;

                            $('#tblAllocation tbody tr').each(function () {
                                const empCode = $(this).find('.Emp_Code').val()?.trim();
                                if (empCode && empCode !== '') {
                                    isAllEmpCodeEmpty = false;
                                    return false; // exit loop early
                                }
                            });

                            window.isAllEmpCodeEmpty = isAllEmpCodeEmpty;

                            tbody.find('.Emp_Code').off('keydown').on('keydown', function (e) {
                                if (e.key === 'Tab' && !e.shiftKey) {
                                    e.preventDefault();

                                    const $currentInput = $(this);
                                    const currentValue = $currentInput.val().trim();
                                    const $currentRow = $currentInput.closest('tr');
                                    const currentIndex = $currentRow.data('row-index');

                                    const empCodeInt = parseInt(currentValue, 10);
                                    if (isNaN(empCodeInt)) {
                                        toastr.warning('Invalid Employee Code');
                                        $currentInput.focus().select();
                                        return;
                                    }

                                    // 🔍 Validate employee first
                                    $.ajax({
                                        url: '/LoomMonitoringSystemEntry/GetEmpNameBycode',
                                        type: 'GET',
                                        data: {
                                            cCode: compCode,
                                            eCode: empCodeInt
                                        },
                                        success: function (response) {
                                            if (!response.success) {
                                                toastr.warning(response.message || 'Employee not found');
                                                $currentInput.focus().select(); 
                                                return;
