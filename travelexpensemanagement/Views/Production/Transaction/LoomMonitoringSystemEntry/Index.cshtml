@{
    ViewBag.Title = "Loom Monitoring System Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<p class="diamond-heading"><span>Loom Monitoring System</span></p>
<div class="mf-container">
    <!-- Button Group -->
    <div class="mf-btn-group">
        <button class="mf-btn active" onclick="showForm('form1', this)">
            <i class="fa fa-tasks"></i> Allocation
        </button>
        <button class="mf-btn" onclick="showForm('form2', this)" id="HpBtn">
            <i class="fa fa-industry"></i> 2 Hrs Production
        </button>
        <button class="mf-btn" onclick="showForm('form3', this) " id="PpmBtn">
            <i class="fa fa-file-alt"></i> PPM Entry
        </button>
        <button class="mf-btn" onclick="showForm('form4', this)" id="WastageBtn">
            <i class="fa fa-recycle"></i> Wastage Entry
        </button>
        <button class="mf-btn" onclick="showForm('form5', this)">
            <i class="fa fa-bar-chart"></i> Report Details
        </button>
    </div>
    <!-- Form 1 -->
    <div id="form1" class="mf-form-box active">
        <h3>Machine Allocation Data</h3>
        <div class="row">
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="form-group">
                    <label for="DtDateMA">Date</label>
                    <input type="date" class="form-control" id="DtDateMA" />
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="form-group">
                    <label for="ddlShiftMA">Shift</label>
                    <select class="form-control" id="ddlShiftMA">
                        <option value="">Select Shift</option>
                    </select>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="form-group">
                    <label for="TxtBlockMA">Block No</label>
                    @*                     <input type="text" class="form-control" id="TxtBlockMA" placeholder="Enter Block No" value="A" />
 *@                 <select id="TxtBlockMA" class="form-control">
                        <option value="">-- Select Block --</option>
                    </select>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="btn-mt">
                    <button type="button" class="btn btn-success" id="btn_fillMA"><i class="fa fa-pencil-square"></i>Fill</button>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="table-responsive">
                <table id="tblAllocation" class="table-width">
                    <thead class="table-head">
                        <tr>
                            <th style="display:none;">Code</th>
                            <th>Loom No.</th>
                            <th>EmpCode</th>
                            <th>Item Name</th>
                            <th>Denier</th>
                            <th>Mesh</th>
                            <th>Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="display:none;">
                                <input type="hidden" class="form-control" />
                            </td>
                            <td>
                                <select class="form-control" id="Loom_No">
                                    <option value="">-- Select Loom --</option>
                                </select>
                            </td>
                            <td>
                                <select class="form-control" id="Emp_Code">
                                    <option value="">-- Select EmpCode --</option>
                                </select>
                            </td>
                            <td>
                                <select class="form-control" id="Item_Code">
                                    <option value="">-- Select Item --</option>
                                </select>
                            </td>
                            <td>
                                <input type="text" class="form-control" placeholder="Enter Denier" id="Denier" />
                            </td>
                            <td>
                                <select class="form-control" id="Mash_Code">
                                    <option value="">-- Select Mesh --</option>
                                </select>
                            </td>
                            <td>
                                <input type="text" class="form-control" placeholder="Enter Name" />
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- Pagination container -->
            @* <div class="row">
                    <div class="col-md-12">
                        <div class="pagination-end">
                            <div class="custom-pagination" id="tablePagination"></div>
                        </div>
                    </div>
                </div> *@
        </div>
        <div class="row">
            <div class="col-12 col-md-12 col-lg-3 offset-lg-9">
                <div class="btn-mt button-right">
                    <button type="button" class="btn btn-danger" id="btn_cancelMA"><i class="fa fa-close"></i>Cancel</button>
                    <button type="button" class="btn btn-primary" id="btn_saveMA"><i class="fa fa-save"></i>Save</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Form 2 -->
