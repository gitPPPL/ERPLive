@{
    ViewBag.Title = "Lot Master List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentMenu = ViewBag.CurrentMenu as string;
    bool canAdd = false;
    bool canEdit = false;
    bool canDelete = false;
    bool canPrint = false;
    bool canExport = false;
    bool canMail = false;
    bool canApproval = false;
    bool canDocDetail = false;

    foreach (var permission in Model.UserMenuPermissions)
    {
        if (permission.DISPLAY_NAME == ViewBag.CurrentMenu)
        {
            canAdd = Model.UserLevel == 1 || permission._ADD == 1;
            canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
            canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
            canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
            canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
            canMail = Model.UserLevel == 1 || permission._MAIL == 1;
            canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
            canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
            break; 
        }
    }
}
<fieldset>
    <legend class="legend-field">Lot Master List</legend>

    <div class="row">
        <div class="col-lg-3">
            <div class="input-group shadow-sm rounded-pill overflow-hidden">
                <input type="text" id="searchBox" class="form-control border-0" placeholder="Search Module..." aria-label="Search term">
            </div>
        </div>
        <div class="col-lg-9">
            <div class="btn-rightalign">
                @if (canAdd)
                {
                    <button id="btnSave" onclick="window.location.href='@Url.Action("Index", "LotMaster")'" type="button" class="btn btn-add">
                        <i class="fa fa-plus"></i>Add
                    </button>
                }
                @if (canPrint)
                {
                    <button class="btn btn-print" onclick="callGetReportAsPdf()">
                        <i class="fa fa-print"></i> Print
                    </button>
                }
                @if (canExport)
                {
                    <button class="btn btn-export" onclick="exportToExcel()">
                        <i class="fas fa-file-export"></i> Export
                    </button>
                }
                @if (canMail)
                {
                    <button class="btn btn-info">
                        <i class="fa fa-envelope"></i> Mail
                    </button>
                }
                @if (canApproval)
                {
                    <button class="btn btn-export" onclick="Approval()">
                        <i class="fas fa-file-export"></i> Export
                    </button>
                }
            </div>
        </div>
    </div>
    <div class="card">
        <div class="table-responsive">
            <table id="LotMasterList" class="table-width">
                <thead class="table-head">
                    <tr>
                        <th style="display:none;">Code</th>
                        <th>Name</th>
                        <th>ShortName</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="pagination-end">
                    <div class="custom-pagination" id="tablePagination"></div>
                </div>
            </div>
        </div>
    </div>
</fieldset>
<script>

    let currentPage = 1;
    const pageSize = 10;

    $(document).ready(function () {

        loadData();

        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadData();
        });

    });

    //================= Load List With Pagination =================
    function loadData() {
            //show loader
        $('.circle-loader').css('display', 'flex');

        $.ajax({
            url: '/LotMasterList/LoadData',
            type: 'GET',
            data: {
                pageNumber: currentPage,
                pageSize: pageSize,
                searchTerm: $('#searchBox').val()
            },
            success: function (response) {

                if (!response.success) {
                    alert("Failed to load data");
                    return;
                }

                let tbody = $("#LotMasterList tbody");
                tbody.empty();

                const list = response.data;
                const totalCount = response.totalCount;

                if (!list || list.length === 0) {
                    tbody.html(`<tr>
                                   <td colspan="4" class="text-center text-muted">
                                       No records found
                                   </td>
                                </tr>`);
                    renderPagination(0);
                    return;
                }
                $.each(list, function (index, item) {

                    let row = `
                        <tr>
                            <td style="display:none;">${item.code}</td>
                            <td>${item.name || ''}</td>
                            <td>${item.shortName || ''}</td>
                            <td>
                                <i class="fa fa-edit btn-edit" style="cursor:pointer" onclick="editLotMaster(${item.code})"></i>
                                <i class="fa fa-eye btn-view" style="cursor:pointer" onclick="viewLotMasterDetails(${item.code})"></i>
                                <i class="fa fa-trash btn-delete" style="cursor:pointer" onclick="deleteLotMaster(${item.code})"></i>
                            </td>
                        </tr>`;
                    tbody.append(row);
                });

                renderPagination(totalCount);
            },
            error: function (xhr) {
                 let msg = xhr.responseText || "Unexpected error occurred";
                 toastr.error(msg);
            },
            complete: function () {
                //hide loader 
               $('.circle-loader').css('display', 'none');
            }
        });
    }

    //================Render Pagination =================
    function renderPagination(totalCount) {

        const totalPages = Math.ceil(totalCount / pageSize);
        const paginationContainer = $('#tablePagination');
        paginationContainer.empty();

        if (totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;         
        }
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {

            html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1"onclick="goToPage(${i})">${i}</button>`;
                        
        }

        if (currentPage < totalPages) {

            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1"  onclick="goToPage(${totalPages})">Last</button>`;
                       
        }
        paginationContainer.html(html);
    }

    function goToPage(page) {
        currentPage = page;
        loadData();
    }

    //====== Edit ============
    function editLotMaster(code) {
        window.location.href = '/LotMaster/Index?code=' + code;
    }

    //====== View ============
    function viewLotMasterDetails(code) {
        window.location.href = '/LotMaster/Index?code=' + code + '&mode=view';
    }

    //====== Delete ============
    function deleteLotMaster(code) {
        Swal.fire({
            title: "Are you sure?",
            text: "Do you really want to delete this record?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/LotMasterList/DeleteData',
                    type: 'POST',
                    data: { code: code },
                    success: function (response) {

                        if (response.success) {

                            Swal.fire('Deleted','Data has been deleted successfully','success');
                               
                            loadData();
                        }
                        else {
                            Swal.fire('Failed','Failed to delete data','error');          
                        }
                    },
                    error: function () {
                        Swal.fire('Error','An error occurred while deleting','error');         
                    }
                });
            }
        });
    }
</script>