                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="ddlUnit">Unit</label>
                            <select class="form-control" id="ddlUnit">
                                <option value="">Select Unit</option>
                                <option value="">Unit 1</option>
                                <option value="">Unit 2</option>
                                <option value="">Both</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="ddlEmpType">Emp Type</label>
                            <select class="form-control" id="ddlEmpType">
