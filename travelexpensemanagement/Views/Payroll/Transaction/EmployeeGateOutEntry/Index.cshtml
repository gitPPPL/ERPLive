                                <option value="">Staff</option>
                                <option value="">Worker</option>
                                <option value="">Both</option>
                                <option value="">Form 12</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="ddlData">Data</label>
                            <select class="form-control" id="ddlData">
