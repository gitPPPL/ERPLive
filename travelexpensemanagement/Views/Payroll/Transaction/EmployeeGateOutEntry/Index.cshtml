                    <button id="btn_Summary" type="button" class="btn btn-primary"><i class="fa fa-calendar-alt"></i>Summary Day wise</button>
                    <button id="btn_Salary" type="button" class="btn btn-primary"><i class="fa fa-balance-scale"></i>Salary Vs Machine</button>
                    <button id="btn_Duplicate" type="button" class="btn btn-danger"><i class="fa fa-clone"></i>Duplicate Remove</button>
                    <button id="btn_Update" type="button" class="btn btn-success"><i class="fa fa-sync"></i>Update Out</button>
