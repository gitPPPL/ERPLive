                        <select class="form-control" id="ddlEmpCode" style="width:50%">
                            <option value="">Select Emp Code</option>
                        </select>
                        <input type="text" id="TxtEmpName" class="form-control" readonly />
                        <input type="hidden" id="TxtDeptCode" class="form-control" readonly />

                        @* <select class="form-control" id="TxtEmpName">
                            <option value="">Select Emp Name</option>
                        </select> *@
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtDeptName">Dept Name</label>
                    <input type="text" class="form-control" id="TxtDeptName" value="Take Up Section">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtRemarks">Remarks</label>
                    <input type="text" class="form-control" id="TxtRemarks" value="Duty Off">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-2">
                <div class="form-group">
                    <label for="TxtOutTime">Out Time</label>
                    <input type="time" class="form-control" id="TxtOutTime">
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="TxtInTime">In Time</label>
                    <input type="time" class="form-control" id="TxtInTime">
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="ddlHodCode">HOD Code</label>
                    <div class="input-divide">
                        <select class="form-control" id="ddlHodCode" style="width:50%">
                            <option value="">Select HOD Code</option>
                        </select>
                        <input type="text" id="TxtHodName" class="form-control" readonly />
                        @* <select class="form-control" id="TxtHodName">
                            <option value="">Select HOD Name</option>
                        </select> *@
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="ddlOutType">Out Type</label>
                    <select class="form-control" id="ddlOutType">
                        <option value="">Select Out Type</option>
                        <option>Absent</option>
                        <option>Admin</option>
                        <option>Company Work</option>
                        <option>Extra Duty</option>
                        <option>Gate Return</option>
                        <option>Late Come</option>
                        <option>Machine Problem</option>
                        <option>New Joining</option>
                        <option>OD</option>
                        <option>Personal Work</option>
                        <option>Present</option>
                        <option>Wrong Entry</option>
                        <option>Sleeping Deduction</option>
                        <option>Negligence</option>

                    </select>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="TxtGpNo">Gp No</label>
                    <input type="text" class="form-control" id="TxtGpNo">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-12">
                        <div class="table-bg" style="height:305px;">
