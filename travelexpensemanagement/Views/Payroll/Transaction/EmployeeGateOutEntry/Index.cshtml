        <div class="row">
            <div class="col-md-3">
                <div class="btn-mt">
                    <button id="btn_GateShift" type="button" class="btn btn-primary"><i class="fa fa-exchange"></i>Gate Shift</button>
                    <button id="btn_Inout" type="button" class="btn btn-primary"><i class="fa fa-sign-in-alt"></i>In/Out</button>
                </div>            
            </div>
            <div class="col-md-2">
                <div class="form-group btn-mt">
                    <div class="form-row">
                        <input type="checkbox" id="chkLateOnly">
                        <label class="checkbox-label" for="chkLateOnly">Late Only</label>
                    </div>
                </div>
