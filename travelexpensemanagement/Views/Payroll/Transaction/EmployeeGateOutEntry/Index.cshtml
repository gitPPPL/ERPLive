<script src="~/js/GlobalFunction.js" asp-append-version="true"></script>

<script>
 
    const allFieldIds = [
        'ddlDocType',
        'NumDocNo',
        'DtDocDate',
        'ddlShift',
        'ddlEmpCode',
        'TxtEmpName',
        'TxtDeptName',
        'TxtRemarks',
        'TxtOutTime',
        'TxtInTime',
        'ddlHodCode',
        'TxtHodName',
        'ddlOutType',
        'TxtGpNo',
        'DtFrom',
        'DtTo',
        'ddlUnit',
        'ddlEmpType',
        'ddlData',
        'ddlDepartment'
    ]; 

    let docId = "", readOnly;
    function getQueryParam(param) {
      return new URLSearchParams(window.location.search).get(param);
    }
    $(document).ready(function () {
      initPage();
    });

    async function initPage() {
      try {
        await handleDocLoad();
        setEnterKeyFocus(allFieldIds);
        wireEvents();
    } catch (err) {
        toastr.error('Initialization failed: ' + err);
    }
    }

    function wireEvents() {

      $('#btn-save').on('click', async (e) => {
        e.preventDefault();

        try {
          const data = await collectFormData();
          console.log(data);           
          docId ? UpdateData(data) : SaveData(data);
        } catch (err) {
          toastr.error("Error saving data: " + err);
        }

      });
  

    $(document).on('change', '#ddlEmpCode', function() {
        var selectedOption = $(this).find('option:selected');
        var empName = selectedOption.data('name');
        $('#TxtEmpName').val(empName);  
    });

    $(document).on('change', '#ddlHodCode', function() {
        var selectedOption = $(this).find('option:selected');
        var hodName = selectedOption.data('name');
        $('#TxtHodName').val(hodName);
    });

    $('#ddlDepartment').on('change', function () {
        let selectedDepartName = $('#ddlDepartment option:selected').text();
        let selectedDepartCode = $('#ddlDepartment').val();
        if (!selectedDepartCode) return;

        if (isItemAlreadyAdded(selectedDepartCode)) {
            toastr.warning("is already added" , selectedDepartName);
            $('#ddlItem').val("");
            return;
        }
            $('#itemTable tbody').append(`
                <tr data-code="${selectedDepartCode}">
                    <td>${selectedDepartCode}</td>
                    <td>${selectedDepartName}</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-light btn-itemRemove">
                            <i class="fas fa-trash btn-delete" data-bs-toggle="tooltip" title="Delete"></i>
                        </button>
                    </td>
                </tr>
            `);
            $('#ddlItem').val("");

    });

    function isItemAlreadyAdded(itemCode) {
        return $('#itemTable tbody tr').filter(function () {
            return $(this).data('code') == itemCode;
        }).length > 0;
    }

    $(document).on('click', '#itemTable .btn-itemRemove', function () {
        $(this).closest('tr').remove();
    });


    }

</script>

<script>

    async function handleDocLoad() {
            docId = getQueryParam('id');
            readOnly = getQueryParam('readOnly');
            if (docId) {
                $('#ddlDocType').prop('disabled', true);
                await GetDocData(docId, readOnly);

            } else {
                await GetDocTypeAsync();
                 const Doctypeval = $('#ddlDocType').val();
                GetDocid(Doctypeval);
                const today = new Date();
                const todayDate = today.getFullYear() + '-' +
                    (today.getMonth() + 1).toString().padStart(2, '0') + '-' +
                    today.getDate().toString().padStart(2, '0');
                    $('#DtDocDate').val(todayDate);
                    $('#DtFrom').val(todayDate);
                    $('#DtTo').val(todayDate);
                   GetshiftList();
                   GetEmployeeList();
                   GetHodList();
                   GetDepartmentList();
            }
    }

    function SaveData(saveDt) {
                $.ajax({
                    url: '@Url.Action("SaveOrUpdateGateInOutEntry", "EmployeeGateOutEntry")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(saveDt),
                    success: function (response) {
                        if (response?.status) {
                            toastr.success("Data Insert successfully");
                            setTimeout(() => {
                                window.location.href = '/EmployeeGateOutList/Index';
                            }, 1500);
                        } else {
                            toastr.error(response?.message || "Save failed. Please try again.");
                        }
                    },
                    error: function () {
                        toastr.error("Error occurred while saving. Please contact admin.");
                    }
                });
    }

    function UpdateData(UpdateDt) {
        $.ajax({
            url: '@Url.Action("SaveOrUpdateGateInOutEntry", "EmployeeGateOutEntry")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(UpdateDt),
            dataType: 'json',
            success: function (response) {
                if (response?.status) {
                   toastr.success("Data Update successfully");
                    // showFlashMessageByKey('update', 'success');
                    setTimeout(() => {
                        window.location.href = '/EmployeeGateOutList/Index';
                    }, 1500);
                } else {
                    toastr.error("Update failed: " + (response?.message || "Unknown error."));
                }
            },
            error: function (xhr, status, error) {
                toastr.error("Data not updated: " + error);
            }
        });
    }

    async function fillHeaderData(datas) {        
        const data=datas[0];
         console.log(data);
         GetshiftList(data.SHIFT ?? "");
         GetEmployeeList(data.EMP_CODE ?? "");
         GetHodList(data.HOD_CODE ?? "");
         GetDepartmentList(data.DEPT_CODE ?? "");

        $("#TxtDocId").val(data.DOC_ID ?? "");
        $("#NumDocNo").val(data.V_NO ?? 0);
        $('#ddlDocType').val(data.V_TYPE ?? "");
        $('#DtDocDate').val(data.V_DATE ? data.V_DATE.substring(0, 10) : "");
        // $('#ddlShift').val(data.SHIFT ?? "");
        // $('#ddlEmpCode').val(data.EMP_CODE ?? "");
        $('#TxtEmpName').val(data.EMP_NAME ?? "");
        $('#ddlUnit').val("");
        // $('#TxtDeptCode').val(data.DEPT_CODE ?? "");
        $('#TxtDeptName').val(data.DEPT_NAME ?? "");
        $('#TxtRemarks').val(data.REMARKS ?? "");
        $('#DtFrom').val(data.V_DATE ? data.V_DATE.substring(0, 10) : "");
        $('#DtTo').val(data.V_DATE ? data.V_DATE.substring(0, 10) : "");
        $('#TxtOutTime').val(data.E_TIME ?? "");
        $('#TxtInTime').val(data.IN_TIME ?? "");
        $('#TxtGpNo').val(data.GP_NO ?? "");
        // $('#ddlHodCode').val(data.HOD_CODE ?? "");
        $('#ddlOutType').val(data.REASON_CODE ?? "");
        $('#ddlEmpType').val("");
        $('#ddlDepartment').val(data.DEPT_CODE ?? "");
    }

    
    async function collectFormData() {       
        const DOC_ID = toNullableString(document.getElementById("TxtDocId")?.value);
        const data = {
        VType: $('#ddlDocType').val(),
        VNo: parseInt($('#NumDocNo').val()),
        VDate: new Date($('#DtDocDate').val()),       
        Shift: $('#ddlShift').val(),
        EmpCode: $('#ddlEmpCode').val(),
        EmpName: $('#TxtEmpName').val(),
        DeptCode: $('#ddlUnit').val(),
        DeptName: $('#TxtDeptName').val(),
        Remarks: $('#TxtRemarks').val(),
        EDate: new Date($('#DtFrom').val()),
        ETime: $('#TxtOutTime').val(),
        InTime: $('#TxtInTime').val(),
        GpNo: $('#TxtGpNo').val(),
        DeduHrs: parseFloat($('#TxtOutTime').val()),
        HodCode: $('#ddlHodCode').val(),
        HodName: $('#TxtHodName').val(),
        ReasonCode: $('#ddlOutType').val(),
        GpType: $('#ddlEmpType').val(),
        GpHrs: 0,
        LateHrs: 0,
        SleepHrs: 0,
        WorkplacePlace: $('#ddlDepartment').val(),
        WorkplaceCode: $('#ddlDepartment').val(),
        Approve: false,
        DocId: DOC_ID,
        SaveOrUpdate: (!DOC_ID || DOC_ID === "") ? "Save" : "Update"
             
        };
        return data;
    }
  
    function GetDocTypeAsync(selectedValue) {
          return new Promise((resolve, reject) => {
              $.ajax({
                  url: '@Url.Action("GetDocType", "EmployeeGateOutEntry")',
                  type: 'GET',
                  dataType: 'json',
                  success: function (response) {
                      if (response.status) {
                          const $dropdown = $('#ddlDocType');
                          $dropdown.empty();
                          $.each(response.data, function (index, item) {
                              $dropdown.append(`<option value="${item.CODE}">${item.NAME}</option>`);
                          });

                          if (selectedValue && $dropdown.find(`option[value="${selectedValue}"]`).length > 0) {
                              $dropdown.val(selectedValue).trigger('change');
                          } else {
                              $dropdown.prop('selectedIndex', 0);
                          }

                          resolve();
                      } else {
                          reject("Invalid response status.");
                      }
                  },
                  error: function (xhr, status, error) {
                      toastr.error("Document Type Load failed: " + error);
                      reject(error);
                  }
              });
          });
    }

    function GetDocid(Doctypeval) {
        $.ajax({
            url: '@Url.Action("GetMaxVNo", "EmployeeGateOutEntry")',
            type: 'GET',
            data:{vtype:Doctypeval},
            success: function (response) {
                if (response.status === true && response.data) {
                    $('#NumDocNo').val(response.data.vNo || '');
                    $('#TxtDocId').val(response.data.docId || '');
                } else {
                    $('#NumDocNo').val('');
                    $('#TxtDocId').val('');
                }
            },
            error: function (xhr, status, error) {
                toastr.error('Error fetching Doc ID:', error);
            }
        });
    }

    async function GetDocData(MasterTblId, readOnly) {
        try {
            const response = await $.ajax({
                url: '/EmployeeGateOutEntry/GetGateInOutDataForUpdate',
                type: 'GET',
                data: { id: MasterTblId }
            });
            if (response.status) {
                console.log(response.data);
                await fillHeaderData(response.data);
                // await fillItemDetailTable(response.data);
                if (readOnly === 'true') {
                    $('#btn-save, #cancelBtn').hide();
                    disableAllFields();
                } else {
                    $('#btn-save, #cancelBtn').show();
                    enableAllFields();
                }
            } else {
                toastr.error('No data returned.');
            }
        } catch (error) {
            toastr.error('Failed to load data.');
            console.error(error);
        }
    }
   
    function GetshiftList(selectedValue=null) {
        $.ajax({
            url: '@Url.Action("GetShiftList", "EmployeeGateOutEntry")',
            type: 'GET',
            dataType: 'json',
            success: function (response) {
                if (response.status) {
                    const $DropdownId = $('#ddlShift');
                    $DropdownId.empty();
                    $DropdownId.append('<option value="">- Select Shift -</option>');

                    $.each(response.data, function (index, item) {
                        $DropdownId.append(`
                            <option value="${item.NAME}">${item.NAME}</option>
                        `);
                    });

                    $DropdownId.select2({
                        placeholder: "- Select -",
                        allowClear: true
                    });

                    if (selectedValue && $DropdownId.find(`option[value="${selectedValue}"]`).length > 0) {
                        $DropdownId.val(selectedValue).trigger('change');
                    }
                    else {
                        $DropdownId.val('').trigger('change');
                    }

                } else {
                    toastr.error("data Load failed");
                }
            },
            error: function (xhr, status, error) {
                toastr.error("data Load failed", error);
            }
        });
    }

    function GetEmployeeList(selectedValue=null) {
        $.ajax({
            url: '@Url.Action("GetEmployeeList", "EmployeeGateOutEntry")',
            type: 'GET',
            dataType: 'json',
            success: function (response) {
                if (response.status) {
                    const $DropdownId = $('#ddlEmpCode');
                    $DropdownId.empty();
                    $DropdownId.append('<option value="">- Select Shift -</option>');

                    $.each(response.data, function (index, item) {
                        $DropdownId.append(`
                            <option data-name="${item.NAME}" value="${item.CODE}">${item.CODE} || ${item.NAME}</option>
                        `);
                    });

                    $DropdownId.select2({
                        placeholder: "- Select -",
                        allowClear: true
                    });

                    if (selectedValue && $DropdownId.find(`option[value="${selectedValue}"]`).length > 0) {
                        $DropdownId.val(selectedValue).trigger('change');
                    }
                    else {
                        $DropdownId.val('').trigger('change');
                    }

                } else {
                    toastr.error("data Load failed");
                }
            },
            error: function (xhr, status, error) {
                toastr.error("data Load failed", error);
            }
        });
    }

    function GetHodList(selectedValue=null) {
