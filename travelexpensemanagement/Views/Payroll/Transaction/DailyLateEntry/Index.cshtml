@{
    ViewBag.Title = "Daily Late Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    #tblExtraDutyEntry td,
    #tblExtraDutyEntry th {
        min-width: 70px;
        max-width: 150px;
        word-wrap: break-word;
    }

</style>
<fieldset>
    <legend class="legend-field">Daily Late Entry</legend>
    <form id="DailyLateEntryForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlDocType">Doc Type</label>
                    <select class="form-control" id="ddlDocType">
                        @* <option value="">Select Doc Type</option> *@
                    </select>
                </div>
            </div>
            <div class="col-md-3"> 
                <div class="form-group">
                    <label for="NumDocNo">Doc No</label>
                    <input type="number" class="form-control" id="NumDocNo" placeholder="Enter Doc No">
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="DtDocDate">Doc Date</label>
                    <input type="date" class="form-control" id="DtDocDate" />   
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <button type="button" class="btn btn-secondary" id="btnAddRow">Add Row</button>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="offset-md-6 col-md-3">
                <label class="checkbox-input-mt">
                    <input type="checkbox" id="ChkMachineData" />
                    Machine Data
                </label>
            </div>
            <div class="col-md-3">
                <div class="btn-mt button-right">
                    <button id="btn_Late" type="button" class="btn btn-success"><i class="fa fa-download"></i>Late</button>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="table-responsive">
                <table id="tblExtraDutyEntry" class="table-width">
                    <thead class="table-head">
                        <tr>
                            <th style="display:none;">Code</th>
                            <th>Employee Code</th>
                            <th>Employee Name</th>
                            <th>Before</th>
                            <th>After</th>
                            <th>Shift</th>
                            <th>In Time</th>
                            <th>Out Time</th>
                            <th>Reason</th>
                            <th>HOD Name</th>
                            <th>Auth.By</th>
                            <th>Deduct</th>
                            <th>Remarks</th>
                            <th>Dur</th>
                            <th>Mac Time</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <!-- Pagination container -->
            <div class="row">
                <div class="col-md-12">
                    <div class="pagination-end">
                        <div class="custom-pagination" id="tablePagination"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="offset-md-8 col-md-4">
                <div class="btn-mt button-right">
                    <button id="btn-save" type="button" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
                    <button id="btn_cancel" type="button" class="btn btn-danger"><i class="fa fa-close"></i>Cancel</button>
                </div>
            </div>
        </div>
    </form>
</fieldset>
<script>
    // Global Variable getting from controller
    var compCode = '@ViewBag.CompCode';
    var branchCode = '@ViewBag.BranchCode';
    var yearCode = '@ViewBag.YearCode';
    
    const reasonList = ["Company Work", "Late Come", "Personal Work"];
    const deductList = ["Yes", "No"];

    let empMap = {};
    let hodMap = {};
    let shiftList = [];
    let debounceTimer;

    $(document).ready(function () {
        const today = new Date().toISOString().split('T')[0];
        $('#DtDocDate').val(today);
        loadNextDocNo(yearCode);
        loadDocTypeList();

        let shiftPromise = bindShiftList(compCode);
        let hodPromise = bindHodList(compCode);
        let empPromise = loadEmployeeList(compCode);
           
        $.when(shiftPromise, hodPromise, empPromise).done(function () {
            addEmptyEditableRow();
        });
    });

    function addEmptyEditableRow() {
        const shiftOptions = shiftList.map(s => `<option value="${s}">${s}</option>`).join('');
        const reasonOptions = reasonList.map(r => `<option value="${r}">${r}</option>`).join('');
        const deductOptions = deductList.map(d => `<option value="${d}" ${d === "Yes" ? "selected" : ""}>${d}</option>`).join('');
        const hodOptions = Object.entries(hodMap).map(([code, name]) => `<option value="${code}">${name}</option>`).join('');
        const empOptions = Object.entries(empMap).map(([code, name]) => `<option value="${code}">${code} - ${name}</option>`).join('');

        const tdStyle = `style="min-width:70px; max-width:150px;"`;

        const row = `
        <tr>
            <td style="display:none;"></td>
            <td ${tdStyle}>
                <select class="form-control emp-code-select">
                    <option value="">Select Employee</option>
                    ${empOptions}
                </select>
            </td>
            <td ${tdStyle}><input type="text" class="form-control emp-name-input" readonly /></td>
            <td ${tdStyle}><input type="text" class="form-control bhrs-input" /></td>
            <td ${tdStyle}><input type="text" class="form-control ahrs-input" /></td>
                <td ${tdStyle}>
                <select class="form-control shift-select">
                    ${shiftOptions}
                </select>
            </td>
            <td ${tdStyle}><input type="time" class="form-control in-time-input" /></td>
            <td ${tdStyle}><input type="time" class="form-control out-time-input" /></td>
            <td ${tdStyle}>
                <select class="form-control reason-select">
                    ${reasonOptions}
                </select>
            </td>
            <td ${tdStyle}>
                <select class="form-control hod-select">
                    ${hodOptions}
                </select>
            </td>
            <td ${tdStyle}><input type="text" class="form-control auth-by-input" readonly /></td>
            <td ${tdStyle}>
                <select class="form-control deduct-select">
                    ${deductOptions}
                </select>
            </td>
            <td ${tdStyle}><input type="text" class="form-control remark-input" /></td>
            <td ${tdStyle}><input type="text" class="form-control extra1-input" /></td>
            <td ${tdStyle}><input type="text" class="form-control extra2-input" /></td>
            <td ${tdStyle}>
                <button type="button" class="btn btn-sm btn-danger btn-delete-row">
                    <i class="fa fa-trash"></i>
                </button>
            </td>
        </tr>
        `;

        $('#tblExtraDutyEntry tbody').append(row);
    }

