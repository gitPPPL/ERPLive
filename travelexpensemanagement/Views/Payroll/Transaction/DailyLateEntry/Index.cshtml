    $('#tblExtraDutyEntry').on('change', '.emp-code-select', function () {
        const empCode = $(this).val();
        const empName = empMap[empCode] || '';
        $(this).closest('tr').find('.emp-name-input').val(empName);
    });

    $('#tblExtraDutyEntry').on('change', '.hod-select', function () {
        const selectedCode = $(this).val();
        const hodName = hodMap[selectedCode] || '';
        $(this).closest('tr').find('.auth-by-input').val(hodName);
    });

    function loadNextDocNo(yearC){
        $.ajax({
            url: '/DailyLateEntry/GetNextV_NO',
            type: 'GET',
            data: { yearCode : yearC },
            success: function (response) {
                $('#NumDocNo').val(response);
            },
            error: function (xhr, status, error) {
                toastr.error('Error loading Item make: ' + error);
            }
        });
    }

    function loadDocTypeList() {
        docTypeMap = {};
        return $.ajax({
            url: '/DailyLateEntry/GetDocTypeList',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var ddl = $('#ddlDocType');
                ddl.empty();

                $.each(data, function (index, item) {
                    ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                    docTypeMap[item.value] = item.text;
                });
            },
            error: function (xhr, status, error) {
                toastr.error('Error loading DocType list: ' + error);
            }
        });
    }

    function bindShiftList(compCode) {
        return $.ajax({
            url: '/DailyLateEntry/shiftList',
            type: 'GET',
            data: { cCode: compCode },
            success: function (data) {
                shiftList = data.map(item => item.value);

                var $ddl = $('#ddlShift');
                if ($ddl.length) {
                    $ddl.empty();
                    $ddl.append($('<option>').val('').text('Select Shift'));
                    $.each(data, function (i, item) {
                        $ddl.append($('<option>').val(item.value).text(item.text));
                    });
                }
            },
            error: function (xhr, status, error) {
                console.error('Error loading shift list:', error);
            }
        });
    }

    function bindHodList(compCode) {
        return $.ajax({
            url: '/DailyLateEntry/HodList',
            type: 'GET',
            data: { cCode: compCode },
            success: function (data) {
                hodMap = {};
                data.forEach(item => {
                    hodMap[item.value] = item.text;
                });

                var $ddl = $('#ddlHod');
                if ($ddl.length) {
                    $ddl.empty();
                    $ddl.append($('<option>').val('').text('Select HOD'));
                    $.each(data, function (i, item) {
                        $ddl.append($('<option>').val(item.value).text(item.text));
                    });
                }
            },
            error: function (xhr, status, error) {
                console.error('Error loading HOD list:', error);
            }
        });
    }

    function loadEmployeeList(cCode) {
        return $.ajax({
            url: '/DailyLateEntry/empList',
            type: 'GET',
            data: { cCode: cCode },
            success: function(data) {
                empMap = {};  

                let options = '<option value="">Select Employee</option>';
                data.forEach(function(emp) {
                    empMap[emp.value] = emp.text;
                    options += `<option value="${emp.value}">${emp.value}}</option>`;
                });

                $('.emp-code-select').each(function () {
                    $(this).html(options);
                });

                $('#ddlEmployee').html(options);
            },
            error: function() {
                alert('Failed to load employee list.');
            }
        });
    }

    $('#tblExtraDutyEntry').on('input', '.emp-code-input', function () {
        const $this = $(this);
        const empCode = $this.val().trim();

        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
            if (!empCode) {
                $this.closest('tr').find('.emp-name-input').val('');
                return;
            }

            $.ajax({
                url: '/DailyLateEntry/GetEmployeeNameByCode',
                type: 'GET',
                data: { empCode: empCode, compCode: compCode },
                success: function (response) {
                    const empName = response?.Name || '';
                    $this.closest('tr').find('.emp-name-input').val(empName);
                },
                error: function () {
                    console.error("Failed to fetch employee name");
                    $this.closest('tr').find('.emp-name-input').val('');
                }
            });
        }, 300); 
    });

    $('#btn_Late').on('click', function () {
        loadGatePassData();
    });

    function loadGatePassData() {
        var docDate = $('#DtDocDate').val();
        var docNo = $('#NumDocNo').val();
        var docType = $('#ddlDocType').val();

        if (!docDate || !docNo || !docType) {
            toastr.warning("Please select Doc Type, Doc No and Doc Date.");
            return;
        }

        $.ajax({
            url: '/DailyLateEntry/GetGatePassList',
            type: 'GET',
            data: {
                docDate: docDate,
                docNo: docNo,
                docType: docType
            },
            success: function (data) {
                console.log(data);
                populateGatePassTable(data);
            },
            error: function (xhr, status, error) {
                toastr.error('Failed to load GatePass data: ' + error);
            }
        });
    }

    function populateGatePassTable(data) {
        const tdStyle = `style="min-width:70px; max-width:150px;"`;
        const tbody = $('#tblExtraDutyEntry tbody');
        tbody.empty();

        if (!data || data.length === 0) {
            addEmptyEditableRow();
            return;
        }

        // Dropdown option lists
        const shiftOptions = shiftList.map(s =>
            `<option value="${s}">${s}</option>`).join('');

        const reasonOptions = reasonList.map(r =>
            `<option value="${r}">${r}</option>`).join('');

        const deductOptions = deductList.map(d =>
            `<option value="${d}">${d}</option>`).join('');

        const hodOptions = Object.entries(hodMap).map(([code, name]) =>
            `<option value="${code}">${name}</option>`).join('');

        const empOptions = Object.entries(empMap).map(([code, name]) =>
            `<option value="${code}">${code} - ${name}</option>`).join('');

        $.each(data, function (index, item) {
            const macTime = (item.maC_IN || item.maC_OUT)
                ? `${item.maC_IN || 'N/A'} - ${item.maC_OUT || 'N/A'}`
                : '';

            const row = `
                <tr>
                    <td style="display:none;">${item.sno || ''}</td>
                    
                    <!-- Employee Code dropdown -->
                    <td ${tdStyle}>
                        <select class="form-control emp-code-select">
                            <option value="">Select</option>
                            ${empOptions}
                        </select>
                    </td>

                    <!-- Employee Name (readonly) -->
                    <td ${tdStyle}><input type="text" class="form-control emp-name-input" value="${item.emP_NAME || ''}" readonly /></td>

                    <!-- Before Hours -->
                    <td ${tdStyle}><input type="number" step="0.01" class="form-control bhrs-input" value="${item.bhrs ?? '0'}" /></td>

                    <!-- After Hours -->
                    <td ${tdStyle}><input type="number" step="0.01" class="form-control ahrs-input" value="${item.ahrs ?? '0'}" /></td>

                    <!-- Shift dropdown -->
                    <td ${tdStyle}>
                        <select class="form-control shift-select">
                            ${shiftOptions}
                        </select>
                    </td>

                    <!-- In Time -->
                    <td ${tdStyle}><input type="time" class="form-control in-time-input" value="${item.iN_TIME || ''}" /></td>

                    <!-- Out Time -->
                    <td ${tdStyle}><input type="time" class="form-control out-time-input" value="${item.ouT_TIME || ''}" /></td>

                    <!-- Reason dropdown -->
                    <td ${tdStyle}>
                        <select class="form-control reason-select">
                            ${reasonOptions}
                        </select>
                    </td>

                    <!-- HOD dropdown -->
                    <td ${tdStyle}>
                        <select class="form-control hod-select">
                            ${hodOptions}
                        </select>
                    </td>

                    <!-- Auth By (readonly) -->
                    <td ${tdStyle}><input type="text" class="form-control auth-by-input" value="${item.autH_BY || ''}" readonly /></td>

                    <!-- Deduct dropdown -->
                    <td ${tdStyle}>
                        <select class="form-control deduct-select">
                            ${deductOptions}
                        </select>
                    </td>

                    <!-- Remark -->
                    <td ${tdStyle}><input type="text" class="form-control remark-input" value="${item.remark || ''}" /></td>

                    <!-- Duration -->
                    <td ${tdStyle}><input type="text" class="form-control extra1-input" value="${item.dur ?? '0'}" /></td>

                    <!-- Mac Time -->
                    <td ${tdStyle}><input type="text" class="form-control extra2-input" value="${macTime}" /></td>
                    <td ${tdStyle}>
                        <button type="button" class="btn btn-sm btn-danger btn-delete-row">
                            <i class="fa fa-trash"></i>
                        </button>
                    </td>
                </tr>
            `;

            tbody.append(row);

            const $lastRow = tbody.find('tr').last();
            $lastRow.find('.emp-code-select').val(item.emP_CODE);
            $lastRow.find('.shift-select').val(item.shift || '');
            $lastRow.find('.reason-select').val(item.reason || '');
            $lastRow.find('.hod-select').val(item.hoD_CODE || '');
            $lastRow.find('.deduct-select').val(item.deduct || 'No');
        });
    }

    $('#tblExtraDutyEntry').on('click', '.btn-delete-row', function () {
        $(this).closest('tr').remove();
    });


    $('#tblExtraDutyEntry').on('input', '.emp-code-input', function () {
        const empCode = $(this).val().trim();
        const empName = empMap[empCode] || '';
        $(this).closest('tr').find('.emp-name-input').val(empName);
    });

    $('#tblExtraDutyEntry').on('change', '.hod-select', function () {
        const selectedCode = $(this).val();
        const hodName = hodMap[selectedCode] || '';
        $(this).closest('tr').find('.auth-by-input').val(hodName);
    });

    $('#btnAddRow').on('click', function () {
        debugger;
        var newRow = $('#tblExtraDutyEntry tbody tr:first').clone();
        newRow.find('input').val('');
        $('#tblExtraDutyEntry tbody').append(newRow);
    });

    $('#btn-save').on('click', function () {
        saveLateDaily();
    });

    function saveLateDaily() {
        function parseDecimal(value) {
            const n = parseFloat(value);
            return isNaN(n) ? null : n;
        }

        var gatePassList = [];

        $('#tblExtraDutyEntry tbody tr').each(function () {
            const $row = $(this);
            const item = {
                V_TYPE: $('#ddlDocType').val() || "",
                V_DATE: $('#DtDocDate').val(),
                V_NO: $('#NumDocNo').val(),
                EMP_CODE: $row.find('.emp-code-select').val() || "",
                EMP_NAME: $row.find('.emp-name-input').val() || "",
                BHRS: parseDecimal($row.find('.bhrs-input').val()),
                AHRS: parseDecimal($row.find('.ahrs-input').val()),
                SHIFT: $row.find('.shift-select').val() || "",
                IN_TIME: $row.find('.in-time-input').val() || "",
                OUT_TIME: $row.find('.out-time-input').val() || "",
                REASON: $row.find('.reason-select').val() || "",
                HOD_CODE: $row.find('.hod-select').val() || "",
                AUTH_BY: $row.find('.auth-by-input').val() || "",
                DEDUCT: $row.find('.deduct-select').val() || "",
                REMARK: $row.find('.remark-input').val() || "",
                DUR: $row.find('.extra1-input').val() || "",

                MAC_IN: ($row.find('.extra2-input').val() || "").substring(0, 8),
                MAC_OUT: ($row.find('.extra3-input').val() || "").substring(0, 8)
            };
            gatePassList.push(item);
        });

        console.log(gatePassList);

        $.ajax({
            url: '/DailyLateEntry/SaveGatePassList',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(gatePassList),
            success: function (response) {
                toastr.success('Saved successfully');
                setTimeout(() => {
                    location.reload();
                }, 2000);
            },
            error: function (xhr) {
                toastr.error('Save failed: ' + xhr.responseText);
            }
        });
    }


