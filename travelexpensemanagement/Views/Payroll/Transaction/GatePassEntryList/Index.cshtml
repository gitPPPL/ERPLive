@{
    ViewBag.Title = "Gate Pass Entry List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
    <legend class="legend-field">Gate Pass Entry List</legend>
    <div class="row">
        <div class="col-lg-4">
            <div class="input-group">
                <input type="text" id="searchBox" class="form-control" placeholder="Search Module..." aria-label="Search term">
            </div>
        </div>
        <div class="col-lg-8">
            <div class="btn-align">
                <button id="btnSave" onclick="window.location.href='@Url.Action("Index", "GatePassEntry")'" type="submit" class="btn btn-primary">
                    <i class="fa fa-add"></i>Add 
                </button>
                <button class="btn btn-print">
                    <i class="fa fa-print"></i> Print
                </button>
                <button class="btn btn-export">
                    <i class="fas fa-file-export"></i> Export
                </button>
                <button class="btn btn-mail">
                    <i class="fa fa-envelope"></i> Mail
                </button>
                <button class="btn btn-approved">
                    <i class="fa fa-check"></i> Approved
                </button>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="table-responsive">
            <table id="tblGatePassList" class="table-width">
                <thead class="table-head">
                    <tr>
                        <th>Gate Pass Type</th>
                        <th>V_No</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
	<div class="row">
		<div class="col-md-12">
			<div class="pagination-end">
				<div class="custom-pagination" id="tablePagination"></div>
			</div>
		</div>
	</div>
</fieldset>
<script>

	let currentPage = 1;
	let pageSize = 10;

	$(document).ready(function () {
		loadDocumentStages();
		$('#searchBox').on('keyup', function () {
			currentPage = 1;
			loadDocumentStages();
		});
	});

	  function loadDocumentStages() {
		const searchTerm = $('#searchBox').val();

		$.ajax({
			url: '/GatePassEntryList/GetList',
			type: 'GET',
			dataType: 'json',
			data: {
				searchTerm: searchTerm,
				pageNumber: currentPage,
				pageSize: pageSize
			},
			success: function (res) {
				const docs = res.lists || [];
				const totalCount = res.totalCount || 0;

				console.log('jj', docs);

				const tbody = $('#tblGatePassList tbody');
				tbody.empty();

				if (docs.length === 0) {
					tbody.append(`<tr><td colspan="5" class="text-center text-muted">No records found.</td></tr>`);
					renderPagination(0, pageSize, currentPage);
					return;
				}

				docs.forEach(doc => {
					const formattedDate = doc.v_DATE ? new Date(doc.v_DATE).toLocaleDateString() : '';
					tbody.append(`
						<tr>
							<td style="display:none;">${doc.doC_ID}</td>
							<td>${doc.v_TYPE || ''}</td>
							<td>${doc.v_NO || ''}</td>
							<td>${formattedDate}</td>
							<td>
								<div class="action-icons">
									<i class="fa fa-edit btn-edit" title="Edit" onclick="AddOrEditFunction('${doc.doC_ID}')"></i>
									<i class="fa fa-eye btn-view" title="View" onclick="viewMenuDetails('${doc.doC_ID}')"></i>
									<i class="fa fa-trash btn-delete" title="Delete" onclick="deleteDocStage('${doc.doC_ID}')"></i>
								</div>
							</td>
						</tr>
					`);
				});

				renderPagination(totalCount, pageSize, currentPage);
			},
			error: function (xhr) {
				toastr.error('Error loading document stages: ' + (xhr.responseJSON?.message || xhr.statusText));
			}
		});
	}



	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const paginationContainer = $('#tablePagination');
		paginationContainer.empty();

		if (total <= 0 || totalPages <= 1) return;

		let paginationHtml = '';

		if (currentPage > 1) {
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		let startPage = Math.max(1, currentPage - 2);
		let endPage = Math.min(totalPages, currentPage + 2);

		if (currentPage <= 3) endPage = Math.min(5, totalPages);
		if (currentPage >= totalPages - 2) startPage = Math.max(totalPages - 4, 1);

		for (let i = startPage; i <= endPage; i++) {
			paginationHtml += `
				<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1"
						onclick="goToPage(${i})">${i}</button>`;
		}

		if (currentPage < totalPages) {
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		paginationContainer.html(paginationHtml);
	}

	function goToPage(page) {
		currentPage = page;
		loadDocumentStages();
	}

	function AddOrEditFunction(rowId) {
		window.location.href = '/GatePassEntry/Index?id=' + encodeURIComponent(rowId);
	}

	function viewMenuDetails(rowId) {
		window.location.href = '/GatePassEntry/Index?id=' + encodeURIComponent(rowId) + '&readOnly=true';
	}

	function deleteDocStage(code) {
		
		Swal.fire({
			title: 'Are you sure?',
			text: "You won't be able to revert this deletion!",
			icon: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#d33',
			cancelButtonColor: '#3085d6',
			confirmButtonText: 'Yes, delete it!'
		}).then((result) => {
			if (result.isConfirmed) {
				$.ajax({
					url: '/GatePassEntryList/Delete',
					type: 'POST',
					data: { code: code },
					success: function (response) {
						if (response.success) {
							toastr.success(response.message || "Record deleted successfully.");
							loadDocumentStages();
						} else {
							toastr.warning("Delete failed.");
						}
					},
					error: function () {
						toastr.error("An error occurred while deleting.");
					}
				});
			}
		});
	}

</script>