@{
    ViewBag.Title = "Attendance Entry List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<fieldset>
    <legend class="legend-field">Attendance Entry List</legend>
    <div class="row">
        <div class="col-lg-6">
            <div class="input-group shadow-sm rounded-pill overflow-hidden">
                <input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." />
            </div>
        </div>
        <div class="col-lg-6">
            <div class="btn-rightalign">
                <button id="btnSave" onclick="window.location.href='@Url.Action("Index", "AttendenceEntry")'" class="btn btn-add">
                    <i class="fa fa-plus"></i> Add
                </button>
                <button class="btn btn-print" onclick="printCityMasterReport()">
                    <i class="fa fa-print"></i> Print
                </button>
                <button class="btn btn-export">
                    <i class="fas fa-file-export"></i> Export
                </button>
                <button class="btn btn-mail">
                    <i class="fa fa-envelope"></i> Mail
                </button>
                <button class="btn btn-approved">
                    <i class="fa fa-check"></i> Approved
                </button>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="table-responsive">
            <table id="tblAttendenceList" class="table-width table table-bordered">
                <thead class="table-head">
                    <tr>
                        <th style="display:none;">Code</th>
                        <th>Vno</th>
                        <th>Vtype</th>
                        <th>Vdate</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="row">
            <div class="col-md-12">
                <div class="pagination-end">
                    <div class="custom-pagination" id="tablePagination"></div>
                </div>
            </div>
        </div>
    </div>
</fieldset>

<script>
    let currentPage = 1;
    let pageSize = 10;

    $(document).ready(function () {
        loadDocumentStages();

        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadDocumentStages();
        });
    });

    function loadDocumentStages() {
        const searchTerm = $('#searchBox').val();

        $.ajax({
            url: '/AttendenceEntryList/GetList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                const docs = res.lists || [];
                const totalCount = res.totalCount || 0;

                const tbody = $('#tblAttendenceList tbody');
                tbody.empty();

                if (docs.length === 0) {
                    tbody.append(`<tr><td colspan="5" class="text-center text-muted">No records found.</td></tr>`);
                    renderPagination(0, pageSize, currentPage);
                    return;
                }

                docs.forEach(doc => {
                    const formattedDate = doc.v_DATE ? new Date(doc.v_DATE).toLocaleDateString() : '';
                    tbody.append(`
                        <tr>
                            <td style="display:none;">${doc.doC_ID}</td>
                            <td>${doc.v_NO || ''}</td>
                            <td>${doc.v_TYPE || ''}</td>
                            <td>${formattedDate}</td>
                            <td>
                                <div class="action-icons">
                                    <i class="fa fa-edit btn-edit" title="Edit" onclick="editDocStage('${doc.doC_ID}')"></i>
                                    <i class="fa fa-eye btn-view" title="View" onclick="viewDocStage('${doc.doC_ID}')"></i>
                                    <i class="fa fa-trash btn-delete" title="Delete" onclick="deleteDocStage('${doc.doC_ID}')"></i>
                                </div>
                            </td>
                        </tr>
                    `);
                });

                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                toastr.error('Error loading document stages: ' + (xhr.responseJSON?.message || xhr.statusText));
            }
        });
    }

    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const pagination = $('#tablePagination');
        pagination.empty();

        if (totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        const startPage = Math.max(1, currentPage - 2);
        const endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
            html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        pagination.html(html);
    }

    function goToPage(page) {
        currentPage = page;
        loadDocumentStages();
    }

      function editDocStage(docCode) {
        console.log('DocID', docCode);  // Log first
        window.location.href = `/AttendenceEntry/Index?rowId=${encodeURIComponent(docCode)}`;
    }


    function viewDocStage(docCode) {
        window.location.href = `/AttendenceEntry/Index?rowId=${encodeURIComponent(docCode)}&readOnly=true`;
    }

        function deleteDocStage(code) {

        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this deletion!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/AttendenceEntryList/Delete',
                    type: 'POST',
                    data: { code: code },
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message || "Record deleted successfully.");
                            loadDocumentStages();
                        } else {
                            toastr.warning("Delete failed.");
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while deleting.");
                    }
                });
            }
        });
    }






</script>
