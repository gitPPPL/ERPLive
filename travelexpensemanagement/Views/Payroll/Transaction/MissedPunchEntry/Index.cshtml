@{
    ViewBag.Title = "Missed Punch Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
    <legend class="legend-field">Missed Punch Entry</legend>
    <form id="MissedPunchEntryForm">
        <input type="hidden" class="form-control" id="TxtDocId" name="CODE">
        <div class="row">
            <div class="col-md-6">
                <fieldset>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlDocType">Doc Type</label>
                                <select class="form-control" id="ddlDocType">
                                    <option value="">Select Doc Type</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="NumSrNo">Serial No.</label>
                                <input type="number" class="form-control" id="NumDocNo" readonly>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-6">
                <fieldset>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="DtFromDate">From Date</label>
                                <input type="date" class="form-control" id="DtFromDate">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="DtToDate">To Date</label>
                                <input type="date" class="form-control" id="DtFromDate">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <div class="btn-mt button-right">
                                    <button id="btn_UpdateMissed" type="button" class="btn btn-success"><i class="fa fa-refresh"></i>Update Missed Punch</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        <div class="row">
            <div class="offset-md-8 col-md-4">
                <div class="btn-mt button-right">
                    <button id="btn_importoffday" type="button" class="btn btn-success"><i class="fa fa-download"></i>Import Offday Emp Data</button>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="table-responsive">
                <table id="tblMissedPunchEntry" class="table-width">
                    <thead class="table-head">
                        <tr>                       
                            <th>Emp Code</th>
                            <th>Employee Name</th>
                            <th>Department Name</th>
                            <th>Out Type</th>
                            <th>Date</th>
                            <th>Shift</th>
                            <th>Remarks</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <!-- Pagination container -->
            <div class="row">
                <div class="col-md-12">
                    <div class="btn-add-row-last">
                        <i class="fa fa-plus btn-add-row" title="Add Row"><span>Add New Row</span></i>
                    </div>
                    <div class="pagination-end">
                        <div class="custom-pagination" id="tablePagination"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="btn-mt">
                    <button onclick="window.location.href='@Url.Action("Index", "MissedPunchList")'" type="button" class="btn btn-draft">
                        <i class="fa fa-list"></i>Back to list
                    </button>
                </div>
            </div>
            <div class="offset-md-5 col-md-4">
                <div class="button-right btn-mt">
                    <button id="btn-save" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
                    <button id="btn_cancel" type="button" class="btn btn-danger"><i class="fa fa-close"></i>Cancel</button>
                </div>
            </div>
        </div>
    </form>
</fieldset>

<script src="~/js/GlobalFunction.js" asp-append-version="true"></script>

<script>

    const allFieldIds = [
      "NumDocNo",
      "ddlDocType"      
    ];

    const itemRecords = [
        'TxtEmpId',
        'ddlEmpname',
        'ddlDepartment',
        'ddlOutType',
        'dtDate',
        'ddlShift',
        'TxtRemark'
    ];

    let docId = "", readOnly;
    function getQueryParam(param) {
      return new URLSearchParams(window.location.search).get(param);
    }
    $(document).ready(function () {
      initPage();
    });

    async function initPage() {
      try {
        await handleDocLoad();
        setEnterKeyFocus(allFieldIds);
        wireEvents();
    } catch (err) {
        toastr.error('Initialization failed: ' + err);
    }
    }

    function wireEvents() {

      $('#btn-save').on('click', async (e) => {
        e.preventDefault();

    
        try {
          const data = await collectFormData();
          console.log(data);
          if(data.PayMissedPunchDetails.length === 0){
            toastr.error("Please add at least one record in the table.");
            return;
          }
          docId ? UpdateData(data) : SaveData(data);
        } catch (err) {
          toastr.error("Error saving data: " + err);
        }

      });

      $(document).on('click', '.btn-delete-action, .btn-Itemdelete-action', function () {
        const tbody = $(this).closest('tbody');
        if (tbody.find('tr').length > 1) {
          $(this).closest('tr').remove();
        } else {
          alert('Cannot delete the first row.');

        }
      });

    $(document).on('click', '.btn-add-row, .btn-add-action', function () {
        addItemRecordRow();
    });
    
    $(document).on('change', 'select[id^=ddlEmpname]', function () {
        var empId = $(this).val(); 
        var $selectedOption = $(this).find('option:selected'); 
        var deptCode = $selectedOption.data('departmentid'); 
        var $row = $(this).closest('tr');  
        $row.find('input[id^=TxtEmpId]').val(empId); 
        $row.find('select[id^=ddlDepartment]').val(deptCode).trigger('change');
    });
          
    }

</script>

<script>

    async function handleDocLoad() {
            docId = getQueryParam('id');
            readOnly = getQueryParam('readOnly');
            if (docId) {
                $('#ddlDocType').prop('disabled', true);
                await GetDocData(docId, readOnly);

            } else {
                await GetDocTypeAsync();
                 const Doctypeval = $('#ddlDocType').val();
                GetDocid(Doctypeval);
                const today = new Date();
                const todayDate = today.getFullYear() + '-' +
                    (today.getMonth() + 1).toString().padStart(2, '0') + '-' +
                    today.getDate().toString().padStart(2, '0');
                    $('#DtDocDate').val(todayDate);               
                  addItemRecordRow();
            }
    }

    function SaveData(saveDt) {
                $.ajax({
                    url: '@Url.Action("SaveOrUpdateMissedPunchEntry", "MissedPunchEntry")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(saveDt),
                    success: function (response) {
                        if (response?.status) {
                            toastr.success("Data Insert successfully");
                            setTimeout(() => {
                                window.location.href = '/MissedPunchList/Index';
                            }, 1500);
                        } else {
                            toastr.error(response?.message || "Save failed. Please try again.");
                        }
                    },
                    error: function () {
                        toastr.error("Error occurred while saving. Please contact admin.");
                    }
                });
    }

    function UpdateData(UpdateDt) {
        $.ajax({
            url: '@Url.Action("SaveOrUpdateMissedPunchEntry", "MissedPunchEntry")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(UpdateDt),
            dataType: 'json',
            success: function (response) {
                if (response?.status) {
                   toastr.success("Data Update successfully");
                    // showFlashMessageByKey('update', 'success');
                    setTimeout(() => {
                        window.location.href = '/MissedPunchList/Index';
                    }, 1500);
                } else {
                    toastr.error("Update failed: " + (response?.message || "Unknown error."));
                }
            },
            error: function (xhr, status, error) {
                toastr.error("Data not updated: " + error);
            }
        });
    }

    async function fillHeaderData(headdata) {        
        const data = headdata[0];
        console.log(data);
        $("#TxtDocId").val(data.DOC_ID ?? "");
        $("#NumDocNo").val(data.V_NO ?? 0);        
       await GetDocTypeAsync(data.V_TYPE ?? "");
    }
    async function fillItemDetailTable(itemsData) {
        const $tbody = $('#tblMissedPunchEntry tbody');
        $tbody.empty();

        for (let index = 0; index < itemsData.length; index++) {
            const item = itemsData[index];
            const idx = index + 1;

            addItemRecordRow();
            await bindDropdownData(idx);

            $(`#TxtEmpId${idx}`).val(item.EMP_CODE || '');
            // $(`#dtDate${idx}`).val(item.V_DATE ?? '');
            $(`#dtDate${idx}`).val(item.V_DATE ? item.V_DATE.substring(0, 10) : '');
            $(`#TxtRemark${idx}`).val(item.REMARKS ?? '');
            $(`#ddlOutType${idx}`).val(item.OUT_TYPE ?? '');

            const safeSetDropdown = (selector, value) => {
                const $select = $(`${selector}${idx}`);
                if ($select.find(`option[value="${value}"]`).length > 0) {
                    $select.val(value).trigger('change');
                }
            };

            safeSetDropdown('#ddlEmpname', item.EMP_CODE);
            safeSetDropdown('#ddlDepartment', item.DEPT_CODE);
            safeSetDropdown('#ddlShift', item.SHIFT);
            // safeSetDropdown('#ddlOutType', item.OUT_TYPE);
        }
    }

    async function collectFormData() {
        const tabledt = await collectItemsDetail();
        const DOC_ID = toNullableString(document.getElementById("TxtDocId")?.value);

        const data = {
            V_NO: toNullableString(document.getElementById("NumDocNo")?.value),
            V_TYPE: toNullableString(document.getElementById("ddlDocType")?.value),
            DOC_ID: DOC_ID,
            SaveOrUpdate: (!DOC_ID || DOC_ID === "") ? "Save" : "Update",
            PayMissedPunchDetails: tabledt || []
        };

        return data;
    }

    async function collectItemsDetail() {
        const items = [];

        $('#tblMissedPunchEntry tbody tr').each(function () {
            const idx = this.id.replace('row', '');
            const $r = $(this);

            const empCode = toNullableString($r.find(`#TxtEmpId${idx}`).val());
            const empName = empCode ? $r.find(`#ddlEmpname${idx} option:selected`).text() : null;
            const deptCode = toNullableString($r.find(`#ddlDepartment${idx}`).val());
            const deptName = deptCode ? $r.find(`#ddlDepartment${idx} option:selected`).text() : null;
            const outType = toNullableString($r.find(`#ddlOutType${idx}`).val());
            // const outType = null;
            const shift = toNullableString($r.find(`#ddlShift${idx}`).val());
            const vDate = toNullableDate($r.find(`#dtDate${idx}`).val());
            const remarks = toNullableString($r.find(`#TxtRemark${idx}`).val());

            if (empCode) {
                items.push({
                    SNO: parseIntSafe(idx),
                    EMP_CODE: empCode,
                    EMP_NAME: empName,
                    DEPT_CODE: deptCode,
                    DEPT_NAME: deptName,
                    OUT_TYPE: outType,
                    V_DATE: vDate,
                    SHIFT: shift,
                    IN_TIME: null,  
                    OUT_TIME: null,
                    REMARKS: remarks,
                    FAPROV_STATUS: null,
                    FAPROV_REMARKS: null
                });
            }
        });

        return items;
    }
        
