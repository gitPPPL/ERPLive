              </tr>`;
              // Remove existing add icons from all rows (but leave delete icons untouched)
              $('#tblExtraDutyEntry tbody tr td .btn-add-action').remove();
              $('#tblExtraDutyEntry tbody').append(rowHtml);
              // Load dropdowns for new row



              this.loadEmpList(`#EMP_NAME_${rowIndex}`);
              this.loadDeptList(`#DEPT_NAME_${rowIndex}`);
              this.loadDesgList(`#DESG_NAME_${rowIndex}`);
              this.loadHODList(`#HOD_NAME_${rowIndex}`,0);
