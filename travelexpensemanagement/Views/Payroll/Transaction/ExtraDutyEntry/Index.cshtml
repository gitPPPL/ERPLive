@{
    ViewBag.Title = "Extra Duty Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
    <legend class="legend-field">Extra Duty Entry</legend>
    <form id="ExtraDutyEntryForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlDocType">Doc Type</label>
                    <select class="form-control" id="ddlDocType">
                        <option value="">Select Doc Type</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtNumDocNo">Doc No</label>
                    <input type="number" class="form-control" id="txtNumDocNo" placeholder="Enter Doc No" readonly>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="DtDocDate">Doc Date</label>
                    <div class="input-divide">
                        <input type="date" class="form-control" id="txtDocDate" />
                        <input type="text" class="form-control" id="txtDocID" readonly />
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlDepartment">Department</label>
                    <select class="form-control" id="ddlDepartment">
                        <option value="">Select Department</option>
                    </select>
                </div>
            </div>
            <div class="offset-md-7 col-md-2">
                <div class="btn-mt button-right">
                    <button id="btn_Calc" type="button" class="btn btn-success"><i class="fa fa-download"></i>Calc</button>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="table-responsive">
                <table id="tblExtraDutyEntry" class="table-width">
                    <thead class="table-head">
                        <tr>
                            <th style="display:none;">Code</th>
                            <th>Employee code</th>
                            <th>Employee Name</th>
                            <th>Department</th>
                            <th>Designation</th>
                            <th>Before</th>
                            <th>After</th>
                            <th>Shift</th>
                            <th>Required</th>
                            <th>Present</th>
                            <th>In Time</th>
                            <th>Out Time</th>
                            <th>Reason</th>
                            <th>Hod Name</th>
                            <th>Auth. By</th>
                            <th>Approval</th>
                            <th>Approv Remarks</th>
                            <th>Remarks</th>
                            <th>Dur</th>
                            <th>Mac Time</th>
                            <th style="display:none">ref type</th>
                            <th style="display:none">ref no</th>
                            <th style="display:none">gate no</th>
                            <th style="display:none">dept code</th>
                            <th style="display:none">desg Code</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <!-- Pagination container -->
            <div class="row">
                <div class="col-md-12">
                    <div class="btn-add-row-last">
                        <i class="fa fa-plus btn-add-row" title="Add Row"><span>Add New Row</span></i>
                    </div>
                    <div class="pagination-end">
                        <div class="custom-pagination" id="tablePagination"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="btn-mt">
                    <button onclick="window.location.href='@Url.Action("Index", "ExtraDutyEntryList")'" type="button" class="btn btn-draft">
                        <i class="fa fa-list"></i>Back to list
                    </button>
                </div>
            </div>
            <div class="offset-md-5 col-md-4">
                <div class="btn-mt button-right">
                    <button id="btn-save" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
                    <button id="btn_cancel" type="button" class="btn btn-danger"><i class="fa fa-close"></i>Cancel</button>
                </div>
            </div>
        </div>
    </form>
</fieldset>
