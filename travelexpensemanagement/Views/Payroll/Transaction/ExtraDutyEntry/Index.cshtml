<script>

    const jsGateEntry = {

          compCode : '@ViewBag.CompCode',
          branchCode :'@ViewBag.BranchCode',
          yearCode : '@ViewBag.YearCode',

          currentPage : 1,
          pageSize : 10,
          rowIndex : 0,
          AddEditMode : '',
          paramdocId : 0,

          Initialize : function() {
              this.GetDocTypeAsync(null);
              this.GetDepartmentAsync(null);
              $('#ddlDocType').trigger("change");

              this.addNewRowBelow(this.rowIndex);

              $(document).on('click', '.btn-add-row, .btn-add-action', function () {
                  //addRow();

                  jsGateEntry.addNewRowBelow(jsGateEntry.rowIndex);
                  jsGateEntry.rowIndex ++;
              });

              this.rowIndex ++;
          },



          collectFormData: function() {
              // return {
              //     DocType:  this.toNullableString($('#ddlDocType').val()),
              //     Vno: this.toNullableString($('#txtNumDocNo').val()),
              //     DocDate: this.toNullableString($('#txtDocDate').val()),
              //     Department:  this.toNullableString($('#ddlDepartment').val()),
              //     tableData: this.collectTableData()
              // }

              return{
                  header: {
                      DocType: this.toNullableString($('#ddlDocType').val()),
                      Vno:this.toNullableString($('#txtNumDocNo').val()),
                      DocDate:  this.toNullableString($('#txtDocDate').val()),
                      Department:   this.toNullableString($('#ddlDepartment').val()),
                      Action: this.AddEditMode
                  },
                  details: {
                      tableData:this.collectTableData()
                  }
              }
           },


          collectTableData: function() {
             let tdata = [];

              $('#tblExtraDutyEntry tbody tr').each(function (rowIndex) {
                  const $row = $(this);
                  let rowdata = {
                        EmpCode: $row.find(`#EMP_CODE_${rowIndex}`).val(),
                        EmpName: $row.find(`#EMP_NAME_${rowIndex} option:selected`).text(),
                        Department: $row.find(`#DEPT_NAME_${rowIndex}`).val(),
                        Designation: $row.find(`#DESG_NAME_${rowIndex}`).val(),
                        Before: $row.find(`#BEFORE_${rowIndex}`).val(),
                        After: $row.find(`#AFTER_${rowIndex}`).val(),
                        Shift: $row.find(`#SHIFT_${rowIndex}`).val(),
                        Required: $row.find(`#REQUIRED_${rowIndex}`).val(),
                        Present: $row.find(`#PRESENT_${rowIndex}`).val(),
                        InTime: $row.find(`#IN_TIME_${rowIndex}`).val(),
                        OutTime: $row.find(`#OUT_TIME_${rowIndex}`).val(),
                        Reason: $row.find(`#REASON_${rowIndex}`).val(),
                        HodName: $row.find(`#HOD_NAME_${rowIndex}`).val(),
                        AuthBy: $row.find(`#AUTH_BY_${rowIndex}`).val(),
                        Approval: $row.find(`#APPROVAL_${rowIndex}`).val(),
                        ApprovalRemarks: $row.find(`#APPROVAL_REMARKS_${rowIndex}`).val(),
                        Remarks: $row.find(`#REMARKS_${rowIndex}`).val(),
                        Duration: $row.find(`#DURATION_${rowIndex}`).val(),
                        MacTime: $row.find(`#MAC_TIME_${rowIndex}`).val(),
                        RefType: $row.find(`#REF_TYPE_${rowIndex}`).val(),
                        RefNo: $row.find(`#REF_NO_${rowIndex}`).val(),
                        GateNo: $row.find(`#GATE_NO_${rowIndex}`).val(),
                        DeptCode: $row.find(`#DEPT_CODE_${rowIndex}`).val(),
                        DesgCode: $row.find(`#DESG_CODE_${rowIndex}`).val(),
                        Action: 1
                  };
                  tdata.push(rowdata);
               });
              return tdata;
          },

          SaveMasterData : function (masterData)  {
              const Namee = masterData?.header.DocDate?.trim();
              if (!Namee) {
                  toastr.warning("Doc date is required.");
                  return;
              }

              // this.checkExistOrNot(Namee)
              //     .done(function (data) {
              //         if (data?.status && data?.exists) {
              //             toastr.warning("Duplicate emp Name");
              //             return;
              //         }



                      $.ajax({
                          url: '@Url.Action("SaveExtraDuty", "ExtraDutyEntry")',
                          type: 'POST',
                          contentType: 'application/json',
                          data: JSON.stringify(masterData),
                          success: function (response) {
                              if (response?.success) {

                                  toastr.success('Data saved successfully.');
                                 // this.resetFields();
                                  setTimeout(() => {
                                      window.location.href = '/ExtraDutyEntry/Index';
                                  }, 1500);
                              } else {
                                  toastr.error(response?.message || "Save failed. Please try again.");
                              }
                          },
                          error: function () {
                              toastr.error("Error occurred while saving. Please contact admin.");
                          }
                      });

                  // })
                  // .fail(function () {
                  //     toastr.error("Error while checking Department Category name.");
                  // });

          },

          EditMasterData: function  (masterData) {
              if (PreviousInputDt !== masterData.Name) {
                  // checkExistOrNot(masterData.Name)
                  //     .done(function (data) {
                          if (data?.status && data?.exists) {
                              toastr.warning("Duplicate Department Category Name");
                              return;
                          }
                          this.UpdateMasterData(masterData);
                      // })
                      // .fail(function () {
                      //     toastr.error("Error while checking Department Category Name.");
                      // });
              } else {
                  this.UpdateMasterData(masterData);
              }
          },

          UpdateMasterData : function (masterData) {
              $.ajax({
                  url: '/ExtraDutyEntry/UpdateDepCategoryMast',
                  type: 'POST',
                  contentType: 'application/json',
                  data: JSON.stringify(masterData),
                  dataType: 'json',
                  success: function (response) {
                      if (response?.status) {
                          toastr.success('Data updated successfully.');
                          this.resetFields();
                          setTimeout(() => {
                                  window.location.href = '/ExtraDutyEntry/Index';
                          }, 1500);
                      } else {
                          toastr.error("Update failed: " + (response?.message || "Unknown error."));
                      }
                  },
                  error: function (xhr, status, error) {
                      toastr.error("Data not updated: " + error);
                  }
              });
          },

           checkExistOrNot : function (inputData) {

               return true;

              return $.ajax({
                  url: '/ExtraDutyEntry/getExistOrNot',
                  type: 'GET',
                  dataType: 'json',
                  data: { inputData: inputData }
              });
           },

           GetDocData :  function (docId, readOnly){
              $.ajax({
                  url: '/ExtraDutyEntry/GetExtradutyDatabyId',
                  type: 'GET',
                  data: { DocNo: docId },
                  success: function (res) {
                      if (res.status && res.data) {
                          jsGateEntry.fillFormFields(res.data);
                          if (readOnly === 'true') {
                              $('input,select, #DdActive').prop('disabled', true);
                              $('#btn-save, #cancelBtn, .btn-add-row, .btn-delete-action, .btn-add-action').hide();
                          } else {
                              $('input,select, #DdActive').prop('disabled', false);
                              $('#btn-save, #cancelBtn, .btn-add-row, .btn-delete-action, .btn-add-action').show();
                          }
                      } else {
                          toastr.warning('No data found for this ID.');
                      }
                  },
                  error: function () {
                      toastr.error('Failed to load data.');
                  }
              });
          },

          fillFormFields : function (dt) {

            const headerData =  dt.header;

            $('#ddlDocType').val(headerData.docType).trigger('change');
            $('#txtDocDate').val(headerData.docDate);
            //$('#ddlDepartment').val(headerData.department).trigger('change');
            let docid  =  headerData.docType + dt.header.vno;
            $('#txtDocID').val(docid);
            $('#txtNumDocNo').val(headerData.vno);

            // $('#tblExtraDutyEntry tbody').empty();
            this.rowIndex = 1;
            const rows = dt.details.tableData;

            rows.forEach((item, index) => {
                if (index > 0) {
                    jsGateEntry.rowIndex = index;
                    jsGateEntry.addNewRowBelow(jsGateEntry.rowIndex);
                }

                const ri = index;

                Promise.all([
                    jsGateEntry.loadDeptList(`#DEPT_NAME_${ri}`),
                    jsGateEntry.loadDesgList(`#DESG_NAME_${ri}`),
                    jsGateEntry.loadEmpList(`#EMP_NAME_${ri}`),
                    jsGateEntry.loadHODList(`#HOD_NAME_${ri}`, 0),
                    jsGateEntry.loadReasonList(`#REASON_${ri}`),
                    jsGateEntry.loadShiftList(`#SHIFT_${ri}`)
                ]).then(() => {
                    debugger;

                    $('#EMP_CODE_' + ri).val(item.empCode);
                    $('#EMP_NAME_' + ri).val(item.empCode).trigger('change');
                    $('#DEPT_NAME_' + ri).val(item.deptCode).trigger('change');
                    $('#DESG_NAME_' + ri).val(item.desgCode).trigger('change');
                    $('#BEFORE_' + ri).val(item.before);
                    $('#AFTER_' + ri).val(item.after);
                    $('#SHIFT_' + ri).val(item.shift).trigger('change');
                    $('#REQUIRED_' + ri).val(item.required);
                    $('#PRESENT_' + ri).val(item.present);
                    $('#IN_TIME_' + ri).val(item.inTime);
                    $('#OUT_TIME_' + ri).val(item.outTime);
                    $('#REASON_' + ri).val(item.reason).trigger('change');
                    $('#HOD_NAME_' + ri).val(item.hodName).trigger('change');
                    $('#AUTH_BY_' + ri).val(item.authBy);
                    $('#APPROVAL_' + ri).val(item.approval);
                    $('#APPROVAL_REMARKS_' + ri).val(item.approvalRemarks);
                    $('#REMARKS_' + ri).val(item.remarks);
                    $('#DURATION_' + ri).val(item.duration);
                    $('#MAC_TIME_' + ri).val(item.macTime);
                    $('#REF_TYPE_' + ri).val(item.refType);
                    $('#REF_NO_' + ri).val(item.refNo);
                    $('#GATE_NO_' + ri).val(item.gateNo);
                    $('#DEPT_CODE_' + ri).val(item.deptCode);
                    $('#DESG_CODE_' + ri).val(item.desgCode);

                });

             });
          },

          getQueryParam : function (param){
              const urlParams = new URLSearchParams(window.location.search);
              return urlParams.get(param);
          },

          loadFormData : function() {
              this.paramdocId = this.getQueryParam('id');
              let readOnly = this.getQueryParam('readOnly');

              if (this.paramdocId) {
                  this.GetDocData(this.paramdocId, readOnly);
                  this.AddEditMode = "UPDATE";
              }else{
                  this.AddEditMode = "INSERT";
              }
          },

          toNullableInt : function (v) {
              const t = String(v ?? '').trim();
              return t === '' ? null : parseInt(t, 10);
          },

          toNullableString : function (v)  {
              const t = String(v ?? '').trim();
              return t === '' ? null : t;
          },

          GetDepartmentAsync :  function (selectedValue) {
                  return new Promise((resolve, reject) => {
                  $.ajax({
                      url: '@Url.Action("GetDepartmentList", "ExtraDutyEntry")',  // PayGatePas
                      type: 'GET',
                      dataType: 'json',
                      success: function (response) {

                          if (response.status) {
                              const $dropdown = $('#ddlDepartment');
                              $dropdown.empty();
                              // $dropdown.append('<option value="">-select doc Type-</option>');

                              $.each(response.data, function (index, item) {
                                  $dropdown.append(`<option value="${item.value}">${item.text}</option>`);
                              });

                              if (selectedValue && $dropdown.find(`option[value="${selectedValue}"]`).length > 0) {
                                  $dropdown.val(selectedValue).trigger('change');
                              } else {
                                  $dropdown.prop('selectedIndex', 0);
                              }

                              resolve();
                          } else {
                              reject("Invalid response status.");
                          }
                      },
                      error: function (xhr, status, error) {
                          toastr.error("Department list Load failed: " + error);
                          reject(error);
                      }
                  });
              });
          },

          GetDocTypeAsync : function (selectedValue)  {

                  return new Promise((resolve, reject) => {
                  $.ajax({
                      url: '@Url.Action("GetDocumentTypeList", "ExtraDutyEntry")',  // PayGatePas
                      type: 'GET',
                      dataType: 'json',
                      success: function (response) {

                          if (response.status) {
                              const $dropdown = $('#ddlDocType');
                              $dropdown.empty();
                              // $dropdown.append('<option value="">-select doc Type-</option>');

                              $.each(response.data, function (index, item) {
                                  $dropdown.append(`<option value="${item.value}">${item.text}</option>`);
                              });

                              if (selectedValue && $dropdown.find(`option[value="${selectedValue}"]`).length > 0) {
                                  $dropdown.val(selectedValue).trigger('change');
                              } else {
                                  $dropdown.prop('selectedIndex', 0);
                              }

                              $('#ddlDocType').trigger("change");

                              resolve();
                          } else {
                              reject("Invalid response status.");
                          }
                      },
                      error: function (xhr, status, error) {
                          toastr.error("Document Type Load failed: " + error);
                          reject(error);
                      }
                  });
              });
          },

          GetDocid : function (VType)  {
              $.ajax({
                  url: '@Url.Action("GetMaxVNo", "ExtraDutyEntry")',
                  type: 'GET',
                  data:{V_type:VType},
                  success: function (response) {
                      console.log(response);
                      if (response.status === true && response.data) {
                          $('#txtNumDocNo').val(response.data.vNo || '');
                          $('#txtDocID').val(response.data.docId || '');
                      } else {
                          $('#txtNumDocNo').val('');
                          $('#txtDocID').val('');
                      }
                  },
                  error: function (xhr, status, error) {
                      toastr.error('Error fetching Doc ID:', error);
                  }
              });
          },


          addNewRowBelow : function (rowIndex) {

              let lastRow = $('#tblExtraDutyEntry tbody tr:last');
              if (lastRow.length > 0) {
                  let lastRowId = lastRow.find('select[id^="EMP_NAME"]').data('id');
                  if (lastRowId) {
                      let lastIndex = lastRowId

                      let empNameVal = $(`#EMP_NAME_${lastIndex} option:selected`).text();
                      let empCodeVal = $(`#EMP_CODE_${lastIndex}`).val();

                      if (!jsGateEntry.getQueryParam('id')){
                          if (!empNameVal) {
                              toastr.warning('Please select an Emp Name before adding a new row.');
                              $(`#ITEM_NAME_${lastIndex}`).focus();
                              return;
                          }

                          if (!empCodeVal || empCodeVal.trim() === '') {
                              toastr.warning('Please enter an Emp Code before adding a new row.');
                              $(`#EMP_CODE_${lastIndex}`).focus();
                              return;
                          }
                      }

                  }
              }


              const rowHtml = `
                  <tr class="no-border-input">
                  <td style="display:none;"></td>
                  <td><input style="min-width: 100px; max-width: 200px;" class="form-control" id="EMP_CODE_${rowIndex}"  data-id=${rowIndex}  name="EMP_CODE[${rowIndex}]" type="text" class="form-control-sm" readonly/></td>
                  <td>
                      <select style="min-width: 150px; max-width: 300px;"  class="form-control" id="EMP_NAME_${rowIndex}" data-id=${rowIndex} name="EMP_NAME[${rowIndex}]" class="form-control-sm">
                          <option value="">-- Select Emp name --</option>
                      </select>
                  </td>
                  <td>
                      <select style="min-width: 100px; max-width: 200px;" class="form-control" id="DEPT_NAME_${rowIndex}" data-id=${rowIndex} name="DEPT_NAME[${rowIndex}]" class="form-control-sm" disabled>
                          <option value="">-- Select Dept. Name --</option>
                      </select>
                  </td>
                  <td>
                      <select style="min-width: 100px; max-width: 200px;" class="form-control" id="DESG_NAME_${rowIndex}" data-id=${rowIndex} name="DESG_NAME[${rowIndex}]" class="form-control-sm" disabled>
                          <option value="">-- Select Desg. Name --</option>
                      </select>
                  </td>
                  <td><input style="min-width: 100px; max-width: 200px;"  class="form-control" id="BEFORE_${rowIndex}" name="BEFORE[${rowIndex}]" type="number" class="form-control-sm" /></td>
                  <td><input style="min-width: 50px; max-width: 200px;"  class="form-control" id="AFTER_${rowIndex}" name="AFTER[${rowIndex}]" type="number" class="form-control-sm" /></td>
                  <td>
                      <select style="min-width: 100px; max-width: 200px;" class="form-control" id="SHIFT_${rowIndex}" data-id=${rowIndex} name="SHIFT[${rowIndex}]" class="form-control-sm">
                          <option value="">-- Select Shift Name --</option>
                      </select>
                  </td>
                  <td><input style="min-width: 50px; max-width: 200px;"  class="form-control" id="REQUIRED_${rowIndex}" name="REQUIRED[${rowIndex}]" type="number" class="form-control-sm" /></td>
                  <td><input style="min-width: 50px; max-width: 200px;"  class="form-control" id="PRESENT_${rowIndex}" name="EXCH_RATE[${rowIndex}]" type="number" class="form-control-sm" /></td>
                  <td><input style="min-width: 50px; max-width: 200px;"  class="form-control" id="IN_TIME_${rowIndex}" name="RATE[${rowIndex}]" type="time" class="form-control-sm" /></td>
