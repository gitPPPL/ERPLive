          },

          loadEmpList : function (targetSelector) {
                  return $.ajax({
                      url: '@Url.Action("GetEmplist", "ExtraDutyEntry")',
                      type: 'GET',
                      data: {},
                      dataType: 'json',
                      success: function (data) {
                          let $ddl = $(targetSelector);

                          $ddl.on('change', function () {

                              const rowId = $(this).data('id');
                              const selected = $(this).find('option:selected');

                              const empCode = $(this).val();
                              const deptId  = selected.data('deptid');
                              const desgId  = selected.data('desgid');

                              $('#EMP_CODE_' + rowId).val(empCode);
                              $('#DEPT_NAME_' + rowId).val(deptId).trigger('change');
                              $('#DESG_NAME_' + rowId).val(desgId).trigger('change');

                              jsGateEntry.loadHODList(`#HOD_NAME_${rowId}`,deptId );

                              //jsGateEntry.loadReasonList(`#REASON_${rowId}`);

                          });

                          $ddl.empty();
                          $ddl.append('<option value="">-- Select Employee --</option>');
                          $.each(data.data, function (index, item) {
                              $ddl.append('<option  data-deptid = "'+ item.dept_id +'" data-desgid = "'+ item.desg_id +'"  value="' + item.value + '">' + item.text + '</option>');
                          });
                      },
                      error: function (xhr, status, error) {
                          toastr.error('Error loading Employee list: ' + error);
                      }
                  });
              },

          loadDeptList : function (targetSelector) {
                  return $.ajax({
                      url: '@Url.Action("GetDepartmentList", "ExtraDutyEntry")', //
                      type: 'GET',
                      data: {},
                      dataType: 'json',
                      success: function (data) {
                          var ddl = $(targetSelector);
                          ddl.empty();
                          ddl.append('<option value="">-- Select Department --</option>');
                          $.each(data.data, function (index, item) {
                              ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                          });
                      },
                      error: function (xhr, status, error) {
                          toastr.error('Error loading designation list: ' + error);
                      }
                  });
              },

              //loadDesgList
          loadDesgList: function(targetSelector) {
              return $.ajax({
                  url: '@Url.Action("GetDesglist", "ExtraDutyEntry")',
                  type: 'GET',
                  data: {},
                  dataType: 'json',
                  success: function (data) {
                      var ddl = $(targetSelector);
                      ddl.empty();
                      ddl.append('<option value="">-- Select Designation --</option>');
                      $.each(data.data, function (index, item) {
                          ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                      });
                  },
                  error: function (xhr, status, error) {
                      toastr.error('Error loading item list: ' + error);
                  }
              });
              },

          loadHODList : function(targetSelector, DeptCode){
              return $.ajax({
                  url: '@Url.Action("GetHODlist", "ExtraDutyEntry")',
                  type: 'GET',
                  data: { deptCode: DeptCode },
                  dataType: 'json',
                  success: function (data) {
                      var ddl = $(targetSelector);
                      ddl.empty();
                      ddl.append('<option value="">-- Select HOD Name --</option>');
                      $.each(data.data, function (index, item) {
                          ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                      });
                  },
                  error: function (xhr, status, error) {
                      toastr.error('Error loading item list: ' + error);
                  }
              });
           },

          loadReasonList :  function (targetSelector) {
              return $.ajax({
                  url: '@Url.Action("GetReasonlist", "ExtraDutyEntry")',
                  type: 'GET',
                  data: { vtype:  $('#ddlDocType option:selected').val() },
                  dataType: 'json',
                  success: function (data) {
                      var ddl = $(targetSelector);
                      ddl.empty();
                      ddl.append('<option value="">-- Select Reason --</option>');
                      $.each(data.data, function (index, item) {
                          ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                      });
                  },
                  error: function (xhr, status, error) {
                      toastr.error('Error loading item list: ' + error);
                  }
              });
           },

          loadShiftList: function (targetSelector) {
              var ddl = $(targetSelector);
              ddl.empty();
              ddl.append('<option value="A">A</option>');
              ddl.append('<option value="B">B</option>');
              ddl.append('<option value="C">C</option>');
              ddl.append('<option value="G">G</option>');
              },

      }

</script>

<script>

    $(document).ready(function () {

        // Delete row
        $(document).on('click', '.btn-delete-action', function () {
            const $row = $(this).closest('tr');
            const isLastRow = $row.is(':last-child');
            $row.remove();

            // If last row was deleted, show plus on new last row
            if (isLastRow) {
                const $lastRow = $tbody.find('tr:last');
                if ($lastRow.length > 0 && $lastRow.find('.btn-add-action').length === 0) {
                    $lastRow.find('td:last').prepend(
                        `<i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer; margin-right:8px;"></i>
                         <i class="fa fa-trash btn-delete-action text-danger" title="Delete Row" style="cursor:pointer;"></i>`
                    );
                }
            }
        });

         $('#txtNumDocNo').on('keypress', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                    $('#TxtDocDate').focus();
            }
        });

        $('#TxtDocDate').on('keypress', function (e) {

            if (e.key === 'Enter') {
                e.preventDefault();
                $('#ddlDepartment').focus();
            }
        });

        $('#ddlDepartment').on('keypress', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                    $('#btn_Calc').focus();
            }
        });

        $('#ddlDocType').on('change', function () {
            const VType = $(this).val();
            // If paramdocId is not set (null/undefined/empty/0) -> fetch new Doc id
            jsGateEntry.paramdocId = jsGateEntry.getQueryParam('id');
            if (!jsGateEntry.paramdocId) {
                jsGateEntry.GetDocid(VType);
            }
        });


        $('#btn-save').on('click', function (e) {
            e.preventDefault();



            const masterData = jsGateEntry.collectFormData();

            if (!masterData.header.DocDate || !masterData.header.Vno) {
                toastr.warning("Please fill all required fields");
                return;
            }

            if (jsGateEntry.docId) {
               jsGateEntry.EditMasterData(masterData);
            } else {
                jsGateEntry.SaveMasterData(masterData);
            }

        });

        jsGateEntry.Initialize();
        jsGateEntry.loadFormData();


    });

</script>
