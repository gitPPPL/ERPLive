@{
	ViewBag.Title = "Staff Movement Entry List";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
	<legend class="legend-field">Staff Movement Entry List</legend>
	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>
		<div class="col-lg-6">
			<div class="btn-rightalign">
				<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "StaffMovementEntry")'" type="submit" class="btn btn-add">
					<i class="fa fa-plus"></i>Add
				</button>
				<button class="btn btn-print" onclick="printCityMasterReport()">
					<i class="fa fa-print"></i> Print
				</button>
				<button class="btn btn-export">
					<i class="fas fa-file-export"></i> Export
				</button>
				<button class="btn btn-mail">
					<i class="fa fa-envelope"></i> Mail
				</button>
				<button class="btn btn-approved">
					<i class="fa fa-check"></i> Approved
				</button>
			</div>
		</div>
	</div>
	<div class="card">
		<div class="table-responsive">
			<table id="tblStaffMovementList" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>Date</th>
						<th>Emp Code</th>
						<th>Emp Name</th>
						<th>Department</th>
						<th>Out Time</th>
						<th>In Time</th>
						<th>Purpose</th>
						<th>Remarks</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
	</div>
</fieldset>
<script>
	let currentPage = 1;
	let pageSize = 10;

	$(document).ready(function () {
	loadAllMenus();


		$('#searchBox').on('keyup', function () {
			currentPage = 1;
			loadAllMenus();


		});
	});

	function loadAllMenus() {
			  const searchTerm = $('#searchBox').val();
			  $.ajax({
				url: '/StaffMovementEntryList/Getlist',
				type: 'GET',
				dataType: 'json',
				data: {
				  searchTerm: searchTerm,
				  pageNumber: currentPage,
				  pageSize: pageSize
				},
				success: function (res) {

				 if (!res.success) {
				toastr.error("Failed to load data.");
				return;
			}

				  const DiwalibonusList = res.lists;
				  const totalCount = res.totalCount;

				  console.log('Data received:', DiwalibonusList);



				  let tbody = $('#tblStaffMovementList tbody');
				  tbody.empty();
				  if (DiwalibonusList.length === 0) {

				  } else {
				$.each(DiwalibonusList, function (index, item) {
			     $('#tblStaffMovementList tbody').append(`
				<tr>
					<td>${formatDate(item.v_DATE)}</td>
					<td>${item.emP_CODE}</td>
					<td>${item.emP_NAME}</td>
					<td>${item.depT_NAME}</td>
   				    <td>${item.e_TIME}</td>
					<td>${item.iN_TIME}</td>
					<td>${item.gP_TYPE}</td>
					<td>${item.remarks}</td>
				<td>
				<button class="btn btn-sm btn-light">
						<i class="fas fa-edit" style="cursor: pointer;" title="Edit" onclick="AddOrEditFunction('${item.doC_ID}')"></i>
						</button>
						<button class="btn btn-sm btn-light">
						<i class="fas fa-eye" style="cursor: pointer;" title="View Detail" onclick="viewMenuDetails('${item.doC_ID}')"></i>
						</button>
						<button class="btn btn-sm btn-light btn-delete" onclick="deleteTemp('${item.doC_ID}')">
						<i class="fas fa-trash text-danger" title="Delete"></i>
						</button>
				  </td>
				</tr>
			  `);
			});

					renderPagination(totalCount, pageSize, currentPage);
				  }
				},
				error: function (xhr) {
				  toastr.error('Error loading  list: ' + xhr.responseText);
				}
			  });
			}


	function formatDate(dateStr) {
			if (!dateStr) return null;
			const date = new Date(dateStr);
			if (isNaN(date)) return null;
			const year = date.getFullYear();
			const month = String(date.getMonth() + 1).padStart(2, '0');
			const day = String(date.getDate()).padStart(2, '0');

			return `${day}-${month}-${year}`;
		}


	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const pagination = $('#tablePagination');
		pagination.empty();

		if (totalPages <= 1) return;

		let html = '';

		if (currentPage > 1) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		const startPage = Math.max(1, currentPage - 2);
		const endPage = Math.min(totalPages, currentPage + 2);

		for (let i = startPage; i <= endPage; i++) {
			html += `
				<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
		}

		if (currentPage < totalPages) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		pagination.html(html);
	}

	function goToPage(page) {
		currentPage = page;
		loadDocumentStages();
	}

	function AddOrEditFunction(code) {
			window.location.href = '/StaffMovementEntry/Index?id=' + encodeURIComponent(code);
		}

	function viewMenuDetails(code) {
			window.location.href = '/StaffMovementEntry/Index?id=' + encodeURIComponent(code)  + '&mode=view'  ;
		}

	function deleteTemp(code) {
		if (!confirm('Are you sure you want to delete this Staff Movement Entry?')) return;
		$.ajax({
			url: '/StaffMovementEntryList/Delete',
			type: 'POST',
			data: { code: code },
			success: function (res) {
				if (res.success) {
					toastr.success('Deleted successfully.');
					loadAllMenus();
				} else {
					toastr.error(res.message || 'Failed to delete.');
				}
			},
			error: function () {
				toastr.error('Error deleting Staff Movement Entry .');
			}
		});
	}


</script>
