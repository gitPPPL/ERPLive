      attendence.forEach(function(item) {
        const row = $('<tr>');         
        row.append(`<td>${item.Date}</td>`);
        row.append(`<td>${item.LOOM_CODE}</td>`);
        row.append(`<td>${item.LoomNo}</td>`)
        row.append(`<td>${item.Type}</td>`);
        row.append(`<td>${item.ItemType}</td>`);
        row.append(`<td>${item.Width}</td>`);
        row.append(`<td>${item.Gram}</td>`);
        row.append(`<td>${item.Denier}</td>`);
        row.append(`<td>${item.ActProd}</td>`);
