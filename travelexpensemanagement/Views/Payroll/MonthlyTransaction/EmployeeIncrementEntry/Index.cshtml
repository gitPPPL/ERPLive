                toastr.error('Error fetching Doc ID:', error);
            }
        });
    }

    async function GetDocData(MasterTblId, readOnly) {
        try {
            const response = await $.ajax({
                url: '/EmployeeIncrementEntry/GetEmpIncrementDetailsForUpdate',
                type: 'GET',
                data: { id: MasterTblId }
            });
            if (response.status) {
                const data=(response.data)[0];
                await fillHeaderData(data);
                // await fillItemDetailTable(response.data);
                if (readOnly === 'true') {
                    $('#btn-save, #cancelBtn').hide();
                    // disableAllFields();
                } else {
                    $('#btn-save, #cancelBtn').show();
                    // enableAllFields();
                }
            } else {
                toastr.error('No data returned.');
            }
        } catch (error) {
            toastr.error('Failed to load data.');
            console.error(error);
        }
    }
     

