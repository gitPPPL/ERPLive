@{
	ViewBag.Title = "Earn Leave Payment List";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
	<legend class="legend-field">Earn Leave Payment List</legend>
	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>
		<div class="col-lg-6">
			<div class="btn-rightalign">
				<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "EarnLeavePaymentEntry")'" type="submit" class="btn btn-add">
					<i class="fa fa-plus"></i>Add
				</button>
				<button class="btn btn-print" onclick="printCityMasterReport()">
					<i class="fa fa-print"></i> Print
				</button>
				<button class="btn btn-export">
					<i class="fas fa-file-export"></i> Export
				</button>
				<button class="btn btn-mail">
					<i class="fa fa-envelope"></i> Mail
				</button>
				<button class="btn btn-approved">
					<i class="fa fa-check"></i> Approved
				</button>
			</div>
		</div>
	</div>
	<div class="card">
		<div class="table-responsive">
			<table id="tblEarnLeavePaymentList" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>Sno</th>
						<th>Date</th>
						<th>Document Type</th>
						<th>Emp_Code</th>
						<th>Employee Name</th>
						<th>Bal_Days</th>
						<th>Pay_Days</th>
						<th>Gross</th>
						<th>Rate</th>
						<th>Amount</th>
						<th>Uuser</th>
						<th>Udate</th>
						<th>Euser</th>
						<th>Edate</th>
					
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
	</div>
</fieldset>
<script>
	let currentPage = 1;
	let pageSize = 10;

	$(document).ready(function () {
		loadCanteenList();

		$('#searchBox').on('keyup', function () {
			currentPage = 1;
			loadCanteenList();
		});
	});

	//Load main grid...............
	function loadCanteenList() {
		  const searchTerm = $('#searchBox').val();

		  $.ajax({
			  url: '/EarnLeavePaymentList/GetList',
			  type: 'GET',
			  dataType: 'json',
			  data: { searchTerm, pageNumber: currentPage, pageSize },
			  success: function (res) {
				  const list = res.lists || [];
				  const totalCount = res.totalCount || 0;
				  const tbody = $('#tblEarnLeavePaymentList tbody');
				  tbody.empty();

				  console.log('list', list);

				  if (list.length === 0) {
					  tbody.append('<tr><td colspan="8" class="text-center">No records found</td></tr>');
					  renderPagination(0, pageSize, currentPage);
					  return;
				  }

				  // Add serial number logic
				  list.forEach((item, index) => {
				
					  tbody.append(`
						  <tr>
							  <td style="display:none;">${item.doC_ID}</td>
							  <td>${(currentPage - 1) * pageSize + index + 1}</td> <!-- Serial number calculation -->
							  <td>${formatDate(item.v_DATE ) || ''}</td>
							  <td>${item.v_TYPE || ''}</td>
							  <td>${item.emP_CODE || ''}</td>
							  <td>${item.emp_name || ''}</td>
							  <td>${item.baL_DAYS || ''}</td>
							  <td>${item.paY_DAYS || ''}</td>
							  <td>${item.gross || ''}</td>
							  <td>${item.rate || ''}</td>
							  <td>${item.amount || ''}</td>
							  <td>${item.uuser || ''}</td>
							  <td>${formatDate(item.udate)|| ''}</td>
								<td>${item.euser || ''}</td>
								 <td>${formatDate(item.edate)|| ''}</td>

							  <td>
								  <div class="action-icons">
									  <i class="fa fa-edit btn-edit" title="Edit" onclick="AddOrEditFunction('${item.doC_ID}')"></i>
									  <i class="fa fa-eye btn-view" title="View" onclick="viewMenuDetails('${item.doC_ID}')"></i>
									  <i class="fa fa-trash btn-delete" title="Delete" onclick="deleteDocStage('${item.doC_ID}')"></i>
								  </div>
							  </td>
						  </tr>
					  `);
				  });

				  renderPagination(totalCount, pageSize, currentPage);
			  },
			  error: function (xhr) {
				  toastr.error('Error loading canteen list: ' + (xhr.responseJSON?.message || xhr.statusText));
			  }
		  });
	  }

	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const pagination = $('#tablePagination');
		pagination.empty();

		if (totalPages <= 1) return;

		let html = '';

		if (currentPage > 1) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		const startPage = Math.max(1, currentPage - 2);
		const endPage = Math.min(totalPages, currentPage + 2);

		for (let i = startPage; i <= endPage; i++) {
			html += `
				<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
		}

		if (currentPage < totalPages) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		pagination.html(html);
	}

	function goToPage(page) {
		currentPage = page;
		loadDocumentStages();
	}

	function AddOrEditFunction(docId) {
		window.location.href = '/EarnLeavePaymentEntry/Index?id=' + encodeURIComponent(docId);
	}

	function viewMenuDetails(docId) {
		window.location.href = '/EarnLeavePaymentEntry/Index?id=' + encodeURIComponent(docId) + '&readOnly=true';
	}

	function deleteDocStage(docId) {
		Swal.fire({
			title: 'Are you sure?',
			text: "You won't be able to revert this deletion!",
			icon: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#d33',
			cancelButtonColor: '#3085d6',
			confirmButtonText: 'Yes, delete it!'
		}).then((result) => {
			if (result.isConfirmed) {
				$.ajax({
					url: '/EarnLeavePaymentList/Delete',
					type: 'POST',
					data: { code: docId },
					success: function (response) {
						if (response.success) {
							toastr.success(response.message || "Record deleted successfully.");
							loadCanteenList();
						} else {
							toastr.warning(response.message || "Delete failed.");
						}
					},
					error: function () {
						toastr.error("An error occurred while deleting.");
					}
				});
			}
		});
	}

	function formatDate(dateString) {
		if (!dateString) return 'Null'; // Return 'null' if the dateString is falsy (null, undefined, or empty)

		const date = new Date(dateString);
		if (isNaN(date.getTime())) return 'Null'; // Check if the date is valid

		const year = date.getFullYear();
		const month = String(date.getMonth() + 1).padStart(2, '0');
		const day = String(date.getDate()).padStart(2, '0');
		return `${year}-${month}-${day}`;
	}

</script>
