<script src="~/js/GlobalFunction.js" asp-append-version="true"></script>
<script>

    const allFieldIds = [
    "TxtDocId",
    "ddlDocType",
    "NumDocNo",
    "DtDocDate"
    ];

    const itemRecords = [
        'TxtEmpId',
        'ddlEmpname',
        'ddlDepartment',
        'ddlOutType',
        'dtDate',
        'ddlShift',
        'TxtRemark'
    ];

    let docId = "", readOnly;
    function getQueryParam(param) {
      return new URLSearchParams(window.location.search).get(param);
    }
    $(document).ready(function () {
      initPage();
    });

    async function initPage() {
      try {
        await fillBanknameDynamic();
        await handleDocLoad();
        setEnterKeyFocus(allFieldIds);
        wireEvents();
    } catch (err) {
        toastr.error('Initialization failed: ' + err);
    }
    }

    function wireEvents() {

      $('#btn-save').on('click', async (e) => {
        e.preventDefault();

        try {
          const data = await collectFormData();
          if(data.payAdvanceLists.length === 0){
            toastr.error("Please add at least one record in the table.");
            return;
          }
          docId ? UpdateData(data) : SaveData(data);
        } catch (err) {
          toastr.error("Error saving data: " + err);
        }

      });

      $(document).on('click', '#btn_Load', function() {
        var departmentId = $('#ddlDepartment').val();
        var Vdate = $('#DtDocDate').val();
        var chkDepartmentValue = $('#chkDepartment').prop('checked') ? 1 : 0;
        var chkDesignationValue = $('#chkDesignation').prop('checked') ? 1 : 0;
        var chkEmployeeValue = $('#chkEmpcode').prop('checked') ? 1 : 0;

        $.ajax({
            url: "/AdvanceListCreation/GetFilteredData",
            type: 'GET',
            data: {
                vdate: Vdate,
                departmentId: departmentId,
                cbDeptId: chkDepartmentValue,
                cbDesignId: chkDesignationValue,
                cbEmplId: chkEmployeeValue
            },
            dataType: 'json',
            success: function(response) {
                if (response.status) {
                    const data = response.data;
                    fillTableBasedOnFilter(data);
                }
            },
            error: function(error) {
                toastr.error("Error loading filtered data: " + error);
            }
        });
    });


    }

</script>

<script>

    async function fillBanknameDynamic() {
        try {
            let response = await $.ajax({
                url: '/AdvanceListCreation/GetBankList',
                type: 'GET'
            });

            // Check if the response contains a property like "data"
            let bankNames = Array.isArray(response) ? response : response.data;
            if (!Array.isArray(bankNames)) {
                console.error('Bank list is not an array:', bankNames);
                return;
            }

            const container = document.getElementById('bankListContainer');
            container.innerHTML = ''; // clear existing items

            bankNames.forEach((item, index) => {
            const div = document.createElement('div');
            div.classList.add('form-row');

            div.innerHTML = `
                <input type="checkbox" class="bankCheckbox" id="bank${item.CODE}" name="bankName" value="${item.NAME}">
                <label class="checkbox-label" for="bank${item.CODE}">${item.NAME}</label>
            `;
            container.appendChild(div);
        });

        } catch (error) {
            console.error('Error loading bank names:', error);
        }
    }


    function toggleAllBanks(selectAllCheckbox) {
        const checkboxes = document.querySelectorAll('.bankCheckbox');
        checkboxes.forEach(chk => chk.checked = selectAllCheckbox.checked);
    }

    function fillTableBasedOnFilter(data) {
        $('#tblAdvanceListCreation tbody').empty();

        data.forEach(function (item, index) {
            const gross = parseFloat(item.Gross) || 0;
            const wday  = parseFloat(item.Wday) || 0;
            const rate  = parseFloat($('#TxtRate').val()) || 0;
            const wages = parseFloat(((gross / 26) * wday).toFixed(2));

            let advnamt = 0;
            if ($('#chkRate').is(':checked')) {
                advnamt = parseFloat((wages * rate * 0.01).toFixed(2));
            } else {
                advnamt = parseFloat((wday * rate).toFixed(2));
            }
            const sancamt = 0;

            const row = $('<tr></tr>');

            row.append('<td id="rowIndex' + index + '">' + (index + 1) + '</td>');
            row.append('<td id="empCode' + index + '">' + (item.CODE ?? '') + '</td>');
            row.append('<td id="empName' + index + '">' + (item.NAME ?? '') + '</td>');
            row.append('<td id="empDept' + index + '">' + (item.Dept ?? '') + '</td>');
            row.append('<td id="empDesg' + index + '">' + (item.Desg ?? '') + '</td>');
            row.append('<td id="empWday' + index + '">' + wday.toFixed(2) + '</td>');
            row.append('<td id="empGross' + index + '">' + gross.toFixed(2) + '</td>');
            row.append('<td id="empWages' + index + '">' + wages.toFixed(2) + '</td>');
            row.append('<td id="empAdvNamT' + index + '">' + advnamt.toFixed(2) + '</td>');
            row.append('<td id="empSancAmt' + index + '">' + sancamt.toFixed(2) + '</td>');
            row.append('<td id="empRemark' + index + '">' + (item.REMARK ?? '') + '</td>');
            row.append('<td id="empRate' + index + '">' + rate.toFixed(2) + '</td>');

            // Append the row to the table body
            $('#tblAdvanceListCreation tbody').append(row);
        });
    }

    async function handleDocLoad() {
            docId = getQueryParam('id');
            readOnly = getQueryParam('readOnly');
            if (docId) {
                $('#ddlDocType').prop('disabled', true);
                await GetDocData(docId, readOnly);

            } else {
                 await GetDocTypeAsync();
                const ddlDocType = $('#ddlDocType');
                if (!ddlDocType.val()) {
                ddlDocType.prop('selectedIndex', 0);
                }
               const Doctypeval = ddlDocType.val();
                GetDocid(Doctypeval);
                const today = new Date();
                const todayDate = today.getFullYear() + '-' +
                    (today.getMonth() + 1).toString().padStart(2, '0') + '-' +
                    today.getDate().toString().padStart(2, '0');
                    $('#DtDocDate').val(todayDate);
                    GetDepartmentList();
                   GetBankList();
                   GetEmployeeList();
                  // addItemRecordRow();
            }
    }

    function SaveData(saveDt) {
                $.ajax({
                    url: '@Url.Action("SaveOrUpdateAdvanceListCreationEntry", "AdvanceListCreation")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(saveDt),
                    success: function (response) {
                        if (response?.status) {
                            toastr.success("Data Insert successfully");
                            setTimeout(() => {
                                window.location.href = '/AdvanceListCreationList/Index';
                            }, 1500);
                        } else {
                            toastr.error(response?.message || "Save failed. Please try again.");
                        }
                    },
                    error: function () {
                        toastr.error("Error occurred while saving. Please contact admin.");
                    }
                });
    }

    function UpdateData(UpdateDt) {
        $.ajax({
            url: '@Url.Action("SaveOrUpdateAdvanceListCreationEntry", "AdvanceListCreation")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(UpdateDt),
            dataType: 'json',
            success: function (response) {
                if (response?.status) {
                   toastr.success("Data Update successfully");
                    // showFlashMessageByKey('update', 'success');
                    setTimeout(() => {
                        window.location.href = '/AdvanceListCreationList/Index';
                    }, 1500);
                } else {
                    toastr.error("Update failed: " + (response?.message || "Unknown error."));
                }
            },
            error: function (xhr, status, error) {
                toastr.error("Data not updated: " + error);
            }
        });
    }

    async function fillHeaderData(headdata) {
        const data = headdata[0];
        console.log(data);
        $("#TxtDocId").val(data.DOC_ID ?? "");
        $("#NumDocNo").val(data.V_NO ?? 0);
        $("#DtDocDate").val(data.V_DATE ? data.V_DATE.substring(0, 10) : '');         
        await GetDocTypeAsync(data.V_TYPE ?? "");
    }

    async function fillItemDetailTable(itemsData) {
        const data = itemsData;
         $('#tblAdvanceListCreation tbody').empty();

        data.forEach(function (item, index) {
            // Creating a new table row with assigned IDs for easier access
            const row = $('<tr></tr>');

            row.append('<td id="rowIndex' + index + '">' + (index + 1) + '</td>');
            row.append('<td id="empCode' + index + '">' + (item.EMP_CODE ?? '') + '</td>');
            row.append('<td id="empName' + index + '">' + (item.EMP_NAME ?? '') + '</td>');
            row.append('<td id="empDept' + index + '">' + (item.DEPARTMENT ?? '') + '</td>');
            row.append('<td id="empDesg' + index + '">' + (item.DESIGNATION ?? '') + '</td>');
            row.append('<td id="empWday' + index + '">' + (item.WDAY ?? '') + '</td>');
            row.append('<td id="empGross' + index + '">' + (item.GROSS ?? '') + '</td>');
            row.append('<td id="empWages' + index + '">' + (item.WAGES ?? '') + '</td>');
            row.append('<td id="empAdvNamT' + index + '">' + (item.ADVNAMT ?? '') + '</td>');
            row.append('<td id="empSancAmt' + index + '">' + (item.SANCAMT ?? '') + ' </td>');
            row.append('<td id="empRemark' + index + '">' + (item.REMARK ?? '') + '</td>');
            row.append('<td id="empRate' + index + '">' + (item.RATE ?? '') + '</td>');
            // Append the row to the table body
            $('#tblAdvanceListCreation tbody').append(row);
        });
 
    }
     
    function collectFormData() {
        
        const payAdvanceList = {
            VType: $('#ddlDocType').val(),
            VNo: $('#NumDocNo').val(),
            VDate: $('#DtDocDate').val(),
            SaveOrUpdate: docId ? 'Update' : 'Save',
            payAdvanceLists: []
        };

       
        $('#tblAdvanceListCreation tbody tr').each(function (index) {
            const row = $(this);  
            const payAdvanceListDT = {
                EmpCode: row.find('#empCode' + index).text() || '',  // Employee Code
                SNo: index + 1,  // Serial number from the row index
                WDay: parseFloat(row.find('#empWday' + index).text()) || 0,  // Working Days
                Gross: parseFloat(row.find('#empGross' + index).text()) || 0,  // Gross Amount
                Wages: parseFloat(row.find('#empWages' + index).text()) || 0,  // Wages
                AdvNamT: parseFloat(row.find('#empAdvNamT' + index).text()) || 0,  // Advance Amount
                SancAmt: parseFloat(row.find('#empSancAmt' + index).text()) || 0,  // Sanction Amount
                Remark: row.find('#empRemark' + index).text() || '',  // Remark
                BankCh: 0,   
                Rate: parseFloat($('#TxtRate').val()) || 0,  // Rate from the textbox outside the table
                PerFlg: $('#chkRate').is(':checked') ? 1 : 0  // Flag if Rate checkbox is checked
            };
 
            payAdvanceList.payAdvanceLists.push(payAdvanceListDT);
        });
     
        return payAdvanceList;
    }


    function GetDocTypeAsync(selectedValue) {
          return new Promise((resolve, reject) => {
              $.ajax({
                  url: '@Url.Action("GetDocType", "AdvanceListCreation")',
                  type: 'GET',
                  dataType: 'json',
                  success: function (response) {
                      if (response.status) {
                          const $dropdown = $('#ddlDocType');
                          $dropdown.empty();
                          $.each(response.data, function (index, item) {
                              $dropdown.append(`<option value="${item.CODE}">${item.NAME}</option>`);
                          });

                          if (selectedValue && $dropdown.find(`option[value="${selectedValue}"]`).length > 0) {
                              $dropdown.val(selectedValue).trigger('change');
                          } else {
                              $dropdown.prop('selectedIndex', 0);
                          }

                          resolve();
                      } else {
                          reject("Invalid response status.");
                      }
                  },
                  error: function (xhr, status, error) {
                      toastr.error("Document Type Load failed: " + error);
                      reject(error);
                  }
              });
          });
    }

    function GetDepartmentList(selectedValue=null) {
        $.ajax({
            url: '@Url.Action("GetDepartmentMast", "AdvanceListCreation")',
            type: 'GET',
            dataType: 'json',
            success: function (response) {
                if (response.status) {
                    const $DropdownId = $('#ddlDepartment');
                    $DropdownId.empty();
                    $DropdownId.append('<option value="">- Select Department Name -</option>');
                    $.each(response.data, function (index, item) {
                        $DropdownId.append(`<option value="${item.CODE}">${item.NAME}</option>`);
                    });

                    $DropdownId.select2({
                        placeholder: "- Select -",
                        allowClear: true
                    });

                    if (selectedValue && $DropdownId.find(`option[value="${selectedValue}"]`).length > 0) {
                        $DropdownId.val(selectedValue).trigger('change');
                    }
                    else {
                        $DropdownId.val('').trigger('change');
                    }

                } else {
                    toastr.error("data Load failed");
                }
            },
            error: function (xhr, status, error) {
                toastr.error("data Load failed", error);
            }
        });
    }

