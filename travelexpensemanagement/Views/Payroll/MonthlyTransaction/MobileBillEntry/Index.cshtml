                <td><input style="min-width: 50px; max-width: 200px;"  class="form-control" id="LIMIT_${rowIndex}" name="LIMIT[${rowIndex}]" type="number" class="form-control-sm"  maxlength= "10"  oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);"  /></td>

                <td><input style="min-width: 50px; max-width: 200px;"  class="form-control" id="BILL_AMT_${rowIndex}" name="BILL_AMT[${rowIndex}]" type="number" class="form-control-sm"  oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" /></td>
                <td><input style="min-width: 50px; max-width: 200px;"  class="form-control" id="DEDUCT_AMT_${rowIndex}" name="DEDUCT_AMT[${rowIndex}]" type="number" class="form-control-sm"  oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" /></td>
                <td><input style="min-width: 50px; max-width: 200px;"  class="form-control" id="NAME_${rowIndex}" name="NAME[${rowIndex}]" type="text" class="form-control-sm"  maxlength= "60" /></td>
                <td>
                    <select style="min-width: 100px; max-width: 200px;" class="form-control" id="DR_AC_NAME_${rowIndex}" data-id=${rowIndex} name="DR_AC_NAME[${rowIndex}]" class="form-control-sm">
                        <option value="">-- Select Debit Account Name --</option>
                    </select>
