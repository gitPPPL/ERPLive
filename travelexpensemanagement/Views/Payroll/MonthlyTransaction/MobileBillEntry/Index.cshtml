            rowIndex++;
            jsMobileBillEntry.rowIndex = rowIndex;

        },

        loadEmpList : function (targetSelector) {
            return $.ajax({
                url: '@Url.Action("GetEmplist", "MobileBillEntry")',
                type: 'GET',
                data: {},
                dataType: 'json',
                success: function (data) {
                    let $ddl = $(targetSelector);

                    $ddl.on('change', function () {
                        const rowId = $(this).data('id');
                        const selected = $(this).find('option:selected');
                        const empCode = $(this).val();
                        $('#EMP_CODE_' + rowId).val(empCode);
                    });

                    $ddl.empty();
                    $ddl.append('<option value="">-- Select Employee --</option>');
                    $.each(data.data, function (index, item) {
                        $ddl.append('<option  value="' + item.value + '">' + item.text + '</option>');
                    });

                },
                error: function (xhr, status, error) {
                    toastr.error('Error loading Employee list: ' + error);
                }
            });
        },

        copyFromMobileEntry : function(){

             const searchTerm = $('#searchBoxMB').val();

             return $.ajax({
                url: '@Url.Action("GetCopyMobileList", "MobileBillEntry")',
                type: 'GET',
                data: {
                    searchTerm,
                    pageNumber: jsMobileBillEntry.currentPage,
                    pageSize: jsMobileBillEntry.pageSize
                },
                dataType: 'json',
                success: function (data) {

                    const $table = $('#tblCopyMobileBilldata');
                    // ensure exactly one <tbody>
                    let $tbody = $table.children('tbody');
                    if ($tbody.length === 0) {
                        $tbody = $('<tbody/>').appendTo($table);
                    } else {
                        $tbody.empty();
                    }

                    $.each(data.data, function (index, item) {
                        let $row  = $ (`<tr>
                                         <td><input type="checkbox" id="selectDocId`+ index +`"  data-docNo = "`+ item.docNo +`"   /></td>
                                         <td>${item.docId || ''}</td>
                                         <td>${item.docNo || ''}</td>
                                         <td>${item.docDate || ''}</td>
                                         <td>${item.remark || ''}</td>
                                         <td>${item.BillAmount || ''}</td>
                                         <td>${item.deductAmount || ''}</td>
                                         <td>${item.dr_bill_name || ''}</td>
                                         <td>${item.cr_bill_name || ''}</td>
                                         <td>${item.cgstAmt || ''}</td>
                                         <td>${item.sgstAmt || ''}</td>
                                         <td>${item.igstAmt || ''}</td>
                                         <td>${item.cgstActName || ''}</td>
                                         <td>${item.sgstActName || ''}</td>
                                         <td>${item.igstActName || ''}</td>
                                    <tr/>`);

                        let $checkbox =  $row.find(`#selectDocId${index}`);
                        debugger;
                        // $checkbox.click(function () {
                        //     if ($(this).prop('checked')) {
                        //         $(this).removeAttr('checked'); // uncheck
                        //         $(this).prop('checked', false); // check
                        //     } else {
                        //         $(this).prop('checked', true); // check
                        //     }
                        // });

                        $tbody.append($row);

                    });

                },
                error: function (xhr, status, error) {
                    toastr.error('Error loading Employee list: ' + error);
                }
            });

        },


    };


</script>

<script>


    $(document).ready(function () {
        jsMobileBillEntry.Initialize();
        jsMobileBillEntry.loadFormData();
        // On Doc Type change, fetch new Doc ID
        $('#ddlDocType').on('change', function () {
            const selectedDocType = $(this).val();
            if (!jsMobileBillEntry.getQueryParam("id")){
                jsMobileBillEntry.GetDocid(selectedDocType);
            }
        });

        // Save button click handler
        $('#btn-save').on('click', function () {

            const mbillEntry = jsMobileBillEntry.collectFormData();
            if (jsMobileBillEntry.AddEditMode === 'INSERT') {
                jsMobileBillEntry.SaveMasterData(mbillEntry);
            } else if (jsMobileBillEntry.AddEditMode === 'UPDATE') {
                jsMobileBillEntry.EditMasterData(mbillEntry);
            }
        });

        $(document).on('click', '.btn-delete-action', function () {
            $(this).closest('tr').remove();
        });

        // MOBILE BILL  MODAL
        $(document).on('click', '#LinkMobillBill', function () {

            jsMobileBillEntry.copyFromMobileEntry();
        });

        $(document).on('keyup', '#searchBoxMB', function () {

            jsMobileBillEntry.copyFromMobileEntry();
        });

        $(document).on('click','#btncopyMbill',function(){

           const findDocNo = () => {
                const docNos = [];
                const $table = $('#tblCopyMobileBilldata');
                const $rows = $table.find('tbody > tr');

                $rows.each(function() {
                    const $checkbox = $(this).find('input[type="checkbox"][id^="selectDocId"]');
                    if ($checkbox.prop('checked')) {
                        const docno = $checkbox.data('docno');
                        if (docno !== undefined && docno !== null) {
                            docNos.push(docno);
                        }
                    }
                });

                return docNos;
            };

            let docNos = findDocNo();


            const getRowsFromBillEntry = (docId) =>{

                 $.ajax({
                    url: '/MobileBillEntry/GetMobBillEntryDatabyId',
                    type: 'GET',
                    data: { Vno: docId },
                    success: function (res) {
                        if (res.status && res.data) {
                            const url = new URL(window.location); // current URL
                            url.searchParams.set('id', docId); // add or update ?id=
                            window.history.pushState({}, '', url);
                            jsMobileBillEntry.fillFormFields(res.data, false);
                        } else {
                            toastr.warning('No data found for this ID.');
                        }
                    },
                    error: function () {
                        toastr.error('Failed to load data.');
                    }
                });

            }

            debugger;

            getRowsFromBillEntry(docNos[0]);

            //console.log('docnos --> ',docNos);

        });


    });


</script>