                    <i class="fa fa-trash btn-delete-action text-danger" title="Delete Row" style="cursor:pointer;"></i>
                </td>
                <td><input style="display:none" id="REF_TYPE_${rowIndex}" name="REF_TYPE[${rowIndex}]" type="text" class="form-control-sm" /></td>
            </tr>`;

            // Remove existing add icons from all rows (but leave delete icons untouched)
            $('#tblMobileBillEntry tbody tr td .btn-add-action').remove();
            $('#tblMobileBillEntry tbody').append($(rowHtml));


            if ( !jsMobileBillEntry.getQueryParam('id') ||  btnClick){
                this.loadEmpList(`#EMP_NAME_${rowIndex}`);
                this.SetAcountDropDown($(`#DR_AC_NAME_${rowIndex}`));
                this.SetAcountDropDown($(`#CR_AC_NAME_${rowIndex}`));
