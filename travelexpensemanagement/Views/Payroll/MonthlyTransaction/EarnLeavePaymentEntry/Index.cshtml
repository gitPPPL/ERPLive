@{
    ViewBag.Title = "Earn Leave Payment Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
    <legend class="legend-field">Earn Leave Payment Entry</legend>
    <form id="EarnLeavePaymentEntryForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumDocNo">Doc No</label>
                    <input type="number" class="form-control" id="NumDocNo" placeholder="Enter Doc No" readonly>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DtDocDate">Doc Date</label>
                    <input type="date" class="form-control" id="DtDocDate" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlEmployeeName">Employee Name</label>
                    <select class="form-control" id="ddlEmployeeName">
                        <option value="">Select Employee Name</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-2">
                <div class="form-group">
                    <label for="NumBalDays">Balance Days</label>
                    <input type="number" class="form-control" id="NumBalDays" readonly />
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="NumPayDay">Pay Day</label>
                    <input type="number" class="form-control" id="NumPayDay" />
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="NumGross">Gross</label>
                    <input type="number" class="form-control" id="NumGross" readonly />
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="Numrate">Rate</label>
                    <input type="number" class="form-control" id="Numrate"  readonly/>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="NumAmount">Amount</label>
                    <input type="number" class="form-control" id="NumAmount" />
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <fieldset>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="DtFromDate">From Date</label>
                                <input type="date" class="form-control" id="DtFromDate" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="DtToDate">To Date</label>
                                <input type="date" class="form-control" id="DtToDate" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="btn-mt">
                                <button type="button" class="btn btn-print" id="btn_print"><i class="fa fa-print"></i>Print</button>
                            </div>
                        </div>
                    </div>

                </fieldset>


            </div>
        </div>
           

        <div class="row">
            <div class="col-md-3">
                <div class="btn-mt">
                    <button onclick="window.location.href='@Url.Action("Index", "EarnLeavePaymentList")'" type="button" class="btn btn-draft">
                        <i class="fa fa-list"></i>Back to list
                    </button>
                </div>
            </div>
            <div class="offset-md-5 col-md-4">
                <div class="button-right btn-mt">
                    <button id="btn-save" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
                    <button id="btn_cancel" type="button" class="btn btn-danger" onclick="clearForm();">
                        <i class="fa fa-close"></i> Cancel
                    </button>
                </div>
            </div>
        </div>
    </form>
</fieldset>
<script>
    const urlParams = new URLSearchParams(window.location.search);
    const rowId = urlParams.get('id');
    const isReadOnly = urlParams.get('readOnly') === 'true';

    $(document).ready(async function () {
        await DDLEmpcode();

        if (rowId) 
        {
            await loadById(rowId);
            if (isReadOnly) setFormReadOnly();
        } 
        else
        {
            $('#DtDocDate').val(new Date().toISOString().split('T')[0]);
            await GetVNo();
           $('#NumBalDays').val(1);

        }
                   
        $("#NumGross, #NumPayDay").on("input", function () {
            calRateAndAmt();
        });

        $('#ddlEmployeeName').on('change', function () {
        var empId = $(this).val();
        var vDate = $('#DtDocDate').val();

        if (empId && vDate) {
            $.ajax({
                url: '/EarnLeavePaymentEntry/GetEmployeeBalance',
                type: 'GET',
                data: { empId: empId, vDate: vDate },
                success: function (data) {
                  
                    console.log('Data',data);
                    
                    if (data.error) {
                        alert("Error: " + data.error);
                    } else {
                        $('#NumBalDays').val(data.baldays);
                        $('#NumGross').val(data.gross);
                    }
                },
                error: function (xhr) {
                    alert("Error fetching data: " + xhr.responseText);
                }
            });
        }
    });
           
        $("#btn-save").click(function (e) {
            e.preventDefault();

            const DOC_ID = $("#TxtCode").val();
            const V_NO = $("#NumDocNo").val().trim();
            const V_DATE = $("#DtDocDate").val().trim();
            const EMP_CODE = $("#ddlEmployeeName").val();
            const BAL_DAYS = $("#NumBalDays").val().trim();
            const PAY_DAYS = $("#NumPayDay").val().trim();
            const GROSS = $("#NumGross").val().trim();
         
            const RATE = $("#Numrate").val().trim();
            const AMOUNT = $("#NumAmount").val().trim();
                    

            const action = DOC_ID ? 'UPDATE' : 'INSERT';

            const formData = {
             DOC_ID,V_NO,V_DATE,EMP_CODE,BAL_DAYS,PAY_DAYS,GROSS,RATE,AMOUNT,action
            };

          
            $("#btn-save").prop("disabled", true);

            $.ajax({
                url: '/EarnLeavePaymentEntry/SaveTempMaster',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (response) {
                    toastr.success(response.message || "Saved successfully!");
                    setTimeout(() => window.location.href = '/EarnLeavePaymentList/Index', 1000);
             
                },
                error: function (xhr, status, error) {
                    console.error("Error:", xhr.responseText);
                    toastr.error("Something went wrong. Please try again.");
                },
                complete: function () {
                    $("#btn-save").prop("disabled", false);
                }
            });
        });

    });

    async function GetVNo() {
        try {
            const resp = await fetch('/EarnLeavePaymentEntry/GetVNo');
            const data = await resp.json();
            if (data.v_NO != null) {
                $('#NumDocNo').val(data.v_NO);
            }
        } catch (err) {
            console.error("Error fetching VNo:", err);
            toastr.error("Error fetching Document Number");
        }
    }
     
    async function DDLEmpcode() {
        try {
            const response = await fetch('/EarnLeavePaymentEntry/DDlEmp');
            if (!response.ok) throw new Error('Network error: ' + response.statusText);
            const data = await response.json();
            const ddl = $('#ddlEmployeeName');
            ddl.empty().append('<option value="" selected>-- Select Employee --</option>');
            data.forEach(item => {
                ddl.append(`<option value="${item.value}">${item.text}</option>`);
            });
        } catch (error) {
            console.error("Error loading Employee:", error);
            toastr.error('Error loading employee list: ' + error.message);
        }
    }

    function loadById(code) {
        $.ajax({
            url: '/EarnLeavePaymentList/GetdatabyCode',
            type: 'GET',
            data: { code: code },
            success: function (res) {
                if (!res.success || !res.data) {
                    toastr.warning("No data found for the given ID.");
                    return;
                }

                console.log('Data received:', res);
                populateForm(res.data);
            },
            error: function (xhr, status, error) {
                console.error("Error details:", xhr, status, error);
                toastr.error("Error loading data: " + (xhr.responseText || error));
            }
        });
    }

    function populateForm(data) {
        $("#NumDocNo").val($.trim(data.v_NO));
        $("#DtDocDate").val(formatDate(data.v_DATE));
        const empCode = data.emP_CODE;
        const ddl = $("#ddlEmployeeName");
        ddl.val(empCode).trigger('change');
        $("#TxtCode").val($.trim(data.doC_ID));
        $("#NumBalDays").val($.trim(data.baL_DAYS));
        $("#NumPayDay").val($.trim(data.paY_DAYS));
         $("#NumGross").val($.trim(data.gross));
         $("#Numrate").val($.trim(data.rate));
         $("#NumAmount").val($.trim(data.amount));
      
    }

    function setFormReadOnly() {
        $('#NumDocNo, #DtDocDate, #ddlEmployeeName, #NumAmount, #NumInstallment, #TxtRemarks').prop('disabled', true);
    }
         
    function calRateAndAmt() {
        const gross = parseFloat($("#NumGross").val()) || 0;
        const payDays = parseFloat($("#NumPayDay").val()) || 0;
        const rate = gross / 26;
        $("#Numrate").val(rate.toFixed(0));
        const amount = rate * payDays;
        $("#NumAmount").val(amount.toFixed(0)); 
    }

    function formatDate(dateString) {
        const date = new Date(dateString);
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

    function clearForm() {
        if (!rowId) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to undo this action!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, clear it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#NumBalDays').val('');
                    $('#NumBalDays').val('');
                    $('#NumGross').val('');
                    $('#Numrate').val('');
                    $('#NumAmount').val('');
                    $('#TxtCode').val('');

                    $('#ddlEmployeeName').val('0').trigger('change');
              
                    Swal.fire(
                        'Cleared!',
                        'The form has been cleared except for the Document No.',
                        'success'
                    );
                }
            });
        } else {

            document.getElementById(`row-${rowId}`).reset();
        }
    }

</script>
