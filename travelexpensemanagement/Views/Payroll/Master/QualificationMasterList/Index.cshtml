@{
    ViewBag.Title = "Qualification Master List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<fieldset>
    <legend class="legend-field">Qualification Master List</legend>
    <div class="row">
        <div class="col-lg-4">
            <div class="input-group">
                <input type="text" id="searchBox" class="form-control" placeholder="Search Module..." aria-label="Search term">
            </div>
        </div>
        <div class="col-lg-8 btn-align">
            <button id="btnSave" onclick="window.location.href='@Url.Action("Index", "QualificationMaster")'" type="submit" class="btn btn-primary">
                <i class="fa fa-plus"></i>Add 
            </button>
            <button class="btn btn-print">
                <i class="fa fa-print"></i> Print
            </button>
            <button class="btn btn-export">
                <i class="fas fa-file-export"></i> Export
            </button>
            <button class="btn btn-mail">
                <i class="fa fa-envelope"></i> Mail
            </button>
        
        </div>
    </div>
    <div class="card">
        <div class="table-responsive">
            <table id="tblQualificationMaster" class="table-width">
                <thead class="table-head">
                    <tr>
                        <th style="display:none;">Code</th>
                        <th>Name</th>
                        <th>Short Name</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
    <div class="pagination-wrapper">
        <ul class="pagination" id="tablePagination"></ul>
    </div>
</fieldset>

<script>
    let currentPage = 1;
    let pageSize = 10;
    let moduleMap = {};
    let parentModuleMap = {};

    $(document).ready(function () {
        loadAllMenus();
    });

    //Load Full LIST START

    function loadAllMenus() {
        const searchTerm = $('#searchBox').val();

        $.ajax({
            url: '/QualificationMasterList/GetQualificationlist',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function(res) {
                if (!res.success) {
                    toastr.error("Failed to load data.");
                    return;
                }

                const GetQualificationLevellist = res.lists;
                const totalCount = res.totalCount;

                console.log('listdata' , res.lists);

                let tbody = $('#tblQualificationMaster tbody');
                tbody.empty();

                if (GetQualificationLevellist.length === 0) {
                    tbody.append('<tr><td colspan="8" class="text-center text-muted">No List found.</td></tr>');
                } else {
                    $.each(GetQualificationLevellist, function(index, item) {
                        $('#tblQualificationMaster tbody').append(`
                            <tr>
                                <td>${item.name}</td>
                                <td>${item.shortname}</td>
                                <td>${item.active === 1 ? 'Yes' : 'No'}</td>
                                <td>
                                    <button class="btn btn-sm btn-light">
                                        <i class="fas fa-edit" style="cursor: pointer;" title="Edit" onclick="AddOrEditFunction('${item.code}')"></i>
                                    </button>
                                    <button class="btn btn-sm btn-light">
                                        <i class="fas fa-eye" style="cursor: pointer;" title="View Detail" onclick="viewMenuDetails('${item.code}')"></i>
                                    </button>
                                    <button class="btn btn-sm btn-light btn-delete" onclick="deleteTemp('${item.code}')">
                                        <i class="fas fa-trash text-danger" title="Delete"></i>
                                    </button>
                                </td>
                            </tr>
                        `);
                    });

                    renderPagination(totalCount, pageSize, currentPage);
                }
            },
            error: function(xhr) {
                toastr.error('Error loading menu list: ' + xhr.responseText);
            }
        });
    }

    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const paginationContainer = $('#tablePagination');

        // Clear previous pagination
        paginationContainer.empty();

        // No records case
        if (total === 0) {
            paginationContainer.html('<span class="text-muted">No records found</span>');
            return;
        }

        // Don't render pagination if only one page
        if (totalPages <= 1) return;

        let paginationHtml = '';

        // First and Prev
        if (currentPage > 1) {
            paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        if (currentPage <= 3) {
            endPage = Math.min(5, totalPages);
        }
        if (currentPage >= totalPages - 2) {
            startPage = Math.max(totalPages - 4, 1);
        }

        for (let i = startPage; i <= endPage; i++) {
            paginationHtml += `
                <button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1"
                        onclick="goToPage(${i})">${i}</button>`;
        }

        // Next and Last
        if (currentPage < totalPages) {
            paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        paginationContainer.html(paginationHtml);
    }

    function goToPage(page) {
        currentPage = page;
        loadAllMenus();
    }

    $('#searchBox').on('keyup', function () {
        currentPage = 1;
        loadAllMenus();
    });

    //Load Full LIST END

    //Redirect to EDIT AND VIEW FORM

    function AddOrEditFunction(code) {
        window.location.href = '/QualificationMaster/Index?id=' + encodeURIComponent(code);
    }

    function viewMenuDetails(code) {
        if (code != null) {
            window.location.href = '/QualificationMaster/Index?id=' + encodeURIComponent(code) + '&mode=view';
        }
    }


    function deleteTemp(code) {
         Swal.fire({
             title: 'Are you sure?',
             text: "You won't be able to revert this deletion!",
             icon: 'warning',
             showCancelButton: true,
             confirmButtonColor: '#d33',
             cancelButtonColor: '#3085d6',
             confirmButtonText: 'Yes, delete it!'
         }).then((result) => {
             if (result.isConfirmed) {
                 $.ajax({
                      url: '/QualificationMasterList/Delete',
                     type: 'POST',
                     data: { code: code },
                     success: function (response) {
                         if (response.success) {
                             toastr.success(response.message || "Record deleted successfully.");
                             loadAllMenus();
                         } else {
                             toastr.warning("Delete failed.");
                         }
                     },
                     error: function () {
                         toastr.error("An error occurred while deleting.");
                     }
                 });
             }
         });
     }
</script>

<style>
    /* Pagination Wrapper */
    .pagination-wrapper {
        display: flex;
        justify-content: flex-end; /* Aligns the pagination to the right */
        margin-top: 20px; /* Optional: Adds some spacing from the content above */
    }

    /* Pagination Buttons */
    .pagination {
        margin: 0; /* Optional: Removes any default margin from the list */
    }

        .pagination button {
            margin: 0 5px; /* Adds space between pagination buttons */
        }
</style>
