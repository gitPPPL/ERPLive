@{
	ViewBag.Title = "Salary Structure Master List";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<fieldset>
	<legend class="legend-field">Salary Structure Master List</legend>
	<div class="row">
		<div class="col-lg-4">
			<div class="input-group">
				<input type="text" id="searchBox" class="form-control" placeholder="Search Module..." aria-label="Search term">
			</div>
		</div>
		<div class="col-lg-8 btn-align">
			<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "SalaryStructureMaster")'" type="submit" class="btn btn-primary">
				<i class="fa fa-plus"></i>Add Salary Structure
			</button>
			<button class="btn btn-print">
				<i class="fa fa-print"></i> Print
			</button>
			<button class="btn btn-export">
				<i class="fas fa-file-export"></i> Export
			</button>
			<button class="btn btn-mail">
				<i class="fa fa-envelope"></i> Mail
			</button>
			<button class="btn btn-send">
				<i class="fa fa-paper-plane"></i> Approval Send
			</button>
			<button class="btn btn-approved">
				<i class="fa fa-check"></i> Approved
			</button>
		</div>
	</div>
	<div class="card">
		<div class="table-responsive">
			<table id="tblSalaryStructureMaster" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>Department</th>
						<th>Designation</th>
						<th>From Salary</th>
						<th>To Salary</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
	</div>
	<div class="pagination-wrapper">
		<ul class="pagination" id="tablePagination"></ul>
	</div>
</fieldset>


<script>
	let currentPage = 1;
	let pageSize = 10;

	$(document).ready(function () {
		GetMasterDataList();
		$('#searchBox').on('keyup', function () {
			currentPage = 1;
			GetMasterDataList();
		});
	});

	function GetMasterDataList() {
		const searchTerm = $('#searchBox').val().trim();
		$.ajax({
			url: '@Url.Action("GetSalaryStructData", "SalaryStructureMasterList")',
			type: 'GET',
			dataType: 'json',
			data: {
				searchTerm: searchTerm,
				pageNumber: currentPage,
				pageSize: pageSize
			},
			success: function (res) {
				const mastListData = res.data || [];
				const totalCount = res.totalCount || 0;
				let tbody = $('#tblSalaryStructureMaster tbody');
				tbody.empty();
				console.log(mastListData);
				if (mastListData.length === 0) {
					tbody.append('<tr><td colspan="10" class="text-center text-muted"></td></tr>');
					return;
				}
				$.each(mastListData, function (index, item) {
					tbody.append(`
						<tr>
							<td class="code d-none">${item.CODE}</td>
							<td>${item.Department}</td>
							<td>${item.Designation}</td>
							<td>${item.MAX_SALARY}</td>
							<td>${item.MIN_SALARY}</td>							 
							<td>
								<button class="btn btn-sm btn-light" onclick="AddOrEditFunction('${item.CODE}')" title="Edit">
									<i class="fas fa-edit"></i>
								</button>
								<button class="btn btn-sm btn-light" onclick="viewMenuDetails('${item.CODE}')" title="View Detail">
									<i class="fas fa-eye"></i>
								</button>
								<button class="btn btn-sm btn-light btn-delete" title="Delete">
									<i class="fas fa-trash text-danger"></i>
								</button>
							</td>
						</tr>
					`);
				});

				renderPagination(totalCount, pageSize, currentPage);
			},
			error: function (xhr) {
				toastr.error('Error loading Salary Structure Data list: ' + xhr.responseText);
			}
		});
	}

	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const paginationContainer = $('#tablePagination');
		paginationContainer.empty();

		if (total <= 0 || totalPages <= 1) return;

		let paginationHtml = '';

		if (currentPage > 1) {
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		let startPage = Math.max(1, currentPage - 2);
		let endPage = Math.min(totalPages, currentPage + 2);

		if (currentPage <= 3) endPage = Math.min(5, totalPages);
		if (currentPage >= totalPages - 2) startPage = Math.max(totalPages - 4, 1);

		for (let i = startPage; i <= endPage; i++) {
			paginationHtml += `
				<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1"
						onclick="goToPage(${i})">${i}</button>`;
		}

		if (currentPage < totalPages) {
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		paginationContainer.html(paginationHtml);
	}

	function goToPage(page) {
		currentPage = page;
		GetMasterDataList();
	}

	function AddOrEditFunction(rowId) {
		window.location.href = '/SalaryStructureMaster/Index?id=' + encodeURIComponent(rowId);
	}

	function viewMenuDetails(rowId) {
		window.location.href = '/SalaryStructureMaster/Index?id=' + encodeURIComponent(rowId) + '&readOnly=true';
	}

	 $(document).on('click', '.btn-delete', function() {
				const $row = $(this).closest('tr');
				const CodeforDel = $row.find('.code').text().trim();
				Swal.fire({
					title: 'Are you sure you want to delete?',
					text: "This action cannot be undone.",
					icon: 'warning',
					showCancelButton: true,
					confirmButtonText: 'Yes, delete it!',
					cancelButtonText: 'No, cancel!',
					reverseButtons: true
				}).then((result) => {
					if (result.isConfirmed) {
						$.ajax({
							url: '/SalaryStructureMasterList/DelSalaryStructMastDt',
							type: 'DELETE',
							data: { Code: CodeforDel },
							success: function(data) {
								if (data.status === true) {
									Swal.fire(
										'Deleted!',
										'Your data has been deleted.',
										'success'
									);
									$row.remove();
									GetMasterDataList();
								} else {
									Swal.fire(
										'Error!',
										'There was an issue deleting the data.',
										'error'
									);
								}
							},
							error: function(xhr, status, error) {
								Swal.fire(
									'Error!',
									'Data could not be deleted: ' + error,
									'error'
								);
							}
						});
					}
				});
	});

</script>
