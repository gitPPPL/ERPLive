@{
    ViewBag.Title = "Employee Category Master";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentMenu = ViewBag.CurrentMenu as string;
    bool canAdd = false;
    bool canEdit = false;
    bool canDelete = false;
    bool canPrint = false;
    bool canExport = false;
    bool canMail = false;
    bool canApproval = false;
    bool canDocDetail = false;

    foreach (var permission in Model.UserMenuPermissions)
    {
        if (permission.MENU_NAME == ViewBag.CurrentMenu)
        {
            canAdd = Model.UserLevel == 1 || permission._ADD == 1;
            canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
            canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
            canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
            canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
            canMail = Model.UserLevel == 1 || permission._MAIL == 1;
            canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
            canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
            break;
        }
    }
}

<fieldset>
    <legend class="legend-field">Employee Category Master</legend>

    <!-- Top Buttons (Print, Export, Mail, Approval) -->
    <div class="row">
        <div class="offset-md-4 col-md-8">
            <div class="button-right">

            @if (canPrint)
            {
                <button class="btn btn-print">
                    <i class="fa fa-print"></i> Print
                </button>
            }
            @if (canExport)
            {
                <button class="btn btn-export">
                    <i class="fas fa-file-export"></i> Export
                </button>
            }
            @if (canMail)
            {
                <button class="btn btn-mail">
                    <i class="fa fa-envelope"></i> Mail
                </button>
            }

            @if (canApproval)
            {
                <button class="btn btn-send">
                <i class="fa fa-paper-plane"></i> Approval Send
                </button>
            }



            @if (canApproval)
            {
                <button class="btn btn-approved">
                    <i class="fa fa-check"></i> Approved
                </button>
            }

            </div>
        </div>
    </div>

    <!-- Form -->
    <form id="EmployeeCategoryMasterForm">
        <input type="hidden" class="form-control" id="CODE" name="CODE">

        <!-- Name and Short Name Fields -->
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtName">Name<span class="required">*</span></label>
                    <input type="text" class="form-control" id="TxtName" name="Name" placeholder="Enter Name" maxlength="100">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtShortName">Short Name<span class="required">*</span></label>
                    <input type="text" class="form-control" id="TxtShortName" name="ShortName" placeholder="Enter Short Name" maxlength="30">
                </div>
            </div>
            <div class="offset-md-3 col-md-3">
                <div class="active-toggle mt-4">
                    <label class="toggle-switch me-2">
                        <input type="checkbox" id="ACTIVE" name="ACTIVE" checked>
                        <span class="slider"></span>
                    </label>
                    <span class="label-status" id="statusText">Active</span>
                </div>
            </div>
        </div>        

        <div class="row">
            <div class="col-md-6">
                <button onclick="window.location.href='@Url.Action("Index", "EmployeeCategoryMasterList")'" type="button" class="btn btn-draft" id="BacktolistID">
                    <i class="fa fa-list"></i> Back to list
                </button>
            </div>
            <div class="col-md-6">
                <div class="button-right">
                    <button id="btnSaves" type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Save
                    </button>
                </div>
            </div>
        </div>
    </form>
</fieldset>

<script>
    $(document).ready(function() {
        const urlParams = new URLSearchParams(location.search);
        const rowId = parseInt(urlParams.get('id'));
        const mode = urlParams.get("mode");
        const isReadOnly = urlParams.get('readOnly') === 'true';

        // Handle ACTIVE toggle
        $('#ACTIVE').on('change', function() {
            const isChecked = $(this).is(':checked');
            const status = isChecked ? 'Active' : 'Inactive';
            $('#statusText')
                .text(status)
                .removeClass('active inactive')
                .addClass(isChecked ? 'active' : 'inactive');
        });

        // Load data if editing
        if (!isNaN(rowId) && rowId > 0) {
            loadMasterById(rowId);
            if (isReadOnly) {
                setFormReadOnly();
            }
        }

        // If in view mode, set read-only and show badge
        if (mode === "view") {
            setFormReadOnly();
            $('#EmployeeCategoryMasterForm').after('<span class="badge bg-secondary ms-2">Read-Only Mode</span>');
        }

        // Autocomplete for Name
        $("#TxtName").autocomplete({
            minLength: 1,
            source: function (request, response) {
                $.ajax({
                    url: "/EmployeeCategoryMaster/SearchNames",
                    type: "GET",
                    data: { term: request.term },
                    success: function (data) {
                        response(data);
                    }
                });
            },
            select: function (event, ui) {
                $("#TxtName").val(ui.item.value);
            }
        });

        // Save Button Logic
        $("#btnSaves").click(async function(e) {
            e.preventDefault();

            const Name = $("#TxtName").val().trim();
            const SHORTNAME = $("#TxtShortName").val().trim();
            let CODE = $("#CODE").val().trim();
            const isActive = $('#ACTIVE').is(':checked') ? 1 : 0;

            // Input validation
            if (!Name) {
                toastr.warning("Please enter a Name.");
                  $("#TxtName").attr("style", "border-color:red !important;").focus();
                return;
            }

            if (!SHORTNAME) {
                toastr.warning("Please enter a SHORT NAME.");
                   $("#TxtShortName").attr("style", "border-color:red !important;").focus();
            
                return;
            }

            // Determine action (INSERT/UPDATE)
            const action = (CODE && !isNaN(CODE) && CODE > 0) ? 'UPDATE' : 'INSERT';

            // If code is missing, fetch a new code
            if (!CODE) {
                CODE = await getCode();
            }

            // Prepare form data
            const formData = {
                NAME: Name,
                CODE: (CODE && !isNaN(CODE)) ? CODE : null,
                SHORTNAME: SHORTNAME,
                ACTIVE: isActive,
                ACTION: action
            };

            // Disable the save button to prevent multiple submissions
            $("#btnSaves").prop("disabled", true);

            // AJAX call to save data
            $.ajax({
                url: '/EmployeeCategoryMaster/SaveMaster',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    if (response.success) {
                        toastr.success(response.message || "Saved successfully!");
                        window.location.href = '/EmployeeCategoryMaster/Index?id=' + encodeURIComponent(formData.CODE) + '&mode=view';
                    } else {
                        toastr.error(response.message || "Save failed.");
                    }
                },
                error: function(xhr, status, error) {
                    console.error("Error: ", xhr.responseText);
                    toastr.error("Something went wrong.");
                },
                complete: function() {
                    $("#btnSaves").prop("disabled", false);
                }
            });
        });



        $("#TxtName, #TxtShortName").on('change keyup', function () {
   
            if ($(this).val().trim() !== "") {
             $(this).removeAttr('style');
            }
        });
            
        
    });

    // Load Master data by ID
    function loadMasterById(code) {
        $.ajax({
            url: '/EmployeeCategoryMasterList/GetEmployeecategoryByCode',
            type: 'GET',
            data: { code },
            success: function(res) {
                if (!res.success || !res.data) {
                    toastr.warning("No Employee Category Master found for the given ID.");
                    return;
                }
                populateForm(res.data);
            },
            error: function(xhr) {
                toastr.error("Error loading data: " + xhr.responseText);
            }
        });
    }

    // Populate form with data
    function populateForm(data) {
        $("#TxtName").val($.trim(data.name));
        $("#TxtShortName").val($.trim(data.shortname));
        $("#CODE").val($.trim(data.code));
        const isActive = data.active === 1 || data.active === true;
        $('#ACTIVE').prop('checked', isActive);
        $('#statusText')
            .text(isActive ? 'Active' : 'Inactive')
            .removeClass('active inactive')
            .addClass(isActive ? 'active' : 'inactive');
    }

    // Set form as read-only
    function setFormReadOnly() {
        $('#EmployeeCategoryMasterForm :input').prop('disabled', true);
        $('#btnSaves').hide();
        $('#BacktolistID').prop('disabled', false);
    }

    // Fetch a new code
    function getCode() {
        return fetch('/EmployeeCategoryMaster/Getcode')
            .then(response => response.json())
            .then(data => data.code)
            .catch(() => null);
    }
</script>
