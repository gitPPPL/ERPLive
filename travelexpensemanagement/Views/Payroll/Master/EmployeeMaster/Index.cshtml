<script src="~/js/GlobalFunction.js" type="text/javascript"></script>
 
<script>

     const empdetailSequence = [
      'txtEmpCode', 'ddlTitle', 'txtFirstName', 'txtMiddleName', 'txtLastName', 'txtEmpName', 'txtFatherHusband',
      'txtDOB','NumAge','ddlGender','DtDOM','ddlMaritalStatus','NumContact', 'NumMobile', 'ddlBloodGroup',
      'txtReligion', 'txtEmail', 'txtPermAddress1', 'txtPermAddress2', 'txtPermAddress3', 'ddlPermCity', 'txtTemporaryAddress1', 'txtTemporaryAddress2', 'txtTemporaryAddress3', 'ddlTempCity',
      'txtSpouseName', 'txtRejoinCode', 'ddlDesignation', 'ddlPlace', 'ddlCader', 'ddlGrade', 'ddlJobResponsibility', 'ddlDepartment', 'ddlType', 'ddlIncentive', 'ddlCategoryWPlace',
      'dtJoinDate', 'dtResignDate', 'dtPermanentDate', 'txtExperience', 'ddlPfAppl', 'ddlEsiAppl', 'ddlVPFAppl', 'dtPFDate', 'dtESIDate', 'dtVPFDt', 'dtPFNo', 'dtESINo',
      'ddlOffday', 'ddlRiskZone', 'NumUAN', 'txtAadhar', 'txtDL', 'ddlShift', 'txtReferred', 'txtPAN', 'txtVoterID', 'NumCardNo', 'ddlBank', 'NumAccountNo',
      'txtAccountType', 'txtBranch', 'txtIFSC', 'ddlBankVerified', 'ddlLeaveAppl', 'ddlBonusAppl', 'ddlColonyApp', 'ddlHolidayApply', 'ddlABRY', 'NumRoomNo', 'txtRemarks'
    ];
    const experiencesequence2 = ['TxtPreviousEmployer', 'txtAddress', 'DtJoining', 'DtResign', 'NumPeriod','NumLastSalary', 'txtDepartment', 'txtDesignation', 'txtJobProfile'];
    const qualificationsequence2 = [ 'tblEmployeeExperience','TxtQualification', 'txtBoard', 'TxtYear', 'NumJobProfile', 'txtQualificationRemarks'];
    const familysequence3 = ['TxtMember', 'NumMemAge', 'NumContactNo', 'TxtRelation', 'ddlMinor', 'TxtNominee', 'NumShare', 'TxtAddressFD', 'TxtRemarksFD'];
    const relativesequence4 = ['TxtNameRD', 'DdlRelativeDepartment', 'NumContactNoRD', 'TxtRelationRD', 'TxtAddressRD', 'TxtRemarksRD'];


    const allFieldIds = [
      ...empdetailSequence,
      ...experiencesequence2,
      ...qualificationsequence2,
      ...familysequence3,
      ...relativesequence4
    ];
    let PreviousEmpCode=0;
    let MasterTblId ;
    let readOnly;

    $(document).ready(function () {


        GetDesignationList();
        GetCaderList();
        GetGradeList();
        GetJobResponsbilityList();
        GetCategoryList();
        GetShiftList();
        GetBankList();
        GetCityList('#ddlTempCity');
        GetCityList('#ddlPermCity');
        GetCityList();
        GetPlaceList('#ddlPlace');
        GetPlaceList('#ddlIncentive');
        GetDepartmentList('#DdlRelativeDepartment');
        GetDepartmentList('#ddlDepartment');


        setEnterKeyFocus(empdetailSequence);
        setEnterKeyFocus(experiencesequence2);
        setEnterKeyFocus(qualificationsequence2);
        setEnterKeyFocus(familysequence3);
        setEnterKeyFocus(relativesequence4);

        function setEnterKeyFocus(sequence) {
            sequence.forEach((id, index) => {
                $(`#${id}`).on('keypress', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        if (index + 1 < sequence.length) {
                            $(`#${sequence[index + 1]}`).focus();
                        }
                    }
                });
            });
        }


        const MasterTblId = getQueryParam('id');
        const readOnly = getQueryParam('readOnly');

        if (MasterTblId) {
            GetMasterDataList(MasterTblId, readOnly);
        }

        $('.ctc-checkbox').on('change', function () {
        $(this).val($(this).is(':checked') ? 1 : 0);
        });
        $('#DdActive').on('change', function () {
            let isChecked = $(this).is(':checked');
            let status = isChecked ? 'Active' : 'Inactive';
            let value = isChecked ? 1 : 0;
            $('#statusText').text(status);
            $(this).val(value);
        });

         $('#btnExperience').click(function (e) {
            e.preventDefault();
            let employer = $('#TxtPreviousEmployer').val().trim();
            let address = $('#txtAddress').val().trim();
            let doj = $('#DtJoining').val().trim();
            let dor = $('#DtResign').val().trim();
            let period = $('#NumPeriod').val().trim();
            let lastSalary = $('#NumLastSalary').val().trim();
            let department = $('#txtDepartment').val().trim();
            let designation = $('#txtDesignation').val().trim();
            let jobProfile = $('#txtJobProfile').val().trim();

            if (!employer && !address && !doj && !dor && !period && !lastSalary && !department && !designation && !jobProfile) {
                alert('Please enter at least one value before adding.');
                return;
            }
            let missingFields = [];
            if (!employer) missingFields.push("Previous Employer");
            if (!department) missingFields.push("Department");
            if (!designation) missingFields.push("Designation");

            if (missingFields.length > 0) {
                alert("Please fill required fields: " + missingFields.join(", "));
                return;
            }

            let newRow = `<tr>
                <td>${employer}</td>
                <td>${address}</td>
                <td>${doj}</td>
                <td>${dor}</td>
                <td>${period}</td>
                <td>${lastSalary}</td>
                <td>${department}</td>
                <td>${designation}</td>
                <td>${jobProfile}</td>
                <td><button class="btn btn-danger btn-sm btnRemoveExperience"><i class="fa fa-trash"></i></button></td>
            </tr>`;

            $('#tblEmployeeExperience tbody').append(newRow);
            $('#TxtPreviousEmployer, #txtAddress, #DtJoining, #DtResign, #NumPeriod, #NumLastSalary, #txtDepartment, #txtDesignation, #txtJobProfile').val('');
        });

        $(document).on('click', '.btnRemoveExperience', function () {
        $(this).closest('tr').remove();
        });

        $('#btnQualification').click(function (e) {
        e.preventDefault();

        const qualification = $('#TxtQualification');
        const board = $('#txtBoard');
        const year = $('#TxtYear');
        const marksObtained = $('#NumJobProfile');
        const remarks = $('#txtQualificationRemarks');
        if (!qualification.val().trim() || !board.val().trim() || !year.val().trim()) {
            alert('Qualification, Board/University, and Year of Passing are required.');
            return;
        }
        if (!/^\d{4}$/.test(year.val().trim())) {
            alert('Year of Passing must be a valid 4-digit year.');
            return;
        }
        $('#tblQualificationDetails tbody').append(`
            <tr>
                <td>${qualification.val().trim()}</td>
                <td>${board.val().trim()}</td>
                <td>${year.val().trim()}</td>
                <td>${marksObtained.val().trim()}</td>
                <td>${remarks.val().trim()}</td>
                <td><button class="btn btn-danger btn-sm btnRemoveQualification"><i class="fa fa-trash"></i></button></td>
            </tr>`);

        $('#TxtQualification, #txtBoard, #TxtYear, #NumJobProfile, #txtQualificationRemarks').val('');
     });

       $(document).on('click', '.btnRemoveQualification', function () {
        $(this).closest('tr').remove();
