@{
    ViewBag.Title = "Employee Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<fieldset>
    <legend class="legend-field">Employee Master</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="window.location.href='@Url.Action("Index", "EmployeeMasterList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>

    <form id="EmployeeMasterForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <div class="navtab-form">
            <ul class="nav nav-tabs" id="formTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" id="tab1-tab" data-bs-toggle="tab" data-bs-target="#tab1" type="button" role="tab">Employee Details</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="tab2-tab" data-bs-toggle="tab" data-bs-target="#tab2" type="button" role="tab">Experience & Qualification</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="tab3-tab" data-bs-toggle="tab" data-bs-target="#tab3" type="button" role="tab">Attachment & Family</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="tab4-tab" data-bs-toggle="tab" data-bs-target="#tab4" type="button" role="tab">Relatives List</button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- tab 1 -->
                <div class="tab-pane fade show active" id="tab1" role="tabpanel">
                    <fieldset class="fieldset-sub">
                        <legend class="sub-legend">Employee Identity</legend>
                        <div class="row">
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Emp. Code <span class="required">*</span></label>
                                    <div class="input-icon-wrapper">
                                        <input type="text" oninput="allowOnlyNumbers(this)" class="form-control" id="txtEmpCode" maxlength="8" placeholder="Enter Emp code">
                                        <span class="input-icon"><i class="fa fa-search"></i></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Title<span class="required">*</span></label>
                                    <select class="form-control" id="ddlTitle">
                                        <option>Mr</option>
                                        <option>Mrs</option>
                                        <option>Ms</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>First Name <span class="required">*</span></label>
                                    <input type="text" class="form-control" id="txtFirstName" maxlength="20" placeholder="Enter First name">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Middle Name</label>
                                    <input type="text" class="form-control" id="txtMiddleName" maxlength="20" placeholder="Enter Middle name">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Last Name</label>
                                    <input type="text" class="form-control" id="txtLastName" maxlength="20" placeholder="Enter Last name">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Employee Name<span class="required">*</span></label>
                                    <input type="text" class="form-control" id="txtEmpName" maxlength="50" placeholder="Full name">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Father/Husband <span class="required">*</span></label>
                                    <input type="text" class="form-control" id="txtFatherHusband" maxlength="30" placeholder="Father or Husband name">
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <!-- Personal Details -->
                    <fieldset class="fieldset-sub">
                        <legend class="sub-legend">Personal Details</legend>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Date of Birth <span class="required">*</span></label>
                                    <input type="date" class="form-control" id="txtDOB">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Age</label>
                                    <input type="text" oninput="allowOnlyNumbers(this)" maxlength="3" class="form-control" id="NumAge" placeholder="Age">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Gender <span class="required">*</span></label>
                                    <select class="form-control" id="ddlGender">
                                        <option value="">--Select Gender--</option>
                                        <option>Male</option>
                                        <option>Female</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Date of Marriage<span class="required">*</span></label>
                                    <input type="date" class="form-control" id="DtDOM">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Marital Status</label>
                                    <select class="form-control" id="ddlMaritalStatus">
                                        <option value="">--Select Marital Status--</option>
                                        <option>Unmarried</option>
                                        <option>Married</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <!-- Contact Details -->
                    <fieldset class="fieldset-sub">
                        <legend class="sub-legend">Contact Details</legend>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Contact No <span class="required">*</span></label>
                                    <input type="text" class="form-control" id="NumContact" placeholder="Enter Phone number">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Mobile No <span class="required">*</span></label>
                                    <input type="text" class="form-control" id="NumMobile" placeholder="Enter Mobile number">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Blood Group</label>
                                    <select class="form-control" id="ddlBloodGroup">
                                        <option value="">--Select Blood Group--</option>
                                        <option>A-</option>
                                        <option>B-</option>
                                        <option>O-</option>
                                        <option>AB-</option>

                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Religion</label>
                                    <input type="text" class="form-control" id="txtReligion" maxlength="30" placeholder="Religion">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Email ID</label>
                                    <input type="email" class="form-control" id="txtEmail" maxlength="50" placeholder="Email address">
                                    @*  <div id="emailError" class="invalid-feedback" style="display:none;">Invalid email format</div> *@
                                </div>
                            </div>
                        </div>

                    </fieldset>

                    <!-- Address Details -->
                    <fieldset class="fieldset-sub">
                        <legend class="sub-legend">Address Details</legend>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Permanent Address 1<span class="required">*</span></label>
                                    <textarea class="form-control" id="txtPermAddress1" maxlength="50" placeholder="Enter Permanent address"></textarea>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Permanent Address 2<span class="required">*</span></label>
                                    <textarea class="form-control" id="txtPermAddress2" maxlength="50" placeholder="Enter Permanent address"></textarea>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Permanent Address 3</label>
                                    <textarea class="form-control" id="txtPermAddress3" maxlength="50" placeholder="Enter Permanent address"></textarea>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Permanent City <span class="required">*</span></label>
                                    <select class="form-control" id="ddlPermCity">
                                        <option value="">--Select Permanent City--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Temporary Address 1</label>
                                    <textarea class="form-control" id="txtTemporaryAddress1" maxlength="50" placeholder="Enter Temporary address"></textarea>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Temporary Address 2</label>
                                    <textarea class="form-control" id="txtTemporaryAddress2" maxlength="50" placeholder="Enter Temporary address"></textarea>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Temporary Address 3</label>
                                    <textarea class="form-control" id="txtTemporaryAddress3" maxlength="50" placeholder="Enter Temporary address"></textarea>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Temporary City</label>
                                    <select class="form-control" id="ddlTempCity">
                                        <option value="">--Select Temporary City--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Spouse Name</label>
                                    <input type="text" class="form-control" id="txtSpouseName" maxlength="30" placeholder="Spouse name">
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <!-- Official Details -->
                    <fieldset class="fieldset-sub">
                        <legend class="sub-legend">Official Details</legend>
                        <div class="row">
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Rejoin Code</label>
                                    <input type="text" class="form-control" id="txtRejoinCode" maxlength="8" placeholder="Enter Rejoin Code">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Designation <span class="required">*</span></label>
                                    <select class="form-control" id="ddlDesignation">
                                        <option value="">--Select Designation--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Place</label>
                                    <select class="form-control" id="ddlPlace">
                                        <option value="">--Select Place--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Cader</label>
                                    <select class="form-control" id="ddlCader">
                                        <option value="">--Select Cader--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Grade</label>
                                    <select class="form-control" id="ddlGrade">
                                        <option value="">--Select Grade--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Job Responsibility</label>
                                    <select class="form-control" id="ddlJobResponsibility">
                                        <option value="">--Select Job Responsibility--</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Department<span class="required">*</span></label>
                                    <select class="form-control" id="ddlDepartment">
                                        <option value="">--Select Department--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Type <span class="required">*</span></label>
                                    <select class="form-control" id="ddlType">
                                        <option value="">--Select Type--</option>
                                        <option>Worker</option>
                                        <option>Staff</option>
                                        <option>Others</option>
                                        <option>Semi Staff</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Incentive Place</label>
                                    <select class="form-control" id="ddlIncentive">
                                        <option value="">--Select Incentive Place--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Category/WPlace <span class="required">*</span></label>
                                    <select class="form-control" id="ddlCategoryWPlace">
                                        <option value="">--Select Category/WPlace--</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Join Date <span class="required">*</span></label>
                                    <input type="date" class="form-control" id="dtJoinDate">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Resignation Date</label>
                                    <input type="date" class="form-control" id="dtResignDate">
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <!-- Experience & Benefits -->
                    <fieldset class="fieldset-sub">
                        <legend class="sub-legend">Experience & Benefits</legend>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Permanent Date</label>
                                    <input type="date" class="form-control" id="dtPermanentDate">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Experience</label>
                                    <input type="text" oninput="allowOnlyNumbers(this)" class="form-control" id="txtExperience" maxlength="5" placeholder="Enter Experience">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>PF Appl.</label>
                                    <select class="form-control" id="ddlPfAppl">
                                        <option value="">N/A</option>
                                        <option>Yes</option>
                                        <option>No</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>ESI Appl.</label>
                                    <select class="form-control" id="ddlEsiAppl">
                                        <option value="">N/A</option>
                                        <option>Yes</option>
                                        <option>No</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>VPF Appl.</label>
                                    <select class="form-control" id="ddlVPFAppl">
                                        <option value="">N/A</option>
                                        <option>Yes</option>
                                        <option>No</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>PF Dt</label>
                                    <input type="date" class="form-control" id="dtPFDate">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>ESI Dt</label>
                                    <input type="date" class="form-control" id="dtESIDate">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>VPF Dt</label>
                                    <input type="date" class="form-control" id="dtVPFDt">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>PF No</label>
                                    <input type="text" class="form-control" id="dtPFNo" maxlength="30" placeholder="Enter PF No">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>ESI No</label>
                                    <input type="text" class="form-control" id="dtESINo" maxlength="30" placeholder="Enter ESI No">
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <!-- Identity Details -->
                    <fieldset class="fieldset-sub">
                        <legend class="sub-legend">Identity & Personal Info</legend>
                        <div class="row">
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Offday</label>
                                    <select class="form-control" id="ddlOffday">
                                        <option value="">Select Offday</option>
                                        <option value="Sun">Sun</option>
                                        <option value="Mon">Mon</option>
                                        <option value="Tue">Tue</option>
                                        <option value="Wed">Wed</option>
                                        <option value="Thu">Thu</option>
                                        <option value="Fri">Fri</option>
                                        <option value="Sat">Sat</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Risk Zone</label>
                                    <select class="form-control" id="ddlRiskZone">
                                        <option value="">N/A</option>
                                        <option>Yes</option>
                                        <option>No</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>UAN</label>
                                    <input type="text" oninput="allowOnlyNumbers(this)" maxlength="12" class="form-control" id="NumUAN" placeholder="Enter UAN">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Aadhar No <span class="required">*</span></label>
                                    <input type="text" oninput="allowOnlyNumbers(this)" maxlength="12" class="form-control" id="txtAadhar" placeholder="Enter Aadhar No">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Driving Licence</label>
                                    <input type="text" maxlength="16" class="form-control" id="txtDL" placeholder="Enter Driving Licence">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Shift <span class="required">*</span></label>
                                    <select class="form-control" id="ddlShift">
                                        <option value="">Select Shift</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Referred By</label>
                                    <input type="text" class="form-control" id="txtReferred" maxlength="100" placeholder="Enter Referred By">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>PAN</label>
                                    <input type="text" maxlength="10" class="form-control" id="txtPAN" placeholder="Enter PAN">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Voter ID</label>
                                    <input type="text" maxlength="10" pattern="[A-Z]{3}[0-9]{7}" class="form-control" id="txtVoterID" placeholder="Enter Voter ID">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Card No</label>
                                    <input type="text" oninput="allowOnlyNumbers(this)" maxlength="20" class="form-control" id="NumCardNo" placeholder="Enter Card No">
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <!-- Bank Details -->
                    <fieldset class="fieldset-sub">
                        <legend class="sub-legend">Bank Details</legend>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Bank <span class="required">*</span></label>
                                    <select class="form-control" id="ddlBank">
                                        <option value="">Select Bank</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Account No <span class="required">*</span></label>
                                    <input type="text" oninput="allowOnlyNumbers(this)" maxlength="17" class="form-control" id="NumAccountNo" placeholder="Enter Account No">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Account Type</label>
                                    <input type="text" class="form-control" id="txtAccountType" maxlength="30" placeholder="Enter Account Type">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Branch <span class="required">*</span></label>
                                    <input type="text" class="form-control" id="txtBranch" maxlength="50" placeholder="Enter Branch">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>IFSC Code <span class="required">*</span></label>
                                    <input type="text" class="form-control" id="txtIFSC" maxlength="11" placeholder="Enter IFSC Code">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Bank Verified</label>
                                    <select class="form-control" id="ddlBankVerified">
                                        <option value="">Select Bank Verified</option>
                                        <option>Yes</option>
                                        <option>No</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <!-- Other Details -->
                    <fieldset class="fieldset-sub">
                        <legend class="sub-legend">Other Details</legend>
                        <div class="row">
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Leave Appl.</label>
                                    <select class="form-control" id="ddlLeaveAppl">
                                        <option value="">Select Leave Appl.</option>
                                        <option>Yes</option>
                                        <option>No</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Bonus Appl.</label>
                                    <select class="form-control" id="ddlBonusAppl">
                                        <option value="">Select Bonus Appl.</option>
                                        <option>Yes</option>
                                        <option>No</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Colony Appl.</label>
                                    <select class="form-control" id="ddlColonyApp">
                                        <option value="">Select Colony Appl.</option>
                                        <option>Yes</option>
                                        <option>No</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Holiday Apply</label>
                                    <select class="form-control" id="ddlHolidayApply">
                                        <option value="">Select Holiday Apply</option>
                                        <option>Yes</option>
                                        <option>No</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>ABRY Scheme</label>
                                    <select class="form-control" id="ddlABRY">
                                        <option value="">Select ABRY Scheme</option>
                                        <option>Yes</option>
                                        <option>No</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Room No.</label>
                                    <input type="text" maxlength="10" class="form-control" id="NumRoomNo" placeholder="Enter Room No.">
