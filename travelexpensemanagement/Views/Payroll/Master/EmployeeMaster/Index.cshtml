    function SaveMasterData(masterData) {
        checkExistOrNot(masterData.EmpId)
            .done(function (data) {
                if (data?.status && data?.exists) {
                    toastr.warning("Duplicate Employee Code");
                    return;
                }

                $.ajax({
                    url: '@Url.Action("SaveOrUpdateEmployeeMast", "EmployeeMaster")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(masterData),
                    success: function (response) {
                        if (response?.status) {
                            // toastr.success('Data saved successfully.');
                             showFlashMessageByKey('insert', 'success');
                            resetFields();
                            setTimeout(() => {
                                window.location.href = '/EmployeeMasterList/Index';
                            }, 1500);
                        } else {
                            toastr.error(response?.message || "Save failed. Please try again.");
                        }
                    },
                    error: function () {
                        toastr.error("Error occurred while saving. Please contact admin.");
                    }
                });
            })
            .fail(function () {
                toastr.error("Error while checking Employee Code.");
            });
    }

    function EditMasterData(masterData) {
        console.log(PreviousEmpCode,masterData);
        if (PreviousEmpCode != masterData.EmpId) {
            checkExistOrNot(masterData.EmpId)
                .done(function (data) {
                    if (data?.status && data?.exists) {
                        toastr.warning("Duplicate Employee ID");
                        return;
                    }
                    UpdateMasterData(masterData);
                })
                .fail(function () {
                    toastr.error("Error while checking Employee Code.");
                });
        } else {
            UpdateMasterData(masterData);
        }
    }

    function UpdateMasterData(masterData) {
        $.ajax({
            url: '/EmployeeMaster/SaveOrUpdateEmployeeMast',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(masterData),
            dataType: 'json',
            success: function (response) {
                if (response?.status) {
                    // toastr.success('Data updated successfully.');
                    showFlashMessageByKey('update', 'success');
                    resetFields();
                    setTimeout(() => {
                        window.location.href = '/EmployeeMasterList/Index';
                    }, 1500);
                } else {
                    toastr.error("Update failed: " + (response?.message || "Unknown error."));
                }
            },
            error: function (xhr, status, error) {
                toastr.error("Data not updated: " + error);
            }
        });
    }

    function GetMasterDataList(MasterTblId, readOnly) {
        $.ajax({
            url: '/EmployeeMaster/GetEmpMastDetailsById',
            type: 'GET',
            data: { id: MasterTblId },
            success: function (res) {
                if (res.status) {
                    fillFormFields(res.header);
                    fillExperienceTable(res.experience);
                    fillFamilyTable(res.family);
                    fillQualificationTable(res.qualification);
                    fillRelativesTable(res.relatives);
                    fillAttachmentTable(res.attachments);

                    if (readOnly === 'true') {
                         disableAllFields();
                         $('#DdActive').prop('disabled', true);
                         $('#chkProdIncentive, #chkMiscBenefits, #chkOtherAllow, #chkCarBenefits, #chkMobileExp, #chkRentReim, #chkTeaExp').prop('disabled', true);
                         $('.btnRemoveExperience, .btnRemoveQualification, .btnRemoveAttachment, .btnRemoveFamily, .btnRemoveRelative')
                         .prop('disabled', true);
                         $('#btn-save, #cancelBtn').hide();
                    } else {
                        enableAllFields();
                        $('#DdActive').prop('disabled', false);
                        $('#chkProdIncentive, #chkMiscBenefits, #chkOtherAllow, #chkCarBenefits, #chkMobileExp, #chkRentReim, #chkTeaExp').prop('disabled', false);
                         $('.btnRemoveExperience, .btnRemoveQualification, .btnRemoveAttachment, .btnRemoveFamily, .btnRemoveRelative')
                         .prop('disabled', false);
                        $('#btn-save, #cancelBtn').show();
                    }

                }
            },
            error: function () {
                toastr.error('Failed to load data.');
            }
        });
    }

    function resetFields() {
      empdetailSequence.forEach(id => {
        const $el = $('#' + id);
        if ($el.is('select')) {
          $el.prop('selectedIndex', 0);
        } else if ($el.is(':checkbox') || $el.is(':radio')) {
          $el.prop('checked', false);
        } else {
          $el.val('');
        }
      });
    }

    function enableAllFields() {
      allFieldIds.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.disabled = false;
      });
    }

    function disableAllFields() {
      allFieldIds.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.disabled = true;
      });
    }

