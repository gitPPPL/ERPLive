<div class="modal fade" id="B2BpopupModal" tabindex="-1" aria-labelledby="popupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle"></h5>
                <i class="fa fa-times modal-icon" data-bs-dismiss="modal" style="cursor: pointer;" aria-label="Close"></i>
            </div>
            <!-- Modal Body -->
            <div class="modal-body">
                <img src="" alt="Image description" class="img-fluid" id="modalImage" />
            </div>
        </div>
    </div>
</div>
<!-- JavaScript -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var tdsButtons = document.querySelectorAll('.btn-tds');

        tdsButtons.forEach(function(button) {
            button.addEventListener('click', function() {
                var imageSrc = button.getAttribute('data-image');
                var title = button.getAttribute('data-title');

                document.getElementById('modalImage').src = imageSrc;
                document.getElementById('modalTitle').textContent = title;
            });
        });
    });
</script>
