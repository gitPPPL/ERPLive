@{
    ViewBag.Title = "rPET";
    Layout = "~/Views/Shared/ProductPortfolioLayout.cshtml";
}
<style>
 
    .product-tabs {
        border-bottom: none;
        gap: 12px;
    }

        .product-tabs .nav-link {
            border-radius: 10px;
            padding: 4px 45px;
            min-width: 140px;
            background: #e7e7e7;
            color: #1c1a1a;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            font-weight: 600;
            transition: all 0.3s ease;
            border: 1px solid #747474;
        }

            .product-tabs .nav-link i {
                font-size: 20px;
                color: #3c914b;
            }

            .product-tabs .nav-link span {
                font-size: 18px;
            }

            .product-tabs .nav-link:hover {
                background: #e7e7e7;
                border: none;
                box-shadow: 0 6px 10px rgba(0, 0, 0, 0.20);
            }

            .product-tabs .nav-link.active {
                background: linear-gradient(135deg, #2f7d3f, #4caf63);
                color: #fff;
                box-shadow: 0 8px 20px rgba(60, 145, 75, 0.35);
                border: 1px solid #2f7d3f;
            }

                .product-tabs .nav-link.active i {
                    color: #fff;
                }

    /* Title Container */
    .title-container {
        display: flex;
        align-items: center;
        justify-content: flex-start;
    }

    .watermark-container {
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }

    .watermark-logo {
        width: 40px; /* Adjust the logo width */
        height: auto;
        opacity: 0.8; /* Optional: Adjust opacity for watermark effect */
        pointer-events: none;
    }
    /* Flex container for title and watermark */
    .content-inner {
        display: flex;
        justify-content: space-between; /* Space between title and watermark */
        align-items: center; /* Vertically center the content */
        width: 100%;
        margin-bottom: 15px; /* Optional: Adjust space between content and button */
    }
</style>
<section class="container-fluid">
    <!-- Heading -->
    <div class="row">
        <div class="section-heading">
            <h1 class="main-heading">rPET</h1>
            <span class="heading-line"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <ul class="nav nav-tabs justify-content-center product-tabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#granules">
                        <i class="fa-solid fa-cubes"></i>
                        <span>rPET Granules</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#flakes">
                        <i class="fa-solid fa-layer-group"></i>
                        <span>rPET Flakes</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#masterbatches">
                        <i class="fa-solid fa-industry"></i>
                        <span>rMaster Batches</span>
                    </button>
                </li>

            </ul>
        </div>
    </div>


