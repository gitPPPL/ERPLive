<style>

    .product-tabs {
        border-bottom: none;
        gap: 12px;
    }

        .product-tabs .nav-link {
            border-radius: 10px;
            padding: 4px 45px;
            min-width: 140px;
            background: #e7e7e7;
            color: #1c1a1a;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            font-weight: 600;
            transition: all 0.3s ease;
            border: 1px solid #747474;
        }

            .product-tabs .nav-link i {
                font-size: 20px;
                color: #3c914b;
            }

            .product-tabs .nav-link span {
                font-size: 18px;
            }

            .product-tabs .nav-link:hover {
                background: #e7e7e7;
                border: none;
                box-shadow: 0 6px 10px rgba(0, 0, 0, 0.20);
            }

            .product-tabs .nav-link.active {
                background: linear-gradient(135deg, #2f7d3f, #4caf63);
                color: #fff;
                box-shadow: 0 8px 20px rgba(60, 145, 75, 0.35);
                border: 1px solid #2f7d3f;
            }

                .product-tabs .nav-link.active i {
                    color: #fff;
                }

    .title-container {
        position: relative;
        display: inline-block;
    }

    .watermark-logo {
        position: relative;
        top: -8px;
        left: 0;
        height: 100%;
        opacity: 1;
        z-index: 1;
        pointer-events: none;
        width: 40px;
        margin: 10px 2px;
    }
</style>



