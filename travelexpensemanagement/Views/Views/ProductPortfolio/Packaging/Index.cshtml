    <div class="row">
        <div class="section-heading">
            <h1 class="main-heading">Packaging</h1>
            <span class="heading-line"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <ul class="nav nav-tabs justify-content-center product-tabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#pphdpepackaging">
                        <i class="fa-solid fa-boxes"></i>
                        <span>PP & HDPE Bags for Packaging</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#pphdpefabric">
                        <i class="fa-solid fa-square"></i>
