@{
    ViewBag.Title = "Bin Master List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<fieldset>
    <legend class="legend-field">Bin Master List</legend>
    <div class="row">
        <div class="col-lg-4">
            <div class="input-group">
                <input type="text" id="searchBox" class="form-control" placeholder="Search Module..." aria-label="Search term">
            </div>
        </div>
        <div class="col-lg-8 btn-align">
            <button id="btnSave" onclick="window.location.href='@Url.Action("Index", "BinMaster")'" type="submit" class="btn btn-primary">
                <i class="fa fa-plus"></i>Add Bin
            </button>
            <button class="btn btn-print">
                <i class="fa fa-print"></i> Print
            </button>
            <button class="btn btn-export">
                <i class="fas fa-file-export"></i> Export
            </button>
            <button class="btn btn-mail">
                <i class="fa fa-envelope"></i> Mail
            </button>
            <button class="btn btn-send">
                <i class="fa fa-paper-plane"></i> Approval Send
            </button>
            <button class="btn btn-approved">
                <i class="fa fa-check"></i> Approved
            </button>
        </div>
    </div>
    <div class="card">
        <div class="table-responsive">
            <table id="tblBinMaster" class="table-width">
                <thead class="table-head">
                    <tr>
                        <th style="display:none;">Code</th>
                        <th>Name</th>
                        <th>Short Name</th>
                        <th>Status </th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
    <div class="pagination-wrapper">
        <ul class="pagination" id="tablePagination"></ul>
    </div>
</fieldset>


<script>
    let currentPage = 1;
    let pageSize = 10;
    let moduleMap = {};
    let parentModuleMap = {};

    // When the page is ready, initialize dropdowns and load menus
    $(document).ready(function () {

        loadAllMenus();
    });
    // Load Menu Data ------------------------------------------------------------
    function loadAllMenus() {
        const searchTerm = $('#searchBox').val();

        $.ajax({
            url: '/BinMasterList/GetCategaryList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                if (!res.success) {
                    toastr.error("Failed to load data.");
                    return;
                }

                const BinMastList = res.lists;
                const totalCount = res.totalCount;

                let tbody = $('#tblBinMaster tbody');
                tbody.empty();

                if (BinMastList.length === 0) {
                    tbody.append('<tr><td colspan="8" class="text-center text-muted">No list found.</td></tr>');
                } else {
                    $.each(BinMastList, function (index, item) {
                        $('#tblBinMaster tbody').append(`
                          <tr>
                                <td>${item.name}</td>
                                <td>${item.shortname}</td>
                                <td>${item.active === 1 ? 'Yes' : 'No'}</td>
                                 <!-- Action Buttons -->
                                 <td>
                                     <!-- Edit Button -->
                                     <button class="btn btn-sm btn-light">
                                         <i class="fas fa-edit" style="cursor: pointer;" title="Edit" onclick="AddOrEditFunction('${item.code}')"></i>
                                     </button>
                                     <!-- View Button -->
                                     <button class="btn btn-sm btn-light">
                                         <i class="fas fa-eye" style="cursor: pointer;" title="View Detail" onclick="viewMenuDetails('${item.code}')"></i>
                                     </button>
                                     <!-- Delete Button -->
                                     <button class="btn btn-sm btn-light btn-delete" onclick="Delete('${item.code}')">
                                         <i class="fas fa-trash text-danger" title="Delete"></i>
                                     </button>
                                 </td>
                          </tr>

                        `);
                    });
                }
                renderPagination(totalCount, pageSize, currentPage); 
            },
            error: function () {
                toastr.error("An error occurred while fetching data.");
            }
        });
    }
    // Pagination Function ------------------------------------------------------
    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const paginationContainer = $('#tablePagination');
        // Clear previous pagination
        paginationContainer.empty();
        if (total === 0) {
            paginationContainer.html('<span class="text-muted">No records</span>');
            return;
        }
        if (totalPages <= 1) return; // No pagination needed
        let paginationHtml = '';
        // First and Prev
        if (currentPage > 1) {
            paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        if (currentPage <= 3) endPage = Math.min(5, totalPages);
        if (currentPage >= totalPages - 2) startPage = Math.max(totalPages - 4, 1);

        for (let i = startPage; i <= endPage; i++) {
            paginationHtml += `
                <button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1"
                        onclick="goToPage(${i})">${i}</button>`;
        }
        // Next and Last
        if (currentPage < totalPages) {
            paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        paginationContainer.html(paginationHtml);
    }

    // Navigate to selected page
    function goToPage(page) {
        currentPage = page;
        loadAllMenus();
    }

    // Search on keyup event
    $('#searchBox').on('keyup', function () {
        currentPage = 1;
        loadAllMenus();
    });

    // Edit or Add Function
    function AddOrEditFunction(code) {

        window.location.href = '/BinMaster/Index?id=' + encodeURIComponent(code);
    }

    // View Function
    function viewMenuDetails(code) {

        window.location.href = '/BinMaster/Index?id=' + encodeURIComponent(code);
    }

    // Delete Function
    function Delete(code) {
        if (!confirm('Are you sure you want to delete this Tolerance?')) return;
        $.ajax({
            url: '/BinMasterList/Delete',
            type: 'POST',
            data: { code: code },
            success: function (res) {
                if (res.success) {
                    toastr.success('Deleted successfully.');
                    loadAllMenus();
                } else {
                    toastr.error(res.message || 'Failed to delete.');
                }
            },
            error: function () {
                toastr.error('Error deleting tolerance.');
            }
        });
    }
</script>
