@{
	ViewBag.Title = "Machine Main Group Master List";
	Layout = "~/Views/Shared/_Layout.cshtml";
    var currentMenu = ViewBag.CurrentMenu as string;
}

<fieldset>
	<legend class="legend-field">Machine Main Group Master List</legend>
	<div class="row">
		<div class="col-lg-4">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control border-0" placeholder="Search Module..." aria-label="Search term">
			</div>
		</div>



		<div class="col-lg-8 btn-align">
			<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "MachineMainGroupMaster")'" type="submit" class="btn btn-primary">
				<i class="fa fa-plus"></i>Add Machine Main
			</button>
			<button class="btn btn-print">
				<i class="fa fa-print"></i> Print
			</button>
			<button class="btn btn-export"> 
				<i class="fas fa-file-export"></i> Export
			</button>
			<button class="btn btn-mail">
				<i class="fa fa-envelope"></i> Mail
			</button>
			<button class="btn btn-send"> 
				<i class="fa fa-paper-plane"></i> Approval Send
			</button>
			<button class="btn btn-approved">
				<i class="fa fa-check"></i> Approved
			</button>
		</div>



	</div>
	<div class="card shadow-sm border-0 mt-1">
		<div class="table-responsive">
			<table id="tblMachineMain" class="table-width">
				<thead class="table-head">
					<tr>
						<th>Code</th>
						<th>Name</th>
						<th>Short Name</th>
                        <th>Status</th>
                        <th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>

		<!-- Pagination container -->
		<div class="row p-3">
			<div class="col-md-12 d-flex justify-content-center" id="tablePagination"></div>
		</div>
	</div>
</fieldset>
<script>

    let currentPage = 1;
    let pageSize = 10;

    $(document).ready(function () {
        loadAllMachineMainGroups();
    });

    function loadAllMachineMainGroups() {
        const searchTerm = $('#searchBox').val();

        $.ajax({
            url: '/MachineMainGroupMasterList/GetMachineMainGroups', // 🔁 Update with your actual controller route
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                console.log(res);
                const lists = res.lists;
                const totalCount = res.totalCount;

                let tbody = $('#tblMachineMain tbody');
                tbody.empty();

                if (!lists || lists.length === 0) {
                    tbody.append('<tr><td colspan="4" class="text-center text-muted">No records found.</td></tr>');
                    renderPagination(0, pageSize, currentPage);
                    return;
                }

                $.each(lists, function (index, item) {
                    tbody.append(`
                        <tr>
                            <td>${item.code}</td>
                            <td>${item.name || ''}</td>
                            <td>${item.shortname || ''}</td>
                            <td>${item.active === 1 ? 'Active' : 'Inactive'}</td>
                            <td>
                                <i class="fas fa-edit text-primary" style="cursor:pointer;" title="Edit" onclick="editMachineGroup(${item.code})"></i>
                                <i class="fas fa-eye text-primary" style="cursor:pointer;" title="View" onclick="viewMachineGroup(${item.code})"></i>
                                <i class="fas fa-trash text-danger ms-2" style="cursor:pointer;" title="Delete" onclick="deleteMachineGroup(${item.code})"></i>
                            </td>
                        </tr>
                    `);
                });

                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                alert('Error loading data: ' + xhr.responseText);
            }
        });
    }

    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const paginationContainer = $('#tablePagination');
        paginationContainer.empty();

        if (totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        if (currentPage <= 3) endPage = Math.min(5, totalPages);
        if (currentPage >= totalPages - 2) startPage = Math.max(totalPages - 4, 1);

        for (let i = startPage; i <= endPage; i++) {
            html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        paginationContainer.html(html);
    }

    function goToPage(page) {
        currentPage = page;
        loadAllMachineMainGroups();
    }

    $('#searchBox').on('keyup', function () {
        currentPage = 1;
        loadAllMachineMainGroups();
    });



    function editMachineGroup(rowId) {
        window.location.href = '/MachineMainGroupMaster/Index?id=' + encodeURIComponent(rowId);
    }
    function viewMachineGroup(rowId) {
        window.location.href = '/MachineMainGroupMaster/Index?id=' + encodeURIComponent(rowId) + '&readOnly=true';
    }

    function deleteMachineGroup(code) {
        Swal.fire({
            title: 'Are you sure?',
            text: "This action will permanently delete the Machine group.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/MachineMainGroupMaster/DeleteMachinMainGrpByCode',
                    type: 'POST',
                    data: { code: code },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Deleted!', response.message, 'success').then(() => {
                                loadAllMachineMainGroups();
                            });
                        } else {
                            Swal.fire('Failed', response.message, 'warning');
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Delete error:", status, error);
                        Swal.fire('Error!', 'An error occurred while deleting record.', 'error');
                    }
                });
            }
        });
    }

</script>