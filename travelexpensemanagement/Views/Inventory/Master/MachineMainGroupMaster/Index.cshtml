@{
	ViewBag.Title = "Machine Main Group Master";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<fieldset>
	<legend class="legend-field">Machine Main Group Master</legend>
	<div class="row">
		<div class="offset-md-8 col-md-4 btn-right">
			<button id="btnSave"
					onclick="window.location.href='@Url.Action("Index", "MachineMainGroupMasterList")'" type="button" class="btn btn-primary">
				<i class="fa fa-list"></i>Back to list
			</button>
		</div>
	</div> 
	<form id="MachineMainGroupform">
		<input type="hidden" class="form-control" id="CODE" name="CODE">
		<div class="row">
			<div class="col-md-3"> 
				<div class="form-group">
					<label for="TxtMachineGroup" class="form-label">Machine Group</label>
					<input type="text" class="form-control" id="TxtMachineGroup" name="TxtMachineGroup" placeholder="Enter Machine Group">
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<label for="TxtShortName" class="form-label">Short Name</label>
					<input type="text" class="form-control" id="TxtShortName" name="ShortName" placeholder="Select Short Name">
				</div>
			</div>
		</div>
		<div class="row">
			<div class="offset-md-7 col-md-2">
				<div class="active-toggle">
					<label class="toggle-switch">
						<input type="checkbox" id="ACTIVE" name="ACTIVE" checked>
						<span class="slider"></span>
					</label>
					<span class="ms-2" id="statusText">Active</span>
				</div>
			</div>
			<div class="col-md-3 btn-align">
				<button type="submit" class="btn btn-primary">Submit</button>
				<button type="button" id="cancelBtn" class="btn btn-danger">Cancel</button>
			</div>
		</div>

	</form>

</fieldset>

<script>
	$(document).ready(function () {
		const urlParams = new URLSearchParams(location.search);
		const rowId = parseInt(urlParams.get('id'));
		const isReadOnly = urlParams.get('readOnly') === 'true';

		if (!isNaN(rowId) && rowId > 0) {
			LoadMachineMainGroupById(rowId);
			if (isReadOnly) {
				setMachineFormReadOnly();
			}
		}

		$('#cancelBtn').on('click', function () {
			window.location.href = '/MachineMainGroupList/Index';
		});
	});

	function LoadMachineMainGroupById(code) {
		$.ajax({
			url: '/MachineMainGroupMasterList/GetMachineGroupByCode',
			type: 'GET',
			data: { code: code },
			success: function (response) {
				var data = response.data;

				if (!data) {
					toastr.warning("No data found.");
					return;
				}

				// Set values for form fields
				$('#CODE').val(data.code);
				$('#TxtMachineGroup').val(data.name);
				$('#TxtShortName').val(data.shortname);
				$('#ACTIVE').prop('checked', data.active === 1 || data.active === true);
				$('#statusText').text(data.active ? 'Active' : 'Inactive');
			},
			error: function (xhr, status, error) {
				console.error("Error loading Machine Main Group by ID:", status, error);
				toastr.error('Error: ' + xhr.responseText);
			}
		});
	}



	$('#MachineMainGroupform').on('submit', function (e) {
		e.preventDefault();

		const code = parseInt($('#CODE').val()) || 0;
		const machineData = {
			CODE: code,
			NAME: $('#TxtMachineGroup').val().trim(),
			ShortName: $('#TxtShortName').val().trim(),
			ACTIVE: $('#ACTIVE').is(':checked') ? 1 : 0,
			UUSER: 1, // Replace with actual user ID dynamically
			UDATE: new Date().toISOString(),
			EUSER: 1,
			EDATE: new Date().toISOString(),
			AED: code > 0 ? 'E' : 'A',
			WSID: "WEB",
			LIP: "127.0.0.1",
			LID: "WEB",
			ACTION: code > 0 ? "UPDATE" : "INSERT"
		};

		// Validation
		if (!machineData.NAME) {
			toastr.warning("Please enter Machine Group.");
			$('#TxtMachineGroup').focus();
			return;
		}

		if (!machineData.ShortName) {
			toastr.warning("Please enter Short Name.");
			$('#TxtShortName').focus();
			return;
		}

		$.ajax({
			url: '/MachineMainGroupMaster/SaveMachineGRP',
			type: 'POST',
			contentType: 'application/json',
			data: JSON.stringify(machineData),
			success: function (response) {
				if (response.success) {
					toastr.success("Machine Group saved successfully!");
					$('#MachineMainGroupform')[0].reset();
					setTimeout(() => {
						window.location.href = '/MachineMainGroupMasterList/Index';
					}, 1000);
				} else {
					const message = response.message || "Something went wrong while saving.";
					toastr.warning(message);
				}
			},
			error: function (xhr) {
				const errorMsg = xhr.responseJSON?.message || xhr.responseText || "An error occurred.";
				toastr.error("Error: " + errorMsg);
			}
		});
	});
	

	function setMachineFormReadOnly() {
		const form = $('#MachineMainGroupform');
		form.find('input, select, textarea, button').prop('disabled', true);
	}

</script>



@* Cancel Button Popup *@
<script>
	document.getElementById("cancelBtn").addEventListener("click", function () {
	  Swal.fire({
		title: 'Are you sure?',
		text: "Do you want to cancel all the changes?",
		icon: 'warning',
		showCancelButton: true,
		confirmButtonText: 'Yes, cancel it!',
		cancelButtonText: 'No, keep it',
		reverseButtons: true
	  }).then((result) => {
		if (result.isConfirmed) {
		  Swal.fire(
			'Cancelled!',
			'Your action has been cancelled.',
			'success'
		  )
		} else if (result.dismiss === Swal.DismissReason.cancel) {
		  Swal.fire(
			'Resumed',
			'Your action is still in progress.',
			'info'
		  )
		}
	  });
	});
</script>

@* Cancel button end *@

