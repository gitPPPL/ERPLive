<script>

	let currentPage = 1;
	let pageSize = 10;

	$(document).ready(function () {
		loadAllMachineSubGroups();
	});

	function loadAllMachineSubGroups() {
		const searchTerm = $('#tableSearch').val();

		$.ajax({
			url: '/MachineSubGroupMasterList/GetAllMachingSubGrp',
			type: 'GET',
			dataType: 'json',
			data: {
				searchTerm: searchTerm,
				pageNumber: currentPage,
				pageSize: pageSize
			},
			success: function (res) {
				const list = res.list;
				const totalCount = res.totalCount;
				let tbody = $('#tblMachineSubGroup tbody');
				tbody.empty();

				if (!list || list.length === 0) {
					tbody.append('<tr><td colspan="9" class="text-center text-muted">No records found.</td></tr>');
					renderPagination(0, pageSize, currentPage);
					return;
				}

				$.each(list, function (index, item) {
					tbody.append(`
						<tr>
							<td style="display:none;">${item.code}</td>
							<td>${item.name || ''}</td>
							<td>${item.shortname || ''}</td>
							<td>${item.active === 1
									? '<span class="erppagestatus-badge erppagestatus-active"><i class="fa fa-check-circle"></i>&nbsp;Active</span>'
									: '<span class="erppagestatus-badge erppagestatus-inactive"><i class="fa fa-times-circle"></i>&nbsp;Inactive</span>'
								}</td>

							<td class="action-col">
							  <div class="action-wrap">
								 <button class="act-btn edit btn-edit" title="Edit Row" style="cursor:pointer;" onclick="editMachineSubGroup(${item.code})"><i class="fa fa-edit"></i></button>
								 <button class="act-btn view btn-view" title="View Row" style="cursor:pointer;" onclick="viewMachineSubGroup(${item.code})"><i class="fa fa-eye"></i></button>
								 <button class="act-btn delete btn-delete" title="Delete Row" style="cursor:pointer;" onclick="deleteMachineSubGroup(${item.code})"><i class="fa fa-trash"></i></button>
							  </div>
						    </td>
						</tr>
					`);
				});

				renderPagination(totalCount, pageSize, currentPage);
			},
			error: function (xhr) {
				toastr.error('Error loading data: ' + xhr.responseText);
			}
		});
	}

	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const paginationContainer = $('#tablePagination');
		paginationContainer.empty();

		if (totalPages <= 1) return;

		let html = '';

		if (currentPage > 1) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		let startPage = Math.max(1, currentPage - 2);
		let endPage = Math.min(totalPages, currentPage + 2);

		for (let i = startPage; i <= endPage; i++) {
			html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
		}

		if (currentPage < totalPages) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		paginationContainer.html(html);
	}

	function goToPage(page) {
		currentPage = page;
		loadAllMachineSubGroups();
	}

	$('#tableSearch').on('keyup', function () {
		currentPage = 1;
		loadAllMachineSubGroups();
	});


	function editMachineSubGroup(rowId) {
		window.location.href = '/MachineSubGroupMaster/Index?id=' + encodeURIComponent(rowId);
	}
	function viewMachineSubGroup(rowId) {
		window.location.href = '/MachineSubGroupMaster/Index?id=' + encodeURIComponent(rowId) + '&readOnly=true';
	}


	function deleteMachineSubGroup(code) {
		Swal.fire({
			title: 'Are you sure?',
			text: "This action will permanently delete the sub group.",
			icon: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#d33',
			cancelButtonColor: '#3085d6',
			confirmButtonText: 'Yes, delete it!',
			cancelButtonText: 'Cancel'
		}).then((result) => {
			if (result.isConfirmed) {
				$.ajax({
					url: '/MachineSubGroupMaster/DeleteMachineSubGroupByCode',
					type: 'POST',
					data: { code: code },
					success: function (response) {
						if (response.success) {
							Swal.fire('Deleted!', response.message, 'success').then(() => {
								loadAllMachineSubGroups();
							});
						} else {
							Swal.fire('Failed', response.message, 'warning');
						}
					},
					error: function (xhr) {
						Swal.fire('Error!', 'An error occurred while deleting.', 'error');
					}
				});
			}
		});
	}


</script>