            </fieldset> *@

           
        </div>

        <div class="erppage-actions">
            <button id="btn_save" type="submit" class="erppage-btn erppage-btn-save">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>
        </div>

    </div>
</div>
<script src="~/js/erpjs/inventory/transaction/toolkitissueentry/toolkitissueentry.js"></script>