@{
    ViewBag.Title = "Delivery Challan Store";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa-solid fa-truck"></i>
        </div>
        <div class="erppage-header-title">Delivery Challan Store</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "DeliveryChallanStoreList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="DeliveryChallanStoreform">
    <input type="hidden" class="form-control" id="CODE" name="CODE">
    <div class="erppage-container">
        <div class="erppage-fieldset">
            <div class="erppage-grid8">
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Type</label>
                    <select class="erppage-input erppage-select" id="ddlDocType">
                        <option value="">Select Doc Type</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc No</label>
                    <input type="number" class="erppage-input" id="NumDocno" placeholder="Enter Doc No">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-input" id="DtDocDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">TranType</label>
                    <select class="erppage-input erppage-select" id="ddlTranType">
                        <option value="">Select Tran Type</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Reference Bill Type</label>
                    <select class="erppage-input erppage-select" id="ddlRefBillType">
                        <option value="">Select Ref Bill Type</option>
                    </select>
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Reference Bill No</label>
                    <div class="erppage-inputgroup">
                        <select class="erppage-input erppage-select" id="ddlRefBillNo">
                            <option value="">Select Ref Bill Type</option>
                        </select>
                        <button type="button" class="erppage-btn erppage-btn-common-active-disabled" id="btn__load"><i class="fa fa-download"></i> Load</button>
                    </div>
                </div>
                <div class="erppage-divfield erppage-datefield">
                    <label class="erppage-label">Ref. Date</label>
                    <div class="erppage-datebox">
                        <input type="date" class="erppage-input erppage-dateinput" id="DtRefDate">
                        <label class="erppage-checkbox-inside">
                            <input type="checkbox" class="erppage-checkbox-input" id="chkRefDate">
                        </label>
                    </div>
                </div>
            </div>
            <div class="erppagesrow">
                <div class="erppagescol-6">
                    <fieldset class="erppagefieldset">
                        <legend class="erppagefieldset-legend">Bill Details</legend>
                        <div class="erppage-grid3">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Bill To</label>
                                <select class="erppage-input" id="ddlbillto">
                                    <option value="">Select Bill To</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Address L1</label>
                                <div class="erppage-inputgroup">
                                    <select class="erppage-input erppage-width-70" id="ddladdl1">
                                        <option value="">Select Address L1</option>
                                    </select>
                                    <select class="erppage-input erppage-width-30" id="ddladdl1a">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Address L2</label>
                                <select class="erppage-input" id="ddladdl2">
                                    <option value="">Select Address L2</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid3">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Address L3</label>
                                <select class="erppage-input" id="ddladdl3">
                                    <option value="">Select Address L3</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Bill City</label>
                                <select class="erppage-input" id="ddlBillCity">
                                    <option value="">Select Bill City</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Bill GST</label>
                                <input type="number" class="erppage-input" id="NumBillGST" />
                            </div>
                        </div>
                        <div class="erppage-grid3">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Pincode</label>
                                <input type="number" class="erppage-input" id="NumPincode" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">POS/City</label>
                                <select class="erppage-input" id="ddlPOSCity">
                                    <option value="">Select POS/City</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Desp. From Party</label>
                                <select class="erppage-input" id="ddldespparty">
                                    <option value="">Select Desp. From Party</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid3">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Desp. From GST</label>
                                <select class="erppage-input" id="ddldespgst">
                                    <option value="">Select Desp. From GST</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Desp. From Loc.</label>
                                <select class="erppage-input" id="ddldesploc">
                                    <option value="">Select Desp. From Loc.</option>
                                </select>
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="erppagescol-6">
                    <fieldset class="erppagefieldset">
                        <legend class="erppagefieldset-legend">Ship Details</legend>
                        <div class="erppage-grid3">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Ship To</label>
                                <select class="erppage-input" id="ddlshiptoSD">
                                    <option value="">Select Ship To</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Address L1</label>
                                <div class="erppage-inputgroup">
                                    <select class="erppage-input erppage-width-70" id="ddladdl1SD">
                                        <option value="">Select Address L1</option>
                                    </select>
                                    <select class="erppage-input erppage-width-30" id="ddladdl1aSD">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Address L2</label>
                                <select class="erppage-input" id="ddladdl2SD">
                                    <option value="">Select Address L2</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid3">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Address L3</label>
                                <select class="erppage-input" id="ddladdl3SD">
                                    <option value="">Select Address L3</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Bill City</label>
                                <select class="erppage-input" id="ddlBillCitySD">
                                    <option value="">Select Bill City</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Bill GST</label>
                                <input type="number" class="erppage-input" id="NumBillGSTSD" />
                            </div>
                        </div>
                        <div class="erppage-grid3">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Pincode</label>
                                <input type="number" class="erppage-input" id="NumPincodeSD" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Mov. Type</label>
                                <select class="erppage-input" id="ddlMovtype">
                                    <option value="">Select Mov. Type</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Desp. From Party</label>
                                <select class="erppage-input" id="ddldesppartySD">
                                    <option value="">Select Desp. From Party</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid3">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Desp. From GST</label>
                                <select class="erppage-input" id="ddldespgstSD">
                                    <option value="">Select Desp. From GST</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Desp. From Loc.</label>
                                <select class="erppage-input" id="ddldesplocSD">
                                    <option value="">Select Desp. From Loc.</option>
                                </select>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Other Details</legend>
                <div class="erppage-grid8">
                    <div class="erppage-divfield erppage-col-span-2">
                        <label class="erppage-label">WB Doc No</label>
                        <div class="erppage-inputgroup">
                            <input type="number" class="erppage-input" id="NumWBDocNo">
                            <button type="button" class="erppage-btn erppage-btn-common-active-disabled" id="btn__loadqty"><i class="fa fa-download"></i> Load Qty</button>
                        </div>
                    </div>
                    <div class="erppage-divfield erppage-datefield">
                        <label class="erppage-label">Bill Date</label>
                        <div class="erppage-datebox">
                            <input type="date" class="erppage-input erppage-dateinput" id="DtBillDate">
                            <label class="erppage-checkbox-inside">
                                <input type="checkbox" class="erppage-checkbox-input" id="chkBillDate">
                            </label>
                        </div>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Nature of Work</label>
                        <select class="erppage-input erppage-select" id="ddlNatureWork">
                            <option value="">Select Nature of Work</option>
                        </select>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Other Work</label>
                        <input type="text" class="erppage-input" id="TxtOtherWork" placeholder="Enter Other Work">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">EWaybill No.</label>
                        <input type="text" class="erppage-input" id="TxtEwaybillno" placeholder="Enter EWaybill No.">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Responsible Person</label>
                        <select class="erppage-input erppage-select" id="ddlResponsiblePerson">
                            <option value="">Select Responsible Person</option>
                        </select>
                    </div>
                    <div class="erppage-divfield erppage-datefield">
                        <label class="erppage-label">Expected Return On</label>
                        <div class="erppage-datebox">
                            <input type="date" class="erppage-input erppage-dateinput" id="DtExpectedReturnDate">
                            <label class="erppage-checkbox-inside">
                                <input type="checkbox" class="erppage-checkbox-input" id="chkExpectedReturnDate">
                            </label>
                        </div>
                    </div>
                </div>
                <div class="erppage-grid8">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Distance(KM)</label>
                        <input type="number" class="erppage-input" id="NumDistance">
                    </div>
                    <div class="erppage-divfield erppage-col-span-2">
                        <label class="erppage-label">Reason</label>
                        <textarea type="text" class="erppage-textarea" style="height:40px;" id="txtreason" placeholder="Enter Reason"></textarea>
                    </div>
                    <div class="erppage-divfield erppage-col-span-2">
                        <label class="erppage-label">Dispatch From</label>
                        <textarea type="text" class="erppage-textarea" style="height:40px;" id="txtdispatchfrom" placeholder="Enter Dispatch From"></textarea>
                    </div>
                </div>
            </fieldset>
            
            <div class="erppage-fieldset">
                <div class="erppage-container">
                    <div class="erppage-tabs">
                        <button class="erppage-tab active" data-tab="itemrecord">Item Record</button>
                        <button class="erppage-tab" data-tab="itemtotal">Item Total</button>
                        <button class="erppage-tab" data-tab="logisticdetails">Logistic Details</button>
                    </div>
                    <!-- Item Record -->
                    <div class="erppage-tab-content active" id="itemrecord">
                        <div class="erppagelist-container">
                            <div class="excel-wrapper fixed-grid-wrapper">
                                <table id="tblItemrecord" class="excel-table fixed-grid-table table-width resizable-table">
                                    <colgroup>
                                        <col class="hidden-col">
                                        <col style="width:180px;">
                                        <col style="width:100px;">
                                        <col style="width:80px;">
                                        <col style="width:70px;">
                                        <col style="width:150px;">
                                        <col style="width:100px;">
                                        <col style="width:100px;">
                                        <col style="width:120px;">
                                        <col style="width:110px;">
                                        <col style="width:90px;">
                                        <col style="width:120px;">
                                        <col style="width:90px;">
                                        <col style="width:120px;">
                                        <col style="width:90px;">
                                        <col style="width:120px;">
                                        <col style="width:90px;">
                                        <col style="width:120px;">
                                        <col style="width:90px;">
                                        <col style="width:120px;">
                                        <col style="width:110px;">
                                        <col style="width:110px;">
                                        <col class="action-col" style="width:80px;">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th class="hidden-col">Code</th>
                                            <th>Item Desc</th>
                                            <th>Hsncode</th>
                                            <th>Uom</th>
                                            <th>Nos</th>
                                            <th>Received Quantity</th>
                                            <th>Inv. Qty</th>
                                            <th>Rate</th>
                                            <th>Amount</th>
                                            <th>Tax Type</th>
                                            <th>Pack %</th>
                                            <th>Pack Amount</th>
                                            <th>Disc %</th>
                                            <th>Dis. Amount</th>
                                            <th>Cgst%</th>
                                            <th>Cgst Amount</th>
                                            <th>Sgst%</th>
                                            <th>Sgst Amount</th>
                                            <th>Igst%</th>
                                            <th>Igst Amount</th>
                                            <th>Ref. Type</th>
                                            <th>Ref. No</th>
                                            <th class="action-col">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                            <div class="erppagelist-pagination">
                                <div class="pagination-left">
                                    <select id="pageSizeSelect">
                                        <option value="5">5</option>
                                        <option value="10" selected>10</option>
                                        <option value="20">20</option>
                                        <option value="50">50</option>
                                    </select>
                                </div>
                                <div class="pagination-center">
                                    <button class="page-nav" id="prevBtn">‹</button>
                                    <div id="tablePagination" class="page-numbers"></div>
                                    <button class="page-nav" id="nextBtn">›</button>
                                </div>
                                <div class="pagination-right" id="pageInfoText">
                                    Results: 0 - 0 of 0
                                </div>
                            </div>
                        </div>
                        
                       
                    </div>
                    <!-- Item Total -->
                    <div class="erppage-tab-content" id="itemtotal">
                       <div class="erppage-grid8">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Total Nos</label>
                                <input type="number" class="erppage-input" id="NumTotalnos" placeholder="Enter Total Nos">
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Received Quantity</label>
                                <input type="number" class="erppage-input" id="NumReceivedQty" placeholder="Enter Received Qty">
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Bill Qty</label>
                                <input type="number" class="erppage-input" id="NumBillQty" placeholder="Enter Bill Qty">
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Amount</label>
                                <input type="number" class="erppage-input" id="NumAmount" placeholder="Enter Amount">
                            </div>
                       </div>
                        <div class="erppage-grid8">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Discount</label>
                                <div class="erppage-inputgroup">
                                    <input type="number" class="erppage-input erppage-width-30" id="NumDiscount1">
                                    <input type="number" class="erppage-input erppage-width-70" id="NumDiscount2" placeholder="0.00">
                                </div>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">CGST</label>
                                <div class="erppage-inputgroup">
                                    <input type="number" class="erppage-input erppage-width-30" id="NumCGST1">
                                    <input type="number" class="erppage-input erppage-width-70" id="NumCGST2" placeholder="0.00">
                                </div>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">SGST</label>
                                <div class="erppage-inputgroup">
                                    <input type="number" class="erppage-input erppage-width-30" id="NumSGST1">
                                    <input type="number" class="erppage-input erppage-width-70" id="NumSGST2" placeholder="0.00">
                                </div>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">IGST</label>
                                <div class="erppage-inputgroup">
                                    <input type="number" class="erppage-input erppage-width-30" id="NumIGST1">
                                    <input type="number" class="erppage-input erppage-width-70" id="NumIGST2" placeholder="0.00">
                                </div>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Packing</label>
                                <div class="erppage-inputgroup">
                                    <input type="number" class="erppage-input erppage-width-30" id="NumPacking1">
                                    <input type="number" class="erppage-input erppage-width-70" id="NumPacking2" placeholder="0.00">
                                </div>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Round Off</label>
                                <input type="number" class="erppage-input" id="NumRoundOff" placeholder="0.00">
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Net Amount</label>
                                <input type="number" class="erppage-input" id="NumNetAmount" placeholder="Enter Net Amount">
                            </div>
                        </div>
                    </div>
                    <!-- Logistic Details -->
                    <div class="erppage-tab-content" id="logisticdetails">
                        <div class="erppage-grid8">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label">Transport Name</label>
                                <select class="erppage-input erppage-select" id="ddltransportname">
                                    <option value="">Select Transport Name</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Vehicle No.</label>
                                <input type="text" class="erppage-input" id="TxtVehicleNo" placeholder="Enter Vehicle No.">
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">GR No.</label>
                                <input type="number" class="erppage-input" id="TxtGRNo" placeholder="Enter GR No.">
                            </div>
                            <div class="erppage-divfield erppage-datefield">
                                <label class="erppage-label">GR Date</label>
                                <div class="erppage-datebox">
                                    <input type="date" class="erppage-input erppage-dateinput" id="DtGRDate">
                                    <label class="erppage-checkbox-inside">
                                        <input type="checkbox" class="erppage-checkbox-input" id="chkGRDate">
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="erppage-actions">
            <button id="btn_save" type="submit" class="erppage-btn erppage-btn-save">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>
        </div>

    </div>
</div>
