@{
    ViewBag.Title = "Store Inventory Transfer List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentMenu = ViewBag.CurrentMenu as string;
}
<div id="erp-toast-container"></div>
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>Store Inventory Transfer List</span>
    </div>
    <div class="erppagelist-header-right">
        <button class="erppage-header-back " id="button_add" onclick="window.location.href='@Url.Action("Index", "StoreInventoryTransfer")'">
            <i class="fa fa-plus"></i>Add New
        </button>
    </div>
</div>
<div class="erppagelist-toolbar">
    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" id="searchBox" placeholder="Search Module..." />
    </div>
    <div class="erppagelist-actions">
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" id="button_print" data-tooltip="Print Report">
            <i class="fa fa-print"></i> Print
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" id="button_export" data-tooltip="Export to Excel">
            <i class="fa fa-file-excel"></i> Export
        </button>
    </div>
</div>
<div class="erppagelist-container">
    <div class="excel-wrapper fixed-grid-wrapper">
        <table id="tblStoreInventoryTransferList" class="excel-table fixed-grid-table table-width resizable-table">
            <colgroup>
                <col style="width: 8%;">
                <col style="width: 10%;">
                <col style="width: 10%;">
                <col style="width: 10%;">
                <col style="width: 10%;">
                <col style="width: 10%;">
                <col style="width: 10%;">
               
                <col class="action-col" style="width: 10%;">
            </colgroup>
            <thead>
                <tr>
                    <th>Doc No</th>
                    <th>Doc Type</th>
                    <th>Doc Date</th>
                    <th>Shift</th>
                    <th>Slip No</th>
                    <th>DeptName</th>
                    <th>Remarks</th>
                    <th class="action-col">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    <div class="erppagelist-pagination">
        <div class="pagination-left">
            <select id="pageSizeSelect">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="pagination-center">
            <button class="page-nav" id="prevBtn">‹</button>
            <div id="tablePagination" class="page-numbers"></div>
            <button class="page-nav" id="nextBtn">›</button>
        </div>
        <div class="pagination-right" id="pageInfoText">
            Results: 0 - 0 of 0
        </div>
    </div>
</div>

<script src="~/common/pagination.js"></script>
<script src="~/common/delete.js"></script>

<script src="~/js/erpjs/inventory/transaction/storeinventorytransferlistjs/storeinventorytransferlist.js"></script>