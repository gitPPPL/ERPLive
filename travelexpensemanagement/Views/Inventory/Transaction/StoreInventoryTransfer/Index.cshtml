@{
    ViewBag.Title = "Store Inventory Transfer";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var globalVar = ViewBag.GlobalVariables as Models.UserSessionData;
}
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-exchange"></i>
        </div>
        <div class="erppage-header-title">Store Inventory Transfer</div>
    </div>
    <div class="erppage-header-right">
        <button id="btn_print" type="button" class="erppage-btn erppage-btn-print" onclick="StorePrint()">
            <i class="fa-solid fa-print"></i>
            <span>Print</span>
        </button>
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "StoreInventoryTransferList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="StoreInventoryTransferform">
    <input type="hidden" class="form-control" id="CODE" name="CODE">
    <div class="erppage-container">
        <div class="erppage-fieldset">
            <div class="erppage-grid8">
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Type</label>
                    <select class="erppage-input erppage-select" id="ddlDocType">
                        <option value="">Select Doc Type</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc No</label>
                    <input type="number" class="erppage-input" id="NumDocno" placeholder="Enter Doc No" readonly>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-input" id="DtDocDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Status</label>
                    <select class="erppage-input erppage-select" id="ddlStatus">
                        <option value="">Select Status</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Shift</label>
                    <select class="erppage-input erppage-select" id="ddlShift">
                        <option value="">Select Shift</option>
                        <option value="A">A</option>
                        <option value="B">B</option>
                        <option value="C">C</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Slip No</label>
                    <input type="number" class="erppage-input" id="NumSlipNo" placeholder="Enter Slip No">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Req. by Department</label>
                    <select class="erppage-input erppage-select" id="ddlRefDepartment">
                        <option value="">Select Ref. by Department</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Reason</label>
                    <textarea type="text" class="erppage-textarea" style="height:40px;" id="txtreason" placeholder="Enter Reason"></textarea>
                </div>
            </div>
            <div class="erppage-internalaction mt-2">
                <button type="button" class="erppage-btn erppage-btn-common-print-disabled" id="btn_linkWB"><i class="fa fa-link"></i> Link WB</button>
            </div>
            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Item Details</legend>
                <div class="erppagelist-container">
                    <div class="excel-wrapper fixed-grid-wrapper">
                        <table id="tblItemdetail" class="excel-table fixed-grid-table table-width resizable-table">
                            <colgroup>
                                <col class="hidden-col">
                                <col style="width: 81px;">
                                <col style="width:180px;">
                                <col style="width: 122px;">
                                <col style="width: 117px;">
                                <col style="width:70px;">
                                <col style="width: 72px;">
                                <col style="width: 104px;">
                                <col style="width: 155px;">
                                <col style="width: 145px;">
                                <col style="width: 113px;">
                                <col style="width: 134px;">
                                <col style="width:120px;">
                                <col style="width:120px;">
                                <col style="width:120px;">
                                <col style="width: 124px;">
                                <col style="width: 127px;">
                                <col style="width:120px;">
                                <col class="action-col" style="width:80px;">
                            </colgroup>
                            <thead>
                                <tr>
                                    <th class="hidden-col">Code</th>
                                    <th>Item Code</th>
                                    <th>Item Name</th>
                                    <th>Make</th>
                                    <th>Unit</th>
                                    <th>Nos</th>
                                    <th>Quantity</th>
                                    <th>Bag No</th>
                                    <th>From Place</th>
                                    <th>To Place</th>
                                    <th>Remarks</th>
                                    <th>WB Date</th>
                                    <th>Ref/WB Type</th>
                                    <th>Ref/WB No</th>
                                    <th>POrd Type</th>
                                    <th>POrd No</th>
                                    <th>PReq Type</th>
                                    <th>PReq No</th>
                                    <th class="action-col">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </fieldset>
            
        </div>

        <div class="erppage-actions">
            <button id="btn_save" type="submit" class="erppage-btn erppage-btn-save">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>
        </div>

    </div>
</div>
<script src="~/common/dropdown.js"></script>
<script src="~/js/erpjs/inventory/transaction/storeinventorytransferjs/storeinventorytransfer.js"></script>
<script>
    var compCode = '@ViewBag.CompCode';
    var branchCode = '@ViewBag.BranchCode';
    var yearCode = '@ViewBag.YearCode';

    window.globalVariables = {
        compCode: "@globalVar?.PubCompCode",
        yearCode: "@globalVar?.PubFYearCode",
        branchCode: "@globalVar?.PubBranchCode",

        companyName: "@globalVar?.CompanyName",
        add1: "@globalVar?.Address1",
        add2: "@globalVar?.Address2"
    };

    window.database = {
        db: "@ViewBag.DatabaseName"
    }
</script>