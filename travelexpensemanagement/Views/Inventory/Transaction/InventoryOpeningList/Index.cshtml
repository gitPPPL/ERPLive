@{
    ViewBag.Title = "Inventory Opening List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentMenu = ViewBag.CurrentMenu as string;
}
<div id="erp-toast-container"></div>

<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>Inventory Opening List</span>
    </div>
    <div class="erppagelist-header-right">
        <button class="erppage-header-back" onclick="window.location.href='@Url.Action("Index", "InventoryOpeningEntry")'">
            <i class="fa fa-plus"></i>Add New
        </button>
    </div>
</div>

<div class="erppagelist-toolbar">
    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" id="searchBox" placeholder="Search Module..." />
    </div>
    <div class="erppagelist-actions">
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report">
            <i class="fa fa-print"></i> Print
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Export to Excel">
            <i class="fa fa-file-excel"></i> Export
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail">
            <i class="fa fa-envelope"></i> Mail
        </button>
        <button class="erppagelist-btn erppagelist-btn-approve tooltip-btn"
                data-tooltip="Approve Records">
            <i class="fa fa-check-circle"></i> Approved
        </button>
    </div>
</div>

<div class="erppagelist-container">
    <div class="excel-wrapper fixed-grid-wrapper">
        <table id="tblInventoryOpeningList" class="excel-table fixed-grid-table table-width resizable-table">
            <colgroup>
                <col style="width:180px;"> 
                <col style="width:100px;"> 
                <col style="width:100px;"> 
                <col style="width:100px;"> 
                <col style="width:100px;"> 
                <col style="width:90px;">  
                <col style="width:90px;">  
                <col style="width:110px;"> 
                <col style="width:90px;">  
                <col style="width:70px;">  
                <col style="width:90px;">  
                <col style="width:100px;"> 
                <col style="width:100px;"> 
                <col style="width:110px;"> 
                <col style="width:100px;"> 
                <col style="width:110px;"> 
                <col style="width:70px;">  
                <col style="width:80px;">  
                <col style="width:100px;"> 
                <col style="width:100px;"> 
                <col style="width:100px;"> 
                <col style="width:100px;"> 
                <col style="width:120px;"> 
                <col style="width:180px;">
                <col style="width:90px;">
            </colgroup>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Year Code</th>
                    <th>Comp Code</th>
                    <th>Branch Code</th>
                    <th>Doc Type</th>
                    <th>Doc No</th>
                    <th>Doc Date</th>
                    <th>Doc Id1</th>
                    <th>Shift</th>
                    <th>Slip No</th>
                    <th>Pord Type</th>
                    <th>Pord No</th>
                    <th>Place Code</th>
                    <th>Emp Code</th>
                    <th>Dept Code</th>
                    <th>Remarks</th>
                    <th>Cons Type</th>
                    <th>Status</th>
                    <th>Amount</th>
                    <th>Plan Type</th>
                    <th>Plan No</th>
                    <th>Faprov Status</th>
                    <th>Faprov Remarks</th>
                    <th class="action-col">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    <div class="erppagelist-pagination">
        <div class="pagination-left">
            <select id="pageSizeSelect">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="pagination-center">
            <button class="page-nav" id="prevBtn">‹</button>
            <div id="tablePagination" class="page-numbers"></div>
            <button class="page-nav" id="nextBtn">›</button>
        </div>
        <div class="pagination-right" id="pageInfoText">
            Results: 0 - 0 of 0
        </div>
    </div>
</div>

<script>

    let currentPage = 1;
    let pageSize = 10;
    let totalCount = 0;
    var controllerName = window.location.pathname.split('/')[1];

    $(document).ready(function () {

          loadAllInward();
            // checkPermission(controllerName, function () {
            //   loadAllInward();
            // });

        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadAllInward();
        });

        $('#button_export').on('click', function () {
            var text = $('#searchBox').val();
            window.location.href = '/InventoryOpeningList/ExportToExcel?searchTerm=' + encodeURIComponent(text);
        });

        $('#button_print').on('click', function () {
            var text = $('#searchBox').val();
            window.open('/InventoryOpeningList/ExportToPdf?searchTerm=' + encodeURIComponent(text), '_blank');
        });

    });

    // ================= LOAD DATA =================
    function loadAllInward() {

        $.ajax({
            url: '/InventoryOpeningList/GetList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: $('#searchBox').val(),
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {

                if (!res.success) {
                    toastr.error("Failed to load data.");
                    return;
                }

                const list = res.lists || [];
                totalCount = res.totalCount || 0;

                renderTable(list);
                renderPagination();
            },
            error: function (xhr) {
                toastr.error('Error loading list: ' + xhr.responseText);
            }
        });
    }

    // ================= TABLE =================
    function renderTable(list) {

        const tbody = $('#tblInwardEntryList tbody');
        tbody.empty();

        if (!list || list.length === 0) {
            tbody.append('<tr><td colspan="13" class="text-center text-muted">No list found.</td></tr>');
            return;
        }

        $.each(list, function (index, item) {
            tbody.append(`
                <tr>
                    <td style="display:none;">${item.v_NO || ''}</td>
                    <td>${item.v_NO || ''}</td>
                    <td>${item.v_TYPE || ''}</td>
                    <td>${formatDate(item.v_DATE)}</td>
                    <td>${item.trucK_NO || ''}</td>
                    <td>${item.bilL_NO || ''}</td>
                    <td>${formatDate(item.bilL_DATE)}</td>
                    <td>${item.partY_NAME || ''}</td>
                    <td>${item.transiT_NO || ''}</td>
                    <td>${item.waybilL_NO || ''}</td>
                    <td>${formatDate(item.r_DATE)}</td>
                    <td>${item.r_TIME || ''}</td>
                    <td>${item.status || ''}</td>

                    <td class="action-col">
                    <div class="action-wrap">

                    <button class="act-btn edit permission-edit" onclick="AddOrEditFunction('${item.v_NO}','${item.vtypeCode}' ,'${item.v_DATE}')"><i class="fa fa-edit"></i></button>

                    <button class="act-btn view btn-view" onclick="viewMenuDetails('${item.v_NO}','${item.vtypeCode}')"><i class="fa fa-eye"></i></button>

                    <button class="act-btn delete permission-delete" onclick="deleteTemp('${item.v_NO}','${item.vtypeCode}')"><i class="fa fa-trash"></i></button>

                    <button class="act-btn document btn-document" onclick="showDocumentPopup('${item.doC_ID}')"><i class="fa fa-file"></i></button>
                        </div>
                    </td>
                </tr>
            `);
            applyGridPermission();
        });

    }

    // ================= PAGINATION =================
    function renderPagination() {

        const totalPages = Math.ceil(totalCount / pageSize) || 1;

        let html = '';
        let maxVisible = 5;

        let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
        let endPage = startPage + maxVisible - 1;

        if (endPage > totalPages) {
            endPage = totalPages;
            startPage = Math.max(1, endPage - maxVisible + 1);
        }

        if (startPage > 1) {
            html += `<span class="page-number" onclick="goToPage(1)">1</span>`;
            if (startPage > 2) html += `<span class="dots">...</span>`;
        }

        for (let i = startPage; i <= endPage; i++) {
            html += `<span class="page-number ${i === currentPage ? 'active' : ''}"
                        onclick="goToPage(${i})">${i}</span>`;
        }

        if (endPage < totalPages) {
            if (endPage < totalPages - 1) html += `<span class="dots">...</span>`;
            html += `<span class="page-number" onclick="goToPage(${totalPages})">${totalPages}</span>`;
        }

        $('#pageNumbers').html(html);

        let start = (currentPage - 1) * pageSize + 1;
        let end = Math.min(currentPage * pageSize, totalCount);

        if (totalCount === 0) {
            start = 0;
            end = 0;
        }

        $('#pageInfoText').text(`Results: ${start} - ${end} of ${totalCount}`);

        $('#prevBtn').prop('disabled', currentPage === 1);
        $('#nextBtn').prop('disabled', currentPage === totalPages);
    }

    // ================= PAGINATION ACTIONS =================
    function prevPage() {
        if (currentPage > 1) {
            currentPage--;
            loadAllInward();
        }
    }

    function nextPage() {
        const totalPages = Math.ceil(totalCount / pageSize);
        if (currentPage < totalPages) {
            currentPage++;
            loadAllInward();
        }
    }

    function goToPage(page) {
        currentPage = page;
        loadAllInward();
    }

    function changeRowsPerPage() {
        pageSize = parseInt($('#pageSizeSelect').val());
        currentPage = 1;
        loadAllInward();
    }

    // ================= UTIL =================
    function formatDate(dateStr) {
        if (!dateStr) return '';
        const d = new Date(dateStr);
        if (isNaN(d)) return '';

        const day = String(d.getDate()).padStart(2, '0');
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const year = d.getFullYear();

        return `${day}-${month}-${year}`;
    }

    // ================= ACTIONS =================
    function AddOrEditFunction() {
        //Cheackview(vtype,code ,v_DATE);
          window.location.href = `/InventoryOpening/Index?id=${encodeURIComponent(v_no)}&vtype=${encodeURIComponent(v_type)}`;

    }

    function viewMenuDetails(code, vtype) {
        window.location.href = `/InwardEntry/Index?id=${encodeURIComponent(code)}&vtype=${encodeURIComponent(vtype)}&mode=view`;
    }

    function Cheackview(v_type, v_no, vdate) {

        $.ajax({
            url: '/InventoryOpeningList/CheackEdit',
            type: 'POST',
            data: {
                v_type: v_type,
                v_no: v_no,
                v_DATE: formatDate(vdate)
            },
            success: function (res) {
                  console.log("res.status",res.status);
                if (res.status== false )
                {
                    Swal.fire({
                    title: 'Warning',
                    text: res.message,
                    icon: 'warning',
                    confirmButtonText: 'OK'
                    });
                    return ;
                }
                else{
                   window.location.href = `/InwardEntry/Index?id=${encodeURIComponent(v_no)}&vtype=${encodeURIComponent(v_type)}`;
                }


            },
            error: function (xhr) {
                alert("Error: " + xhr.responseText);
            }
        });
    }

    function deleteTemp(code, VType) {
        Swal.fire({
            title: "Are you sure?",
            text: "You want to delete this Inward Entry?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {

            if (result.isConfirmed) {

                $.ajax({
                    url: '/InventoryOpeningList/Delete',
                    type: 'POST',
                    data: { code: code, VType: VType },
                    success: function (res) {

                        if (res.success) {
                            toastr.success(res.message || "Deleted successfully");
                            loadAllInward();
                        } else {
                            toastr.error(res.message || 'Failed to delete.');
                        }
                    },
                    error: function () {
                        toastr.error('Error deleting record.');
                    }
                });
            }
        });
    }

    function showDocumentPopup(docCode) {

        $.ajax({
            url: '/InventoryOpeningList/DocDetailsCode',
            type: 'POST',
            dataType: 'json',
            data: { docCode: docCode },
            success: function (response) {
                if (response.success) {
                    showDocumentPopupjQuery(response.data, docCode);
                } else {
                    toastr.error("Failed to get document details.");
                }
            },
            error: function () {
                toastr.error("Error fetching document details.");
            }
        });
    }

</script>