                                    <option value="Basic">Basic</option>
                                    <option value="Standard">Standard</option>
                                    <option value="Premium">Premium</option>
                                    <option value="NA">NA</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Email ID</label>
                                <input type="email" class="erppage-input" id="txtemail" placeholder="Enter Email ID" />
