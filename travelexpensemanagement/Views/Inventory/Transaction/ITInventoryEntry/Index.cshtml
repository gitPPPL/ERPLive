                                <label class="erppage-label">Assign. Mobile No.</label>
                                <input type="email" class="erppage-input" id="AssmobileNo" placeholder="Enter Mobile NO " />
                            </div>
                        </div>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Office Lic. Type</label>
                                <select class="erppage-input erppage-select" id="ddlOfficeLicType">
                                    <option value="">Select Office Lic. Type</option>
                                    <option value="Basic">Basic</option>
                                    <option value="Standard">Standard</option>
                                    <option value="Enterprise">Enterprise</option>
                                    <option value="Office365">Office 365</option>
                                    <option value="Student">Student</option>
                                    <option value="DOSFree">DOS Free</option>
                                    <option value="NA">NA</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Intercom No.</label>
                                <input type="text" class="erppage-input" id="TxtIntercomNo" placeholder="Enter TxtIntercomNo" />
                            </div>
                        </div>
                    </fieldset>
                    <fieldset class="erppagefieldset">
