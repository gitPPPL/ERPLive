                                        <input type="checkbox" class="erppage-checkbox-input" id="chkissuedateFrom">
                                    </label>
                                </div>
                            </div>
                            <div class="erppage-divfield erppage-datefield">
                                <label class="erppage-label">Issue Date To</label>
                                <div class="erppage-datebox">
                                    <input type="date" class="erppage-input erppage-dateinput" id="DtissuedateTo">
                                    <label class="erppage-checkbox-inside">
                                        <input type="checkbox" class="erppage-checkbox-input" id="chkissuedateTo">
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Unit Name</label>
                                <select class="erppage-input erppage-select" id="ddlUnitname">
                                    <option value="">Select Unit Name</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Server IP</label>
                                <select class="erppage-input erppage-select" id="ddlServerIP">
                                    <option value="">Select Server IP</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Employee Name</label>
                                <select class="erppage-input erppage-select" id="ddlEmployeename">
                                    <option value="">Select Employee Name</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Asset Cat.</label>
                                <select class="erppage-input erppage-select" id="ddlAssetCat">
                                    <option value="">Select Asset Cat.</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Asset Type</label>
                                <select class="erppage-input erppage-select" id="ddlAssetType">
                                    <option value="">Select Asset Type</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Purchase From</label>
                                <select class="erppage-input erppage-select" id="ddlPurchaseFrom">
                                    <option value="">Select Purchase From</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Warrantee Status</label>
                                <select class="erppage-input erppage-select" id="ddlWarrantys">
                                    <option value="">Select Warrantee Status</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Device Status</label>
                                <select class="erppage-input erppage-select" id="ddlDevices">
                                    <option value="">Select Device Status</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Department</label>
                                <select class="erppage-input erppage-select" id="ddlDepartmentp">
                                    <option value="">Select Department</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-internalaction">
                            <button type="button" id="btn_print" class="erppage-btn erppage-btn-common-print-disabled"><i class="fa fa-print"></i> Print</button>
                        </div>
                    </fieldset>
                   
                </div>
            </div>
