                                    <option value="HomeBasic">Home Basic</option>
                                    <option value="Standard">Standard</option>
                                    <option value="Enterprise">Enterprise</option>
                                    <option value="DOSFree">DOS Free</option>
                                    <option value="NA">NA</option>
                                </select>
                            </div>
