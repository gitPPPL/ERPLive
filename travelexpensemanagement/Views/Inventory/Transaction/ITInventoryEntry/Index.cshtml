                            </div>
                        </div>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield">
                                <label class="erppage-label">VPN UName</label>
                                <input type="text" class="erppage-input" id="txtVPNuname" placeholder="Enter VPN UName" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">VPN Password</label>
                                <input type="text" class="erppage-input" id="txtVPNPassword" placeholder="Enter VPN Password" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Dataserver UName</label>
                                <input type="text" class="erppage-input" id="txtdataserveruname" placeholder="Enter Dataserver UName" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Dataserver Password</label>
                                <input type="text" class="erppage-input" id="txtdataserverpassword" placeholder="Enter Dataserver Password" />
                            </div>
                        </div>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Cloud UName</label>
                                <input type="text" class="erppage-input" id="txtclouduname" placeholder="Enter Cloud UName" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Cloud Password</label>
                                <input type="text" class="erppage-input" id="txtCloudpassword" placeholder="Enter Cloud Password" />
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="erppagescol-4">
