@{
    ViewBag.Title = "IT Inventory Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-laptop"></i>
        </div>
        <div class="erppage-header-title">IT Inventory Entry</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "ITInventoryList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="ITInventoryform">
    <input type="hidden" class="form-control" id="CODE" name="CODE">
    <div class="erppage-container">
        <div class="erppage-fieldset">
            <div class="erppagesrow">
                <div class="erppagescol-8">
                    <div class="erppage-grid3">
                        <div class="erppage-divfield">
                            <label class="erppage-label">Doc No</label>
                            <input type="number" class="erppage-input" id="NumDocno" placeholder="Enter Doc No" readonly>
                        </div>
                        <div class="erppage-divfield">
                            <label class="erppage-label">Doc Date</label>
                            <input type="date" class="erppage-input" id="DtDocDate">
                        </div>
                        <div class="erppage-divfield">
                            <label class="erppage-label">User Status</label>
                            <select class="erppage-input erppage-select" id="ddlUserstatus">
                                <option value="">Select User Status</option>
                                <option value="1">Active</option>
                                <option value="2">In Active</option>
                            </select>
                        </div>
                    </div>
                    <fieldset class="erppagefieldset">
                        <legend class="erppagefieldset-legend">User Information</legend>
                         <div class="erppage-grid4">
                             <div class="erppage-divfield">
                                 <label class="erppage-label">Unit Name</label>
                                 <select class="erppage-input erppage-select" id="ddlUnitName">
                                     <option value="">Select Unit Name</option>
                                     <option value="PPPL">PPPL</option>
                                     <option value="PLPL">PLPL</option>
                                     <option value="PEPL">PEPL</option>
                                     <option value="SRP">SRP</option>
                                     <option value="STPL">STPL</option>
                                     <option value="KTPL">KTPL</option>
                                     <option value="SCTPL">SCTPL</option>
                                     <option value="KOTHI">KOTHI</option>
                                    <option value="Other">Other</option>
                                 </select>
                             </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Employee Name</label>
                                <select class="erppage-input erppage-select" id="ddlEmployeeName">
                                    <option value="">Select Employee Name</option>
                                </select>
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label">Department</label>
                                <input type="text" class="erppage-input" id="txtdepartment" placeholder="Enter Department"/>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Designation</label>
                                <input type="text" class="erppage-input" id="txtdesignation" placeholder="Enter Designation" />
                            </div>
                         </div>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Used By </label>
                                <input type="text" class="erppage-input" id="txtusedby" placeholder="Enter Used By" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Location</label>
                                <input type="text" class="erppage-input" id="txtlocation" placeholder="Enter Location" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Email Lic. Type</label>
                                <select class="erppage-input erppage-select" id="ddlEmailLicType">
