            <div class="erppage-fieldset">
                <div class="erppage-container">
                    <div class="erppage-tabs">
                        <button class="erppage-tab active" data-tab="itemrecord">Device Information</button>
                    </div>
                    <!-- Item Record -->
                    <div class="erppage-tab-content active" id="itemrecord">
                        <div class="erppagelist-container">
                            <div class="excel-wrapper fixed-grid-wrapper">
                                <table id="tblDeviceInfromation" class="excel-table fixed-grid-table table-width resizable-table">
                                    <colgroup>
                                        <col class="hidden-col">
                                        <col style="width: 149px;">
                                        <col style="width: 154px;">
                                        <col style="width:100px;">
                                        <col style="width:100px;">
                                        <col style="width:120px;">
                                        <col style="width:130px;">
                                        <col style="width:110px;">
                                        <col style="width:110px;">
                                        <col style="width: 123px;">
                                        <col style="width:130px;">
                                        <col style="width: 185px;">
                                        <col style="width: 189px;">
                                        <col style="width:180px;">
                                        <col style="width: 129px;">
                                        <col style="width: 126px;">
                                        <col style="width:80px;">
                                        <col style="width:150px;">
                                        <col style="width:120px;">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th class="hidden-col">Code</th>
                                            <th>Asset Cat.</th>
                                            <th>Asset Type</th>
                                            <th>Asset Srno</th>
                                            <th>Asset Code</th>
                                            <th>Serial No.</th>
                                            <th>Device Name</th>
                                            <th>Device Make</th>
                                            <th>Device Model</th>
                                            <th>Purchase Date</th>
                                            <th>Purchase From</th>
                                            <th>Warranty Status</th>
                                            <th>Device Status</th>
                                            <th>Reason</th>
                                            <th>Issue Date</th>
                                            <th>Return Date</th>
                                            <th>Qty</th>
                                            <th>Purpose</th>
                                            <th class="action-col">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="erppage-grid6">
                <div class="erppage-divfield erppage-col-span-3">
                    <label class="erppage-label">Remarks</label>
                    <textarea typeof="text" class="erppage-input" id="txtremarks" style="height:50px;" placeholder="Enter Remarks"></textarea>
                </div>
            </div>

