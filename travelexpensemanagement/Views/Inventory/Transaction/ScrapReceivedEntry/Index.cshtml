

@using System.Text.Json

@{
    ViewBag.Title = "Scrap Received Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";



    var globalVariables = ViewBag.GlobalVariables as Models.UserSessionData ?? new Models.UserSessionData();
    var databaseName = ViewBag.DatabaseName as string;
    var CompCode = int.TryParse(globalVariables.PubCompCode, out var parsedCompCode) ? parsedCompCode : 0;
    var PubUserLevel = int.TryParse(globalVariables.PubUserLevel, out var parsedPubUserLevel) ? parsedPubUserLevel : 0;
    var logindate = globalVariables.PubLoginDate is DateTime date ? date.ToString("yyyy-MM-dd") : "";

}


<script>
    window.globalVariables = @Html.Raw(JsonSerializer.Serialize(new {
        CompCode = int.TryParse(globalVariables.PubCompCode, out var c) ? c : 0,
        UserId = globalVariables.PubUserId,
        UserName = globalVariables.PubUserName,
        UserLevel = int.TryParse(globalVariables.PubUserLevel, out var ul) ? ul : 0,
        FYearCode = globalVariables.PubFYearCode,
        BranchCode = globalVariables.PubBranchCode,
        LoginDate = globalVariables.PubLoginDate.ToString("yyyy-MM-dd"),
        CompanyName = globalVariables.CompanyName,
        Address1 = globalVariables.Address1,
        Address2 = globalVariables.Address2,
        GST = globalVariables.gstin,
        PAN = globalVariables.PAN,
        Phone = globalVariables.Phone,
        Email = globalVariables.Email,
        wsid = globalVariables.PubWorkStationID
    }));

    window.database = @Html.Raw(JsonSerializer.Serialize(databaseName));
</script>


<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-cubes"></i>
        </div>
        <div class="erppage-header-title">Scrap Received Entry</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "ScrapReceivedList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="ScrapReceivedform">
    <input type="hidden" class="form-control" id="CODE" name="CODE">
    <div class="erppage-container">
        <div class="erppage-fieldset">
            <div class="erppage-grid6">
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Type</label>
                    <select class="erppage-input erppage-select" id="ddlDocType">
                        <option value="">Select Doc Type</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc No</label>
                    <input type="number" class="erppage-input" id="NumDocno" placeholder="Enter Doc No">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-input" id="DtDocDate">
                </div>
               
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">A/C Name</label>
                    <select class="erppage-input erppage-select" id="ddlACName">
                        <option value="">Select A/C Name</option>
                    </select>
                </div>
            </div>
            <div class="erppage-grid5">
               
                <div class="erppage-divfield">
                    <label class="erppage-label">Place</label>
                    <select class="erppage-input erppage-select" id="ddlPlace">
                        <option value="">Select Place</option>
                    </select>
                </div>
             
          
                <div class="erppage-divfield">
                    <label class="erppage-label">Remarks</label>
                    <textarea typeof="text" class="erppage-input" id="TxtRemarks" style="height: 45px;" placeholder="Enter Remarks"></textarea>
                </div>
            </div>
            <div class="erppage-internalaction">
                <button type="button" id="btn_pendinglist" class="erppage-btn erppage-btn-common-pending-disabled" data-bs-toggle="modal" data-bs-target="#pendinglistModal">
                    <i class="fa-solid fa-hourglass-half"></i>
                    <span>Pending List</span>
                </button>
            </div>

            <!--Modal Popup-->
            <!--Load Pending WB-->
            <div class="modal fade" id="pendinglistModal" tabindex="-1" aria-labelledby="pendinglistLabel" aria-hidden="true">
                <div class="modal-dialog erppagesmodal medium-modal erppage-modal-drag">
                    <div class="modal-content erppagesmodal-content">
                        <div class="erppagesmodal-header" style="justify-content: flex-end;">
                            <button type="button" class="erppagesmodal-close" data-bs-dismiss="modal" aria-label="Close">
                                <i class="fa fa-times"></i>
                            </button>
                        </div>
                        <div class="erppagesmodal-body">
                            <div class="excel-wrapper fixed-grid-wrapper">
                                <table id="tblpendinglist" class="excel-table width-table fixed-grid-table resizable-table">
                                    <colgroup>
                                        <col style="width:50px;">     
                                        <col style="width:250px;">  
                                        <col style="width:100px;">  
                                        <col style="width:120px;">  
                                        <col style="width:180px;">  
                                        <col style="width:250px;">  
                                        <col class="hidden-col">    
                                        <col class="hidden-col">    
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th><input type="checkbox" id="selectAlllpwb" /></th>
                                            <th>Item Code</th>
                                            <th>Item Name</th>
                                            <th>Unit</th>
                                            <th>Quantity</th>
                                            <th>Department</th>
                                            <th>TO DEPT</th>  
                                            <th>Scrap Name</th>
                                            <th>ScrapCode</th>                                    
                                                                       
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                            <div class="erppagesmodal-action mt-2">
                                <button type="button" class="erppagesmodal-btn" data-bs-dismiss="modal" id="btn_seletedRow">
                                    <i class="fa fa-copy"></i>Okay
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
           
            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Item Details</legend>
                <div class="excel-wrapper fixed-grid-wrapper">
                    <table id="tblScrapreceivedentry" class="excel-table fixed-grid-table width-table resizable-table">
                        <colgroup>
                            <col style="width: 150px;"> 
                            <col style="width: 100px;"> 
                            <col style="width: 100px;"> 
                            <col style="width: 130px;"> 
                            <col style="width: 150px;"> 
                            <col style="width: 150px;"> 
                            <col style="width: 87px;">  
                        </colgroup>
                        <thead>
                            <tr>
                              
                                <th>Item Name</th>
                                <th>Quantity</th>
                                <th>Weight</th>
                                <th>Department</th>
                                <th>Scrap Name</th>
                                <th>Remark</th>
                                <th class="action-col">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </fieldset>

            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Print Details</legend>
                <div class="erppage-grid6">
                    <div class="erppage-divfield">
                        <label class="erppage-label">From</label>
                        <input type="date" class="erppage-input" id="DtFrom" />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">To Date</label>
                        <input type="date" class="erppage-input" id="DtToDate" />
                    </div>
                    <div class="erppage-divfield erppage-col-span-2">
                        <label class="erppage-label">Item</label>
                        <select class="erppage-input" id="ddlitem">
                            <option value="">Select Item</option>
                        </select>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Department</label>
                        <select class="erppage-input" id="ddlDepartment">
                            <option value="">Select Department</option>
                        </select>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Unit</label>
                        <select class="erppage-input" id="ddlUnit">
                            <option value="">Select Unit</option>
                        </select>
                    </div>
                </div>
                <div class="erppage-internalaction mt-2">
                    <button type="button" id="btn_dailyreport" class="erppage-btn erppage-btn-common-print-disabled">
                        <i class="fa-solid fa-print"></i>
                        <span>Daily Report</span>
                    </button>
                    <button type="button" id="btn_pendingdeptreport" class="erppage-btn erppage-btn-common-print-disabled">
                        <i class="fa-solid fa-print"></i>
                        <span>Pending at Dept. Report</span>
                    </button>
                    <button type="button" id="btn_ScrapIssueReport" class="erppage-btn erppage-btn-common-print-disabled">
                        <i class="fa-solid fa-print"></i>
                        <span>Scrap Issue Report</span>
                    </button>
                    <button type="button" id="btn_ScrapReceivedReport" class="erppage-btn erppage-btn-common-print-disabled">
                        <i class="fa-solid fa-print"></i>
                        <span>Scrap Received Report</span>
                    </button>
                    <button type="button" id="btn_ScrapStockReport" class="erppage-btn erppage-btn-common-print-disabled">
                        <i class="fa-solid fa-print"></i>
                        <span>Scrap Stock Report</span>
                    </button>
                </div>
            </fieldset>
        </div>

        <div class="erppage-actions">
            <button id="btn_save" type="submit" class="erppage-btn erppage-btn-save">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>
        </div>

    </div>
</div>
<script src="~/js/erpjs/inventory/transaction/scrapreceivedentry/scrapreceivedentry.js"></script>
<script src="~/js/erpjs/inventory/transaction/scrapreceivedentry/scrapreceivedentryapi.js"></script>
<script src="~/js/erpjs/inventory/transaction/scrapreceivedentry/scrapreceivedentryinit.js"></script>