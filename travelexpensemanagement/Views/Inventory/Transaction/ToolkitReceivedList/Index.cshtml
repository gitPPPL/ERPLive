@{
	ViewBag.Title = "Toolkit Received List";
	Layout = "~/Views/Shared/_Layout.cshtml";

}
<div id="erp-toast-container"></div>
<div class="erppagelist-header">
	<div class="erppagelist-title">
		<i class="fa fa-list"></i>
		<span>Toolkit Received List</span>
	</div>
	<div class="erppagelist-header-right">
		<button class="erppage-header-back" onclick="window.location.href='@Url.Action("Index", "ToolkitReceivedEntry")'" id="button_add">
			<i class="fa fa-plus"></i>Add New
		</button>
	</div>
</div>
<div class="erppagelist-toolbar">
	<div class="erppagelist-search-wrapper">
		<i class="fa fa-search"></i>
		<input type="text" id="searchBox" placeholder="Search Module..." />
	</div>
	<div class="erppagelist-actions">
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" id="button_print">
			<i class="fa fa-print"></i> Print
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Export to Excel" id="button_export">
			<i class="fa fa-file-excel"></i> Export
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail" id="button_mail">
			<i class="fa fa-envelope"></i> Mail
		</button>
		<button class="erppagelist-btn erppagelist-btn-approve tooltip-btn"
				data-tooltip="Approve Records" id="button_approve">
			<i class="fa fa-check-circle"></i> Approved
		</button>
	</div>
</div>
<div class="erppagelist-container">
	<div class="excel-wrapper fixed-grid-wrapper">
		<table id="tblToolkitReceivedList" class="excel-table fixed-grid-table table-width resizable-table">
			<colgroup>
				<col style="width: 71px;">
				@* <col style="width: 104px;"> *@
				<col style="width: 80px;">
				<col style="width: 82px;">
				@* <col style="width: 78px;">
                <col style="width: 91px;"> *@
				<col style="width: 72px;">
				<col style="width: 166px;">
				@* <col style="width: 66px;">
                <col style="width: 51px;">
                <col style="width: 62px;"> *@
				<col style="width: 80px;">
				<col style="width: 109px;">
				@* <col style="width: 74px;">
                <col style="width: 103px;">
                <col style="width: 71px;">
                <col style="width: 88px;">
                <col style="width: 88px;">
                <col style="width: 72px;">
                <col style="width: 54px;">
                <col style="width: 52px;">
                <col style="width: 88px;"> *@
				<col style="width: 120px;">
			</colgroup>
			<thead>
				<tr>
					<th>Doc Type</th>
					@* <th>Doc Type Name</th> *@
					<th>Doc No</th>
					<th>Doc Date</th>
					@* <th>Place Code</th> *@
					@* <th>Place Name</th> *@
					<th>Item Code</th>
					<th>Item Name</th>
					@* <th>Quantity</th> *@
					@* <th>Rate</th> *@
					@* <th>Amount</th> *@
					<th>Emp Code</th>
					<th>Employee Name</th>
					@* <th>From Dept</th>
                    <th>From Department</th>
                    <th>To Dept</th>
                    <th>To Department</th> *@
					@* <th>Remark</th>
                    <th>Received Quantity</th>
                    <th>Dr Amount</th>
                    <th>User</th>
                    <th>Udate</th> *@
					<th class="action-col">Action</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>
	<div class="erppagelist-pagination">
		<div class="pagination-left">
			<select id="pageSizeSelect" onchange="changeRowsPerPage()">
				<option value="5">5</option>
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
			</select>
		</div>
		<div class="pagination-center">
			<button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
			<div id="pageNumbers" class="page-numbers"></div>

			<button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
		</div>
		<div class="pagination-right" id="pageInfoText">
			Results: 0 - 0 of 0
		</div>
	</div>
</div>

<script src="~/common/delete.js"></script>
<script src="~/common/pagination.js"></script>
<script src="~/js/erpjs/inventory/transaction/toolkitreceivedlist/toolkitreceivedlist.js"></script>