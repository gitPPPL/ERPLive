    </div>
    <script src="~/js/portfoliopinsession.js"></script>
    <!-- Bootstrap JS FIRST -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- PIN Session Logic -->

    <script>
        const pinModal = document.getElementById('pinModal');

        pinModal.addEventListener('shown.bs.modal', function () {
            document.getElementById('pinInput').focus();
        });
             function handleEnter(event) {
            if (event.key === "Enter") {
                // event.preventDefault();
                verifyPin(); // 👈 same as Login button click
            }
        }

    </script>
    <script>
        function openVisitorLoginModal() {
            new bootstrap.Modal(
                document.getElementById('visitorLoginModal')
            ).show();
        }

        function openVisitorRegisterModal() {
            // close login modal
            const loginModalEl = document.getElementById('visitorLoginModal');
            bootstrap.Modal.getInstance(loginModalEl).hide();

            // open register modal
            new bootstrap.Modal(
                document.getElementById('visitorRegisterModal')
            ).show();
        }

        // function verifyVisitorLogin() {
        //     document.getElementById("loginError").classList.add("d-none");

        //     const u = document.getElementById("loginUsername").value.trim();
        //     const p = document.getElementById("loginPassword").value.trim();
        //     alert(u)
        //     alert(p)

           
        // }

            function verifyVisitorLogin() {

            document.getElementById("loginError").classList.add("d-none");

            const u = document.getElementById("loginUsername").value.trim();
            const p = document.getElementById("loginPassword").value.trim();

            if (u === '' || p === '') {
                document.getElementById("loginError").classList.remove("d-none");
                document.getElementById("loginError").innerText = "Username and Password required";
                return;
            }

            $.ajax({
                url: '/HomeLogin/VerifyVisitorLogin',
                type: 'POST',
                data: {
                    username: u,
                    password: p
                },
                success: function (res) {
                    if (res.success) {
                        window.location.href = '/Testpage/Index';
                    } else {
                        document.getElementById("loginError").classList.remove("d-none");
                        document.getElementById("loginError").innerText = res.message;
                    }
                },
                error: function () {
                    document.getElementById("loginError").classList.remove("d-none");
                    document.getElementById("loginError").innerText = "Server error";
                }
            });
        }


        function registerVisitor() {

             var username = $('#regUsername').val().trim();
             var phone = $('#regPhone').val().trim();
             var password = $('#regPassword').val().trim();

             if (username === '' || phone === '' || password === '') {
                 $('#registerError').removeClass('d-none').text('All fields are required');
                 return;
             }
                     console.log('Sending data:', {
            Name: username,
            VisitorMobile: phone,
            Password: password
        });

             $.ajax({
                 url: '/HomeLogin/RegisterVisitor',
                 type: 'POST',
                 data: {
                     Name: username,
                     VisitorMobile: phone,
                     Password: password
                 },
                 success: function (response) {
                     if (response.success) {
                         alert('Visitor registered successfully');
                         $('#visitorRegisterModal').modal('hide');
                         $('#regUsername,#regPhone,#regPassword').val('');
                     } else {
                         $('#registerError').removeClass('d-none').text(response.message);
                     }
                 },
                 error: function () {
                     $('#registerError').removeClass('d-none').text('Something went wrong');
                 }
             });
         }
    </script>



    <script>
        function verifyPin() {
            const enteredPin = document.getElementById("pinInput").value;

            if (enteredPin === "2620") {
                setPinSession(); // ✅ Store session
                redirectAfterPin();
            } else {
                document.getElementById("pinError").classList.remove("d-none");
            }
        }
    </script>
 


    <!-- ===== JavaScript ===== -->
    <script>
        /* Mouse Parallax */
        document.addEventListener("mousemove", e => {
            document.querySelectorAll(".shape").forEach((shape, i) => {
                const speed = (i + 1) * 0.02;
                shape.style.transform =
                    `translate(${e.clientX * speed}px, ${e.clientY * speed}px)`;
            });
        });

        /* Ripple Effect */
        document.querySelectorAll(".glass-card").forEach(card => {
            card.addEventListener("click", function (e) {
                const ripple = document.createElement("span");
                ripple.classList.add("ripple");
                const rect = card.getBoundingClientRect();
                ripple.style.left = `${e.clientX - rect.left}px`;
                ripple.style.top = `${e.clientY - rect.top}px`;
                ripple.style.width = ripple.style.height = `${Math.max(rect.width, rect.height)}px`;
                card.appendChild(ripple);
                setTimeout(() => ripple.remove(), 600);
            });
        });
    </script>

    <script>
        function redirectToLogin() {
           window.location.href = '@Url.Action("Index", "Login")';
        }
        function redirectToEmployeeLogin() {
           window.location.href = '@Url.Action("Index", "EmpLogin")';
        }
        function redirectToProducts() {
           window.location.href = '@Url.Action("Index", "Home")';
        }
         function redirectToVisitorRegistration() {
           window.location.href = '@Url.Action("Index", "Testpage")';
        }

        
    </script>

   
    
</body>
</html>
