    function formatDate(dateStr) {
        if (!dateStr) return '';

        const d = new Date(dateStr);
        if (isNaN(d)) return '';

        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');

        return `${year}-${month}-${day}`;
    }

  function setFormReadOnly() {
        const form = $('#CreateTaskForm');

        // Make inputs & textarea readonly
        form.find('input:not([type="button"]):not([type="file"]), textarea')
            .prop('readonly', true);

        // Disable selects & file upload
        form.find('select, input[type="file"]').prop('disabled', true);

        // Disable action buttons (Save / WhatsApp / Popup Save)
        $('#btnSave, #popupsave').prop('disabled', true);

        // Keep navigation buttons enabled
        $('.btn-backtask, .btn-cancel').prop('disabled', false);
    }

