@{
    ViewBag.Title = "Tolrance Master List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<fieldset>
    <legend class="legend-field">Tolrance Master List</legend>
    <div class="row">
        <div class="col-lg-4">
            <div class="input-group shadow-sm rounded-pill overflow-hidden">
                <input type="text" id="searchBox" class="form-control border-0" placeholder="Search Module..." aria-label="Search term" />
            </div>
        </div>
        <div class="col-lg-8 btn-align">
            <button id="btnSave" onclick="window.location.href='@Url.Action("Index", "TolranceMaster")'" type="button" class="btn btn-primary">
                <i class="fa fa-plus"></i> Add Tolrance
            </button>
            <button class="btn btn-print"><i class="fa fa-print"></i> Print</button>
            <button class="btn btn-export"><i class="fas fa-file-export"></i> Export</button>
            <button class="btn btn-mail"><i class="fa fa-envelope"></i> Mail</button>
            <button class="btn btn-send"><i class="fa fa-paper-plane"></i> Approval Send</button>
            <button class="btn btn-approved"><i class="fa fa-check"></i> Approved</button>
        </div>
    </div>
    <div class="card shadow-sm border-0 mt-1">
        <div class="table-responsive">
            <table id="tblTolranceMaster" class="table table-striped table-bordered">
                <thead class="table-head">
                    <tr>
                        <th>Code</th>
                        <th>V Type</th>
                        <th>Qty</th>
                        <th>Tolrance Qty</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Pagination container -->
        <div class="row p-3">
            <div class="col-md-12 d-flex justify-content-center" id="tablePagination"></div>
        </div>
    </div>
</fieldset>

<script>
    let currentPage = 1;
    let pageSize = 10;

    $(document).ready(function () {
        loadAllMenus();

        // Search box event
        $('#searchBox').on('keyup', function () {
          
            currentPage = 1;
            loadAllMenus();
        });
    });

    function loadAllMenus() {
        const searchTerm = $('#searchBox').val();
 
        $.ajax({
            url: '/TolranceMasterList/GetTolranceList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
    console.log("API Response:", res);

    if (!res.success) {
        toastr.error("Failed to load data.");
        return;
    }

    const TolranceMasterlist = res.lists;
    const totalCount = res.totalCount;

    console.log("Parsed Data:", TolranceMasterlist);

                let tbody = $('#tblTolranceMaster tbody');
                tbody.empty();

                if (TolranceMasterlist.length === 0) {
                    tbody.append('<tr><td colspan="5" class="text-center text-muted">No menus found.</td></tr>');
                } else {
                      $.each(TolranceMasterlist, function (index, item) {
        $('#tblTolranceMaster tbody').append(`
            <tr>
                <td>${item.code}</td>
                <td>${item.v_TYPE}</td>
                <td>${item.qty}</td>
                <td>${item.tolrancE_QTY}</td>
                <td>
                    <button class="btn btn-sm btn-light" onclick="AddOrEditFunction('${item.code}')">
                        <i class="fas fa-edit" title="Edit"></i>
                    </button>
                    <button class="btn btn-sm btn-light" onclick="viewMenuDetails('${item.code}')">
                        <i class="fas fa-eye" title="View"></i>
                    </button>
                    <button class="btn btn-sm btn-light btn-delete" onclick="deleteTolrance('${item.code}')">
                        <i class="fas fa-trash text-danger" title="Delete"></i>
                    </button>
                </td>
            </tr>
        `);
    });

                }

                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                toastr.error('Error loading item list: ' + xhr.responseText);
            }
        });
    }

    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const paginationContainer = $('#tablePagination');

        paginationContainer.empty();

        if (total === 0) {
            paginationContainer.html('<span class="text-muted">No records found.</span>');
            return;
        }

        if (totalPages <= 1) return;

        let paginationHtml = '';

        if (currentPage > 1) {
            paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        if (currentPage <= 3) {
            endPage = Math.min(5, totalPages);
        }
        if (currentPage >= totalPages - 2) {
            startPage = Math.max(totalPages - 4, 1);
        }

        for (let i = startPage; i <= endPage; i++) {
            paginationHtml += `
                <button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1"
                        onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        paginationContainer.html(paginationHtml);
    }

    function goToPage(page) {
        currentPage = page;
        loadAllMenus();
    }

    function AddOrEditFunction(code) {
        alert(code);
        //window.location.href = '/TolranceMaster/AddOrEdit?id=' + encodeURIComponent(code);
                   window.location.href = '/TolranceMaster/Index?id=' + encodeURIComponent(code);
                       }

    function viewMenuDetails(code) {
       // window.location.href = '/TolranceMaster/View?id=' + encodeURIComponent(code);
            window.location.href = '/TolranceMaster/Index?id=' + encodeURIComponent(code);
    }

    function deleteTolrance(code) {
        if (!confirm('Are you sure you want to delete this Tolrance?')) return;

          alert('delete: ' + code);

        $.ajax({
            url: '/TolranceMasterList/Delete',
            type: 'POST',
            data: { code: code },
            success: function (res) {
                if (res.success) {
                    toastr.success('Deleted successfully.');
                    loadAllMenus();
                } else {
                    toastr.error(res.message || 'Failed to delete.');
                }
            },
            error: function () {
                toastr.error('Error deleting Tolrance.');
            }
        });
    }


</script>
