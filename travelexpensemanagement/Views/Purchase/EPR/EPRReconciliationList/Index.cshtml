@{
	ViewBag.Title = "EPR Reconciliation List";
	Layout = "~/Views/Shared/_Layout.cshtml";

}
<div id="erp-toast-container"></div>
<div class="erppagelist-header">
	<div class="erppagelist-title">
		<i class="fa fa-list"></i>
		<span>EPR Reconciliation List</span>
	</div>
	<div class="erppagelist-header-right">
		<button class="erppage-header-back" onclick="window.location.href='@Url.Action("Index", "EPRReconciliation")'">
			<i class="fa fa-plus"></i>Add New
		</button>
	</div>
</div>
<div class="erppagelist-toolbar">
	<div class="erppagelist-search-wrapper">
		<i class="fa fa-search"></i>
		<input type="text" id="searchBox" placeholder="Search Module..." />
	</div>
	<div class="erppagelist-actions">
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report">
			<i class="fa fa-print"></i> Print
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Export to Excel">
			<i class="fa fa-file-excel"></i> Export
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail">
			<i class="fa fa-envelope"></i> Mail
		</button>
		<button class="erppagelist-btn erppagelist-btn-approve tooltip-btn"
				data-tooltip="Approve Records">
			<i class="fa fa-check-circle"></i> Approved
		</button>
	</div>
</div>
<div class="erppagelist-container">
	<div class="excel-wrapper fixed-grid-wrapper">
		<table id="tblEPRReconciliationList" class="excel-table fixed-grid-table table-width resizable-table">
			<colgroup>
				<col style="width:100px;">  
				<col style="width:90px;">   
				<col style="width:110px;">  
				<col style="width:120px;">  
				<col style="width:120px;">  
				<col style="width:120px;">  
				<col style="width:120px;">  
				<col style="width:150px;">  
				<col style="width:100px;">  
				<col style="width:100px;">  
				<col style="width:150px;">  
				<col style="width:120px;">  
			</colgroup>
			<thead>
				<tr>
					<th data-column="0">Doc No <span class="sort-icon"></span></th>
					<th data-column="1">Doc Type <span class="sort-icon"></span></th>
					<th data-column="2">Doc Date <span class="sort-icon"></span></th>
					<th data-column="3">Refno1 <span class="sort-icon"></span></th>
					<th data-column="4">Refno2 <span class="sort-icon"></span></th>
					<th data-column="5">Billno <span class="sort-icon"></span></th>
					<th data-column="6">Billdate <span class="sort-icon"></span></th>
					<th data-column="7">Alloted To <span class="sort-icon"></span></th>
					<th data-column="8">City <span class="sort-icon"></span></th>
					<th data-column="9">State <span class="sort-icon"></span></th>
					<th data-column="10">Gstin <span class="sort-icon"></span></th>
					<th data-column="11">Ewaybill <span class="sort-icon"></span></th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>
	<div class="erppagelist-pagination">
		<div class="pagination-left">
			<select id="pageSizeSelect">
				<option value="5">5</option>
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
			</select>
		</div>
		<div class="pagination-center">
			<button class="page-nav" id="prevBtn">‹</button>
			<div id="tablePagination" class="page-numbers"></div>
			<button class="page-nav" id="nextBtn">›</button>
		</div>
		<div class="pagination-right" id="pageInfoText">
			Results: 0 - 0 of 0
		</div>
	</div>
</div>


<script>

	let currentPage = 1;
	let pageSize = 10;

	$(document).ready(function () {
		loadPurchaseBillDirectStages();

		$('#searchBox').on('keyup', function () {
			currentPage = 1;
			loadPurchaseBillDirectStages();
		});
	});

	//Load main grid...............
	function loadPurchaseBillDirectStages() {
		const searchTerm = $('#searchBox').val();

		$.ajax({
			url: '/PurchaseBillPassEntryDirectList/GetAllPurchaseBillPassEntryDirect',
			type: 'GET',
			dataType: 'json',
			data: {
				searchTerm,
				pageNumber: currentPage,
				pageSize: pageSize
			},
			success: function (res) {
				console.log(res);
				const docs = res.purchaseBillDirect || res.purchaseBillDirect || [];
				const totalCount = res.totalCount || 0;

				const tbody = $('#tblPurchaseBillPassEntryDirect tbody');
				tbody.empty();

				if (docs.length === 0) {
					tbody.append(`<tr><td colspan="19" class="text-center text-muted">No records found.</td></tr>`);
					renderPagination(0, pageSize, currentPage);
					return;
				}

				docs.forEach(doc => {
					tbody.append(`
						<tr>
							<td style="display:none;">${doc.code || doc.doC_CODE || ''}</td>
							<td>${doc.v_TYPE || ''}</td>
							<td>${doc.v_NO || ''}</td>
							<td>${doc.v_DATE || '0'}</td>
							<td>${doc.partY_NAME || ''}</td>
							<td>${doc.shiP_ADD1 || ''}</td>
							<td>${doc.debiT_AC || '0'}</td>
							<td>${doc.crediT_AC || ''}</td>
							<td>${doc.bilL_QTY || ''}</td>
							<td>${doc.amount || '0'}</td>
							<td>${doc.reF_TYPE || ''}</td>
							<td>${doc.reF_NO || ''}</td>
							<td>${doc.bilL_NO || '0'}</td>
							<td>${doc.bilL_DATE || ''}</td>
							<td>${doc.chalL_NO || ''}</td>
							<td>${doc.chalL_DATE || '0'}</td>
							<td>${doc.dR_FROM_TPT || '0'}</td>
							<td>${doc.remarks || '0'}</td>
							<td>${doc.status || '0'}</td>
							<td class="action-col">
							  <div class="action-wrap">
								 <button class="act-btn edit btn-edit" title="Edit Row" style="cursor:pointer;" onclick="editDocStage('${doc.v_NO}')"><i class="fa fa-edit"></i></button>
								 <button class="act-btn view btn-view" title="View Row" style="cursor:pointer;" onclick="viewDocStage('${doc.v_NO}')"><i class="fa fa-eye"></i></button>
								 <button class="act-btn delete btn-delete" title="Delete Row" style="cursor:pointer;" onclick="deleteDocStage('${doc.v_NO}')"><i class="fa fa-trash"></i></button>
								 <button class="act-btn document btn-document" title="Document Details" style="cursor:pointer;" onclick="showDocumentPopup('${doc.v_NO}')"><i class="fa fa-file"></i></button>
							  </div>
							</td>
						</tr>
					`);
				});

				renderPagination(totalCount, pageSize, currentPage);
			},
			error: function (xhr) {
				toastr.error('Error loading document stages: ' + (xhr.responseJSON?.message || xhr.statusText));
			}
		});
	}

	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const pagination = $('#tablePagination');
		pagination.empty();

		if (totalPages <= 1) return;

		let html = '';

		if (currentPage > 1) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		const startPage = Math.max(1, currentPage - 2);
		const endPage = Math.min(totalPages, currentPage + 2);

		for (let i = startPage; i <= endPage; i++) {
			html += `
				<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
		}

		if (currentPage < totalPages) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		pagination.html(html);
	}

	function goToPage(page) {
		currentPage = page;
		loadDocumentStages();
	}

	function editDocStage(docCode) {
		window.location.href = `/ApprovalStageMaster/Index?docCode=${encodeURIComponent(docCode)}`;
	}

	function viewDocStage(docCode) {
		window.location.href = `/ApprovalStageMaster/Index?docCode=${encodeURIComponent(docCode)}&readOnly=true`;
	}

	function deleteDocStage(docCode) {
		Swal.fire({
			title: 'Are you sure?',
			text: "You won't be able to revert this deletion!",
			icon: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#d33',
			cancelButtonColor: '#3085d6',
			confirmButtonText: 'Yes, delete it!'
		}).then((result) => {
			if (result.isConfirmed) {
				$.ajax({
					url: '/ApprovalStageMasterList/DeleteDocByCode',
					type: 'POST',
					data: { docCode: docCode },
					success: function (response) {
						if (response.success) {
							toastr.success(response.message || "Record deleted successfully.");
							loadDocumentStages();
						} else {
							toastr.warning("Delete failed.");
						}
					},
					error: function () {
						toastr.error("An error occurred while deleting.");
					}
				});
			}
		});
	}


</script>
