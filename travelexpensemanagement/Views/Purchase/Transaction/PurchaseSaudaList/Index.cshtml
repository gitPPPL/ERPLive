@{
    ViewBag.Title = "Purchase Sauda List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentMenu = ViewBag.CurrentMenu as string;

    bool canAdd = false;
    bool canEdit = false;
    bool canDelete = false;
    bool canPrint = false;
    bool canExport = false;
    bool canMail = false;
    bool canApproval = false;

    foreach (var permission in Model.UserMenuPermissions)
    {
        if (permission.DISPLAY_NAME == ViewBag.CurrentMenu)
        {
            canAdd = Model.UserLevel == 1 || permission._ADD == 1;
            canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
            canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
            canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
            canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
            canMail = Model.UserLevel == 1 || permission._MAIL == 1;
            canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
            break;
        }
    }
}

<!-- HEADER -->
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>Purchase Sauda List</span>
    </div>

    @if (canAdd)
    {
        <div class="erppagelist-header-right">
            <button type="button"
                    class="erppage-header-back"
                    onclick="location.href='@Url.Action("Index", "PurchaseSauda")'">
                <i class="fa fa-plus"></i> Add New
            </button>
        </div>
    }
</div>

<!-- TOOLBAR -->
<div class="erppagelist-toolbar">

    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" id="searchBox" placeholder="Search by All Columns Name...." />
    </div>

    <div class="erppagelist-actions">

        @if (canPrint)
        {
            <button class="erppagelist-btn erppagelist-btn-action" id="btnPrint">
                <i class="fa fa-print"></i> Print
            </button>
        }

        @if (canExport)
        {
            <button class="erppagelist-btn erppagelist-btn-action" id="btnExport">
                <i class="fa fa-file-excel"></i> Export
            </button>
        }

        @if (canMail)
        {
            <button class="erppagelist-btn erppagelist-btn-action" id="btnMail">
                <i class="fa fa-envelope"></i> Mail
            </button>
        }

        @if (canApproval)
        {
            <button class="erppagelist-btn erppagelist-btn-action" id="btnApprove">
                <i class="fa fa-check"></i> Approved
            </button>
        }

    </div>
</div>

<!-- TABLE -->
<div class="erppagelist-container">
    <div class="excel-wrapper fixed-grid-wrapper">

        <table id="tblPurchaseSaudaList" class="excel-table fixed-grid-table resizable-table">
            <colgroup>
                <col style="width: 100px;">  
                <col style="width: 120px;">  
                <col style="width: 200px;">  
                <col style="width: 150px;">  
                <col style="width: 200px;">  
                <col style="width: 250px;">  
                <col style="width: 120px;">  
            </colgroup>
            <thead>
                <tr>
                    <th>Serial No</th>
                    <th>Date</th>
                    <th>Customer Name</th>
                    <th>City</th>
                    <th>Item Name</th>
                    <th>Remarks</th>
                    <th class="action-col">Action</th>
                </tr>
            </thead>

            <tbody></tbody>

        </table>

    </div>


    <!-- PAGINATION -->
    <div class="erppagelist-pagination">

        <div class="pagination-left">
            <select id="pageSizeSelect" onchange="changeRowsPerPage()">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>

        <div class="pagination-center">
            <button onclick="prevPage()" class="page-nav" id="prevBtn">‹</button>
            <div id="pageNumbers" class="page-numbers"></div>
            <button onclick="nextPage()" class="page-nav" id="nextBtn">›</button>
        </div>

        <div class="pagination-right" id="pageInfoText">
            Results: 0 - 0 of 0
        </div>

    </div>
</div>

<script>

    let currentPage = 1;
    let pageSize = 10;
    let totalCount = 0;

    $(document).ready(function () {

        loadSaudaList();

        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadSaudaList();
        });

        $('#btnExport').click(function () {
            let text = $('#searchBox').val();
            window.location.href = '/PurchaseSaudaList/Export?searchTerm=' + encodeURIComponent(text);
        });

        $('#btnPrint').click(function () {
            let text = $('#searchBox').val();
            window.open('/PurchaseSaudaList/Print?searchTerm=' + encodeURIComponent(text), '_blank');
        });

    });

    // LOAD DATA
    function loadSaudaList() {

        $.ajax({
            url: '/PurchaseSaudaList/GetList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: $('#searchBox').val(),
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                console.log("Res", res);
                if (!res.success) {
                    toastr.error("Failed to load data");
                    return;
                }

                renderTable(res.lists || []);
                totalCount = res.totalCount || 0;
                renderPagination();

            },
            error: function (xhr) {
                toastr.error(xhr.responseText);
            }
        });
    }

    // TABLE
    function renderTable(list) {

        let tbody = $('#tblPurchaseSaudaList tbody');
        tbody.empty();

        if (list.length === 0) {
            tbody.append('<tr><td colspan="7" class="text-center">No data found</td></tr>');
            return;
        }

        $.each(list, function (i, item) {

            tbody.append(`
                <tr>
                    <td>${item.v_NO || ''}</td>
                    <td>${formatDate(item.v_DATE)}</td>
                    <td>${item.customerName || ''}</td>
                    <td>${item.cityName || ''}</td>
                    <td>${item.itemName || ''}</td>
                    <td>${item.remark || ''}</td>

                    <td class="action-col">

                        @if (canEdit)
                        {
                                <button class="act-btn edit" onclick="edit('${item.v_NO}')"><i class="fa fa-edit"></i></button>
                                
                        }
                        <button class="act-btn view" onclick="view('${item.v_NO}')"><i class="fa fa-eye"></i></button>
                        

                        @if (canDelete)
                        {
                            <button class="act-btn delete"
                                 onclick="deletevalidation('${item.v_NO}', '${item.v_TYPE}')">
                            <i class="fa fa-trash"></i>
                            </button>
                                
                        }
                         <button class="act-btn document" onclick="showDocumentPopup('${item.doC_ID}')"><i class="fa fa-file"></i></button>
                    </td>
                </tr>
            `);

        });
    }

    // PAGINATION
    function renderPagination() {

        const totalPages = Math.ceil(totalCount / pageSize) || 1;

        let html = '';

        for (let i = 1; i <= totalPages; i++) {
            html += `<span onclick="goToPage(${i})"
                        class="${i === currentPage ? 'active' : ''}">
                        ${i}
                     </span>`;
        }

        $('#pageNumbers').html(html);

        let start = (currentPage - 1) * pageSize + 1;
        let end = Math.min(currentPage * pageSize, totalCount);

        $('#pageInfoText').text(`Results: ${start} - ${end} of ${totalCount}`);

        $('#prevBtn').prop('disabled', currentPage === 1);
        $('#nextBtn').prop('disabled', currentPage === totalPages);
    }

    // PAGINATION ACTIONS
    function goToPage(p) {
        currentPage = p;
        loadSaudaList();
    }

    function prevPage() {
        if (currentPage > 1) {
            currentPage--;
            loadSaudaList();
        }
    }

    function nextPage() {
        currentPage++;
        loadSaudaList();
    }

    function changePageSize() {
        pageSize = parseInt($('#pageSizeSelect').val());
        currentPage = 1;
        loadSaudaList();
    }

    // ACTIONS
    function edit(id) {
        window.location.href = '/PurchaseSauda/Index?id=' + id;
    }

    function view(id) {
        window.location.href = '/PurchaseSauda/Index?id=' + id + '&mode=view';
    }

    function deletevalidation(id, v_TYPE) {
             

        $.post('/PurchaseSaudaList/Deletevalidation',
            {
                code: id,
                v_type: v_TYPE
            },
            function (res) {        
                if (!res.success) {
                    toastr.warning(res.message);
                    return;
                }       
                if (confirm(res.message + "\n\nDo you want to proceed with DELETE?")) {
                    deleteRow(id, v_TYPE);
                }
            }
        );
    }


    function deleteRow(id, v_TYPE) {
       if (!confirm("Do you want to delete this record?")) return;

         $.post('/PurchaseSaudaList/Delete',
            {
                code: id,
                v_type: v_TYPE
            },
            function (res) {
                if (res.success) {
                    toastr.success(res.message || "Deleted successfully");
                    loadSaudaList();
                } else {
                    toastr.warning(res.message);
                }
            }
        );
    }

    // UTIL
    function formatDate(dateStr) {
        if (!dateStr) return '';
        let d = new Date(dateStr);
        if (isNaN(d)) return '';
        return d.toISOString().split('T')[0];
    }

   function showDocumentPopup(docCode) {
    
        $.ajax({
            url: '/PurchaseSaudaList/DocDetailsCode',
            type: 'POST',
            dataType: 'json',
            data: { docCode: docCode },
            success: function (response) {
                if (response.success) {
                    showDocumentPopupjQuery(response.data, docCode);
                } else {
                    toastr.error("Failed to get document details.");
                }
            },
            error: function () {
                toastr.error("Error fetching document details.");
            }
        });
    }

</script>