@{
	ViewBag.Title = "Purchase Sauda List";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<fieldset>
	<legend class="legend-field">Purchase Sauda List</legend>

	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control border-0" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>


		<div class="col-lg-6">
			<div class="btn-rightalign">
			<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "PurchaseSauda")'" type="submit" class="btn btn-add">
				<i class="fa fa-plus"></i>Add
			</button>
			<button class="btn btn-print" onclick="printCityMasterReport()">
				<i class="fa fa-print"></i> Print
			</button>
			<button class="btn btn-export">
				<i class="fas fa-file-export"></i> Export
			</button>
			<button class="btn btn-mail">
				<i class="fa fa-envelope"></i> Mail
			</button>
			@* <button class="btn btn-approved">
				<i class="fa fa-paper-plane"></i> Approval Send
			</button> *@
			<button class="btn btn-approved">
				<i class="fa fa-check"></i> Approved
			</button>
			</div>
		</div>
	</div>



	<div class="card">
		<div class="table-responsive">
			<table id="tblPurchaseQuotationList" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>Serial No</th>
						<th>Date</th>
						<th>Customer Name</th>
						<th>City</th>
						<th>Item Name</th>
						<th>Remarks</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
	</div>



</fieldset>

<script>

	let currentPage = 1;
	let pageSize = 10;

	$(document).ready(function () {
		loadAllMenus();
	});

	function loadAllMenus() {
			const searchTerm = $('#searchBox').val();
			$.ajax({
				url: '/PurchaseSaudaList/GetList',
				type: 'GET',
				dataType: 'json',
				data: {
					searchTerm: searchTerm,
					pageNumber: currentPage,
					pageSize: pageSize
				},
				success: function (res) {
					if (!res.success) {
						toastr.error("Failed to load data.");
						return;
					}

					const list = res.lists;
					const totalCount = res.totalCount;
					let tbody = $('#tblPurchaseQuotationList tbody');
					tbody.empty();

					if (list.length === 0) {
						tbody.append('<tr><td colspan="11" class="text-center text-muted">No list found.</td></tr>');
					} else {
						$.each(list, function (index, item) {
							tbody.append(`
								<tr>
								<td>${item.v_NO}</td>
								<td>${formatDate(item.v_DATE)}</td>
								<td>${item.customerName}</td>
								<td>${item.cityName}</td>
								<td>${item.itemName}</td>
								<td>${item.remark}</td>
															
									<td>
										<i class="fas fa-edit btn-edit" title="Edit" onclick="AddOrEditFunction('${item.v_NO}')"></i>
										<i class="fa fa-eye btn-view" title="View Detail" onclick="viewMenuDetails('${item.v_NO}')"></i>
										<i class="fa fa-trash text-danger btn-delete" title="Delete" onclick="deleteTemp('${item.v_NO}')"></i>
									</td>
								</tr>
							`);
						});
						renderPagination(totalCount, pageSize, currentPage);
					}
				},
				error: function (xhr) {
					toastr.error('Error loading menu list: ' + xhr.responseText);
				}
			});
		}

    function formatDate(dateStr) {
				if (!dateStr) return '';
				const d = new Date(dateStr);
				if (isNaN(d)) return '';
				return d.toISOString().slice(0, 10);
			}

	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const pagination = $('#tablePagination');
		pagination.empty();

		if (totalPages <= 1) return;

		let html = '';

		if (currentPage > 1) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		const startPage = Math.max(1, currentPage - 2);
		const endPage = Math.min(totalPages, currentPage + 2);

		for (let i = startPage; i <= endPage; i++) {
			html += `
				<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
		}

		if (currentPage < totalPages) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		pagination.html(html);
	}

	function goToPage(page) {
		currentPage = page;
	loadAllMenus();
	}

	$('#searchBox').on('keyup', function () {
		currentPage = 1;
		loadAllMenus();
	});

	function AddOrEditFunction(code) {
	
		window.location.href = '/PurchaseSauda/Index?id=' + encodeURIComponent(code);
	}

	function viewMenuDetails(code) {
		window.location.href = '/PurchaseSauda/Index?id=' + encodeURIComponent(code) + '&mode=view';
	}

	function deleteTemp(code) {
		if (!confirm('Are you sure you want to delete this Purchase Request?')) return;

		$.ajax({
			url: '/PurchaseSaudaList/Delete',
			type: 'POST',
			data: { code: code },
			success: function (res) {
				if (res.success) {
					toastr.success('Deleted successfully.');
					loadAllMenus();
				} else {
					toastr.error(res.message || 'Failed to delete.');
				}
			},
			error: function () {
				toastr.error('Error deleting Purchase Sauda .');
			}
		});
	}

</script>
