@{
ViewBag.Title = "Import Tracking Report";
Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
.tracking-updated-row,
.tracking-updated-row td:not(.action-col) {
background-color: #cdf9da !important;
}
#tbldocumentsendlist tbody tr.row-sent td {
background-color: #fff4cc !important; /* soft amber: sent, awaiting receipt */
}
#tbldocumentsendlist tbody tr.row-received td {
background-color: #d9f2e3 !important; /* soft mint: received */
}
</style>

<div id="erp-toast-container"></div>
<div class="erppagelist-header">
<div class="erppagelist-title">
<i class="fa fa-ship"></i>
<span>Import Tracking Report</span>
</div>
</div>
