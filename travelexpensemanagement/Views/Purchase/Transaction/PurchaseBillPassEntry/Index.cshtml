                                            <th>Remarks</th>
                                            <th>Reqtype</th>
                                            <th>Reqno</th>
                                            <th>Reftype</th>
                                            <th>Refno</th>
                                            <th>Deptcode</th>
                                            <th>Makecode</th>
                                            <th>Ucode</th>
                                            <th>Taxcode</th>
                                            <th style="display:none;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
