@{
    ViewBag.Title = "Purchase Bill Pass Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<fieldset>
    <legend class="legend-field">Purchase Bill Pass Entry</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="window.location.href='@Url.Action("Index", "PurchaseBillPassEntryList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div> 
    </div>
    <form id="PurchaseBillPassEntryForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group"> 
                    <label for="ddlDocType">Doc Type</label>
                    <select class="form-control" id="ddlDocType"> 
                        <option>--Select DOC Type--</option> 
                    </select> 
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DtDocDate">Doc Date</label>
                    <input type="date" class="form-control" id="DtDocDate" placeholder="Enter Doc Date">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumDocNo">Doc No</label>
                    <input type="number" class="form-control" id="NumDocNo" placeholder="Enter Doc No">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtMRNNo">MRN No</label>
                    <div class="input-divide">
                        <input type="text" class="form-control" id="TxtMRNNo1">
                        <input type="text" class="form-control" id="TxtMRNNo2">
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Party Details</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ddlBillFrom">Bill From</label>
                                <select class="form-control" id="ddlBillFrom">
                                    <option>Select Bill From</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="TxtAdd1PD">Add Line1</label>
                                @* <input type="text" class="form-control" id="TxtAdd1PD" placeholder="Enter Address Line 1"> *@
                                <select class="form-control" id="TxtAdd1PD">
                                    <option>Select Billing Address</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="TxtAdd2PD">Add Line2</label>
                                <input type="text" class="form-control" id="TxtAdd2PD" placeholder="Enter Address Line 2">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="TxtAdd3PD">Add Line3</label>
                                <input type="text" class="form-control" id="TxtAdd3PD" placeholder="Enter Address Line 3">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlCity">City</label>
                                <select class="form-control" id="ddlCityPD">
                                    <option value="">Select City</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtGSTNo">GST No</label>
                                <input type="text" class="form-control" id="TxtGSTNo" placeholder="Enter GST No">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtDispFromAdd">Disp From Address</label>
                                <input type="text" class="form-control" id="TxtDispFromAdd" placeholder="Enter Dispatch Address">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlDispCity">Disp City</label>
                                <select class="form-control" id="ddlDispCity">
                                    <option value="">Select Dispatch City</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Shipping Details</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ddlShipFrom">Ship from</label>
                                <div class="input-divide">
                                    <select class="form-control" id="ddlShipFrom1">
                                        <option value="">Select Ship from</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ddlShipFromAddress">Ship from address</label>
                                <select class="form-control" id="ddlShipFromAddress">
                                    <option>Select Shipping Address</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="TxtAdd1SF">Add Line1</label>
                                <input type="text" class="form-control" id="TxtAdd1SF" placeholder="Enter Address Line 1">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="TxtAdd2SF">Add Line2</label>
                                <input type="text" class="form-control" id="TxtAdd2SF" placeholder="Enter Address Line 2">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="TxtAdd3SF">Add Line3</label>
                                <input type="text" class="form-control" id="TxtAdd3SF" placeholder="Enter Address Line 3">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtGSTNoSF">GST No</label>
                                <input type="text" class="form-control" id="TxtGSTNoSF" placeholder="Enter GST Number">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlCitySF">City</label>
                                <select class="form-control" id="ddlCitySF">
                                    <option>Select City</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Document Details</legend>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtBillNo">Bill No</label>
                                <input type="text" class="form-control" id="TxtBillNo" placeholder="Enter Bill No">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtBillDate">Bill Date</label>
                                <input type="date" class="form-control" id="DtBillDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtChallanNo">Challan No</label>
                                <input type="text" class="form-control" id="TxtChallanNo" placeholder="Enter Challan No">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtChDate">Ch Date</label>
                                <input type="date" class="form-control" id="DtChDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtWaybillNo">Waybill No</label>
                                <input type="text" class="form-control" id="TxtWaybillNo" placeholder="Enter Waybill No">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlTransitNo">Transit No</label>
                                <select class="form-control" id="ddlTransitNo">
                                    <option>Select Transit No</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtWaybillDate">Waybill Date</label>
                                <input type="date" class="form-control" id="DtWaybillDate">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtWayBillInvNo">WayBill InvNo</label>
                                <input type="text" class="form-control" id="TxtWayBillInvNo" placeholder="Enter WayBill InvNo">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtWaybillExpiry">Waybill Expiry</label>
                                <input type="date" class="form-control" id="DtWaybillExpiry">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="NumExRate">Ex-Rate(Rs/USD)</label>
                                <input type="number" class="form-control" id="NumExRate" placeholder="Enter Ex-Rate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlInputType">Input Type</label>
                                <select class="form-control" id="ddlInputType">
                                    <option>--Select Input Type--</option>
                                    <option value="Central">Central</option>
                                    <option value="GST Input">GST Input</option>
                                    <option value="GST NA">GST NA</option>
                                    <option value="Import">Import</option>
                                    <option value="Input Capital">Input Capital</option>
                                    <option value="Input GST">Input GST</option>
                                    <option value="Input NA">Input NA</option>
                                    <option value="Input VAT">Input VAT</option>
                                    <option value="Local">Local</option>
                                    <option value="RCM">RCM</option>
                                    <option value="Exempt">Exempt</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="ddlDebitAC">Debit A/c</label>
                    <select class="form-control" id="ddlDebitAC">
                        <option>Select Debit A/C</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="ddlCreditAC">Credit A/c</label>
                    <select class="form-control" id="ddlCreditAC">
                        <option>Select Credit Account</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="txtRemarks">Remarks</label>
                    <textarea type="text" class="form-control" id="txtRemarks" placeholder="Enter Remarks"></textarea>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="offset-md-6 col-md-6">
                <div class="button-right">
                    <div class="dropdown">
                        <button class="btn btn-primary dropdown-toggle" type="button" id="copyFromDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-copy"></i> <span id="dropdownText">Copy From</span>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="copyFromDropdown">
                            <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#purchaseorderModal">Purchase Order</a></li>
                            <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#RMPurchaseModal">RM Purchase (Indian)</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <!-- Net Amount -->
            <div class="col-md-2">
                <div class="form-group">
                    <label for="TxtNetAmount">Net Amount</label>
                    <input type="text" class="form-control" id="TxtNetAmount" placeholder="Enter Amount">
                </div>
            </div>
            <!-- Status Dropdown -->
            <div class="col-md-2">
                <div class="form-group">
                    <label for="ddlStatus">Status</label>
                    <select class="form-control" id="ddlStatus">
                        <option value="open" selected>Open</option>
                        <option value="closed">Closed</option>
                        <option value="pending">Pending</option>
                    </select>
                </div>
            </div>
            <!-- Buttons -->
            <div class="col-md-8">
                <div class="btn-mt button-right">
                    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#costallocationModal">
                        <i class="fa fa-project-diagram"></i> Cost Allocation
                    </button>
                    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#pendingapprovalModal">
                        <i class="fa fa-tasks"></i> List of Pending Approval
                    </button>
                    <button class="btn btn-primary" type="button">
                        <i class="fa fa-print"></i> Pending MRN for Bill Passing
                    </button>
                    <button class="btn btn-primary" type="button">
                        <i class="fa fa-print"></i> RM Import Bill
                    </button>
                </div>
            </div>
        </div>
        <!--Cost Allocation Modal-->
        <div class="modal fade" id="costallocationModal" tabindex="-1" aria-labelledby="costallocationLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content draggable-modal">
                    <div class="popup-header">
                        <h5 class="popup-title" id="costallocationLabel">Cost Allocation</h5>
                        <i class="fa fa-times" data-bs-dismiss="modal" style="cursor: pointer;" aria-label="Close"></i>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label for="PartyName">Party Name</label>
                                    <input type="text" class="form-control" id="TxtPartyNameCA" placeholder="Enter Party Name">
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="btn-rightalign">
                                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><i class="fa fa-edit"></i>Edit</button>
                                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><i class="fa fa-copy"></i>Copy</button>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="RefVno">Ref. Vno</label>
                                    <input type="number" class="form-control" id="NumRefVno" placeholder="Enter Ref. VNo">
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="form-group">
                                    <label for="TotalAmtAllocated">Total Amt. to be allocated</label>
                                    <input type="text" class="form-control" id="TxtTotalAmtAllocated" placeholder="Enter Total Amt. to be allocated">
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="SrNo">Sr. No</label>
                                    <input type="number" class="form-control" id="NumSrNo" placeholder="Enter Sr. No">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="SrDate">Sr. Date</label>
                                    <input type="date" class="form-control" id="DtSrDate">
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="BalAmount">Bal. Amount</label>
                                    <input type="number" class="form-control" id="NumBalAmount" placeholder="Enter Bal Amount">
                                </div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="table-responsive">
                                <table id="tblpurchaseallocationmodal" class="table-width">
                                    <thead class="table-head">
                                        <tr>
                                            <th style="display:none;"><input type="checkbox" id="selectAllPR" /></th>
                                            <th>Cost Center</th>
                                            <th>Allocated Amt</th>
                                            <th>Narration</th>
                                            <th style="display:none;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="btn-add-row-last">
                                        <i class="fa fa-plus btn-add-row" title="Add Row"><span>Add New Row</span></i>
                                    </div>
                                    <div class="pagination-end">
                                        <div class="custom-pagination" id="tablePagination"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--Pending Approval Modal-->
        <div class="modal fade" id="pendingapprovalModal" tabindex="-1" aria-labelledby="pendingapprovalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content draggable-modal">
                    <div class="popup-header">
                        <h5 class="popup-title" id="pendingapprovalLabel">List of Unapproved Purchase Bill</h5>
                        <i class="fa fa-times" data-bs-dismiss="modal" style="cursor: pointer;" aria-label="Close"></i>
