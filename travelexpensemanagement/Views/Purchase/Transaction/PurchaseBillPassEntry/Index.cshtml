                                </div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="table-responsive">
                                <table id="tblpurchaseordermodal" class="table-width">
                                    <thead class="table-head">
                                        <tr>
                                            <th><input type="checkbox" id="selectAllPR" /></th>
                                            <th>Pono</th>
                                            <th>Potype</th>
                                            <th>Vdate</th>
                                            <th>Item Code</th>
