@{
	ViewBag.Title = "Purchase Receipt Entry List";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-center-toast-container"></div>
<!-- HEADER -->
<div class="erppagelist-header">
	<div class="erppagelist-title">
		<i class="fa fa-list"></i>
		<span>Purchase Receipt Entry List</span>
	</div>
	<div class="erppagelist-header-right">

		<button type="button" class="erppage-header-back" id="button_add" onclick="location.href='@Url.Action("Index", "PurchaseReceiptEntry")'">
			<i class="fa fa-plus"></i>Add New
		</button>

	</div>
</div>

<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
	<div class="erppagelist-search-wrapper">
		<i class="fa fa-search"></i>
		<input type="text" id="searchBox" placeholder="Search by All Columns Name...." />
	</div>
	<div class="erppagelist-actions">

		@* <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" id="button_print" onclick="PendingQCReport()">
				<i class="fa fa-print"></i>Print
		</button> *@

		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" id="button_export" data-tooltip="Export to Excel">
			<i class="fa fa-file-excel"></i>Export
		</button>

	</div>
</div>

<div class="erppagelist-container">
	<div class="excel-wrapper fixed-grid-wrapper">
		<table id="tblPurchaseReceiptEntryList" class="excel-table fixed-grid-table table-width resizable-table">
			<colgroup>
				<col class="hidden-col">
				<col style="width: 73px;">
				<col style="width: 82px;">
				<col style="width: 80px;">
				<col style="width: 220px;">
				<col style="width: 130px;">
				<col style="width: 79px;">
				<col style="width: 198px;">
				<col style="width: 205px;">
				<col style="width: 85px;">
				<col style="width: 131px;">
				<col style="width: 220px;">
				<col style="width: 67px;">
				<col style="width: 66px;">
				<col style="width: 76px;">
				<col style="width: 114px;">
				<col style="width: 113px;">
				<col style="width: 67px;">
				<col style="width: 120px;">
			</colgroup>
			<thead>
				<tr>
					<th class="hidden-col">Code</th>
					<th>Doc Type</th>
					<th>Doc No</th>
					<th>Doc Date</th>
					<th>Party Name</th>
					<th>Bill Number</th>
					<th>Bill Date</th>
					<th>Bill Address 1</th>
					<th>Bill Address 2</th>
					<th>Bill City</th>
					<th>Bill Gst</th>
					<th>Ship To</th>
					<th>Quantity</th>
					<th>Amount</th>
					<th>Remarks</th>
					<th>Transport Name</th>
					<th>Gate Number</th>
					<th>Status</th>
					<th class="action-col">Action</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>

	<div class="erppagelist-pagination">
		<div class="pagination-left">
			<select id="pageSizeSelect" onchange="changeRowsPerPage()">
				<option value="5">5</option>
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
			</select>
		</div>
		<div class="pagination-center">
			<button onclick="prevPage()" class="page-nav" id="prevBtn">‹</button>
			<div id="pageNumbers" class="page-numbers"></div>

			<button onclick="nextPage()" class="page-nav" id="nextBtn">›</button>
		</div>
		<div class="pagination-right" id="pageInfoText">
			Results: 0 - 0 of 0
		</div>
	</div>
</div>

<script src="~/common/pagination.js"></script>
<script src="~/js/erpjs/purchase/transaction/purchasereceiptmrnlistjs/purchasereceiptmrnlist.js"></script>

