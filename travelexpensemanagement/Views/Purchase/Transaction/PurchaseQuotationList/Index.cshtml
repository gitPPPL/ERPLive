@{
	ViewBag.Title = "Purchase Quotation List";
	Layout = "~/Views/Shared/_Layout.cshtml";

	var currentMenu = ViewBag.CurrentMenu as string;
	bool canAdd = false;
	bool canEdit = false;
	bool canDelete = false;
	bool canPrint = false;
	bool canExport = false;
	bool canMail = false;
	bool canApproval = false;
	bool canDocDetail = false;

	foreach (var permission in Model.UserMenuPermissions)
	{
		if (permission.MENU_NAME == ViewBag.CurrentMenu)
		{
			canAdd = Model.UserLevel == 1 || permission._ADD == 1;
			canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
			canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
			canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
			canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
			canMail = Model.UserLevel == 1 || permission._MAIL == 1;
			canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
			canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
			break;
		}
	}

}
<div id="erp-toast-container"></div>
<div class="erppagelist-header">
	<div class="erppagelist-title">
		<i class="fa fa-list"></i>
		<span>Purchase Quotation List</span>
	</div>
	<div class="erppagelist-header-right">
		@if (canAdd)
		{
			<button class="erppage-header-back" onclick="window.location.href='@Url.Action("Index", "PurchaseQuotation")'">
				<i class="fa fa-plus"></i>Add New
			</button>
		}
	</div>
</div>
<div class="erppagelist-toolbar">
	<div class="erppagelist-search-wrapper">
		<i class="fa fa-search"></i>
		<input type="text" id="searchBox" placeholder="Search Module..." />
	</div>
	<div class="erppagelist-actions">
		@if (canPrint)
		{
			<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" onclick="printCityMasterReport()">
				<i class="fa fa-print"></i> Print
			</button>
			<button class="btn btn-export">
				<i class="fas fa-file-export"></i> Export 
			</button>  
			<button class="btn btn-mail">
				<i class="fa fa-envelope"></i> Mail 
			</button>
		}
	</div>
</div>
<div class="erppagelist-container">
	<div class="excel-wrapper fixed-grid-wrapper">
		<table id="tblPurchaseQuotationList" class="excel-table fixed-grid-table table-width resizable-table">
			<colgroup>
				<col style="display:none;">      <!-- Code -->
				<col style="width: 77px;">       <!-- Doc No -->
				<col style="width: 70px;">       <!-- Doc Type -->
				<col style="width: 76px;">       <!-- Doc Date -->
				<col style="width: 213px;">       <!-- Party Name -->
				<col style="width: 75px;">       <!-- Quote No -->
				<col style="width: 83px;">       <!-- Quote Date -->
				<col style="width: 209px;">       <!-- Contact Person -->
				<col style="width: 74px;">       <!-- Valid Date -->
				<col style="width: 108px;">       <!-- Remarks -->
				<col style="width: 53px;">       <!-- Status -->
				<col style="width:100px;">       <!-- Action -->
			</colgroup>
			<thead>
				<tr>
					<th style="display:none;">Code</th>
					<th>Doc No</th>
					<th>Doc Type</th>
					<th>Doc date</th>
					<th>Party Name</th>
					<th>Quote No</th>
					<th>Quote Date</th>
					<th>Contact Person</th>
					<th>Valid Date</th>
					<th>Remarks</th>
					<th>Status</th>
					<th class="action-col">Action</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>
	<div class="erppagelist-pagination">
		<div class="pagination-left">
			<select id="pageSizeSelect">
				<option value="5">5</option>
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
			</select>
		</div>
		<div class="pagination-center">
			<button class="page-nav" id="prevBtn">‹</button>
			<div id="tablePagination" class="page-numbers"></div>
			<button class="page-nav" id="nextBtn">›</button>
		</div>
		<div class="pagination-right" id="pageInfoText">
			Results: 0 - 0 of 0
		</div>
	</div>
</div>

<script src="~/common/pagination.js"></script>
<script src="~/js/erpjs/purchase/transaction/purchasequotationlistjs/purchasequotationlist.js"></script>

<script>
	window.permissions = {
		canEdit: @canEdit.ToString().ToLower(),
		canDelete: @canDelete.ToString().ToLower(),
		canDocDetail: @canDocDetail.ToString().ToLower()
	};

	var compCode = '@ViewBag.CompCode';
	var branchCode = '@ViewBag.BranchCode';
	var yearCode = '@ViewBag.YearCode';


	let currentPage = 1;
	const pageSize = 10;

	$(document).ready(function () {
		loadAllQuotations();
	});

	function loadAllQuotations() {
		const searchTerm = $('#tableSearch').val();

		$.ajax({
			url: '/PurchaseQuotationList/GetAllQuotations', // 👈 Update with actual endpoint
			type: 'GET',
			dataType: 'json',
			data: {
				searchTerm: searchTerm,
				pageNumber: currentPage,
				pageSize: pageSize
			},
			success: function (res) {
				console.log(res);
				const quotations = res.quotations || [];
				const totalCount = res.totalCount || 0;

				let tbody = $('#tblPurchaseQuotationList tbody');
				tbody.empty();

				if (quotations.length === 0) {
					tbody.append('<tr><td colspan="13" class="text-center text-muted">No quotations found.</td></tr>');
					renderPagination(0, pageSize, currentPage);
					return;
				}

				$.each(quotations, function (index, item) {
					tbody.append(`
						<tr>
							<td style="display:none;">${item.code}</td>
							<td>${item.v_NO || ''}</td>
							<td>${item.v_TYPE || ''}</td>
							<td>${item.v_DATE || ''}</td>
							<td>${item.partY_NAME || ''}</td>
							<td>${item.quotE_NO || ''}</td>
							<td>${item.quotE_DATE || ''}</td>
							<td>${item.conT_PERSON || ''}</td>
							<td>${item.valiD_DATE || ''}</td>
							<td>${item.remarks || ''}</td>
							<td>${item.statuS_NAME || ''}</td>
							<td>
								<i class="fa fa-edit btn-edit" title="Edit" onclick="editQuotation(${item.v_NO})"></i>
								<i class="fa fa-eye btn-view" title="View" onclick="viewQuotation(${item.v_NO})"></i>
								<i class="fa fa-trash btn-delete" title="Delete" onclick="deleteQuotation(${item.v_NO}, '${item.v_TYPE}')"></i>
							</td>
						</tr>
					`);
				});

				renderPagination(totalCount, pageSize, currentPage);
			},
			error: function (xhr) {
				toastr.error('Error loading quotations: ' + xhr.responseText);
			}
		});
	}

	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const paginationContainer = $('#tablePagination');
		paginationContainer.empty();

		if (totalPages <= 1) return;

		let html = '';

		if (currentPage > 1) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		let startPage = Math.max(1, currentPage - 2);
		let endPage = Math.min(totalPages, currentPage + 2);

		if (currentPage <= 3) endPage = Math.min(5, totalPages);
		if (currentPage >= totalPages - 2) startPage = Math.max(totalPages - 4, 1);

		for (let i = startPage; i <= endPage; i++) {
			html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
		}

		if (currentPage < totalPages) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		paginationContainer.html(html);
	}

	function goToPage(page) {
		currentPage = page;
		loadAllQuotations();
	}

	$('#tableSearch').on('keyup', function () {
		currentPage = 1;
		loadAllQuotations();
	});

	function editQuotation(id) {
		window.location.href = '/PurchaseQuotation/Index?id=' + encodeURIComponent(id);
	}

	function viewQuotation(id) {
		window.location.href = '/PurchaseQuotation/Index?id=' + encodeURIComponent(id) + '&readOnly=true';
	}

	function deleteQuotation(code,vType) {
		Swal.fire({
			title: 'Are you sure?',
			text: "This will permanently delete the quotation.",
			icon: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#d33',
			cancelButtonColor: '#3085d6',
			confirmButtonText: 'Yes, delete it!',
			cancelButtonText: 'Cancel'
		}).then((result) => {
			if (result.isConfirmed) {
				$.ajax({
					url: '/PurchaseQuotation/DeletePurchaseQuotationByCode', 
					type: 'POST',
					data: {
						code: code,
						vType: vType,
						compCode: compCode,
						branchCode: branchCode,
						yearCode: yearCode
					},					
					success: function (response) {
						if (response.success) {
							Swal.fire('Deleted!', response.message, 'success').then(() => {
								loadAllQuotations();
							});
						} else {
							Swal.fire('Failed', response.message, 'warning');
						}
					},
					error: function () {
						Swal.fire('Error!', 'An error occurred while deleting.', 'error');
					}
				});
			}
		});
	}


</script>
