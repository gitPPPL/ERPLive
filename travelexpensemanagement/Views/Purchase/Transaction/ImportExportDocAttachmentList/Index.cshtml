@{
    ViewBag.Title = "Import Export Doc Attachment List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-paperclip"></i>
        <span>Import Export Doc Attachment List</span>
    </div>
</div>
<div class="erppage-fieldset">
    <div class="erppage-container">
        <div class="erppage-grid5">
            <div class="erppage-divfield">
                <label class="erppage-label">Type</label>
                <select class="erppage-input erppage-select" id="ddltype">
                    <option value="Import">Import</option>
                    <option value="Export">Export</option>
                </select>
            </div>
        </div>
        <fieldset class="erppagefieldset">
            <div class="erppage-grid5">
                <div class="erppage-divfield">
                    <label class="erppage-label">From</label>
                    <input type="date" class="erppage-input" id="Dtfrom" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">To</label>
                    <input type="date" class="erppage-input" id="Dtto" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Party Name</label>
                    <select class="erppage-input erppage-select" id="ddlpartyname">
                        <option value="">Select Party Name</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Location</label>
                    <select class="erppage-input erppage-select" id="ddllocation">
                        <option value="">Select Location</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <div class="erppage-checkbox-wrap">
                        <input type="checkbox" id="ChkSelectAll" class="erppage-checkbox-input">
                        <label class="erppage-checkbox-label">Select All</label>
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="erppage-internalaction mt-2">
            <button type="button" id="btnviewdata" class="erppage-btn erppage-btn-common-active-disabled">
                <i class="fa fa-eye"></i>
                <span>View Data</span>
            </button>
            <button type="button" id="btnexportsave" class="erppage-btn erppage-btn-common">
                <i class="fa fa-download"></i>
                <span>Export & Save</span>
            </button>
        </div>


        <div class="erppagelist-container">
            <div class="excel-wrapper fixed-grid-wrapper">
                <table id="tblImportExportDocAttachmentList" class="excel-table fixed-grid-table table-width resizable-table">
                    <colgroup>
                        <col class="hidden-col">             
                        <col style="width:100px;">           <!-- Sauda No -->
                        <col style="width:110px;">           <!-- Sauda Date -->
                        <col style="width:100px;">           <!-- Inv No -->
                        <col style="width:110px;">           <!-- Inv Date -->
                        <col style="width:120px;">           <!-- B E No. -->
                        <col style="width:100px;">           <!-- Exim No -->
                        <col style="width:110px;">           <!-- Exim Date -->
                        <col style="width:220px;">           <!-- Party Name -->
                        <col style="width:100px;">           <!-- Party Code -->
                        <col style="width:60px;">            <!-- Chk -->
                        <col style="width:90px;">            <!-- P I Copy -->
                        <col style="width:90px;">            <!-- B L Copy -->
                        <col style="width:90px;">            <!-- B E Copy -->
                        <col style="width:90px;">            <!-- L C Copy -->
                        <col style="width:90px;">            <!-- INV Copy -->
                        <col style="width:90px;">            <!-- D P Copy -->
                        <col style="width:90px;">            <!-- SBLC Copy -->
                        <col style="width:90px;">            <!-- Oth Copy1 -->
                        <col style="width:90px;">            <!-- Oth Copy2 -->
                        <col style="width:90px;">            <!-- Oth Copy3 -->
                        <col style="width:90px;">            <!-- Oth Copy4 -->
                        <col style="width:90px;">            <!-- Oth Copy5 -->
                        <col style="width:90px;">            <!-- Oth Copy6 -->
                        <col style="width:90px;">            <!-- Oth Copy7 -->
                    </colgroup>

                    <thead>
                        <tr>
                            <th class="hidden-col">Code</th>   <!-- Column 0 -->
                            <th>Sauda No</th>                  <!-- Column 1 -->
                            <th>Sauda Date</th>                <!-- Column 2 -->
                            <th>Inv No</th>                    <!-- Column 3 -->
                            <th>Inv Date</th>                  <!-- Column 4 -->
                            <th>B E No.</th>                   <!-- Column 5 -->
                            <th>Exim No</th>                   <!-- Column 6 -->
                            <th>Exim Date</th>                 <!-- Column 7 -->
                            <th>Party Name</th>                <!-- Column 8 -->
                            <th>Party Code</th>                <!-- Column 9 -->
                            <th>Chk</th>                       <!-- Column 10 -->
                            <th>P I Copy</th>                  <!-- Column 11 -->
                            <th>B L Copy</th>                  <!-- Column 12 -->
                            <th>B E Copy</th>                  <!-- Column 13 -->
                            <th>L C Copy</th>                  <!-- Column 14 -->
                            <th>INV Copy</th>                  <!-- Column 15 -->
                            <th>D P Copy</th>                  <!-- Column 16 -->
                            <th>SBLC Copy</th>                 <!-- Column 17 -->
                            <th>Oth Copy1</th>                 <!-- Column 18 -->
                            <th>Oth Copy2</th>                 <!-- Column 19 -->
                            <th>Oth Copy3</th>                 <!-- Column 20 -->
                            <th>Oth Copy4</th>                 <!-- Column 21 -->
                            <th>Oth Copy5</th>                 <!-- Column 22 -->
                            <th>Oth Copy6</th>                 <!-- Column 22 -->
                            <th>Oth Copy7</th>                 <!-- Column 22 -->
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<script src="~/js/erpjs/purchase/transaction/importexportdocattachmentlist/importexportdocattachmentlistapi.js"></script>
<script src="~/js/erpjs/purchase/transaction/importexportdocattachmentlist/importexportdocattachmentlistinit.js"></script>