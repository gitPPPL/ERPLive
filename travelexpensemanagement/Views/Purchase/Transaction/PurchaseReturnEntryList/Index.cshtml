@{
	ViewBag.Title = "Purchase Return Entry List";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<fieldset>
	<legend class="legend-field">Purchase Return Entry List</legend>

	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>
		 
		<div class="col-lg-6">
			<div class="btn-rightalign">
				<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "PurchaseReturnEntry")'" type="button" class="btn btn-add">
					<i class="fa fa-plus"></i>Add
				</button>
				<button class="btn btn-print" onclick="printCityMasterReport()">
					<i class="fa fa-print"></i> Print
				</button>
				<button class="btn btn-export">
					<i class="fas fa-file-export"></i> Export
				</button>
				<button class="btn btn-mail">
					<i class="fa fa-envelope"></i> Mail
				</button>
				<button class="btn btn-approved">
					<i class="fa fa-check"></i> Approved
				</button>
			</div>
		</div>
	</div>

	<div class="card">
		<div class="table-responsive">
			<table id="tblPurchaseReturnEntryList" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>Voucher No</th>
						<th>Voucher Type</th>
						<th>Voucher Date</th>
						<th>Party Name</th>
						<th>Bill Number</th>
						<th>Bill Date</th>
						<th>Bill Address 1</th>
						<th>Bill Address 2</th>
						<th>Bill City</th>
						<th>Bill Gst</th>
						<th>Ship To</th>
						<th>Quantity</th>
						<th>Amount</th>
						<th>Remarks</th>
						<th>Transport Name</th>
						<th>Gate No</th>
						<th>Status</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
	</div>
</fieldset>

<script>
	let currentPage = 1;
	const pageSize = 10;
	$(document).ready(function () {
		loadPurchaseReceiptEntryList();
		$('#searchBox').on('keyup', function () {
			currentPage = 1;
			loadPurchaseReceiptEntryList();
		});
	});
	function loadPurchaseReceiptEntryList() {
		const searchTerm = $('#searchBox').val();
		$.ajax({
			url: '/PurchaseReturnEntryList/GetPurchaseReceiptEntryList',
			type: 'GET',
			dataType: 'json',
			data: {
				searchTerm,
				pageNumber: currentPage,
				pageSize: pageSize
			},
			success: function (res) {
				console.log('res',res)
				const docs = res.items || [];
				const totalCount = res.totalCount || 0;
				const tbody = $('#tblPurchaseReturnEntryList tbody');
				tbody.empty();

				if (docs.length === 0) {
					tbody.append(`<tr><td colspan="18" class="text-center text-muted">No records found.</td></tr>`);
					renderPagination(0, pageSize, currentPage);
					return;
				}
				docs.forEach(doc => {
					tbody.append(`
						<tr>
							<td>${doc.vNo || ''}</td>
							<td>${doc.vType || ''}</td>
							<td>${doc.vDate || ''}</td>
							<td>${doc.partyName || ''}</td>
							<td>${doc.billNo || ''}</td>
							<td>${doc.billDate || ''}</td>
							<td>${doc.billAdd1 || ''}</td>
							<td>${doc.billAdd2 || ''}</td>
							<td>${doc.billCity || ''}</td>
							<td>${doc.billGST || ''}</td>
							<td>${doc.shipTo && typeof doc.shipTo === 'object' ? (doc.shipTo.Name || '') : (doc.shipTo || '')}</td>
							<td>${doc.qty || ''}</td>
							<td>${doc.amount}</td>
							<td>${doc.remarks && typeof doc.remarks === 'object' ? (doc.remarks.Text || '') : (doc.remarks || '')}</td>
							<td>${typeof doc.transportName === 'object' ? (doc.transportName.Name || '') : (doc.transportName || '')}</td>
							<td>${doc.gateNo || ''}</td>
							<td>${doc.status || ''}</td>
							<td>
								<div class="action-icons">
									<i class="fa fa-edit btn-edit" data-bs-toggle="tooltip" title="Edit" onclick="editDocStage('${doc.vType}', '${doc.vNo}')"></i>
									<i class="fas fa-eye btn-view" data-bs-toggle="tooltip" title="View" onclick="viewDocStage('${doc.vNo}')"></i>
									<i class="fas fa-trash btn-delete" data-bs-toggle="tooltip" title="Delete" onclick="deleteDocStage('${doc.vNo}')"></i>
									<i class="fa fa-file btn-document" data-bs-toggle="tooltip" title="Document Details" onclick="showDocumentPopup('${doc.vNo}')"></i>
								</div>
					</td>
						</tr>
					`);
				});

				renderPagination(totalCount, pageSize, currentPage);
			},
			error: function () {
				alert('Error fetching data');
			}
		});
	}
	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const pagination = $('#tablePagination');
		pagination.empty();
		if (totalPages <= 1) return;
		let html = '';
		if (currentPage > 1) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}
		const startPage = Math.max(1, currentPage - 2);
		const endPage = Math.min(totalPages, currentPage + 2);
		for (let i = startPage; i <= endPage; i++) {
			html += `
				<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
		}
		if (currentPage < totalPages) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}
		pagination.html(html);
	}
	function goToPage(page) {
		currentPage = page;
		loadPurchaseReceiptEntryList();
	}
		function editDocStage(vType, vNo) {
		// Build the docCode (if you want to combine) or pass separately
		window.location.href = `/PurchaseReturnEntry/Index?vType=${encodeURIComponent(vType)}&vNo=${encodeURIComponent(vNo)}`;
	}
	function viewDocStage(docCode) {
		window.location.href = `/PurchaseReturnEntry/Index?docCode=${encodeURIComponent(docCode)}&mode=view`;
	}
	function deleteDocStage(docCode) {
		Swal.fire({
			title: 'Are you sure?',
			text: "You won't be able to revert this deletion!",
			icon: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#d33',
			cancelButtonColor: '#3085d6',
			confirmButtonText: 'Yes, delete it!'
		}).then((result) => {	
			if (result.isConfirmed) {
				$.ajax({
					url: '/PurchaseReturnEntry/DeleteDocByCode',
					type: 'POST',
					data: { docCode: docCode },
					success: function (response) {
						if (response.success) {
							toastr.success(response.message || "Record deleted successfully.");
							loadPurchaseReceiptEntryList();
						} else {
							toastr.warning("Delete failed.");
						}
					},
					error: function () {
						toastr.error("An error occurred while deleting.");
					}
				});
			}
		});
	}
	function showDocumentPopup(docCode)
	{
		alert(docCode)
	}

</script>
