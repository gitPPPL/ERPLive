@{
	ViewBag.Title = "Purchase Return Entry List";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<fieldset>
	<legend class="legend-field">Purchase Return Entry List</legend>

	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>
		 
		<div class="col-lg-6">
			<div class="btn-rightalign">
				<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "PurchaseReturnEntry")'" type="button" class="btn btn-add">
					<i class="fa fa-plus"></i>Add
				</button>
				<button class="btn btn-print" onclick="printCityMasterReport()">
					<i class="fa fa-print"></i> Print
				</button>
				<button class="btn btn-export">
					<i class="fas fa-file-export"></i> Export
				</button>
				<button class="btn btn-mail">
					<i class="fa fa-envelope"></i> Mail
				</button>
				<button class="btn btn-approved">
					<i class="fa fa-check"></i> Approved
				</button>
			</div>
		</div>
	</div>

	<div class="card">
		<div class="table-responsive">
			<table id="tblPurchaseReturnEntryList" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>Voucher No</th>
						<th>Voucher Type</th>
						<th>Voucher Date</th>
						<th>Party Name</th>
						<th>Bill Number</th>
						<th>Bill Date</th>
						<th>Bill Address 1</th>
						<th>Bill Address 2</th>
						<th>Bill City</th>
						<th>Bill Gst</th>
						<th>Ship To</th>
						<th>Quantity</th>
						<th>Amount</th>
						<th>Remarks</th>
						<th>Transport Name</th>
						<th>Gate No</th>
						<th>Status</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				@* <div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div> *@

				<div class="erppagelist-pagination">
					<div class="pagination-left">
						<select id="pageSizeSelect" onchange="changeRowsPerPage()">
							<option value="5">5</option>
							<option value="10" selected>10</option>
							<option value="25">25</option>
							<option value="50">50</option>
						</select>
					</div>
					<div class="pagination-center">
						<button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
						<div id="pageNumbers" class="page-numbers"></div>
						<button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
					</div>
					<div class="pagination-right" id="pageInfoText">
						Results: 0 - 0 of 0
					</div>
				</div>

			</div>
		</div>
	</div>
</fieldset>


<script src="/common/pagination.js"></script>
<script src="/common/delete.js"></script>

<script>
	let purchasePagination;

	$(document).ready(function () {

		purchasePagination = Pagination.create({
			pageSize: 10,
			paginationContainer: '#pageNumbers',
			infoContainer: '#pageInfoText',

			loader: function (params) {

				$.ajax({
					url: '/PurchaseReturnEntryList/GetPurchaseReceiptEntryList',
					type: 'GET',
					dataType: 'json',
					data: {
						searchTerm: $('#searchBox').val(),
						pageNumber: params.pageNumber,
						pageSize: params.pageSize
					},
					success: function (res) {

						params.callback({
							data: res.items || [],
							totalCount: res.totalCount || 0
						});

					},
					error: function () {
						toastr.error("Error fetching data.");
					}
				});

			},

			render: function (docs) {

				const tbody = $('#tblPurchaseReturnEntryList tbody');
				tbody.empty();

				if (!docs.length) {
					tbody.append(`
						<tr>
							<td colspan="18" class="text-center text-muted">
								No records found.
							</td>
						</tr>
					`);
					return;
				}

				docs.forEach(doc => {

					tbody.append(`
						<tr>
							<td>${doc.vNo || ''}</td>
							<td>${doc.vType || ''}</td>
							<td>${doc.vDate || ''}</td>
							<td>${doc.partyName || ''}</td>
							<td>${doc.billNo || ''}</td>
							<td>${doc.billDate || ''}</td>
							<td>${doc.billAdd1 || ''}</td>
							<td>${doc.billAdd2 || ''}</td>
							<td>${doc.billCity || ''}</td>
							<td>${doc.billGST || ''}</td>
							<td>${doc.shipTo && typeof doc.shipTo === 'object'
								? (doc.shipTo.Name || '')
								: (doc.shipTo || '')}</td>
							<td>${doc.qty || ''}</td>
							<td>${doc.amount || ''}</td>
							<td>${doc.remarks && typeof doc.remarks === 'object'
								? (doc.remarks.Text || '')
								: (doc.remarks || '')}</td>
							<td>${typeof doc.transportName === 'object'
								? (doc.transportName.Name || '')
								: (doc.transportName || '')}</td>
							<td>${doc.gateNo || ''}</td>
							<td>${doc.status || ''}</td>
							<td>
								<div class="action-icons">
									<i class="fas fa-edit btn-edit"
									   title="Edit"
									   onclick="editDocStage('${doc.vType}','${doc.vNo}')"></i>

									   <i class="fas fa-eye btn-view"
									   title="View"
									   onclick="viewDocStage('${doc.vType}','${doc.vNo}')"></i>

									   <i class="fas fa-trash btn-delete"
									   title="Delete"
									   onclick="deleteDocStage('${doc.vType}','${doc.vNo}')"></i>

									<i class="fa fa-file btn-document"
									   title="Document"
									   onclick="showDocumentPopup('${doc.vNo}')"></i>
								</div>
							</td>
						</tr>
					`);

				});

			}

		});

		// First Load
		purchasePagination.load();

		// Search
		$('#searchBox').keyup(function () {
			purchasePagination.load();
		});

	});

	function changeRowsPerPage() {
		purchasePagination.setPageSize(parseInt($('#pageSizeSelect').val()));
		purchasePagination.load();
	}

	function editDocStage(vType, vNo) {
		window.location.href = `/PurchaseReturnEntry/Index?vType=${encodeURIComponent(vType)}&vNo=${encodeURIComponent(vNo)}`;
	}

	function viewDocStage(vType, vNo) {
		window.location.href = `/PurchaseReturnEntry/Index?vType=${encodeURIComponent(vType)}&vNo=${encodeURIComponent(vNo)}&mode=view`;
	}

	function deleteDocStage(vType, vNo) {

		Swal.fire({
			title: 'Are you sure?',
			text: "You won't be able to revert this deletion!",
			icon: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#d33',
			cancelButtonColor: '#3085d6',
			confirmButtonText: 'Yes, delete it!'
		}).then((result) => {

			if (result.isConfirmed) {

				$.ajax({
					url: '/PurchaseReturnEntryList/Delete',   
					type: 'POST',
					data: {
						vNo: vNo,
						docType: vType
					},
					success: function (response) {

						if (response.success) {

							toastr.success(response.message);

							purchasePagination.load();

						} else {

							toastr.error(response.message);

						}

					},
					error: function (xhr) {

						toastr.error(xhr.responseText);

					}

				});

			}

		});

	}

	function showDocumentPopup(docCode) {
		alert(docCode);
	}

</script>
