@{
	ViewBag.Title = "Purchase Request List";
	Layout = "~/Views/Shared/_Layout.cshtml";

	var currentMenu = ViewBag.CurrentMenu as string;
	bool canAdd = false;
	bool canEdit = false;
	bool canDelete = false;
	bool canPrint = false;
	bool canExport = false;
	bool canMail = false;
	bool canApproval = false;
	bool canDocDetail = false;

	foreach (var permission in Model.UserMenuPermissions)
	{
		if (permission.DISPLAY_NAME == ViewBag.CurrentMenu)
		{
			canAdd = Model.UserLevel == 1 || permission._ADD == 1;
			canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
			canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
			canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
			canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
			canMail = Model.UserLevel == 1 || permission._MAIL == 1;
			canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
			canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
			break;
		}
	}

	var userlevel = Model.UserLevel;

	var globalVariables = ViewBag.GlobalVariables as Models.UserSessionData;

}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<div id="erp-toast-container"></div>
<fieldset>
	<legend class="legend-field">Purchase Request List</legend>

	<div class="row">
		<div class="col-lg-3">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control border-0" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>
		 

		<div class="col-lg-9 btn-rightalign">
			<button onclick="window.location.href='@Url.Action("Index", "PurchaseRequest")'" type="button" class="btn btn-add">
				<i class="fa fa-plus"></i>Add 
			</button>
			<button class="btn btn-print" onclick="printCityMasterReport()">
				<i class="fa fa-print"></i> Print
			</button>
			<button class="btn btn-export">
				<i class="fas fa-file-export"></i> Export
			</button>
			<button class="btn btn-mail">
				<i class="fa fa-envelope"></i> Mail
			</button>
			<button class="btn btn-send">
				<i class="fa fa-paper-plane"></i> Approval Send
			</button>
			<button class="btn btn-approved">
				<i class="fa fa-check"></i> Approved
			</button>

		</div>
	</div>



	<div class="card">
		<div class="table-responsive">
			<table id="tblPurchaseRequestList" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>Voucher No</th>
						<th>Voucher Type</th>
						<th>Voucher Date</th>
						<th>Department</th>
						<th>Owner Name</th>
						<th>Place</th>

						<th>Required Date</th>
						<th>Remarks</th>
						<th>Status</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
	</div>



</fieldset>

<script src="~/js/erpjs/purchase/transaction/purchaserequestlist/purchaserequestlist.js"></script>

<script>
	window.permissions = {
		canEdit: @canEdit.ToString().ToLower(),
		canDelete: @canDelete.ToString().ToLower()
	};
	window.userLevel = @userlevel;
</script>



