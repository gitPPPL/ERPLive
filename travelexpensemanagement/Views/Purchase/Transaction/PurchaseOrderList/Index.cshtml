@{
	ViewBag.Title = "Purchase Order List";
	Layout = "~/Views/Shared/_Layout.cshtml";


	var userlevel = ViewBag.userLevel;


	var currentMenu = ViewBag.CurrentMenu as string;
	bool canAdd = false;
	bool canEdit = false;
	bool canDelete = false;
	bool canPrint = false;
	bool canExport = false;
	bool canMail = false;
	bool canApproval = false;
	bool canDocDetail = false;

	foreach (var permission in Model.UserMenuPermissions)
	{
		if (permission.MENU_NAME == ViewBag.CurrentMenu)
		{
			canAdd = Model.UserLevel == 1 || permission._ADD == 1;
			canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
			canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
			canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
			canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
			canMail = Model.UserLevel == 1 || permission._MAIL == 1;
			canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
			canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
			break;
		}
	} 

}

<div id="erp-toast-container"></div>
<div class="erppagelist-header">
	<div class="erppagelist-title">
		<i class="fa fa-list"></i>
		<span>Purchase Order List</span>
	</div>
	<div class="erppagelist-header-right">
		@if (canAdd)
		{
			<button class="erppage-header-back"
					onclick="window.location.href='@Url.Action("Index", "PurchaseOrder")'">
				<i class="fa fa-plus"></i> Add New
			</button>
		}
	</div>
</div>
<div class="erppagelist-toolbar">
	<div class="erppagelist-search-wrapper">
		<i class="fa fa-search"></i>
		<input type="text" id="searchBox" placeholder="Search Purchase Order..." />
	</div>
	<div class="erppagelist-actions">
		@if (canPrint)
		{
			<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" onclick="printCityMasterReport()">
				<i class="fa fa-print"></i> Print
			</button>
		}

		@if (canExport)
		{
			<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Export to Excel" onclick="exportToExcel()">
				<i class="fa fa-file-excel"></i> Export
			</button>
		}

		@if (canMail)
		{
			<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail">
				<i class="fa fa-envelope"></i> Mail
			</button>
		}

		@if (canApproval)
		{
			<button class="erppagelist-btn erppagelist-btn-approve tooltip-btn" data-tooltip="Approve Records">
				<i class="fa fa-check-circle"></i> Approved
			</button>
		}

	</div>
</div>
<div class="erppagelist-container">
	<div class="excel-wrapper fixed-grid-wrapper">
		<table id="tblPurchaseOrderList" class="excel-table fixed-grid-table table-width resizable-table">
			<colgroup>
				<col style="display:none;">      
				<col style="width:120px;">       
				<col style="width:110px;">       
				<col style="width:110px;">       
				<col style="width:220px;">       
				<col style="width:180px;">       
				<col style="width:90px;">        
				<col style="width:120px;">       
				<col style="width:120px;">       
				<col style="width:120px;">       
				<col style="width:100px;">       
			</colgroup>
			<thead>
				<tr>
					<th class="hidden-col">DocId</th>
					<th>Voucher No</th>
					<th>Voucher Type</th>
					<th>Voucher Date</th>
					<th>Party Name</th>
					<th>Ship To</th>
					<th>Quantity</th>
					<th>Amount</th>
					<th>Delivery Date</th>
					<th>Validity Date</th>
					<th class="action-col">Action</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>
	<div class="erppagelist-pagination">
		<div class="pagination-left">
			<select id="pageSizeSelect">
				<option value="5">5</option>
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
			</select>
		</div>

		<div class="pagination-center">
			<button class="page-nav" id="prevBtn">‹</button>
			<div id="tablePagination" class="page-numbers"></div>
			<button class="page-nav" id="nextBtn">›</button>
		</div>

		<div class="pagination-right" id="pageInfoText">
			Results: 0 - 0 of 0
		</div>

	</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="~/js/GlobalFunction.js" asp-append-version="true"></script>
<script>
	var permissions = {
		canEdit: @canEdit.ToString().ToLower(),
		canDelete: @canDelete.ToString().ToLower(),
		canDocDetail: @canDocDetail.ToString().ToLower()
	};

	const userlevel = @Model.UserLevel;	   	
	let currentPage = 1;
	let pageSize = 10;

	$(document).ready(function () {
		GetMasterDataList();
		$('#searchBox').on('keyup', function () {
			currentPage = 1;
			GetMasterDataList();
		});
	});
 
	function GetMasterDataList() {
	      const searchTerm = $('#searchBox').val().trim();
		  $.ajax({
			url: '@Url.Action("GetPurchaseOrderList", "PurchaseOrderList")',
			type: 'GET',
			dataType: 'json',
			data: {
				searchTerm: searchTerm,
				pageNumber: currentPage,
				pageSize: pageSize
			},
			success: function (res) {
				const mastListData = res.data || [];
				const totalCount = res.totalCount || 0;
				let tbody = $('#tblPurchaseOrderList tbody');
				tbody.empty();
		
				if (mastListData.length === 0) {
					tbody.append('<tr><td colspan="10" class="text-center text-muted">No PO found.</td></tr>');
					return;
				}
				$.each(mastListData, function (index, item) {
					let actions = '';
					if (permissions.canEdit) {
						actions += `<button class="act-btn edit btn-edit" title="Edit Row" style="cursor:pointer;" onclick="AddOrEditFunction('${item.DOC_ID}','${item.V_NO}','${item.V_TYPE}')"><i class="fa fa-edit"></i></button>`;
					}
					actions += `<button class="act-btn view btn-view" title="View Row" style="cursor:pointer;" onclick="viewMenuDetails('${item.DOC_ID}')"><i class="fa fa-eye"></i></button>`;

					if (permissions.canDelete) {
						actions += `<button class="act-btn delete btn-delete" title="Delete Row" style="cursor:pointer;"><i class="fa fa-trash"></i></button>`;
					}
					if (permissions.canDocDetail) {
						actions += `<button class="act-btn document btn-document btn-details" title="Document Row" style="cursor:pointer;" onclick="showEmployeePopup('${item.DOC_ID}')"><i class="fa fa-file"></i></button>`;
					}
					tbody.append(`
						<tr>
							<td class="d-none code">${item.DOC_ID}</td>
							<td id="v_no">${item.V_NO}</td>
							<td id="v_type">${item.V_TYPE}</td>
							<td>${item.V_DATE}</td>
							<td>${item.PartyName}</td>
							<td>${item.ShipTo}</td>
							<td>${item.QTY}</td>
							<td>${item.AMOUNT}</td>
							<td>${item.DELIVERY_DATE}</td>
							<td>${item.VALIDITY_DATE}</td>
							<td class="action-col"><div class="action-wrap">${actions}</div></td>
						</tr>
					`);
				});				 
		    $('[data-bs-toggle="tooltip"]').tooltip();
				renderPagination(totalCount, pageSize, currentPage);
			},
			error: function (xhr) {
				toastr.error('Error loading Purchase Order list: ' + xhr.responseText);
			}
		    });
	    }

	function renderPagination(total, pageSize, currentPage) {
			const totalPages = Math.ceil(total / pageSize);
			const paginationContainer = $('#tablePagination');
			paginationContainer.empty();

			if (total <= 0 || totalPages <= 1) return;

			let paginationHtml = '';

			if (currentPage > 1) {
				paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
				paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
			}

			let startPage = Math.max(1, currentPage - 2);
			let endPage = Math.min(totalPages, currentPage + 2);

			if (currentPage <= 3) endPage = Math.min(5, totalPages);
			if (currentPage >= totalPages - 2) startPage = Math.max(totalPages - 4, 1);

			for (let i = startPage; i <= endPage; i++) {
				paginationHtml += `
					<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1"
							onclick="goToPage(${i})">${i}</button>`;
			}

			if (currentPage < totalPages) {
				paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
				paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
			}
			paginationContainer.html(paginationHtml);
		}

	function goToPage(page) {
			currentPage = page;
			GetMasterDataList();
		}

	async function AddOrEditFunction(rowId , v_no ,v_type ) {
	        try {
				const res = await $.ajax({
					url: '/PurchaseOrderList/EditValidation',
					method: 'GET',
					dataType: 'json',
					data: { v_no: v_no, v_type: v_type }
				});

				if (res?.validation1?.success === true) {
					toastr.warning(res?.validation1?.message );
					return;
				}

				if (res?.validation2?.success === true) {
					toastr.info(res.validation2.message);
				}

				if (res?.validation2?.success === true) {
					toastr.info(res.validation2.message);
				}

				if (res?.validation3?.success === true) {
					toastr.info(res.validation3.message);
				}

			      window.location.href = '/PurchaseOrder/Index?id=' + encodeURIComponent(rowId);
			

			} catch (error) {
				console.error("AJAX error:", error);
				alert("Something went wrong while validating.");
			}


		}

	async function viewMenuDetails(rowId) {
	    	window.location.href = '/PurchaseOrder/Index?id=' + encodeURIComponent(rowId) + '&readOnly=true';
		}

   $(document).on('click', '.btn-delete', async function () {

		const $row = $(this).closest('tr');
		const CodeforDel = $row.find('.code').text().trim();
		const v_no = $row.find('#v_no').text().trim();
		const v_type = $row.find('#v_type').text().trim();

		try {
			const res = await $.ajax({
				url: '/PurchaseOrderList/DeleteValidation',
				method: 'GET',
				dataType: 'json',   // ✅ IMPORTANT FIX
				data: { v_no: v_no, v_type : v_type }
			});

			console.log("res", res);

				if (res?.validation4?.approval === "Approved") {
					toastr.warning("This document approval is in process, deletion not allowed.");
					return;
				}

				if (res?.validation1?.success === true) {
					toastr.info(res.validation1.message);
				   console.log("User_level" ,userlevel);

				   if(userlevel != "1")
				   {
					   return ;
				   }


				}

				if (res?.validation2?.success === true) {
					toastr.info(res.validation2.message);

				}

				if (res?.validation3?.success === true) {
					toastr.info(res.validation3.message);

				}


			const confirmed = await confirmAction();
			if (!confirmed) return;

			$.ajax({
				url: '/PurchaseOrderList/DeletePurchaseOrderEntry',
				type: 'DELETE',
				dataType: 'json',   // ✅ important
				data: { docid: CodeforDel },
				success: function (res) {
					if (res.status) {
						showFlashMessageByKey('delete', 'success');
						$row.remove();
						GetMasterDataList();
					} else {
						Swal.fire('Error!', res.message || 'Delete failed', 'error');
					}
				},
				error: function (xhr) {
					Swal.fire('Error!', xhr.responseText || 'Server error', 'error');
				}
			});

		} catch (err) {
			console.error("Validation error:", err);
			Swal.fire('Error!', 'Validation failed. Please try again.', 'error');
		}
	});
			 
   function exportToExcel() {
		  fetch('/PurchaseOrderList/ExportAllDocs')
			.then(response => {
			  if (!response.ok) throw new Error("Network response was not ok");
			  return response.json();
			})
			.then(responseData => {
			  if (!responseData.status) {
				toastr.error("Failed to fetch data.");
				return;
			  }
			  const dataArray = responseData.data;
			  if (!Array.isArray(dataArray) || dataArray.length === 0) {
				toastr.warning("No data available to export.");
				return;
			  }

			  const worksheet = XLSX.utils.json_to_sheet(dataArray, { header: Object.keys(dataArray[0]) });
			  const colWidths = Object.keys(dataArray[0]).map(key => {
				const maxLen = Math.max(
				  key.length,
				  ...dataArray.map(row => (row[key] ? row[key].toString().length : 0))
				);
				return { wch: maxLen + 2 };
			  });
			  worksheet['!cols'] = colWidths;


			  const headerRowNumber = 1;
			  Object.keys(dataArray[0]).forEach((_, idx) => {
				const cellAddress = XLSX.utils.encode_cell({ c: idx, r: headerRowNumber - 1 });
				if (!worksheet[cellAddress]) return;
				worksheet[cellAddress].s = {
				  font: { bold: true },
				  fill: { fgColor: { rgb: "FFFF00" } }
				};
			  });

			  const workbook = XLSX.utils.book_new();
			  XLSX.utils.book_append_sheet(workbook, worksheet, "AllDocs");

			  const pageName = "PurchaseOrder_List";
			  const now = new Date();
			  const pad = n => String(n).padStart(2, '0');
			  const timestamp = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}_${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;
			  const fileName = `${pageName}_${timestamp}.xlsx`;

			  XLSX.writeFile(workbook, fileName);
			})
			.catch(error => {
			  console.error("Export failed:", error);
			  toastr.error("Failed to export data.");
			});
		}

   function callGetReportAsPdf() {
		    var reportName = "rpt_emp_mast";
			var now = new Date();
			var day = String(now.getDate()).padStart(2, '0');
			var month = String(now.getMonth() + 1).padStart(2, '0');
			var year = String(now.getFullYear()).slice(-2);
			var hours = String(now.getHours()).padStart(2, '0');
			var minutes = String(now.getMinutes()).padStart(2, '0');
			var seconds = String(now.getSeconds()).padStart(2, '0');
			var timestamp = `${day}${month}${year}_${hours}${minutes}${seconds}`;

			$.ajax({
				url: 'http://192.168.20.51:8082/Report/GetReportAsPdf',
				type: 'GET',
				data: { Reportname: reportName },
				xhrFields: {
					responseType: 'blob'
				},
				success: function (response) {
					console.log('PDF response:', response);
					var file = new Blob([response], { type: 'application/pdf' });
					var fileName = `${reportName}_${timestamp}.pdf`;

					var link = document.createElement('a');
					link.href = URL.createObjectURL(file);
					link.download = fileName;
					document.body.appendChild(link);
					link.click();
					document.body.removeChild(link);
				},
				error: function (xhr, status, error) {
					console.error('Error generating report:', error);
				}
			});
		}

   function showEmployeePopup(docCode) {
			 $.ajax({
				 url: '/PurchaseOrderList/GetPurchaseOrderEntryDetails',
				 type: 'Get',
				 dataType: 'json',
				 data: { docid: docCode },
				 success: function(response) {
						 if(response.status) {
								 console.log(response.data);
						 showDocumentPopupjQuery(response.data, docCode);
					 } else {
						 toastr.error("Failed to get document details.");
					 }
				 },
				 error: function() {
					 toastr.error("An error occurred while fetching document details.");
				 }
			 });
		 }

</script>


 