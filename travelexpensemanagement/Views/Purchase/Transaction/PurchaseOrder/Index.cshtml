@{
    ViewBag.Title = "Purchase Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    #tblItemRecordPO th:nth-child(2),
    #tblItemRecordPO td:nth-child(2) select {
        min-width: 400px;
        max-width: 700px; /* optional */
    }

    #tblItemRecordPO th:nth-child(3),
    #tblItemRecordPO th:nth-child(4),
    #tblItemRecordPO th:nth-child(5),
    #tblItemRecordPO th:nth-child(6),
    #tblItemRecordPO td:nth-child(3) select,
    #tblItemRecordPO td:nth-child(4) select,
    #tblItemRecordPO td:nth-child(5) select,
    #tblItemRecordPO td:nth-child(6) select {
        min-width: 100px;
        max-width: 200px;
    }
</style>
<fieldset>
    <legend class="legend-field">Purchase Order</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="window.location.href='@Url.Action("Index", "PurchaseOrderList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>

    <form id="PurchaseOrderForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <div class="row">
            <div class="col-md-2">
                <div class="form-group">
                    <label for="ddlDocType">Doc Type <span class="required">*</span> </label>
                    <select class="form-control" id="ddlDocType">                     
                    </select>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="txtDocNo">Doc No</label>
                    <input type="text" class="form-control" id="txtDocNo" readonly>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="dtDocDate">Doc Date <span class="required">*</span></label>
                    <input type="date" class="form-control" id="dtDocDate">
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="ddlPOType1">PO Type</label>
                    <div class="input-divide">
                        <select class="form-control" id="ddlPOType1">
                            <option>Others</option>
                            <option>Capital</option>
                            <option>Monthly</option>
                        </select>
                        @* <label for="ddlStatus">Request Status</label> *@
                        <select class="form-control" id="ddlStatus">
                            <option value="1">Open</option>
                            <option value="0">Cancel</option>
                            <option value="2">Close</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="ddlPlace">Place <span class="required">*</span></label>
                    <select class="form-control" id="ddlPlace">
                        <option value="">-Select Place-</option>
                    </select>
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="col-md-4">
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Party Details</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ddlPartyName">Party Name<span class="required">*</span></label>
                                <div class="input-divide">
                                    <select class="form-control" id="ddlPartyName">
                                        <option value="">Select Party Name</option>
                                    </select>
                                    <div class="select-wrapper">
                                        <select class="form-control" id="ddlAddressbyparty">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="TxtAdd1PD">Address 1</label>
                                <textarea type="text" class="form-control" id="TxtAdd1PD" placeholder="Enter Address 1" readonly></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="TxtAdd2PD">Address 2</label>
                                <textarea type="text" class="form-control" id="TxtAdd2PD" placeholder="Enter Address 2" readonly></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtAdd3PD">Address 3</label>
                                <input type="text" class="form-control" id="TxtAdd3PD" readonly>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="NumPincodePD">Pincode</label>
                                <input type="text" class="form-control" id="NumPincodePD" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtCity1PD">City</label>
                                <input type="text" class="form-control" id="TxtCity1PD" readonly>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtGSTPD">GST</label>
                                <input type="text" class="form-control" id="TxtGSTPD" readonly>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Ship Details</legend> 
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ddlShipFrom">Ship From <span class="required">*</span></label>
                                <div class="input-divide">
                                    <select class="form-control" id="ddlShipFrom">
                                        <option value="">-Select Ship From-</option>
                                    </select>
                                    <div class="select-wrapper">
                                        <select class="form-control" id="ddlAddressbypartySD">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>                   
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="TxtAdd1SD">Address 1</label>
                                <textarea type="text" class="form-control" id="TxtAdd1SD" placeholder="Enter Address 1" readonly></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="TxtAdd2SD">Address 2</label>
                                <textarea type="text" class="form-control" id="TxtAdd2SD" placeholder="Enter Address 2" readonly></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtAdd3SD">Address 3</label>
                                <input type="text" class="form-control" id="TxtAdd3SD" readonly>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="NumPincodeSD">Pincode</label>
                                <input type="text" class="form-control" id="NumPincodeSD" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtCity1SD">City</label>
                                <input type="text" class="form-control" id="TxtCity1SD" readonly>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtGSTSD">GST</label>
                                <input type="text" class="form-control" id="TxtGSTSD" readonly>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Terms and Condition</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtDeliveryTerm">Delivery Term</label>
                                <input type="text" class="form-control" id="txtDeliveryTerm" placeholder="Enter Delivery Term">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtTransportTerm">Transport Term</label>
                                <input type="text" class="form-control" id="txtTransportTerm" placeholder="Enter Transport Term">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ddlPaymentTerm">Payment Term</label>
                                <div class="input-divide">
                                    <select class="form-control" id="ddlPaymentTerm" style="width:30%">
                                        <option value="">Select Payment Term</option>
                                    </select>
                                    <input type="text" class="form-control" id="txtPaymentTerm" placeholder="Enter Payment Term" style="width:70%">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtPriceTerm">Price Term</label>
                                <input type="text" class="form-control" id="txtPriceTerm" placeholder="Enter Price Term">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtRemarksTC">Remarks</label>
                                <textarea type="text" class="form-control" id="txtRemarksTC" placeholder="Enter Remarks"></textarea>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        <div class="row">
            <div class="col-md-2">
                <div class="form-group">
                    <label for="txtPartyRef">Party Ref/Quot No</label>
                    <input type="text" class="form-control" id="txtPartyRef" placeholder="Enter Party Ref/Quot No">
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group position-relative">
                    <label for="chkDeliveryDate">Delivery Date</label>
                    <div class="calender-check">
                        <input type="date" class="form-control" id="DtDeliveryDate" name="DeliveryDate" style="padding-left: 30px;">
                        <input type="checkbox" id="chkDeliveryDate" class="checkbox-inside">
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group position-relative">
                    <label for="chkValidateDate">Validate Date</label>
                    <div class="calender-check">
                        <input type="date" class="form-control" id="DtValidateDate" name="DeliveryDate" style="padding-left: 30px;">
                        <input type="checkbox" id="chkValidateDate" class="checkbox-inside">
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="ddlPriceType">Price Type <span class="required">*</span></label>
                    <select class="form-control" id="ddlPriceType">
                        <option value="">-Select Price Type-</option>
                        <option>F.O.R -at our plant</option>
                        <option>Ex-Work</option>
                        <option>CIF</option>
                        <option>FOB</option>
                        <option>CFR</option>
                    </select>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label id="LblWbNo" for="ddWBNo">WB No</label>
                    <select id="ddWBNo" class="form-control">
                        <option value="">-Select WB No-</option>
                    </select>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label id="LblSaudaNo" for="ddSaudaNo">Sauda No</label>
                    <div class="input-icon-wrapper">
                        <select class="form-control" id="ddSaudaNo">
                            <option value="">-Select Sauda No-</option>
                        </select>
                        <button id="BtnCalculation">
                            <span class="input-icon"><i class="fa-solid fa-c"></i></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-2">
                <div class="form-group">
                    <label for="txtnetamount1">Net Amount</label>
                    <div class="input-divide">
                        <input type="text" class="form-control" id="txtnetamount1" readonly>
                        <input type="text" class="form-control" id="TxtDocId" readonly>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="ddlCurrency">Currency</label>
                    <select class="form-control" id="ddlCurrency">
                        <option value="">-Select Currency-</option>
                    </select>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="NumExRate">Ex-Rate</label>
                    <input type="text" class="form-control" id="NumExRate" oninput="allowOnlyNumbers(this)" placeholder="Enter Ex-Rate">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <fieldset class="fieldset-sub">
                    <legend class="sub-legend">Item Total</legend>
                    <div class="row">
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="NumTotalNos">Total Nos</label>
                                <input type="text" class="form-control" id="NumTotalNosIt" placeholder="Enter Total Nos" readonly>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="NumQty">Quantity</label>
                                <input type="text" class="form-control" id="NumQtyIt" placeholder="Enter Quantity" readonly>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="NumAmount">Amount</label>
                                <input type="text" class="form-control" id="NumAmountIt" placeholder="Enter Amount" readonly>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="NumPackingAmt">Packing Amt</label>
                                <input type="text" class="form-control" id="NumPackingAmtIt" oninput="allowOnlyNumbers(this)" placeholder="Enter Packing Amt">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="NumDiscAmt">Disc Amt</label>
                                <input type="text" class="form-control" id="NumDiscAmtIt" oninput="allowOnlyNumbers(this)" placeholder="Enter Disc Amt">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="NumCgstAmt">CGST Amt</label>
                                <input type="text" class="form-control" id="NumCgstAmtIt" oninput="allowOnlyNumbers(this)" placeholder="Enter CGST Amt" readonly>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="NumSgstAmt">SGST Amt</label>
                                <input type="text" class="form-control" id="NumSgstAmtIt"  placeholder="Enter SGST Amt" readonly>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="NumIgstAmt">IGST Amt</label>
                                <input type="text" class="form-control" id="NumIgstAmtIt" placeholder="Enter IGST Amt" readonly>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="NumVatAmt">VAT Amt</label>
                                <input type="text" class="form-control" id="NumVatAmtIt" placeholder="Enter VAT Amt" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="NumCessAmt">Cess Amt</label>
                                <input type="text" class="form-control" id="NumCessAmtIt" placeholder="Enter Cess Amt" readonly>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="NumTCS">TCS</label>
                                <input type="text" class="form-control" id="NumTCSIt" placeholder="Enter TCS" readonly>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="NumOtherAmt">Other Amt</label>
                                <input type="text" class="form-control" id="NumOtherAmtIt" oninput="allowOnlyNumbers(this)"                                                         placeholder="Enter Other Amt">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="NumNetAmt">Net Amt</label>
                                <input type="text" class="form-control" id="NumNetAmtIt" placeholder="Enter Net Amt" readonly>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        <div class="row">
            <div class="offset-md-6 col-md-6 mt-2">
                <div class="button-right">
                    <button type="button" class="btn btn-primary">
                        <i class="fa-solid fa-clock-rotate-left"></i> PO Modification History
                    </button>

                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#PendingRequestModal">
                        <i class="fa-solid fa-hourglass-half"></i> Pending Request
                    </button>

                    <div class="dropdown">
                        <button class="btn btn-primary dropdown-toggle" type="button" id="copyFromDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-copy"></i> <span id="dropdownText">Copy From</span>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="copyFromDropdown">
                            <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#purchaseRequestModal" id="BtnPurchaseReq">Purchase Request</a></li>
                            <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#quotationModal" id="BtnQuotationRtAprvl">Quotation Rate Approval</a></li>
                        </ul>
                    </div>

                </div>
            </div>
        </div>
        <!--Purchase Request Modal-->
        <div class="modal fade" id="purchaseRequestModal" tabindex="-1" aria-labelledby="purchaseRequestLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content draggable-modal">
                    <div class="popup-header">
                        <h5 class="popup-title" id="purchaseRequestLabel">Copy From</h5>
                        <i class="fa fa-times" data-bs-dismiss="modal" style="cursor: pointer;" aria-label="Close"></i>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-4">
                                <div class="input-group shadow-sm rounded-pill overflow-hidden">
                                    <input type="text" id="searchBoxPR" class="form-control border-0" placeholder="Search Module..." aria-label="Search term" />
                                </div>
                            </div>
                            <div class="col-lg-2">
                                <div class="form-group">
                                    <div class="form-row">
                                        <input type="checkbox" id="chkAppendPR">
                                        <label class="checkbox-label" for="chkAppendPR">Append</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="btn-rightalign">
                                    <button type="button" class="btn btn-primary btn-purchaseCopy" data-bs-dismiss="modal"><i class="fa fa-copy"></i>Copy</button>
                                    @*  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa fa-close"></i>Close</button> *@
                                </div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="table-responsive">
                                <table id="tblPurchaseRequest" class="table-width">
                                    <thead class="table-head">
                                        <tr>
                                            <th><input type="checkbox" id="selectAllPR" /></th>
                                            <th>Vno</th>
                                            <th>VType</th>
                                            <th>Vdate</th>
                                            <th>Item C</th>
                                            <th>Item Name</th>
                                            <th>Unit</th>
                                            <th>Make</th>
                                            <th>Tech Desc</th>
                                            <th>Req_Qty</th>
                                            <th>Valid Date</th>
                                            <th>Remarks</th>
                                            <th>Status</th>
                                            <th>Department</th>
                                            <th>Dept Code</th>
                                            <th>Make Code</th>
                                            <th>Reqno</th>
                                            <th>Reqtype</th>
                                            <th>Ucode</th>
                                            <th style="display:none;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <!--Quotation Modal-->
        <div class="modal fade" id="quotationModal" tabindex="-1" aria-labelledby="quotationLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content draggable-modal">
                    <div class="popup-header">
                        <h5 class="popup-title" id="quotationLabel">Copy From</h5>
                        <i class="fa fa-times" data-bs-dismiss="modal" style="cursor: pointer;" aria-label="Close"></i>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-4">
                                <div class="input-group shadow-sm rounded-pill overflow-hidden">
                                    <input type="text" id="searchBoxQM" class="form-control" placeholder="Search Module..." aria-label="Search term" />
                                </div>
                            </div>
                            <div class="col-lg-2">
                                <div class="form-group">
                                    <div class="form-row">
                                        <input type="checkbox" id="chkAppendQM">
                                        <label class="checkbox-label" for="chkAppendQM">Append</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="btn-rightalign">
                                    <button type="button" class="btn btn-primary btn-quoteCopy" data-bs-dismiss="modal"><i class="fa fa-copy"></i>Copy</button>
                                    @*  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa fa-close"></i>Close</button> *@
                                </div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="table-responsive">
                                <table id="tblQuotationModal" class="table-width">
                                    <thead class="table-head">
                                        <tr>
                                            <th><input type="checkbox" id="selectAllQM" /></th>
                                            <th>Vno</th>
                                            <th>VType</th>
                                            <th>Vdate</th>
                                            <th>Item Name</th>
                                            <th>Unit</th>
                                            <th>Make</th>
                                            <th>Tech Desc</th>
                                            <th>Qty</th>
                                            <th>Rate</th>
                                            <th>Amount</th>
                                            <th>Pack %</th>
                                            <th>Pack Amt</th>
                                            <th>Freight</th>
                                            <th>Disc%</th>
                                            <th>Disc Amt</th>
                                            <th>Tax Type</th>
                                            <th>CGST%</th>
                                            <th>CGST Amt</th>
                                            <th>SGST%</th>
                                            <th>SGST Amt</th>
                                            <th>IGST%</th>
                                            <th>IGST Amt</th>
                                            <th>Cessp</th>
                                            <th>Cess</th>
                                            <th>Oth Amt</th>
                                            <th>LD Rate</th>
                                            <th>Net Amt</th>
                                            <th>Party Name</th>
                                            <th>Quote No</th>
                                            <th>Quote Date</th>
                                            <th>Remarks</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--Pending Request Modal Popup-->
        <div class="modal fade" id="PendingRequestModal" tabindex="-1" aria-labelledby="PendingRequestModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
