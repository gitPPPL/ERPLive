@{
	ViewBag.Title = "Import Payment List";
	Layout = "~/Views/Shared/_Layout.cshtml";

}
<div id="erp-toast-container"></div>
<div class="erppagelist-header">
	<div class="erppagelist-title">
		<i class="fa fa-list"></i>
		<span>Import Payment List</span>
	</div>
	<div class="erppagelist-header-right">
		<button class="erppage-header-back" id="button_add" onclick="window.location.href='@Url.Action("Index", "ImportPaymentEntry")'">
			<i class="fa fa-plus"></i>Add New
		</button>
	</div>
</div>
<div class="erppagelist-toolbar">
	<div class="erppagelist-search-wrapper">
		<i class="fa fa-search"></i>
		<input type="text" id="searchBox" placeholder="Search Module..." />
	</div>
	<div class="erppagelist-actions">
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" id="button_export" data-tooltip="Export to Excel">
			<i class="fa fa-file-excel"></i> Export
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" id="button_mail" data-tooltip="Send Mail">
			<i class="fa fa-envelope"></i> Mail
		</button>
	</div>
</div>
<div class="erppagelist-container">
	<div class="excel-wrapper fixed-grid-wrapper">
		<table id="tblImportPaymentList" class="excel-table fixed-grid-table table-width resizable-table">
			<colgroup>
				<col class="hidden-col">
				<col style="width: 179px;">
				<col style="width: 268px;">
				<col style="width: 133px;">
				<col style="width:90px;">
			</colgroup>
			<thead>
				<tr>
					<th class="hidden-col">Code</th>
					<th>Doc No</th>
					<th>Doc Type</th>
					<th>Doc Date</th>
					<th class="action-col">Action</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>
	<div class="erppagelist-pagination">
		<div class="pagination-left">
			<select id="pageSizeSelect">
				<option value="5">5</option>
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
			</select>
		</div>
		<div class="pagination-center">
			<button class="page-nav" id="prevBtn">‹</button>
			<div id="tablePagination" class="page-numbers"></div>
			<button class="page-nav" id="nextBtn">›</button>
		</div>
		<div class="pagination-right" id="pageInfoText">
			Results: 0 - 0 of 0
		</div>
	</div>
</div>

<script src="~/common/pagination.js"></script>
<script src="~/common/delete.js"></script>
<script src="~/js/erpjs/purchase/transaction/importpaymententrylistjs/importpaymententrylist.js"></script>