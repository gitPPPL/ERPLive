@{
    ViewBag.Title = "Printing Requestion List";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<div id="erp-toast-container"></div>
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>Printing Requestion List</span>
    </div>
    <div class="erppagelist-header-right">
        <button class="erppage-header-back" onclick="window.location.href='@Url.Action("Index", "PrintingRequestionEntry")'">
            <i class="fa fa-plus"></i>Add New
        </button>
    </div>
</div>
<div class="erppagelist-toolbar">
    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" id="searchBox" placeholder="Search Module..." />
    </div>
    <div class="erppagelist-actions">
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report">
            <i class="fa fa-print"></i> Print
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Export to Excel">
            <i class="fa fa-file-excel"></i> Export
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail">
            <i class="fa fa-envelope"></i> Mail
        </button>
        <button class="erppagelist-btn erppagelist-btn-approve tooltip-btn"
                data-tooltip="Approve Records">
            <i class="fa fa-check-circle"></i> Approved
        </button>
    </div>
</div>
<div class="erppagelist-container">
    <div class="excel-wrapper fixed-grid-wrapper">
        <table id="tblPrintingRequestionList" class="excel-table fixed-grid-table table-width resizable-table">
            <colgroup>
                <col class="hidden-col">      <!-- Code -->
                <col style="width:100px;">    <!-- Doc Type -->
                <col style="width:100px;">    <!-- Doc No -->
                <col style="width:110px;">    <!-- Doc Date -->
                <col style="width:180px;">    <!-- Department -->
                <col style="width:180px;">    <!-- Owner Name -->
                <col style="width:150px;">    <!-- Place -->
                <col style="width:110px;">    <!-- Valid Date -->
                <col style="width:110px;">    <!-- Target Date -->
                <col style="width:220px;">    <!-- Remarks -->
                <col style="width:90px;">     <!-- Status -->
                <col style="width:120px;">    <!-- Action -->
            </colgroup>
            <thead>
                <tr>
                    <th class="hidden-col">Code</th>
                    <th>Doc Type</th>
                    <th>Doc No</th>
                    <th>Doc Date</th>
                    <th>Department</th>
                    <th>Owner Name</th>
                    <th>Place</th>
                    <th>Valid Date</th>
                    <th>Target Date</th>
                    <th>Remarks</th>
                    <th>Status</th>
                    <th class="action-col">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    <div class="erppagelist-pagination">
        <div class="pagination-left">
            <select id="pageSizeSelect">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="pagination-center">
            <button class="page-nav" id="prevBtn">‹</button>
            <div id="tablePagination" class="page-numbers"></div>
            <button class="page-nav" id="nextBtn">›</button>
        </div>
        <div class="pagination-right" id="pageInfoText">
            Results: 0 - 0 of 0
        </div>
    </div>
</div>
<script src="~/common/delete.js"></script>
<script>
    let currentPage = 1;
    let pageSize = 10;
    $(document).ready(function () {
        // Initial Load
        loadPrintingRequestionList();
        // Search
        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadPrintingRequestionList();
        });
        // Page Size
        $('#pageSizeSelect').on('change', function () {
            pageSize = parseInt($(this).val());
            currentPage = 1;
            loadPrintingRequestionList();
        });
        // Previous
        $('#prevBtn').on('click', function () {
            if (currentPage > 1) {
                currentPage--;
                loadPrintingRequestionList();
            }
        });
        // Next
        $('#nextBtn').on('click', function () {
            const total =  parseInt($('#pageInfoText').data('total')) || 0;
            const totalPages = Math.ceil(total / pageSize);
            if (currentPage < totalPages) {
                currentPage++;
                loadPrintingRequestionList();
            }
        });
    });
    // LOAD PRINTING REQUISITION
    function loadPrintingRequestionList() {
        const searchTerm = $('#searchBox').val();
        $.ajax({
            url: '@Url.Action("GetPrintingRequestionList", "PrintingRequestionList")',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                console.log("Printing Requisition Response:", res);
                const docs = res.data || [];
                const totalCount =  res.totalCount || 0;
                const tbody = $('#tblPrintingRequestionList tbody');
                tbody.empty();
                // NO RECORD
                if (docs.length === 0) {
                    tbody.append(`
                        <tr>
                            <td colspan="12" class="text-center text-muted"> No records found.</td>
                        </tr>
                    `);
                    renderPagination(totalCount,pageSize,currentPage);
                    updatePageInfo(totalCount,pageSize,currentPage);
                    return;
                }
                // RECORDS
                docs.forEach(function (doc) {
                    tbody.append(`
                        <tr>
                            <!-- Search Code -->
                            <td class="hidden-col"> ${escapeHtml(doc.searchCode)} </td>
                            <!-- Doc Type -->
                            <td>${escapeHtml(doc.vType)} </td>
                            <!-- Doc No -->
                            <td>${escapeHtml(doc.vNo)}</td>
                            <!-- Doc Date -->
                            <td>${escapeHtml(doc.vDate)}</td>
                            <!-- Department -->
                            <td>${escapeHtml(doc.department)} </td>
                            <!-- Owner -->
                            <td>${escapeHtml(doc.ownerName)} </td>
                            <!-- Place -->
                            <td>${escapeHtml(doc.place)}</td>
                            <!-- Valid Date -->
                            <td>${escapeHtml(doc.validDate)}</td>
                            <!-- Target Date -->
                            <td>${escapeHtml(doc.targetDate)}</td>
                            <!-- Remarks -->
                            <td>${escapeHtml(doc.remarks)}</td>
                            <!-- Status -->
                            <td>${escapeHtml(doc.status)}</td>
                            <!-- Action -->
                            <td class="action-col">
                            <div class="action-wrap">
                                <button class="act-btn edit btn-edit"  title="Edit" style="cursor:pointer;"  onclick="editPrintingRequestion('${doc.vNo || ''}', '${doc.vType || ''}')">
                                       <i class="fa fa-edit"></i>
                               </button>
                               <button class="act-btn view btn-view"  title="View" style="cursor:pointer;" onclick="viewPrintingRequestion('${doc.vNo || ''}', '${doc.vType || ''}')">
                                       <i class="fa fa-eye"></i>
                               </button>
                               <button class="act-btn delete btn-delete" title="Delete Row" data-vno="${doc.vNo}" data-vtype="${doc.vType}" onclick="deletePrintingRequestion(this)">
                               <i class="fa fa-trash"></i>
                               </button>
                           </div>
                            </td>
                        </tr>
                    `);
                });
                // Pagination
                renderPagination(totalCount, pageSize, currentPage);
                updatePageInfo(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                console.error( "Error:", xhr.responseText);
                toastr.error(
                    xhr.responseJSON?.message ||
                    "Error loading Printing Requisition List."
                );
            }
        });
    }
    // PAGINATION
    function renderPagination(total, pageSize, currentPage)
    {
        const totalPages = Math.ceil(total / pageSize);
        const pagination = $('#tablePagination');
        pagination.empty();
        // Previous button
        $('#prevBtn').prop('disabled', currentPage <= 1);
        // Next button
        $('#nextBtn').prop('disabled', currentPage >= totalPages);
        if (totalPages <= 1) {
            return;
        }
        let html = '';
        // First
        if (currentPage > 1) {
            html += `<button  class="btn btn-sm btn-light mx-1" onclick="goToPage(1)"> First </button>`;
        }
        // Previous
        if (currentPage > 1) {

            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }
        // Page Numbers
        const startPage = Math.max(1, currentPage - 2);
        const endPage = Math.min(totalPages, currentPage + 2);
        for (let i = startPage; i <= endPage; i++)
        {
            html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})"> ${i} </button>`;
        }
        // Next
        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})"> Next </button> `;
        }
        // Last
        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})"> Last </button>`;
        }
        pagination.html(html);
    }
    // GO TO PAGE
    function goToPage(page) {
        currentPage = page;
        loadPrintingRequestionList();
    }
    // PAGE INFO
    function updatePageInfo(total, pageSize, currentPage)
    {
        $('#pageInfoText').data('total', total);
        if (total === 0) {
            $('#pageInfoText').text('Results: 0 - 0 of 0');
            return;
        }
        const start = ((currentPage - 1) * pageSize) + 1;
        const end = Math.min(currentPage * pageSize, total);
        $('#pageInfoText').text(
            `Results: ${start} - ${end} of ${total}`
        );
    }
    // EDIT
    function editPrintingRequestion(vNo, vType) {
        window.location.href =`/PrintingRequestionEntry/Index?vNo=${encodeURIComponent(vNo)}&vType=${encodeURIComponent(vType)}&mode=edit`;
    }
    function viewPrintingRequestion(vNo, vType) {
        window.location.href = `/PrintingRequestionEntry/Index?vNo=${encodeURIComponent(vNo)}&vType=${encodeURIComponent(vType)}&mode=view`;
    }
    // DELETE
    function deletePrintingRequestion(el) {
        const vNo = $(el).data("vno");
        const vType = "PRPI";
        deleteRecordbytype("PrintingRequestionList", vNo, vType, {
            action: "Delete",
            text: "This will permanently delete the Printing Requisition entry.",
            successCallback: function (response) {
                console.log("Delete response:", response);
                toastr.success(response?.message || "Record deleted successfully.");
                // Delete ke baad list refresh
                loadPrintingRequestionList();
            }
        });
    }
    // HTML ENCODE
    function escapeHtml(value) {
        if (value === null || value === undefined)
        {
            return '';
        }
        return $('<div>').text(value).html();
    }

</script>