                                        <div class="erppage-datebox">
                                            <input type="date" class="erppage-input erppage-dateinput" id="DtMRNDate">
                                            <label class="erppage-checkbox-inside"><input type="checkbox" class="erppage-checkbox-input" id="chkMRNDate"></label>
                                        </div>
                                    </div>
                                    <div class="erppage-divfield erppage-datefield">
                                        <label class="erppage-label">Actual Cont. HO Date</label>
                                        <div class="erppage-datebox">
                                            <input type="date" class="erppage-input erppage-dateinput" id="DtActualContHODate">
                                            <label class="erppage-checkbox-inside"><input type="checkbox" class="erppage-checkbox-input" id="chkActualContHODate"></label>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>

                            <!-- Bills of Entry Related -->
                            <fieldset class="erppagefieldset">
                                <legend class="erppagefieldset-legend">Bills of Entry Related</legend>
                                <div class="erppage-grid2">
                                    <div class="erppage-divfield erppage-datefield">
                                        <label class="erppage-label">Custom OOC Date</label>
                                        <div class="erppage-datebox">
                                            <input type="date" class="erppage-input erppage-dateinput" id="DtCustomOOCDate">
                                            <label class="erppage-checkbox-inside"><input type="checkbox" class="erppage-checkbox-input" id="chkCustomOOCDate"></label>
                                        </div>
                                    </div>
                                    <div class="erppage-divfield">
