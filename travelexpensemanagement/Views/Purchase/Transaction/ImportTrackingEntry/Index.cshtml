<script>
    // Remove-file buttons: clear the file input (and file name box where present) of the same picker
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.erppage-filepicker').forEach(function (picker) {
            var file = picker.querySelector('input[type=file]');
            var nameBox = picker.querySelector('.erppage-filepicker-name');
            var remove = picker.querySelector('.erppage-filepicker-remove');
            if (nameBox) {
                file.addEventListener('change', function () {
                    nameBox.value = this.files.length ? this.files[0].name : '';
                });
            }
            remove.addEventListener('click', function () {
                file.value = '';
                if (nameBox) nameBox.value = '';
            });
        });
    });
</script>
