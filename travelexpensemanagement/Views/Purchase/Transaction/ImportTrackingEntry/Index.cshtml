                                        <label class="erppage-label">Shipping Line</label>
                                        <select class="erppage-input erppage-select" id="ddlShippingLine">
                                            <option value="">Select Shipping Line</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="erppage-grid2">
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">BL No.</label>
                                        <div class="erppage-filepicker">
                                            <input type="text" class="erppage-input" id="TxtBLNo" placeholder="Enter BL No">
                                            <label for="FileBL" class="erppage-filepicker-btn erppage-btn erppage-btn-common" title="Attach"><i class="fa fa-paperclip"></i></label>
                                            <button type="button" class="erppage-filepicker-btn" title="View"><i class="fa fa-eye"></i></button>
                                            <button type="button" class="erppage-filepicker-remove" title="Remove file"><i class="fa fa-times"></i></button>
                                            <input type="file" id="FileBL" hidden>
                                        </div>
                                    </div>
                                    <div class="erppage-divfield erppage-datefield">
                                        <label class="erppage-label">BL Dt.</label>
                                        <div class="erppage-datebox">
                                            <input type="date" class="erppage-input erppage-dateinput" id="DtBLDate">
                                            <label class="erppage-checkbox-inside"><input type="checkbox" class="erppage-checkbox-input" id="chkBLDate"></label>
                                        </div>
                                    </div>
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">VSL Name</label>
                                        <input type="text" class="erppage-input" id="TxtVSLName" placeholder="Enter Vessel Name">
                                    </div>
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">Free Days</label>
                                        <input type="number" class="erppage-input" id="NumFreeDays" placeholder="Enter Free Days">
                                    </div>
                                </div>
                                <div class="erppage-grid1">
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">Country of Origin</label>
                                        <select class="erppage-input erppage-select" id="ddlCountryOfOrigin">
                                            <option value="">Select Country of Origin</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="erppage-grid2">
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">POL</label>
                                        <select class="erppage-input erppage-select" id="ddlPOL">
                                            <option value="">Select POL</option>
                                        </select>
                                    </div>
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">POD</label>
                                        <select class="erppage-input erppage-select" id="ddlPOD">
                                            <option value="">Select POD</option>
                                        </select>
                                    </div>
                                    <div class="erppage-divfield">
