                                        <select class="erppage-input erppage-select" id="ddlSupplier">
                                            <option value="">Select Supplier</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="erppage-grid1">
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">Agent</label>
                                        <select class="erppage-input erppage-select" id="ddlAgent">
                                            <option value="">Select Agent</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="erppage-grid1">
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">Item Name</label>
                                        <select class="erppage-input erppage-select" id="ddlItemName">
                                            <option value="">Select Item</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="erppage-grid1">
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">Size Desp</label>
                                        <input type="text" class="erppage-input" id="TxtSizeDesp" placeholder="Enter Size Description">
