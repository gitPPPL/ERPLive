                                        <input type="text" class="erppage-input" id="TxtTestMemoNo" placeholder="Enter Test Memo No">
                                    </div>
                                    <div class="erppage-divfield erppage-datefield">
                                        <label class="erppage-label">Test Memo Date</label>
                                        <div class="erppage-datebox">
                                            <input type="date" class="erppage-input erppage-dateinput" id="DtTestMemoDate">
                                            <label class="erppage-checkbox-inside"><input type="checkbox" class="erppage-checkbox-input" id="chkTestMemoDate"></label>
                                        </div>
                                    </div>
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">Assessment Type</label>
                                        <select class="erppage-input erppage-select" id="ddlAssessmentType">
                                            <option value="">Select Assessment Type</option>
                                        </select>
                                    </div>
                                    <div class="erppage-divfield erppage-datefield">
                                        <label class="erppage-label">Ass. Date</label>
                                        <div class="erppage-datebox">
                                            <input type="date" class="erppage-input erppage-dateinput" id="DtAssDate">
                                            <label class="erppage-checkbox-inside"><input type="checkbox" class="erppage-checkbox-input" id="chkAssDate"></label>
                                        </div>
