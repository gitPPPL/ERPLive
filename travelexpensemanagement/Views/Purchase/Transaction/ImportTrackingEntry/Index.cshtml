                                        </div>
                                    </div>
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">Sample Collected?</label>
                                        <select class="erppage-input erppage-select" id="ddlSampleCollected">
                                            <option value="">Select</option>
                                        </select>
                                    </div>
                                    <div class="erppage-divfield erppage-datefield">
                                        <label class="erppage-label">Sample Test Report Dt</label>
                                        <div class="erppage-datebox">
                                            <input type="date" class="erppage-input erppage-dateinput" id="DtSampleTestReportDate">
                                            <label class="erppage-checkbox-inside"><input type="checkbox" class="erppage-checkbox-input" id="chkSampleTestReportDate"></label>
                                        </div>
                                    </div>
                                    <div class="erppage-divfield erppage-datefield">
                                        <label class="erppage-label">Sample Coll. Date</label>
                                        <div class="erppage-datebox">
                                            <input type="date" class="erppage-input erppage-dateinput" id="DtSampleCollDate">
                                            <label class="erppage-checkbox-inside"><input type="checkbox" class="erppage-checkbox-input" id="chkSampleCollDate"></label>
                                        </div>
