                                            <button type="button" class="erppage-filepicker-btn" title="View"><i class="fa fa-eye"></i></button>
                                            <button type="button" class="erppage-filepicker-remove" title="Remove file"><i class="fa fa-times"></i></button>
                                            <input type="file" id="FileSupplierInv" hidden>
                                        </div>
                                    </div>
                                    <div class="erppage-divfield erppage-datefield">
                                        <label class="erppage-label">Inv Dt</label>
                                        <div class="erppage-datebox">
                                            <input type="date" class="erppage-input erppage-dateinput" id="DtInvDate">
                                            <label class="erppage-checkbox-inside"><input type="checkbox" class="erppage-checkbox-input" id="chkInvDate"></label>
                                        </div>
                                    </div>
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">Sup. Inv Value</label>
                                        <div class="erppage-inputgroup">
                                            <input type="number" class="erppage-input" id="NumSupInvValue" placeholder="Enter Value">
                                            <select class="erppage-input erppage-select" id="ddlCurrency">
