                                        <input type="date" class="erppage-input" id="DtETDDate">
                                    </div>
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">ETA Dt</label>
                                        <input type="date" class="erppage-input" id="DtETADate">
                                    </div>
                                    <div class="erppage-divfield erppage-datefield">
                                        <label class="erppage-label">Rail Dt</label>
                                        <div class="erppage-datebox">
                                            <input type="date" class="erppage-input erppage-dateinput" id="DtRailDate">
                                            <label class="erppage-checkbox-inside"><input type="checkbox" class="erppage-checkbox-input" id="chkRailDate"></label>
                                        </div>
                                    </div>
                                    <div class="erppage-divfield erppage-datefield">
                                        <label class="erppage-label">ICD Dt</label>
                                        <div class="erppage-datebox">
                                            <input type="date" class="erppage-input erppage-dateinput" id="DtICDDate">
                                            <label class="erppage-checkbox-inside"><input type="checkbox" class="erppage-checkbox-input" id="chkICDDate"></label>
                                        </div>
                                    </div>
                                    <div class="erppage-divfield erppage-datefield">
                                        <label class="erppage-label">Mov. Date</label>
                                        <div class="erppage-datebox">
                                            <input type="date" class="erppage-input erppage-dateinput" id="DtMovDate">
                                            <label class="erppage-checkbox-inside"><input type="checkbox" class="erppage-checkbox-input" id="chkMovDate"></label>
                                        </div>
                                    </div>
                                    <div class="erppage-divfield erppage-datefield">
                                        <label class="erppage-label">Tent. Cont. HO Ret. Date</label>
                                        <div class="erppage-datebox">
                                            <input type="date" class="erppage-input erppage-dateinput" id="DtTentContHORetDate">
