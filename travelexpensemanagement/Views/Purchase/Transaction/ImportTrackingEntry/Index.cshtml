@{
    ViewBag.Title = "Import Tracking Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>

<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-ship"></i>
        </div>
        <div class="erppage-header-title">Import Tracking</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "ImportTrackingList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>

<div id="ImportTrackingForm">
    <input type="hidden" class="form-control" id="TxtCode" name="CODE">
    <div class="erppage-container">
        <div class="erppage-fieldset">

            <div class="erppage-tabs">
                <button class="erppage-tab active" data-tab="generalinfo">General Info</button>
                <button class="erppage-tab" data-tab="paymentinfo">Payment Related Info</button>
                <button class="erppage-tab" data-tab="otherinfo">Other Information</button>
                <button class="erppage-tab" data-tab="importexpenses">Import Expenses</button>
            </div>

            <!-- ================= GENERAL INFO ================= -->
            <div class="erppage-tab-content active" id="generalinfo">
                <div class="erppage-accordion-body">
                    <div class="erppagesrow">
                        <div class="erppagescol-6">
                            <!-- Basic Information -->
                            <fieldset class="erppagefieldset">
                                <legend class="erppagefieldset-legend">Basic Information</legend>
                                <div class="erppage-grid2">
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">Doc Type</label>
                                        <select class="erppage-input erppage-select" id="ddlDocType">
                                            <option value="">Select Doc Type</option>
                                        </select>
                                    </div>
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">Sauda No</label>
                                        <input type="text" class="erppage-input" id="TxtSaudaNo" placeholder="Enter Sauda No" disabled>
                                    </div>
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">Doc No</label>
                                        <input type="number" class="erppage-input" id="NumDocNo" placeholder="Enter Doc No" disabled>
                                    </div>
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">Sauda Date</label>
                                        <input type="date" class="erppage-input" id="DtSaudaDate" disabled>
                                    </div>
                                    <div class="erppage-divfield">
                                        <label class="erppage-label">Doc Date</label>
                                        <input type="date" class="erppage-input" id="DtDocDate">
                                    </div>
                                </div>
                                <div class="erppage-grid2">
                                    <div class="erppage-divfield">
