@{
    ViewBag.Title = "Import Tracking Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    /* Prevent Supplier PI No column from growing */
    .erppage-grid3 > .erppage-divfield {
        min-width: 0;
    }

    /* Keep the input group within its column */
    .erppage-divfield .erppage-filepicker {
        width: 100%;
        min-width: 0;
    }
    /* Filename row must match the input width */
    .erppage-filechip {
        display: flex;
        align-items: center;
        gap: 6px;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
        overflow: hidden;
        margin-top: 4px;
        padding: 0;
        border: none;
        background: transparent;
    }

        .erppage-filechip[hidden] {
            display: none !important;
        }

    /* ===== ATTACHMENT FILE NAME ===== */
    .erppage-filechip-name {
        display: block;
        flex: 1 1 0;
        width: 0;
        min-width: 0;
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 11px;
        font-weight: 600;
        color: #334155;
        letter-spacing: 0.15px;
        line-height: 20px;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        cursor: pointer;
        transition: color 0.2s ease;
    }
    /* View and delete: icon only, no button appearance */
    .erppage-file-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        width: auto;
        height: auto;
        margin: 0;
        padding: 0;
        border: none;
        border-radius: 0;
        background: transparent !important;
        box-shadow: none;
        cursor: pointer;
        font-size: 13px;
    }

        /* Green eye icon */
        .erppage-file-icon.view-icon {
            color: #1c5e31;
        }

        /* Red delete icon */
        .erppage-file-icon.delete-icon {
            color: #dc2626;
        }

        /* Hover only changes icon color */
        .erppage-file-icon.view-icon:hover {
            color: #2f7d32;
        }

        .erppage-file-icon.delete-icon:hover {
            color: #991b1b;
        }
    
    /* Eye and delete icons alignment */
    .erppage-filechip .erppage-file-icon {
        flex-shrink: 0;
        font-size: 12px;
        transition: color 0.2s ease;
    }
    /* Filename hover */
    .erppage-filechip-name:hover {
        color: #2563eb;
        text-decoration: underline;
        text-underline-offset: 2px;
    }
    /* View icon */
    .erppage-filechip .view-icon {
        color: #16803c;
        font-size: 13px;
        flex-shrink: 0;
    }

    /* Delete icon */
    .erppage-filechip .delete-icon {
        color: #dc2626;
        font-size: 13px;
        flex-shrink: 0;
    }
    /* Icons hover */
    .erppage-filechip .view-icon:hover {
        color: #14532d;
    }

    .erppage-filechip .delete-icon:hover {
        color: #991b1b;
    }

    .erppage-filepicker-btn.disabled {
        pointer-events: none; /* click band */
        opacity: .5; /* grey look */
        cursor: not-allowed;
    }

</style>
