                                    <div class="erppage-divfield erppage-datefield">
                                        <label class="erppage-label">BE Date</label>
                                        <div class="erppage-datebox">
                                            <input type="date" class="erppage-input erppage-dateinput" id="DtBEDate">
                                            <label class="erppage-checkbox-inside"><input type="checkbox" class="erppage-checkbox-input" id="chkBEDate"></label>
                                        </div>
