@{
    ViewBag.Title = "Pending Sauda Order List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>Pending Sauda Order List</span>
    </div>
    <div class="erppagelist-header-right">
        <button class="erppage-header-back" onclick="window.location.href='@Url.Action("Index", "PendingSaudaOrder")'">
            <i class="fa fa-plus"></i>Add New
        </button>
    </div>
</div>
<div class="erppagelist-toolbar">
    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" id="searchBox" placeholder="Search Module..." />
    </div>
    <div class="erppagelist-actions">
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report">
            <i class="fa fa-print"></i> Print
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Export to Excel">
            <i class="fa fa-file-excel"></i> Export
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail">
            <i class="fa fa-envelope"></i> Mail
        </button>
        <button class="erppagelist-btn erppagelist-btn-approve tooltip-btn" data-tooltip="Approve Records">
            <i class="fa fa-check-circle"></i> Approved
        </button>
    </div>
</div>
<div class="erppagelist-container">
    <div class="excel-wrapper fixed-grid-wrapper">
        <table id="tblPendingSaudaOrderList" class="excel-table fixed-grid-table table-width resizable-table">
            <colgroup>
                <col style="width:80px;">   
                <col style="width: 82px;">  
                <col style="width: 139px;"> 
                <col style="width:90px;">   
                <col style="width:100px;">  
                <col style="width:100px;">  
                <col style="width: 163px;"> 
                <col style="width: 181px;"> 
                <col style="width:80px;">   
                <col style="width: 63px;">  
                <col style="width:90px;">   
                <col style="width:90px;">   
                <col style="width: 111px;"> 
                <col style="width: 106px;"> 
                <col style="width: 67px;">  
                <col style="width:80px;">   
            </colgroup>
            <thead>
                <tr>
                    <th>Doc Type</th>
                    <th>Doc No</th>
                    <th>Doc Date</th>
                    <th>Ref Type</th>
                    <th>Ref No</th>
                    <th>Ref Date</th>
                    <th>Party Name</th>
                    <th>Item Name</th>
                    <th>Quantity</th>
                    <th>Rate</th>
                    <th>Adj Quantity</th>
                    <th>Bal Quantity</th>
                    <th>Remarks</th>
                    <th>Add Quantity</th>
                    <th>Reason</th>
                    <th class="action-col">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    <div class="erppagelist-pagination">
        <div class="pagination-left">
            <select id="pageSizeSelect">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="pagination-center">
            <button class="page-nav" id="prevBtn">‹</button>
            <div id="tablePagination" class="page-numbers"></div>
            <button class="page-nav" id="nextBtn">›</button>
        </div>
        <div class="pagination-right" id="pageInfoText">
            Results: 0 - 0 of 0
        </div>
    </div>
</div>


<script>
    // Global Variable getting from controller
    var compCode = '@ViewBag.CompCode';
    var branchCode = '@ViewBag.BranchCode';
    var yearCode = '@ViewBag.YearCode';
    let currentPage = 1;
    let pageSize = 10;

    $(document).ready(function () {
        loadAllItemRateList();
    });

    function loadAllItemRateList() {
        const searchTerm = $('#searchBox').val();

        $.ajax({
            url: '/ItemMarketRateList/GetAllItemRateList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                const lists = res.itemRates;
                const totalCount = res.totalCount;

                let tbody = $('#tblPendingSaudaOrderList tbody');
                tbody.empty();

                if (!lists || lists.length === 0) {
                    tbody.append('<tr><td colspan="11" class="text-center text-muted">No records found.</td></tr>');
                    renderPagination(0, pageSize, currentPage);
                    return;
                }

                   $.each(lists, function (index, item) {
                    tbody.append(`
                        <tr>
                            <td>${item.v_TYPE || ''}</td>
                            <td>${item.v_NO || ''}</td>
                            <td>${item.v_DATE || ''}</td>
                            <td>${item.ref_TYPE || ''}</td>
                            <td>${item.ref_NO || ''}</td>
                            <td>${item.ref_DATE || ''}</td>
                            <td>${item.party_NAME || ''}</td>
                            <td>${item.item_NAME || ''}</td>
                            <td>${item.qty || ''}</td>
                            <td>${item.rate || ''}</td>
                            <td>${item.adj_QTY || ''}</td>
                            <td>${item.bal_QTY || ''}</td>
                            <td>${item.remarks || ''}</td>
                            <td>${item.add_QTY || ''}</td>
                            <td>${item.reason || ''}</td>
                            <td class="action-col">
                                <div class="action-wrap">
                                    <button class="act-btn edit btn-edit" title="Edit Row" onclick="editPendingSaudaOrder(${item.v_NO})">
                                        <i class="fa fa-edit"></i>
                                    </button>
                                    <button class="act-btn view btn-view" title="View Row" onclick="viewPendingSaudaOrder(${item.v_NO})">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                    <button class="act-btn delete btn-delete" title="Delete Row" onclick="deletePendingSaudaOrder(${item.v_NO}, '${item.v_TYPE}')">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `);
                 });

                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                toastr.error('Error loading UOM data: ' + xhr.responseText);
            }
        });
    }

    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const paginationContainer = $('#tablePagination');
        paginationContainer.empty();

        if (totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        if (currentPage <= 3) endPage = Math.min(5, totalPages);
        if (currentPage >= totalPages - 2) startPage = Math.max(totalPages - 4, 1);

        for (let i = startPage; i <= endPage; i++) {
            html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        paginationContainer.html(html);
    }

    function goToPage(page) {
        currentPage = page;
        loadAllItemRateList();
    }

    $('#searchBox').on('keyup', function () {
        currentPage = 1;
        loadAllItemRateList();
    });

    function editPendingSaudaOrder(code) {
        window.location.href = '/PendingSaudaOrder/Index?id=' + encodeURIComponent(code);
    }

    function viewPendingSaudaOrder(code) {
        window.location.href = '/PendingSaudaOrder/Index?id=' + encodeURIComponent(code) + '&readOnly=true';
    }

    function deletePendingSaudaOrder(code,vType) {
        Swal.fire({
            title: 'Are you sure?',
            text: "This will permanently delete the quotation.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/PendingSaudaOrderList/DeletePendingSaudaOrderByCode',
                    type: 'POST',
                    data: {
                        code: code,
                        vType: vType,
                        compCode: compCode,
                        branchCode: branchCode,
                        yearCode: yearCode
                    },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Deleted!', response.message, 'success').then(() => {
                                loadAllItemRateList();
                            });
                        } else {
                            Swal.fire('Failed', response.message, 'warning');
                        }
                    },
                    error: function () {
                        Swal.fire('Error!', 'An error occurred while deleting.', 'error');
                    }
                });
            }
        });
    }

</script>