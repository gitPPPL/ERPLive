@{
    ViewBag.Title = "Item Market Rate List";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<fieldset>
    <legend class="legend-field">Item Market Rate List</legend>
    <div class="row">
        <div class="col-lg-6">
            <div class="input-group shadow-sm rounded-pill overflow-hidden">
                <input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
            </div>
        </div>
        <div class="col-lg-6">
            <div class="btn-rightalign">
                <button onclick="window.location.href='@Url.Action("Index", "ItemMarketRate")'" type="button" class="btn btn-add">
                    <i class="fa fa-plus"></i>Add
                </button>
                <button class="btn btn-print" onclick="printCityMasterReport()">
                    <i class="fa fa-print"></i> Print
                </button>
                <button class="btn btn-export">
                    <i class="fas fa-file-export"></i> Export
                </button>
                <button class="btn btn-mail">
                    <i class="fa fa-envelope"></i> Mail
                </button>
                <button class="btn btn-approved">
                    <i class="fa fa-check"></i> Approved
                </button>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="table-responsive">
            <table id="tblItemMarketRate" class="table-width">
                <thead class="table-head">
                    <tr>
                        <th style="display:none;">Code</th>
                        <th>Document Type</th>
                        <th>Document No</th>
                        <th>Document Date</th>
                        <th>Group Type</th>
                        <th>Remarks</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <!-- Pagination container -->
        <div class="row">
            <div class="col-md-12">
                <div class="pagination-end">
                    <div class="custom-pagination" id="tablePagination"></div>
                </div>
            </div>
        </div>
    </div>



</fieldset>

<script>

    // Global Variable getting from controller
    var compCode = '@ViewBag.CompCode';
    var branchCode = '@ViewBag.BranchCode';
    var yearCode = '@ViewBag.YearCode';


    let currentPage = 1;
    let pageSize = 10;

    $(document).ready(function () {
        loadAllItemRateList();
    });

    function loadAllItemRateList() {
        const searchTerm = $('#searchBox').val();

        $.ajax({
            url: '/ItemMarketRateList/GetAllItemRateList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                const lists = res.itemRates;
                const totalCount = res.totalCount;

                let tbody = $('#tblItemMarketRate tbody');
                tbody.empty();

                if (!lists || lists.length === 0) {
                    tbody.append('<tr><td colspan="11" class="text-center text-muted">No records found.</td></tr>');
                    renderPagination(0, pageSize, currentPage);
                    return;
                }

                $.each(lists, function (index, item) {
                    tbody.append(`
                        <tr>
                            <td style="display:none;">${item.comP_CODE}</td>
                            <td style="display:none;">${item.brancH_CODE}</td>
                            <td style="display:none;">${item.yeaR_CODE}</td>
                            <td>${item.v_TYPE || ''}</td>
                            <td>${item.v_NO || ''}</td>
                            <td>${item.v_DATE || ''}</td>
                            <td>${item.mgrouP_TYPE || ''}</td>
                            <td>${item.remarks || ''}</td>
                            <td>
                                <i class="fa fa-edit btn-edit" title="Edit" onclick="editItemMarketRate(${item.v_NO})"></i>
                                <i class="fa fa-eye btn-view" title="View" onclick="viewItemMarketRate(${item.v_NO})"></i>
                                <i class="fa fa-trash btn-delete" title="Delete" onclick="deleteItemMarketRate(${item.v_NO},'${item.v_TYPE}')"></i>
                            </td>
                        </tr>
                    `);
                });

                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                toastr.error('Error loading UOM data: ' + xhr.responseText);
            }
        });
    }

    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const paginationContainer = $('#tablePagination');
        paginationContainer.empty();

        if (totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        if (currentPage <= 3) endPage = Math.min(5, totalPages);
        if (currentPage >= totalPages - 2) startPage = Math.max(totalPages - 4, 1);

        for (let i = startPage; i <= endPage; i++) {
            html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        paginationContainer.html(html);
    }

    function goToPage(page) {
        currentPage = page;
        loadAllItemRateList();
    }

    $('#searchBox').on('keyup', function () {
        currentPage = 1;
        loadAllItemRateList();
    });

    function editItemMarketRate(code) {
        window.location.href = '/ItemMarketRate/Index?id=' + encodeURIComponent(code);
    }

    function viewItemMarketRate(code) {
        window.location.href = '/ItemMarketRate/Index?id=' + encodeURIComponent(code) + '&readOnly=true';
    }

    function deleteItemMarketRate(code,vType) {
        Swal.fire({
            title: 'Are you sure?',
            text: "This will permanently delete the quotation.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/ItemMarketRateList/DeleteItemMarketRateByCode',
                    type: 'POST',
                    data: {
                        code: code,
                        vType: vType,
                        compCode: compCode,
                        branchCode: branchCode,
                        yearCode: yearCode
                    },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Deleted!', response.message, 'success').then(() => {
                                loadAllItemRateList();
                            });
                        } else {
                            Swal.fire('Failed', response.message, 'warning');
                        }
                    },
                    error: function () {
                        Swal.fire('Error!', 'An error occurred while deleting.', 'error');
                    }
                });
            }
        });
    }


</script>