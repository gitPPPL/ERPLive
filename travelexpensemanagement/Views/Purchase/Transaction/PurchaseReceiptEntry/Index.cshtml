            data: { code: code },
            success: function (response) {
                if (response) {
                    // Set values
                    $('#txtAddLine1').val(response.address1).prop('readonly', true);
                    $('#txtAddLine2').val(response.address2).prop('readonly', true);
                    $('#txtAddLine3').val(response.address3).prop('readonly', true);
