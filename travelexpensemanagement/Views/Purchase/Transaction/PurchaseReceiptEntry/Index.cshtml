@{
    ViewBag.Title = "Purchase Receipt Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<fieldset>
    <legend class="legend-field">Purchase Receipt Entry</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="window.location.href='@Url.Action("Index", "PurchaseReceiptEntryList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>

    <form id="PurchaseReceiptEntryForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlDocType"><span class="required">*</span>Doc Type</label>
                    <select class="form-control" id="ddlDocType">
                        <option>--Select DOC Type--</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumDocNo"><span class="required">*</span>Doc No</label>
                    <input type="text" class="form-control" id="NumDocNo" placeholder="Enter Doc No">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DtDocDate"><span class="required">*</span>Doc Date</label>
                    <input type="date" class="form-control" id="DtDocDate" name="DocDate">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtGateNo"><span class="required">*</span>Gate No</label>
                    <select class="form-control" id="ddlGateNo">
                        <option value="0">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <!-- Bill From Section -->
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Bill Details</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ddlBillFrom"><span class="required">*</span>Bill From</label>
                                <select class="form-control" id="ddlBillFrom">
                                    <option>--Select Bill From--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtAddLine1">Add Line1</label>
                                <div class="input-divide">
                                    <input type="text" class="form-control" id="txtAddLine1" placeholder="Enter Address Line 1">
                                    <div class="select-wrapper">
                                        <select id="ddladdressBD1">
                                            <option value="">Select address</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtAddLine2">Address Line 2</label>
                                <input type="text" class="form-control" id="txtAddLine2" placeholder="Enter Address">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtAddLine3">Address Line 3</label>
                                <input type="text" class="form-control" id="txtAddLine3" placeholder="Enter Address">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlCity">City</label>
                                <select class="form-control" id="ddlCity">
                                    <option>--Select City--</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="txtPincode">Pincode</label>
                                <input type="number" class="form-control" id="txtPincode" data-maxlength="6" placeholder="Enter Pincode">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlState">State</label>
                                <select class="form-control" id="ddlState">
                                    <option>--Select State--</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="txtGST">GST</label>
                                <input type="text" class="form-control" id="txtGST" placeholder="Enter GST">
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <!-- Ship From Section -->
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Ship Details</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ddlShipFrom"><span class="required">*</span>Ship From</label>
                                <select class="form-control" id="ddlShipFrom">
                                    <option>--Select Ship From--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtShipAddLine1">Add Line1</label>
                                <div class="input-divide">
                                    <input type="text" class="form-control" id="txtShipAddLine1" placeholder="Enter Address">
                                    <div class="select-wrapper">
                                        <select id="ddladdressSD1">
                                            <option value="">Select address</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtShipAddLine2">Address Line 2</label>
                                <input type="text" class="form-control" id="txtShipAddLine2" placeholder="Enter Address">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtShipAddLine3">Address Line 3</label>
                                <input type="text" class="form-control" id="txtShipAddLine3" placeholder="Enter Address">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlShipCity">City</label>
                                <select class="form-control" id="ddlShipCity">
                                    <option>--Select City--</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="NumShipPincode">Pincode</label>
                                <input type="number" class="form-control" id="NumShipPincode" data-maxlength="6" placeholder="Enter Pincode">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlShipState">State</label>
                                <select class="form-control" id="ddlShipState">
                                    <option>--Select State--</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="txtShipGST">GST</label>
                                <input type="text" class="form-control" id="txtShipGST" placeholder="Enter GST">
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Document Details</legend>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="txtBillNo"><span class="required">*</span>Bill No</label>
                                <input type="text" class="form-control" id="txtBillNo" placeholder="Enter Bill No">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtBillDate"><span class="required">*</span>Bill Date</label>
                                <input type="date" class="form-control" id="DtBillDate" name="BillDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="NumChallanNo">Challan No</label>
                                <input type="number" class="form-control" id="NumChallanNo" placeholder="Enter Challan No">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtChallanDate"><span class="required">*</span>Challan Date</label>
                                <input type="date" class="form-control" id="DtChallanDate" name="ChallanDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtWaybillNo">Waybill No</label>
                                <input type="text" class="form-control" id="TxtWaybillNo" placeholder="Enter Waybill No">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtWaybillDate">Waybill Date</label>
                                <input type="date" class="form-control" id="DtWaybillDate" name="WaybillDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtWaybillInvNo">Waybill Inv No</label>
                                <input type="text" class="form-control" id="TxtWaybillInvNo" placeholder="Enter Waybill Inv No">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtWaybillExpiry">Waybill Expiry</label>
                                <input type="date" class="form-control" id="DtWaybillExpiry" name="WaybillExpiry">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlReturnType"><span class="required">*</span>Return Type</label>
                                <select class="form-control" id="ddlReturnType">
                                    <option value="NA">NA</option>
                                    <option value="Return">Return</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="txtExchangeRate">Ex-Rate (Rs/USD)</label>
                                <input type="text" class="form-control" id="txtExchangeRate" name="ExchangeRate" placeholder="Enter Ex-Rate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlDocStatus"><span class="required">*</span>Doc. Status</label>
                                <select class="form-control" id="ddlDocStatus">
                                    <option value="0">Select</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="txtNetAmount">Net Amount</label>
                                <input type="text" class="form-control" id="txtNetAmount" name="NetAmount" placeholder="Enter Net Amount">
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <fieldset class="fieldset-sub">
                    <legend class="sub-legend">Item Total</legend>
                    <div class="row">
                        <div class="col-md-10">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumReceivedQty">Received Qty</label>
                                        <input type="number" class="form-control" id="NumReceivedQty" readonly placeholder="Enter Received Qty">
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumBillQty">Bill Qty</label>
                                        <input type="number" class="form-control" id="NumBillQty" readonly placeholder="Enter Bill Qty">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumAmount">Amount</label>
                                        <input type="number" class="form-control" id="NumAmount" readonly placeholder="Enter Amount">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumPacking">Packing</label>
                                        <input type="number" class="form-control" id="NumPacking" readonly placeholder="Enter Packing Amt">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumDiscount">Discount</label>
                                        <input type="number" class="form-control" id="NumDiscount" readonly placeholder="Enter Discount Amt">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumCGST">CGST</label>
                                        <input type="number" class="form-control" id="NumCGST" readonly placeholder="Enter CGST">
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumSGST">SGST</label>
                                        <input type="number" class="form-control" id="NumSGST" readonly placeholder="Enter SGST">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumIGST">IGST</label>
                                        <input type="number" class="form-control" id="NumIGST" readonly placeholder="Enter IGST">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumCESS">CESS</label>
                                        <input type="number" class="form-control" id="NumCESS" readonly placeholder="Enter CESS">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumVAT">VAT</label>
                                        <input type="number" class="form-control" id="NumVAT" readonly placeholder="Enter VAT">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumOtherAmt">Other Amt</label>
                                        <input type="number" class="form-control" id="NumOtherAmt" readonly placeholder="Enter Other Amount">
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumTCSPer">TCS %</label>
                                        <div class="input-divide">
                                            <input type="number" class="form-control" id="NumTCSPer1" readonly placeholder="Enter TCS %">
                                            <input type="number" class="form-control" id="NumTCSPer2" readonly placeholder="Enter TCS %">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumSubTotal">Sub Total</label>
                                        <input type="number" class="form-control" id="NumSubTotal" readonly placeholder="Enter Sub Total">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumRoundOff">Round Off</label>
                                        <input type="number" class="form-control" id="NumRoundOff" readonly placeholder="Enter Round Off">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumFinalNetAmt">Net Amount</label>
                                        <input type="number" class="form-control" id="NumFinalNetAmt" readonly placeholder="Enter Net Amount">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="ddlPaymentIT">Payment</label>
                                        <select class="form-control" id="ddlPaymentIT">
                                            <option value="NA">NA</option>
                                            <option value="Hold">Hold</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="txtReason">Reason</label>
                                        <input type="text" class="form-control" id="txtReason" placeholder="Enter Reason">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="DtHoldDate">Hold Date</label>
                                        <input type="date" class="form-control" id="DtHoldDate">
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="btn-mt button-right">
                                        <button type="button" class="btn btn-primary">
                                            <i class="fa fa-print"></i> Pending Gate Inward
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="Remarks">Remarks</label>
                                <textarea type="text" class="form-height" id="txtremarks" placeholder="Enter Remarks"></textarea>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>

        <!--indendorderstoreModal-->
        <div class="modal fade" id="indendorderstoreModal" tabindex="-1" aria-labelledby="indendorderstoreModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content draggable-modal">
                    <div class="popup-header">
                        <h5 class="popup-title" id="indendorderstoreModalLabel">Copy From</h5>
                        <i class="fa fa-times" data-bs-dismiss="modal" style="cursor: pointer;" aria-label="Close"></i>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-4">
                                <div class="input-group shadow-sm rounded-pill overflow-hidden">
                                    <input type="text" id="searchBoxIOSM" class="form-control border-0" placeholder="Search Module..." aria-label="Search term" />
                                </div>
                            </div>
                            <div class="col-lg-2">
                                <div class="form-group mt-2">
                                    <div class="form-row">
                                        <input type="checkbox" id="chkAppendIOSM">
                                        <label class="checkbox-label" for="chkAppendIOSM">Append</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="btn-rightalign">
                                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><i class="fa fa-copy"></i>Copy</button>
                                   @*  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa fa-close"></i>Close</button> *@
                                </div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="table-responsive table-height">
                                <table id="tblindendorderstore" class="table-width">
                                    <thead class="table-head">
                                        <tr>
                                            <th><input type="checkbox" id="selectAllIOSM" /></th>
                                            <th>Vno</th>
                                            <th>Vtype</th>
                                            <th>Vdate</th>
                                            <th>Item Code</th>
                                            <th>Item Name</th>
                                            <th>Unit</th>
                                            <th>Nos</th>
                                            <th>Qty</th>
                                            <th>Balqty</th>
                                            <th>Rate</th>
                                            <th>Taxtype</th>
                                            <th>Pack%</th>
                                            <th>Disc%</th>
                                            <th>Cgst%</th>
                                            <th>Sgst%</th>
                                            <th>Igst%</th>
                                            <th>Cess%</th>
                                            <th>Cess</th>
                                            <th>Vat%</th>
                                            <th>Oth Amt</th>
                                            <th>Make</th>
                                            <th>Department</th>
                                            <th>Remarks</th>
                                            <th>Req Type</th>
                                            <th>Req No</th>
                                            <th>Deptcode</th>
                                            <th>Make Code</th>
                                            <th>UCode</th>
                                            <th>Taxcode</th>
                                            <th style="display:none;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
       
        <div class="navtab-form" style="margin-top:15px;">
            <div class="row">
                <div class="col-md-10">
                    <ul class="nav nav-tabs" id="formTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" id="tab1-tab" data-bs-toggle="tab" data-bs-target="#tab1" type="button" role="tab">Item Record</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="tab3-tab" data-bs-toggle="tab" data-bs-target="#tab3" type="button" role="tab">Attachment</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="tab4-tab" data-bs-toggle="tab" data-bs-target="#tab4" type="button" role="tab">Transport</button>
                        </li>
                    </ul>
                 </div>
                <div class="col-md-2">
                    <div class="dropdown">
                        <select class="form-control custom-dropdown" id="ddlcopyFromDropdown">
                            <option>--Select Order Type--</option>
                        </select>
                    </div>
                </div>
            </div>
           
            @* Add List box showing block Start *@
            <div class="tab-content">
                <!-- tab 1 -->
                <div class="tab-pane fade show active" id="tab1">
