</fieldset>

<script>
    const $tbody = $('#tblItemDetailsPR tbody');
    const $attachmentTbody = $('#tblAttachmentPR tbody');
    const statusOptions ={ 1: "Pending", 2: "Approved", 3: "Rejected" };
    const Approvstatus = ["Approved", "Hold","Reject"];
    const priorityOptions = ["Low", "Medium", "High"];
    const scrapOptions = ["Yes" , "No"];
    const workOptions = ["Maintenance", "Project", "Operation"];
    const urlParams = new URLSearchParams(location.search);
    const rowId = urlParams.get('id');
    const mode = urlParams.get('mode');
    const isReadOnly = urlParams.get('readOnly') === 'true';
    const rowDataArray = [];
    let ItemMap = {};
    let MakeMap = {};
    let PlaceUseMap = {};

     $(document).ready(async function () {
  
        if (!rowId) {
            GetVNo();
            document.getElementById('DtDocDate').valueAsDate = new Date();
            document.getElementById("ddlStatus").disabled = true;
        }
        
        LoadDropDown().then(() => {
        if (rowId) {
            return LoadFormByID(rowId).then(() => {
            });
        }
    });

        addAttachmentRow({ index: 0 });

        if (mode === "view") {
        setFormReadOnly();
           $('#PurchaseRequestForm').after(
          '<span class="badge bg-secondary ms-2">Read‑Only Mode</span>'
        );
    }

        $('#ddlDepartment').on('change', function () {
        const selectedValue = this.value;
        const docDate = $('#DtDocDate').val();
        if (!docDate) {
            toastr.warning('Please select a valid Doc Date before proceeding.');
            $("#DtDocDate").focus();
            return;
        }
            fetchDDlItems(selectedValue);
        });
        
        $(document).on('change', 'select.ddlItem', function () {
        const selectedId = $(this).val();
        const $row = $(this).closest('tr');
              fetchPendingQty(selectedId, $row)
            .then(() => {
               return fetchTotal_Qty(selectedId, $row);
            })
            .then(() => {
                 return fetchTECH_DESC(selectedId, $row);
            })
            .then(() => {
              return fetchCurrentStock(selectedId, $row);
            })
            .then(() => {
              return fetchAvgConsumption(selectedId, $row);
            })

            .then(() => {
               return FetchDDlMake(selectedId, $row);
            })
            .then(() => {
                return fetchUnit(selectedId, $row);
            })
            .catch((err) => {
                console.error('Error in fetch chain:', err);
            });
    });
    
        $("#btnSaves").click(function (e) {
        e.preventDefault();
        const DOC_ID = $.trim($('#TxtCode').val());
        const V_NO = parseFloat($.trim($('#NumDocNo').val())) || 0;
        const V_DATE = formatDate($("#DtDocDate").val());
        const DEPT_CODE = parseInt($('#ddlDepartment').val()) || 0;
        const TARGET_DATE = formatDate($("#DtRequiredDate").val());
        const REASON = $.trim($('#txtRequiredDate').val());
        const PLACE_CODE = parseInt($('#ddlPlace').val()) || 0;
        const URGENT_REQUEST = $('#chkUrgentRequest').prop('checked') ? 1 : 0;
        const STATUS = parseInt($('#ddlStatus').val()) || 0;
        const OWNER_CODE = parseInt($.trim($('#ddlRequester').val())) || 0;
        const OWNER_NAME = $.trim($('#ddlRequester option:selected').text()) || "";
        const PLAN_NO = parseInt($.trim($('#ddlPlanComplain').val())) || 0;
        const PLAN_TYPE = $.trim($('#ddlPlanComplain option:selected').text()) || "";
        const REMARKS = $.trim($('#txtRemarks').val());
        const ACTION = (!DOC_ID || DOC_ID.trim() === '') ? 'INSERT' : 'UPDATE';

            if (!validateRequiredField('#ddlDepartment', 'Department')) return;
            if (!validateRequiredField('#DtRequiredDate', 'Required Date')) return;
            if (!validateRequiredField('#DtDocDate', ' Doc Date.')) return;
            if (!validateRequiredField('#ddlPlace', 'Place.')) return;
            if (!validateRequiredField('#ddlStatus', 'Status.')) return;
            if (!validateRequiredField('#ddlRequester', 'Requester.')) return;
           // const rowsData = collectRowsData();
            const AttachmentsRowsData = collectPurchaseDocumentsData();

          const $rows = $tbody.find('tr');
    let hasAtLeastOneItem = false;

    for (let i = 0; i < $rows.length; i++) {
        const $row = $rows.eq(i);
        const itemName = $row.find('.ddlItem option:selected').text().trim();

        if (itemName !== '' && itemName.toLowerCase() !== 'select') {
            hasAtLeastOneItem = true;

            const isValid = validateItemRow($row, `Row ${i + 1}`);
            if (!isValid) {
                // Stop at the first failed row
                return;
            }
        }
    }

    if (!hasAtLeastOneItem) {
        toastr.warning("Please add at least one Item Detail");
        return;
    }

    // ✅ Now it's safe to collect data from validated rows
    const rowsData = collectRowsData();
                 const Header = {
                    DOC_ID,
                    V_NO,
                    V_DATE,
                    DEPT_CODE,
                    TARGET_DATE,
                    REASON,
                    PLACE_CODE,
                    URGENT_REQUEST,
                    STATUS,
                    OWNER_CODE,
                    OWNER_NAME,
                    PLAN_NO,
                    PLAN_TYPE,
                    REMARKS,
                    ACTION
            };
             const payload = {
                Header,
                itamDetails: rowsData,
                purchaseDocuments: AttachmentsRowsData
            };
            $("#btnSaves").prop("disabled", true);

        $.ajax({
            url: '/PurchaseRequest/SavedData',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (response) {
                if (response.success) {
                    toastr.success("Saved successfully!");
     
                   setTimeout(() => window.location.href = '/PurchaseRequestList/Index', 1000);
           
                } else {
                    toastr.error(response.message || "Save failed.");
                }
            },
            error: function (xhr, status, error) {
                let errorMessage = "Something went wrong.";
                if (xhr.status === 400) {
                    errorMessage = "Bad Request: " + xhr.responseText;
                } else if (xhr.status === 500) {
                    errorMessage = "Server error: " + xhr.responseText;
                } else {
                    errorMessage = "Unexpected error: " + xhr.statusText;
                }

                  toastr.error("Error: ", errorMessage);
       
            },
            complete: function () {
                $("#btnSaves").prop("disabled", false);
            }
        });
    });








     
        $(document).on('click', '.btn-add-item-row, .btn-add-action', function () {
        const $tbody = $('#tab1 tbody');
        const rowCount = $tbody.find('tr').length;

        if (rowCount > 0) {
            const $lastRow = $tbody.find('tr:last');
            const requiredFields = [
                { selector: '.ddlItem', name: 'Item' },
                { selector: '.required-qty', name: 'Required Quantity' },
                { selector: '.req-reason', name: 'Requirement Reason' },
                { selector: '.ddlplaceuse', name: 'Place of Use' },
                { selector: '.priority-type', name: 'Priority Type' },
                { selector: '.scrap-type', name: 'Scrap Type' },
                { selector: '.work-type', name: 'Work Type' }
            ];

            for (const field of requiredFields) {
                const $field = $lastRow.find(field.selector);
                const value = $field.val();
                if (!value || value === '0' || value.trim() === '') {
                    toastr.warning(`Please fill "${field.name}" in the previous row.`);
                    $field.focus();
                    return;
                }
            }
        }

        addRow();
    });

        $(document).on('click', '.btn-delete-action', function () {
          $(this).closest('tr').remove();
        });

        $(document).on('click', '.btn-delete-Attaction', function () {
          $(this).closest('tr').remove();
        });

        $(document).on('change', 'input[type="file"]', function (event) {
            const fileInput = event.target;
            const file = fileInput.files[0];

            if (file) {
            const fileName = file.name;
            const rowId = $(fileInput).closest('tr').find('td').eq(0).attr('id');
            const index = rowId.split('_')[1]; 

                $(`#fileName_${index}`).val(fileName);
            }
        });

        $(document).on('click', '.btn-add-attachment-row', function () {
        const $tbody = $('#tblAttachmentPR tbody');
        const rowCount = $tbody.find('tr').length;

        if (rowCount > 0) {
            const $lastRow = $tbody.find('tr').last();
            const $lastFileNameInput = $lastRow.find('input[type="text"]');
            const lastFileName = $lastFileNameInput.val()?.trim();

            if (lastFileName) {
                const index = rowCount;
                addAttachmentRow({ index });
            } else {
                   toastr.warning('Please Select File Name in the last row before adding a new one.');
                $lastFileNameInput.focus();
            }
        } else {
         
            addAttachmentRow({ index: 0 });
        }
    });


        ////  sorting data in item details table

        $('#selectAllPR').on('change', function () {
        const isChecked = $(this).is(':checked');
        $('#tblpurchasequotationmodal tbody input[type="checkbox"]').prop('checked', isChecked);
    });

        $('#btnSort').on('click', function () {
        const selectedValue = $('#ddlSortBy').val();
        const isDescending = $('#chkDesc').is(':checked');
        const columnClassMap = {
            'ApproxRate': 'approx-rate',
            'ItemName': 'ddlItem',
            'Qty': 'user-qty'
        };
        const className = columnClassMap[selectedValue];
        if (!className) {
            alert('Please select a valid column to sort by.');
            return;
        }
         const $rows = $tbody.find('tr');
        const sortedRows = $rows.get().sort(function (a, b) {
            const aVal = getCellValue($(a), className);
            const bVal = getCellValue($(b), className);
            const isNumeric = !isNaN(parseFloat(aVal)) && !isNaN(parseFloat(bVal));
            if (isNumeric) {
                return isDescending
                    ? parseFloat(bVal) - parseFloat(aVal)
                    : parseFloat(aVal) - parseFloat(bVal);
            } else {
                return isDescending
                    ? bVal.localeCompare(aVal)
                    : aVal.localeCompare(bVal);
            }
        });
        $tbody.empty().append(sortedRows);
    });
  
        $(document).on('change', '#tblpurchasequotationmodal tbody input[type="checkbox"]', function () {
        const totalCheckboxes = $('#tblpurchasequotationmodal tbody input[type="checkbox"]').length;
        const checkedCheckboxes = $('#tblpurchasequotationmodal tbody input[type="checkbox"]:checked').length;

        $('#selectAllPR').prop('checked', totalCheckboxes === checkedCheckboxes);
    });

        /////// end


            //////////// Searching Data using dropdown Dropdown in purchase Quatation Table
        let selectedColumn = parseInt($('#columnSelect').val());
        $('#searchLabel').html(`Search in: <strong>${$('#columnSelect option:selected').text()}</strong>`);

        $('#columnSelect').on('change', function () {
                selectedColumn = parseInt($(this).val());
                $('#searchLabel').html(`Search in: <strong>${$(this).find('option:selected').text()}</strong>`);
                $('#searchBoxPR').trigger('keyup'); 
            });

        $('#searchBoxPR').on('keyup', function () {
                const searchTerm = $(this).val().toLowerCase();
                $('#tblpurchasequotationmodal tbody tr').each(function () {
                    const cell = $(this).find('td').eq(selectedColumn);
                    const text = cell.text().toLowerCase();
                    $(this).toggle(text.includes(searchTerm));
                });
            });
        //end

    });
       
    function getCellValue($row, className) {
            const $cell = $row.find('.' + className);
            if ($cell.is('select')) {
                return $cell.find('option:selected').text().trim();
            }

            return $cell.val()?.trim() || $cell.text().trim();
    }

    function setFormReadOnly() {
        const form = $('#PurchaseRequestForm');
        form.find(':input').prop('disabled', true);
        form.find('textarea').css('background-color', '#f0f0f0');
        form.find('table tbody tr').css('background-color', '#f9f9f9');
        $('.btn-add-row-last').hide();
    }

    async function GetVNo() {
        try 
        {
        const res = await fetch('/PurchaseRequest/GetVNo');
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const data = await res.json();

        if (!data.v_NO) throw new Error('Response missing v_NO');
          $('#NumDocNo').val(data.v_NO);
        } 
        catch (e) 
        {
           toastr.warning('Error loading Document Number: ' + e.message);
        }
        }

   async function LoadFormByID(id) {
      try {
        const res = await $.ajax({
          url: '/PurchaseRequestList/GetDataByCode',
          method: 'GET',
          data: { code: id }
        });

        if (!res.success) {
          toastr.error(res.message || "Failed to load data.");
          return;
        }

        const header = res.data.header;
        const details = res.data.itamDetails;
        const attachments = res.data.purchaseDocuments;


        $('#TxtCode').val(header.doC_ID || '');
        $('#NumDocNo').val(header.v_NO || '');
        $('#DtDocDate').val(formatDate(header.v_DATE));
        $('#ddlDepartment').val(header.depT_CODE || '');
        $('#DtRequiredDate').val(formatDate(header.targeT_DATE));
        $('#txtRequiredDate').val(header.reason || '');
        $('#ddlPlace').val(header.placE_CODE || '');
        $('#chkUrgentRequest').prop('checked', header.urgenT_REQUEST === 1);
        $('#ddlStatus').val(header.status || '');
        $('#ddlRequester').val(header.owneR_CODE || '');
        $('#ddlPlanComplain').val(header.plaN_NO || '');
        $('#txtRemarks').val(header.remarks || '');

