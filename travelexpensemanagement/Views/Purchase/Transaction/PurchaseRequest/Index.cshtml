                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label>Doc Date<span class="required">*</span></label>
                    <input type="date" class="form-control" id="DtDocDate">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Department<span class="required">*</span></label>
                    <select class="form-control" id="ddlDepartment">
                        <option>--Select Department--</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label>Required Date<span class="required">*</span></label>
                    <div class="input-divide">
                    <input type="date" class="form-control" id="DtRequiredDate">
                    <input type="text" class="form-control" id="txtRequiredDate">
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
           
            <div class="col-md-3">
                <div class="form-group">
                    <label>Place<span class="required">*</span></label>
                    <div class="sort-controls">
                        <select class="form-control" id="ddlPlace">
                            <option>select Place</option>
                        </select>
                    <label class="desc-label">
                        <input type="checkbox" id="chkUrgentRequest"> Urgent Request
                    </label>
                    </div>
                </div>
            </div>
        
            <div class="col-md-2">
                <div class="form-group">
                    <label>Requester<span class="required">*</span></label>
                    <select class="form-control" id="ddlRequester">
                    
                    </select>
                </div>
            </div>


            <div class="col-md-2">
                <div class="form-group">
                    <label>Status<span class="required">*</span></label>
                    <select class="form-control" id="ddlStatus">
                        <option value="1">Open</option>
                        <option value="2">Cancel</option>
                        <option value="3">Close</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
