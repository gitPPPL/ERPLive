   function formatDate(dateStr) {
            if (!dateStr) return null;
            const date = new Date(dateStr);
            if (isNaN(date)) return null;
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0'); 
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
            }

   function generateSelect(options, selectedValue, selectedText = null) {
      let html = `<option value="">Select</option>`;

      if (Array.isArray(options)) {
        const unique = [...new Set(options)];
        unique.forEach(option => {
          const isSelected = option === selectedValue ? ' selected' : '';
          html += `<option value="${option}"${isSelected}>${option}</option>`;
        });

        if (selectedValue && !unique.includes(selectedValue)) {
          html += `<option value="${selectedValue}" selected>${selectedText || selectedValue}</option>`;
        }

      } else if (typeof options === 'object' && options !== null) {
        const keys = Object.keys(options).sort((a, b) => options[a].localeCompare(options[b]));
        keys.forEach(key => {
          const isSelected = key === selectedValue ? ' selected' : '';
          html += `<option value="${key}"${isSelected}>${options[key]}</option>`;
        });

        if (selectedValue && !keys.includes(selectedValue)) {
          html += `<option value="${selectedValue}" selected>${selectedText || selectedValue}</option>`;
        }
      }

      return html;
    }

    function cpygenerateSelect(map, selectedValue, selectedText = null) {
      let options = '<option value="">Select</option>';
      let found = false;

      for (const key in map) {
        if (Object.prototype.hasOwnProperty.call(map, key)) {
          const isSelected = key === selectedValue ? ' selected' : '';
          if (key === selectedValue) found = true;
          options += `<option value="${key}"${isSelected}>${map[key]}</option>`;
        }
      }

      if (selectedValue && !found) {
        options += `<option value="${selectedValue}" selected>${selectedText || selectedValue}</option>`;
      }

      return options;
    }

    function generateSelectFromArray(itemArray, selectedValue, selectedText = null) {
      let options = '<option value="">-- Select --</option>';
      const uniqueMap = {};

      itemArray.forEach(item => {
        if (item && item.value != null && !(item.value in uniqueMap)) {
          uniqueMap[item.value] = item.text;
        }
      });

      for (const val in uniqueMap) {
        if (Object.prototype.hasOwnProperty.call(uniqueMap, val)) {
          const isSelected = val === selectedValue ? ' selected' : '';
          options += `<option value="${val}"${isSelected}>${uniqueMap[val]}</option>`;
        }
      }

      if (selectedValue && !(selectedValue in uniqueMap)) {
        options += `<option value="${selectedValue}" selected>${selectedText || selectedValue}</option>`;
      }

      return options;
    }
                  
