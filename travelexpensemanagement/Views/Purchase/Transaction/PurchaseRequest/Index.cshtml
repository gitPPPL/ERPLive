@{
    ViewBag.Title = "Purchase Request";
    Layout = "~/Views/Shared/_Layout.cshtml";

}


<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-shopping-cart"></i>
        </div>
        <div class="erppage-header-title">Purchase Request</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "PurchaseRequestList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="PurchaseRequestForm">
    <input type="hidden" class="form-control" id="TxtCode" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc No</label>
                    <input type="number" class="erppage-redinput" id="NumDocNo" placeholder="Enter Doc No" readonly>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-redinput" id="DtDocDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Department</label>
                    <select class="erppage-input erppage-required" id="ddlDepartment">
                        <option value="">Select Department</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Status</label>
                    <select class="erppage-input erppage-required" id="ddlStatus">
                        @* <option value="1">Open</option>
                        <option value="2">Cancel</option>
                        <option value="3">Close</option> *@
                    </select>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Place</label>
                    <select class="erppage-input erppage-required" id="ddlPlace">
                        <option value="">Select Place</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Req. Date</label>
                    <input type="date" class="erppage-redinput" id="DtRequiredDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Req. Instruc.</label>
                    <input type="text" class="erppage-redinput" id="txtRequiredDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Agst. Plan</label>
                    <select class="erppage-input" id="ddlPlanComplain">
                    </select>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Requester</label>
                    <select class="erppage-input erppage-required" id="ddlRequester">
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Remarks</label>
                    <input class="erppage-input" id="txtRemarks" placeholder="Enter Remarks" />
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <div class="dropdown erppagedropdown" id="btn-copyFromDiv">
                        <button type="button" class="erppagedropdown-btn">
                            <i class="fa fa-copy"></i>
                            <span>Copy From</span>
                        </button>
                        <button type="button" class="erppagedropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa fa-chevron-down"></i>
                        </button>
                        <ul class="dropdown-menu erppagedropdown-menu">
                            <li>
                                <a class="erppagedropdown-item" data-bs-toggle="modal" data-bs-target="#purchasequotationModal" onclick="LoadCopyForm()">
                                    <i class="fa-solid fa-file-invoice"></i>
                                    <span>Purchase Quotation</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                   @*  <button id="btn-closeprocess" type="button" class="erppage-btn erppage-btn-copy">
                        <i class="fa fa-lock"></i>
                        <span>Close Process</span>
                    </button> *@
                    <button id="btn-monthlyrequirement" type="button" class="erppage-btn erppage-btn-copy" onclick="LoadMonthlyRequirementData()">
                        <i class="fa fa-calendar"></i><span>Monthly Requirement</span>
                    </button>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="divfield" style="background-color: #66a644; padding: 3px 5px;border-radius: 6px;color: white !important;" id="div-ApproxTotalAmt">
                    <label class="erppage-label" id="lbl-ApproxTotalAmt" style="display: contents;     color: white;">
                        Approx Total Amount: ₹<span id="lbl-totalApproxAmount">0.00</span>
                    </label>
                </div>
                <div class="erppage-internalaction erppage-col-span-3" style="margin:0px;">
                    <button id="btn-lastTenPurchaseOrder" type="button" class="erppage-btn erppage-btn-common">
                        <i class="fa fa-calendar"></i><span>Last 10 Purchase Order</span>
                    </button>
                    <button id="btn-lastTenPurchases" type="button" class="erppage-btn erppage-btn-common">
                        <i class="fa fa-calendar"></i><span>Last 10 Purchases</span>
                    </button>
                    <button id="btn-lastTenPurchaseRequest" type="button" class="erppage-btn erppage-btn-common">
                        <i class="fa fa-calendar"></i><span>Last 10 Purchase Request</span>
                    </button>
                    <button id="btn-lastTenConsumption" type="button" class="erppage-btn erppage-btn-common">
                        <i class="fa fa-calendar"></i><span>Last 10 Consumption</span>
                    </button>
                </div>
            </div>
            
            <div class="erppage-container">
                @*  <div class="erppage-tab-content" id="attachment">

                    <fieldset class="erppage-fieldset">
                        <div class="excel-wrapper fixed-grid-wrapper">
                            <table id="tblAttachmentPR" class="excel-table fixed-grid-table resizable-table">
                                <colgroup>
                                    <col style="display:none;">
                                    <col style="width:400px;">
                                    <col style="width:350px;">
                                    <col style="width:120px;">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th class="hidden-col">Code</th>
                                        <th>File Name</th>
                                        <th>File Upload</th>
                                        <th class="action-col">Action</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </fieldset>
                </div> *@
                <div class="erppage-tabs">
                    <button class="erppage-tab active" data-tab="itemdetails">Item Details</button>
                    <button class="erppage-tab" data-tab="attachment">Attachment</button>
                </div>
                <div class="erppage-tab-content active" id="itemdetails">
                    <div class="erppage-accordion-header">Item Details</div>
                    <div class="erppage-accordion-body">
                        <fieldset class="erppage-fieldset">
                            <div class="excel-wrapper fixed-grid-wrapper">
                                <table id="tblItemDetailsPR" class="excel-table fixed-grid-table resizable-table sortable-table">
                                    <colgroup>
                                        <col style="display:none;">
                                        <col style="width:180px;">
                                        <col style="width:150px;">
                                        <col style="width:100px;">
                                        <col style="width:250px;">
                                        <col style="width:120px;" id="itemCol-approx-rate">
                                        <col style="width:120px;">
                                        <col style="width:200px;">
                                        <col style="width:100px;">
                                        <col style="width:120px;">
                                        <col style="width:130px;" id="itemCol-avgConsumption">
                                        <col style="width:130px;">
                                        <col style="width:130px;" id="itemCol-OpenReqQty">
                                        <col style="width:100px;">
                                        <col style="width:120px;">
                                        <col style="width:250px;">
                                        <col style="width:180px;">
                                        <col style="width:130px;">
                                        <col style="width:130px;">
                                        <col style="width:130px;">
                                        <col style="width:200px;">
                                        <col style="width:100px;" id="itemCol-status">
                                        <col style="width:100px;">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th class="hidden-col" data-column="0">
                                                Code <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="1">
                                                Item Name<span class="required">*</span> <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="2">
                                                Make <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="3">
                                                Unit <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="4">
                                                Tech Description <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="5" id="item-approx-rate">
                                                Approx Rate <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="6">
                                                Approval Status <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="7">
                                                Approval Remarks <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="8">
                                                Std Req <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="9">
                                                Current Stock <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="10" id="item-avgConsumption">
                                                Avg Consumption <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="11">
                                                Pending PO Qty <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="12" id="item-OpenReqQty">
                                                Open Req Qty <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="13">
                                                User Qty <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="14">
                                                Required Qty<span class="required">*</span> <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="15">
                                                Reason of Requirement<span class="required">*</span> <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="16">
                                                Place of Use<span class="required">*</span> <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="17">
                                                Priority Type<span class="required">*</span> <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="18">
                                                Scrap Type<span class="required">*</span> <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="19">
                                                Work Type<span class="required">*</span> <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="20">
                                                Remarks <span class="sort-icon"></span>
                                            </th>
                                            <th data-column="21" id="item-status">
                                                Status <span class="sort-icon"></span>
                                            </th>
                                            <th class="action-col">
                                                Action
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </fieldset>
                    </div>
                </div>
               

            </div>
          
            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Attachment</legend>
                <div class="erppageattachmentsection">
                    <div class="erppageattachmentsectionrow">
                        <div class="erppageattachmentsectioncol">
                            <div class="erppageattachmentsectionuploadcard">
                                <h2 class="erppageattachmentsectiontitle">UPLOAD MULTIPLE FILES</h2>
                                <div class="erppageattachmentsectiondropzone" id="dropZone">
                                    <div class="erppageattachmentsectioncloud">
                                        ?
                                    </div>
                                    <div class="erppageattachmentsectiondragtext">
                                        Drag & Drop your files here
                                    </div>
                                    <div class="erppageattachmentsectionor">
                                        OR
                                    </div>
                                    <button type="button" class="erppageattachmentsectionbrowsebtn" id="browseBtn">
                                        Browse Files
                                    </button>
                                    <input type="file" id="fileInput" multiple hidden>
                                </div>
                            </div>
                        </div>
                        <div class="erppageattachmentsectioncol">
                            <div class="erppageattachmentsectionfilecard">
                                <div class="erppageattachmentsectionheader">
                                    Uploaded Files
                                </div>
                                <div class="erppageattachmentsectionfilelist"
                                     id="fileList">
                                </div>
                            </div>

                        </div>

                    </div>

                </div>
            </fieldset>
        </fieldset>
        <div class="erppage-actions">
            <button id="btnSaves" type="button" class="erppage-btn erppage-btn-save">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>
        </div>
    </div>
</div>
@* Modal Popup *@
<div class="modal fade" id="purchasequotationModal" tabindex="-1" aria-labelledby="purchasequotationLabel" aria-hidden="true">
    <div class="modal-dialog erppagesmodal medium-modal">
        <div class="modal-content erppagesmodal-content">
            <div class="erppagesmodal-header">
                <div class="erppagesmodal-header-left">
                    <div class="erppagesmodal-header-icon">
                        <i class="fa fa-copy"></i>
                    </div>
                    <h5 class="erppagesmodal-title" id="purchasequotationLabel">
                        Copy From
                    </h5>
                </div>
                <button type="button" class="erppagesmodal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa fa-times"></i>
                </button>
            </div>
            <div class="erppagesmodal-body">
                <div class="erppage-grid3">
                    <div class="erppage-divfield">
                        <select id="columnSelect" class="erppage-input">
                            <option value="1" selected>V No</option>
                            <option value="2">V Type</option>
                            <option value="3">V Date</option>
                            <option value="4">Item Code</option>
                            <option value="5">Item Name</option>
                        </select>
                    </div>
                    <div class="erppage-divfield">
                        <div class="erppagelist-search-wrapper">
                            <i class="fa fa-search"></i>
                            <input type="text" id="searchBoxPR" placeholder="Search..." />
                        </div>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label"></label>
                        <div class="erppage-checkbox-wrap">
                            <input type="checkbox" id="chkAppendPQModal" class="erppage-checkbox-input">
                            <label class="erppage-checkbox-label">Append</label>
                        </div>
                    </div>
                </div>
                <div class="excel-wrapper fixed-grid-wrapper">
                    <table id="tblpurchasequotationmodal" class="excel-table fixed-grid-table resizable-table">
                        <colgroup>
                            <col style="width:50px;">
                            <col style="width:100px;">
                            <col style="width:120px;">
                            <col style="width:120px;">
                            <col style="width:130px;">
                            <col style="width:220px;">
                            <col style="width:150px;">
                            <col style="width:250px;">
                            <col style="width:80px;">
                            <col style="width:100px;">
                            <col style="width:120px;">
                            <col style="width:100px;">
                            <col style="width:100px;">
                            <col style="display:none;">
                        </colgroup>
                        <thead>
                            <tr>
                                <th><input type="checkbox" id="selectAllPR" /></th>
                                <th>Doc No</th>
                                <th>Doc Type</th>
                                <th>Doc Date</th>
                                <th>Item Code</th>
                                <th>Item Name</th>
                                <th>Make</th>
                                <th>Tech Desc</th>
                                <th>Unit</th>
                                <th>Quantity</th>
                                <th>Make Code</th>
                                <th>U Code</th>
                                <th>Tax Code</th>
                                <th style="display:none;">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="erppagesmodal-action">
                    <button type="button" class="erppagesmodal-btn" data-bs-dismiss="modal" onclick="getSelectedRows()">
                        <i class="fa fa-copy"></i>Copy
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>


