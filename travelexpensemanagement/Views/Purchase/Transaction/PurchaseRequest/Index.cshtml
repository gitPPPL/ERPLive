                        row += '<td>' + item.techDesc + '</td>';
                        row += '<td>' + item.unit + '</td>';
                        row += '<td>' + item.qty + '</td>';
                        row += '<td>' + item.makeCode + '</td>';
                        row += '<td>' + item.uCode + '</td>';
                        row += '<td>' + item.taxCode + '</td>';
                        row += '<td style="display:none;">Action</td>';
                        row += '</tr>';

                        $('#tblpurchasequotationmodal tbody').append(row);
                    });


                } else {
                    console.error("Error from server:", res.message);
                    toastr.error(res.message || "Failed to load data.");
                }
            },
            error: function (err) {
                console.error("Failed to load data", err);
                toastr.error("Something went wrong while loading the form.");
            }
        });
    }
 
    function getSelectedRows() {
        var selectedRowsData = [];
        $('#tblpurchasequotationmodal tbody tr').each(function() {
            var checkbox = $(this).find('input[type="checkbox"]');

            if (checkbox.prop('checked')) {
                var rowData = {
                    vno: $(this).find('td').eq(1).text(),
                    vtype: $(this).find('td').eq(2).text(),
                    vdate: $(this).find('td').eq(3).text(),
                    itemCode: $(this).find('td').eq(4).text(),
                    itemName: $(this).find('td').eq(5).text(),
                    make: $(this).find('td').eq(6).text(),
                    techDesc: $(this).find('td').eq(7).text(),
                    unit: $(this).find('td').eq(8).text(),
                    qty: $(this).find('td').eq(9).text(),
                    makeCode: $(this).find('td').eq(10).text(),
                    uCode: $(this).find('td').eq(11).text(),
                    taxCode: $(this).find('td').eq(12).text()
                };

                selectedRowsData.push(rowData); 
            }
        });

        if (selectedRowsData.length > 0) {
            addRowsToMainTable(selectedRowsData);
             toastr.success(selectedRowsData.length + " row(s) copied successfully.");
        } else {
            toastr.warning("No rows selected.");
        }
    }
 
    function addRowsToMainTable(selectedRowsData) {
        selectedRowsData.forEach(function(row) {
            var data = {
                code: row.vno,
                value: row.itemCode,
                makeValue: row.makeCode,
                unitName: row.unit,
                techDesc: row.techDesc,
                approxRate: '', 
                approvalStatus: '', 
                approvalRemarks: '', 
                stdReq: '',
                currentStock: '', 
                avgConsumption: '', 
                pendingPOQty: '', 
                openReqQty: '', 
                userQty: '', 
                requiredQty: row.qty,
                reason: '', 
                placeOfUse: '', 
                priorityType: '', 
                scrapType: '', 
                workType: '',
                remarks: '', 
                status: '' 
            };

          CopyaddRow(data);
        });
    }
  
    function CopyaddRow(data = {}) {
     
        if ($tbody.find('tr').length === 1) {
            const firstRowInputs = $tbody.find('tr:first input, tr:first select');
            let isBlank = true;

            firstRowInputs.each(function () {
                if ($(this).val().trim() !== '') {
                    isBlank = false;
                    return false; 
                }
            });

            if (isBlank) {
                $tbody.find('tr:first').remove();
            }
        }

        const row = `
            <tr class="no-border-input">
                <td style="display:none;">${data.code || ''}</td>
                   <td><select class="form-control ddlItem" style="width:250px;">${cpygenerateSelect(ItemMap, data.value)}</select></td>
                   <td><select class="form-control ddlMake" style="width:100px;">${cpygenerateSelect(MakeMap, data.makeValue)}</select></td>
                <td>
                    <input type="text" class="form-control unit-name" style="width:100px;" value="${data.unitName || ''}" readonly />
                    <input type="hidden" class="unit-code" value="${data.unitCode || ''}" />
                </td>
                <td><input type="text" class="form-control tech-desc" value="${data.techDesc || ''}"/></td>
                <td><input type="number" class="form-control approx-rate" value="${data.approxRate || ''}" readonly /></td>
                   <td><select class="form-control approval-status">${cpygenerateSelect(Approvstatus, data.approvalStatus)}</select></td>
                <td><input type="text" class="form-control approval-remarks" value="${data.approvalRemarks || ''}"/></td>
                <td><input type="number" class="form-control std-req" value="${data.stdReq || ''}"/></td>
                <td><input type="number" class="form-control current-stock" value="${data.currentStock || ''}" readonly/></td>
                <td><input type="number" class="form-control avg-consumption" value="${data.avgConsumption || ''}" readonly/></td>
                <td><input type="number" class="form-control pending-po-qty" value="${data.pendingPOQty || ''}" readonly/></td>
                <td><input type="number" class="form-control open-req-qty" value="${data.openReqQty || ''}" readonly/></td>
                <td><input type="number" class="form-control user-qty" value="${data.userQty || ''}" readonly/></td>
                <td><input type="number" class="form-control required-qty" value="${data.requiredQty || ''}" /></td>
                <td><input type="text" class="form-control req-reason" value="${data.reason || ''}"/></td>
                   <td><select class="form-control ddlplaceuse">${cpygenerateSelect(PlaceUseMap, data.placeOfUse)}</select></td>
                   <td><select class="form-control priority-type">${cpygenerateSelect(priorityOptions, data.priorityType)}</select></td>
                   <td><select class="form-control scrap-type">${cpygenerateSelect(scrapOptions, data.scrapType)}</select></td>
                   <td><select class="form-control work-type" style="width:120px;">${cpygenerateSelect(workOptions, data.workType)}</select></td>
                <td><input type="text" class="form-control remarks" value="${data.remarks || ''}"/></td>
                   <td><select class="form-control status" style="width:120px;">${cpygenerateSelect(statusOptions, data.status)}</select></td>
                <td>
                    <i class="fa fa-plus btn-add-item-row" title="Add Row"></i>
                    <i class="fa fa-trash btn-delete-action" title="Delete Row"></i>
                </td>
            </tr>
        `;
        $tbody.append(row);
    }

    function LoadMonthlyRequirementData() {
        const DEPT_CODE = parseInt($('#ddlDepartment').val()) || 0;

        return $.ajax({
               url: '/PurchaseRequestList/GetDataMonthlyRequirement',
            method: 'GET',
            data: { deptId: DEPT_CODE },
            success: function (res) {
                if (res.success) {
                  addRowsToMainTableMonthly(res.data);
                } else {
                    console.error("Error from server:", res.message);
                    toastr.error(res.message || "Failed to load data.");
                }
            },
            error: function (err) {
                console.error("Failed to load data", err);
                toastr.error("Something went wrong while loading the form.");
            }
        });
    }
 
    function addRowsToMainTableMonthly(selectedRowsData) {
        selectedRowsData.forEach(function (row) {
            const data = {
                code: row.iteM_CODE,        
                value: row.itemName,         
                makeValue: row.make,       
                unitName: row.unit,         
                unitCode: row.uCode,         
                techDesc: '',                
                approxRate: row.deptQty,     
                approvalStatus: '',          
                approvalRemarks: '',         
                stdReq: '',                  
                currentStock: row.currentStock, 
                avgConsumption: '',          
                pendingPOQty: '',          
                openReqQty: '',           
                userQty: '',                 
                requiredQty: row.reserveQty, 
                reason: '',                
                placeOfUse: '',              
                priorityType: '',            
                scrapType: '',               
                workType: '',             
                remarks: '',                
                status: ''                 
            };

            MonthlyReqRowData(data);
        });
    }
 
