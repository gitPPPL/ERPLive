                    <label>Agst. Plan/Complain No.</label>
                    <select class="form-control" id="ddlPlanComplain">
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>Remarks</label>
                    <textarea type="text" class="form-control" id="txtRemarks" placeholder="Enter Remarks"></textarea>
                </div>
            </div>
            <div class="offset-md-3 col-md-6">
                <div class="btn-mt button-right">
                    <button type="button" class="btn btn-primary">
                        <i class="fa fa-lock"></i> Close Process
                    </button>

                    <div class="dropdown">
                        <button class="btn btn-primary dropdown-toggle" type="button" id="copyFromDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-copy"></i> <span id="dropdownText">Copy From</span>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="copyFromDropdown">
                            <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#purchasequotationModal" onclick="LoadCopyForm()">Purchase Quotation</a></li>
                        </ul>
                    </div>

                    <button type="button" class="btn btn-primary" onclick="LoadMonthlyRequirementData()">
                        <i class="fa fa-calendar"></i> Monthly Requirement
                    </button>
                </div>
            </div>
        </div>
       
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">

                    <label for="ddlSortBy">Sort by</label>
                    <div class="sort-controls">
                        <select id="ddlSortBy" class="form-control">
                            <option>Select sort By </option>
                            <option value="ApproxRate">Approx. Rate</option>
                            <option value="ItemName">Item Name</option>
                            <option value="Qty">Quantity</option>
                        </select>

                        <label class="desc-label">
                            <input type="checkbox" id="chkDesc"> Desc
                        </label>

                        <button type="button" id="btnSort">
                            <i class="fa fa-search"></i> Sort
                        </button>
                    </div>
                </div>
            </div>

        </div>
        <!--Purchase Quotation-->
        <div class="modal fade" id="purchasequotationModal" tabindex="-1" aria-labelledby="purchasequotationLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content draggable-modal">
                    <div class="popup-header">
                        <h5 class="popup-title" id="purchasequotationLabel">Copy From</h5>
                        <i class="fa fa-times" data-bs-dismiss="modal" style="cursor: pointer;" aria-label="Close"></i>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <select id="columnSelect" class="form-control">
                                        <option value="1" selected>V No</option>
                                        <option value="2">V Type</option>
                                        <option value="3">V Date</option>
                                        <option value="4">Item Code</option>
                                        <option value="5">Item Name</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="input-group shadow-sm rounded-pill overflow-hidden">
                                <input type="text" id="searchBoxPR" class="form-control border-0" placeholder="Search..." />

                                </div>
                            </div>
                            <div class="col-lg-2">
                                <div class="form-group">
                                    <div class="form-row">
                                        <input type="checkbox" id="chkAppendPQModal">
                                        <label class="checkbox-label" for="chkAppendPQModal">Append</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <div class="btn-rightalign">
                                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal" onclick="getSelectedRows()"><i class="fa fa-copy"></i>Copy</button>
                                </div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="table-responsive">
                                <table id="tblpurchasequotationmodal" class="table-width">
                                    <thead class="table-head">
                                        <tr>
                                            <th><input type="checkbox" id="selectAllPR" /></th>
                                            <th>Vno</th>
                                            <th>Vtype</th>
                                            <th>Vdate</th>
                                            <th>Item Code</th>
                                            <th>Item Name</th>
                                            <th>Make</th>
                                            <th>Tech Desc</th>
                                            <th>Unit</th>
                                            <th>Qty</th>
                                            <th>Makecode</th>
                                            <th>Ucode</th>
                                            <th>Taxcode</th>
                                            <th style="display:none;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="navtab-form">
            <ul class="nav nav-tabs" id="formTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" id="tab1-tab" data-bs-toggle="tab" data-bs-target="#tab1" type="button" role="tab">Item Details</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="tab2-tab" data-bs-toggle="tab" data-bs-target="#tab2" type="button" role="tab">Attachments</button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- tab 1 -->
                <div class="tab-pane fade show active" id="tab1"> 
               
                        <div class="card">
                            <div class="table-responsive-entry">
                                <table id="tblItemDetailsPR" class="table-entry">
                                    <thead class="table-head">
                                        <tr>
                                            <th style="display:none;">Code</th>
                                            <th style="width:250px;">Item Name<span class="required">*</span></th>
                                            <th style="width:100px;">Make</th>
                                            <th>Unit</th>
                                            <th>Tech Description</th>
                                            <th>Approx Rate</th>
                                            <th>Approval Status</th>
                                            <th>Approval Remarks</th>
                                            <th>Std Req</th>
                                            <th>Current Stock</th>
                                            <th>Avg Consumption</th>
                                            <th>Pending PO Qty</th>
                                            <th>Open Req Qty</th>
                                            <th>User Qty</th>
                                            <th>Required Qty<span class="required">*</span></th>
                                            <th>Reason of Requirement<span class="required">*</span></th>
                                            <th style ="width:250px;" >Place of Use    <span class="required">*</span></th>
                                            <th>Priority Type<span class="required">*</span></th>
                                            <th>Scrap Type<span class="required">*</span></th>
                                            <th style="width:100px;">Work Type<span class="required">*</span></th>
                                            <th>Remarks</th>
                                            <th style="width:100px;">Status</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                          
                   
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="btn-add-row-last">
                                    <i class="fa fa-plus btn-add-item-row btn-success" title="Add Row" style="padding: 4px;border-radius: 2px;"><span>Add New Row</span></i>
                                    </div>
                           
                                </div>
                            </div>


                        </div>
                </div>
                <!-- tab 2 -->
                <div class="tab-pane fade" id="tab2">
                        <div class="card">
                            <div class="table-responsive-entry">
                                <table id="tblAttachmentPR" class="table-entry">
                                    <thead class="table-head">
                                        <tr>
                                            <th style="display:none;">Code</th>
                                            <th>File Name</th>
                                            <th>File Upload</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>

                            <div class="row">
                                <div class="col-md-12">
                                    <div class="btn-add-row-last">
                                    <i class="fa fa-plus btn-add-attachment-row" title="Add Row"><span>Add New Row</span></i>
                                    </div>
                                
                                </div>
