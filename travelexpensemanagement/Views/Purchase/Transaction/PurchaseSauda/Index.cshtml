@using System.Text.Json




@{
    ViewBag.Title = "Purchase Sauda";
    Layout = "~/Views/Shared/_Layout.cshtml";



    var globalVariables = ViewBag.GlobalVariables as Models.UserSessionData
         ?? new Models.UserSessionData();
    var databaseName = ViewBag.DatabaseName as string;
    var CompCode = int.TryParse(globalVariables.PubCompCode, out var parsedCompCode) ? parsedCompCode : 0; // Ensure proper type conversion
    var PubUserLevel = int.TryParse(globalVariables.PubUserLevel, out var parsedPubUserLevel) ? parsedPubUserLevel : 0;
    var logindate = globalVariables.PubLoginDate is DateTime date ? date.ToString("yyyy-MM-dd") : "";

}

<script>
    // Passing only required variables to JS
    window.globalVariables = @Html.Raw(JsonSerializer.Serialize(new {
        CompCode = int.TryParse(globalVariables.PubCompCode, out var c) ? c : 0,
        UserId = globalVariables.PubUserId,
        UserName = globalVariables.PubUserName,
        UserLevel = int.TryParse(globalVariables.PubUserLevel, out var ul) ? ul : 0,
        FYearCode = globalVariables.PubFYearCode,
        BranchCode = globalVariables.PubBranchCode,
        LoginDate = globalVariables.PubLoginDate.ToString("yyyy-MM-dd"),
        CompanyName = globalVariables.CompanyName,
        Address1 = globalVariables.Address1,
        Address2 = globalVariables.Address2,
        GST = globalVariables.gstin,
        PAN = globalVariables.PAN,
        Phone = globalVariables.Phone,
        Email = globalVariables.Email
    }));

    window.database = @Html.Raw(JsonSerializer.Serialize(databaseName));
</script>






<fieldset>
    <legend class="legend-field">Purchase Sauda</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="window.location.href='@Url.Action("Index", "PurchaseSaudaList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>

    <form id="PurchaseSaudaForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">

        <!-- Row 1 -->
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>Doc No</label>
                    <input type="number" class="form-control" id="txtDocNo" placeholder="Enter Doc No" readonly>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Doc Date<span class="required">*</span></label>
                    <input type="date" class="form-control" id="dtDocDate" placeholder="Select Doc Date">
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label>Doc Status</label>
                    <select class="form-control" id="ddlDocStatus">
                        <option value="open">Open</option>
                        <option value="closed">Closed</option>
                    </select>
                </div>
            </div>      
            <div class="col-md-3">
                <div class="form-group">
                    <label>Supply From<span class="required">*</span></label>
                    <select class="form-control" id="ddlSupplyFrom">                       
                        <option value="LOCAL">LOCAL</option>
                        <option value="IMPORT">IMPORT</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Party Details</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Party Name<span class="required">*</span></label>
                                <select class="form-control" id="ddlPartyName">
                                    <option value="">-- Select Party Name --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Address Line 1</label>
                                <textarea type="text" class="form-control" id="txtAddress1" placeholder="Enter Address Line 1" readonly></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Address Line 2</label>
                                <textarea type="text" class="form-control" id="txtAddress2" placeholder="Enter Address Line 2" readonly></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Address Line 3</label>
                                <textarea type="text" class="form-control" id="txtAddress3" placeholder="Enter Address Line 3" readonly></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Station</label>
                                  <select class="form-control" id="txtStation" >
                                    <option value="">-- Select Station --</option>
                                </select>
                            </div>
                        </div>

                          <div class="col-md-6">
                            <div class="form-group">
                                <label>Contact No</label>
                                <input type="text" class="form-control" id="txtContactNo" placeholder="Enter Contact No" readonly>
                            </div>
                        </div>




                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Country</label>
                                <input type="text" class="form-control" id="txtCountry" placeholder="Enter Country" readonly>
                            </div>
                        </div>
                 
                    </div>
                    <div class="row">
                                             
                    </div>
                    <div class="row">

                         <div class="col-md-6">
                            <div class="form-group">
                                <label>Delivery From</label>
                                  <input type="text" class="form-control" id="txtDeliveryFrom" placeholder="Enter Delivery From" readonly>
                                                                
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Ship From</label>
                                <select class="form-control" id="ddlShipFrom">
                                    <option value="">-- Select Ship From --</option>
                                </select>
                            </div>
                        </div>






                    </div>
                </fieldset>
            </div>
            <div class="col-md-8">
                <fieldset class="fieldset-sub-divide" style="height:338px;">
                    <legend class="sub-legend">Purchase Details</legend>
                    <div class="row">
                       
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Item Name<span class="required">*</span></label>
                                <select class="form-control" id="ddlItemName">
                                    <option value="">-- Select Item Name --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>No. of Trucks</label>
                                <input type="number" class="form-control" id="numTrucks" placeholder="Enter Truck Count">
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Weight (Kgs)<span class="required">*</span></label>
                                <input type="number" class="form-control" id="numWeight" placeholder="Enter Weight">
                            </div>
                        </div>
                    </div>
                   
                    <div class="row">

                         <div class="col-md-3">
                            <div class="form-group">
                                <label>Item Type<span class="required">*</span></label>
                                <select class="form-control" id="ddlItemType">

                                    <option value="">-- Select Item Type --</option>
                                    <option value="PSF">PSF</option>
                                    <option value="MB">MB</option>
                                    <option value="CHIPS">CHIPS</option>
                                    <option value="FABRIC">FABRIC</option>
                                    <option value="HD">HD</option>
                                    <option value="RAW">RAW</option>                                              

                                </select>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Rate<span class="required">*</span> </label>
                                <div class="input-divide">
                                    <select class="form-control" id="ddlRate">
                                        <option value="Rs">Rs</option>
                                        <option value="USD">USD</option>
                                        <option value="Yen">Yen</option>
                                        <option value="CNY">CNY</option>
                                    </select>
                                    <input type="number" class="form-control" id="numRate" placeholder="Enter Rate" >
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>ExRate</label>
                                <input type="text" class="form-control" id="txtExRate" placeholder="Enter ExRate">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Discount %</label>
                                <input type="number" class="form-control" id="numDiscount" placeholder="Enter Discount %">
                            </div>
                        </div>

                          <div class="col-md-3">
                            <div class="form-group">
                                <label>Freight Rate</label>
                                <input type="number" class="form-control" id="numFreightRate" placeholder="Enter Freight Rate">
                                <input type="text" class="form-control" id="cmbtaxterm" placeholder="Enter Tax Term">
                            </div>
                        </div>



                    
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Tax Rate<span class="required">*</span></label>
                                <div class="input-divide">
                                    <select class="form-control" id="ddlTaxRate" style="width:100px;">
                                        <option value="">--Select Tax Rate--</option>
                                    </select>
                                    <input type="number" class="form-control" id="numTaxRate" placeholder="Enter Tax Rate" readonly>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Net Rate</label>
                                <input type="number" class="form-control" id="numNetRate" placeholder="Enter Net Rate" readonly>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Waste %</label>
                                <input type="number" class="form-control" id="numWaste" placeholder="Enter Waste %">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="btn-mt">
                                <div class="form-group" style="display: flex;gap: 10px;">
                                    <input type="checkbox" id="chkNatural">
                                    <label class="checkbox-label" for="chkNatural">Only Natural Bottle Accepted</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Payment Term<span class="required">*</span></label>
                                <select class="form-control" id="ddlPaymentTerm">
                                    <option value="">-- Select Payment Term --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Purchase Through<span class="required">*</span></label>
                                <select class="form-control" id="ddlPurchaseThrough">
                                    <option value="">-- Select Purchase Through --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Freight Term<span class="required">*</span></label>
                                <select class="form-control" id="ddlFreightTerm">
                                    <option value="">-- Select Freight Term --</option>
                                    <option value="FOR">FOR</option>
                                    <option value="EX">EX</option>
                                    <option value="FOB">FOB</option>
                                    <option value="CIF">CIF</option>
                                    <option value="CFR">CFR</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Delivery Term</label>
                                <input type="text" class="form-control" id="txtDeliveryTerm" placeholder="Enter Delivery Term" maxlength="100">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Remarks</label>
                                <textarea type="text" class="form-control" id="txtRemarks" placeholder="Enter Remarks"></textarea>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        <fieldset class="fieldset-sub">
            <legend class="sub-legend">Import Terms</legend>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>PI No.</label>
                        <input type="text" class="form-control" id="NumPINO" placeholder="Enter PI No." maxlength="50">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>PI Dt</label>
                        <input type="date" class="form-control" id="DtPIDate">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Offer No.</label>
                        <input type="text" class="form-control" id="NumOfferNo" placeholder="Enter Offer No." maxlength="50">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Broker Name</label>
                        <select class="form-control" id="ddlBrokerName">
                            <option value="">-- Select Broker Name --</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Brokerage/Comm.</label>
                        <input type="number" class="form-control" id="NumBrokerage" placeholder="Enter Brokerage/Comm"  maxlength="12">
                    </div>
                </div>


                <div class="col-md-3">
                    <div class="form-group">
                        <label>Offer Rate</label>
                        <input type="number" class="form-control" id="NumOfferRate" placeholder="Enter Offer Rate."  maxlength="12">
                    </div>
                </div>


                <div class="col-md-2">
                    <div class="form-group">
                        <label>Packing Type</label>
                        <select class="form-control" id="ddlPackingType">
                            <option value="">-- Select Packing Type --</option>
                            <option value="Jumbo">Jumbo</option>
                            <option value="Box">Box</option>
                            <option value="Pallet">Pallet</option>
                            <option value="Bales"> Bales</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>Dispatch From</label>
                        <select class="form-control" id="ddlDispatchFrom">
                            <option value="">-- Select Dispatch Location --</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>Payment Type</label>
                        <select class="form-control" id="ddlPaymentType">
                            <option value="">-- Select Payment Type --</option>
                            <option value="Advance">Advance</option>
                            <option value="Due">Due</option>
                            <option value="Paid">Paid</option>
                            <option value="Late">Late</option>
                            <option value="SBLC">SBLC</option>
                            <option value="TT">TT</option>
                            <option value="LC">LC</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group position-relative">
                        <label for="DtSBLCDue">SBLC Due Dt</label>
                        <div class="calender-check">
                            <input type="date" class="form-control" id="DtSBLCDue" style="padding-left: 30px;">
                            <input type="checkbox" id="chkSBLCDue" class="checkbox-inside">
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group position-relative">
                        <label for="DtLCDue">LC Due Dt</label>
                        <div class="calender-check">
                            <input type="date" class="form-control" id="DtLCDue" style="padding-left: 30px;">
                            <input type="checkbox" id="chkDtLCDue" class="checkbox-inside">
                        </div>
                    </div>
                </div>
          
                <div class="col-md-2">
                    <div class="form-group">
                        <label id="GradeID">Grade<span class="required">*</span></label>
                        <select class="form-control" id="ddlGrade">
                            <option value="">-- Select Grade --</option>
                            <option value="PE">PE</option>
                            <option value="PP">PP</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Item Remarks</label>
                        <textarea class="form-control" id="TxtItemRemarks" placeholder="Enter remarks" maxlength="300"   ></textarea>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="table-responsive-entry">
                    <table id="tblAttachmentPS" class="table-entry">
                        <thead class="table-head">
                            <tr>
                                <th style="display:none;">Code</th>
                                <th>File Name</th>
                                <th>File Upload</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

            </div>
        </fieldset>
        <div class="row">
            <div class="offset-md-6 col-md-6">
                <div class="button-right">
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#deliveryPlanModal">
                        <i class="fa fa-truck"></i> Create/View Delivery Plan
                    </button>

                    <button type="button" class="btn btn-primary" id="btn_CreatePurchaseOrder">
                        <i class="fa fa-file-invoice"></i> Create Purchase Order
                    </button>

                </div>
            </div>
        </div>
        <div class="row">
            <div class="offset-md-9 col-md-3">
                <div class="btn-last">
                    <button id="btn-save" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
                </div>
            </div>
        </div>
        <div class="modal fade" id="deliveryPlanModal" tabindex="-1" aria-labelledby="deliveryPlanModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="popup-header">
                        <h5 class="popup-title" id="deliveryPlanModalLabel">Dispatch Delivery Planning</h5>
                        <i class="fa fa-close btn-close" data-bs-dismiss="modal"></i>
                    </div>

                    <div class="modal-body">

                        <!-- Form Row -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Doc No</label>
                                    <input type="text" class="form-control" id="TxtDispatchDocNo" readonly>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Doc Date</label>
                                    <input type="date" class="form-control" id="DispatchDocDate" readonly>
                                </div>
                            </div>
                        </div>

                        <!-- Table -->
                        <div class="card">
                            <div class="table-responsive">
                                <table id="tblPurchaseQuotationList" class="table-width">
                                    <thead class="table-head">
                                        <tr>
                                            <th>Icode</th>
                                            <th>Item Name</th>
                                            <th>Del. Date</th>
                                            <th>Quantity</th>
                                            <th>Remarks</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr class="no-border-input">
                                            <td><input type="text" class="form-control" id="TxtIcode" /></td>
                                            <td><input type="text" class="form-control" id="TxtItemName" /></td>
                                            <td><input type="date" class="form-control" id="DtDelDate" /></td>
                                            <td><input type="number" class="form-control" id="NumQuantity" /></td>
                                            <td><input type="text" class="form-control" id="TxtRemarks" /></td>
                                        </tr>

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>


                    <div class="modal-footer">
                        <button id="DispatchSave" type="button" class="btn btn-success">
                            <i class="fa fa-save"></i> Save
                        </button>

                    </div>

                </div>
            </div>
        </div>
    </form>
</fieldset>
<script src="~/js/erpjs/purchase/transaction/purchasesauda/purchasesaudainit.js"></script>
<script src="~/js/erpjs/purchase/transaction/purchasesauda/purchasesaudaapi.js"></script>
