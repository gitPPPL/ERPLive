@{
    ViewBag.Title = "Purchase Sauda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<fieldset>
    <legend class="legend-field">Purchase Sauda</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="window.location.href='@Url.Action("Index", "PurchaseSaudaList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>

    <form id="PurchaseSaudaForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">

        <!-- Row 1 -->
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label>Doc No</label>
                    <input type="number" class="form-control" id="txtDocNo" placeholder="Enter Doc No" readonly>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Doc Date<span class="required">*</span></label>
                    <input type="date" class="form-control" id="dtDocDate" placeholder="Select Doc Date">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Doc Status</label>
                    <select class="form-control" id="ddlDocStatus">
                        <option value="">-- Select Status --</option>
                        <option value="open" selected>Open</option>
                        <option value="closed">Closed</option>
                    </select>

                </div>
            </div>
      
            <div class="col-md-3">
                <div class="form-group">
                    <label>Supply From<span class="required">*</span></label>
                    <select class="form-control" id="ddlSupplyFrom">
                        <option value="">-- Select Supply From --</option>
                        <option>LOCAL</option>
                        <option>IMPORT</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Party Details</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Party Name<span class="required">*</span></label>
                                <select class="form-control" id="ddlPartyName">
                                    <option value="">-- Select Party Name --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Address Line 1</label>
                                <textarea type="text" class="form-control" id="txtAddress1" placeholder="Enter Address Line 1" readonly></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Address Line 2</label>
                                <textarea type="text" class="form-control" id="txtAddress2" placeholder="Enter Address Line 2" readonly></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Address Line 3</label>
                                <textarea type="text" class="form-control" id="txtAddress3" placeholder="Enter Address Line 3" readonly></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Station</label>
                                <input type="text" class="form-control" id="txtStation" placeholder="Enter Station" readonly>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Country</label>
                                <input type="text" class="form-control" id="txtCountry" placeholder="Enter Country" readonly>
                            </div>
                        </div>
                 
                    </div>
                    <div class="row">
                                             
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Ship From</label>
                                <select class="form-control" id="ddlShipFrom">
                                    <option value="">-- Select Ship From --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-8">
                <fieldset class="fieldset-sub-divide" style="height:338px;">
                    <legend class="sub-legend">Purchase Details</legend>
                    <div class="row">
                       
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Item Name<span class="required">*</span></label>
                                <select class="form-control" id="ddlItemName">
                                    <option value="">-- Select Item Name --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>No. of Trucks</label>
                                <input type="number" class="form-control" id="numTrucks" placeholder="Enter Truck Count">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Weight (Kgs)<span class="required">*</span></label>
                                <input type="number" class="form-control" id="numWeight" placeholder="Enter Weight">
                            </div>
                        </div>
                    </div>
                   
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Rate<span class="required">*</span> </label>
                                <div class="input-divide">
                                    <select class="form-control" id="ddlRate">
                                        <option value="Rs">Rs</option>
                                        <option value="USD">USD</option>
                                        <option value="Yen">Yen</option>
                                        <option value="CNY">CNY</option>
                                    </select>
                                    <input type="number" class="form-control" id="numRate" placeholder="Enter Rate" >
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>ExRate</label>
                                <input type="text" class="form-control" id="txtExRate" placeholder="Enter ExRate">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Discount %</label>
                                <input type="number" class="form-control" id="numDiscount" placeholder="Enter Discount %">
                            </div>
                        </div>
                    
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Tax Rate<span class="required">*</span></label>
                                <div class="input-divide">
                                    <select class="form-control" id="ddlTaxRate" style="width:100px;">
                                        <option value="">--Select Tax Rate--</option>
                                    </select>
                                    <input type="number" class="form-control" id="numTaxRate" placeholder="Enter Tax Rate" readonly>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Net Rate</label>
                                <input type="number" class="form-control" id="numNetRate" placeholder="Enter Net Rate" readonly>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Waste %</label>
                                <input type="number" class="form-control" id="numWaste" placeholder="Enter Waste %">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="btn-mt">
                                <div class="form-group" style="display: flex;gap: 10px;">
                                    <input type="checkbox" id="chkNatural">
                                    <label class="checkbox-label" for="chkNatural">Only Natural Bottle Accepted</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Payment Term<span class="required">*</span></label>
                                <select class="form-control" id="ddlPaymentTerm">
                                    <option value="">-- Select Payment Term --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Purchase Through<span class="required">*</span></label>
                                <select class="form-control" id="ddlPurchaseThrough">
                                    <option value="">-- Select Purchase Through --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Freight Term<span class="required">*</span></label>
                                <select class="form-control" id="ddlFreightTerm">
                                    <option value="">-- Select Freight Term --</option>
                                    <option value="FOR">FOR</option>
                                    <option value="EX">EX</option>
                                    <option value="FOB">FOB</option>
                                    <option value="CIF">CIF</option>
                                    <option value="CFR">CFR</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Delivery Term</label>
                                <input type="text" class="form-control" id="txtDeliveryTerm" placeholder="Enter Delivery Term" maxlength="100">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Remarks</label>
                                <textarea type="text" class="form-control" id="txtRemarks" placeholder="Enter Remarks"></textarea>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        <fieldset class="fieldset-sub">
            <legend class="sub-legend">Import Terms</legend>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>PI No.</label>
                        <input type="text" class="form-control" id="NumPINO" placeholder="Enter PI No." maxlength="50">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>PI Dt</label>
                        <input type="date" class="form-control" id="DtPIDate">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Offer No.</label>
                        <input type="text" class="form-control" id="NumOfferNo" placeholder="Enter Offer No." maxlength="50">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Broker Name</label>
                        <select class="form-control" id="ddlBrokerName">
                            <option value="">-- Select Broker Name --</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Brokerage/Comm.</label>
                        <input type="number" class="form-control" id="NumBrokerage" placeholder="Enter Brokerage/Comm"  maxlength="12">
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>Packing Type</label>
                        <select class="form-control" id="ddlPackingType">
                            <option value="">-- Select Packing Type --</option>
                            <option>Jumbo</option>
                            <option>Box</option>
                            <option>Pallet</option>
                            <option>Bales</option>
                            <option>Other</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>Dispatch From</label>
                        <select class="form-control" id="ddlDispatchFrom">
                            <option value="">-- Select Dispatch Location --</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>Payment Type</label>
                        <select class="form-control" id="ddlPaymentType">
                            <option value="">-- Select Payment Type --</option>
                            <option value="Advance">Advance</option>
                            <option value="Due">Due</option>
                            <option value="Paid">Paid</option>
                            <option value="Late">Late</option>
                            <option value="SBLC">SBLC</option>
                            <option value="TT">TT</option>
                            <option value="LC">LC</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group position-relative">
                        <label for="DtSBLCDue">SBLC Due Dt</label>
                        <div class="calender-check">
                            <input type="date" class="form-control" id="DtSBLCDue" style="padding-left: 30px;">
                            <input type="checkbox" id="chkSBLCDue" class="checkbox-inside">
                        </div>
                    </div>
                </div>

               @*  <div class="col-md-3">
                    <div class="form-group">
                        <label for="DtSBLCDue">SBLC Due Dt</label>
                        <div class="d-flex align-items-center">
                            <input type="checkbox" id="chkSBLCDue" style="margin-right: 10px;">
                            <input type="date" class="form-control" id="DtSBLCDue">
                        </div>
                    </div>
                </div> *@
                <div class="col-md-3">
                    <div class="form-group position-relative">
                        <label for="DtLCDue">LC Due Dt</label>
                        <div class="calender-check">
                            <input type="date" class="form-control" id="DtLCDue" style="padding-left: 30px;">
                            <input type="checkbox" id="chkDtLCDue" class="checkbox-inside">
                        </div>
                    </div>
                </div>
                @* <div class="col-md-3">
                    <div class="form-group">
                        <label>LC Due Dt</label>
                        <div class="d-flex align-items-center">
                            <input type="checkbox" id="chkDtLCDue" style="margin-right: 10px;">
                        <input type="date" class="form-control" id="DtLCDue" >
                        </div>
                    </div>
                </div> *@
                <div class="col-md-2">
                    <div class="form-group">
                        <label id="GradeID">Grade<span class="required">*</span></label>
                        <select class="form-control" id="ddlGrade">
                            <option value="">-- Select Grade --</option>
                            <option value="PE">PE</option>
                            <option value="PP">PP</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Item Remarks</label>
                        <textarea class="form-control" id="TxtItemRemarks" placeholder="Enter remarks" maxlength="300"   ></textarea>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="table-responsive-entry">
                    <table id="tblAttachmentPS" class="table-entry">
                        <thead class="table-head">
                            <tr>
                                <th style="display:none;">Code</th>
                                <th>File Name</th>
                                <th>File Upload</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

            </div>
        </fieldset>
        <div class="row">
            <div class="offset-md-6 col-md-6">
                <div class="button-right">
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#deliveryPlanModal">
                        <i class="fa fa-truck"></i> Create/View Delivery Plan
                    </button>

                    <button type="button" class="btn btn-primary">
                        <i class="fa fa-file-invoice"></i> Create Purchase Order
                    </button>

                </div>
            </div>
        </div>
        <div class="row">
            <div class="offset-md-9 col-md-3">
                <div class="btn-last">
                    <button id="btn-save" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
                </div>
            </div>
        </div>
        <div class="modal fade" id="deliveryPlanModal" tabindex="-1" aria-labelledby="deliveryPlanModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="popup-header">
                        <h5 class="popup-title" id="deliveryPlanModalLabel">Dispatch Delivery Planning</h5>
                        <i class="fa fa-close btn-close" data-bs-dismiss="modal"></i>
                    </div>

                    <div class="modal-body">

                        <!-- Form Row -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Doc No</label>
                                    <input type="text" class="form-control" id="TxtDispatchDocNo" readonly>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Doc Date</label>
                                    <input type="date" class="form-control" id="DispatchDocDate" readonly>
                                </div>
                            </div>
                        </div>

                        <!-- Table -->
                        <div class="card">
                            <div class="table-responsive">
                                <table id="tblPurchaseQuotationList" class="table-width">
                                    <thead class="table-head">
                                        <tr>
                                            <th>Icode</th>
                                            <th>Item Name</th>
                                            <th>Del. Date</th>
                                            <th>Quantity</th>
                                            <th>Remarks</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr class="no-border-input">
                                            <td><input type="text" class="form-control" id="TxtIcode" /></td>
                                            <td><input type="text" class="form-control" id="TxtItemName" /></td>
                                            <td><input type="date" class="form-control" id="DtDelDate" /></td>
                                            <td><input type="number" class="form-control" id="NumQuantity" /></td>
                                            <td><input type="text" class="form-control" id="TxtRemarks" /></td>
                                        </tr>

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>


                    <div class="modal-footer">
                        <button id="DispatchSave" type="button" class="btn btn-success">
                            <i class="fa fa-save"></i> Save
                        </button>

                    </div>

                </div>
            </div>
        </div>
    </form>
</fieldset>

<script>
        $(document).ready(async function () {
            const urlParams = new URLSearchParams(window.location.search);
            const rowId = urlParams.get('id');
            const mode = urlParams.get('mode');
            const $attachmentTbody = $('#tblAttachmentPS tbody');
            const $dispatchtableTbody = $('#tblPurchaseQuotationList tbody');
            let attachmentIndex = Date.now();

          addAttachmentRow()

           if (!rowId) {
                await GetVNo();
                document.getElementById('dtDocDate').valueAsDate = new Date();
                 document.getElementById('DispatchDocDate').valueAsDate = new Date();
            }

               

                    LoadDropDown()
            .then(() => {
                if (rowId) {
                    return LoadFormByID(rowId).then(() => {
                        const selectedValue = $('#ddlSupplyFrom').val();

                 
                        if (selectedValue === "IMPORT") {
                            $('#GradeID').html('Grade <span class="required">*</span>');
                        } else {
                            $('#GradeID').html('Grade');
                        }

                        const DtSBLCDue = $("#DtSBLCDue").val();
                        if (DtSBLCDue) {
                        $("#chkSBLCDue").prop("checked", true);
                        } else {
                        $("#chkSBLCDue").prop("checked", false);
                        }

                        const DtLCDue = $("#DtLCDue").val();
                        if (DtLCDue) {
                        $("#chkDtLCDue").prop("checked", true);
                        } else {
                        $("#chkDtLCDue").prop("checked", false);
                        }
                                               
                    });
                }
            })
            .catch(error => {
                console.error("An error occurred:", error);
            });


          if (mode === "view") {
               setFormReadOnly();
                  $('#PurchaseRequestForm').after(
                 '<span class="badge bg-secondary ms-2">Read‑Only Mode</span>'
               );
             }

          $('#ddlPartyName').on('change', function () {
                const selectedValue = this.value;
                if (selectedValue) {
                fetchDDlParty(selectedValue);
            }
            });

          $('#ddlSupplyFrom').on('change', function () {
                const selectedValue = this.value;
                if (selectedValue === "IMPORT") {
                    $('#GradeID').html('Grade <span class="required">*</span>');
                } else {
                    $('#GradeID').html('Grade');
                }
            });

          $('.btn-add-row-last').on('click', function () {
            const lastRowFileNameInput = $attachmentTbody.find('tr:last input[type="text"]').val();
            if (lastRowFileNameInput === '') {
                toastr.warning('Please Select Prevoius Row Attachment.');
                return;
            }
            addAttachmentRow();
            });

          $('#numRate, #numDiscount,  #ddlTaxRate').on('change', recalculateNetRate);

          $(document).on('click', '.btn-add-action', function () {

            const lastRowFileNameInput = $attachmentTbody.find('tr:last input[type="text"]').val();
            if (lastRowFileNameInput === '') {
                toastr.warning('Please Select Prevoius Row Attachment.');
                return;
            }

            addAttachmentRow();
          });

          $(document).on('click', '.btn-delete-action', function () {
            if (confirm('Are you sure you want to delete this attachment?')) {
              $(this).closest('tr').remove();
            }
          });

          $(document).on('click', '.btn-edit-action', function () {
            const $btn = $(this);
            const $row = $btn.closest('tr');
            const $input = $row.find('input[type="text"]');

            $btn.toggleClass('editing');
            const isEditing = $btn.hasClass('editing');

            $input.prop('disabled', !isEditing);
            $input.focus();
            $input.css('background-color', isEditing ? '#f0f8ff' : 'white');
          });

          $(document).on('change', 'input[type="file"]', function () {
            const fileInput = this;
            const fileName = fileInput.files.length ? fileInput.files[0].name : '';
            const $row = $(this).closest('tr');
            $row.find('input[type="text"]').val(fileName);
          });

          $("#btn-save").click(function (e) {
            e.preventDefault();
                    const DOC_ID = $.trim($('#TxtCode').val()) || null;
                    const V_NO = $.trim($('#txtDocNo').val()) ? parseFloat($.trim($('#txtDocNo').val())) : null;
                    const V_DATE = formatDate($("#dtDocDate").val()) || null;
                    const SHIP_CODE = parseInt($('#ddlShipFrom').val()) || 0;
                    const SHIP_TYPE = $.trim($('#ddlSupplyFrom option:selected').text()) || "";
                    const PARTY_CODE = parseInt($('#ddlPartyName').val()) || 0;
                    const ADD1 = $.trim($('#txtAddress1').val()) || "";
                    const ADD2 = $.trim($('#txtAddress2').val()) || "";
                    const ADD3 = $.trim($('#txtAddress3').val()) || "";
                    const CityName = $('#txtStation').val().trim();
                    const CITY_CODE = $('#txtStation').data('cityCode') || 0;
                    const PHONE = $.trim($('#NumContactNo').val()) || "";
                    const ITEM_CODE = parseInt($('#ddlItemName').val()) || 0;
                    const TRUCK_NO = parseInt($('#numTrucks').val()) || 0;
                    const EXRATE = parseFloat($('#txtExRate').val()) || 0;
                    const DISC_PER = parseFloat($('#numDiscount').val()) || 0;
                    const REMARK = $.trim($('#txtRemarks').val()) || "";
                    const PINO = $.trim($('#NumPINO').val()) || "";
                    const PIDATE = formatDate($("#DtPIDate").val()) || null;
                    const OFFERNO = $.trim($('#NumOfferNo').val()) || "";
                    const BROKER_RATE = parseFloat($('#NumBrokerage').val()) || 0;
                    const BROKER = parseInt($('#ddlBrokerName').val()) || 0;
                    const PACK_TYPE = $.trim($('#ddlPackingType option:selected').text()) || "";
                    const DISPATCH_FROM = parseInt($('#ddlDispatchFrom').val()) || 0;
                    const PAYMENT_STATUS = $.trim($('#ddlPaymentType option:selected').text()) || "";
                    const CURRENCY = $.trim($('#ddlRate option:selected').text()) || "";
                 
                    let SBLC_DUEDATE = null;
                    if ($("#chkSBLCDue").is(":checked")) {
                        const dateVal = $("#DtSBLCDue").val();
                        SBLC_DUEDATE = dateVal ? dateVal : null;
                    } else {
                        SBLC_DUEDATE = null;
                    }

                    const GRADE = $.trim($('#ddlGrade option:selected').text()) || "";
                    const ITEM_REMARKS = $.trim($('#TxtItemRemarks').val()) || "";
                    const WASTE_PER = parseInt($('#numWaste').val()) || 0;
                    const RATE = parseFloat($('#numRate').val()) || 0;
                    const TAX_CODE = parseFloat($('#ddlTaxRate').val()) || 0;
                    const TAX_RATE = parseFloat($('#numTaxRate').val()) || 0;
                    const ONLY_NATURAL = $('#chkNatural').prop('checked') ? 1 : 0;
                    const ITEM_TYPE = $.trim($('#ddlItemType option:selected').text()) || "";
                    const QTY = parseInt($('#numWeight').val()) || 0;
                    const FRT_TERM = $.trim($('#ddlFreightTerm option:selected').text()) || "";
                    const NET_RATE = parseFloat($('#numNetRate').val()) || 0;
