@{
    ViewBag.Title = "Import Payment Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
@* <style>
    .erppage-grid4 {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        column-gap: 16px;
        row-gap: 10px;
        padding: 6px;
        align-items: start;
    }

    .erppage-grid5 {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        column-gap: 16px;
        row-gap: 10px;
        padding: 6px;
        align-items: start;
    }

    .erppage-label {
        font-size: 11px;
        color: #2c2c2c;
        margin: 0;
        font-weight: 600;
        display: contents;
    }
</style> *@
<div id="erp-toast-container"></div>
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-credit-card"></i>
        <span>Import Payment Entry</span>
    </div>
    <div class="erppagelist-header-right">
        <button class="erppage-header-back" onclick="window.location.href='@Url.Action("Index", "ImportPaymentList")'">
            <i class="fa-solid fa-arrow-left"></i>Back to List
        </button>
    </div>
</div>
<div class="erppage-fieldset">
    <div class="erppage-container">
        <div class="erppage-tabs">
            <button class="erppage-tab active" data-tab="mainpage">Main Page</button>
            <button class="erppage-tab" data-tab="bankdetails">Bank Details</button>
            <button class="erppage-tab" data-tab="customerdeclaration">Customer Declaration</button>
            <button class="erppage-tab" data-tab="forma2">Form A2</button>
            <button class="erppage-tab" data-tab="partybinfo">Part B Info. About ECB</button>
            <button class="erppage-tab" data-tab="partcd">Part-C & D</button>
        </div>

        <!-- Main Page -->
        <div class="erppage-tab-content active" id="mainpage">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Type</label>
                    <select class="erppage-input erppage-select" id="ddldoctype">
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc No</label>
                    <input type="number" class="erppage-input" id="Numdocno" readonly />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-input" id="Dtdocdate" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Currency</label>
                    <select class="erppage-input erppage-select" id="ddlcurrency">
                        <option value="">Select Currency</option>
                    </select>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Party Name</label>
                    @* <select class="erppage-input erppage-select" id="ddlpartyname">
                        <option value="">Select Party Name</option>
                    </select> *@
                    <input type="text" id="txtSupplierName" class="erppage-input erppage-select" placeholder="Search Supplier" />
                    <input type="hidden" id="hdnSupplierCode">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Evidence</label>
                    <input type="text" class="erppage-input" id="Txtdocevidence" placeholder="Enter Doc Evidence" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Purpose of ECB/Nature of Project</label>
                    <select class="erppage-input erppage-select" id="ddlnatureproject">
                        <option value="importpayment">Import Payment</option>
                        <option value="others">Others</option>
                    </select>
                </div>
            </div>
            <div class="erppage-grid5">
                <div class="erppage-divfield">
                    <label class="erppage-label">Import of</label>
                    <select class="erppage-input erppage-select" id="ddlimport">
                        <option value="goods">Goods</option>
                        <option value="services">Services</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Import Remitt.</label>
                    <select class="erppage-input erppage-select" id="ddlimportremitt">
                        <option value="swift">Swift</option>
                        <option value="demanddraft">Demand Draft</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Pay Type</label>
                    <select class="erppage-input erppage-select" id="ddlpaytype">
                        <option value="advance">Advance</option>
                        <option value="direct">Direct</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Foreign Bank Ch.</label>
                    <select class="erppage-input erppage-select" id="ddlforeignbankch">
                        <option value="onus">On Us</option>
                        <option value="onbeneficiary">On Beneficiary</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Int. Rate Appl.</label>
                    <select class="erppage-input erppage-select" id="ddlintrateappl">
                        <option value="yes">Yes</option>
                        <option value="no">No</option>
                    </select>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Remarks</label>
                    <textarea typeof="text" class="erppage-input" id="txtremarks" placeholder="Enter Remarks"></textarea>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Net Amount</label>
                    <input type="number" class="erppage-input" id="Numnetamount" placeholder="Enter Net Amount" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Sauda No</label>
                    <select class="erppage-input erppage-select" id="ddlsaudano">
                        <option value="">Select Sauda No</option>
                    </select>
                </div>
                <div class="erppage-internalaction">
                    <button type="button" id="btn_fillgrid" class="erppage-btn erppage-btn-common-active">
                        <i class="fa fa-fill"></i>
                        <span>Fill Grid</span>
                    </button>
                </div>
            </div>
            <div class="erppage-internalaction mt-2">
                <button type="button" id="btnRequestLetter" class="erppage-btn erppage-btn-common-disabled">
                    <i class="fa fa-envelope-open-text"></i>
                    <span>Request Letter</span>
                </button>
                <button type="button" id="btnPaymentRequestForm" class="erppage-btn erppage-btn-common-disabled">
                    <i class="fa fa-file-invoice-dollar"></i>
                    <span>Payment Request Form</span>
                </button>
                <button type="button" id="btnSupplierCredit" class="erppage-btn erppage-btn-common-disabled">
                    <i class="fa fa-hand-holding-usd"></i>
                    <span>Supplier Credit</span>
                </button>
                <button type="button" id="btnFormA2" class="erppage-btn erppage-btn-common-disabled">
                    <i class="fa fa-file-alt"></i>
                    <span>Form A2</span>
                </button>
                <button type="button" id="btnPartB" class="erppage-btn erppage-btn-common-disabled">
                    <i class="fa fa-file-signature"></i>
                    <span>Part B</span>
                </button>
                <button type="button" id="btnPaymentECB" class="erppage-btn erppage-btn-common-disabled">
                    <i class="fa fa-credit-card"></i>
                    <span>Payment of ECB</span>
                </button>
                <button type="button" id="btnBuyerCredit1" class="erppage-btn erppage-btn-common-disabled">
                    <i class="fa fa-university"></i>
                    <span>Buyer Credit 1</span>
                </button>
            </div>
            <div class="erppage-internalaction mt-2">
                <button type="button" id="btnBuyerCredit2" class="erppage-btn erppage-btn-common-disabled">
                    <i class="fa fa-bank"></i>
                    <span>Buyer Credit 2</span>
                </button>
                <button type="button" id="btnForm1Declaration" class="erppage-btn erppage-btn-common-disabled">
                    <i class="fa fa-file-text"></i>
                    <span>Form 1 Declaration</span>
                </button>
                <button type="button" id="btnCustomDeclaration" class="erppage-btn erppage-btn-common">
                    <i class="fa fa-gavel"></i>
                    <span>Custom Declaration</span>
                </button>
            </div>
        </div>
        <!-- Bank Details -->
        <div class="erppage-tab-content" id="bankdetails">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Our Bank</label>
                    <select class="erppage-input erppage-select" id="ddlourbank">
                        <option value="">Select Our Bank</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Our A/C No</label>
                    <input type="number" class="erppage-input" id="Numacno" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Our Shift</label>
                    <input type="text" class="erppage-input" id="Txtourshift" placeholder="Enter our shift" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">AD Code</label>
                    <input type="text" class="erppage-input" id="Txtadcode" placeholder="Enter AD Code" />
                </div>
            </div>
            <div class="erppagesrow">
                <div class="erppagescol-6">
                    <fieldset class="erppagefieldset">
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Beneficiary Bank</label>
                                <select class="erppage-input erppage-select" id="ddlbeneficiarybank">
                                    <option value="">Select Beneficiary Bank</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Beneficiary A/C No</label>
                                <input type="number" class="erppage-input" id="Numbeneficiaryacno" />
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Beneficiary Swift</label>
                                <input type="text" class="erppage-input" id="Txtbeneficiaryshift" placeholder="Enter Beneficiary shift" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Beneficiary ABA</label>
                                <input type="text" class="erppage-input" id="Txtbeneficiaryaba" placeholder="Enter Beneficiary ABA" />
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Beneficiary Routing</label>
                                <input type="text" class="erppage-input" id="Txtbeneficiaryrouting" placeholder="Enter Beneficiary Routing" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Beneficiary Source Code</label>
                                <input type="number" class="erppage-input" id="Numbeneficiaryacno" />
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label">Beneficiary Bank Address</label>
                                <textarea typeof="text" class="erppage-input" id="Txtbeneficiarybankaddress" style="height:50px;" placeholder="Enter Beneficiary Bank Address"></textarea>
                            </div>
                        </div>
                    </fieldset>
                </div>

                <div class="erppagescol-6">
                    <fieldset class="erppagefieldset">
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Correspondance Bank</label>
                                <select class="erppage-input erppage-select" id="ddlcorrespondancebank">
                                    <option value="">Select Correspondance Bank</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Correspondance A/C No</label>
                                <input type="number" class="erppage-input" id="Numcorrespondanceacno" />
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Correspondance Swift</label>
                                <input type="text" class="erppage-input" id="Txtcorrespondanceshift" placeholder="Enter Correspondance shift" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Correspondance ABA</label>
                                <input type="text" class="erppage-input" id="Txtcorrespondanceaba" placeholder="Enter Correspondance ABA" />
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Correspondance Routing</label>
                                <input type="text" class="erppage-input" id="Txtcorrespondancerouting" placeholder="Enter Correspondance Routing" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Correspondance Source Code</label>
                                <input type="number" class="erppage-input" id="Numcorrespondanceacno" />
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label">Correspondance Bank Address</label>
                                <textarea typeof="text" class="erppage-input" id="Txtcorrespondancebankaddress" style="height:50px;" placeholder="Enter Correspondance Bank Address"></textarea>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>


        </div>
        <!-- Customer Declaration -->
        <div class="erppage-tab-content" id="customerdeclaration">
            <div class="erppage-grid3">
                <div class="erppage-divfield">
                    <label class="erppage-label">SPFC Bank</label>
                    <select class="erppage-input erppage-select" id="ddlSPFCBank">
                        <option value="">Select SPFC Bank</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Other Doc Details:</label>
                    <input type="text" class="erppage-input" id="txtotherdocumentdetails" placeholder="Enter Other Document Details" />
                </div>
            </div>
            <div class="erppagesrow">
                <div class="erppagescol-4">
                    <fieldset class="erppagefieldset">
                        <legend class="erppagefieldset-legend">Details of Part Payment as per below Invoice</legend>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Bill Reference No.</label>
                                <input type="text" class="erppage-input" id="txtbillreferenceno" placeholder="Enter Bill Reference No." />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">CCY</label>
                                <input type="text" class="erppage-input" id="txtCCY" placeholder="Enter CCY" />
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Amount Remitted</label>
                                <input type="number" class="erppage-input" id="Numamountremitted" placeholder="Enter Amount Remitted" />
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="erppagescol-4">
                    <fieldset class="erppagefieldset">
                        <legend class="erppagefieldset-legend">FEMA Declaration</legend>
                        <div class="erppagesrow" style="gap:12px; padding:10px;">
                            <div class="erppage-divfield">
                                <div class="erppage-checkbox-wrap">
                                    <input type="checkbox" id="Chknotcoveredunderprohibited" class="erppage-checkbox-input">
                                    <label class="erppage-checkbox-label">Not Covered Under Prohibited</label>
                                </div>
                            </div>
                            <div class="erppage-divfield">
                                <div class="erppage-checkbox-wrap">
                                    <input type="checkbox" id="Chkreceivedforimport" class="erppage-checkbox-input">
                                    <label class="erppage-checkbox-label">Received for import</label>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="erppagescol-4">
                    <fieldset class="erppagefieldset">
                        <legend class="erppagefieldset-legend">Document Attached</legend>
                        <div class="erppagesrow" style="gap:12px; padding:10px;">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Document Attached</label>
                                <div id="ddlDocumentAttached" class="erppage-search-inputdropdown"></div>
                            </div>
                            <div class="erppage-divfield">
                                <div class="erppage-checkbox-wrap">
                                    <input type="checkbox" id="Chkproformainvoice" class="erppage-checkbox-input">
                                    <label class="erppage-checkbox-label">Proforma Invoice</label>
                                </div>
                            </div>
                            <div class="erppage-divfield">
                                <div class="erppage-checkbox-wrap">
                                    <input type="checkbox" id="Chkpurchaseorderraised" class="erppage-checkbox-input">
                                    <label class="erppage-checkbox-label">Purchase Order Raised</label>
                                </div>
                            </div>
                            <div class="erppage-divfield">
                                <div class="erppage-checkbox-wrap">
                                    <input type="checkbox" id="Chktransportdocument" class="erppage-checkbox-input">
                                    <label class="erppage-checkbox-label">Transport Document</label>
                                </div>
                            </div>
                            <div class="erppage-divfield">
                                <div class="erppage-checkbox-wrap">
                                    <input type="checkbox" id="Chkcopybillentry" class="erppage-checkbox-input">
                                    <label class="erppage-checkbox-label">Copy of Bill Entry</label>
                                </div>
                            </div>
                            <div class="erppage-divfield">
                                <div class="erppage-checkbox-wrap">
                                    <input type="checkbox" id="Chkcopybillentry" class="erppage-checkbox-input">
                                    <label class="erppage-checkbox-label">Copy of Bill Entry</label>
                                </div>
                            </div>
                            <div class="erppage-divfield">
                                <div class="erppage-checkbox-wrap">
                                    <input type="checkbox" id="Chkforma2" class="erppage-checkbox-input">
                                    <label class="erppage-checkbox-label">Form A2</label>
                                </div>
                            </div>
                            <div class="erppage-divfield">
                                <div class="erppage-checkbox-wrap">
                                    <input type="checkbox" id="ChkPaymentmade" class="erppage-checkbox-input">
                                    <label class="erppage-checkbox-label">If Payment is being made</label>
                                </div>
                            </div>
                        </div>
                        <div class="erppagesrow" style="gap:12px; padding: 0px 10px 0px 10px;">
                            <div class="erppage-divfield">
                                <div class="erppage-checkbox-wrap">
                                    <input type="checkbox" id="ChkOriginallicence" class="erppage-checkbox-input">
                                    <label class="erppage-checkbox-label">Original Licence</label>
                                </div>
                            </div>
                            <div class="erppage-divfield">
                                <div class="erppage-checkbox-wrap">
                                    <input type="checkbox" id="ChkOriginallicence" class="erppage-checkbox-input">
                                    <label class="erppage-checkbox-label">Original Bank Guarantee</label>
                                </div>
                            </div>
                            <div class="erppage-divfield">
                                <div class="erppage-checkbox-wrap">
                                    <input type="checkbox" id="ChkAnyOtherDocument" class="erppage-checkbox-input">
                                    <label class="erppage-checkbox-label">Any Other Document</label>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>



        </div>
        <!-- Form A2 -->
        <div class="erppage-tab-content" id="forma2">
            <div class="erppagesrow" style="gap:12px; padding:10px;">
                <div class="erppage-divfield">
                    <div class="erppage-checkbox-wrap">
                        <input type="checkbox" id="Chkissuedraft" class="erppage-checkbox-input">
                        <label class="erppage-checkbox-label">Issue a Draft</label>
                    </div>
                </div>
                <div class="erppage-divfield">
                    <div class="erppage-checkbox-wrap">
                        <input type="checkbox" id="Chkeffectforeignexchange" class="erppage-checkbox-input">
                        <label class="erppage-checkbox-label">Effect of Foreign Exchange Remittance directly</label>
                    </div>
                </div>
                <div class="erppage-divfield">
                    <div class="erppage-checkbox-wrap">
                        <input type="checkbox" id="Chkissuetravellerscheque" class="erppage-checkbox-input">
                        <label class="erppage-checkbox-label">Issue Travellers Cheques for</label>
                    </div>
                </div>
                <div class="erppage-divfield">
                    <div class="erppage-checkbox-wrap">
                        <input type="checkbox" id="Chkissueforeigncurrencynotes" class="erppage-checkbox-input">
                        <label class="erppage-checkbox-label">Issue foreign currency notes for</label>
                    </div>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Benifi. Name</label>
                    @* <select class="erppage-input erppage-select" id="ddlBeeficiaryname">
                        <option value="">Select Benificiary Name</option>
                    </select> *@
                    <input type="text" id="ddlBeeficiaryname" class="form-control" placeholder="Search Supplier" />
                    <input type="hidden" id="hdnBeneficiaryCode">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Account No</label>
                    <input type="number" class="erppage-input" id="NumAccountno" />
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Name and Bank Address</label>
                    <textarea typeof="text" class="erppage-input" rows="2" id="Txtnamebankaddress" placeholder="Enter Name and Bank Address"></textarea>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Amount</label>
                    <input type="number" class="erppage-input" id="Numamount" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Whether Under LRS</label>
                    <select class="erppage-input erppage-select" id="ddlLRS">
                        <option value="yes">Yes</option>
                        <option value="no">No</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Purpose Code</label>
                    <input type="text" class="erppage-input" id="Txtpurposecode" placeholder="Enter Purpose Code" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Description</label>
                    <textarea typeof="text" class="erppage-input" rows="2" id="Txtnamebankaddress" placeholder="Enter Name and Bank Address"></textarea>
                </div>
            </div>
        </div>
        <!-- Part B Info. About -->
        <div class="erppage-tab-content" id="partybinfo">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Name of lender/Supplier</label>
                    @* <select class="erppage-input erppage-select" id="ddlLender">
                        <option value="">Select Name of lender/Supplier</option>
                    </select> *@
                    <input type="text" id="ddlLender" class="form-control" placeholder="Search Supplier" />
                    <input type="hidden" id="hdnLenderCode">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Address of lender</label>
                    <textarea typeof="text" class="erppage-input" id="textaddresslender" placeholder="Enter Address of lender"></textarea>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Nature of security to be provided</label>
                    <input type="text" class="erppage-input" id="Txtnaturesecurity" placeholder="Enter Nature of Security" />
                </div>
            </div>
            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Nature of ECB</legend>
                <div class="erppagesrow" style="gap:12px; padding: 0px 10px 0px 10px;">
                    <div class="erppage-divfield">
                        <div class="erppage-checkbox-wrap">
                            <input type="checkbox" id="Chksuppliercredit" class="erppage-checkbox-input">
                            <label class="erppage-checkbox-label">Supplier's Credit</label>
                        </div>
                    </div>
                    <div class="erppage-divfield">
