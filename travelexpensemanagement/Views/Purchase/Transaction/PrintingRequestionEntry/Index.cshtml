@{
    ViewBag.Title = "Printing Requestion Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-print"></i>
        </div>
        <div class="erppage-header-title">Printing Requestion Entry</div>
    </div>
    <div class="erppage-header-right">

        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" onclick="PrintingRequestionEntryReport()">
            <i class="fa fa-print"></i> Print
        </button>

        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "PrintingRequestionList")', readOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="PrintingRequestionForm">
    <input type="hidden" class="form-control" id="TxtCode" name="CODE">
    <div class="erppage-container">
        <div class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc No</label>
                    <input type="number" class="erppage-input" id="NumDocNo" placeholder="Enter Doc No">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-input" id="DtDocDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Place</label>
                    <select class="erppage-input erppage-select" id="ddlPlace">
                        <option value="">Select Place</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Status</label>
                    <select class="erppage-input erppage-select" id="ddlStatus">
                        <option value="">Select Status</option>
                    </select>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Department</label>
                    <select class="erppage-input erppage-select" id="ddlDepartment">
                        <option value="">Select Department</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Req. Date</label>
                    <input type="date" class="erppage-input" id="DtRequiredDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Reason</label>
                    <textarea typeof="text" class="erppage-input" id="TxtReason" placeholder="Enter Reason"></textarea>
                </div>
            </div>
            <div class="erppage-grid2">
                <div class="erppage-divfield">
                    <label class="erppage-label">Request By</label>
                    <div class="erppage-inputgroup">
                        <select class="erppage-input erppage-select" id="ddlrequestby">
                            <option value="">Select Request By</option>
                        </select>
                        <input type="text" class="erppage-input" id="Txtrequestby">
                    </div>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Remarks</label>
                    <textarea typeof="text" class="erppage-input" id="TxtRemarks" placeholder="Enter Remarks"></textarea>
                </div>
            </div>
            @* item Master *@
            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Item Details</legend>
                <div class="excel-wrapper fixed-grid-wrapper">
                    <table id="tblPrintingRequestionEntry" class="excel-table fixed-grid-table table-width resizable-table">
                        <colgroup>
                            <col class="hidden-col">
                            <col style="width:180px;">
                            <col style="width:220px;">
                            <col style="width:120px;">
                            <col style="width:100px;">
                            <col style="width:80px;">
                            <col style="width:120px;">
                            <col style="width:120px;">
                            <col style="width:100px;">
                            <col style="width:150px;">
                            <col style="width:180px;">
                            <col style="width:120px;">
                            <col style="width:120px;">
                            <col style="width:120px;">
                            <col style="width:220px;">
                            <col style="width:220px;">
                        </colgroup>
                        <thead>
                            <tr>
                                <th class="hidden-col">Code</th>
                                <th>Item Name</th>
                                <th>Description</th>
                                <th>Make</th>
                                <th>Mat. Type</th>
                                <th>Unit</th>
                                <th>Req. Quantity</th>
                                <th>Printing Type</th>
                                <th>Finish</th>
                                <th>Place of Use</th>
                                <th>Reason</th>
                                <th>Priority Type</th>
                                <th>Work Type</th>
                                <th>Scrap Type</th>
                                <th>Remarks</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </fieldset>
            @* item Master *@
            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Attachment</legend>
                <div class="erppage-tab-content" id="attachment">
                    <div class="erppage-accordion-body">
                        <div class="erppageattachmentsection">
                            <div class="erppageattachmentsectionrow">
                                <div class="erppageattachmentsectioncol">
                                    <div class="erppageattachmentsectionuploadcard">
                                        <h2 class="erppageattachmentsectiontitle">UPLOAD MULTIPLE FILES</h2>
                                        <div class="erppageattachmentsectiondropzone" id="dropZone">
                                            <div class="erppageattachmentsectioncloud">
                                                <i class="fa fa-cloud"></i>
                                            </div>
                                            <div class="erppageattachmentsectiondragtext">
                                                Drag & Drop your files here
                                            </div>
                                            <div class="erppageattachmentsectionor">
                                                OR
                                            </div>
                                            <button type="button" class="erppageattachmentsectionbrowsebtn" id="browseBtn">
                                                Browse Files
                                            </button>
                                            <input type="file" id="fileInput" multiple hidden>
                                        </div>
                                    </div>
                                </div>
                                <div class="erppageattachmentsectioncol">
                                    <div class="erppageattachmentsectionfilecard">
                                        <div class="erppageattachmentsectionheader">Uploaded Files</div>
                                        <div class="erppageattachmentsectionfilelist" id="fileList">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">

                        <div class="modal-dialog erppagesmodal small-modal">

                            <div class="modal-content erppagesmodal-content">

                                <div class="erppagesmodal-header">

                                    <div class="erppagesmodal-header-left">

                                        <div class="erppagesmodal-header-icon">
                                            <i class="fa fa-image"></i>
                                        </div>

                                        <h5 class="erppagesmodal-title">
                                            Attachment Preview
                                        </h5>

                                    </div>

                                    <button type="button" class="erppagesmodal-close" data-bs-dismiss="modal" aria-label="Close">
                                        <i class="fa fa-times"></i>
                                    </button>
                                </div>
                                <div class="erppagesmodal-body text-center">
                                    <img id="previewImage" src="" style="width:100%;height:75vh; object-fit:contain; display:none;" />
                                    <iframe id="previewPdf" style="width:100%; height:75vh; border:none; display:none;">
                                    </iframe>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>
            <div class="erppage-container">
                <div class="erppage-actions">
                    <button id="btn-save" type="button" class="erppage-btn erppage-btn-save">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>Save</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let itemList = [];
    let priorityList = [];
    let workTypeList = [];
    let rowsAttachment = [];
    function getQueryParam(param) {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(param);
    }
    const code = getQueryParam('vNo');
    const vType = getQueryParam('vType');
    const mode = getQueryParam("mode");

    $(document).ready(function () {
        ddlDocNo();
        loadCurrentDate();
        bindStatus();
        bindPlace();
        bindDepartment();
        bindRequestBy();
        $.when(
            $.get('/PrintingRequestionEntry/GetPriority'),
            $.get('/PrintingRequestionEntry/GetWorkType'),
            $.get('/PrintingRequestionEntry/GetItem')
        )
        .done(function (priorityResponse, workTypeResponse, itemResponse) {
        priorityList = priorityResponse[0] || [];
        workTypeList = workTypeResponse[0] || [];
        itemList = itemResponse[0] || [];
        if (mode === 'view') {
          setPageReadOnly();
        } 
        // Now itemList is ready
        if (code) {
           $.ajax({
            url: '/PrintingRequestionEntry/GetById',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            data: JSON.stringify({
                vNo: parseInt(code, 10),
                vType: vType
            }),
            success: function (response) {
                console.log("GetById Response:", response);
                if (!response.success) {
                    toastr.error(
                        response.message || "Unable to load record.",
                        "Error"
                    );
                    return;
                }
                fillHeaderData(response.header);
                fillDetailData(response.details);
                getdataImage(response.images);
            },
            error: function (xhr, status, error) {
                toastr.error(xhr.responseText || "Unable to load record.","Error");
            }
        });
        } else {
            // New entry
            addNewRow();
        }
    })
        .fail(function (xhr) {

        console.error("Dropdown loading failed:", xhr.responseText);

        toastr.error(
            "Unable to load dropdown data.",
            "Error"
        );
    });
        readOnly = (mode === 'view');
        $(document).on("change", ".itemddl", function () {
            var itemCode = $(this).val();
            var makeDDL = $(this).closest("tr").find(".makeddl");
            makeDDL.empty();
            makeDDL.append('<option value="">Select Make</option>');

            if (!itemCode)
                return;
            $.ajax({
                url: "/PrintingRequestionEntry/GetMake",
                type: "GET",
                data: { itemCode: itemCode },
                success: function (data) {
                    $.each(data, function (i, item) {
                        makeDDL.append(
                            $('<option>', {
                                value: item.value,
                                text: item.text
                            })
                        );
                    });
                    if (data.length == 1) {
                        makeDDL.val(data[0].value);
                    }

                }
            });

        });
        $("#browseBtn").on("click", function () {
            $("#fileInput").click();
        });
        $('#fileInput').on('change', function (e) {
            const files = e.target.files;
            Array.from(files).forEach(file => {
            const reader = new FileReader();
            reader.onload = function (ev) {
                const mime = file.type || 'application/octet-stream';
                // New File
                rowsAttachment.push({FileName: file.name, File: file, IsExisting: false });
                const card = `
                    <div class="erp-file-row new-file"
                         data-filename="${file.name}">
                        <div class="erp-file-preview">
                            ${
                                mime.startsWith('image/') ? `<img src="${ev.target.result}" class="erp-file-thumbnail">`
                                : mime === 'application/pdf' ? `<i class="fa fa-file-pdf-o" style="font-size:40px;color:red;"></i>`
                                : `<i class="fa fa-file" style="font-size:40px;"></i>`
                            }
                        </div>
                        <div class="erp-file-info">
                            <div class="erp-file-name"> ${file.name} </div>
                            <div class="erp-file-type"> ${mime} </div>
                        </div>
                        <div class="erp-file-actions">
                            <button type="button" class="erp-btn view btn-view-attachment" data-src="${ev.target.result}" data-type="${mime}">
                                <i class="fa fa-eye"></i>
                            </button>
                            <button type="button" class="erp-btn delete btn-delete-attachment" data-filename="${file.name}"> <i class="fa fa-trash"></i></button>
                        </div>
                    </div>
                `;
                $('#fileList').append(card);
            };
            reader.readAsDataURL(file);
        });
            $(this).val('');
        });
        $(document).on("click", ".btn-view-attachment", function () {
        const src = $(this).data("src");
        const type = $(this).data("type");
        $("#previewImage").hide();
        $("#previewPdf").hide();
        if (type.startsWith("image/")) {
            $("#previewImage").attr("src", src).show();
        }
        else if (type === "application/pdf") {
            $("#previewPdf").attr("src", src).show();
        }
        else {
            alert("Preview not available for this file type.");
            return;
        }
        $("#imagePreviewModal").modal("show");
    });
        $(document).on("click", ".btn-delete-attachment", function () {
        const fileName = $(this).data("filename");
        rowsAttachment = rowsAttachment.filter(x => x.FileName !== fileName);
        $(this).closest(".erp-file-row").remove();
    });
        $(document).on("click", ".btn-add-row", function () {
         addNewRow();
        });

         $("#btn-save").click(function () {
         
         if (!validateData()) {
             return false;
         }
         var formData = new FormData();
         // Header
         formData.append("Header.DocNo", $("#NumDocNo").val());
         formData.append("Header.DocDate", $("#DtDocDate").val());
         formData.append("Header.Place", $("#ddlPlace").val());
         formData.append("Header.Status", $("#ddlStatus").val());
         formData.append("Header.Department", $("#ddlDepartment").val());
         formData.append("Header.RequiredDate", $("#DtRequiredDate").val());
         formData.append("Header.RequestBy", $("#ddlrequestby").val());
         formData.append("Header.RequestByName", $("#Txtrequestby").val());
         formData.append("Header.Reason", $("#TxtReason").val());
         formData.append("Header.Remarks", $("#TxtRemarks").val());
         var action = code > 0 ? "UPDATE" : "INSERT";
         formData.append("ACTION", action);

        // Detail Rows
         var details = [];
         $("#tblPrintingRequestionEntry tbody tr").each(function (i) {
            formData.append(`Details[${i}].ItemCode`, $(this).find(".itemddl").val());
            formData.append(`Details[${i}].Description`, $(this).find(".description").val());
            formData.append(`Details[${i}].Make`, $(this).find(".makeddl").val());
            formData.append(`Details[${i}].MatType`, $(this).find(".mattype").val());
            formData.append(`Details[${i}].Unit`, $(this).find(".unit").val());
            formData.append(`Details[${i}].Qty`, $(this).find(".qty").val());
            formData.append(`Details[${i}].PrintingType`, $(this).find(".printingtype").val());
            formData.append(`Details[${i}].Finish`, $(this).find(".finish").val());
            formData.append(`Details[${i}].PlaceUse`, $(this).find(".placeuse").val());
            formData.append(`Details[${i}].Reason`, $(this).find(".reason").val());
            formData.append(`Details[${i}].Priority`, $(this).find(".priority").val());
            formData.append(`Details[${i}].WorkType`, $(this).find(".worktype").val());
            formData.append(`Details[${i}].ScrapType`, $(this).find(".scraptype").val());
            formData.append(`Details[${i}].Remarks`, $(this).find(".remarks").val());
        });
         rowsAttachment.forEach(function (attachment) {
           if (attachment.File) {
               formData.append("Files", attachment.File);
           }
         });

        console.log("===== FormData =====");
        for (const pair of formData.entries()) {
         console.log(pair[0], pair[1]);
        }
         console.log('kks',formData)
         $.ajax({
              url: "/PrintingRequestionEntry/SaveAllData",
              type: "POST",
              data: formData,
              processData: false,
              contentType: false,
              success: function (res) {
               console.log(res);
                 if (res.success)
                 {
                      toastr.success(res.message, "Success");
                 }
                 else
                 {
                      toastr.error(res.message, "Error");
                 }
              }
         });
    });
    });
    function validateData() {
        // DOCUMENT NO
        var docNo = $("#NumDocNo").val();
        if (!docNo || parseInt(docNo) <= 0) {
            toastr.warning("Doc no is 0, record not saved.", "Validation");
            $("#NumDocNo").focus();
            return false;
        }
        // DEPARTMENT
        var department = $("#ddlDepartment").val();
        if (!department) { toastr.warning("Department Name is required.", "Validation" );
            $("#ddlDepartment").focus();
            return false;
        }
        var place = $("#ddlPlace").val();
        if (!place) {
            toastr.warning("Place is required.", "Validation");
            $("#ddlPlace").focus();
            return false;
        }
        var requestBy = $("#ddlrequestby").val();
        if (!requestBy) {
            toastr.warning("Requested by Name is required.", "Validation");
            $("#ddlrequestby").focus();
            return false;
        }
        var docDateValue = $("#DtDocDate").val();
        if (!docDateValue) {
            toastr.warning("Document Date is required.","Validation");
            $("#DtDocDate").focus();
            return false;
        }
        var requiredDateValue = $("#DtRequiredDate").val();
        if (!requiredDateValue) {
            toastr.warning("Required Date is required.","Validation");
            $("#DtRequiredDate").focus();
            return false;
        }
        var docDate = new Date(docDateValue);
        var requiredDate = new Date(requiredDateValue);
        // REQUIRED DATE < DOCUMENT DATE
        if (requiredDate < docDate) {
            toastr.warning("Required Date can not less than Document date.","Validation");
            $("#DtRequiredDate").focus();
            return false;
        }
        // REASON IF LESS THAN 5 DAYS
        var fiveDaysLater = new Date(docDate);
        fiveDaysLater.setDate(fiveDaysLater.getDate() + 5);
        if (requiredDate < fiveDaysLater && $.trim($("#TxtReason").val()) === "")
        {
            toastr.warning("Please specify the Reason for Urgent Requirement less than 5 days.", "Validation");
            $("#TxtReason").focus();
            return false;
        }
        // DETAIL ROW CHECK
        var validItemCount = 0;
        var itemCodes = [];
        var duplicateFound = false;
        $("#tblPrintingRequestionEntry tbody tr").each(function () {
            var row = $(this);
            var itemCode = row.find(".itemddl").val();
            var description = row.find(".description").val();
            var qty = row.find(".qty").val();
            var placeUse = row.find(".placeuse").val();
            // ITEM CODE
            if (description && (!itemCode || parseInt(itemCode) === 0))
            {
                toastr.warning("Item code not valid.","Validation");
                row.find(".itemddl").focus();
                duplicateFound = true;
                return false;
            }
            // VALID ITEM
            if (itemCode && parseInt(itemCode) > 0) {
                validItemCount++;
                // DUPLICATE ITEM
                if ($.inArray(itemCode, itemCodes) !== -1) {
                    toastr.warning("Duplicate record found for item: " + description + ". Kindly Remove Duplicate items.", "Validation");
                    row.find(".itemddl").focus();
                    duplicateFound = true;
                    return false;
                }
                itemCodes.push(itemCode);
                // QUANTITY
                if (!qty || parseFloat(qty) <= 0) {
                    toastr.warning("Request Qty of " + description + " must not be 0.", "Validation");
                    row.find(".qty").focus();
                    duplicateFound = true;
                    return false;
                }
                // PLACE OF USE
                if ($.trim(placeUse) === "") {
                    toastr.warning("Place of use of " + description + " is required/Compulsory.", "Validation");
                    row.find(".placeuse").focus();
                    duplicateFound = true;
                    return false;
                }
            }
        });
        // Stop if detail validation failed
        if (duplicateFound) {
            return false;
        }
        // AT LEAST ONE ITEM
        if (validItemCount === 0) {
            toastr.warning("Item Details Should not be Blank, Kindly Check in Grid.","Validation");
            return false;
        }
        return true;
    }

    function ddlDocNo() {
        $.ajax({
            url: '/PrintingRequestionEntry/GetDocNo',
            type: 'GET',
            success: function (data) {
                if (data.success) {
                    $("#NumDocNo").val(data.nextVNo);
                }
                else {
                    alert(data.message);
                }
            },
            error: function (xhr) {
                console.log(xhr.responseText);
            }
        });
    }
    function loadCurrentDate() {
        const currentDate = new Date().toISOString().split('T')[0];
        $('#DtDocDate').val(currentDate);
        $('#DtRequiredDate').val(currentDate);
    }
    function bindPlace() {
        $.get('/PrintingRequestionEntry/GetPlace', function (data) {
            $("#ddlPlace").empty();
            $("#ddlPlace").append('<option value="">Select Place</option>');
            $.each(data, function (i, item) {
                $("#ddlPlace").append(
                    '<option value="' + item.value + '">' + item.text + '</option>'
                );
            });
        });
    }
    function bindStatus() {
        $.get('/PrintingRequestionEntry/GetStatus', function (data) {
            $("#ddlStatus").empty();
            $("#ddlStatus").append('<option value="">Select Status</option>');
            $.each(data, function (i, item) {
                $("#ddlStatus").append(
                    '<option value="' + item.value + '">' + item.text + '</option>'
                );
            });
        });
    }
    function loadCurrentDate() {
         var today = new Date();
         var yyyy = today.getFullYear();
         var mm = String(today.getMonth() + 1).padStart(2, '0');
         var dd = String(today.getDate()).padStart(2, '0');
         var currentDate = yyyy + "-" + mm + "-" + dd;
         $("#DtDocDate").val(currentDate);
         $("#DtRequiredDate").val(currentDate);
    }
    function bindDepartment() {
        $.get('/PrintingRequestionEntry/GetDepartment', function (data) {
            $("#ddlDepartment").empty();
            $("#ddlDepartment").append('<option value="">Select Department</option>');
            $.each(data, function (i, item) {
                $("#ddlDepartment").append(
                    '<option value="' + item.value + '">' + item.text + '</option>'
                );
            });
        });
    }
    function bindRequestBy() {
        $.get('/PrintingRequestionEntry/GetRequestBy', function (data) {
            $("#ddlrequestby").empty();
            $("#ddlrequestby").append('<option value="">Select Request By</option>');
            $.each(data, function (i, item) {
                $("#ddlrequestby").append(
                    '<option value="' + item.value + '">' + item.text + '</option>'
                );
            });
        });
    }
    function addNewRow() {
        let rowIndex = $("#tblPrintingRequestionEntry tbody tr").length;
        // Item Dropdown
        let options = '<option value="">Select Item</option>';
        $.each(itemList, function (i, item) {
            options += `<option value="${item.value}">${item.text}</option>`;
        });
        // Priority Dropdown
        let priorityOptions = '<option value="">Select Priority</option>';
        $.each(priorityList, function (i, item) {
            priorityOptions += `<option value="${item.value}">${item.text}</option>`;

        });
        // WorkType Dropdown
        let workTypeOptions = '<option value="">Select Work Type</option>';
        $.each(workTypeList, function (i, item) {
            workTypeOptions += `<option value="${item.value}">${item.text}</option>`;
        });
        let row = `
        <tr>
            <td class="hidden-col">
                <input type="hidden" id="ItemCode_${rowIndex}" />
            </td>
            <td>
                <select id="ddlItem_${rowIndex}" class="erppage-input erppage-select itemddl">
                    ${options}
                </select>
            </td>
            <td>
                <input type="text" id="txtDescription_${rowIndex}" class="erppage-input description"/>
            </td>
            <td>
                <select id="ddlMake_${rowIndex}" class="erppage-input erppage-select makeddl">
                    <option value="">Select Make</option>
                </select>
            </td>
            <td>
                <input type="text" id="txtMatType_${rowIndex}" class="erppage-input mattype"/>
            </td>
            <td>
                 <input type="number" id="txtUnit_${rowIndex}" class="erppage-input unit"/>
            </td>
            <td>
                <input type="number" id="txtQty_${rowIndex}" class="erppage-input qty"/>
            </td>
            <td>
                <input type="text" id="txtPrintingType_${rowIndex}" class="erppage-input printingtype"/>
            </td>
            <td>
                <input type="text" id="txtFinish_${rowIndex}" class="erppage-input finish"/>
            </td>
            <td>
                <input type="text" id="txtPlaceUse_${rowIndex}" class="erppage-input placeuse"/>
            </td>
            <td>
                <input type="text" id="txtReason_${rowIndex}" class="erppage-input reason"/>
            </td>
            <td>
