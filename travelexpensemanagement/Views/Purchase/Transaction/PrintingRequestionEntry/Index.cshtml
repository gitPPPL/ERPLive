    async function fillDetailData(details) {
        $("#tblPrintingRequestionEntry tbody").empty();
        if (!details || details.length === 0) {
            addNewRow();
            return;
        }
        for (let i = 0; i < details.length; i++) {
            const detail = details[i];
            addNewRow();
            const row = $(
                "#tblPrintingRequestionEntry tbody tr"
            ).last();
            // Item
            row.find(".itemddl").val(detail.ITEM_CODE ?? "");
            // Description
            row.find(".description").val(detail.TECH_DESC ?? "");
            // Material Type
            row.find(".mattype").val(detail.MAT_TYPE ?? "");
            // Unit
            row.find(".unit").val(detail.UOM_CODE ?? "");
            // Quantity
            row.find(".qty").val(detail.REQ_QTY ?? "");
            // Printing Type
            row.find(".printingtype").val(detail.PRINT_TYPE ?? "");
            // Finish
            row.find(".finish").val(detail.FINISH ?? "");
            // Place Use
            row.find(".placeuse").val(detail.PLACE_USE ?? "");
            // Reason
            row.find(".reason").val(detail.REQ_REASON ?? "");
            // Priority
            row.find(".priority").val(detail.PRIORITY_TYPE ?? "");
            // Work Type
            row.find(".worktype").val(detail.WORK_TYPE ?? "");
            // Scrap Type
            row.find(".scraptype").val(detail.SCRAP_TYPE ?? "");
            // Remarks
            row.find(".remarks").val(detail.REMARKS ?? "");
            // Make Dropdown
            await loadMakeForRow(row, detail.ITEM_CODE, detail.MAKE_CODE);
        }
    }
    function loadMakeForRow(row, itemCode, selectedMakeCode) {
        return $.ajax({
            url: "/PrintingRequestionEntry/GetMake",
            type: "GET",
            data: {itemCode: itemCode}
        }).then(function (data) {
            const makeDDL = row.find(".makeddl");
            makeDDL.empty();
            makeDDL.append('<option value="">Select Make</option>');
            $.each(data, function (i, item) {
                makeDDL.append(
                    $('<option>', {
                        value: item.value,
                        text: item.text
                    })
                );
            });
            // Select existing Make
            makeDDL.val(selectedMakeCode ?? "");
        });
    }
   function PrintingRequestionEntryReport() {
        const code = getQueryParam('vNo');
        const vType = getQueryParam('vType');
        if (!vType) {
            toastr.error("VType is required.");
            return;
        }
        if (!code) 
        {
            toastr.error("VNo is required.");
            return;
        }
        const model = {VType: vType, VNo: code };
        console.log("Sending:", model);
        $.ajax({
            url: '@Url.Action("PrintingRequestionEntryReport", "PrintingRequestionEntry")',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(model),
            success: function (response) {
                console.log("Controller Response:", response);
                if (!response.success) {
                    toastr.error(response.message);
                    return;
                }
                const requestData = response.report;
                console.log("Report Data:", requestData);
                $.ajax({
                    url: "http://localhost:34087/Report/PendingQCReport",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify(requestData),
                    xhrFields: {
                        responseType: "blob"
                    },
                    success: function (pdf) {
                        const file = new Blob([pdf], {
                            type: "application/pdf"
                        });
                        const url = window.URL.createObjectURL(file);
                        window.open(url, "_blank");
                    },
                    error: function (xhr) {
                        console.log("Report API Error:", xhr);
                        toastr.error("Unable to generate report.");
                    }
                });
            },
            error: function (xhr) {
                    console.log("Controller Error:", xhr);
                    toastr.error(xhr.responseJSON?.message || "Error occurred while generating report."
                );
            }
        });
    }

