    function allowOnlyNumbers(input) {
      input.value = input.value
        .replace(/[^0-9.]/g, '')
        .replace(/(\..*)\./g, '$1');
    }

    function setFieldsEnabled(enabled) {
      AllFieldsId.forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          el.disabled = !enabled;
        }
      });
    }

    function setEnterKeyFocus(sequence) {
               sequence.forEach((id, index) => {
                   $(`#${id}`).on('keypress', function (e) {
                       if (e.key === 'Enter') {
                           e.preventDefault();
                           if (index + 1 < sequence.length) {
                               $(`#${sequence[index + 1]}`).focus();
                           }
                       }
                   });
               });
     }

    function setEnterKeyFocusOnTable(sequence, rowCount) {
        sequence.forEach((id, index) => {
            let elementId = `#${id}${rowCount}`;
            $(document).on('keydown', elementId, function (e) {
                if (e.key === 'Enter' || e.key === 'Tab' || e.keyCode === 13 || e.keyCode === 9) {
                    e.preventDefault();

                    let nextIndex = index + 1;
                    if (nextIndex < sequence.length) {
                        let nextElementId = `#${sequence[nextIndex]}${rowCount}`;
                        if ($(nextElementId).length) {
                            $(nextElementId).focus();
                        }
                    } else {

                        addItemRecordRow();
                        setEnterKeyFocus(sequence, rowCount + 1);
                        $(`#${sequence[0]}${rowCount + 1}`).focus();
                    }
                }
            });
        });
    }

    async function GetDocData(MasterTblId, readOnly) {
        try {
            const response = await $.ajax({
                url: '/ImportExportExpensesEntry/GetImpExpExpenseRecordsById',
                type: 'GET',
                data: { id: MasterTblId }
            });

            if (response.status) {
                if (readOnly === 'true') {
                        document.querySelectorAll("#tblPurchaseReceiptIR input, #tblPurchaseReceiptIR select, #tblPurchaseReceiptIR textarea, #tblPurchaseReceiptIR button")
                       .forEach(el => el.disabled = true);
                    $('.btn-add-row-last').hide();
                    $('#btn-save, #cancelBtn').hide();
                    disableAllFields();
                } else {
                    document.querySelectorAll("#tblPurchaseReceiptIR input, #tblPurchaseReceiptIR select, #tblPurchaseReceiptIR textarea, #tblPurchaseReceiptIR button")
                    .forEach(el => el.disabled = false);
                    $('.btn-add-row-last').show();
                    $('#btn-save, #cancelBtn').show();
                    enableAllFields();
                }

                await fillFormFields(response.header);
                await fillItemDetailsTable(response.detail);
                $('#tblAttachmentPRE tbody').empty();
                if (response.attachment) {
                    if (Array.isArray(response.attachment)) {
                        response.attachment.forEach(att => addAttachmentRow(att));
                    } else if (typeof response.attachment === 'object') {
                        addAttachmentRow(response.attachment);
                    } else {
                        addAttachmentRow();
                    }
                } else {
                    addAttachmentRow();
                }
                 
            } else {
                toastr.error('No data returned.');
            }
        } catch (error) {
            toastr.error('Failed to load data.');
            console.error(error);
        }
    }

