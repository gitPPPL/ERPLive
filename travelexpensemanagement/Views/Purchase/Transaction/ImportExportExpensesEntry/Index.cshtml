@{
    ViewBag.Title = "Import Export Expenses Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>


</style>
<fieldset>

    <legend class="legend-field">Import Export Expenses Entry</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="window.location.href='@Url.Action("Index", "ImportExportExpensesEntryList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>

    <form id="PurchaseReceiptEntryForm">

        <input type="hidden" class="form-control" id="TxtDocId">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlDocType">Doc Type<span class="required">*</span></label>
                    <select class="form-control" id="ddlDocType">
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumDocNo">Doc No<span class="required">*</span></label>
                    <input type="text" class="form-control" id="NumDocNo" placeholder="Enter Doc No" readonly>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DtDocDate">Doc Date<span class="required">*</span></label>
                    <input type="date" class="form-control" id="DtDocDate" name="DocDate">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtRefNo">Ref No<span class="required">*</span></label>
                    <div class="input-divide">
                        <input type="text" class="form-control" id="txtRefNo" readonly>
                        <select class="form-control" id="ddlRefNo">
                            <option value="">--Select Reference Id--</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <!-- Bill From Section -->
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Bill Details</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ddlBillFrom">Bill From<span class="required">*</span></label>
                                <select class="form-control" id="ddlBillFrom">
                                    <option value="">--Select Bill From--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtAddLine1">Add Line1</label>
                                <div class="input-divide">
                                    <input type="text" class="form-control" id="txtAddLine1" placeholder="Enter Address Line 1" readonly>
                                    <div class="select-wrapper">
                                        <select id="ddladdressBD1">
                                            <option value="">Select address</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtAddLine2">Address Line 2</label>
                                <input type="text" class="form-control" id="txtAddLine2" placeholder="Enter Address" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtAddLine3">Address Line 3</label>
                                <input type="text" class="form-control" id="txtAddLine3" placeholder="Enter Address" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlCity">City</label>
                                @* <input type="text" id="TxtCity" class="form-control" /> *@
                                <select class="form-control" id="ddlCity" disabled>
                                    <option value="">--Select City--</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlState">State</label>
                                @* <input type="text" id="TxtState" class="form-control" /> *@
                                <select class="form-control" id="ddlState" disabled>
                                    <option value="">--Select State--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="txtGST">GST</label>
                                <input type="text" class="form-control" id="txtGST" placeholder="Enter GST" readonly>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="txtPincode">Pincode</label>
                                <input type="text" class="form-control" id="txtPincode" placeholder="Enter Pincode" readonly>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <!-- Ship From Section -->
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Ship Details</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ddlShipFrom">Ship from<span class="required">*</span></label>
                                <div class="input-divide">
                                    <select class="form-control" id="ddlShipFrom">
                                        <option value="">Select Ship from</option>
                                    </select>
                                    <div class="select-wrapper">
                                        <select class="form-control" id="ddlShipFrom2">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtShipAddLine1">Add Line1</label>
                                <input type="text" class="form-control" id="txtShipAddLine1" placeholder="Enter Address" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtShipAddLine2">Address Line 2</label>
                                <input type="text" class="form-control" id="txtShipAddLine2" placeholder="Enter Address" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtShipAddLine3">Address Line 3</label>
                                <input type="text" class="form-control" id="txtShipAddLine3" placeholder="Enter Address" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlShipCity">City</label>
                                @* <input type="text" id="TxtShipCity" class="form-control" /> *@
                                <select class="form-control" id="ddlShipCity" disabled>
                                    <option value="">--Select City--</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlShipState">State</label>
                                @* <input type="text" id="TxtShipState" /> *@
                                <select class="form-control" id="ddlShipState" disabled>
                                    <option value="">--Select State--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="txtShipGST">GST</label>
                                <input type="text" class="form-control" id="txtShipGST" placeholder="Enter GST">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="NumShipPincode">Pincode</label>
                                <input type="number" class="form-control" id="NumShipPincode" data-maxlength="6" placeholder="Enter Pincode">
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Document Details</legend>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="txtBillNo">Bill No<span class="required">*</span></label>
                                <input type="text" class="form-control" id="txtBillNo" maxlength="15" placeholder="Enter Bill No">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtBillDate">Bill Date<span class="required">*</span></label>
                                <input type="date" class="form-control" id="DtBillDate" name="BillDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="NumBOENo">BOE No</label>
                                <input type="number" class="form-control" id="NumBOENo" maxlength="15" placeholder="Enter BOE No">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtBOEDate">BOE Date</label>
                                <input type="date" class="form-control" id="DtBOEDate" name="BOEDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtWaybillNo">Waybill No</label>
                                <input type="text" class="form-control" id="TxtWaybillNo" maxlength="15" placeholder="Enter Waybill No">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlTransitNo">Transit No</label>
                                <select class="form-control" id="ddlTransitNo">
                                    <option value="">-Select Transit No-</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlInputType">Input Type</label>
                                <select class="form-control" id="ddlInputType">
                                    <option value="">--Select Input Type--</option>
                                    <option>GST Input</option>
                                    <option>GST NA</option>
                                    <option>Import</option>
                                    <option>Input NA </option>
                                    <option>RCM</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlExpensesType">Expenses Type</label>
                                <select class="form-control" id="ddlExpensesType">
                                    <option value="">--Select Expenses Type--</option>
                                    <option>Custom Duty</option>
                                    <option>Shipping Line</option>
                                    <option>Container</option>
                                    <option>Clearing Agent</option>
                                    <option>Freight</option>
                                    <option>Detention</option>
                                    <option>Clearing Exps</option>
                                    <option>Lab Test</option>
                                </select>
                            </div>
                        </div>
                    </div>

                </fieldset>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="ddlDebitAC">Debit A/c <span class="required">*</span></label>
                    <select class="form-control" id="ddlDebitAC">
                        <option value="">Select Debit A/C</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="ddlCreditAC">Credit A/c <span class="required">*</span></label>
                    <select class="form-control" id="ddlCreditAC">
                        <option value="">Select Credit Account</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="txtRemarks">Remarks</label>
                    <textarea type="text" class="form-control" id="txtRemarks" maxlength="500" placeholder="Enter Remarks"></textarea>
                </div>
            </div>
        </div>
        <div class="row">
            <!-- Net Amount -->
            <div class="col-md-2">
                <div class="form-group">
                    <label for="TxtNetAmount">Net Amount</label>
                    <input type="text" class="form-control" id="TxtNetAmount" placeholder="Enter Amount" readonly>
                </div>
            </div>
            <!-- Status Dropdown -->
            <div class="col-md-2">
                <div class="form-group">
                    <label for="ddlStatus">Status</label>
                    <select class="form-control" id="ddlStatus" readonly>
                        <option>Open</option>
                        <option>Closed</option>
                        <option>Pending</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="ddlEmployee">Employee</label>
                    <select class="form-control" id="ddlEmployee">
                        <option value="">Select Employee</option>
                    </select>
                </div>
            </div>
            <!-- Buttons -->
            <div class="col-md-12">
                <div class="button-right">
                    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#costallocationModal">
                        <i class="fa fa-project-diagram"></i> Cost Allocation
                    </button>
                    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#pendingapprovalModal">
                        <i class="fa fa-tasks"></i> List of Pending Approval
                    </button>
                </div>
            </div>
        </div>
        <!--Cost Allocation Modal-->
        <div class="modal fade" id="costallocationModal" tabindex="-1" aria-labelledby="costallocationLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content draggable-modal">
                    <div class="popup-header">
                        <h5 class="popup-title" id="costallocationLabel">Cost Allocation</h5>
                        <i class="fa fa-times" data-bs-dismiss="modal" style="cursor: pointer;" aria-label="Close"></i>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label for="PartyName">Party Name</label>
                                    <input type="text" class="form-control" id="TxtPartyNameCA" placeholder="Enter Party Name">
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="btn-rightalign">
                                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><i class="fa fa-edit"></i>Edit</button>
                                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><i class="fa fa-copy"></i>Copy</button>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="RefVno">Ref. Vno</label>
                                    <input type="number" class="form-control" id="NumRefVno" placeholder="Enter Ref. VNo">
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="form-group">
                                    <label for="TotalAmtAllocated">Total Amt. to be allocated</label>
                                    <input type="text" class="form-control" id="TxtTotalAmtAllocated" placeholder="Enter Total Amt. to be allocated">
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="SrNo">Sr. No</label>
                                    <input type="number" class="form-control" id="NumSrNo" placeholder="Enter Sr. No">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="SrDate">Sr. Date</label>
                                    <input type="date" class="form-control" id="DtSrDate">
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="BalAmount">Bal. Amount</label>
                                    <input type="number" class="form-control" id="NumBalAmount" placeholder="Enter Bal Amount">
                                </div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="table-responsive">
                                <table id="tblpurchaseallocationmodal" class="table-width">
                                    <thead class="table-head">
                                        <tr>
                                            <th style="display:none;"><input type="checkbox" id="selectAllPR" /></th>
                                            <th>Cost Center</th>
                                            <th>Allocated Amt</th>
                                            <th>Narration</th>
                                            <th style="display:none;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="btn-add-row-last">
                                        <i class="fa fa-plus btn-add-row" title="Add Row"><span>Add New Row</span></i>
                                    </div>
                                    <div class="pagination-end">
                                        <div class="custom-pagination" id="tablePagination"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="row">
            <div class="col-md-12">
                <fieldset class="fieldset-sub">
                    <legend class="sub-legend">Item Total</legend>
                    <div class="row">
                        <div class="col-md-10">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumReceivedQty">Received Qty</label>
                                        <input type="number" class="form-control" id="NumReceivedQty" readonly placeholder="Enter Received Qty">
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumBillQty">Bill Qty</label>
                                        <input type="number" class="form-control" id="NumBillQty" readonly placeholder="Enter Bill Qty">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumAmount">Amount</label>
                                        <input type="number" class="form-control" id="NumAmount" readonly placeholder="Enter Amount">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumPacking">Packing</label>
                                        <input type="number" class="form-control" id="NumPacking" readonly placeholder="Enter Packing Amt">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumDiscount">Discount</label>
                                        <input type="number" class="form-control" id="NumDiscount" readonly placeholder="Enter Discount Amt">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumCGST">CGST</label>
                                        <input type="number" class="form-control" id="NumCGST" readonly placeholder="Enter CGST">
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumSGST">SGST</label>
                                        <input type="number" class="form-control" id="NumSGST" readonly placeholder="Enter SGST">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumIGST">IGST</label>
                                        <input type="number" class="form-control" id="NumIGST" readonly placeholder="Enter IGST">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumCESS">CESS</label>
                                        <input type="number" class="form-control" id="NumCESS" readonly placeholder="Enter CESS">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumVAT">VAT</label>
                                        <input type="number" class="form-control" id="NumVAT" readonly placeholder="Enter VAT">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumOtherAmt">Other Amt</label>
                                        <input type="number" class="form-control" id="NumOtherAmt" readonly placeholder="Enter Other Amount">
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumTCSPer">TCS %</label>
                                        <div class="input-divide">
                                            <input type="text" oninput="allowOnlyNumbers(this);" class="form-control" id="NumTCSPer1" maxlength="5" placeholder="Enter TCS %">
                                            <input type="text" oninput="allowOnlyNumbers(this);" class="form-control" maxlength="10" id="NumTCSAmt">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumSubTotal">Sub Total</label>
                                        <input type="number" class="form-control" id="NumSubTotal" readonly placeholder="Enter Sub Total">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumRoundOff">Round Off</label>
                                        <input type="number" class="form-control" id="NumRoundOff" readonly placeholder="Enter Round Off">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumFinalNetAmt">Net Amount</label>
                                        <input type="number" class="form-control" id="NumFinalNetAmt" readonly placeholder="Enter Net Amount">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <!-- TDS A/c -->
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="ddlTdsAccount">TDS A/c</label>
                                        <select class="form-control" id="ddlTdsAccount">
                                            <option value="">Select TDS A/C</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="TxtTds">TDS</label>
                                        <div class="input-divide">
                                            <input type="text" class="form-control" oninput="allowOnlyNumbers(this);" maxlength="10" id="TxtTds1">
                                            <input type="text" class="form-control" oninput="allowOnlyNumbers(this);" maxlength="10" id="TxtTds2">
                                        </div>
                                    </div>
                                </div>
                                <!-- TDS 194Q -->
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="TxtTds194q">TDS 194Q</label>
                                        <div class="input-divide">
                                            <input type="text" oninput="allowOnlyNumbers(this);" class="form-control" maxlength="10" id="TxtTds194q1">
                                            <input type="text" oninput="allowOnlyNumbers(this);" class="form-control" maxlength="10" id="TxtTds194q2">
                                        </div>
                                    </div>
                                </div>
                                <!-- Party Bill Amt in USD -->
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="TxtPartyUsd">Party Bill Amt in USD</label>
                                        <input type="text" class="form-control" id="TxtPartyUsd" oninput="allowOnlyNumbers(this);" maxlength="20" placeholder="Enter USD Amount">
                                    </div>
                                </div>
                            </div>
                            <!-- PL No & Date -->
                            <div class="row">

                                <!--Modal TDS Calculation-->
                                <div class="modal fade" id="tdscalculationModal" tabindex="-1" aria-labelledby="tdscalculationLabel">
                                    <div class="modal-dialog modal-lg">
                                        <div class="modal-content draggable-modal">
                                            <div class="popup-header">
                                                <h5 class="popup-title" id="tdscalculationLabel">TDS 194Q Cal As.</h5>
                                                <i class="fa fa-times" data-bs-dismiss="modal" style="cursor: pointer;" aria-label="Close"></i>
                                            </div>
                                            <div class="modal-body">
                                                <div class="row">
                                                    <div class="col-lg-3">
                                                        <div class="form-group">
                                                            <label for="NumNetAmt">Net Amt :</label>
                                                            <input type="text" oninput="allowOnlyNumbers(this);" maxlength="12" class="form-control" id="NumNetAmt" placeholder="Enter Net Amount">
