    function bindDropdownData(rowCount) {
        const itemSelect = $(`#ddlItemName${rowCount}`);
        const taxSelect = $(`#ddlTaxType${rowCount}`);
        const makeSelect = $(`#ddlMake${rowCount}`);
        const departmentSelect = $(`#ddlDepartment${rowCount}`);
        const loadDropdown = (url, selectElem, defaultText, formatter) => {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: url,
                    type: 'GET',
                    dataType: 'json',
                    success: function (response) {
                        if (response.status) {
                            selectElem.empty().append(`<option value="">${defaultText}</option>`);
                            $.each(response.data, function (i, item) {
                                selectElem.append(formatter(item));
                            });

                            selectElem.select2({
                                placeholder: defaultText,
                                allowClear: true,
                                minimumResultsForSearch: 0
                            });

                            resolve();
                        } else {
                            toastr.error(`${defaultText} Load failed`);
                            resolve();
                        }
                    },
                    error: reject
                });
            });
        };

        return Promise.all([
            loadDropdown('@Url.Action("GetMakeList", "ImportExportExpensesEntry")', makeSelect, "- Select Make -", item => `<option value="${item.CODE}">${item.NAME}</option>`),
            loadDropdown('@Url.Action("GetDepartmentList", "ImportExportExpensesEntry")', departmentSelect, "- Select Department -", item => `<option value="${item.CODE}">${item.NAME}</option>`),
            loadDropdown('@Url.Action("GetItemList", "ImportExportExpensesEntry")',
            itemSelect,
            "- Select Item -",
            item => `<option
            data-hsnCode="${item.HSN_CODE}"
            data-unitCd="${item.UNIT_CODE}"
            data-unitname="${item.UNIT_NAME}"
            value="${item.CODE}">${item.NAME}
            </option>`),

            loadDropdown(
                '@Url.Action("GetTaxList", "ImportExportExpensesEntry")',
                taxSelect,
                "- Select Tax -",
                item => `
                    <option
                        value="${item.CODE}"
                        data-CSgstPer="${item.CSGST_PER}"
                        data-IgstPer="${item.IGST_PER}"
                        data-TdsPer="${item.TDS_PER}"
                        data-TcsPer="${item.TCS_PER}"
                        data-VatPer="${item.VAT_PER}"
                        data-OtherPer1="${item.OTH_PER}"
                        data-OtherPer2="${item.OTH_PER2}">
                        ${item.NAME}
                    </option>`
            )
        ]);
    }

    function addAttachmentRow(data = {}) {
        const $attachmentTbody = $('#tblAttachmentPRE tbody');

        // Don't empty here if you're adding multiple rows
        if ($attachmentTbody.find('tr').length === 0) {
            $attachmentTbody.empty();
        }
            const row = $(`
         <tr class="no-border-input">
        <td>
            <input type="file" class="form-control file-input" />
            <input type="hidden" class="existing-file-path" value="${data.FILE_Path || ''}" />
            <input type="hidden" class="existing-file-name" value="${data.FILE_NAME || ''}" />
        </td>
        <td>
            <div class="file-preview mt-2"></div>
        </td>
        <td>
            <input type="text" class="form-control file-name-input" placeholder="Enter file name" value="${data.FILE_NAME || ''}" />
        </td>
        <td>
           <i class="fa fa-trash btn-delete-action text-danger" title="Delete Row" style="cursor:pointer;"></i>
        </td>
       </tr>
       `);


        $attachmentTbody.append(row);

        const previewDiv = row.find('.file-preview');

    if (data.FILE_Path) {
        const fileExt = data.FILE_Path.split('.').pop().toLowerCase();
        const fileName = data.FILE_NAME || 'View File';

        // Build preview + download
        let previewHtml = '';
        if (['jpg', 'jpeg', 'png', 'gif'].includes(fileExt)) {
            previewHtml = `<img src="${data.FILE_Path}" alt="Preview" style="max-width: 30px; max-height: 30px;" />`;
        } else if (fileExt === 'pdf') {
            previewHtml = `<iframe src="${data.FILE_Path}" style="width: 30px; height: 30px;"></iframe>`;
        } else {
            previewHtml = `<span>${fileName}</span>`;
        }

        // Add a download or view link
        previewHtml += `<br><a href="${data.FILE_Path}" target="_blank" style="font-size: 10px;">Download</a>`;

        previewDiv.html(previewHtml);
    }

        // Handle file input preview on change
        row.find('.file-input').on('change', function () {
            const file = this.files[0];
            previewDiv.empty();
            const fileNameInput = row.find('.file-name-input');

            if (file) {
                const fileURL = URL.createObjectURL(file);
                fileNameInput.val(file.name);

                if (file.type.startsWith('image/')) {
                    previewDiv.append(
                        $('<img>', {
                            src: fileURL,
                            css: {
                                width: '30px',
                                height: '30px',
                                objectFit: 'cover',
                                border: '1px solid #ccc',
                            }
                        })
                    );
                } else if (file.type === 'application/pdf') {
                    previewDiv.append(
                        $('<iframe>', {
                            src: fileURL,
                            css: {
                                width: '30px',
                                height: '30px',
                                border: '1px solid #ccc',
                            }
                        })
                    );
                } else {
                    previewDiv.text('Preview not available');
                }
            }
        });
    }

    function formatDate(dateStr) {
      if (!dateStr) return '';
      const d = new Date(dateStr);
      return d.toISOString().split('T')[0];
    }

    function parseIntSafe(value) {
        const parsed = parseInt(value, 10);
        return isNaN(parsed) ? null : parsed;
    }

    function parseFloatSafe(value) {
        const parsed = parseFloat(value);
        return isNaN(parsed) ? null : parsed;
    }

     function parseDate(dateStr) {
        if (!dateStr) return null;
        const parts = dateStr.split(/[-\/]/);
        if (parts.length === 3) {
            let [day, month, year] = parts.map(p => parseInt(p, 10));
            if (year < 1000) year += 2000;
            return new Date(year, month - 1, day);
        }
        return null;
     }

    function toNullableInt(val) {
        const parsed = parseInt(val);
        return isNaN(parsed) ? null : parsed;
    }

    function toNullableDate(val) {
        const date = new Date(val);
        return isNaN(date.getTime()) ? null : val;
    }

    function toNullableString(val) {
      return val?.trim() || null;
    }

