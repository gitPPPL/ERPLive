    async function fillItemDetailsTable(data) {
        const $tbody = $('#tblPurchaseReceiptIR tbody');
        $tbody.empty();

        for (let i = 0; i < data.length; i++) {
            addItemRecordRow();
        }

        await Promise.all(
            data.map((_, index) => bindDropdownData(index + 1))
        );

        for (let index = 0; index < data.length; index++) {
            const item = data[index];
            const idx = index + 1;

            const safeSetDropdown = (selector, value) => {
                const $el = $(selector);
                if ($el.find(`option[value="${value}"]`).length > 0) {
                    $el.val(value).trigger('change');
                } else {
                    console.warn(`Value "${value}" not found in ${selector}`);
                }
            };

