    async function getAttachmentDetails() {
        const attachments = [];

        const rows = $('#tblAttachmentPRE tbody tr').toArray();
        for (const row of rows) {
            const $row = $(row);
            const fileInput = $row.find('.file-input')[0];
            const file = fileInput?.files[0];
            const fileNameInput = $row.find('.file-name-input').val()?.trim() || null;

            let base64String = null;
            let filePath = null;
            let fileName = null;
            let fileType = null;
            let fileSize = null;

            if (file) {
                base64String = await toBase64(file);
                fileName = file.name;
                fileSize = file.size;
                fileType = file.type;
                filePath = `/uploads/${file.name}`;
            } else {
                fileName = $row.find('.existing-file-name').val()?.trim() || null;
                fileSize = $row.find('.existing-file-size').val()?.trim() || null;
                fileType = $row.find('.existing-file-type').val()?.trim() || null;
                filePath = $row.find('.existing-file-path').val()?.trim() || null;
            }

            if (fileName || filePath) {
                attachments.push({
                    fileName: fileNameInput || fileName,
                    fileSize: fileSize,
                    fileType: fileType,
                    filePath: filePath,
                    fileContentBase64: base64String
                });
            }
        }

        return attachments;
    }

    function toBase64(file) {
         return new Promise((resolve, reject) => {
             const reader = new FileReader();
             reader.onload = () => resolve(reader.result.split(',')[1]);
             reader.onerror = reject;
             reader.readAsDataURL(file);
         });
    }

