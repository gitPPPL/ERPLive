                                    <td><input type="number" class="erppagetabledynamic-table" name="LDRate" /></td>
                                    <td><input type="number" class="erppagetabledynamic-table" name="LDAmt" /></td>
                                    <td>
                                        <select class="erppagetabledynamic-table bin-dropdown" name="BinLocation">
                                            <option value="">Select Bin Location</option>
                                        </select>
                                    </td>
                                    <td><input type="text" class="erppagetabledynamic-table" name="POType" /></td>
                                    <td><input type="text" class="erppagetabledynamic-table" name="PONo" /></td>
                                    <td><input type="text" class="erppagetabledynamic-table" name="KantaType" /></td>
