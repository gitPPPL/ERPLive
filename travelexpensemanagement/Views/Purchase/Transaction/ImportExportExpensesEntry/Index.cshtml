@{
    ViewBag.Title = "Purchase Receipt Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var globalVar = ViewBag.GlobalVariables as Models.UserSessionData;
}
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-file-invoice-dollar"></i>
        </div>
        <div class="erppage-header-title">Purchase Receipt Entry</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-btn erppage-btn-common" onclick="PendingReport()">
            <i class="fa-solid fa-print"></i>
            <span>Print</span>
        </button>
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "ImportExportExpensesEntryList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="PurchaseReceiptEntryForm">
    <input type="hidden" class="form-control" id="TxtCode" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Type</label>
                    <select class="erppage-input erppage-required" id="ddlDocType">
                        <option value="">Select Doc Type</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc No</label>
                    <input type="text" class="erppage-redinput" id="NumDocNo" placeholder="Enter Doc No">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-redinput" id="DtDocDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Gate No</label>
                    <select class="erppage-input erppage-required" id="ddlGateNo">
                        <option value="0">Select Gate No</option>
                    </select>
                </div>
            </div>
            <div class="erppagesrow">
                <div class="erppagescol-6">
                    <fieldset class="erppagefieldset">
                        <legend class="erppagefieldset-legend">Bill Details</legend>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Bill From</label>
                                <select class="erppage-input erppage-required" id="ddlBillFrom">
                                    <option value="">Select Bill From</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Addr. Line1</label>
                                <div class="erppage-inputgroup">
                                    <input type="text" class="erppage-input erppage-width-93" id="txtAddLine1" placeholder="Enter Address 1">
                                    <select class="erppage-input erppage-required erppage-width-7" id="ddladdressBD1">
                                        <option value="">Select Address</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Addr. Line 2</label>
                                <input type="text" class="erppage-input" id="txtAddLine2" placeholder="Enter Address 2">
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Addr. Line 3</label>
                                <input type="text" class="erppage-input" id="txtAddLine3" placeholder="Enter Address 3">
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">City</label>
                                <select class="erppage-input erppage-select" id="ddlCity">
                                    <option value="">Select City</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Pincode</label>
                                <input type="text" class="erppage-input" id="txtPincode" data-maxlength="6" placeholder="Enter Pincode">
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">State</label>
                                <select class="erppage-input erppage-select" id="ddlState">
                                    <option value="">Select State</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">GST</label>
                                <input type="text" class="erppage-input" id="txtGST" placeholder="Enter GST">
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="erppagescol-6">
                    <fieldset class="erppagefieldset">
                        <legend class="erppagefieldset-legend">Ship Details</legend>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Ship From</label>
                                <select class="erppage-input erppage-required" id="ddlShipFrom">
                                    <option value="">-Select Ship From-</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Add Line1</label>
                                <div class="erppage-inputgroup">
                                    <input type="text" class="erppage-input erppage-width-93" id="txtShipAddLine1" placeholder="Enter Address">
                                    <select class="erppage-input erppage-select erppage-width-7" id="ddladdressSD1">
                                        <option value="">Select Addr.</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Address 2</label>
                                <input type="text" class="erppage-input" id="txtShipAddLine2" placeholder="Enter Address 2">
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Address 3</label>
                                <input type="text" class="erppage-input" id="txtShipAddLine3" placeholder="Enter Address 3">
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">City</label>
                                <select class="erppage-input erppage-select" id="ddlShipCity">
                                    <option value="">Select City</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Pincode</label>
                                <input type="text" class="erppage-input" id="NumShipPincode" data-maxlength="6" placeholder="Enter Pincode">
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">State</label>
                                <select class="erppage-input erppage-select" id="ddlShipState">
                                    <option value="">Select State</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">GST</label>
                                <input type="text" class="erppage-input" id="txtShipGST" placeholder="Enter GST">
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>

            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Document Details</legend>
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Bill No</label>
                        <input type="text" class="erppage-redinput" id="txtBillNo" placeholder="Enter Bill No">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Bill Date</label>
                        <input type="date" class="erppage-redinput" id="DtBillDate" name="BillDate">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Challan No</label>
                        <input type="number" class="erppage-input" id="NumChallanNo" placeholder="Enter Challan No">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Challan Date</label>
                        <input type="date" class="erppage-redinput" id="DtChallanDate" name="ChallanDate">
                    </div>
                </div>
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Waybill No</label>
                        <input type="text" class="erppage-input" id="TxtWaybillNo" placeholder="Enter Waybill No">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Waybill Date</label>
                        <input type="date" class="erppage-input" id="DtWaybillDate" name="WaybillDate">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Waybill Inv No</label>
                        <input type="text" class="erppage-input" id="TxtWaybillInvNo" placeholder="Enter Waybill Inv No">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="DtWaybillExpiry">Waybill Expiry</label>
                        <input type="date" class="erppage-input" id="DtWaybillExpiry" name="WaybillExpiry">
                    </div>
                </div>
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Return Type</label>
                        <select class="erppage-input erppage-required" id="ddlReturnType">
                            <option value="NA">NA</option>
                            <option value="Return">Return</option>
                        </select>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Ex-Rate (Rs/USD)</label>
                        <input type="text" class="erppage-input" id="txtExchangeRate" name="ExchangeRate" placeholder="Enter Ex-Rate">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Doc. Status</label>
                        <select class="erppage-input erppage-required" id="ddlDocStatus">
                            <option value="0">Select</option>
                        </select>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Net Amount</label>
                        <input type="text" class="erppage-input" id="txtNetAmount" name="NetAmount" placeholder="Enter Net Amount">
                    </div>
                </div>
            </fieldset>

            <div class="erppage-internalaction mt-2">
                <div class="dropdown erppagedropdown">

                    <button class="erppagedropdown-btn"
                            type="button"
                            id="copyFromDropdown"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <i class="fa-solid fa-copy"></i>
                        <span>Copy From</span>
                    </button>

                    <button class="erppagedropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <i class="fa-solid fa-chevron-down"></i>
                    </button>

                    <ul class="dropdown-menu erppagedropdown-menu" id="copyFromMenu">
                    </ul>

                </div>

                <button type="button"
                        id="btnShowProductionBatch"
                        class="erppage-btn erppage-btn-common-disabled">
                    <i class="fa fa-search"></i>
                    <span>Show Production Batch</span>
                </button>
            </div>

