            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Item Total</legend>
                <div class="erppage-grid5">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Received Qty</label>
                        <input type="text" class="erppage-input" id="NumReceivedQty" readonly placeholder="Enter Received Qty">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Bill Qty</label>
                        <input type="text" class="erppage-input" id="NumBillQty" readonly placeholder="Enter Bill Qty">
