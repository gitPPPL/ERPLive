    function calculateTaxAmounts(rowId) {
        const rate = parseFloat($(`#TxtRate${rowId}`).val()) || 0;
        const qty = parseFloat($(`#TxtBillQty${rowId}`).val()) || 0;
        const amount = rate * qty;

        const discPer = parseFloat($(`#TxtDiscPer${rowId}`).val()) || 0;
        const discAmt = (amount * discPer) / 100;
        $(`#TxtDiscAmt${rowId}`).val(discAmt.toFixed(2));

        const packPer = parseFloat($(`#TxtPackPer${rowId}`).val()) || 0;
        const packAmt = (amount * packPer) / 100;
        $(`#TxtPackAmt${rowId}`).val(packAmt.toFixed(2));

        const taxableAmount = amount - discAmt + packAmt;

        const cgstPer = parseFloat($(`#TxtCGSTPer${rowId}`).val()) || 0;
        const sgstPer = parseFloat($(`#TxtSGSTPer${rowId}`).val()) || 0;
        const igstPer = parseFloat($(`#TxtIGSTPer${rowId}`).val()) || 0;
        const cessPer = parseFloat($(`#TxtCESSPer${rowId}`).val()) || 0;
        const tcsPer = parseFloat($(`#TxtTcsPer${rowId}`).val()) || 0;
        const vatPer = parseFloat($(`#TxtVATPer${rowId}`).val()) || 0;
        // const othPer1 = parseFloat($(`#TxtOthPer${rowId}`).val()) || 0;
        // const othPer2 = parseFloat($(`#TxtOthPer2${rowId}`).val()) || 0;

        const cgstAmt = (taxableAmount * cgstPer) / 100;
        const sgstAmt = (taxableAmount * sgstPer) / 100;
        const igstAmt = (taxableAmount * igstPer) / 100;
        const cessAmt = (taxableAmount * cessPer) / 100;
        const tcsAmt = (taxableAmount * tcsPer) / 100;
        const vatAmt = (taxableAmount * vatPer) / 100;
        // const othAmt1 = (taxableAmount * othPer1) / 100;
        // const othAmt2 = (taxableAmount * othPer2) / 100;

        // const totalTax = cgstAmt + sgstAmt + igstAmt + cessAmt + tcsAmt + vatAmt + othAmt1 + othAmt2;

        const totalTax = cgstAmt + sgstAmt + igstAmt + cessAmt + tcsAmt + vatAmt ;
        const netAmt = taxableAmount + totalTax;

        $(`#TxtAmount${rowId}`).val(amount.toFixed(2));
        $(`#TxtCGSTAmt${rowId}`).val(cgstAmt.toFixed(2));
        $(`#TxtSGSTAmt${rowId}`).val(sgstAmt.toFixed(2));
        $(`#TxtIGSTAmt${rowId}`).val(igstAmt.toFixed(2));
        $(`#TxtCESSAmt${rowId}`).val(cessAmt.toFixed(2));
        $(`#TxtTcsAmt${rowId}`).val(tcsAmt.toFixed(2));
        $(`#TxtVATAmt${rowId}`).val(vatAmt.toFixed(2));
        // $(`#TxtOthAmt${rowId}`).val(othAmt1.toFixed(2));
        // $(`#TxtOthAmt2${rowId}`).val(othAmt2.toFixed(2));
        $(`#TxtNetAmt${rowId}`).val(netAmt.toFixed(2));

        calculateAllTotals(); // Recalculate footer totals
    }

    function calculateAllTotals() {
        let totalRecQty = 0,
            totalQty = 0,
            totalAmount = 0,
            totalPackAmt = 0,
            totalDiscAmt = 0,
            totalCgstAmt = 0,
            totalSgstAmt = 0,
            totalIgstAmt = 0,
            totalVatAmt = 0,
            totalCessAmt = 0,
            totalTcsAmt = 0,
            totalOtherAmt = 0,
            totalNetAmt = 0;

        $('#tblPurchaseReceiptIR tbody tr').each(function () {
            const $row = $(this);
            const idx = $row.attr('id').replace('row', '');

            totalRecQty      += parseFloat($(`#TxtRecQty${idx}`).val()) || 0;
            totalQty      += parseFloat($(`#TxtBillQty${idx}`).val()) || 0;
            totalAmount   += parseFloat($(`#TxtAmount${idx}`).val()) || 0;
            totalPackAmt  += parseFloat($(`#TxtPackAmt${idx}`).val()) || 0;
            totalDiscAmt  += parseFloat($(`#TxtDiscAmt${idx}`).val()) || 0;
            totalCgstAmt  += parseFloat($(`#TxtCGSTAmt${idx}`).val()) || 0;
            totalSgstAmt  += parseFloat($(`#TxtSGSTAmt${idx}`).val()) || 0;
            totalIgstAmt  += parseFloat($(`#TxtIGSTAmt${idx}`).val()) || 0;
            totalVatAmt   += parseFloat($(`#TxtVATAmt${idx}`).val()) || 0;
            totalCessAmt  += parseFloat($(`#TxtCESSAmt${idx}`).val()) || 0;
            // totalTcsAmt   += parseFloat($(`#TxtTcsAmt${idx}`).val()) || 0;
            totalOtherAmt += parseFloat($(`#TxtOthAmt${idx}`).val()) || 0;
            // totalOtherAmt += parseFloat($(`#TxtOthAmt2${idx}`).val()) || 0;
            totalNetAmt   += parseFloat($(`#TxtNetAmt${idx}`).val()) || 0;
        });

        const netAmtRaw = totalNetAmt;
        const netAmt = Math.round(netAmtRaw);
        const roundOff = +(netAmtRaw - netAmt).toFixed(2);


        $('#NumReceivedQty').val(totalRecQty.toFixed(2));
        $('#NumBillQty').val(totalQty.toFixed(2));
        $('#NumAmount').val(totalAmount.toFixed(2));
        $('#NumPacking').val(totalPackAmt.toFixed(2));
        $('#NumDiscount').val(totalDiscAmt.toFixed(2));
        $('#NumCGST').val(totalCgstAmt.toFixed(2));
        $('#NumSGST').val(totalSgstAmt.toFixed(2));
        $('#NumIGST').val(totalIgstAmt.toFixed(2));
        $('#NumVAT').val(totalVatAmt.toFixed(2));
        // $('#NumCessAmtIt').val(totalCessAmt.toFixed(2));
        // $('#NumTCSIt').val(totalTcsAmt.toFixed(2));
        $('#NumOtherAmt').val(totalOtherAmt.toFixed(2));
        $('#NumFinalNetAmt').val(totalNetAmt.toFixed(2));
        $('#NumRoundOff').val(roundOff.toFixed(2));
    }

