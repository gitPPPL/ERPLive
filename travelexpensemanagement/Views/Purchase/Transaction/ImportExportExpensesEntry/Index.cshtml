                                    <select class="erppage-input erppage-width-7" id="ddladdressBD1">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Add Line2</label>
                                <input type="text" class="erppage-input" id="txtAddLine2" placeholder="Enter Address Line 2" readonly>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Add Line3</label>
                                <input type="text" class="erppage-input" id="txtAddLine3" placeholder="Enter Address Line 3" readonly>
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">City</label>
                                <select class="erppage-input erppage-select" id="ddlCity" disabled>
                                    <option value="">Select City</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">State</label>
                                <select class="erppage-input erppage-select" id="ddlState" disabled>
                                    <option value="">Select State</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">GST No</label>
                                <input type="text" class="erppage-input" id="txtGST" placeholder="Enter GST No" disabled>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Pincode</label>
                                <input type="number" class="erppage-input" id="txtPincode" placeholder="Enter Pincode" disabled>
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="erppagescol-6">
                    <fieldset class="erppagefieldset">
                        <legend class="erppagefieldset-legend">Ship Details</legend>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Ship from</label>
                                <div class="erppage-inputgroup">
                                    <select class="erppage-redinput erppage-width-93" id="ddlShipFrom">
                                        <option value="">Select Ship from</option>
                                    </select>
                                    <select class="erppage-redinput erppage-width-7" id="ddlShipFrom2">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Add Line1</label>
                                <input type="text" class="erppage-input" id="txtShipAddLine1" placeholder="Enter Address Line 1" readonly>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Add Line2</label>
                                <input type="text" class="erppage-input" id="txtShipAddLine2" placeholder="Enter Address Line 2" readonly>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Add Line3</label>
                                <input type="text" class="erppage-input" id="txtShipAddLine3" placeholder="Enter Address Line 3" readonly>
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">City</label>
                                <select class="erppage-input erppage-select" id="ddlShipCity" disabled>
                                    <option value="">Select City</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">State</label>
                                <select class="erppage-input erppage-select" id="ddlShipState" disabled>
                                    <option value="">Select State</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">GST No</label>
                                <input type="text" class="erppage-input" id="txtShipGST" placeholder="Enter GST Number" disabled>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Pincode</label>
                                <input type="number" class="erppage-input" id="NumShipPincode" data-maxlength="6" placeholder="Enter Pincode" disabled>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Document Details</legend>
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Bill No</label>
                        <input type="text" class="erppage-redinput" id="txtBillNo" placeholder="Enter Bill No">
                    </div>
                    <div class="erppage-divfield erppage-datefield">
                        <label class="erppage-label">Bill Date</label>
                        <div class="erppage-datebox">
                            <input type="date" class="erppage-redinput erppage-dateinput" id="DtBillDate">
                            <label class="erppage-checkbox-inside">
                                <input type="checkbox" class="erppage-checkbox-input" id="chkBillDate">
                            </label>
                        </div>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">BOE No</label>
                        <input type="text" class="erppage-input" id="NumBOENo" maxlength="15" placeholder="Enter BOE No">
                    </div>
                    <div class="erppage-divfield erppage-datefield">
                        <label class="erppage-label">BOE Date</label>
                        <div class="erppage-datebox">
                            <input type="date" class="erppage-input erppage-dateinput" id="DtBOEDate">
                            <label class="erppage-checkbox-inside">
                                <input type="checkbox" class="erppage-checkbox-input" id="chkBOEDate">
                            </label>
                        </div>
                    </div>
                </div>
               
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label">BL No</label>
                        <input type="text" class="erppage-input" id="NumBLNo" maxlength="15" placeholder="Enter BL No">
                    </div>
                    <div class="erppage-divfield erppage-datefield">
                        <label class="erppage-label">BL Date</label>
                        <div class="erppage-datebox">
                            <input type="date" class="erppage-input erppage-dateinput" id="DtBLDate">
                            <label class="erppage-checkbox-inside">
                                <input type="checkbox" class="erppage-checkbox-input" id="chkBLDate">
                            </label>
                        </div>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Input Type</label>
                        <select class="erppage-input erppage-select" id="ddlInputType">
                            <option>Select Input Type</option>
                            <option value="GST Input">GST Input</option>
                            <option value="GST NA">GST NA</option>
                            <option value="Import">Import</option>
                            <option value="Input NA">Input NA</option>
                            <option value="RCM">RCM</option>
                        </select>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Exp. Type</label>
                        <select class="erppage-input erppage-select" id="ddlExpensesType">
                            <option value="">Select Expenses Type</option>
                            <option value="customduty">Custom Duty</option>
                            <option value="shippingline">Shipping Line</option>
                            <option value="container">Container</option>
                            <option value="clearingagent">Clearing Agent</option>
                            <option value="freight">Freight</option>
                            <option value="detention">Detention</option>
                            <option value="clearingexps">Clearing Exps</option>
                            <option value="labtest">Lab Test</option>
                        </select>
                    </div>
                </div>
            </fieldset>
            <div class="erppage-grid4 mt-2">
                <div class="erppage-divfield">
                    <label class="erppage-label">Debit A/c</label>
                    <select class="erppage-input erppage-required" id="ddlDebitAC">
                        <option value="">Select Debit A/C</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Credit A/c</label>
                    <select class="erppage-redinput erppage-select" id="ddlCreditAC">
                        <option>Select Credit Account</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Remarks</label>
                    <textarea class="erppage-input" id="txtRemarks" maxlength="500" placeholder="Enter Remarks"></textarea>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Status</label>
                    <select class="erppage-input erppage-select" id="ddlStatus" readonly>
                        <option value="open" selected>Open</option>
                        <option value="closed">Closed</option>
                        <option value="pending">Pending</option>
                    </select>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Net Amount</label>
                    <input type="text" class="erppage-input" id="TxtNetAmount" placeholder="Enter Amount" disabled>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Employee</label>
                    <select class="erppage-input erppage-select" id="ddlEmployee">
                        <option value="">Select Employee</option>
                    </select>
                </div>
            </div>
            <div class="erppage-internalaction mt-2">
                <div class="dropdown erppagedropdown">
                    <button class="erppagedropdown-btn" type="button" id="copyFromDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa-solid fa-copy"></i>
                        <span>Copy From</span>
                    </button>
                    <button class="erppagedropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa-solid fa-chevron-down"></i>
                    </button>
                    <ul class="dropdown-menu erppagedropdown-menu">
                        <li>
                            <a class="dropdown-item erppagedropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#directorderModal">
                                <i class="fa fa-shopping-cart"></i>
                                <span>Direct Order</span>
                            </a>
                        </li>
                    </ul>
                </div>
                <button type="button" class="erppage-btn erppage-btn-common-disabled" data-bs-toggle="modal" data-bs-target="#costallocationModal">
                    <i class="fa fa-calculator"></i>
                    <span>Cost Allocation</span>
                </button>
                <button type="button" class="erppage-btn erppage-btn-common-pending-disabled" data-bs-toggle="modal" data-bs-target="#pendingapprovalModal">
                    <i class="fa fa-clock"></i>
                    <span>List of Pending Approval</span>
                </button>
                <button type="button" class="erppage-btn erppage-btn-common-active">
                    <i class="fa fa-list"></i>
                    <span>Import Invoice List</span>
                </button>
            </div>
            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Item Total</legend>
                <div class="erppage-grid5">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Received Qty</label>
                        <input type="number" class="erppage-input" id="NumReceivedQty" readonly placeholder="Enter Received Qty">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Bill Qty</label>
                        <input type="number" class="erppage-input" id="NumBillQty" readonly placeholder="Enter Bill Qty">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Amount</label>
                        <input type="number" class="erppage-input" id="NumAmount" readonly placeholder="Enter Amount">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Packing</label>
                        <input type="number" class="erppage-input" id="NumPacking" readonly placeholder="Enter Packing Amt">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Discount</label>
                        <input type="number" class="erppage-input" id="NumDiscount" readonly placeholder="Enter Discount Amt">
                    </div>
                </div>
                <div class="erppage-grid5">
                    <div class="erppage-divfield">
                        <label class="erppage-label">CGST</label>
                        <input type="number" class="erppage-input" id="NumCGST" readonly placeholder="Enter CGST">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">SGST</label>
                        <input type="number" class="erppage-input" id="NumSGST" readonly placeholder="Enter SGST">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">IGST</label>
                        <input type="number" class="erppage-input" id="NumIGST" readonly placeholder="Enter IGST">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">CESS</label>
                        <input type="number" class="erppage-input" id="NumCESS" readonly placeholder="Enter CESS">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">VAT</label>
                        <input type="number" class="erppage-input" id="NumVAT" readonly placeholder="Enter VAT">
                    </div>
                </div>
                <div class="erppage-grid5">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Other Amt</label>
                        <input type="number" class="erppage-input" id="NumOtherAmt" readonly placeholder="Enter Other Amount">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">TCS %</label>
                        <div class="erppage-inputgroup">
                            <input type="text" class="erppage-input" id="NumTCSPer1" maxlength="5" oninput="allowOnlyNumbers(this);" placeholder="%">
                            <input type="text" class="erppage-input" id="NumTCSAmt" maxlength="10" oninput="allowOnlyNumbers(this);" placeholder="Amount">
                        </div>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Sub Total</label>
                        <input type="number" class="erppage-input" id="NumSubTotal" readonly placeholder="Enter Sub Total">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Round Off</label>
                        <input type="number" class="erppage-input" id="NumRoundOff" readonly placeholder="Enter Round Off">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Net Amount</label>
                        <input type="number" class="erppage-input" id="NumFinalNetAmt" readonly placeholder="Enter Net Amount">
                    </div>
                </div>
                <fieldset class="erppagesubfieldset">
                    <div class="erppage-grid3">
                        <div class="erppage-divfield">
                            <label class="erppage-label">TDS A/c</label>
                            <select class="erppage-input erppage-select" id="ddlTdsAccount">
                                <option value="">Select TDS A/C</option>
                            </select>
                        </div>
                        <div class="erppage-divfield">
                            <label class="erppage-label">TDS</label>
                            <div class="erppage-inputgroup">
                                <input type="text" class="erppage-input" id="TxtTds1" maxlength="10" oninput="allowOnlyNumbers(this);">
                                <input type="text" class="erppage-input" id="TxtTds2" maxlength="10" oninput="allowOnlyNumbers(this);">
                            </div>
                        </div>
                        <div class="erppage-divfield">
                            <label class="erppage-label">TDS 194Q</label>
                            <div class="erppage-inputgroup">
                                <input type="text" class="erppage-input" id="TxtTds194q1" maxlength="10" oninput="allowOnlyNumbers(this);">
                                <input type="text" class="erppage-input" id="TxtTds194q2" maxlength="10" oninput="allowOnlyNumbers(this);">
                            </div>
                        </div>
                    </div>
                    <div class="erppage-grid3">
                        <div class="erppage-divfield">
                            <label class="erppage-label">Party Bill Amt (USD)</label>
                            <input type="text" class="erppage-input" id="TxtPartyUsd" maxlength="20" oninput="allowOnlyNumbers(this);" placeholder="Enter USD Amount">
                        </div>
                        <div class="erppage-divfield erppage-col-span-2 erppage-internalaction">
                            <button type="button" class="erppage-btn erppage-btn-common-active-disabled" data-bs-toggle="modal" data-bs-target="#tdscalculationModal">
                                <i class="fa fa-tasks"></i>
                                <span>TDS Calculation</span>
                            </button>
                            <button type="button" class="erppage-btn erppage-btn-common-active-disabled" data-bs-toggle="modal" data-bs-target="#tdsadjustmentModal">
                                <i class="fa fa-sitemap"></i>
                                <span>TDS Adjustment</span>
                            </button>
                            
                        </div>
                    </div>
                </fieldset>
            </fieldset>
            <div class="erppage-container">
                <div class="erppage-tabs">
                    <button class="erppage-tab active" data-tab="itemrecord">Item Record</button>
                    <button class="erppage-tab" data-tab="logisticdetails">Logistic Details</button>
                    <button class="erppage-tab" data-tab="crdrnote">Cr/Dr Note</button>
                    <button class="erppage-tab" data-tab="attachment">Attachment</button>
                </div>
