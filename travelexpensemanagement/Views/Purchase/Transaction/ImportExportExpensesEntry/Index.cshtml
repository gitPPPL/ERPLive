    function UpdateData(UpdateDt) {
        $.ajax({
            url: '@Url.Action("SaveOrUpdateImportExportExpense", "ImportExportExpensesEntry")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(UpdateDt),
