        <div class="erppage-header-icon">
            <i class="fa fa-archive"></i>
        </div>
        <div class="erppage-header-title">Import Export Expenses Entry</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "ImportExportExpensesEntryList")', readOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="PurchaseReceiptEntryForm">
