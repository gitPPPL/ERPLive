@{
    ViewBag.Title = "Purchase Return Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-undo"></i>
        </div>
        <div class="erppage-header-title">Purchase Return Entry</div>
    </div>
    <div class="erppage-header-right">

        <button type="button"
                id="btn_Sendapproval"
                style="display:none;">
            Send For Approval
        </button>

        <button type="button"
                id="btn_Approved"
                style="display:none;color:green;font-weight:bold;">
            Approved
        </button>

        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" onclick="PrintPurchaseReturnEntryReport()">
            <i class="fa fa-print"></i> Print
        </button>

        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "PurchaseReturnEntryList")', readOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="PurchaseReturnEntryForm">
    <input type="hidden" class="form-control" id="TxtCode" name="CODE">
    <div class="erppage-container">
        <div class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Type</label>
                    <select class="erppage-input erppage-required" id="ddlDocType">
                        <option value="">Select DOC Type</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc No</label>
                    <input type="number" class="erppage-redinput" id="NumDocNo" placeholder="Enter Doc No">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-redinput" id="DtDocDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">WB No</label>
                    <input type="text" class="erppage-redinput" id="WBNo">
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Ref Type</label>
                    <select class="erppage-input erppage-required" id="ddlRefType">
                        <option value="">Select Ref Type</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Ref No</label>
                    <select class="erppage-input erppage-required" id="ddlRefNo">
                        <option value="">Select Ref No</option>
                    </select>
                </div>
            </div>

            <div class="erppagesrow">
                <div class="erppagescol-4">
                    <fieldset class="erppagefieldset" style="height: 95%;">
                        <legend class="erppagefieldset-legend">Return To</legend>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Return To</label>
                                <select class="erppage-input erppage-required" id="ddlReturnTo">
                                    <option value="">Select Return To</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Add Line1</label>
                                <input type="text" class="erppage-input" id="txtAddLine1" placeholder="Enter Address Line 1">
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Add Line2</label>
                                <input type="text" class="erppage-input" id="txtAddLine2" placeholder="Enter Address Line 2">
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Add Line3</label>
                                <input type="text" class="erppage-input" id="txtAddLine3" placeholder="Enter Address Line 3">
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">City</label>
                                <select class="erppage-input erppage-select" id="ddlCity">
                                    <option value="">Select City</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">GST No</label>
                                <input type="text" class="erppage-input" id="txtGST" placeholder="Enter GST No">
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="erppagescol-4">
                    <fieldset class="erppagefieldset" style="height: 95%;">
                        <legend class="erppagefieldset-legend">Shipping Details</legend>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Ship To</label>
                                <select class="erppage-input erppage-required" id="ddlShipFrom">
                                    <option value="">Select Ship To</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Add Line1</label>
                                <input type="text" class="erppage-input" id="txtShipAddLine1" placeholder="Enter Address Line 1">
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Add Line2</label>
                                <input type="text" class="erppage-input" id="txtShipAddLine2" placeholder="Enter Address Line 2">
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Add Line3</label>
                                <input type="text" class="erppage-input" id="txtShipAddLine3" placeholder="Enter Address Line 3">
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">City</label>
                                <select class="erppage-input erppage-select" id="ddlShipCity">
                                    <option value="">Select City</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">GST No</label>
                                <input type="text" class="erppage-input" id="txtShipGST" placeholder="Enter GST Number">
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="erppagescol-4">
                    <fieldset class="erppagefieldset">
                        <legend class="erppagefieldset-legend">Document Details</legend>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Bill No</label>
                                <input type="text" class="erppage-redinput" id="txtBillNo" placeholder="Enter Bill No">
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield erppage-datefield">
                                <label class="erppage-label">Bill Date</label>
                                <div class="erppage-datebox">
                                    <input type="date" class="erppage-redinput erppage-dateinput" id="DtBillDate">
                                    <label class="erppage-checkbox-inside">
                                        <input type="checkbox" class="erppage-checkbox-input" id="chkBillDate">
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">BL No</label>
                                <input type="text" class="erppage-input" id="TxtBLNo" placeholder="Enter BL No">
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield erppage-datefield">
                                <label class="erppage-label">BL Date</label>
                                <div class="erppage-datebox">
                                    <input type="date" class="erppage-input erppage-dateinput" id="DtBLDate">
                                    <label class="erppage-checkbox-inside">
                                        <input type="checkbox" class="erppage-checkbox-input" id="chkBLDate">
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Waybill No</label>
                                <input type="text" class="erppage-input" id="TxtWaybillNo" placeholder="Enter Waybill No">
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Transit No</label>
                                <select class="erppage-input erppage-select" id="ddlTransitNo">
                                    <option value="">Select Transit No</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Input Type</label>
                                <select class="erppage-input erppage-required" id="ddlInputType">
                                    <option value="">Select Input Type</option>
                                    <option value="GST Input">GST Input</option>
                                    <option value="GST NA">GST NA</option>
                                    <option value="Import">Import</option>
                                    <option value="Input NA">Input NA</option>
                                    <option value="RCM">RCM</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Expenses Type</label>
                                <select class="erppage-input erppage-select" id="ddlExpensesType">
                                    <option value="">Select Expenses Type</option>
                                    <option value="Custom Duty">Custom Duty</option>
                                    <option value="Shipping Line">Shipping Line</option>
                                    <option value="Container">Container</option>
                                    <option value="Clearing Agent">Clearing Agent</option>
                                    <option value="Freight">Freight</option>
                                    <option value="Detention">Detention</option>
                                    <option value="Clearing Exps">Clearing Exps</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Status</label>
                                <select class="erppage-input erppage-required" id="ddlDocStatus">
                                    <option value="">Select Doc Status</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Net Amount</label>
                                <input type="text" class="erppage-input" id="txtNetAmount" placeholder="No">
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
            <div class="erppage-grid3">
                <div class="erppage-divfield">
                    <label class="erppage-label">Credit A/C</label>
                    <select class="erppage-input erppage-select" id="ddlcreditAC">
                        <option value="">Select Credit A/C</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Debit A/C</label>
                    <select class="erppage-input erppage-select" id="ddldebitAC">
                        <option value="">Select Debit A/C</option>
                    </select>
                </div>
            </div>
            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Item Total</legend>
                <div class="erppage-grid5">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Received Qty</label>
                        <input type="number" class="erppage-input" id="NumReceivedQty" readonly placeholder="Enter Received Qty">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Bill Qty</label>
                        <input type="number" class="erppage-input" id="NumBillQty" readonly placeholder="Enter Bill Qty">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Amount</label>
                        <input type="number" class="erppage-input" id="NumAmount" readonly placeholder="Enter Amount">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Packing</label>
                        <input type="number" class="erppage-input" id="NumPacking" readonly placeholder="Enter Packing Amount">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Discount</label>
                        <input type="number" class="erppage-input" id="NumDiscount" readonly placeholder="Enter Discount Amount">
                    </div>
                </div>
                <div class="erppage-grid5">
                    <div class="erppage-divfield">
                        <label class="erppage-label">CGST</label>
                        <input type="number" class="erppage-input" id="NumCGST" readonly placeholder="Enter CGST">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">SGST</label>
                        <input type="number" class="erppage-input" id="NumSGST" readonly placeholder="Enter SGST">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">IGST</label>
                        <input type="number" class="erppage-input" id="NumIGST" readonly placeholder="Enter IGST">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">CESS</label>
                        <input type="number" class="erppage-input" id="NumCESS" readonly placeholder="Enter CESS">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Other Amt</label>
                        <input type="number" class="erppage-input" id="NumOtherAmt" readonly placeholder="Enter Other Amount">
                    </div>
                </div>
                <div class="erppage-grid5">
                    <div class="erppage-divfield">
                        <label class="erppage-label">TCS %</label>
                        <div class="erppage-inputgroup">
                            <input type="number" class="erppage-input" id="NumTCSPer1" readonly placeholder="%">
                            <input type="number" class="erppage-input" id="NumTCSPer2" readonly placeholder="Amount">
                        </div>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Sub Total</label>
                        <input type="number" class="erppage-input" id="NumSubTotal" readonly placeholder="Enter Sub Total">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Round Off</label>
                        <input type="number" class="erppage-input" id="NumRoundOff" readonly placeholder="Enter Round Off">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Net Amount</label>
                        <input type="number" class="erppage-input" id="NumFinalNetAmt" readonly placeholder="Enter Net Amount">
                    </div>
                </div>
                <div class="erppage-grid5">
                    <div class="erppage-divfield">
                        <label class="erppage-label">TDS A/c</label>
                        <select class="erppage-input erppage-select" id="ddlTdsAccount">
                            <option value="">Select TDS A/C</option>
                        </select>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">TDS</label>
                        <div class="erppage-inputgroup">
                            <input type="text" class="erppage-input" id="TxtTds1">
                            <input type="text" class="erppage-input" id="TxtTds2">
                        </div>
                    </div>
                    <div class="erppage-divfield erppage-col-span-2">
                        @*   <label class="erppage-label">Remarks</label>
                        <textarea class="erppage-input" id="txtremarks" rows="3" placeholder="Enter Remarks"></textarea> *@
                    </div>
                </div>
            </fieldset>

            <div class="erppage-internalaction mt-2">
                <button type="button" class="erppage-btn erppage-btn-common-disabled" data-bs-target="#showproductionbatchmodal" data-bs-toggle="modal">
                    <i class="fa fa-search"></i>
                    <span>Show Production Batch</span>
                </button>
                <button type="button" class="erppage-btn erppage-btn-common">
                    <i class="fa fa-refresh"></i>
                    <span>Refresh Batch From MRN</span>
                </button>
            </div>

            <div class="erppage-container">
                <div class="erppage-tabs">
                    <button class="erppage-tab active" data-tab="itemrecord">Item Record</button>
                    <button class="erppage-tab" data-tab="logisticdetails">Logistic Details</button>
                    <button class="erppage-tab" data-tab="crdrnote">Cr/Dr Note</button>
                    <button class="erppage-tab" data-tab="attachment">Attachment</button>
                </div>
                <!-- Item Record -->
                <div class="erppage-tab-content active" id="itemrecord">
                    <div class="erppage-accordion-body">
                        <fieldset class="erppage-fieldset">
                            <div class="excel-wrapper fixed-grid-wrapper">
                                <table id="tblItemRecordPO" class="excel-table fixed-grid-table width-table resizable-table">

                                    <colgroup>
                                        <col class="hidden-col">
                                        <col style="width:250px;">
                                        <col style="width:120px;">
                                        <col style="width:90px;">
                                        <col style="width:80px;">
                                        <col style="width:90px;">
                                        <col style="width:90px;">
                                        <col style="width:100px;">
                                        <col style="width:100px;">
                                        <col style="width:90px;">
                                        <col style="width:90px;">
                                        <col style="width:120px;">
                                        <col style="width:80px;">
                                        <col style="width:100px;">
                                        <col style="width:80px;">
                                        <col style="width:100px;">
                                        <col style="width:80px;">
                                        <col style="width:100px;">
                                        <col style="width:80px;">
                                        <col style="width:100px;">
                                        <col style="width:80px;">
                                        <col style="width:100px;">
                                        <col style="width:80px;">
                                        <col style="width:100px;">
                                        <col style="width:80px;">
                                        <col style="width:100px;">
                                        <col style="width:120px;">
                                        <col style="width:120px;">
                                        <col style="width:150px;">
                                        <col style="width:100px;">
                                        <col style="width:100px;">
                                        <col style="width:120px;">
                                        <col style="width:120px;">
                                        <col style="width:120px;">
                                        <col style="width:120px;">
                                        <col style="width:120px;">
                                        <col style="width:90px;">
                                    </colgroup>

                                    <thead>
                                        <tr>
                                            <th class="hidden-col">Code</th>
                                            <th class="freeze-item">Item Name</th>
                                            <th>HSN Code</th>
                                            <th>Unit</th>
                                            <th>Nos</th>
                                            <th>Return Qty</th>
                                            <th>Bill Qty</th>
                                            <th>Rate</th>
                                            <th>Amount</th>
                                            <th>RCM Y/N</th>
                                            <th>Input Y/N</th>
                                            <th>Tax Type</th>
                                            <th>Pack %</th>
                                            <th>Pack Amt</th>
                                            <th>Disc %</th>
                                            <th>Disc</th>
                                            <th>WB Qty</th>
                                            <th>CGST %</th>
                                            <th>CGST</th>
                                            <th>SGST %</th>
                                            <th>SGST</th>
                                            <th>IGST %</th>
                                            <th>IGST</th>
                                            <th>Cess %</th>
                                            <th>Cess</th>
                                            <th>Oth Amt</th>
                                            <th>Net Amt</th>
                                            <th>Make</th>
                                            <th>Department</th>
                                            <th>Remarks</th>
                                            <th>LD Rate</th>
                                            <th>LD Amt</th>
                                            <th>WB Type</th>
                                            <th>WB No</th>
                                            <th>Ref Type</th>
                                            <th>Ref No</th>
                                            <th class="action-col">Action</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <tr>
                                            <td class="hidden-col">
                                                <input type="text" class="erppagetable-control" name="Code">
                                            </td>
                                            <td>
                                                <select class="erppagetable-control item-name-dropdown" name="ItemName">
                                                    <option value="">Select</option>
                                                </select>
                                            </td>
                                            <td><input type="text" class="erppagetable-control" name="HSNCode"></td>
                                            <td><input type="text" class="erppagetable-control" name="Unit"></td>
                                            <td><input type="number" class="erppagetable-control" name="Nos"></td>
                                            <td><input type="number" class="erppagetable-control" name="ReturnQty"></td>
                                            <td><input type="number" class="erppagetable-control" name="BillQty"></td>
                                            <td><input type="number" class="erppagetable-control" name="Rate"></td>
                                            <td><input type="number" class="erppagetable-control" name="Amount"></td>
                                            <td>
                                                <select class="erppagetable-control" name="RCMYN">
                                                    <option value="">Select</option>
                                                    <option>Yes</option>
                                                    <option>No</option>
                                                </select>
                                            </td>
                                            <td>
                                                <select class="erppagetable-control" name="InputYN">
                                                    <option value="">Select</option>
                                                    <option>Yes</option>
                                                    <option>No</option>
                                                </select>
                                            </td>
                                            <td>
                                                <select class="erppagetable-control TaxType-dropdown" name="TaxType">
                                                    <option value="">Select</option>
                                                </select>
                                            </td>
                                            <td><input type="number" class="erppagetable-control" name="PackPer"></td>
                                            <td><input type="number" class="erppagetable-control" name="PackAmt"></td>
                                            <td><input type="number" class="erppagetable-control" name="DiscPer"></td>
                                            <td><input type="number" class="erppagetable-control" name="DiscAmt"></td>
                                            <td><input type="number" class="erppagetable-control" name="WBQty"></td>
                                            <td><input type="number" class="erppagetable-control" name="CGSTPer"></td>
                                            <td><input type="number" class="erppagetable-control" name="CGSTAmt"></td>
                                            <td><input type="number" class="erppagetable-control" name="SGSTPer"></td>
                                            <td><input type="number" class="erppagetable-control" name="SGSTAmt"></td>
                                            <td><input type="number" class="erppagetable-control" name="IGSTPer"></td>
                                            <td><input type="number" class="erppagetable-control" name="IGSTAmt"></td>
                                            <td><input type="number" class="erppagetable-control" name="CessPer"></td>
                                            <td><input type="number" class="erppagetable-control" name="CessAmt"></td>
                                            <td><input type="number" class="erppagetable-control" name="OthAmt"></td>
                                            <td><input type="number" class="erppagetable-control" name="NetAmt"></td>
                                            <td>
                                                <select class="erppagetable-control Make-dropdown" name="Make">
                                                    <option value="">Select</option>
                                                </select>
                                            </td>
                                            <td>
                                                <select class="erppagetable-control Department-dropdown" name="Department">
                                                    <option value="">Select</option>
                                                </select>
                                            </td>
                                            <td><input type="text" class="erppagetable-control" name="Remarks"></td>
                                            <td><input type="number" class="erppagetable-control" name="LDRate"></td>
                                            <td><input type="number" class="erppagetable-control" name="LDAmt"></td>
                                            <td><input type="text" class="erppagetable-control" name="WBType"></td>
                                            <td><input type="text" class="erppagetable-control" name="WBNo"></td>
                                            <td><input type="text" class="erppagetable-control" name="RefType"></td>
                                            <td><input type="text" class="erppagetable-control" name="RefNo"></td>
                                            <td class="action-col">
                                                <div class="action-wrap">
                                                    <button type="button" class="act-btn add btn-add" title="Add row"><i class="fa fa-plus-circle"></i></button>
                                                    <button type="button" class="act-btn edit btn-edit" title="Edit row"><i class="fa fa-edit"></i></button>
                                                    <button type="button" class="act-btn delete btn-delete btn-delete-row" title="Delete row"><i class="fa fa-trash"></i></button>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>

                                </table>
                            </div>
                        </fieldset>
                    </div>
                </div>
