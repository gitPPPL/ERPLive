@{
    ViewBag.Title = "Purchase Return Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<fieldset>
    <legend class="legend-field">Purchase Return Entry</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="window.location.href='@Url.Action("Index", "PurchaseReturnEntryList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>

    <form id="PurchaseReturnEntryForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlDocType">Doc Type<span class="required">*</span></label>
                    <select class="form-control" id="ddlDocType">
                        <option>--Select DOC Type--</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumDocNo">Doc No<span class="required">*</span></label>
                    <input type="text" class="form-control" id="NumDocNo" placeholder="Enter Doc No">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DtDocDate">Doc Date<span class="required">*</span></label>
                    <input type="date" class="form-control" id="DtDocDate" name="DocDate">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtWBNo">WB No<span class="required">*</span></label>
                    <input type="text" class="form-control" id="WBNo" name="WBNo">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="ddlRefType"><span class="required">*</span>Ref Type</label>
                    <select class="form-control" id="ddlRefType">
                        <option value="">--Select Ref Type--</option>
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="NumRefNo">Ref No<span class="required">*</span></label>
                    <select class="form-control" id="ddlRefNo">
                        <option value="0">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <!-- Return To Section -->
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Return To</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ddlReturnTo">Return To<span class="required">*</span></label>
                                <select class="form-control" id="ddlReturnTo">
                                    <option>--Select Return To--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtAddLine1">Add Line1</label>
                                <input type="text" class="form-control" id="txtAddLine1" placeholder="Enter Address Line 1">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtAddLine2">Address Line 2</label>
                                <input type="text" class="form-control" id="txtAddLine2" placeholder="Enter Address">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtAddLine3">Address Line 3</label>
                                <input type="text" class="form-control" id="txtAddLine3" placeholder="Enter Address">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlCity">City</label>
                                <select class="form-control" id="ddlCity">
                                    <option>--Select City--</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="txtGST">GST</label>
                                <input type="text" class="form-control" id="txtGST" placeholder="Enter GST">
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <!-- Ship To Section -->
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Ship Details</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ddlShipTo">Ship To<span class="required">*</span></label>
                                <select class="form-control" id="ddlShipFrom">
                                    <option>--Select Ship To--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtShipAddLine1">Add Line1</label>
                               @*  <div class="input-divide"> *@
                                    <input type="text" class="form-control" id="txtShipAddLine1" placeholder="Enter Address">
                                 @*    <div class="select-wrapper">
                                        <select id="ddladdressSD1">
                                            <option value="">Select address</option>
                                        </select>
                                    </div> *@
                                @* </div> *@
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtShipAddLine2">Address Line 2</label>
                                <input type="text" class="form-control" id="txtShipAddLine2" placeholder="Enter Address">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="txtShipAddLine3">Address Line 3</label>
                                <input type="text" class="form-control" id="txtShipAddLine3" placeholder="Enter Address">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlShipCity">City</label>
                                <select class="form-control" id="ddlShipCity">
                                    <option>--Select City--</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="txtShipGST">GST</label>
                                <input type="text" class="form-control" id="txtShipGST" placeholder="Enter GST">
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Document Details</legend>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="txtBillNo">Bill No<span class="required">*</span></label>
                                <input type="text" class="form-control" id="txtBillNo" placeholder="Enter Bill No">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtBillDate">Bill Date<span class="required">*</span></label>
                                <input type="date" class="form-control" id="DtBillDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtBLNo">BL No</label>
                                <input type="text" class="form-control" id="TxtBLNo" placeholder="Enter BL No">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtBLDate">BL Date</label>
                                <input type="date" class="form-control" id="DtBLDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtWaybillNo">Waybill No</label>
                                <input type="text" class="form-control" id="TxtWaybillNo" placeholder="Enter Waybill No">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlTransitNo">Transit No</label>
                                <select class="form-control" id="ddlTransitNo">
                                    <option value="">Select Transit No</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlInputType">Input Type<span class="required">*</span></label>
                                <select class="form-control" id="ddlInputType">
                                    <option value="">Select Input Type</option>
                                    <option value="GST Input">GST Input</option>
                                    <option value="GST NA">GST NA</option>
                                    <option value="Import">Import</option>
                                    <option value="Input NA">Input NA</option>
                                    <option value="RCM">RCM</option>
                                </select>

                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlExpensesType">Expenses Type<span class="required">*</span></label>
                                <select class="form-control" id="ddlExpensesType">
                                    <option value="">Select Expenses Type</option>
                                    <option value="Custom Duty">Custom Duty</option>
                                    <option value="Shipping Line">Shipping Line</option>
                                    <option value="Container">Container</option>
                                    <option value="Clearing Agent">Clearing Agent</option>
                                    <option value="Freight">Freight</option>
                                    <option value="Detention">Detention</option>
                                    <option value="Clearing Exps">Clearing Exps</option>
                                </select>

                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlStatus">Status<span class="required">*</span></label>
                                <select class="form-control" id="ddlDocStatus">
                                    <option value="">-- Select Doc Status --</option>
                                    @* <option value="1" selected>Open</option>
                                    <option value="2">Cancel</option>
                                    <option value="3">Close</option> *@
                                </select>

                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="txtNetAmount">Net Amount</label>
                                <input type="text" class="form-control" id="txtNetAmount" placeholder="Enter Net Amount">
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="ddlcredit">Credit A/C</label>
                    <select class="form-control" id="ddlcreditAC">
                        <option value="">Select Credit A/C</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="ddldebit">Debit A/C</label>
                    <select class="form-control" id="ddldebitAC">
                        <option value="">Select Debit A/C</option>
                    </select>
                </div>
            </div>
        </div>

        @* Item Total start Block *@
        <div class="row">
            <div class="col-md-12">
                <fieldset class="fieldset-sub">
                    <legend class="sub-legend">Item Total</legend>
                    <div class="row">
                        <div class="col-md-10">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumReceivedQty">Received Qty</label>
                                        <input type="number" class="form-control" id="NumReceivedQty" readonly placeholder="Enter Received Qty">
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumBillQty">Bill Qty</label>
                                        <input type="number" class="form-control" id="NumBillQty" readonly placeholder="Enter Bill Qty">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumAmount">Amount</label>
                                        <input type="number" class="form-control" id="NumAmount" readonly placeholder="Enter Amount">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumPacking">Packing</label>
                                        <input type="number" class="form-control" id="NumPacking" readonly placeholder="Enter Packing Amt">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumDiscount">Discount</label>
                                        <input type="number" class="form-control" id="NumDiscount" readonly placeholder="Enter Discount Amt">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumCGST">CGST</label>
                                        <input type="number" class="form-control" id="NumCGST" readonly placeholder="Enter CGST">
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumSGST">SGST</label>
                                        <input type="number" class="form-control" id="NumSGST" readonly placeholder="Enter SGST">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumIGST">IGST</label>
                                        <input type="number" class="form-control" id="NumIGST" readonly placeholder="Enter IGST">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumCESS">CESS</label>
                                        <input type="number" class="form-control" id="NumCESS" readonly placeholder="Enter CESS">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumOtherAmt">Other Amt</label>
                                        <input type="number" class="form-control" id="NumOtherAmt" readonly placeholder="Enter Other Amount">
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="NumTCSPer">TCS %</label>
                                        <div class="input-divide">
                                            <input type="number" class="form-control" id="NumTCSPer1" readonly placeholder="Enter TCS %">
                                            <input type="number" class="form-control" id="NumTCSPer2" readonly placeholder="Enter TCS %">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumSubTotal">Sub Total</label>
                                        <input type="number" class="form-control" id="NumSubTotal" readonly placeholder="Enter Sub Total">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumRoundOff">Round Off</label>
                                        <input type="number" class="form-control" id="NumRoundOff" readonly placeholder="Enter Round Off">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="NumFinalNetAmt">Net Amount</label>
                                        <input type="number" class="form-control" id="NumFinalNetAmt" readonly placeholder="Enter Net Amount">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <!-- TDS A/c -->
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="ddlTdsAccount">TDS A/c</label>
                                        <select class="form-control" id="ddlTdsAccount">
                                            <option value="">Select TDS A/C</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="TxtTds">TDS</label>
                                        <div class="input-divide">
                                            <input type="text" class="form-control" id="TxtTds1">
                                            <input type="text" class="form-control" id="TxtTds2">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="Remarks">Remarks</label>
                                <textarea type="text" class="form-height" id="txtremarks" placeholder="Enter Remarks"></textarea>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        @* Item Total End Block *@

