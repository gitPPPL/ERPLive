    function ddlRefNo() {
        const ddl = $('#ddlRefNo');
        const vType1 = $('#ddlRefType').val();
        const vNo = $('#NumDocNo').val();

        // Optional: guard clause if values are missing
        if (!vType1 || !vNo) {
            console.warn("Missing vType or vNo");
            return;
        }
        $.ajax({
            url: '/PurchaseReturnEntry/GetddlRefNo',
            type: 'GET',
            dataType: 'json',
            data: { VNo: vNo, Vtype: vType1 },
            success: function (data) {
                // Reset Select2 if already applied
                if (ddl.hasClass("select2-hidden-accessible")) {
                    ddl.select2('destroy');
                }

                ddl.empty().append('<option value="" disabled selected hidden>-- Select Reference No --</option>');

                data.forEach(item => {
                    const displayText = `${item.text}`; // Already formatted in C#
                    ddl.append(new Option(displayText, item.value));
                });

                ddl.select2({
                    placeholder: "-- Select Reference No --",
                    allowClear: true,
                    width: '100%',
                    minimumResultsForSearch: data.length >= 5 ? 0 : Infinity,
                    language: {
                        inputTooShort: () => 'Type to search...',
                        searchInputPlaceholder: "Search Reference No..."
                    }
                });

                $('.select2-selection').addClass('form-control');
            },
            error: function (xhr, status, error) {
                console.error("Error loading reference list:", xhr.responseText);
                toastr.error('Error loading reference list: ' + error);
            }
        });
