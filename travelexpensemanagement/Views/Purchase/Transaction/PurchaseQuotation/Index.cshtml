@{
    ViewBag.Title = "Purchase Quotation";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var compCode = @ViewBag.CompCode;
    var branchCode = @ViewBag.BranchCode;
    var yearCode = @ViewBag.YearCode;
    var globalVar = ViewBag.GlobalVariables as Models.UserSessionData;
}

<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-file-invoice-dollar"></i>
        </div>
        <div class="erppage-header-title">Purchase Quotation</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "PurchaseQuotationList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="PurchaseQuotationForm">
    <input type="hidden" class="form-control" id="TxtCode" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Type</label>
                    <select class="erppage-input erppage-select" id="ddlDocType">
                        <option value="">Select Doc Type</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc No</label>
                    <input type="number" class="erppage-input" id="NumDocNo" placeholder="Enter Doc No" readonly>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-input" id="dtDocDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Status</label>
                    <select class="erppage-input erppage-required" id="ddlStatus">
                        <option value="">Select Status</option>
                    </select>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Party Name</label>
                    <select class="erppage-input erppage-required" id="txtPartyName">
                        <option value="">Select Party Name</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Cont. Person</label>
                    <input type="text" class="erppage-input" id="NumContactPerson" placeholder="Enter Contact Person" maxlength="50">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Quotation No</label>
                    <input type="text" class="erppage-input" id="txtQuotationNo" placeholder="Enter Quotation No" maxlength="50">
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Quot Date</label>
                    <input type="date" class="erppage-input" id="dtQuotDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Valid Date</label>
                    <input type="date" class="erppage-input" id="dtValidDate">
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Paym. Term</label>
                    <select class="erppage-input erppage-select erppage-required" id="ddlPaymentTerm">
                        <option value="">Select Payment Term</option>
                    </select>
                    <input type="text" class="erppage-input" id="txtPaymentTerm" />
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Freight Term</label>
                    <select class="erppage-input erppage-required" id="ddlFreightTerm">
                        <option value="Ex-Work">Ex-Work</option>
                        <option value="F.O.R-at out Plant">F.O.R-at out Plant</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Delivery Term</label>
                    <input type="text" class="erppage-input" id="txtDeliveryTerm" maxlength="250">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Group No</label>
                    <input type="number" class="erppage-input" id="NumGroupNo">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Currency</label>
                    <select class="erppage-input erppage-select" id="ddlCurrency">
                        <option value="">Select Currency</option>
                    </select>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Ex-Rate</label>
                    <input type="number" class="erppage-input" id="NumExRate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Remarks</label>
                    <input type="text" class="erppage-input" id="txtRemarks" placeholder="Enter Remarks">
                </div>
            </div>
            <div class="erppage-internalaction erppage-col-span-3" style="margin:0px;">
                <div class="dropdown erppagedropdown">
                    <button type="button" class="erppagedropdown-btn" id="CopyFrom">
                        <i class="fa fa-copy"></i>
                        <span>Copy From</span>
                    </button>
                    <button type="button" class="erppagedropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa fa-chevron-down"></i>
                    </button>
                    <ul class="dropdown-menu erppagedropdown-menu">
                        <li>
                            <a class="erppagedropdown-item" data-bs-toggle="modal" data-bs-target="#purchasequotationModal" onclick="openCopyModal('CopyFromPurchaseQuotation', '#purchasequotationModal', '#tblpurchasequotationmodal')">
                                <i class="fa-solid fa-file-invoice"></i>
                                <span>Purchase Quotation</span>
                            </a>
                        </li>
                        <li>
                            <a class="erppagedropdown-item" data-bs-toggle="modal" data-bs-target="#purchaserequestModal" onclick="openCopyModal('CopyFromPurchaseRequest', '#purchaserequestModal', '#tblpurchaserequestmodal')">
                                <i class="fa-solid fa-file-invoice"></i>
                                <span>Purchase Request</span>
                            </a>
                        </li>
                    </ul>
                </div>
                <button type="button" class="erppage-btn erppage-btn-common-disabled" id="btn-duplicate">
                    <i class="fa-solid fa-copy"></i>
                    <span>Create Duplicate</span>
                </button>
                <button type="button" class="erppage-btn erppage-btn-print" onclick="PendingQCReport1()">
                    <i class="fa-solid fa-print"></i>
                    <span>Print</span>
                </button>
            </div>
            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Item Record</legend>
                <div class="erppagelist-container">
                    <div class="excel-wrapper fixed-grid-wrapper">
                        <table id="tblPurchaseQuotationListByVno" class="excel-table fixed-grid-table resizable-table">
                            <colgroup>
                                <col style="display:none;" />
                                <col style="width:160px;" />
                                <col style="width:160px;" />
                                <col style="width:120px;" />
                                <col style="width:120px;" />
                                <col style="width:80px;" />
                                <col style="width:80px;" />
                                <col style="width:80px;" />
                                <col style="width:80px;" />
                                <col style="width:80px;" />
                                <col style="width:80px;" />
                                <col style="width:80px;" />
                                <col style="width:80px;" />
                                <col style="width:80px;" />
                                <col style="width:120px;" />
                                <col style="width:80px;" />
                                <col style="width:80px;" />
                                <col style="width:80px;" />
                                <col style="width:80px;" />
                                <col style="width:100px;" />
                                <col style="width:120px;" />
                                <col style="width:100px;" />
                                <col style="width:120px;" />
                                <col style="width:100px;" />
                                <col style="width:120px;" />
                                <col style="width:140px;" />
                                <col style="width:100px;" />
                                <col style="width:140px;" />
                                <col style="width:120px;" />
                                <col style="width:140px;" />
                                <col style="width:100px;" />
                                <col style="width:120px;" />
                                <col style="width:140px;" />
                                <col style="width:140px;" />
                                <col style="width:120px;" />
                                <col style="width:120px;" />
                                <col style="width:120px;" />
                                <col style="width:120px;" />
                                <col style="width:140px;" />
                                <col style="width:140px;" />
                                <col style="width:120px;" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th class="hidden-col">DOC_ID</th>
                                    <th>Item Code</th>
                                    <th>Make Code</th>
                                    <th>Remarks</th>
                                    <th>Unit</th>
                                    <th>Quantity</th>
                                    <th>Rate</th>
                                    <th id="thImportRate">Import Rate</th>
                                    <th>Amount</th>
                                    <th>Pack %</th>
                                    <th>Pack Amount</th>
                                    <th>Discount %</th>
                                    <th>Discount Amount</th>
                                    <th>Freight</th>
                                    <th>Tax Code</th>
                                    <th>CGST %</th>
                                    <th>CGST Amount</th>
                                    <th>SGST %</th>
                                    <th>SGST Amount</th>
                                    <th>IGST %</th>
                                    <th>IGST Amount</th>
                                    <th>VAT %</th>
                                    <th>VAT Amount</th>
                                    <th>CESS %</th>
                                    <th>CESS Amount</th>
                                    <th>Other Expenses</th>
                                    <th>LD Rate</th>
                                    <th>Net Amount</th>
                                    <th>Warranty</th>
                                    <th>Lead Time (Days)</th>
                                    <th>Bulk Qty</th>
                                    <th>Bulk Rate</th>
                                    <th>Bulk Discount %</th>
                                    <th>Bulk Discount Amt</th>
                                    <th>Rate Monthly</th>
                                    <th>Rate Quarterly</th>
                                    <th>Rate Annually</th>
                                    <th>Rate Special</th>
                                    <th>Request Type</th>
                                    <th>Request No</th>
                                    <th class="action-col">Action</th>
                                </tr>
                            </thead>

                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </fieldset>
            <fieldset class="erppagefieldset">
                <div class="erppage-grid5">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Quantity</label>
                        <input type="number" class="erppage-input" id="numQuantityIT" placeholder="Enter Quantity" readonly>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Amount</label>
                        <input type="number" class="erppage-input" id="numAmountIT" placeholder="Enter Amount" readonly>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Pack Amt</label>
                        <input type="number" class="erppage-input" id="numPackAmtIT" placeholder="Enter Pack Amt" readonly>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Disc Amt</label>
                        <input type="number" class="erppage-input" id="numDiscAmtIT" placeholder="Enter Disc Amt" readonly>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Freight</label>
                        <input type="number" class="erppage-input" id="numFreightIT" placeholder="Enter Freight" readonly>
                    </div>
                </div>
                <div class="erppage-grid5">
                    <div class="erppage-divfield">
                        <label class="erppage-label">CGST Amt</label>
                        <input type="number" class="erppage-input" id="numCGSTAmtIT" placeholder="Enter CGST Amt" readonly>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">SGST Amt</label>
                        <input type="number" class="erppage-input" id="numSGSTAmtIT" placeholder="Enter SGST Amt" readonly>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">IGST Amt</label>
                        <input type="number" class="erppage-input" id="numIGSTAmtIT" placeholder="Enter IGST Amt" readonly>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Cess Amt</label>
                        <input type="number" class="erppage-input" id="numCessAmtIT" placeholder="Enter Cess Amt" readonly>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">VAT Amt</label>
                        <input type="number" class="erppage-input" id="numVATAmtIT" placeholder="Enter VAT Amt" readonly>
                    </div>
                </div>
                <div class="erppage-grid5">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Other Amt</label>
                        <input type="number" class="erppage-input" id="numOtherAmtIT" placeholder="Enter Other Amt" readonly>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Net Amt</label>
                        <input type="number" class="erppage-input" id="numNetAmtIT" placeholder="Enter Net Amount" readonly>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Bulk Qty</label>
                        <input type="number" class="erppage-input" id="numBulkQtyIT" placeholder="Enter Bulk Qty">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">B. Disc Amt</label>
                        <input type="number" class="erppage-input" id="numBulkDiscAmtIT" placeholder="Enter Bulk Disc Amt">
                    </div>
                </div>
            </fieldset>
            <fieldset class="erppagefieldset">
                    <legend class="erppagefieldset-legend">Attachment</legend>
                    <div class="erppageattachmentsection">
                        <div class="erppageattachmentsectionrow">
                            <div class="erppageattachmentsectioncol">
                                <div class="erppageattachmentsectionuploadcard">
                                    <h2 class="erppageattachmentsectiontitle">UPLOAD MULTIPLE FILES</h2>
                                    <div class="erppageattachmentsectiondropzone" id="dropZone">
                                        <div class="erppageattachmentsectioncloud">
                                            ☁
                                        </div>
                                        <div class="erppageattachmentsectiondragtext">
                                            Drag & Drop your files here
                                        </div>
                                        <div class="erppageattachmentsectionor">
                                            OR
                                        </div>
                                        <button type="button" class="erppageattachmentsectionbrowsebtn" id="browseBtn">
                                            Browse Files
                                        </button>
                                        <input type="file" id="fileInput" multiple hidden>
                                    </div>
                                </div>
                            </div>
                            <div class="erppageattachmentsectioncol">
                                <div class="erppageattachmentsectionfilecard">
                                    <div class="erppageattachmentsectionheader">
                                        Uploaded Files
                                    </div>
                                    <div class="erppageattachmentsectionfilelist"
                                         id="fileList">
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>
                </fieldset>

        </fieldset>
        <div class="erppage-actions">
            <button type="button" class="erppage-btn erppage-btn-common" onclick="PendingQCReport()">
                <i class="fa-solid fa-print"></i>
                <span>Print</span>
            </button>
            <button id="btn-save" type="button" class="erppage-btn erppage-btn-save">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>
        </div>
    </div>
</div>
