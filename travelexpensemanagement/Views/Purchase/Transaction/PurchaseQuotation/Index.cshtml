@{
    ViewBag.Title = "Purchase Quotation";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var compCode = @ViewBag.CompCode;
    var branchCode = @ViewBag.BranchCode;
    var yearCode = @ViewBag.YearCode;
}

<style>
    #tblPurchaseQuotationListByVno {
        width: 100%;
        border-collapse: collapse;
    }

    #tblPurchaseQuotationListByVno tbody tr:hover {
        background-color: #f0f8ff; /* Light blue hover */
    } 

    #tblPurchaseQuotationListByVno td,
    #tblPurchaseQuotationListByVno th {
        padding: 3px 8px;
        vertical-align: top;
        border: 1px solid #ddd;
        min-width: 100px; /* Added minimum width */
        max-width: 150px;
        overflow: hidden; 
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    #tblPurchaseQuotationListByVno input,
    #tblPurchaseQuotationListByVno select,
    #tblPurchaseQuotationListByVno label.form-control-sm {
        min-width: 100px; /* Add this */
        max-width: 150px;
        width: 100%;
        padding: 2px 4px;
        font-size: 12px;
        border: 1px solid #ccc;
        border-radius: 4px;
        box-sizing: border-box;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    #tblPurchaseQuotationListByVno input:read-only {
        background-color: #f9f9f9;
        color: #555;
    }

    #tblPurchaseQuotationListByVno label.form-control-sm {
        display: inline-block;
        width: 100%;
        max-width: 150px; /* Increased width */
        padding: 2px 4px; /* Reduced padding */
        font-size: 12px;
        line-height: 1.5;
        color: #555;
        background-color: #f9f9f9;
        border: 1px solid #ccc;
        border-radius: 4px;
        box-sizing: border-box;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        cursor: default;
    }

    #tblPurchaseQuotationListByVno td:last-child i {
        cursor: pointer;
        margin: 0 4px;
        color: #007bff;
    }

    #tblPurchaseQuotationListByVno td:last-child i:hover {
        color: #0056b3;
    }

</style>


