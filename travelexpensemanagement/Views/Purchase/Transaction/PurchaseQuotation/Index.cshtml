<script>
    // Global Variable getting from controller
    var compCode = '@ViewBag.CompCode';
    var branchCode = '@ViewBag.BranchCode';
    var yearCode = '@ViewBag.YearCode';

    let rowsData = [];
    let rowsAttachment = [];

    let rowIndex = 0;

    //To replace id with Names.
    let docTypeMap = {};
    let partyMap = {};
    let statusMap = {};
    let paymentTermMap = {};
    let freightTermMap = {};
    let taxCodeMap = {};
    let itemMakeMap = {};
    let uomMap = {};

    //For pagination
    let currentPage = 1;
    const pageSize = 10;

    //getting
    const urlParams = new URLSearchParams(location.search);
    const rowId = parseInt(urlParams.get('id'));
    const isReadOnly = urlParams.get('readOnly') === 'true';

    let currentDocCode = 'STQT';


    $(document).ready(function () {
        const today = new Date().toISOString().split('T')[0]; // Format: YYYY-MM-DD
        $('#dtDocDate').val(today);
        freightTermMap = {
            "Ex-Work": "Ex-Work",
            "F.O.R-at out Plant": "F.O.R-at out Plant",
        };

        if (!isNaN(rowId) && rowId > 0) {
            loadFullQuotationByVno(rowId, currentDocCode);
            if (isReadOnly) {
                // setQCDiscMasterFormReadOnly();
            }
             loadItemList(),
             loadItemMakeList(),
             loadUOMList(),
             loadTaxCodeList()
        } else {
            $.when(
                loadItemList(),
                loadItemMakeList(),
                loadUOMList(),
                loadTaxCodeList()
            ).then(function () {
                addNewRowBelow();
            });
        }
        loadNextDocNo(yearCode);
        loadDocTypeList();
        loadPartyList();
        loadPaymentTermList();
        loadStatusList();
    });


    function loadNextDocNo(yearC){
        $.ajax({
            url: '/PurchaseQuotation/GetNextV_NO',
            type: 'GET',
            data: { yearCode : yearC },
            success: function (response) {
                $('#NumDocNo').val(response).attr('disabled',true);
            },
            error: function (xhr, status, error) {
                toastr.error('Error loading Item make: ' + error);
            }
        });
    }
    function loadDocTypeList() {
        docTypeMap = {};
        return $.ajax({
            url: '/PurchaseQuotation/GetDocTypeList',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var ddl = $('#ddlDocType');
                ddl.empty();
                ddl.append('<option value="">-- Select Doc Type --</option>');

                $.each(data, function (index, item) {
                    ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                    docTypeMap[item.value] = item.text;
                });
            },
            error: function (xhr, status, error) {
                toastr.error('Error loading DocType list: ' + error);
            }
        });
    }
    function loadPartyList(updateDropdown = true) {
        return $.ajax({
            url: '/PurchaseQuotation/GetPartyList',
            type: 'GET',
            dataType: 'json',
        }).then(function (data) {
            const map = {};
            if (updateDropdown) {
                const ddl = $('#txtPartyName');
                ddl.empty();
                ddl.append('<option value="">-- Select Party --</option>');
                data.forEach(item => {
                    ddl.append(`<option value="${item.value}">${item.text}</option>`);
                    map[item.value] = item.text;
                });
            } else {
                data.forEach(item => {
                    map[item.value] = item.text;
                });
            }
            return map;
        }).catch(function (xhr, status, error) {
            toastr.error('Error loading Party list: ' + error);
            return {}; // Return empty map on error
        });
    }
    // function loadStatusList() {
    //     statusMap = {};
    //     return $.ajax({
    //         url: '/PurchaseQuotation/GetStatusList',
    //         type: 'GET',
    //         dataType: 'json',
    //         success: function (data) {
    //             var ddl = $('#ddlStatus');
    //             ddl.empty();
    //             ddl.append('<option value="">-- Select Status --</option>');

    //             $.each(data, function (index, item) {
    //                 ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
    //                 statusMap[item.value] = item.text;
    //             });
    //         },
    //         error: function (xhr, status, error) {
    //             toastr.error('Error loading Status list: ' + error);
    //         }
    //     });
    // }
    function loadStatusList() {
        statusMap = {};
        return $.ajax({
            url: '/PurchaseQuotation/GetStatusList',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var ddl = $('#ddlStatus');
                ddl.empty();
                ddl.append('<option value="">-- Select Status --</option>');

                let openStatusValue = null;

                $.each(data, function (index, item) {
                    ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                    statusMap[item.value] = item.text;

                    if (item.text.trim().toLowerCase() === 'open') {
                        openStatusValue = item.value;
                    }
                });

                // Set "Open" as selected if found
                if (openStatusValue !== null) {
                    ddl.val(openStatusValue);
                }
            },
            error: function (xhr, status, error) {
                toastr.error('Error loading Status list: ' + error);
            }
        });
    }

    function loadPaymentTermList() {
        paymentTermMap = {};
        return $.ajax({
            url: '/PurchaseQuotation/GetPaymentTermList',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var ddl = $('#ddlPaymentTerm');
                ddl.empty();
                ddl.append('<option value="">-- Select Payment Terms --</option>');


                $.each(data, function (index, item) {
                    ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                    paymentTermMap[item.value] = item.text;
                });
            },
            error: function (xhr, status, error) {
                toastr.error('Error loading Payment Term list: ' + error);
            }
        });
    }
    function loadItemList() {
        return $.ajax({
            url: '/PurchaseQuotation/GetItemList',
            type: 'GET',
            dataType: 'json',
        }).then(function (data) {
            const map = {};
            data.forEach(item => {
                map[item.value] = item.text;
            });
            return map;
        }).catch(function (xhr, status, error) {
            toastr.error('Error loading Item list: ' + error);
            return {};
        });
    }
    function loadItemMakeList() {
        return $.ajax({
            url: '/PurchaseQuotation/GetItemMakeList',
            type: 'GET',
            dataType: 'json',
        }).then(function (data) {
            const map = {};
            data.forEach(item => {
                map[item.value] = item.text;
            });
            return map;
        }).catch(function (xhr, status, error) {
            toastr.error('Error loading Item Make list: ' + error);
            return {};
        });
    }

    // When item is selected, load corresponding item makes
    $(document).on('change', 'select[id^="itemName_"]', function () {
        const $row = $(this).closest('tr');
        const rowId = this.id.split('_')[1];
        const selectedItemCode = $(this).val();

        const $makeDropdown = $(`#itemMake_${rowId}`);
        $makeDropdown.empty().append('<option value="">-- Select Item Make --</option>');

        if (!selectedItemCode) return;

        $.ajax({
            url: '/PurchaseQuotation/GetMakeItemsByItemCode',
            type: 'GET',
            data: { itemCode: selectedItemCode },
            success: function (response) {
                if (response.success && Array.isArray(response.data)) {
                    response.data.forEach(item => {
                        $makeDropdown.append(`<option value="${item.makeCode}">${item.name}</option>`);
                    });
                } else {
                    toastr.warning('No makes found for this item.');
                }
            },
            error: function (xhr, status, error) {
                toastr.error('Error loading item make list: ' + error);
            }
        });
    });


    function loadUOMList() {
        return $.ajax({
            url: '/PurchaseQuotation/GetUOMList',
            type: 'GET',
            dataType: 'json',
        }).then(function (data) {
            const map = {};
            data.forEach(item => {
                map[item.value] = item.text;
            });
            return map;
        }).catch(function (xhr, status, error) {
            toastr.error('Error loading UOM list: ' + error);
            return {};
        });
    }
    function loadTaxCodeList() {
        return $.ajax({
            url: '/PurchaseQuotation/GetTextCodeList',
            type: 'GET',
            dataType: 'json'
        }).then(function (data) {
            const taxCodeMap = {};
            data.forEach(item => {
                taxCodeMap[item.value] = item.text;
            });
            return taxCodeMap; // ✅ returning map here is crucial
        }).catch(function (xhr, status, error) {
            toastr.error('Error loading Tax Code list: ' + error);
            return {};
        });
    }


    $('#ddlItemName').on('change',function(){
        var itemCode= $(this).val();
        $.ajax({
            url: '/PurchaseQuotation/GetMakeItemByItemCode',
            type: 'GET',
            data: { itemCode: itemCode },
