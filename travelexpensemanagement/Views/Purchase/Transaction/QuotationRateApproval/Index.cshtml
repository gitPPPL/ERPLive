    async function getAttachmentDetails() {
        const attachments = [];

        const rows = $('#tblAttachmentQR tbody tr').toArray();
        for (const row of rows) {
            const $row = $(row);
            const fileNameInput = $row.find('.file-name-input').val()?.trim() || null;
            const fileInput = $row.find('.file-input')[0];
            const file = fileInput?.files[0];

            if (!file && !fileNameInput) continue;

            let base64String = null;

            if (file) {
                base64String = await toBase64(file);
            }

            attachments.push({
                fileName: fileNameInput || file?.name || null,
                fileSize: file?.size || null,
                fileType: file?.type || null,
                filePath: file ? `/uploads/${file.name}` : null,
                fileContentBase64: base64String // ✅ add this field
            });
        }

        return attachments;
    }

    function toBase64(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(reader.result.split(',')[1]);
            reader.onerror = reject;
            reader.readAsDataURL(file);
        });
    }

