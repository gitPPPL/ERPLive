<script>
    // Global Variable getting from controller
    var compCode = '@ViewBag.CompCode';
    var branchCode = '@ViewBag.BranchCode';
    var yearCode = '@ViewBag.YearCode';

    const urlParams = new URLSearchParams(location.search);
    const rowId = parseInt(urlParams.get('id'));
    const isReadOnly = urlParams.get('readOnly') === 'true';

    $(document).ready(function () {
        if (!isNaN(rowId) && rowId > 0) {
            // loadFullQuotationByVno(rowId, currentDocCode);
            //if (isReadOnly) {
            //    // setQCDiscMasterFormReadOnly();
            //}
        }
        loadNextDocNo(yearCode);
        loadDocTypeList();
        loadStatusList();
        loadPOList(compCode,yearCode,branchCode);
        loadBilltoList(compCode);
        loadShiptoList(compCode);
    });

    function loadNextDocNo(yearC){
        $.ajax({
            url: '/PurchaseBillPassEntryDirect/GetNextV_NO',
            type: 'GET',
            data: { yearCode : yearC },
            success: function (response) {
                $('#NumDocNo').val(response).attr('disabled',true);
            },
            error: function (xhr, status, error) {
                toastr.error('Error loading Item make: ' + error);
            }
        });
    }
    function loadDocTypeList() {
        docTypeMap = {};
        return $.ajax({
            url: '/PurchaseBillPassEntryDirect/GetDocTypeList',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var ddl = $('#ddlDocType');
                ddl.empty();
                ddl.append('<option value="">-- Select Doc Type --</option>');

                $.each(data, function (index, item) {
                    ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                    docTypeMap[item.value] = item.text;
                });
            },
            error: function (xhr, status, error) {
                toastr.error('Error loading DocType list: ' + error);
            }
        });
    }
    function loadStatusList() {
        statusMap = {};
        return $.ajax({
            url: '/PurchaseBillPassEntryDirect/GetStatusList',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var ddl = $('#ddlStatus');
                ddl.empty();
                ddl.append('<option value="">-- Select Status --</option>');

                $.each(data, function (index, item) {
                    ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                    statusMap[item.value] = item.text;
                });
            },
            error: function (xhr, status, error) {
                toastr.error('Error loading Status list: ' + error);
            }
        });
    }
    function loadPOList(CCode,YCode,BCode) {
        statusMap = {};
        return $.ajax({
            url: '/PurchaseBillPassEntryDirect/GetPoList',
            type: 'GET',
            dataType: 'json',
            data: { cCode: CCode, yCode: YCode, bCode: BCode },
            success: function (data) {
                var ddl = $('#ddlPONo');
                ddl.empty();
                ddl.append('<option value="">-- Select PO Num--</option>');

                $.each(data, function (index, item) {
                    ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                    statusMap[item.value] = item.text;
                });
            },
            error: function (xhr, status, error) {
                toastr.error('Error loading Status list: ' + error);
            }
        });
    }
    function loadBilltoList(CCode) {
        return $.ajax({
            url: '/PurchaseBillPassEntryDirect/GetBillToList',
            type: 'GET',
            dataType: 'json',
            data: { cCode: CCode},
        }).then(function (data) {
            const map = {};
                const ddl = $('#ddlBillFrom');
                ddl.empty();
                ddl.append('<option value="">-- Select Party --</option>');
                data.forEach(item => {
                    ddl.append(`<option value="${item.value}">${item.text}</option>`);
                });

            return map;
        }).catch(function (xhr, status, error) {
            toastr.error('Error loading Party list: ' + error);
            return {}; // Return empty map on error
        });
    }
    function loadShiptoList(CCode) {
        return $.ajax({
            url: '/PurchaseBillPassEntryDirect/GetShipToList',
            type: 'GET',
            dataType: 'json',
            data: { cCode: CCode},
        }).then(function (data) {
            const map = {};
                const ddl = $('#ddlShipFrom');
                ddl.empty();
                ddl.append('<option value="">-- Select Party --</option>');
                data.forEach(item => {
                    ddl.append(`<option value="${item.value}">${item.text}</option>`);
                });

            return map;
        }).catch(function (xhr, status, error) {
            toastr.error('Error loading Party list: ' + error);
            return {}; // Return empty map on error
        });
    }

    $('#ddlBillFrom').change(function(){
        var selectedVal = $(this).val();
        $.ajax({
            url: '/PurchaseBillPassEntryDirect/GetTransitNoByParty',
            type: 'GET',
            data: { cCode: compCode, yCode: yearCode,bCode: branchCode,pCode: selectedVal },
            success: function (res) {
                var ddl = $('#ddlTransitNo');
                ddl.empty();
                ddl.append('<option value="">-- Transit No --</option>');
                $.each(res, function (index, item) {
                    ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                });
                loadAddressListByBillTo(compCode,selectedVal);
            },
            error: function (xhr, status, error) {
                toastr.error('Error loading Item make: ' + error);
            }
        });
    })
    function loadAddressListByBillTo(CCode,PCode){
        $('#TxtAdd1PD').data('pcode',PCode);
        $.ajax({
            url: '/PurchaseBillPassEntryDirect/GetAddressListByBillToParty',
            type: 'GET',
            data: { cCode: CCode,pCode: PCode },
            success: function (res) {
                var ddl = $('#TxtAdd1PD');
                ddl.empty();
                ddl.append('<option value="">-- Select Bill to Address--</option>');
                $.each(res, function (index, item) {
                    ddl.append('<option value="' + item.value + '">' + item.text + '</option>');
                });
            },
            error: function (xhr, status, error) {
                toastr.error('Error loading Item make: ' + error);
            }
        });
    }
    $('#TxtAdd1PD').change(function(){
        var selectedVal = $(this).val();
        var selectedtxt = $(this).text();
        var PCode = $(this).data('pcode');
        alert(PCode);

        $.ajax({
            url: '/PurchaseBillPassEntryDirect/GetAddressByBillToParty',
            type: 'GET',
            data: { cCode: compCode,pCode: PCode,addressId: selectedVal},
            success: function (res) {
                console.log(res);

            },
            error: function (xhr, status, error) {
                toastr.error('Error loading Item make: ' + error);
            }
        });
    })
</script>
