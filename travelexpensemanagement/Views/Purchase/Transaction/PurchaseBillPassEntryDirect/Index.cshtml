<script>
    $(function () {

        //==========================
        // COMMON UTILITY FUNCTION
        //==========================
        function reassignPlusIcon($tbody) {
            const $last = $tbody.find('tr:last td:last');
            if ($last.find('.btn-add-action').length === 0) {
                $last.prepend('<i class="fa fa-plus btn-add-action" title="Add Row"></i>');
            }
        }

        //==========================
        // COST ALLOCATION MODAL
        //==========================
        function addRowToCostAllocationTable(data = {}) {
            const $tbody = $('#tblpurchaseallocationmodal tbody');
            $tbody.find('.btn-add-action').remove(); // Only last row gets add icon

            const row = `
                <tr class="no-border-input">
                    <td style="display:none;"><input type="checkbox" class="row-select" /></td>
                    <td><input type="text" class="form-control" placeholder="Enter Cost Center" value="${data.costCenter || ''}"></td>
                    <td><input type="number" class="form-control" placeholder="Enter Allocated Amt" value="${data.allocatedAmt || ''}"></td>
                    <td><input type="text" class="form-control" placeholder="Enter Narration" value="${data.narration || ''}"></td>
                    <td style="display:none;">
                        <i class="fa fa-plus btn-add-action" title="Add Row"></i>
                        <i class="fa fa-trash btn-delete-action" title="Delete Row"></i>
                    </td>
                </tr>`;
            $tbody.append(row);
            reassignPlusIcon($tbody);
        }

        $('#selectAllPR').on('change', function () {
            const checked = $(this).is(':checked');
            $('#tblpurchaseallocationmodal tbody .row-select').prop('checked', checked);
        });

        //==========================
        // ATTACHMENT TAB (TAB 5)
        //==========================
        function addRowToAttachmentTable(data = {}) {
            const $tbody = $('#tblAttachmentPBPE tbody');
            $tbody.find('.btn-add-action').remove();

            const row = `
                <tr class="no-border-input">
                    <td style="display:none;">${data.code || ''}</td>
                    <td><input type="text" class="form-control mb-1" value="${data.fileName || ''}" placeholder="Enter file name"/></td>
                    <td><input type="file" class="form-control file-upload" /></td>
                    <td><input type="" class="form-control" accept="image/*" /></td>
                    <td>
                        <i class="fa fa-plus btn-add-action" title="Add Row"></i>
                        <i class="fa fa-edit btn-edit-action" title="Edit Row"></i>
                        <i class="fa fa-trash btn-delete-action" title="Delete Row"></i>
                    </td>
                </tr>`;
            $tbody.append(row);
        }

        $('#saveAttachmentBtn').on('click', function () {
            const formData = new FormData();
            const $tbody = $('#tblAttachmentPBPE tbody');

            $tbody.find('tr').each(function (i) {
                const $td = $(this).find('td');
                const name = $td.eq(1).find('input').val();
                const file = $td.eq(2).find('input')[0].files[0];

                formData.append(`Attachments[${i}].FileName`, name);
                if (file) formData.append(`Attachments[${i}].File`, file);
            });

            $.ajax({
                url: '/PurchaseBillPassEntry/UploadAttachments',
                method: 'POST',
                processData: false,
                contentType: false,
                data: formData,
                success: () => alert("Attachments uploaded successfully!"),
                error: (xhr) => alert("Upload failed: " + xhr.responseText)
            });
        });

        //==========================
        // ITEM RECORD TAB (TAB 1)
        //==========================
        function addRowToItemTable(data = {}) {
            const $tbody = $('#tblItemRecordPBPED tbody');
            $tbody.find('.btn-add-action').remove();

            const row = `
                <tr class="no-border-input">
                    <td style="display:none;">${data.code || ''}</td>
                    <td><input type="text" class="form-control" placeholder="Item Name"></td>
                    <td><input type="text" class="form-control" placeholder="HSN Code"></td>
