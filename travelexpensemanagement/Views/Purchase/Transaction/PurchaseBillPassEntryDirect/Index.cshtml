            addRowToAttachmentTable();
        }

        // Case 3: Tab 1 - Item Record
        else if ($tab.attr('id') === 'tab1') {
            addRowToItemTable();
        }
        });


        // Delete Row for all tables
        $(document).on('click', '.btn-delete-action', function () {
            const $row = $(this).closest('tr');
            const $tbody = $row.closest('tbody');
            $row.remove();
            reassignPlusIcon($tbody);
        });

    });
</script>
