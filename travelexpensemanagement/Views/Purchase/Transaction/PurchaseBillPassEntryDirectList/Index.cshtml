@{
	ViewBag.Title = "Purchase Bill Pass Entry Direct List";
	Layout = "~/Views/Shared/_Layout.cshtml";

}

<fieldset>
	<legend class="legend-field">Purchase Bill Pass Entry Direct List</legend>
	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>
		<div class="col-lg-6">
			<div class="btn-rightalign">
				<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "PurchaseBillPassEntryDirect")'" type="submit" class="btn btn-add">
					<i class="fa fa-plus"></i>Add
				</button>
				<button class="btn btn-print" onclick="printCityMasterReport()">
					<i class="fa fa-print"></i> Print
				</button>
				<button class="btn btn-export">
					<i class="fas fa-file-export"></i> Export
				</button>
				<button class="btn btn-mail">
					<i class="fa fa-envelope"></i> Mail 
				</button>
				<button class="btn btn-approved">
					<i class="fa fa-check"></i> Approved
				</button>
			</div>
		</div>
	</div>
	<div class="card">
		<div class="table-responsive">
			<table id="tblPurchaseBillPassEntryDirect" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>Vno</th>
						<th>Vtype</th>
						<th>Vdate</th>
						<th>Party Name</th>
						<th>Ship To</th>
						<th>Debit A/C</th>
						<th>Credit A/C</th>
						<th>Bill_Qty</th>
						<th>Net Amt</th>
						<th>Ref_Type</th>
						<th>Ref_No</th>
						<th>Bill No</th>
						<th>Bill Date</th>
						<th>Challan No</th>
						<th>Challan Date</th>
						<th>Dr From Trpt</th>
						<th>Remarks</th>
						<th>Status</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
	</div>
</fieldset>

<script>

	let currentPage = 1;
	let pageSize = 10;

	$(document).ready(function () {
		loadPurchaseBillDirectStages();

		$('#searchBox').on('keyup', function () {
			currentPage = 1;
			loadPurchaseBillDirectStages();
		});
	});

	//Load main grid...............
	function loadPurchaseBillDirectStages() {
		const searchTerm = $('#searchBox').val();

		$.ajax({
			url: '/PurchaseBillPassEntryDirectList/GetAllPurchaseBillPassEntryDirect',
			type: 'GET',
			dataType: 'json',
			data: {
				searchTerm,
				pageNumber: currentPage,
				pageSize: pageSize
			},
			success: function (res) {
				console.log(res);
				const docs = res.purchaseBillDirect || res.purchaseBillDirect || [];
				const totalCount = res.totalCount || 0;

				const tbody = $('#tblPurchaseBillPassEntryDirect tbody');
				tbody.empty();

				if (docs.length === 0) {
					tbody.append(`<tr><td colspan="19" class="text-center text-muted">No records found.</td></tr>`);
					renderPagination(0, pageSize, currentPage);
					return;
				}

				docs.forEach(doc => {
					tbody.append(`
						<tr>
							<td style="display:none;">${doc.code || doc.doC_CODE || ''}</td>
							<td>${doc.v_NO || ''}</td>
							<td>${doc.v_TYPE || ''}</td>
							<td>${doc.v_DATE || '0'}</td>
							<td>${doc.partY_NAME || ''}</td>
							<td>${doc.shiP_ADD1 || ''}</td>
							<td>${doc.debiT_AC || '0'}</td>
							<td>${doc.crediT_AC || ''}</td>
							<td>${doc.bilL_QTY || ''}</td>
							<td>${doc.amount || '0'}</td>
							<td>${doc.reF_TYPE || ''}</td>
							<td>${doc.reF_NO || ''}</td>
							<td>${doc.bilL_NO || '0'}</td>
							<td>${doc.bilL_DATE || ''}</td>
							<td>${doc.chalL_NO || ''}</td>
							<td>${doc.chalL_DATE || '0'}</td>
							<td>${doc.dR_FROM_TPT || '0'}</td>
							<td>${doc.remarks || '0'}</td>
							<td>${doc.status || '0'}</td>
							<td>
							  <div class="action-icons">
							  <i class="fa fa-edit btn-edit" data-bs-toggle="tooltip" title="Edit" onclick="editDocStage('${doc.v_NO}')"></i>
							  <i class="fas fa-eye btn-view" data-bs-toggle="tooltip" title="View" onclick="viewDocStage('${doc.v_NO}')"></i>
							  <i class="fas fa-trash btn-delete" data-bs-toggle="tooltip" title="Delete" onclick="deleteDocStage('${doc.v_NO}')"></i>
							   <i class="fa fa-file btn-document" data-bs-toggle="tooltip" data-bs-title="Document Details" onclick="showDocumentPopup('${doc.v_NO}')"></i>
							  </div>

							</td>
						</tr>
					`);
				});

				renderPagination(totalCount, pageSize, currentPage);
			},
			error: function (xhr) {
				toastr.error('Error loading document stages: ' + (xhr.responseJSON?.message || xhr.statusText));
			}
		});
	}

	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const pagination = $('#tablePagination');
		pagination.empty();

		if (totalPages <= 1) return;

		let html = '';

		if (currentPage > 1) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		const startPage = Math.max(1, currentPage - 2);
		const endPage = Math.min(totalPages, currentPage + 2);

		for (let i = startPage; i <= endPage; i++) {
			html += `
				<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
		}

		if (currentPage < totalPages) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		pagination.html(html);
	}

	function goToPage(page) {
		currentPage = page;
		loadDocumentStages();
	}

	function editDocStage(docCode) {
		window.location.href = `/ApprovalStageMaster/Index?docCode=${encodeURIComponent(docCode)}`;
	}

	function viewDocStage(docCode) {
		window.location.href = `/ApprovalStageMaster/Index?docCode=${encodeURIComponent(docCode)}&readOnly=true`;
	}

	function deleteDocStage(docCode) {
		Swal.fire({
			title: 'Are you sure?',
			text: "You won't be able to revert this deletion!",
			icon: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#d33',
			cancelButtonColor: '#3085d6',
			confirmButtonText: 'Yes, delete it!'
		}).then((result) => {
			if (result.isConfirmed) {
				$.ajax({
					url: '/ApprovalStageMasterList/DeleteDocByCode',
					type: 'POST',
					data: { docCode: docCode },
					success: function (response) {
						if (response.success) {
							toastr.success(response.message || "Record deleted successfully.");
							loadDocumentStages();
						} else {
							toastr.warning("Delete failed.");
						}
					},
					error: function () {
						toastr.error("An error occurred while deleting.");
					}
				});
			}
		});
	}


</script>
