@{
	ViewBag.Title = "Account General Master List";
	Layout = "~/Views/Shared/_Layout.cshtml";
    var currentMenu = ViewBag.CurrentMenu as string;
    bool canAdd = false;
    bool canEdit = false;
    bool canDelete = false;
    bool canPrint = false;
    bool canExport = false;
    bool canMail = false;
    bool canApproval = false;
    bool canDocDetail = false;

    foreach (var permission in Model.UserMenuPermissions)
    {
        if (permission.DISPLAY_NAME == ViewBag.CurrentMenu)
        {
            canAdd = Model.UserLevel == 1 || permission._ADD == 1;
            canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
            canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
            canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
            canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
            canMail = Model.UserLevel == 1 || permission._MAIL == 1;
            canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
            canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
            break;  // Exit loop once found current menu permission
        }
    }
}
<fieldset>
	<legend>Account General Master List</legend>

	<div class="row">
		<div class="col-lg-3">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control border-0" placeholder="Search Module..." aria-label="Search term">

			</div>
		</div>


        <div class="col-lg-9">
            <div class="btn-rightalign">
                @if (canAdd)
                {
                    <button id="btnSave" onclick="window.location.href='@Url.Action("Index", "AccountGeneralMaster")'" type="submit" class="btn btn-primary">
                        <i class="fa fa-plus"></i>Add
                    </button>
                }
                @if (canPrint)
                {
                    <button class="btn btn-print" onclick="callGetReportAsPdf()">
                        <i class="fa fa-print"></i> Print
                    </button>
                }
                @if (canExport)
                {
                    <button class="btn btn-export" onclick="exportToExcel()">
                        <i class="fas fa-file-export"></i> Export
                    </button>
                }
                @if (canMail)
                {
                    <button class="btn btn-info">
                        <i class="fa fa-envelope"></i> Mail
                    </button>
                }
                @if (canApproval)
                {
                    <button class="btn btn-export" onclick="Approval()">
                        <i class="fas fa-file-export"></i> Export
                    </button>
                }
            </div>
        </div>

    </div>

	<div class="card shadow-sm border-0 mt-1">
		<div class="table-responsive">
			<table id="" class="table-width">
				<thead class="table-head">
					<tr>
						<th>Code</th>
						<th>Name</th>
						<th>Short Name</th>
						<th>Group</th>
						<th>Nature</th>
						<th>Active</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>

		<!-- Pagination container -->
		<div class="row p-3">
			<div class="col-md-12 d-flex justify-content-center" id="tablePagination"></div>
		</div>
	</div>
</fieldset>
<script>
     var canAdd = @canAdd.ToString().ToLower();
    var canEdit = @canEdit.ToString().ToLower();
    var canDelete = @canDelete.ToString().ToLower();
    var canPrint = @canPrint.ToString().ToLower();
    var canExport = @canExport.ToString().ToLower();
    var canMail = @canMail.ToString().ToLower();
    var canApproval = @canApproval.ToString().ToLower();
    var canDocDetail = @canDocDetail.ToString().ToLower();

    let currentPage = 1;
    let pageSize = 10;
    let groupMap = {};

    $(document).ready(function () {
        loadAllSubgroups();
        loadGroupList();
    });

    function loadGroupList() {
        $.ajax({
            url: '/AccountGeneralMaster/GetGroupList',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var ddl = $('#GROUP_NAME');
                ddl.empty();
                ddl.append('<option value="">-- Select User --</option>');

                $.each(data, function (index, item) {
                    ddl.append('<option value="' + item.value + '">' + item.text + ' </option>');
                    groupMap[item.value] = item.text;                
                });
            },
            error: function (xhr, status, error) {
                console.error("Error loading module: ", xhr.responseText);
                toastr.error('Error loading module: ' + error);
            }
        });
    }

    function loadAllSubgroups() {
        const searchTerm = $('#searchBox').val();
        $.ajax({
            url: '/AccountGeneralMasterList/GetSubgroups',  
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                console.log(res);
                const lists = res.lists;
                const totalCount = res.totalCount;

                let tbody = $('table tbody');
                tbody.empty();

                if (!lists || lists.length === 0) {
                    tbody.append('<tr><td colspan="7" class="text-center text-muted">No records found.</td></tr>');
                    renderPagination(0, pageSize, currentPage);
                    return;
                }
                $.each(lists, function (index, item) {
                    tbody.append(`
                        <tr>
                            <td>${item.code}</td>
                            <td>${item.name || ''}</td>
                            <td>${item.shortname || ''}</td>
                            <td>${groupMap[item.grouP_CODE] || item.grouP_CODE || ''}</td>
                            <td>${item.nature || ''}</td>
                            <td>${item.active ? 'Yes' : 'No'}</td>
                            <td>
                                ${canEdit ? `<i class="fas fa-edit text-primary btn-edit" data-doc="${item.code}" title="Edit" style="cursor:pointer;"></i>` : ''}
                                <i class="fas fa-eye text-secondary btn-view" data-doc="${item.code}" title="View" style="cursor:pointer;"></i>
                                ${canDelete ? `<i class="fas fa-trash text-danger btn-delete" data-doc="${item.code}" title="Delete" style="cursor:pointer;"></i>` : ''}
                                ${canDocDetail ? `<i class="fa fa-file btn-details text-info" data-doc="${item.code}" title="Details" style="cursor:pointer;"></i>` : ''}
                              ${item.code ? `<i class="fa fa-check text-success btn-approve" data-doc="${item.code}" title="Approve" style="cursor:pointer;font-size:18px;"></i>` : ''}                      </td>
                        </tr>
                    `);
                });

                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                alert('Error loading data: ' + xhr.responseText);
            }
        });
    }

    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const paginationContainer = $('#tablePagination');
        paginationContainer.empty();

        if (totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        if (currentPage <= 3) endPage = Math.min(5, totalPages);
        if (currentPage >= totalPages - 2) startPage = Math.max(totalPages - 4, 1);

        for (let i = startPage; i <= endPage; i++) {
            html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        paginationContainer.html(html);
    }

    function goToPage(page) {
        currentPage = page;
        loadAllSubgroups();
    }

    $('#searchBox').on('keyup', function () {
        currentPage = 1;
        loadAllSubgroups();
    });

     $(document).on('click', '.btn-edit', function() {
        const rowId = $(this).data('doc');
        editSubgroup(rowId);
    });

    $(document).on('click', '.btn-view', function() {
        const rowId = $(this).data('doc');
        viewSubgroupDetails(rowId);
    });

    $(document).on('click', '.btn-delete', function() {
        const code = $(this).data('doc');
        deleteSubGroupById(code);  // Make sure this function exists
    });

    $(document).on('click', '.btn-details', function() {    
        const docCode = $(this).data('doc');
        showDocumentPopup(docCode);  // Your popup function
    });
     $(document).on("click", ".btn-approve", function () {
        let id = $(this).data("doc");
        $.ajax({
        url: '/AccountGeneralMasterList/Getapprovaldata',
        type: 'POST',
        dataType: 'json',
        data: { id: id },
        success: function (response) {
            console.log('AJAX Response:', response);  
            if (response.success) {
                console.log('khushahal singh', response.data);
                resetDropdowns();
                ShowApprovaldata(response.data);
            } else {
                toastr.error("Failed to get document details.");
            }
        },
        error: function () {
            toastr.error("An error occurred while fetching document details.");
        }
    });

    });

    function resetDropdowns() {
        // Clear the existing options in the dropdowns
        $("#ddlSendTo").empty().append("<option value=''>Select Send To</option>");
        $("#TxtRemarks").empty().append("<option value=''>Select Remarks</option>");
    }
    // Redirect to EDIT form
    function editSubgroup(rowId) {
        window.location.href = '/AccountGeneralMaster/Index?id=' + encodeURIComponent(rowId);
    }
    // Redirect to VIEW details form (read-only)
    function viewSubgroupDetails(rowId) {
        window.location.href = '/AccountGeneralMaster/Index?id=' + encodeURIComponent(rowId) + '&readOnly=true';
    }

    function deleteSubGroupById(code) {
        Swal.fire({
            title: 'Are you sure?',
            text: "This action will permanently delete the subgroup.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/AccountGeneralMaster/DeleteSubGroupByCode',
                    type: 'POST',
                    data: { code: code },
                    success: function (response) {
                        console.log("Delete response:", response);
                        if (response.success) {
                            Swal.fire(
                                'Deleted!',
                                response.message,
                                'success'
                            ).then(() => {
                                loadAllSubgroups(); 
                            });
                        } else {
                            Swal.fire(
                                'Failed',
                                response.message,
                                'warning'
                            );
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Delete error:", status, error);
                        Swal.fire(
                            'Error!',
                            'An error occurred while deleting the subgroup.',
                            'error'
                        );
                    }
                });
            }
        });
    }
    function exportToExcel() {
        fetch('/AccountGeneralMasterList/ExportAllDocs')
            .then(response => {
                if (!response.ok) throw new Error("Network response was not ok");
                return response.json();
            })
            .then(data => {
                console.log("kks", data);  

                const filteredData = data.map(item => ({
                    Code: item.code,           
                    NAME: item.name,
                    SHORTNAME: item.shortname,
                    GROUP_NAME: item.subGROUP_NAME,  
                    NATURE: item.nature,
                    STATUS: item.status
                }));

                console.log("Filtered Data:", filteredData);

                const worksheet = XLSX.utils.json_to_sheet(filteredData);
                const workbook = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(workbook, worksheet, "AllDocs");

                const pageName = "A/c GL Master";
                const now = new Date();
                const pad = n => String(n).padStart(2, '0');
                const timestamp = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}_${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;

                const fileName = `${pageName}_${timestamp}.xlsx`;
                XLSX.writeFile(workbook, fileName);
            })
            .catch(error => {
                console.error("Export failed:", error);
                toastr.error("Failed to export data.");
            });
    }
    function callGetReportAsPdf() {
        var reportName = "rpt_city_master";
        var now = new Date();
        var day = String(now.getDate()).padStart(2, '0');
        var month = String(now.getMonth() + 1).padStart(2, '0');
        var year = String(now.getFullYear()).slice(-2);
        var hours = String(now.getHours()).padStart(2, '0');
        var minutes = String(now.getMinutes()).padStart(2, '0');
        var seconds = String(now.getSeconds()).padStart(2, '0');
        var timestamp = `${day}${month}${year}_${hours}${minutes}${seconds}`;

        $.ajax({
            url: 'http://192.168.20.51:8082/Report/GetReportAsPdf',
            type: 'GET',
            data: { Reportname: reportName },
            xhrFields: {
                responseType: 'blob'
            },
            success: function (response) {
                console.log('PDF response:', response);
                var file = new Blob([response], { type: 'application/pdf' });
                var fileName = `${reportName}_${timestamp}.pdf`;

                var link = document.createElement('a');
                link.href = URL.createObjectURL(file);
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            },
            error: function (xhr, status, error) {
                console.error('Error generating report:', error);
            }
        });
    }
    function showDocumentPopup(docCode) {
        $.ajax({
            url: '/AccountGeneralMasterList/DocDetailsCode',
            type: 'POST',
            dataType: 'json',  // important
            data: { docCode: docCode },
            success: function(response) {
                if(response.success) {
                    showDocumentPopupjQuery(response.data, docCode);
                } else {
                    toastr.error("Failed to get document details.");
                }
            },
            error: function() {
                toastr.error("An error occurred while fetching document details.");
            }
        });
    }
   
</script>