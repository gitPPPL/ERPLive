<script>
    $(function () {
      $('#submitBtn').click(function (e) {
        let firstInvalid = $('#supplierAccordion [required]').filter(function () {
          return !this.value.trim();
        }).first();

        if (firstInvalid.length) {
          e.preventDefault();
          const panel = firstInvalid.closest('.accordion-collapse');
          bootstrap.Collapse.getOrCreateInstance(panel[0]).show();
          firstInvalid[0].setCustomValidity("Please fill this field");
          firstInvalid[0].reportValidity();
          firstInvalid.focus();
        }
      });
    });
</script>
