                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">Payment Terms</label>
                                <select class="form-select form-control" id="ddlPAYMENTTERM" name="PAYMENTTERM">
                                    <option value="">-- Select Payment --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">Cr Days</label>
                                <input type="number" class="form-control" id="TxtCRDAYS" placeholder="Enter Days">
                            </div>
