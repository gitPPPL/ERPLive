                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">Cr Limit</label>
                                <input type="number" class="form-control" id="TxtCRLIMIT" placeholder="Enter Cr limit">
                            </div>
                        </div>
                        @*  <div class="col-md-3">
                                <div class="form-group">
                                    <label class="form-label">Last Cr Limit</label>
                                    <input type="number" class="form-control" id="TxtLASTCRLIMIT" placeholder="Enter last Cr limit">
                                </div>
                            </div> *@
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">Aadhar</label>
                                <input type="text" class="form-control" id="TxtAADHAR" placeholder="Enter Aadhar">
                            </div>
                        </div>

                    </div>
                    <div class="row" style="display:none;">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">Bank Name</label>
                                <select class="form-select form-control" id="ddlBANKNAME" name="BANKNAME">
                                    <option value="">-- Select Bank Name --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">Bank Country</label>
                                <select class="form-select form-control" id="ddlBANKCOUNTRY" name="BANKCOUNTRY">
                                    <option value="">-- Select Bank Country --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">Bank Branch</label>
                                <input type="text" class="form-control" id="TxtBANKBRANCH" placeholder="Enter Bank Branch">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">IFSC Code</label>
                                <input type="text" class="form-control" id="TxtIFSCCODE" placeholder="Enter IFSC Code">
                            </div>
                        </div>
                    </div>
                    <div class="row" style="display:none;">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">Pay Type</label>
                                <select class="form-select form-control" id="ddlPAYTYPE" name="PAYTYPE">
