                                <label class="form-label">Date of Marriage</label>
                                <input type="date" id="txtDATEOFMARRIAGEC" class="form-control">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">Gender</label>
                                <select class="form-select form-control" id="ddlGENDERC">
                                    @* <option value="">-- Select Gender --</option> *@
                                    <option value="">-- Select Gender --</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">Portal ID</label>
                                <input type="text" class="form-control" id="txtPortalIDC" placeholder="Enter Fax No.">
                            </div>
