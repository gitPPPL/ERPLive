                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">Agent Name</label>
                                <select class="form-select form-control" id="ddlAGENTNAME" name="AGENTNAME">
                                    <option value="">-- Select Agent Name --</option>
                                </select>
