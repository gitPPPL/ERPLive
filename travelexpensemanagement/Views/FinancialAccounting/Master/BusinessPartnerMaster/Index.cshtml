             $("#dynamicFields").html("");

             $.ajax({
             url: "/BusinessPartnerMaster/GetTableColumns",
             type: "GET",
             data: { tableName: tableName },
             success: function (cols) {
                 console.log('cols',cols)
                 $.each(cols, function (i, col) {

                     let field =
                         `<div class="col-md-4">
                             <div class="form-group">
                                 <label class="form-label">${col.label}</label>
                                 <input type="text" class="form-control dyn-input" data-column="${col.columnName}" placeholder="Enter ${col.label}">
                             </div>
                         </div>`;

                     $("#dynamicFields").append(field);
                 });
             }
         });
         });

         $("#btn_savemodal").on("click", function () {

             let tableName = $("#hdnTableName").val();
             let dataList = [];
             $(".dyn-input").each(function () {
                 dataList.push({
                     columnName: $(this).data("column"),
                     value: $(this).val()
                 });
             });
             console.log("Table Name :", tableName);
             console.log("Collected Data :", dataList);

             $.ajax({
             url: "/BusinessPartnerMaster/SaveDynamicRecord",
             type: "POST",
             contentType: "application/json",
             data: JSON.stringify({
                 tableName: tableName,
                 values: dataList
             }),
             success: function (res) {
                 GetddlLanguage();
                 GetddlCurrency();
                 alert("Record saved successfully");
                 $("#languageModal").modal("hide");
             },
             error: function (err) {
                 console.log(err);
                 alert("Error while saving");
             }
         });

         });
        // modal Popup End block

        });
