                                <label class="form-label">Language<span class="required">*</span></label>
                                @*  <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#languageModal" style="float: right;">
                                        +
                                    </button> *@

                                <button type="button" class="btn btn-success btn-sm openModalBtn" data-bs-toggle="modal" data-bs-target="#languageModal" data-table="LANGUAGE_MAST"
                                        style="float:right;">
                                    +
                                </button>

                            </div>
                            <select class="form-select form-control" id="ddlLANGUAGE">
                                <option value="">-- Select Language --</option>
                            </select>
                        </div>
                        <div class="col-md-3">
