            </div>
        </div>
        <div class="col-md-3">
            <div class="btn-mt">
                <button id="btnGetdata" type="submit" class="btn btn-success"><i class="fa fa-file-import"></i>Import Data</button>
            </div>
        </div>
    </div>

    @* NavTab *@
    <div class="navtab-form">
        <ul class="nav nav-tabs" id="formTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link-tab active" id="tab1-tab" data-bs-toggle="tab" data-bs-target="#tab1" type="button" role="tab">General Details</button>
            </li>
            <li class="nav-item">
                <button class="nav-link-tab" id="tab2-tab" data-bs-toggle="tab" data-bs-target="#tab2" type="button" role="tab">Contact Details</button>
            </li>
            <li class="nav-item">
                <button class="nav-link-tab" id="tab3-tab" data-bs-toggle="tab" data-bs-target="#tab3" type="button" role="tab">Address Details</button>
            </li>
            <li class="nav-item">
                <button class="nav-link-tab" id="tab4-tab" data-bs-toggle="tab" data-bs-target="#tab4" type="button" role="tab">Other Details</button>
            </li>
            <li class="nav-item">
