                                <input type="number" class="form-control" id="txtPHONEC" oninput="limitLength(this, 10)" placeholder="Enter Phone No.">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">Mobile</label>
                                <input type="number" class="form-control" id="txtMOBILEC" oninput="limitLength(this, 10)" placeholder="Enter Mobile No.">
                            </div>
                        </div>
