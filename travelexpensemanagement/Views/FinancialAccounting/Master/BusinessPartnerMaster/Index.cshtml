                                    <input type="checkbox" id="ACTIVE" name="ACTIVE" checked>
                                    <span class="slider"></span>
                                </label>
                                <span class="active-text" id="statusText">Active</span>

                                @*  <button id="btnSave" type="submit" class="btn btn-success"><i class="fa fa-file-import"></i>Import Data</button> *@
                                @* <button type="button" id="cancelBtn" class="btn btn-danger">Cancel</button> *@

                            </div>

                        </div>
                    </div>
                </div>
