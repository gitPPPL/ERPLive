@{
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
	.status-label.inactive {
		color: green !important;
	}
</style>
<body>
	<fieldset>
		<legend>Country Master</legend>
		<div class="row">
			<div class="offset-md-8 col-md-4 btn-right">
				<button onclick="window.location.href='@Url.Action("Index", "CountryMaster")'" type="submit" class="btn btn-primary">
					<i class="fa fa-list"></i>Back to list
				</button>
			</div>
		</div>


		<form>
			<div class="row">
				<div class="col-md-4">
					<div class="form-group">
						<label class="form-label"><span class="required">*</span>Name</label>
                        <input type="text" class="form-control" placeholder="Name" id="Txtname" name="Name">
					</div>
				</div>

			</div>

			<div class="row">
				<div class="offset-md-8 col-md-2">
					<div class="form-group">
						<div class="toggle-wrapper justify-content-center" id="">
							<input type="hidden" id="DdActive" name="IsActive" value="1" />

							<div id="customToggle" class="custom-toggle active"></div>
							<span id="statusLabel" class="status-label active">Active</span>

						</div>
					</div>
				</div>
				<div class="col-md-2 btn-align">
					<button type="submit" class="btn btn-primary" id="btn-save">Save</button>
					@* <button type="button" id="cancelBtn" style="display:none;" class="btn btn-danger">Cancel</button> *@
				</div>
			</div>
		</form>
	</fieldset>
</body>

<script>

	const toggle = document.getElementById("customToggle");
	 const statusLabel = document.getElementById("statusLabel");
	 const hiddenInput = document.getElementById("DdActive");

	 toggle.addEventListener("click", function () {
	   if (toggle.classList.contains("disabled")) return;

	   toggle.classList.toggle("active");
	   const isActive = toggle.classList.contains("active");

	   hiddenInput.value = isActive ? "1" : "0";
	   statusLabel.textContent = isActive ? "Active" : "Inactive";
	   statusLabel.classList.toggle("active", isActive);
	   statusLabel.classList.toggle("inactive", !isActive);
	 });

	 function disableToggle() {
	   toggle.classList.add("disabled");
	 }

	 function enableToggle() {
	   toggle.classList.remove("disabled");
	 }

	function setToggleState(value) {
	  const toggle = document.getElementById("customToggle");
	  const label = document.getElementById("statusLabel");
	  const hiddenInput = document.getElementById("DdActive");
	  const isActive = Number(value) === 1;
	  toggle.classList.toggle("active", isActive);
	  label.textContent = isActive ? "Active" : "Inactive";
	  label.classList.toggle("active", isActive);
	  label.classList.toggle("inactive", !isActive);
	  hiddenInput.value = isActive ? "1" : "0";

	}

</script>
<script>

		let countryUpdateCode=0;
		let PreviousInputDt = "";
		let allMastData = [];
		let filteredData = [];
		let currentPage = 1;
		const rowsPerPage = 10;
		let ModeOfControl="";
		let getCountryDt=[];

		const storedData = localStorage.getItem('editCountry');
		ModeOfControl = localStorage.getItem('Mode');
		  localStorage.removeItem('Mode');
		  console.log(storedData);

		$(document).ready(function(){
		if (storedData && ModeOfControl === 'Edit') {
		  getCountryDt = JSON.parse(storedData);
		 countryUpdateCode = getCountryDt.code;
		 PreviousInputDt = getCountryDt.name;

		  $('#Txtname').val(getCountryDt.name);

		 setToggleState(getCountryDt.active);

		  $('input').prop('readonly', false);
		  $('#btn-save').show();
		  $('#cancelBtn').show();
		  localStorage.removeItem('editCountry');

		}
		else if (storedData && ModeOfControl === 'View') {
			$('#btn-save').hide();
			$('#cancelBtn').hide();
			getCountryDt = JSON.parse(storedData);

		  $('#Txtname').val(getCountryDt.name);
		  $('#DdActive').val(getCountryDt.active);
		  setToggleState(getCountryDt.active);
		   $('input').prop('readonly', true);
			disableToggle();
		  localStorage.removeItem('editCountry');
		}
		$('#Txtname').on('keydown', function (e) {
				if (e.key === 'Enter') {
					e.preventDefault();
					$('#DdActive').val('Active');
					$('#DdActive').focus();
				}
			});

			$('#DdActive').on('keydown', function (e) {
				if (e.key === 'Enter') {
					e.preventDefault();
					$('#btn-save').focus();
				}
			});

		});

	 $('#btn-save').on('click', function (e) {
		e.preventDefault();
		const name = $('#Txtname').val().trim();
		var active = document.getElementById("DdActive").value;
	   if (!validateRequiredField('#Txtname', 'Name')) return;

		if(ModeOfControl=='Edit')
		{
			 var CountryDt = {
				   code: countryUpdateCode,
				   name: name,
				   Active: active
			   };
			   console.log(CountryDt);
			 Editcountrymast(CountryDt, name)
		}
		else
		{
			 var CountryDt = {
				   name: name,
				   Active: active
			   };
		 savecountryMastDt(CountryDt, name);
		}
	});

	 function savecountryMastDt(CountryDt, name)
	{
		checkExistOrNot(name)
			  .done(function (data) {
			   if (data.status === true && data.exists === true) {
                toastr.warning("Duplicate Country Name");
				return;
			   }

				$.ajax({
					url:'@Url.Action("saveCountryMastDt", "CountryMaster")',
					type: 'POST',
					contentType: 'application/json',
					data: JSON.stringify(CountryDt),
					success: function (response) {
						if (response.status === true) {
							toastr.success('Data Save Successfully.');
							resetFields();
							setTimeout(function () {
								  window.location.href ='/CountryMaster/Index';
								}, 1500);

						} else {
                            toastr.error(response.message || "Save failed");
						}
					},
					error: function (xhr, error) {
						console.error(xhr.responseText);
                        toastr.error("Error occurred while saving.");
					}
				});
			  })
			.fail(function (xhr, status, error) {
            toastr.error("Error while checking Country type.");
			});
	}
	function Editcountrymast(CountryDt, name){
		if (PreviousInputDt !== name) {
				  checkExistOrNot(name)
					  .done(function (data) {
					   if (data.status === true && data.exists === true) {
                        toastr.error("Duplicate Country Name");
						return;
					   }
						updateCurrencyData(CountryDt, name);

					  })
					.fail(function (xhr, status, error) {
					console.error("Check Country failed:", error);
                    toastr.error("Error while checking Country type.");
					});
				 }
				 else{
					 updateCurrencyData(CountryDt, name);
				 }
	}
		function updateCurrencyData(CountryDt, name) {
			$.ajax({
				url: '/CountryMaster/UpdateCountryDt',
				type: 'POST',
				data:JSON.stringify(CountryDt),
				contentType: 'application/json',
				dataType: 'json',
				success: function(response) {
					if (response.status === true) {
						 toastr.success('Data update Successfully.');
						 resetFields();
				   setTimeout(function () {
								  window.location.href ='/CountryMaster/Index';
								}, 1500);
					} else {
                        toastr.error("Update failed: " + response.message);
					}
				},
				error: function(xhr, status, error) {
					console.error("Error occurred:", xhr.responseText);
                    toastr.error("Data not updated: " + error);
				}
			});
		}
		 function resetFields() {
			$('#Txtname').val('');
			$('#DdActive').val($('#DdActive option:first').val());
			 $('#searchInput').val();
		}
	  function checkExistOrNot(inputData)
	   {
		   return $.ajax({
		   url: '/CountryMaster/getExitOrNot',
		   type: 'GET',
		   dataType: 'json',
		   data: { inputData: inputData }
	   });
	   }
	document.getElementById("cancelBtn").addEventListener("click", function () {
	  Swal.fire({
		title: 'Are you sure?',
		text: "Do you want to cancel all the changes?",
		icon: 'warning',
		showCancelButton: true,
		confirmButtonText: 'Yes, cancel it!',
		cancelButtonText: 'No, keep it',
		reverseButtons: true
	  }).then((result) => {
		if (result.isConfirmed) {
		  Swal.fire(
			'Cancelled!',
			'Your action has been cancelled.',
			'success'
		  )
		 if(ModeOfControl=='Edit')
		 {
		$('#Txtname').val(getCountryDt.name);
		  setToggleState(getCountryDt.active);
	}
	else
	{
	resetFields();
	}
		} else if (result.dismiss === Swal.DismissReason.cancel) {
		  Swal.fire(
			'Resumed',
			'Your action is still in progress.',
			'info'
		  )
		}
	  });
	});
</script>