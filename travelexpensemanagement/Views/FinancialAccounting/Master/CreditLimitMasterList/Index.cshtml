@{
    ViewBag.Title = "Credit Limit Master List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentMenu = ViewBag.CurrentMenu as string;
}
<fieldset>
    <legend class="legend-field">Credit Limit Master List</legend>

    <div class="row">
        <div class="col-lg-4">
            <div class="input-group shadow-sm rounded-pill overflow-hidden">
                <input type="text" id="searchBox" class="form-control border-0" placeholder="Search Module..." aria-label="Search term">
            </div>
        </div>

        <div class="">
            @foreach (var permission in Model.UserMenuPermissions)
            {
                if (permission.DISPLAY_NAME == ViewBag.CurrentMenu)
                {
                    <div class="">
                        <div class="col-md-12">
                            @* Add Button *@
                            @if (Model.UserLevel == 1 || permission._ADD == 1)
                            {
                                <button id="btnSave" onclick="window.location.href='@Url.Action("Index", "CreditLimitMaster")'" type="submit" class="btn btn-primary">
                                    <i class="fa fa-plus"></i>Add
                                </button>
                            }
                            @* Edit Button *@
                            @* Print Button *@
                            @if (Model.UserLevel == 1 || permission._PRINT == 1)
                            {
                                <button class="btn btn-secondary">
                                    <i class="fa fa-print"></i> Print
                                </button>
                            }
                            @* Export Button *@
                            @if (Model.UserLevel == 1 || permission._EXPORT == 1)
                            {
                                <button class="btn btn-success">
                                    <i class="fa fa-file-excel-o"></i> Export
                                </button>
                            }
                            @* Mail Button *@
                            @if (Model.UserLevel == 1 || permission._MAIL == 1)
                            {
                                <button class="btn btn-info">
                                    <i class="fa fa-envelope"></i> Mail
                                </button>
                            }
                            @* Approval Button *@
                            @if (Model.UserLevel == 1 || permission._APPROVAL == 1)
                            {
                                <button class="btn btn-dark">
                                    <i class="fa fa-check"></i> Approve
                                </button>
                            }
                            @* Doc Detail Button *@
                            @if (Model.UserLevel == 1 || permission._DOCDETAIL == 1)
                            {
                                <button class="btn btn-primary">
                                    <i class="fa fa-file-text"></i> Doc Detail
                                </button>
                            }
                        </div>
                    </div>
                }
            }

        </div>
    </div>

    <div class="card shadow-sm border-0 mt-1">
        <div class="table-responsive">
            <table id="tblcreditlimit" class="table-width">
                <thead class="table-head">
                    <tr>
                        <th style="display:none;">Code</th>
                        <th>Eff From</th>
                        <th>Party Name</th>
                        <th>Group Name</th>
                        <th>CR Limit</th>
                        <th>Insu. CRDays</th>
                        <th>Approval Type</th>
                        <th>Our Approval</th>
                        <th>V NO</th>
                        <th>Remarks</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Pagination container -->
        <div class="row p-3">
            <div class="col-md-12 d-flex justify-content-center" id="tablePagination"></div>
        </div>
    </div>
</fieldset>
<script>
    let currentPage = 1;
    let pageSize = 10;
    let partyMap = {};
    let groupMap = {};

    $(document).ready(function () {
        $.when(loadPartyList(), loadGroupList()).done(function () {
            loadCreditLimitList();
        });
    });

    function loadPartyList() {
        partyMap = {};
        return $.ajax({ 
            url: '/CreditLimitMaster/GetPartyList',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                console.log('PARTY LIST:', data);
                $.each(data, function (index, item) {
                    partyMap[item.code] = item.name;
                });
            },
            error: function (xhr, status, error) {
                console.error("Error loading parties:", xhr.responseText);
                toastr.error('Error loading parties: ' + error);
            }
        });
    }


    function loadGroupList() {
        return $.ajax({
            url: '/CreditLimitMaster/GetGroupList',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                console.log('group LIST:', data);

                data.forEach(item => {
                    var code = item.code || item.value;
                    var name = item.name || item.text;
                    groupMap[code] = name;
                });
            },
            error: function (xhr, status, error) {
                console.error("Error loading group list: ", xhr.responseText);
                toastr.error('Error loading group list: ' + error);
            }
        });
    }


