@{
    ViewBag.Title = "BusinessPartnerMasterList";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentMenu = ViewBag.CurrentMenu as string;
    bool canAdd = false;
    bool canEdit = false;
    bool canDelete = false;
    bool canPrint = false;
    bool canExport = false;
    bool canMail = false;
    bool canApproval = false;
    bool canDocDetail = false;

    foreach (var permission in Model.UserMenuPermissions)
    {
        if (permission.DISPLAY_NAME == ViewBag.CurrentMenu)
        {
            canAdd = Model.UserLevel == 1 || permission._ADD == 1;
            canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
            canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
            canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
            canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
            canMail = Model.UserLevel == 1 || permission._MAIL == 1;
            canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
            canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
            break;  // Exit loop once found current menu permission
        }
    }
}

<fieldset>
    <legend class="legend-field">Business Partner Master List</legend>
    @* section Start *@
    <div class="row">
        <div class="col-lg-3">
            <div class="input-group shadow-sm rounded-pill overflow-hidden">
                <input type="text" id="tableSearch" class="form-control" placeholder="Search..." />
            </div>
        </div>


        <div class="col-lg-9">
            <div class="button-right">
                @if (canAdd)
                {
                    <button onclick="window.location.href='@Url.Action("Index", "BusinessPartnerMaster")'" type="submit" class="btn btn-add">
                        <i class="fa fa-plus"></i>Add
                    </button>
                }
                @if (canPrint)
                {
                    <button class="btn btn-print" onclick="callGetReportAsPdf()">
                        <i class="fa fa-print"></i> Print
                    </button>
                }
                @if (canExport)
                {
                    <button class="btn btn-export" onclick="exportToExcel()">
                        <i class="fas fa-file-export"></i> Export
                    </button>
                }
                @if (canMail)
                {
                    <button class="btn btn-info">
                        <i class="fa fa-envelope"></i> Mail
                    </button>
                }
                @if (canApproval)
                {
                    <button class="btn btn-dark">
                        <i class="fa fa-check"></i> Approve
                    </button>
                }
            </div>
        </div>
        
    </div>
    <div class="card">
        <div class="table-responsive">
            <table id="BusinessPartnerMasterListMastTable" class="table-width">
                <thead class="table-head">
                    <tr>
                        <th>Code</th>
                        <th>Party Name</th>
                        <th>Group</th>
                        <th>Nature</th>
                        <th>Currency</th>
                        <th>Mobile</th>
                        <th>Email</th>
                        <th>Party Type</th>
                        <th>Bank</th>
                        <th>A/C No</th>
                        <th>IFSC</th>
                        <th>Branch</th>
                        @* <th>Status</th> *@
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr> 
                    </tr>
                </tbody>
            </table>
        </div>
        <!-- Pagination container -->
        <div class="row p-3">
            <div class="col-md-12 d-flex justify-content-center" id="tablePagination"></div>
        </div>
    </div>
                
</fieldset>
@* Active status start*@
<script>
        $('#ACTIVE').on('change', function () {
        let status = $(this).is(':checked') ? 'Active' : 'Inactive';
        $('#statusText').text(status);
    });
</script>
@* Active status end*@
@* file Upload Delete Script start *@
<script>
    function setupFileUpload(inputId, previewId) {
      const input = document.getElementById(inputId);
      const preview = document.getElementById(previewId);

      input.addEventListener('change', function () {
        if (input.files.length > 0) {
          const fileName = input.files[0].name;
          preview.innerHTML = `
            📄 ${fileName}
            <span class="remove-btn" onclick="removeFile('${inputId}', '${previewId}')">&times;</span>
          `;
        } else {
          preview.innerHTML = '';
        }
      });
    }

    function removeFile(inputId, previewId) {
      const input = document.getElementById(inputId);
      const preview = document.getElementById(previewId);

      input.value = '';
      preview.innerHTML = '';
    }

    setupFileUpload('PANCOPY', 'PANCOPYPreview');
    setupFileUpload('GSTINCOPY', 'GSTINCOPYPreview');
    setupFileUpload('CANCELLEDCHEQUECOPY', 'CANCELLEDCHEQUECOPYPreview');
    setupFileUpload('MSMECOPY', 'MSMECOPYPreview');
    setupFileUpload('AADHARCOPY', 'AADHARCOPYPreview');
    setupFileUpload('CPCBCOPY', 'CPCBCOPYPreview');
    setupFileUpload('OTHERCOPY', 'OTHERCOPYPreview');
</script>

@* file Upload Delete Script end *@

@* Required Field Accordion Start *@
<script>
    $(function () {
      $('#submitBtn').click(function (e) {
        let firstInvalid = $('#businessaccordionlist [required]').filter(function () {
          return !this.value.trim();
        }).first();

        if (firstInvalid.length) {
          e.preventDefault();
          const panel = firstInvalid.closest('.accordion-collapse');
          bootstrap.Collapse.getOrCreateInstance(panel[0]).show();
          firstInvalid[0].setCustomValidity("Please fill this field");
          firstInvalid[0].reportValidity();
          firstInvalid.focus();
        }
      });
    });
</script>
@* Required Field Accordion End *@

@* pagination Start *@
<script>
    var canAdd = @canAdd.ToString().ToLower();
    var canEdit = @canEdit.ToString().ToLower();
    var canDelete = @canDelete.ToString().ToLower();
    var canPrint = @canPrint.ToString().ToLower();
    var canExport = @canExport.ToString().ToLower();
    var canMail = @canMail.ToString().ToLower();
    var canApproval = @canApproval.ToString().ToLower();
    var canDocDetail = @canDocDetail.ToString().ToLower();

    let currentPage = 1;
    let pageSize = 10;

    $(document).ready(function () {
        loadAllMenus();
    });

    function loadAllMenus() {
        const searchTerm = $('#tableSearch').val();
        $.ajax({
            url: '/BusinessPartnerMasterList/GetBusinessPartnerMasterList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                const menus = res.data;
                const totalCount = res.totalCount;

                let tbody = $('#BusinessPartnerMasterListMastTable tbody');
                tbody.empty();
                if (menus.length === 0) {
                    tbody.append('<tr><td colspan="8" class="text-center text-muted">No menus found.</td></tr>');
                }
                $.each(menus, function (index, menu) {
                    tbody.append(`
                        <tr>
                            <td>${menu.accode}</td>
                            <td>${menu.name}</td>
                            <td>${menu.groupname}</td>
                            <td>${menu.nature}</td>
                            <td>${menu.currency || ''}</td>
                            <td>${menu.mobile || ''}</td>
                            <td>${menu.emailid || ''}</td>
                            <td>${menu.partytype}</td>
                            <td>${menu.bankname === "-- Select Group Name --" ? "" : menu.bankname}</td>
                            <td>${menu.ifsccode}</td>
                            <td>${menu.acno}</td>
                            <td>${menu.bankbranch}</td>
                            <td>
                                 ${canEdit ? `<i class="fas fa-edit text-primary btn-edit" data-doc="${menu.accode}" title="Edit" style="cursor:pointer;"></i>` : ''}
                                <i class="fas fa-eye text-secondary btn-view" data-doc="${menu.accode}" title="View" style="cursor:pointer;"></i>
                                ${canDelete ? `<i class="fas fa-trash text-danger btn-delete" data-doc="${menu.accode}" title="Delete" style="cursor:pointer;"></i>` : ''}
                                ${canDocDetail ? `<i class="fa fa-file btn-details text-info" data-doc="${menu.accode}" title="Details" style="cursor:pointer;"></i>` : ''}
                            </td>
                        </tr>
                    `);
                });

                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                alert('Error loading menu list: ' + xhr.responseText);
            }
        });
    }
    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const paginationContainer = $('#tablePagination');
        paginationContainer.empty();
        if (total === 0) {
            paginationContainer.html('<span class="text-muted"></span>');
            return;
        }
        if (totalPages <= 1) return;

        let paginationHtml = '';
        if (currentPage > 1) {
            paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        if (currentPage <= 3) {
            endPage = Math.min(5, totalPages);
        }
        if (currentPage >= totalPages - 2) {
            startPage = Math.max(totalPages - 4, 1);
        }

        for (let i = startPage; i <= endPage; i++) {
            paginationHtml += `
                <button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1"
                        onclick="goToPage(${i})">${i}</button>`;
        }
        if (currentPage < totalPages) {
            paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            paginationHtml += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        paginationContainer.html(paginationHtml);
    }
    function goToPage(page) {
        currentPage = page;
        loadAllMenus();
    }
    $('#tableSearch').on('keyup', function () {
        currentPage = 1;
        loadAllMenus();
    });

     $(document).on('click', '.btn-edit', function() {
        const rowId = $(this).data('doc');
        AddOrEditFunction(rowId);
    });

    $(document).on('click', '.btn-view', function() {
        const rowId = $(this).data('doc');
        viewMenuDetails(rowId);
    });

    $(document).on('click', '.btn-delete', function() {
        const docCode = $(this).data('doc');
        deleteDocStage(docCode);  // Make sure this function exists
    });

    $(document).on('click', '.btn-details', function() {
        const docCode = $(this).data('doc');
        showDocumentPopup(docCode);  // Your popup function
    });

    function AddOrEditFunction(rowId) {
        window.location.href = '/BusinessPartnerMaster/Index?id=' + encodeURIComponent(rowId);
    }
    function viewMenuDetails(rowId) {
        window.location.href = '/BusinessPartnerMaster/Index?id=' + encodeURIComponent(rowId) + '&readOnly=true';
    }

    function deleteDocStage(docCode) {
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this deletion!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/BusinessPartnerMasterList/DeleteDocByCode',
                    type: 'POST',
                    data: { docCode: docCode },
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message || "Record deleted successfully.");
                            loadDocumentStages();
                        } else {
                            toastr.warning("Delete failed.");
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while deleting.");
                    }
                });
            }
        });
    }
    // Export to Excel Page

    function exportToExcel() {
            fetch('/BusinessPartnerMasterList/ExportAllDocs')
                .then(response => {
                    if (!response.ok) throw new Error("Network response was not ok");
                    return response.json();
                })
                .then(data => {
                    console.log('Export data',data)
                   const filteredData = data.map(item => ({
                   ACCODE: item.accode,
                   NAME: item.name,
                   GROUPNAME: item.groupname,
                   CURRENCY: item.currency,
                   NATURE: item.nature,
                   MOBILE: item.mobile,
                   EMAILID: item.emailid,
                   PARTYTYPE: item.partytype,
                   BANKNAME: item.bankname,
                   IFSCCODE: item.ifsccode,
                   ACNO: item.acno,
                   BANKBRANCH: item.bankbranch
                }));
                    const worksheet = XLSX.utils.json_to_sheet(filteredData);
                    const workbook = XLSX.utils.book_new();
                    XLSX.utils.book_append_sheet(workbook, worksheet, "AllDocs");

                    const pageName = "Business Partner Master";
                    const now = new Date();
                    const pad = n => String(n).padStart(2, '0');
                    const timestamp = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}_${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;

                    const fileName = `${pageName}_${timestamp}.xlsx`;
                    XLSX.writeFile(workbook, fileName);
                })
                .catch(error => {
                    console.error("Export failed:", error);
                    toastr.error("Failed to export data.");
                });
        }
    function callGetReportAsPdf() {
        var reportName = "rpt_city_master";
        var now = new Date();
        var day = String(now.getDate()).padStart(2, '0');
        var month = String(now.getMonth() + 1).padStart(2, '0');
        var year = String(now.getFullYear()).slice(-2);
        var hours = String(now.getHours()).padStart(2, '0');
        var minutes = String(now.getMinutes()).padStart(2, '0');
        var seconds = String(now.getSeconds()).padStart(2, '0');
        var timestamp = `${day}${month}${year}_${hours}${minutes}${seconds}`;

        $.ajax({
            url: 'http://192.168.20.51:8082/Report/GetReportAsPdf',
            type: 'GET',
            data: { Reportname: reportName },
            xhrFields: {
                responseType: 'blob'
            },
            success: function (response) {
                console.log('PDF response:', response);
                var file = new Blob([response], { type: 'application/pdf' });
                var fileName = `${reportName}_${timestamp}.pdf`;

                var link = document.createElement('a');
                link.href = URL.createObjectURL(file);
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            },
            error: function (xhr, status, error) {
                console.error('Error generating report:', error);
            }
        });
    }
    function showDocumentPopup(docCode) {
        $.ajax({
            url: '/BusinessPartnerMasterList/DocDetailsCode',
            type: 'POST',
            dataType: 'json',  // important
            data: { docCode: docCode },
            success: function(response) {
                if(response.success) {
                    showDocumentPopupjQuery(response.data, docCode);
                } else {
                    toastr.error("Failed to get document details.");
                }
            },
            error: function() {
                toastr.error("An error occurred while fetching document details.");
            }
        });
    }
</script>
@* pagination End *@
