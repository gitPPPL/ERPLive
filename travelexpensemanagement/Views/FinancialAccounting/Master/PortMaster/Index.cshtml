@{
	ViewBag.Title = "Port Master";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
	<legend class="legend-field">Port Master</legend>
	<div class="row">
		<div class="offset-md-8 col-md-4 btn-right">
			<button id="btnSave"
					onclick="window.location.href='@Url.Action("Index", "PortMasterList")'" type="button" class="btn btn-primary">
				<i class="fa fa-list"></i>Back to list
			</button>
		</div>
	</div>
	<form id="portMasterForm">
		<input type="hidden" class="form-control" id="CODE" name="CODE">
		<div class="row"> 
			<div class="col-md-3">
				<div class="form-group">
					<label for="PORT_NAME" class="form-label"><span class="required">*</span>Port Name</label>
					<input type="text" class="form-control" id="TxtPORT_NAME" name="PORT_NAME" placeholder="Enter Port Name">
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<label for="PORT_CODE" class="form-label"><span class="required">*</span>Port Code</label>
					<input type="text" class="form-control" id="TxtPORT_CODE" name="PORT_CODE" placeholder="Enter Port Code">
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-group">
					<label for="PORT_TYPE" class="form-label"><span class="required">*</span>Port Type</label>
					<select class="form-control" id="ddlPORT_TYPE" name="ddlPORT_TYPE">
						<option value="">-- Select Port Type --</option>
						<option value="Sea Port">Sea Port</option>
						<option value="Custom Port">Custom Port</option>
						<option value="Other">Other</option>
					</select>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="offset-md-8 col-md-2">
				<div class="active-toggle">
					<label class="toggle-switch">
						<input type="checkbox" id="ACTIVE" name="ACTIVE" checked>
						<span class="slider"></span>
					</label>
					<span class="ms-2" id="statusText">Active</span>
				</div>
			</div>
			<div class="col-md-2 btn-align">
				<button id="btnSave" type="submit" class="btn btn-primary">Save</button>
				@* <button type="button" class="btn btn-danger" onclick="window.location.href='/PortMasterList/Index'">Cancel</button> *@
			</div>
		</div>

	</form>

</fieldset>

<script>
	$(document).ready(function () {
		const urlParams = new URLSearchParams(location.search);
		const rowId = parseInt(urlParams.get('id'));
		const isReadOnly = urlParams.get('readOnly') === 'true';

		if (!isNaN(rowId) && rowId > 0) {
			loadPortById(rowId);
			if (isReadOnly) {
				setPortFormReadOnly();
			}
		}
		$('#ACTIVE').on('change', function () {
			let status = $(this).is(':checked') ? 'Active' : 'Inactive';
			$('#statusText').text(status);
		})

		$('#cancelBtn').on('click', function () {
			window.location.href = '/PortMasterList/Index';
		});
	});

	$('#portMasterForm').on('submit', function (e) {
		e.preventDefault();

		if (!validateRequiredField('#TxtPORT_NAME', 'Port Name')) return;
		if (!validateRequiredField('#TxtPORT_CODE', 'Port Code')) return;
		if (!validateRequiredField('#ddlPORT_TYPE', 'Port Type')) return;

		const code = parseInt($('#CODE').val()) || 0;
		const portData = {
			CODE: code,
			PORTCODE: $('#TxtPORT_CODE').val().trim(),
			NAME: $('#TxtPORT_NAME').val().trim(),
			PORT_TYPE: $('#ddlPORT_TYPE').val(),
			STATE: '', 
			ACTIVE: $('#ACTIVE').is(':checked') ? 1 : 0,
			UUSER: 1, 
			UDATE: new Date().toISOString(),
			EUSER: 1,
			EDATE: new Date().toISOString(),
			AED: code > 0 ? 'E' : 'A',
			WSID: "WEB",
			LIP: "127.0.0.1",
			LID: "WEB",
			ACTION: code > 0 ? "UPDATE" : "INSERT"
		};
		$.ajax({
			url: '/PortMaster/SavePort',
			type: 'POST',
			contentType: 'application/json',
			data: JSON.stringify(portData),
			success: function (response) {
				if (response.success) {
					toastr.success("Port saved successfully!");
					setPortFormReadOnly();
					// $('#portMasterForm')[0].reset();
					// setTimeout(() => {
					// 	window.location.href = '/PortMasterList/Index';
					// }, 1000);
				} else {
					toastr.warning(response.message || "Something went wrong.");
				}
			},
			error: function (xhr) {
				const errorMsg = xhr.responseJSON?.message || xhr.responseText || "An error occurred.";
				toastr.error("Error: " + errorMsg);
			}
		});
	});

	function loadPortById(code) {
		$.ajax({
			url: '/PortMasterList/GetPortByCode',
			type: 'GET',
			data: { code: code },
			success: function (res) {
				console.log(res);
				if (!res.success || !res.data) {
					toastr.warning("No data found for the provided code.");
					return;
				}

				const port = res.data;

				$('#CODE').val(port.code);
				$('#TxtPORT_NAME').val(port.name);
				$('#TxtPORT_CODE').val(port.portcode);
				$('#ddlPORT_TYPE').val(port.porT_TYPE);

				const isActive = port.active === 1 || port.active === true;
				$('#ACTIVE').prop('checked', isActive);
				$('#statusText').text(isActive ? 'Active' : 'Inactive');
			},
			error: function (xhr, status, error) {
				toastr.error("Error loading port: " + xhr.responseText);
			}
		});
	}

	function setPortFormReadOnly() {
		const form = $('#portMasterForm');
		form.find('input, select, textarea, button').prop('disabled', true);
		form.find('#ACTIVE').prop('disabled', true);
		// $('#btnSave, #cancelBtn').hide();
	}
</script>