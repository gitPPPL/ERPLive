	function getDataOfRow($row) {
	   salesExecutivedt = {
			sno: $row.find('.sno').text().trim(),
			code: $row.find('.code').text().trim(),
			name: $row.find('.name').text().trim()

		};

	}

			function getSalesExecutiveDt() {
				debugger;
				$.ajax({
					url:'@Url.Action("GetSaleExecutiveMast", "SalesExecutiveMasterList")',
					type: 'GET',
					dataType: 'json',
					success: function (data) {
						if (data.status === true) {
							 allMastData = data.data;
							filteredData=allMastData;
							currentPage = 1;
							renderYearMasterTable();
							renderYearMasterPagination();

						} else {
							alert("Data Load Failed");
						}
					},
					error: function (xhr, status, error) {
						console.error('Error: ' + xhr.responseText);
						alert('Data Load Failed: ' + error);
					}
				});
			}
			function renderYearMasterTable() {
				const tbody = $('#tabledt tbody');
				tbody.empty();
				const start = (currentPage - 1) * rowsPerPage;
				const end = start + rowsPerPage;
				const pageData = filteredData.slice(start, end);
				pageData.forEach(item => {
					const row = `<tr>
									<td class="sno">${item.Sno}</td>
									<td class="code">${item.code}</td>
									<td class="name">${item.NAME}</td>
									<td>
									<button class="btn btn-sm btn-light btn-edit">
									<i class='fas fa-edit text-primary'></i>
									</button>
									<button class="btn btn-sm btn-light btn-view">
									<i class="fas fa-eye"></i>
									</button>
									<button class="btn btn-sm btn-light btn-delete">
									<i class='fas fa-trash text-danger'></i>
									</button>
									</td>
					</tr>`;
					tbody.append(row);
				});
			}
	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const paginationContainer = $('#tablePagination');

		// Clear previous pagination
		paginationContainer.empty();

			function renderYearMasterPagination() {
				const totalPages = Math.ceil(filteredData.length / rowsPerPage);
				const pagination = $('#tablePagination');
				pagination.empty();

		// Don't render pagination if only one page
				if (totalPages <= 1) return;

				const maxVisiblePages = 7;
				const ellipsis = '<li class="page-item disabled"><span class="page-link">...</span></li>';

				pagination.append(`<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
					<a class="page-link" href="#" data-page="${currentPage - 1}">Prev</a>
				</li>`);

				let startPage = Math.max(1, currentPage - 2);
				let endPage = Math.min(totalPages, currentPage + 2);

				if (currentPage <= 4) {
					startPage = 1;
					endPage = Math.min(totalPages, maxVisiblePages - 2);
				} else if (currentPage >= totalPages - 3) {
					startPage = Math.max(1, totalPages - (maxVisiblePages - 3));
					endPage = totalPages;
				}

				if (startPage > 1) {
					pagination.append(`<li class="page-item"><a class="page-link" href="#" data-page="1">1</a></li>`);
					if (startPage > 2) pagination.append(ellipsis);
				}

				for (let i = startPage; i <= endPage; i++) {
					pagination.append(`<li class="page-item ${i === currentPage ? 'active' : ''}">
						<a class="page-link" href="#" data-page="${i}">${i}</a>
					</li>`);
				}

				if (endPage < totalPages) {
					if (endPage < totalPages - 1) pagination.append(ellipsis);
					pagination.append(`<li class="page-item"><a class="page-link" href="#" data-page="${totalPages}">${totalPages}</a></li>`);
				}
	$('#searchBox').on('keyup', function () {
		currentPage = 1;
		loadAllMenus();
	});
	//Load Full LIST END



				// Next button
				pagination.append(`<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
					<a class="page-link" href="#" data-page="${currentPage + 1}">Next</a>
				</li>`);
			}

</script>
