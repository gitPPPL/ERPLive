@{
    ViewBag.Title = "Account Main Group Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
    <legend>Account Main Group Master</legend>
    <div class="row">

        <div class="offset-md-8 col-md-4 btn-right">
            <button id="btnSave"
                    onclick="window.location.href='@Url.Action("Index", "AccountMainGroupMasterList")'" type="button" class="btn btn-primary">
                <i class="fa fa-list"></i>Back to list
            </button>
        </div>
    </div>
    <form id="groupForm">
        <input type="hidden" class="form-control" id="CODE" name="CODE" value="0">

        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="GROUP_NAME" class="form-label">Group Name<span class="required">*</span></label>
                    <input type="text" class="form-control" id="GROUP_NAME" name="GROUP_NAME" placeholder="Enter Group Name" required>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="SHORT_NAME" class="form-label">Short Name<span class="required">*</span></label>
                    <input type="text" class="form-control" id="SHORT_NAME" name="SHORT_NAME" placeholder="Enter Short Name">
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="TYPE" class="form-label">Type<span class="required">*</span></label>
                    <select class="form-control" id="TYPE" name="TYPE" required>
                        <option value="">-- Select Type --</option>
                        <option value="1">ASSET</option>
                        <option value="2">EXPENSE</option>
                        <option value="3">LIABILITY</option>
                        <option value="4">REVENUE</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="offset-md-8 col-md-2">
                <div class="active-toggle">
                    <label class="toggle-switch">
                        <input type="checkbox" id="ACTIVE" name="ACTIVE" checked>
                        <span class="slider"></span>
                    </label>
                    <span class="ms-2" id="statusText">Active</span>
                </div>
            </div>
            <div class="col-md-2 btn-align">
                @* <button id="btnSave" type="submit" class="btn btn-primary">Submit</button> *@
                <button type="submit" id="btnSubmit" class="btn btn-primary">Save</button>
                <button type="button" id="btnUpdate" class="btn btn-primary">Save</button>
                @* <button type="button" id="cancelBtn" class="btn btn-danger">Cancel</button> *@
            </div>
        </div>
    </form>

</fieldset>

<script>
    $(document).ready(function () {
        // Hide Update button initially
        $("#btnUpdate").hide();

        // Utility: Get URL query string parameters
        function getQueryParam(param) {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get(param);
        }

        const code = getQueryParam('id');
        const mode = getQueryParam("mode");

        // Active checkbox toggle
        $('#ACTIVE').on('change', function () {
            let status = $(this).is(':checked') ? 'Active' : 'Inactive';
            $('#statusText').text(status);
        });

        // Handle Create (Insert)
        $('#btnSubmit').on('click', function (e) {
            e.preventDefault();

            if (!validateRequiredField('#GROUP_NAME', 'Group Name')) return;
            if (!validateRequiredField('#SHORT_NAME', 'Short Name')) return;
            if (!validateRequiredField('#TYPE', 'Type')) return;

            let formData = {
                code: 0,
                group_name: $('#GROUP_NAME').val(),
                short_name: $('#SHORT_NAME').val(),
                // type: $('#TYPE').val(),
                type: $('#TYPE option:selected').text(),
                active: $('#ACTIVE').is(':checked') ? 1 : 0,
            };
            console.log("Inserting Data:", formData);
            $.ajax({
                 url: '/AccountMainGroupMaster/SaveGroupMaster',
                 type: 'POST',
                 contentType: 'application/json',
                 data: JSON.stringify(formData),
                 success: function (response) {

                     if (response.success) {
                         toastr.success(response.message || 'Saved successfully!');

                         // $('#groupForm')[0].reset();
                         setFormReadOnly();
                         $('#statusText').text('Inactive');
                     }
                     else {
                         toastr.warning(response.message || "Something went wrong!");
                     }
                 },
                 error: function (xhr) {
                     toastr.error('Error: ' + xhr.responseText);
                 }
            });

        });

        // Handle Update
        $('#btnUpdate').on('click', function (e) {
            e.preventDefault();

            let formData = {
                code: parseInt(code),
                group_name: $('#GROUP_NAME').val(),
                short_name: $('#SHORT_NAME').val(),
                // type: $('#TYPE').val(),
                type: $('#TYPE option:selected').text(),
                active: $('#ACTIVE').is(':checked') ? 1 : 0,
            };

            console.log("Updating Data:", formData);

            $.ajax({
                url: '/AccountMainGroupMaster/UpdateGroupMaster',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (response) {
                    // alert(response.message || 'Updated successfully!');
                     if (response.success) {
                         toastr.success(response.message || 'Updated successfully!');
                        $('#groupForm')[0].reset();
                        $('#statusText').text('Inactive');
                        $("#btnSubmit").show();
                        $("#btnUpdate").hide();
                     }
                     else {
                         toastr.warning(response.message || "Something went wrong!");
                     }
                },
                error: function (xhr) {
                    alert('Error: ' + xhr.responseText);
                }
            });
        });

        // If editing existing record
        if (code) {
            $("#btnSubmit").hide();
            $("#btnUpdate").show();

            $.ajax({
                url: '/AccountMainGroupMaster/GetAccountMainByCode',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ code: parseInt(code) }),
                success: function (response) {
                    bindItemDeptForm(response);
                },
                error: function (xhr) {
                    alert('Error: ' + xhr.responseText);
                }
            });
        }

        // Handle view-only mode
        if (mode === "view") {
            setFormReadOnly();
            $('#groupForm').after('<span class="badge bg-secondary ms-2">Read-Only Mode</span>');
        }

        // Read-only mode
        function setFormReadOnly() {
            $('#groupForm input, #groupForm select').prop('disabled', true);
            $('#customToggle').css('pointer-events', 'none');
            $('#btnSubmit, #btnUpdate').hide();
        }

        // Pre-fill form for editing
        function bindItemDeptForm(data) {
            const typeMap = {
                "ASSET": "1",
                "EXPENSE": "2",
                "LIABILITY": "3",
                "REVENUE": "4"
            };

            $('#GROUP_NAME').val(data.group_name);
            $('#SHORT_NAME').val(data.short_name);
            $('#TYPE').val(typeMap[data.type] || "");
            $('#ACTIVE').prop('checked', data.active === 1);
            $('#statusText').text(data.active === 1 ? 'Active' : 'Inactive');
        }
    });
</script>

