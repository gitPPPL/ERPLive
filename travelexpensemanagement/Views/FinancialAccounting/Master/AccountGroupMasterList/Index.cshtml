    //     if (!confirm("Are you sure you want to delete this record?")) return;

    //     $.ajax({
    //         url: '/AccountGroupMasterList/DeleteID',
    //         type: 'POST',    // 👉 Use POST
    //         dataType: 'json',
    //         data: { ID: id },  // 👉 Parameter must match action argument (ID)
    //         success: function (res) {
    //             if (res.success) {
    //                 toastr.success(res.message || "Record deleted successfully!");
    //                 loadAllAccountMain(1);
    //             } else {
    //                 toastr.error(res.message || "Unable to delete record!");
    //             }
    //         },
    //         error: function (xhr) {
    //             toastr.error("Error: " + xhr.responseText);
    //         }
    //     });
    // }

        function Delete(id) {
        Swal.fire({
            title: 'Are you sure?',
            text: "This action will permanently delete the subgroup.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/AccountGroupMasterList/DeleteID',
                    type: 'POST',
                    data: { ID: id }, // 🔥 MUST MATCH CONTROLLER
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Deleted!', response.message, 'success')
                                .then(() => loadAllAccountMain());
                        } else {
                            Swal.fire('Failed', response.message, 'warning');
                        }
                    },
                    error: function () {
                        Swal.fire('Error!', 'An error occurred during deletion.', 'error');
                    }
                });
            }
        });
    }



</script>

