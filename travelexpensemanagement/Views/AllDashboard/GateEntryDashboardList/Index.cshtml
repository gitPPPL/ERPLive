@{
	ViewBag.Title = "Gate Entry Dashboard List";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-center-toast-container"></div>
<!-- HEADER -->
<div class="erppagelist-header">
	<div class="erppagelist-title">
		<i class="fa fa-list"></i>
		<span>Gate Entry Dashboard List</span>
	</div>
	<div class="erppagelist-header-right">
		<button type="button" class="erppage-header-back" onclick="location.href='@Url.Action("Index", "GateEntryDashboard")'">
			<i class="fa fa-plus"></i>Add New
		</button>
	</div>
</div>
<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
	<div class="erppagelist-search-wrapper">
		<i class="fa fa-search"></i>
		<input type="text" id="tableSearch" placeholder="Search by All Columns Name...." />
	</div>
	<div class="erppagelist-actions">
		@* <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" id="btnPrint">
			<i class="fa fa-print"></i>Print
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" id="btnExport" data-tooltip="Export to Excel">
			<i class="fa fa-file-excel"></i>Export
		</button> *@
		@* <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail">
			<i class="fa fa-envelope"></i>Mail
		</button>
		<button class="erppagelist-btn erppagelist-btn-approve tooltip-btn" data-tooltip="Approve Records">
			<i class="fa fa-check-circle"></i>Approved
		</button> *@
	</div>
</div>
<div class="erppagelist-container">
	<div class="excel-wrapper fixed-grid-wrapper">
		<table id="tblGateEntryDashboardList" class="excel-table fixed-grid-table">
			<colgroup>
				<col style="display:none;" />          <!-- Code (hidden) -->
				<col style="width: 80px;" />           <!-- Serial No -->
				<col style="width: 120px;" />          <!-- Truck No -->
				<col style="width: 180px;" />          <!-- Visitor/Driver Name -->
				<col style="width: 140px;" />          <!-- Visitor/Driver No -->
				<col style="width: 90px;" />           <!-- In Time -->
				<col style="width: 90px;" />           <!-- Out Time -->
				<col style="width: 150px;" />          <!-- Purpose -->
				<col style="width: 100px;" />          <!-- Status -->
				<col style="width: 120px;" />          <!-- Action -->
			</colgroup>
			<thead>
				<tr>
					<th style="display:none;">Code</th>
					<th>Serial No</th>
					<th>Truck No.</th>
					<th>Visitor/Driver Name</th>
					<th>Visitor/Driver No</th>
					<th>In Time</th>
					<th>Out Time</th>
					<th>Purpose</th>
					<th>Status</th>
					<th class="action-col">Action</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>
	<div class="erppagelist-pagination">
		<div class="pagination-left">
			<select id="pageSizeSelect" onchange="changeRowsPerPage()">
				<option value="5">5</option>
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
			</select>
		</div>
		<div class="pagination-center">
			<button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
			<div id="pageNumbers" class="page-numbers"></div>

			<button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
		</div>
		<div class="pagination-right" id="pageInfoText">
			Results: 0 - 0 of 0
		</div>
	</div>
</div>