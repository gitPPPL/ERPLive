        REF_NO: null,
        FAPROV_STATUS: null,
        FAPROV_REMARKS: null,
        STATUS: null,
        ACTIVE: null,
        Remarks2: null,
        PARTY_NAME: null,
        RC_NO: toNullableString(document.getElementById("TxtVehicleRCNo")?.value),
        DL_NO: toNullableString(document.getElementById("txtDLNo")?.value),
        INSU_NO: toNullableString(document.getElementById("TxtInsuranceNo")?.value),
        PAN_NO: toNullableString(document.getElementById("txtPANNO")?.value),
