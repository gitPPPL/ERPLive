    function getVehicleDetailsFromDB(vehicleNo){
        $.ajax({
            url: '@Url.Action("GetVehicleInfoFromDB", "TransportInwardEntry")',
            type: 'GET',
            dataType: 'json',
            data: {vehicleNo: vehicleNo},
            success: function (response) {
                if (response.success) {
                    const data = response.vehicleInfo;
                    console.log("Vehicle data:", data);
                    $('#txtVehicleBody').val(data.bodyType);
                    $('#txtPassWeight').val(data.grossWt);
                    $('#TxtInsuranceNo').val(data.insuranceNumber);
                    $('#txtPurpose').val(data.purpose);
                    $('#TxtVehicleRCNo').val(data.rcNumber);
                    $('#TxtVehicleRemarks').val(data.vehicleRemarks);
                    GetTransportList(data.transportCode);

                    const validityData = [
                       { value: data.insuExp, checkboxId: '#chkValidity', datepickerId: '#DtValidity' },
                       { value: data.fitmentupto, checkboxId: '#chkFitmentValidity', datepickerId: '#DtFitmentValidity' },
                       { value: data.taxupto, checkboxId: '#chkTaxValidity', datepickerId: '#DtTaxValidity' }
                   ];

                   validityData.forEach(item => {
                       if (item.value !== null && item.value !== "") {
                           $(item.checkboxId).prop('checked', true);
                           $(item.datepickerId).val(formatDateToBind(item.value));
                           $(item.datepickerId).prop('disabled', false);
                       }
                   });
                }
            },
            error: function (xhr, status, error) {
                toastr.error("Driver Details Load failed", xhr.error);
            }
        });
    }
