</fieldset>
<script src="~/js/GlobalFunction.js" asp-append-version="true"></script>
<script>

    var allFieldIds = [
      "TxtDocId", "ddlDocType", "NumDocNo", "DtDocDate", "DtReportDate", "TmInTime", "TmRTime", "ddlTransportName", "TxtDrivername",
      "TxtVehicleNo", "TxtVehicleRCNo", "NumContainerNo", "txtDLNo", "NumDriverMobile", "TxtInsuranceNo", "txtPANNO", "txtPurpose",
      "ddlContainerSize", "ddlDONo", "ddlCustomerName", "TxtAdd1TIR", "TxtAdd2TIR", "TxtAdd3PD", "ddlCity", "TxtRemarks"
    ];

    // const itemRecords = [    
    //   "TxtCode",
    //   "TxtVno",
    //   "TxtVdate",
    //   "TxtDoNo",
    //   "ddlPartyNm",
    //   "TxtTruckNo",
    //   "ddlTransport",
    //   "TxtDriverNm",
    //   "TxtMobileNo",
    //   "TxtRemarks"
    // ];
       
     
    let docId = "";
    let readOnly;

    function getQueryParam(param) {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(param);
    }

    $(async function () {
        try {
            await GetDocTypeAsync();
            $('#ddlDocType').prop('selectedIndex', 0);
            handleDocLoad();
        } catch (error) {
            toastr.error('Failed to load document types: ' + error);
        }
    });

    $(document).ready(function () {
    GetCustomerList();
    GetTransportList(); 
    // addItemRecordRow();
 
    setEnterKeyFocus(allFieldIds);

    $(".draggable-modal").draggable({
    handle: ".popup-header"
    });

    $('#ddlDocType').on('change', function () {
        const VType = $(this).val();       
        if (VType) {
            GetDocid(VType);
        }
    });

    $(document).on('click', '.btn-delete-action, .btn-Itemdelete-action', function () {
        var tbody = $(this).closest('tbody');
        var rowCount = tbody.find('tr').length;
        if (rowCount > 1) {
            $(this).closest('tr').remove();
        } else {
            alert('Cannot delete the first row.');
        }
    });

    $(document).on('click', '#tab1 .btn-Itemadd-action', function () {
    addItemRecordRow();
    });


    $('#ddlCustomerName').on('change', function () {
        var partyCode = $(this).val();
        var selectedOption = $(this).find('option:selected');
        if (partyCode) {
            $('#TxtAdd1TIR').val(selectedOption.data('add1') || '');
            $('#TxtAdd2TIR').val(selectedOption.data('add2') || '');
            $('#TxtAdd3PD').val(selectedOption.data('add3') || '');  
            var cityCode = selectedOption.data('citycd');
            var cityName = selectedOption.data('cityname');           
            ensureOption($('#ddlCity'), cityCode, cityName);            
            $('#ddlCity').val(cityCode).trigger('change');        
        } else {
            $('#TxtAdd1TIR, #TxtAdd2TIR, #TxtAdd3PD').val('');
            $('#ddlCity').val('');          
        }
    });

    function ensureOption($dropdown, code, name) {
        if (code && $dropdown.find(`option[value="${code}"]`).length === 0) {
            $dropdown.append(`<option value="${code}">${name}</option>`);
        }
    }


    $('#btn-save').on('click', async function (e) {
        e.preventDefault();

          if (!validateRequiredField('#ddlDocType', 'Doc Type')) return;
          if (!validateRequiredField('#NumDocNo', 'Doc No')) return;
          if (!validateRequiredField('#DtDocDate', 'Doc Date')) return;
          if (!validateRequiredField('#TmInTime', 'In Time')) return;
          if (!validateRequiredField('#TmRTime', 'R Time')) return;
          if (!validateRequiredField('#ddlTransportName', 'Transport Name')) return;
          if (!validateRequiredField('#TxtDrivername', 'Driver Name')) return;
          if (!validateRequiredField('#ddlCustomerName', 'Customer Name')) return;

        try {
            const tableData = await collectFormData();
            if (docId) {
                UpdateData(tableData);
            } else {
                SaveData(tableData);
            }
        } catch (error) {           
            toastr.error('An error occurred while saving the data.');
        }

    });
 
    });

</script>

<script>

    function setCurrentTime() {
        const now = new Date();
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const currentTime = `${hours}:${minutes}`;
        document.getElementById('TmInTime').value = currentTime;
    }

    function GetDocTypeAsync(selectedValue) {
          return new Promise((resolve, reject) => {
              $.ajax({
                  url: '@Url.Action("GetDocType", "TransportInwardEntry")',
                  type: 'GET',
                  dataType: 'json',
                  success: function (response) {
                      if (response.status) {
                          const $dropdown = $('#ddlDocType');
                          $dropdown.empty();
                          // $dropdown.append('<option value="">-select doc Type-</option>');

                          $.each(response.data, function (index, item) {
                              $dropdown.append(`<option value="${item.CODE}">${item.NAME}</option>`);
                          });

                          if (selectedValue && $dropdown.find(`option[value="${selectedValue}"]`).length > 0) {
                              $dropdown.val(selectedValue).trigger('change');
                          } else {
                              $dropdown.prop('selectedIndex', 0);
                          }

                          resolve();
                      } else {
                          reject("Invalid response status.");
                      }
                  },
                  error: function (xhr, status, error) {
                      toastr.error("Document Type Load failed: " + error);
                      reject(error);
                  }
              });
          });
    }

    async function handleDocLoad() {
             docId = getQueryParam('id');
             readOnly = getQueryParam('readOnly');

            if (docId) {
                $('#ddlDocType').prop('readonly', true);                 
                await GetDocData(docId, readOnly);
            } else {
                const Vtype = $('#ddlDocType').val();
                let selectedText = $('#ddlDocType option:selected').text();
                console.log(Vtype, selectedText);
                if(Vtype)
                {
                  GetDocid(Vtype);
                }
                setCurrentTime();
                const today = new Date();
                const todayDate = today.getFullYear() + '-' +
                    (today.getMonth() + 1).toString().padStart(2, '0') + '-' +
                    today.getDate().toString().padStart(2, '0');
                $('#DtDocDate').val(todayDate);
                $('#DtReportDate').val(todayDate);
            }
    }

    function SaveData(saveDt) {
                $.ajax({
                     url: '@Url.Action("SaveOrUpdateTransportInward", "TransportInwardEntry")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(saveDt),
                    success: function (response) {
                        if (response?.status) {
                            showFlashMessageByKey('insert', 'success');
                            // resetFields();
                            setTimeout(() => {
                                window.location.href = '/TransportInwardEntryList/Index';
                            }, 1500);
                        } else {
                            toastr.error(response?.message || "Save failed. Please try again.");
                        }
                    },
                    error: function () {
                        toastr.error("Error occurred while saving. Please contact admin.");
                    }
                });
    }

    function UpdateData(UpdateDt) {
        $.ajax({
            url: '@Url.Action("SaveOrUpdateTransportInward", "TransportInwardEntry")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(UpdateDt),
            dataType: 'json',
            success: function (response) {
                if (response?.status) {
                    showFlashMessageByKey('update', 'success');
                    // resetFields();
                    setTimeout(() => {
                        window.location.href = '/TransportInwardEntryList/Index';
                    }, 1500);
                } else {
                    toastr.error("Update failed: " + (response?.message || "Unknown error."));
                }
            },
            error: function (xhr, status, error) {
                toastr.error("Data not updated: " + error);
            }
        });
    }
    
