        SHIP_BILLNO: null,
        SHIP_BILLDATE: null,
        EWB_DATE: null,
        EWB_EXPDATE: null,
        PARTY_WBTIME: null,
        EWB_INVNO: null,
        EWB_INVAMT: null,
        PARTY_WBSLIPNO: null,
        PARTY_WBGRWT: null,
        PARTY_WBTRWT: null,
