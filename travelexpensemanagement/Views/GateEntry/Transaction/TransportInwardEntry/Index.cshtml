    function formatDate(dateStr) {
      if (!dateStr) return '';
      const d = new Date(dateStr);
      return d.toISOString().split('T')[0];
    }

    function parseIntSafe(value) {
        const parsed = parseInt(value, 10);
        return isNaN(parsed) ? null : parsed;
    }

    function parseFloatSafe(value) {
        const parsed = parseFloat(value);
        return isNaN(parsed) ? null : parsed;
    }

     function parseDate(dateStr) {
        if (!dateStr) return null;
        const parts = dateStr.split(/[-\/]/);
        if (parts.length === 3) {
            let [day, month, year] = parts.map(p => parseInt(p, 10));
            if (year < 1000) year += 2000;
            return new Date(year, month - 1, day);
        }
        return null;
     }

    function toNullableInt(val) {
        const parsed = parseInt(val);
        return isNaN(parsed) ? null : parsed;
    }

    function toNullableDate(val) {
        const date = new Date(val);
        return isNaN(date.getTime()) ? /* ==correction== null */ "" : val;
    }

    function toNullableString(val) {
      return val?.trim() || /* ==correction== null */ "";
    }

    function allowOnlyNumbers(input) {
      input.value = input.value
        .replace(/[^0-9.]/g, '')
        .replace(/(\..*)\./g, '$1');
    }

    function setFieldsEnabled(enabled) {
      allFieldIds.forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          el.disabled = !enabled;
        }
      });
    }

    function setEnterKeyFocus(sequence) {
               sequence.forEach((id, index) => {
                   $(`#${id}`).on('keypress', function (e) {
                       if (e.key === 'Enter') {
                           e.preventDefault();
                           if (index + 1 < sequence.length) {
                               $(`#${sequence[index + 1]}`).focus();
                           }
                       }
                   });
               });
    }

    async function GetDocData(MasterTblId, readOnly) {
        try {
            const response = await $.ajax({
                url: '/TransportInwardEntry/GetTransportInwardRecordsById',
                type: 'GET',
                data: { id: MasterTblId }
            });
            if (response.status) {
                console.log(response.data);
                await fillFormFields(response.data);

                if (readOnly === 'true') {
                    $('#btn-save, #cancelBtn').hide();
                    disableAllFields();
                    //======================Correction============
                    var $previewContainer = $('#previewContainer');
                    if($previewContainer.is(':visible')){
                         $('#btnRemoveImage').hide();
                         $('#btnGetVAHANData').prop('disabled', true).css('pointer-events', 'none');
                    }
                    //=====================================
                } else {
                    $('#btn-save, #cancelBtn').show();
                    enableAllFields();
                }
            } else {
                toastr.error('No data returned.');
            }
        } catch (error) {
            toastr.error('Failed to load data.');
            console.error(error);
        }
    }

      function enableAllFields() {
      allFieldIds.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.disabled = false;
      });
    }

    function disableAllFields() {
      allFieldIds.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.disabled = true;
      });
    }

    async function fillFormFields(data) {
        if (!Array.isArray(data) || data.length === 0) {
            console.error("Invalid or empty data array");
            return;
        }

        const d = data[0];
        // const formatDate = val => val ? val.substring(0, 10) : '';
        const formatTime = val => val ? val.substring(0, 5) : '';

        document.getElementById("TxtDocId").value = d.DOC_ID || '';
        document.getElementById("ddlDocType").value = d.V_TYPE || '';
        document.getElementById("NumDocNo").value = d.V_NO || '';
        // document.getElementById("DtDocDate").value = formatDate(d.V_DATE);
        document.getElementById("DtDocDate").value = formatDateToBind(d.V_DATE);
        // document.getElementById("DtReportDate").value = formatDate(d.R_DATE);
        document.getElementById("DtReportDate").value = formatDateToBind(d.R_DATE);
        document.getElementById("TmInTime").value = formatTime(d.V_TIME);
        document.getElementById("TmRTime").value = formatTime(d.R_TIME);
        document.getElementById("TxtDrivername").value = d.DRIVER_NAME || '';
        document.getElementById("TxtVehicleNo").value = d.TRUCK_NO || '';
        document.getElementById("TxtVehicleRCNo").value = d.RC_NO || '';
        document.getElementById("NumContainerNo").value = d.CONTAINER_NO || '';
        document.getElementById("txtDLNo").value = d.DL_NO || '';
        document.getElementById("NumDriverMobile").value = d.DRIVER_NO || '';
        document.getElementById("TxtInsuranceNo").value = d.INSU_NO || '';
        document.getElementById("txtPANNO").value = d.PAN_NO || '';
        document.getElementById("txtPurpose").value = d.PURPOSE || '';
        document.getElementById("ddlContainerSize").value = d.CONTAINER_SIZE || '';
        document.getElementById("ddlDONo").value = d.DISP_PLAN_NO || '';
        document.getElementById("TxtAdd1TIR").value = d.ADD1 || '';
        document.getElementById("TxtAdd2TIR").value = d.ADD2 || '';
        document.getElementById("TxtAdd3PD").value = d.ADD3 || '';
        document.getElementById("ddlCity").value = d.PARTY_CITY || '';
        document.getElementById("TxtRemarks").value = d.REMARKS || '';
        GetCustomerList(d.PARTY_CODE);
        GetTransportList(d.TRANSPORT_CODE);

        //================================Correction======================
        document.getElementById("txtVehicleBody").value = d.PARTY_WBSLIPNO || '';
        document.getElementById("TxtVehicleRemarks").value = d.Remarks2 || '';
        document.getElementById("txtPassWeight").value = d.PARTY_WBGRWT || '';

        let currentDate = setCurrentDate();

        if(d.INSU_EXPDT){
            $('#chkValidity').prop('checked', true);
            $('#DtValidity').val(formatDateToBind(d.INSU_EXPDT));
            $('#DtValidity').prop('disabled', false);
        }
        else{
            $('#chkValidity').prop('checked', false);
            $('#DtValidity').val(formatDateToBind(currentDate));
        }
        if(d.EWB_DATE){
            $('#chkFitmentValidity').prop('checked', true);
            $('#DtFitmentValidity').val(formatDateToBind(d.EWB_DATE));
            $('#DtFitmentValidity').prop('disabled', false);
        }
        else{
            $('#chkFitmentValidity').prop('checked', false);
            $('#DtFitmentValidity').val(formatDateToBind(currentDate));
        }
        if(d.CHALL_DATE){
            $('#chkTaxValidity').prop('checked', true);
            $('#DtTaxValidity').val(formatDateToBind(d.CHALL_DATE));
            $('#DtTaxValidity').prop('disabled', false);
        }
        else{
            $('#chkTaxValidity').prop('checked', false);
            $('#DtTaxValidity').val(formatDateToBind(currentDate));
        }

        if (d.IMAGEPATH !== null && d.IMAGEPATH !== '') {
            const imgUrl = `/Attachments/TransportInward/${d.IMAGEPATH}`;

            $('#imgPreview').attr('src', imgUrl);
            $('#previewContainer').show();
        } else {
            $('#imgPreview').attr('src', '');
            $('#previewContainer').hide();
        }
        //========================================
    }
