@{
    ViewBag.Title = " Material Inward Entry List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentMenu = ViewBag.CurrentMenu as string;
    bool canAdd = false;
    bool canEdit = false;
    bool canDelete = false;
    bool canPrint = false;
    bool canExport = false;
    bool canMail = false;
    bool canApproval = false;
    bool canDocDetail = false;

    foreach (var permission in Model.UserMenuPermissions)
    {
        if (permission.DISPLAY_NAME == ViewBag.CurrentMenu)
        {
            canAdd = Model.UserLevel == 1 || permission._ADD == 1;
            canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
            canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
            canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
            canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
            canMail = Model.UserLevel == 1 || permission._MAIL == 1;
            canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
            canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
            break;
        }
    }

}

<!-- HEADER -->
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>Material Inward Entry List</span>
    </div>

    @if (canAdd == true)
    {
        <div class="erppagelist-header-right">
            <button type="button" class="erppage-header-back" onclick="location.href='@Url.Action("Index", "InwardEntry")'">  <i class="fa fa-plus"></i> Add New  </button>
        </div>
    }
</div>

<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" id="searchBox" placeholder="Search by All Columns Name...." />
    </div>

    <div class="erppagelist-actions">

        @if(canPrint)
        {
            <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" id="btn_Report">
                <i class="fa fa-print"></i>Print
            </button>
        }

        @if(canExport)
        {
            <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" id="btn_exportPdf">
            <i class="fa fa-file-excel"></i>Export
            </button>
        }
    
    </div>
</div>

<!-- TABLE -->
<div class="erppagelist-container">
    <div class="excel-wrapper fixed-grid-wrapper">
        <table id="tblInwardEntryList" class="excel-table fixed-grid-table table-width resizable-table">

            <colgroup>
                <col class="hidden-col">
                <col style="width: 81px;">
                <col style="width: 119px;">
                <col style="width: 82px;">
                <col style="width: 95px;">
                <col style="width: 114px;">
                <col style="width: 85px;">
                <col style="width: 150px;">
                <col style="width: 85px;">
                <col style="width: 85px;">
                <col style="width: 100px;">
                <col style="width: 100px;">
                <col style="width: 100px;">
                <col style="width: 120px;">
            </colgroup>

            <thead>
                <tr>
                    <th class="hidden-col">Code</th>
                    <th>Doc No</th>
                    <th>Doc Type</th>
                    <th>Doc Date</th>
                    <th>Truck No</th>
                    <th>Bill No</th>
                    <th>Bill Date</th>
                    <th>Party Name</th>
                    <th>Transit No</th>
                    <th>Waybill No</th>
                    <th>RDate</th>
                    <th>RTime</th>
                    <th>Status</th>
                    <th class="action-col">Action</th>
                </tr>
            </thead>

            <tbody></tbody>
        </table>
    </div>

    <!-- PAGINATION -->
    <div class="erppagelist-pagination">

        <div class="pagination-left">
            <select id="pageSizeSelect" onchange="changeRowsPerPage()">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>

        <div class="pagination-center">
            <button onclick="prevPage()" class="page-nav" id="prevBtn">‹</button>
            <div id="pageNumbers" class="page-numbers"></div>
            <button onclick="nextPage()" class="page-nav" id="nextBtn">›</button>
        </div>

        <div class="pagination-right" id="pageInfoText">
            Results: 0 - 0 of 0
        </div>

    </div>
</div>

<!-- SCRIPT -->
<script>

    let currentPage = 1;
    let pageSize = 10;
    let totalCount = 0;

    $(document).ready(function () {

        loadAllInward();

        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadAllInward();
        });

        $('#btn_exportPdf').on('click', function () {
            var text = $('#searchBox').val();
            window.location.href = '/InwardEntryList/ExportToExcel?searchTerm=' + encodeURIComponent(text);
        });

        $('#btn_Report').on('click', function () {
            var text = $('#searchBox').val();
            window.open('/InwardEntryList/ExportToPdf?searchTerm=' + encodeURIComponent(text), '_blank');
        });

    });

    // ================= LOAD DATA =================
    function loadAllInward() {

        $.ajax({
            url: '/InwardEntryList/GetList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: $('#searchBox').val(),
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {

                if (!res.success) {
                    toastr.error("Failed to load data.");
                    return;
                }

                const list = res.lists || [];
                totalCount = res.totalCount || 0;

                renderTable(list);
                renderPagination();
            },
            error: function (xhr) {
                toastr.error('Error loading list: ' + xhr.responseText);
            }
        });
    }

    // ================= TABLE =================
    function renderTable(list) {

        const tbody = $('#tblInwardEntryList tbody');
        tbody.empty();

        if (!list || list.length === 0) {
            tbody.append('<tr><td colspan="13" class="text-center text-muted">No list found.</td></tr>');
            return;
        }

        $.each(list, function (index, item) {
            tbody.append(`
                <tr>
                    <td style="display:none;">${item.v_NO || ''}</td>
                    <td>${item.v_NO || ''}</td>
                    <td>${item.v_TYPE || ''}</td>
                    <td>${formatDate(item.v_DATE)}</td>
                    <td>${item.trucK_NO || ''}</td>
                    <td>${item.bilL_NO || ''}</td>
                    <td>${formatDate(item.bilL_DATE)}</td>
                    <td>${item.partY_NAME || ''}</td>
                    <td>${item.transiT_NO || ''}</td>
                    <td>${item.waybilL_NO || ''}</td>
                    <td>${formatDate(item.r_DATE)}</td>
                    <td>${item.r_TIME || ''}</td>
                    <td>${item.status || ''}</td>

                    <td class="action-col">
                    <div class="action-wrap">
                    @if (canEdit)
                    {
                         <button class="act-btn edit btn-edit" onclick="AddOrEditFunction('${item.v_NO}','${item.vtypeCode}' ,'${item.v_DATE}')"><i class="fa fa-edit"></i></button>
                    }        
                                          
                  <button class="act-btn view btn-view" onclick="viewMenuDetails('${item.v_NO}','${item.vtypeCode}')"><i class="fa fa-eye"></i></button>

                   @if (canDelete)
                    {
                        <button class="act-btn delete btn-delete" onclick="deleteTemp('${item.v_NO}','${item.vtypeCode}')"><i class="fa fa-trash"></i></button>
                    }              
                
                        <button class="act-btn document btn-document" onclick="showDocumentPopup('${item.doC_ID}')"><i class="fa fa-file"></i></button>
                        </div>
                    </td>
                </tr>
            `);
        });
    }

    // ================= PAGINATION =================
    function renderPagination() {

        const totalPages = Math.ceil(totalCount / pageSize) || 1;

        let html = '';
        let maxVisible = 5;

        let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
        let endPage = startPage + maxVisible - 1;

        if (endPage > totalPages) {
            endPage = totalPages;
            startPage = Math.max(1, endPage - maxVisible + 1);
        }

        if (startPage > 1) {
            html += `<span class="page-number" onclick="goToPage(1)">1</span>`;
            if (startPage > 2) html += `<span class="dots">...</span>`;
        }

        for (let i = startPage; i <= endPage; i++) {
            html += `<span class="page-number ${i === currentPage ? 'active' : ''}"
                        onclick="goToPage(${i})">${i}</span>`;
        }

        if (endPage < totalPages) {
            if (endPage < totalPages - 1) html += `<span class="dots">...</span>`;
            html += `<span class="page-number" onclick="goToPage(${totalPages})">${totalPages}</span>`;
        }

        $('#pageNumbers').html(html);

        let start = (currentPage - 1) * pageSize + 1;
        let end = Math.min(currentPage * pageSize, totalCount);

        if (totalCount === 0) {
            start = 0;
            end = 0;
        }

        $('#pageInfoText').text(`Results: ${start} - ${end} of ${totalCount}`);

        $('#prevBtn').prop('disabled', currentPage === 1);
        $('#nextBtn').prop('disabled', currentPage === totalPages);
    }

    // ================= PAGINATION ACTIONS =================
    function prevPage() {
        if (currentPage > 1) {
            currentPage--;
            loadAllInward();
        }
    }

    function nextPage() {
        const totalPages = Math.ceil(totalCount / pageSize);
        if (currentPage < totalPages) {
            currentPage++;
            loadAllInward();
        }
    }

    function goToPage(page) {
        currentPage = page;
        loadAllInward();
    }

    function changeRowsPerPage() {
        pageSize = parseInt($('#pageSizeSelect').val());
        currentPage = 1;
        loadAllInward();
    }

    // ================= UTIL =================
    function formatDate(dateStr) {
        if (!dateStr) return '';
        const d = new Date(dateStr);
        if (isNaN(d)) return '';

        const day = String(d.getDate()).padStart(2, '0');
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const year = d.getFullYear();

        return `${day}-${month}-${year}`;
    }

    // ================= ACTIONS =================
    function AddOrEditFunction(code, vtype , v_DATE) {
        Cheackview(vtype,code ,v_DATE);
    
    }

    function viewMenuDetails(code, vtype) { 
        window.location.href = `/InwardEntry/Index?id=${encodeURIComponent(code)}&vtype=${encodeURIComponent(vtype)}&mode=view`;
    }

    function Cheackview(v_type, v_no, vdate) {

        $.ajax({
            url: '/InwardEntryList/CheackEdit',
            type: 'POST',
            data: {
                v_type: v_type,
                v_no: v_no,
                v_DATE: formatDate(vdate)
            },
            success: function (res) {
                  console.log("res.status",res.status);
                if (res.status== false )
                {   
                    Swal.fire({
                    title: 'Warning',
                    text: res.message,
                    icon: 'warning',
                    confirmButtonText: 'OK'
                    });
                    return ;
                }        
                else{
                   window.location.href = `/InwardEntry/Index?id=${encodeURIComponent(v_no)}&vtype=${encodeURIComponent(v_type)}`;
                }


            },
            error: function (xhr) {
                alert("Error: " + xhr.responseText);
            }
        });
    }




    function deleteTemp(code, VType) {

        Swal.fire({
            title: "Are you sure?",
            text: "You want to delete this Inward Entry?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {

            if (result.isConfirmed) {

                $.ajax({
                    url: '/InwardEntryList/Delete',
                    type: 'POST',
                    data: { code: code, VType: VType },
                    success: function (res) {

                        if (res.success) {
                            toastr.success(res.message || "Deleted successfully");
                            loadAllInward();
                        } else {
                            toastr.error(res.message || 'Failed to delete.');
                        }
                    },
                    error: function () {
                        toastr.error('Error deleting record.');
                    }
                });
            }
        });
    }

    function showDocumentPopup(docCode) {

        $.ajax({
            url: '/InwardEntryList/DocDetailsCode',
            type: 'POST',
            dataType: 'json',
            data: { docCode: docCode },
            success: function (response) {
                if (response.success) {
                    showDocumentPopupjQuery(response.data, docCode);
                } else {
                    toastr.error("Failed to get document details.");
                }
            },
            error: function () {
                toastr.error("Error fetching document details.");
            }
        });
    }

</script>