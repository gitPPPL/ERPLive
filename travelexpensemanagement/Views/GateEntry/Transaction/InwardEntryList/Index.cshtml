@{
    ViewBag.Title = " Material Inward Entry List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .erp-search {
        display: flex;
        align-items: center;
        width: 360px;
        height: 30px;
        background: linear-gradient(#f2f2f2, #e7e7e7);
        border: 1px solid #b5b5b5;
        border-radius: 4px;
        overflow: hidden;
    }

    /* Input */
    .erp-search-input {
        flex: 1;
        height: 100%;
        border: none;
        outline: none;
        padding: 0 10px;
        font-size: 12px;
        background: #00000000;
        color: #3c3c3c;
    }

        .erp-search-input::placeholder {
            color: #8f8f8f;
        }

    /* Button */
    .erp-search-button {
        width: 30px;
        height: 100%;
        border: none;
        cursor: pointer;
        background: linear-gradient(#93be52, #34733a);
        border-left: 1px solid #b5b5b5;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .erp-search-button:hover {
            background: linear-gradient(#555, #333);
        }

        .erp-search-button:active {
            background: linear-gradient(#2f2f2f, #1f1f1f);
        }

    /* Magnifier icon (pure CSS) */
    .erp-search-icon {
        position: relative;
        width: 12px;
        height: 12px;
        border: 2px solid #fff;
        border-radius: 50%;
    }

        .erp-search-icon::after {
            content: "";
            position: absolute;
            width: 7px;
            height: 2px;
            background: #fff;
            bottom: -4px;
            right: -5px;
            transform: rotate(45deg);
        }
</style>

<fieldset>
    <legend class="legend-field">Inward Entry List</legend>
    <div class="row">
        <div class="col-lg-6">
  
            <div class="erp-search">
                <input type="text" id="searchBox" class="erp-search-input" placeholder="Search by All Columns Name..." />
                <button class="erp-search-button">
                    <span class="erp-search-icon"></span>
                </button>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="btn-rightalign">
                <button id="btnSave" onclick="window.location.href='@Url.Action("Index", "InwardEntry")'" type="submit" class="btn btn-add">
                    <i class="fa fa-plus"></i>Add
                </button>
                <button class="btn btn-print" id="btn_Report">
                    <i class="fa fa-print"></i> Print
                </button>
                <button class="btn btn-export" id="btn_exportPdf">
                    <i class="fas fa-file-export"></i> Export
                </button>      
            </div>
        </div>
    </div>
    <div class="card">
        <div class="table-responsive">
            <table id="tblInwardEntryList" class="table-width">
                <thead class="table-head">
                    <tr>
                        <th style="display:none;">Code</th>
                        <th>Voucher No</th>
                        <th>Voucher Type</th>
                        <th>Voucher Date</th>
                        <th>Truck No</th>
                        <th>Bill No</th>
                        <th>Bill Date</th>
                        <th>Party Name</th>
                        <th>Transit No</th>
                        <th>Waybill No</th>
                        <th>RDate</th>
                        <th>RTime</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <!-- Pagination container -->
        <div class="row">
            <div class="col-md-12">
                <div class="pagination-end">
                    <div class="custom-pagination" id="tablePagination"></div>
                </div>
            </div>
        </div>
    </div>
</fieldset>

<script>

    let currentPage = 1;
    let pageSize = 10;

    $(document).ready(function () {
        loadAllMenus();

        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadAllMenus();
        });


        $('#btn_exportPdf').on('click', function () {
            var text = $('#searchBox').val();
            var url = '/InwardEntryList/ExportToExcel?searchTerm=' + encodeURIComponent(text);
            window.location.href = url;
        });

        $('#btn_Report').on('click', function () {
            var text = $('#searchBox').val();
            var url = '/InwardEntryList/ExportToPdf?searchTerm=' + encodeURIComponent(text);

            window.open(url, '_blank');
        });

    });


    function loadAllMenus() {
        const searchTerm = $('#searchBox').val();

        $.ajax({
            url: '/InwardEntryList/GetList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                if (!res.success) {
                    toastr.error("Failed to load data.");
                    return;
                }
                const list = res.lists;
                const totalCount = res.totalCount;
                const tbody = $('#tblInwardEntryList tbody'); 

                tbody.empty();

                if (list.length === 0) {
                    tbody.append('<tr><td colspan="12" class="text-center text-muted">No list found.</td></tr>');
                } else {
                    $.each(list, function (index, item) {
                        tbody.append(`
                            <tr>
                                <td>${item.v_NO}</td>
                                <td>${item.v_TYPE}</td>
                                <td>${formatDate(item.v_DATE)}</td>
                                <td>${item.trucK_NO}</td>
                                <td>${item.bilL_NO}</td>
                                <td>${formatDate(item.bilL_DATE)}</td>
                                <td>${item.partY_NAME}</td>
                                <td>${item.transiT_NO}</td>
                                <td>${item.waybilL_NO}</td>
                                <td>${formatDate(item.r_DATE)}</td>
                                <td>${item.r_TIME}</td>
                                <td>${item.status}</td>
                                <td>
                                    <i class="fa fa-edit btn-edit" data-bs-toggle="tooltip" title="Edit" onclick="AddOrEditFunction('${item.v_NO}','${item.vtypeCode}')"></i>
                                    <i class="fa fa-eye btn-view" data-bs-toggle="tooltip" title="View" onclick="viewMenuDetails('${item.v_NO}', '${item.vtypeCode}')"></i>
                                    <i class="fa fa-trash btn-delete" data-bs-toggle="tooltip" title="Delete" onclick="deleteTemp('${item.v_NO}', '${item.vtypeCode}')"></i>
                                    <i class="fa fa-file btn-document" data-bs-toggle="tooltip" data-bs-title="Document Details" data-doc="${item.doC_ID}" onclick="showDocumentPopup('${item.doC_ID}')"></i>
                                </td>
                            </tr>
                        `);
                    });
                    renderPagination(totalCount, pageSize, currentPage);
                }
            },
            error: function (xhr) {
                toastr.error('Error loading menu list: ' + xhr.responseText);

            }
        });
    }


    function formatDate(dateStr) {
        if (!dateStr) return '';
        const d = new Date(dateStr);
        if (isNaN(d)) return '';

        const day = String(d.getDate()).padStart(2, '0');
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const year = d.getFullYear();

        return `${day}-${month}-${year}`;
    }
  
    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const pagination = $('#tablePagination');
        pagination.empty();

        if (totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        const startPage = Math.max(1, currentPage - 2);
        const endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
            html += `
                <button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        pagination.html(html);
    }

    function goToPage(page) {
        currentPage = page;
        loadAllMenus();
    }

    function AddOrEditFunction(code, vtype) {
        window.location.href = `/InwardEntry/Index?id=${encodeURIComponent(code)}&vtype=${encodeURIComponent(vtype)}`;
    }

    function viewMenuDetails(code, vtype) {
        window.location.href = '/InwardEntry/Index?id=' + encodeURIComponent(code) + '&vtype=' + encodeURIComponent(vtype) + '&mode=view';
    }

       function deleteTemp(code, VType) {
        Swal.fire({
            title: "Are you sure?",
            text: "You want to delete this Inward Entry?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Yes, delete it!",
            cancelButtonText: "Cancel"
        }).then((result) => {
            if (result.isConfirmed) {

                $.ajax({
                    url: '/InwardEntryList/Delete',
                    type: 'POST',
                    data: { code: code, VType: VType },
                    success: function (res) {

                        if (res.success) {

                            if (res.message === "Successfully Delete") {
                                toastr.success(res.message);
                            } else {
                                toastr.warning(res.message);
                            }
                            loadAllMenus();

                        } else {
                            toastr.error(res.message || 'Failed to delete.');
                        }
                    },
                    error: function (xhr, status, error) {
                        toastr.error(`Error deleting: ${xhr.responseText || error}`);
                    }
                });

            }
        });
    }

    function showDocumentPopup(docCode) {
        $.ajax({
            url: '/InwardEntryList/DocDetailsCode',
            type: 'POST',
            dataType: 'json',
            data: { docCode: docCode },
            success: function(response) {
                if(response.success) {
                    showDocumentPopupjQuery(response.data, docCode);
                } else {
                    toastr.error("Failed to get document details.");
                }
            },
            error: function() {
                toastr.error("An error occurred while fetching document details.");
            }
        });
    }


</script>









