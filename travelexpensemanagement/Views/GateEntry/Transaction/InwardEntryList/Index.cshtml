@{
    ViewBag.Title = " Material Inward Entry List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- HEADER -->
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>Material Inward Entry List</span>
    </div>
    <div class="erppagelist-header-right">
        <button type="button" class="erppage-header-back" onclick="location.href='@Url.Action("Index", "InwardEntry")'">
            <i class="fa fa-plus"></i>Add New
        </button>
    </div>
</div>
<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" id="searchBox" placeholder="Search by All Columns Name...." />
    </div>
    <div class="erppagelist-actions">
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" id="btn_Report">
            <i class="fa fa-print"></i>Print
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" id="btn_exportPdf" data-tooltip="Export to Excel">
            <i class="fa fa-file-excel"></i>Export
        </button>
    </div>
</div>
<div class="erppagelist-container">
    <div class="excel-wrapper fixed-grid-wrapper">
        <table id="tblInwardEntryList" class="excel-table fixed-grid-table">
            <colgroup>
                <col style="display:none;" /> <!-- FIXED -->
                <col style="width: 120px;" />  <!-- Voucher No -->
                <col style="width: 130px;" />  <!-- Voucher Type -->
                <col style="width: 120px;" />  <!-- Voucher Date -->
                <col style="width: 100px;" />  <!-- Truck No -->
                <col style="width: 120px;" />  <!-- Bill No -->
                <col style="width: 120px;" />  <!-- Bill Date -->
                <col style="width: 150px;" />  <!-- Party Name -->
                <col style="width: 130px;" />  <!-- Transit No -->
                <col style="width: 140px;" />  <!-- Waybill No -->
                <col style="width: 100px;" />  <!-- RDate -->
                <col style="width: 100px;" />  <!-- RTime -->
                <col style="width: 100px;" />  <!-- Status -->
                <col style="width: 120px;" />  <!-- Action -->
            </colgroup>
            <thead>
                <tr>
                    <th style="display:none;">Code</th>
                    <th>Voucher No</th>
                    <th>Voucher Type</th>
                    <th>Voucher Date</th>
                    <th>Truck No</th>
                    <th>Bill No</th>
                    <th>Bill Date</th>
                    <th>Party Name</th>
                    <th>Transit No</th>
                    <th>Waybill No</th>
                    <th>RDate</th>
                    <th>RTime</th>
                    <th>Status</th>
                    <th class="action-col">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    <!-- Pagination Section -->
    <div class="erppagelist-pagination">
        <div class="pagination-left">
            <select id="pageSizeSelect" onchange="changeRowsPerPage()">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="pagination-center">
            <button onclick="prevPage()" class="page-nav" id="prevBtn">‹</button>
            <div id="pageNumbers" class="page-numbers"></div>
            <button onclick="nextPage()" class="page-nav" id="nextBtn">›</button>
        </div>
        <div class="pagination-right" id="pageInfoText">
            Results: 0 - 0 of 0
        </div>
    </div>
</div>
<script>

    let currentPage = 1;
    let pageSize = 10;

    $(document).ready(function () {
        loadAllMenus();

        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadAllMenus();
        });


        $('#btn_exportPdf').on('click', function () {
            var text = $('#searchBox').val();
            var url = '/InwardEntryList/ExportToExcel?searchTerm=' + encodeURIComponent(text);
            window.location.href = url;
        });

        $('#btn_Report').on('click', function () {
            var text = $('#searchBox').val();
            var url = '/InwardEntryList/ExportToPdf?searchTerm=' + encodeURIComponent(text);

            window.open(url, '_blank');
        });

    });


    function loadAllMenus() {
        const searchTerm = $('#searchBox').val();

        $.ajax({
            url: '/InwardEntryList/GetList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                if (!res.success) {
                    toastr.error("Failed to load data.");
                    return;
                }
                const list = res.lists;
                const totalCount = res.totalCount;
                const tbody = $('#tblInwardEntryList tbody'); 

                tbody.empty();

                if (list.length === 0) {
                    tbody.append('<tr><td colspan="12" class="text-center text-muted">No list found.</td></tr>');
                } else {
                    $.each(list, function (index, item) {
                        tbody.append(`
                            <tr>
                                <td>${item.v_NO}</td>
                                <td>${item.v_TYPE}</td>
                                <td>${formatDate(item.v_DATE)}</td>
                                <td>${item.trucK_NO}</td>
                                <td>${item.bilL_NO}</td>
                                <td>${formatDate(item.bilL_DATE)}</td>
                                <td>${item.partY_NAME}</td>
                                <td>${item.transiT_NO}</td>
                                <td>${item.waybilL_NO}</td>
                                <td>${formatDate(item.r_DATE)}</td>
                                <td>${item.r_TIME}</td>
                                <td>${item.status}</td>
                                <td class="action-col">
                                    <button class="act-btn edit" title="Edit" style="cursor:pointer;" onclick="AddOrEditFunction('${item.v_NO}','${item.vtypeCode}')"><i class="fa fa-edit"></i></button>
                                    <button class="act-btn view" title="View" style="cursor:pointer;" onclick="viewMenuDetails('${item.v_NO}', '${item.vtypeCode}')"><i class="fa fa-eye"></i></button>
                                    <button class="act-btn delete" title="Delete" style="cursor:pointer;" onclick="deleteTemp('${item.v_NO}', '${item.vtypeCode}')"><i class="fa fa-trash"></i></button>
                                    <button class="act-btn document" title="Document" style="cursor:pointer;" data-doc="${item.doC_ID}" onclick="showDocumentPopup('${item.doC_ID}')"><i class="fa fa-file"></i></button>
                                   
                                </td>
                            </tr>
                        `);
                    });
                    renderPagination(totalCount, pageSize, currentPage);
                }
            },
            error: function (xhr) {
                toastr.error('Error loading menu list: ' + xhr.responseText);

            }
        });
    }


    function formatDate(dateStr) {
        if (!dateStr) return '';
        const d = new Date(dateStr);
        if (isNaN(d)) return '';

        const day = String(d.getDate()).padStart(2, '0');
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const year = d.getFullYear();

        return `${day}-${month}-${year}`;
    }
  
    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const pagination = $('#tablePagination');
        pagination.empty();

        if (totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        const startPage = Math.max(1, currentPage - 2);
        const endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
            html += `
                <button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        pagination.html(html);
    }

    function goToPage(page) {
        currentPage = page;
        loadAllMenus();
    }

    function AddOrEditFunction(code, vtype) {
        window.location.href = `/InwardEntry/Index?id=${encodeURIComponent(code)}&vtype=${encodeURIComponent(vtype)}`;
    }

    function viewMenuDetails(code, vtype) {
        window.location.href = '/InwardEntry/Index?id=' + encodeURIComponent(code) + '&vtype=' + encodeURIComponent(vtype) + '&mode=view';
    }

       function deleteTemp(code, VType) {
        Swal.fire({
            title: "Are you sure?",
            text: "You want to delete this Inward Entry?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Yes, delete it!",
            cancelButtonText: "Cancel"
        }).then((result) => {
            if (result.isConfirmed) {

                $.ajax({
                    url: '/InwardEntryList/Delete',
                    type: 'POST',
                    data: { code: code, VType: VType },
                    success: function (res) {

                        if (res.success) {

                            if (res.message === "Successfully Delete") {
                                toastr.success(res.message);
                            } else {
                                toastr.warning(res.message);
                            }
                            loadAllMenus();

                        } else {
                            toastr.error(res.message || 'Failed to delete.');
                        }
                    },
                    error: function (xhr, status, error) {
                        toastr.error(`Error deleting: ${xhr.responseText || error}`);
                    }
                });

            }
        });
    }

    function showDocumentPopup(docCode) {
        $.ajax({
            url: '/InwardEntryList/DocDetailsCode',
            type: 'POST',
            dataType: 'json',
            data: { docCode: docCode },
            success: function(response) {
                if(response.success) {
                    showDocumentPopupjQuery(response.data, docCode);
                } else {
                    toastr.error("Failed to get document details.");
                }
            },
            error: function() {
                toastr.error("An error occurred while fetching document details.");
            }
        });
    }


</script>









