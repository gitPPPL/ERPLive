@{
	ViewBag.Title = "Visitor Inward List";
	Layout = "~/Views/Shared/_Layout.cshtml";

	var currentMenu = ViewBag.CurrentMenu as string;
	bool canAdd = false;
	bool canEdit = false;
	bool canDelete = false;
	bool canPrint = false;
	bool canExport = false;
	bool canMail = false;
	bool canApproval = false;
	bool canDocDetail = false;

	foreach (var permission in Model.UserMenuPermissions)
	{
		if (permission.DISPLAY_NAME == ViewBag.CurrentMenu)
		{
			canAdd = Model.UserLevel == 1 || permission._ADD == 1;
			canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
			canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
			canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
			canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
			canMail = Model.UserLevel == 1 || permission._MAIL == 1;
			canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
			canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
			break;
		}
	}
}

<div id="erp-toast-container"></div>
<!-- HEADER -->
<div class="erppagelist-header">
	<div class="erppagelist-title">
		<i class="fa fa-list"></i>
		<span>Visitor Entry List</span>
	</div>
	<div class="erppagelist-header-right">
		@if (canAdd)
		{
			<button class="erppagelist-btn erppagelist-btn-add erppagelist-btn-add" onclick="location.href='@Url.Action("Index", "VisitorEntry")'">
				<i class="fa fa-plus"></i>Add New
			</button>
		}
	</div>
</div>
<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
	<div class="erppagelist-search-wrapper">
		<i class="fa fa-search"></i>
		<input type="text" id="tableSearch" placeholder="Search by All Columns Name...." />
	</div>
	<div class="erppagelist-actions">
		@if (canPrint)
		{
			<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" id="btnPrint" onclick="PendingQCReport()">
				<i class="fa fa-print"></i>Print
			</button>
		}
		@if (canExport)
		{
			<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" id="btnExport" data-tooltip="Export to Excel">
				<i class="fa fa-file-excel"></i>Export
			</button>
		}
	</div>
</div>
<div class="erppagelist-container">
	<div class="excel-wrapper fixed-grid-wrapper">
		<table id="tblVisitorEntry" class="excel-table fixed-grid-table">
			<colgroup>
				<col style="display:none;" /> 
				<col style="width: 80px;" />  
				<col style="width: 110px;" /> 
				
				<col style="width: 150px;" /> 
				<col style="width: 180px;" /> 
				<col style="width: 65px;" />  
				<col style="width: 75px;" />  
				<col style="width: 150px;" /> 
				<col style="width: 100px;" /> 
				<col style="width: 150px;" /> 
				<col style="width: 100px;" /> 
				<col style="width: 100px;" /> 
				
				<col style="width: 140px;" /> 
			</colgroup>
			<thead>
				<tr>
					<th style="display:none;">Code</th>
					<th>Serial No</th>
					<th>Visit Date</th>
					<th>Visitor Name</th>
					<th>Organization</th>
					<th>In Time</th>
					<th>Out Time</th>
					<th>Meet Person</th>
					<th>Purpose</th>
					<th>Address</th>
					<th>Mobile</th>
					<th>Vehicle No</th>
					<th class="action-col">Action</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>

	</div>

	<div class="erppagelist-pagination">
		<div class="pagination-left">
			<select id="pageSizeSelect" onchange="changeRowsPerPage()">
				<option value="5">5</option>
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
			</select>
		</div>
		<div class="pagination-center">
			<button onclick="prevPage()" class="page-nav" id="prevBtn">‹</button>
			<div id="pageNumbers" class="page-numbers"></div>

			<button onclick="nextPage()" class="page-nav" id="nextBtn">›</button>
		</div>
		<div class="pagination-right" id="pageInfoText">
			Results: 0 - 0 of 0
		</div>
	</div>
</div>

<script src="~/common/delete.js"></script>
<script src="~/js/erpjs/gateentry/transaction/visitorentrylistjs/visitorentrylist.js"></script>

<script>
	window.permissions = {
		canEdit: @canEdit.ToString().ToLower(),
		canDelete: @canDelete.ToString().ToLower(),
		canDocDetail: @canDocDetail.ToString().ToLower()
	};
</script>

