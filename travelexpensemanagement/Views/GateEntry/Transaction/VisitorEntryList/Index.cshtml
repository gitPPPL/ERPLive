@{
	ViewBag.Title = "Visitor Entry List";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-center-toast-container"></div>
<!-- HEADER -->
<div class="erppagelist-header">
	<div class="erppagelist-title">
		<i class="fa fa-list"></i>
		<span>Visitor Entry List</span>
	</div>
	<div class="erppagelist-header-right">
		<button class="erppagelist-btn erppagelist-btn-add erppagelist-btn-add" onclick="location.href='@Url.Action("Index", "VisitorEntry")'">
			<i class="fa fa-plus"></i>Add New
		</button>
	</div>
</div>
<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
	<div class="erppagelist-search-wrapper">
		<i class="fa fa-search"></i>
		<input type="text" id="tableSearch" placeholder="Search by All Columns Name...." />
	</div>
	<div class="erppagelist-actions">
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" id="btnPrint">
			<i class="fa fa-print"></i>Print
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" id="btnExport" data-tooltip="Export to Excel">
			<i class="fa fa-file-excel"></i>Export
		</button>

	</div>
</div>
<div class="erppagelist-container">
	<div class="excel-wrapper fixed-grid-wrapper">
		<table id="tblVisitorEntry" class="excel-table fixed-grid-table">
			<colgroup>
				<col style="display:none;" /> 
				<col style="width: 80px;" />  
				<col style="width: 110px;" /> 
				<col style="width: 150px;" /> 
				<col style="width: 180px;" /> 
				<col style="width: 65px;" />  
				<col style="width: 75px;" />  
				<col style="width: 150px;" /> 
				<col style="width: 100px;" /> 
				<col style="width: 150px;" /> 
				<col style="width: 100px;" /> 
				<col style="width: 100px;" /> 
				<col style="width: 140px;" /> 
			</colgroup>
			<thead>
				<tr>
					<th style="display:none;">Code</th>
					<th>Serial No</th>
					<th>Visit Date</th>
					<th>Visitor Name</th>
					<th>Organization</th>
					<th>In Time</th>
					<th>Out Time</th>
					<th>Meet Person</th>
					<th>Purpose</th>
					<th>Address</th>
					<th>Mobile</th>
					<th>Vehicle No</th>
					<th class="action-col">Action</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>

	</div>

	<div class="erppagelist-pagination">
		<div class="pagination-left">
			<select id="pageSizeSelect" onchange="changeRowsPerPage()">
				<option value="5">5</option>
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
			</select>
		</div>
		<div class="pagination-center">
			<button onclick="prevPage()" class="page-nav" id="prevBtn">‹</button>
			<div id="pageNumbers" class="page-numbers"></div>

			<button onclick="nextPage()" class="page-nav" id="nextBtn">›</button>
		</div>
		<div class="pagination-right" id="pageInfoText">
			Results: 0 - 0 of 0
		</div>
	</div>
</div>
<script src="~/common/pagination.js"></script>

<script>
	let visitorPagination;
	$(document).ready(function () {
		visitorPagination = Pagination.create({
			pageSize: 10,
			paginationContainer: '#pageNumbers',
			infoContainer: '#pageInfoText',

			loader: function (params) {
				$('.circle-loader').css('display', 'flex');
				$.ajax({
					url: '/VisitorEntryList/GetAllVisitors',
					type: 'GET',
					dataType: 'json',
					data: {
						searchTerm: $('#tableSearch').val(),
						pageNumber: params.pageNumber,
						pageSize: params.pageSize
					},
					success: function (res) {
						params.callback({
							data: res.visitors,
							totalCount: res.totalCount
						});
					},
					error: function () {
						alert('Error loading data');
					},
					complete: function () {
						$('.circle-loader').hide();
					}
				});
			},
			render: function (visitors) {
				let tbody = $('#tblVisitorEntry tbody');
				tbody.empty();

				if (!visitors.length) {
					tbody.append('<tr><td colspan="12" class="text-center">No visitors found</td></tr>');
					return;
				}
				$.each(visitors, function (index, item) {
					tbody.append(`
						<tr>
							<td style="display:none;">${item.doC_ID || ''}</td>
							<td>${item.v_NO || ''}</td>
							<td>${item.v_DATE ? formatDate(item.v_DATE) : ''}</td>
							<td>${item.name || ''}</td>
							<td>${item.organization || ''}</td>
							<td>${item.iN_TIME || ''}</td>
							<td>${item.ouT_TIME || ''}</td>
							<td>${item.meeT_NAME || ''}</td>
							<td>${item.purpose || ''}</td>
							<td>${item.address || ''}</td>
							<td>${item.mobilE_NO || ''}</td>
							<td>${item.vehiclE_NO || ''}</td>
							<td class="action-col">
								<button class="act-btn edit" title="Edit" style="cursor:pointer;" onclick="editVisitor('${item.doC_ID}')"><i class="fa fa-edit"></i></button>
								<button class="act-btn view" title="View" style="cursor:pointer;" onclick="viewVisitor('${item.doC_ID}')"><i class="fa fa-eye"></i></button>
								<button class="act-btn delete" title="View" style="cursor:pointer;" onclick="deleteVisitor('${item.doC_ID}')"><i class="fa fa-trash"></i></button>

							</td>
						</tr>
					`);
				});
			}
		});

		// First Load
		visitorPagination.load();

		// Search
		$('#tableSearch').on('keyup', function () {
			visitorPagination.load();
		});

		// Export
		$('#btnExport').click(function () {
			const searchTerm = $('#tableSearch').val() || '';
			window.location.href = `/VisitorEntryList/ExportVisitorToExcel?searchTerm=${encodeURIComponent(searchTerm)}`;
		});

		// Print
		$('#btnPrint').click(function () {
			const searchTerm = $('#tableSearch').val() || '';
			window.open(`/VisitorEntryList/ExportVisitorToPdf?searchTerm=${encodeURIComponent(searchTerm)}`);
		});
	});

	// Page size change
	function changeRowsPerPage() {
		let size = parseInt($('#pageSizeSelect').val());
		visitorPagination.setPageSize(size);
	}

	// Date format
	function formatDate(dateString) {
		if (!dateString) return '';
		const date = new Date(dateString);
		return date.toLocaleDateString('en-GB');
	}

	// Navigation
	function editVisitor(id) {
		window.location.href = '/VisitorEntry/Index?docId=' + id;
	}

	function viewVisitor(id) {
		window.location.href = '/VisitorEntry/Index?docId=' + id + '&readOnly=true';
	}

	function deleteVisitor(id) {
		if (confirm('Delete this record?')) {
			$.post('/VisitorEntry/DeleteVisitorEntry', { docId: id }, function () {
				visitorPagination.load();
			});
		}
	}

</script>



