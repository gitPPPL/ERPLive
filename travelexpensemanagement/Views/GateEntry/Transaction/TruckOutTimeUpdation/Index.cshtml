@{
    ViewBag.Title = "Truck Out Time Updation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-clock"></i>
        </div>
        <div class="erppage-header-title">Truck Out Time Updation</div>
    </div>
    <div class="erppage-header-right">
    </div>
</div>
<div id="TruckOutTimeUpdationForm">
    <input type="hidden" class="form-control" id="TxtCode" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid5">
                <div class="erppage-divfield">
                    <label class="erppage-label">From Date</label>
                    <input type="date" class="erppage-input" id="DtFromDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">To Date</label>
                    <input type="date" class="erppage-input" id="DtToDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Report Type</label>
                    <select class="erppage-input erppage-select" id="ddlOutTime">
                        <option value="">Select Type</option>
                        <option value="Outward Pending">Outward Pending</option>
                        <option value="Outward Allowed">Outward Allowed</option>
                        <option value="All">All</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Type</label>
                    <select class="erppage-input erppage-select" id="ddlDocType">
                        <option>Select Type</option>
                        <option value="Inward">Inward</option>
                        <option value="Outward">Outward</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Vehicle No.</label>
                    <select class="erppage-input erppage-select" id="ddlTxtVehicleNo">
                        <option value="">Select Vehicle No.</option>
                    </select>
                </div>
            </div>
            <div class="erppage-internalaction mt-2">
                <button type="button" class="erppage-btn erppage-btn-common-disabled" onclick="loadTruckOutData()">
                    <i class="fa fa-download"></i>
                    <span>Load Data</span>
                </button>
                <button id="btn-save" type="submit" class="erppage-btn erppage-btn-save">
                    <i class="fa fa-save"></i>
                    <span>Update</span>
                </button>

                <button type="button" class="erppage-btn erppage-btn-danger" onclick="reloadPage()">
                    <i class="fa fa-close"></i> <span>Cancel</span>
                </button>

            </div>
            <div class="erppagelist-container">
                <div class="excel-wrapper fixed-grid-wrapper">
                    <table id="tblTruckOutTimeUpdation" class="excel-table fixed-grid-table width-table resizable-table">
                        <colgroup>
                            <col class="hidden-col">
                            <col class="hidden-col">
                            <col style="width: 106px;">
                            <col style="width: 77px;">
                            <col style="width: 82px;">
                            <col style="width: 133px;">
                            <col style="width: 91px;">
                            <col style="width: 66px;">
                            <col style="width:110px;">
                            <col style="width: 115px;">
                            <col style="width: 74px;">
                            <col style="width: 72px;">
                            <col style="width:80px;">
                        </colgroup>
                        <thead>
                            <tr>
                                <th class="hidden-col">VNO_HIDDEN</th>
                                <th class="hidden-col">DOC_ID</th>
                                <th>Doc Type</th>
                                <th>Doc No</th>
                                <th>Doc Date</th>
                                <th>Party Name</th>
                                <th>Vehicle No</th>
                                <th>In Time</th>
                                <th>Out Date</th>
                                <th>Out Time</th>
                                <th>Remarks</th>
                                <th>Out Allow</th>
                                <th class="action-col">
                                    <input type="checkbox" />
                                </th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="erppagelist-pagination">
                    <div class="pagination-left">
                        <select id="pageSizeSelect" onchange="changeRowsPerPage()">
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </div>
                    <div class="pagination-center">
                        <button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
                        <div id="pageNumbers" class="page-numbers"></div>
                        <button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
                    </div>
                    <div class="pagination-right" id="pageInfoText">
                        Results: 0 - 0 of 0
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
</div>

<script src="/common/pagination.js"></script>
<script src="/common/delete.js"></script>

<script>
    var truckPagination;
    $(document).ready(function () {
        // setTodayDate();
        var savedFromDate = localStorage.getItem("TruckFromDate");
        var savedToDate = localStorage.getItem("TruckToDate");
        if (savedFromDate && savedToDate) {
            $("#DtFromDate").val(savedFromDate);
            $("#DtToDate").val(savedToDate);
            $("#DtToDate").attr("min", savedFromDate);
            // Agar sirf ek baar use karna hai to remove kar do
            localStorage.removeItem("TruckFromDate");
            localStorage.removeItem("TruckToDate");
        }
        else {
            setTodayDate();

        }
        $("#DtFromDate").on("change", function () {
            var fromDate = $(this).val();
            $("#DtToDate").attr("min", fromDate);
            if ($("#DtToDate").val() < fromDate) {
                $("#DtToDate").val(fromDate);
            }
        });

       $("#DtToDate").on("blur", function () {
            var fromDate = $("#DtFromDate").val();
            var toDate = $(this).val();
            if (toDate && new Date(toDate) < new Date(fromDate)) {
                toastr.warning("To Date cannot be earlier than From Date.");
                $(this).val(fromDate);
            }
        });

        ddlVehicleNo();
        truckPagination = Pagination.create({
            pageSize: 10,
            paginationContainer: "#pageNumbers",
            infoContainer: "#pageInfoText",
            loader: function (options) {
                const fDate = formatDateForInput($('#DtFromDate').val());
                const tDate = formatDateForInput($('#DtToDate').val());
                $.ajax({
                    url: '/TruckOutTimeUpdation/GetTruckOutRecords',
                    type: 'GET',
                    data: {
                        FromDate: fDate,
                        ToDate: tDate,
                        DocType: $('#ddlDocType').val() || null,
                        OutType: $('#ddlOutTime').val() || null,
                        VehicleNo: $('#ddlTxtVehicleNo').val() || null,
                        QrCode: $('#TxtQRCodeNo').val() || null,
                        pageNumber: options.pageNumber,
                        pageSize: options.pageSize
                    },
                    success: function (res) {
                        options.callback(res);
                    }
                });
            },
            render: function (data) {
                renderTruckTable(data);
            }
        });
        $('#btn-save').on('click', function (e) {
            e.preventDefault();
            saveTruckOutUpdates();
        });
       
    });

    function loadTruckOutData() {

        var docType = $("#ddlDocType").val();
        var fromDate = $("#DtFromDate").val();
        var toDate = $("#DtToDate").val();

        if (docType === "Select Type") {
            toastr.warning("Please select Doc Type.");
            $("#ddlDocType").focus();
            return;
        }

        if (!fromDate) {
            toastr.warning("Please select From Date.");
            $("#DtFromDate").focus();
            return;
        }

        if (!toDate) {
            toastr.warning("Please select To Date.");
            $("#DtToDate").focus();
            return;
        }

        if (toDate < fromDate) {
            toastr.warning("To Date cannot be earlier than From Date.");
            $("#DtToDate").focus();
            return;
        }

        $("#DtFromDate").prop("disabled", true);
        $("#DtToDate").prop("disabled", true);
        $("#ddlOutTime").prop("disabled", true);
        $("#ddlDocType").prop("disabled", true);
        $("#ddlTxtVehicleNo").prop("disabled", true).trigger("change.select2");

        truckPagination.load();
    }

    function changeRowsPerPage() {
        truckPagination.setPageSize(
            parseInt($("#pageSizeSelect").val())
        );
    }
    async function ddlVehicleNo() {
        try {
            const response = await fetch('/TruckOutTimeUpdation/ddlVehicleNo');
            const data = await response.json();
            const ddl = $('#ddlTxtVehicleNo');
            ddl.empty();
            ddl.append('<option value="" disabled selected>Select Vehicle</option>');
            data.forEach(item => {
                ddl.append(
                    `<option value="${item.value}">${item.text}</option>`
                );
            });
            ddl.select2({
                placeholder: 'Select Vehicle',
                allowClear: true,
                width: '100%',
                matcher: function (params, data) {
                    if ($.trim(params.term) === '') {
                        return data;
                    }
                    const text = data.text.toLowerCase();
                    const term = params.term.toLowerCase();
                    return text.indexOf(term) > -1 ? data : null;
                }
            });
        }
        catch (err) {
            toastr.error("Vehicle Loading Error");
        }
    }
    function formatDateForInput(dateStr) {
        if (!dateStr)
            return '';
        if (dateStr.includes('-'))
            return dateStr;
        const parts = dateStr.split('/');
        if (parts.length != 3)
            return '';
        return `${parts[2]}-${parts[1]}-${parts[0]}`;
    }

    function renderTruckTable(data) {

        const tbody = $('#tblTruckOutTimeUpdation tbody');
        tbody.empty();

        if (data.length === 0) {
            tbody.append('<tr><td colspan="13" class="text-center">No records found</td></tr>');
            return;
        }

        $.each(data, function (i, item) {

            const isAllowed = (item.ouT_ALLOWED || "").trim().toUpperCase() === "YES";

            const docDate = formatDateForInput(item.v_Date);
            const outDate = formatDateForInput(item.ouT_DATE);

            tbody.append(`
            <tr>

                <td style="display:none;">${item.v_NO}</td>
                <td style="display:none;">${item.doc_id}</td>

                <td>${item.in_Type}</td>
                <td>${item.v_NO}</td>

                <td class="doc-date" data-docdate="${docDate}">
                    ${item.v_Date}
                </td>

                <td>${item.partyName}</td>

                <td>${item.trucK_NO}</td>

                <td>${item.v_TIME}</td>

                <td>
                    <input type="date"
                           class="form-control out-date"
                           value="${outDate}"
                           min="${docDate}"
                           ${isAllowed ? "" : "disabled"} />
                </td>

                <td>
                    <input type="time"
                           class="form-control out-time"
                           value="${item.ouT_TIME || ''}"
                           ${isAllowed ? "" : "disabled"} />
                </td>

                <td>
                    <input type="text"
                           class="form-control remarks"
                           value="${item.remarks || ''}"
                           ${isAllowed ? "" : "disabled"} />
                </td>

                <td class="out-allow">
                    ${item.ouT_ALLOWED || ""}
                </td>

                <td class="action-col">
                    <div class="action-wrap">
                        <input type="checkbox"
                               onchange="onCheckboxChanged(this)"
                               ${isAllowed ? "checked disabled" : ""}/>
                    </div>
                </td>

            </tr>`);
        });
    }
     // Out Date validation
    $(document).on("change blur", ".out-date", function () {

        var row = $(this).closest("tr");

        var docDate = row.find(".doc-date").data("docdate");
        var outDate = $(this).val();

        if (!outDate) return;

        if (new Date(outDate) < new Date(docDate)) {

            toastr.warning("Out Date cannot be earlier than Doc Date.");

            $(this).val(docDate);
            $(this).focus();
        }
    });

    function onCheckboxChanged(checkbox) {
        if ($(checkbox).prop("disabled"))
            return;
        const row = $(checkbox).closest("tr");
        if (checkbox.checked) {
            const now = new Date();
            const docDate = row.find(".doc-date").data("docdate");
            const today = now.toISOString().split("T")[0];
            row.find(".out-date,.out-time,.remarks").prop("disabled", false);
            row.find(".out-date")
                .attr("min", docDate)
                .val(today < docDate ? docDate : today);
            row.find(".out-time").val(now.toTimeString().substring(0, 5));
            row.find(".out-allow").text("Yes");
            row.attr("data-newlyChecked", "true");
        }
        else {

            row.find(".out-date,.out-time,.remarks").prop("disabled", true);
            row.find(".out-date").val("");
            row.find(".out-time").val("");
            row.find(".remarks").val("");
            row.find(".out-allow").text("");
            row.removeAttr("data-newlyChecked");
        }
    }
    function saveTruckOutUpdates() {

        let rowsToSave = [];
        let hasError = false;

        $('#tblTruckOutTimeUpdation tbody tr[data-newlyChecked="true"]').each(function (index) {

            const row = $(this);

            const vNo = parseInt(row.find('td').eq(0).text().trim());
            const docId = row.find('td').eq(1).text().trim();

            const outDate = row.find('.out-date').val();
            const outTime = row.find('.out-time').val().trim();
            const remarks = row.find('.remarks').val().trim();

            // Out Date Validation
            if (outDate === "") {
                toastr.error("Out Date is required. Line No : " + (index + 1));
                row.find('.out-date').focus();
                hasError = true;
                return false;
            }

            // Out Time Validation
            if (outTime === "") {
                toastr.error("Out Time is required. Line No : " + (index + 1));
                row.find('.out-time').focus();
                hasError = true;
                return false;
            }

            // Time format validation (HH:mm)
            var timeRegex = /^([01]\d|2[0-3]):([0-5]\d)$/;

            if (!timeRegex.test(outTime)) {
                toastr.error("Invalid Time Format (HH:mm). Line No : " + (index + 1));
                row.find('.out-time').focus();
                hasError = true;
                return false;
            }

            rowsToSave.push({
                V_NO: vNo,
                DOC_ID: docId,
                OUT_DATE: outDate,
                OUT_TIME: outTime,
                remarks: remarks,
                OUT_ALLOWED: "Yes"
            });

        });

        if (hasError)
            return;

        if (rowsToSave.length === 0) {
            toastr.warning("No rows selected.");
            return;
        }

        $.ajax({
            url: '/TruckOutTimeUpdation/SaveOutTimes',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(rowsToSave),

            success: function (res) {

                if (res.success) {

                    toastr.success(res.message);

                    // Reload Grid
                    truckPagination.load();

                } else {

                    toastr.warning(res.message);

                }

            },

            error: function (xhr) {

                toastr.error("Error while saving data.");

                console.log(xhr.responseText);

            }

        });

    }
    function reloadPage() {
        localStorage.setItem("TruckFromDate", $("#DtFromDate").val());
        localStorage.setItem("TruckToDate", $("#DtToDate").val());
        location.reload();
    }
    function setTodayDate() {
        const today = new Date();
        const yyyy = today.getFullYear();
        const mm = String(today.getMonth() + 1).padStart(2, '0');
        const dd = String(today.getDate()).padStart(2, '0');
        const formattedDate = `${yyyy}-${mm}-${dd}`;
        $("#DtFromDate").val(formattedDate);
        $("#DtToDate").val(formattedDate);
        $("#DtToDate").attr("min", formattedDate);
    }

</script>
