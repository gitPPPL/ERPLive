    function collectTableRowData() {
        const table = document.getElementById('tblInwardEntry');
        const rows = table.querySelectorAll('tbody tr');
        const rowData = [];

        rows.forEach(row => {
            const cells = row.querySelectorAll('td');
          const rowObj = {
             ITEM_CODE: parseInt(cells[0]?.textContent.trim()) || null,
             ITEM_NAME: cells[1]?.textContent.trim() || '',
             UOM_CODE: parseInt(cells[3]?.textContent.trim()) || null,
             NOS: parseInt(cells[4]?.textContent.trim()) || null,
             QTY: parseFloat(cells[5]?.textContent.trim()) || null,
             SHIP_RATE: parseFloat(cells[6]?.textContent.trim()) || null,
             EMPTY: cells[7]?.textContent.trim() || '',
             REMARKS: cells[8]?.textContent.trim() || '',
             REF_TYPE: cells[9]?.textContent.trim() || '',
             REF_NO: parseInt(cells[10]?.textContent.trim()) || null,
             DEPT_CODE: parseInt(cells[11]?.textContent.trim()) || null
         };
            rowData.push(rowObj);
        });

        return rowData;
    }

