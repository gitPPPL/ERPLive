@{
    ViewBag.Title = "Inward Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var logindate = Convert.ToDateTime(TempData["LoginDate"]).ToString("yyyy-MM-dd");
    var PubUserLevel = Convert.ToInt32(TempData["PubUserLevel"]);
}
<div class="circle-loader" style="display: none;">
    <div class="container">
        Loading...
        <div class="spinner-part"></div>
        <div class="spinner-part"></div>
        <div class="spinner-part"></div>
    </div>
</div>

<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-truck-loading"></i>
        </div>
        <div class="erppage-header-title">Material Inward Entry</div>
    </div>
    <div class="erppage-header-right">
        <button id="btn_backtolist" class="erppage-header-back">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div class="erppagelist-toolbar-end" style="display:none;">
    <div class="erppagelist-actions">
        <button type="button" class="erppagelist-btn erppagelist-btn-approve tooltip-btn" data-tooltip="Approve" data-bs-toggle="modal" data-bs-target="#approvedModal" id="btn_approval" style="display:none;">
            <i class="fa fa-check-circle"></i>Approved
        </button>
    </div>
</div>
@* Modal Popup *@
<div class="modal fade" id="approvedModal" tabindex="-1" aria-labelledby="ApprovedLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg erppagesmodal">
        <div class="modal-content erppagesmodal-content">

            <!-- Header -->
            <div class="erppagesmodal-header">
                <div class="erppagesmodal-header-left">
                    <div class="erppagesmodal-header-icon">
                        <i class="fa fa-file-signature"></i>
                    </div>
                    <h5 class="erppagesmodal-title" id="ApprovedLabel">
                        Document Approval Window
                    </h5>
                </div>

                <button type="button" class="erppagesmodal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa fa-times"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="erppagesmodal-body">
                <fieldset class="erppagesmodal-fieldset">
                    <legend>
                        <i class="fa fa-user-check"></i> Approval User
                    </legend>

                    <!-- First Row -->
                    <div class="erppagesrow">
                        <div class="erppagescol-4">
                            <div class="erppagesmodal-group">
                                <label for="ddlApprovalStatus" class="erppagesmodal-label">
                                    Approval Status
                                </label>
                                <select class="erppagesmodal-input" id="ddlApprovalStatus">
                                    <option value="">Select Approval Status</option>
                                </select>
                            </div>
                        </div>

                        <div class="erppagescol-4">
                            <div class="erppagesmodal-group">
                                <label for="ddlForwardTo" class="erppagesmodal-label">
                                    Forward To
                                </label>
                                <select class="erppagesmodal-input" id="ddlForwardTo">
                                    <option value="">Select Forward to</option>
                                </select>
                            </div>
                        </div>

                        <div class="erppagescol-4">
                            <div class="erppagesmodal-group">
                                <label for="ddlRemarks" class="erppagesmodal-label">
                                    Remarks
                                </label>
                                <select class="erppagesmodal-input" id="ddlRemarks">
                                    <option value="">Select Remarks</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Button Row -->
                    <div class="erppagesrow">
                        <div class="erppagescol-12">
                            <div class="erppagesmodal-action">
                                <button type="button" class="erppagesmodal-btn" id="btn_sendapproval">
                                    <i class="fa fa-paper-plane"></i> Send Approval
                                </button>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>

        </div>
    </div>
</div>
<div id="InwardEntryForm">
    <input type="hidden" class="form-control" id="TxtCode" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppagesrow">

                <!-- Doc Type -->
                <div class="erppagescol-25">
                    <div class="erppage-field">
                        <label for="ddlDocType" class="erppage-label">Doc Type</label>
                        <select class="erppage-input erppage-select" id="ddlDocType">
                            <option>Select Doc Type</option>
                        </select>
                    </div>
                </div>

                <!-- Document No -->
                <div class="erppagescol-25">
                    <div class="erppage-field">
                        <label for="TxtDocNo" class="erppage-label">Document No</label>
                        <input type="text" class="erppage-input" id="TxtDocNo" placeholder="Enter Document No" readonly>
                    </div>
                </div>

                <!-- In Date -->
                <div class="erppagescol-25">
                    <div class="erppage-field">
                        <label for="InDate" class="erppage-label">In Date</label>
                        <input type="date" class="erppage-input" id="InDate" value="@logindate">
                    </div>
                </div>

                <!-- In Time -->
                <div class="erppagescol-25">
                    <div class="erppage-field">
                        <label for="InTime" class="erppage-label">In Time</label>
                        <input type="time" class="erppage-input" id="InTime">
                    </div>
                </div>
            </div>
            <div class="erppagesrow">
                <div class="erppagescol-4">
                    <div class="erppage-field">
                        <label for="TxtRptDate" class="erppage-label">
                            Reporting Date
                        </label>

                        <div class="erppage-inline-group" style="width:100%;">
                            <input type="date" class="erppage-redinput" id="TxtRptDate">
                            <input type="time" class="erppage-redinput" id="TiRptDate">
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="erppage-container">
            <div class="erppage-tabs">
                <button class="erppage-tab active" data-tab="partydetails">Party Details</button>
                <button class="erppage-tab" data-tab="shippinginfo">Shipping Info</button>
                <button class="erppage-tab" data-tab="billchallan">Bill & Challan</button>
            </div>
            <div class="erppage-tab-content active" id="partydetails">
                <div class="erppage-accordion-header">Party Details</div>
                <div class="erppage-accordion-body">
                    <fieldset class="erppage-fieldset">
                        <div class="erppage-section-header">Party Details</div>
                        <div class="erppage-body">
                            <div class="erppage-grid2">
                                <div class="erppage-field">
                                    <label for="ddlPartyName" class="erppage-label">Party Name</label>
                                    <select class="erppage-input erppage-required" id="ddlPartyName">
                                        <option value="">Select Party Name</option>
                                    </select>
                                </div>
                                <div class="erppage-field">
                                    <label for="TxtAddLine1" class="erppage-label">Address Line 1</label>
                                    <div class="erppage-inline-group" style="width:100%;">
                                        <input type="text" class="erppage-input" id="TxtAddLine1" placeholder="Enter Address" readonly>
                                        <select id="ddladdressline1" style="width:50%" class="erppage-input">
                                            <option value="" id="SelectAddress">Select address</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="erppage-grid4">
                                <div class="erppage-field">
                                    <label for="TxtAddLine2" class="erppage-label">Address Line 2</label>
                                    <input type="text" class="erppage-input" id="TxtAddLine2" readonly>
                                </div>

                                <div class="erppage-field">
                                    <label for="TxtAddLine3" class="erppage-label">Address Line 3</label>
                                    <input type="text" class="erppage-input" id="TxtAddLine3" readonly>
                                </div>

                                <div class="erppage-field">
                                    <label for="ddlcity" class="erppage-label">City</label>
                                    <select class="erppage-input" id="ddlcity" disabled>
                                        <option>Select City</option>
                                    </select>
                                </div>

                                <div class="erppage-field">
                                    <label for="TxtPincode" class="erppage-label">Pincode</label>
                                    <input type="text" class="erppage-input" id="TxtPincode" readonly>
                                </div>
                            </div>
                            <div class="erppage-grid4">
                                <div class="erppage-field">
                                    <label for="TxtState" class="erppage-label">State</label>
                                    <select class="erppage-input" id="TxtState" disabled>
                                        <option>Select State</option>
                                    </select>
                                </div>

                                <div class="erppage-field">
                                    <label for="TxtGSTNo" class="erppage-label">GST No</label>
                                    <input type="text" class="erppage-input" id="TxtGSTNo" readonly>
                                </div>

                                <div class="erppage-field">
                                    <label for="TxtPAN" class="erppage-label">PAN</label>
                                    <input type="text" class="erppage-input" id="TxtPAN" readonly>
                                </div>

                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
            <div class="erppage-tab-content" id="shippinginfo">
                <div class="erppage-accordion-header">Shipping Info</div>
                <div class="erppage-accordion-body">
                    <fieldset class="erppage-fieldset">
                        <div class="erppage-section-header">Shipping Info</div>
                        <div class="erppage-body">
                            <div class="erppage-grid2">
                                <div class="erppage-field">
                                    <label for="ddlShipFrom" class="erppage-label">Ship From</label>
                                    <select class="erppage-input" id="ddlShipFrom">
                                        <option>Select Ship From</option>
                                    </select>
                                </div>
                                <div class="erppage-field">
                                    <label for="txtShipAddress" class="erppage-label">Ship Address</label>
                                    <input type="text" class="erppage-input" id="txtShipAddress" readonly>
                                </div>
                            </div>
                            <div class="erppage-grid4">
                                <div class="erppage-field">
                                    <label for="ShipBillNo" class="erppage-label">Ship. Bill No</label>
                                    <input type="text" class="erppage-input" id="ShipBillNo">
                                </div>
                                <div class="erppage-field">
                                    <label for="ShipBillDate" class="erppage-label">Ship. Bill Date</label>
                                    <input type="date" class="erppage-input" id="ShipBillDate">
                                </div>
                                <div class="erppage-field">
                                    <label for="VehicleOutTime" class="erppage-label">Vehicle Out Time</label>
                                    <div class="erppage-inline-group" style="width:100%;">
                                        <input type="date" class="erppage-input" id="DtVehicleOutTime">
                                        <input type="time" class="erppage-input" id="TiVehicleOutTime">
                                    </div>
                                </div>
                                <div class="erppage-field">
                                    <label for="VehicleReturn" class="erppage-label">Vehicle Return</label>
                                    <select class="erppage-input" id="VehicleReturn">
                                        <option>NA</option>
                                        <option>Returnable</option>
                                    </select>
                                </div>
                            </div>
                            <div class="erppage-grid4">
                                <div class="erppage-field">
                                    <label for="ddlDocStatus" class="erppage-label">Doc Status</label>
                                    <select class="erppage-input" id="ddlDocStatus">
                                        <option>Select Doc Status</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
            <div class="erppage-tab-content" id="billchallan">
                <div class="erppage-accordion-header">Bill & Challan</div>
                <div class="erppage-accordion-body">
                    <fieldset class="erppage-fieldset">
                        <div class="erppage-section-header">Bill & Challan</div>
                        <div class="erppage-body">
                            <div class="erppage-grid4">
                                <div class="erppage-field">
                                    <label for="TxtPONo" class="erppage-label">PO No</label>
                                    <input type="text" class="erppage-input" id="TxtPONo">
                                </div>
                                <div class="erppage-field">
                                    <label for="TxtBillNo" class="erppage-label">Party Bill No</label>
                                    <div class="erppageinputicon-wrapper">
                                        <input type="text" class="erppage-input" id="TxtBillNo">
                                        <span class="erppageinputicon" id="BtnPartyBillno" data-bs-toggle="modal" data-bs-target="#ellipsisIcon">
                                            <i class="fa fa-ellipsis-h"></i>
                                        </span>
                                    </div>
                                </div>
                                <div class="erppage-field">
                                    <label for="DtPartyBillDate" class="erppage-label">Party Bill Date</label>
                                    <input type="date" class="erppage-input" id="DtPartyBillDate">
                                </div>
                                <div class="erppage-field">
                                    <label for="TxtChallanNo" class="erppage-label">Challan No</label>
                                    <input type="text" class="erppage-input" id="TxtChallanNo">
                                </div>
                            </div>
                            <div class="erppage-grid4">
                                <div class="erppage-field">
                                    <label for="TxtChallanDate" class="erppage-label">Challan Date</label>
                                    <input type="date" class="erppage-input" id="TxtChallanDate">
                                </div>
                                <div class="erppage-field">
                                    <label for="TxtBillAmt" class="erppage-label">Bill Amount</label>
                                    <input type="text" class="erppage-redinput numeric-only" id="TxtBillAmt">
                                </div>

                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>
        @* Modal Popup  *@
        <div class="modal fade" id="ellipsisIcon" tabindex="-1" aria-labelledby="ellipsisIconLabel" aria-hidden="true">
            <div class="modal-dialog modal-xl erppagesmodal">
                <div class="modal-content erppagesmodal-content draggable-modal">

                    <!-- Header -->
                    <div class="erppagesmodal-header">
                        <div class="erppagesmodal-header-left">
                            <div class="erppagesmodal-header-icon">
                                <i class="fa fa-copy"></i>
                            </div>
                            <h5 class="erppagesmodal-title" id="ellipsisIconLabel">Copy From</h5>
                        </div>

                        <button type="button" class="erppagesmodal-close" data-bs-dismiss="modal" aria-label="Close">
                            <i class="fa fa-times"></i>
                        </button>
                    </div>

                    <!-- Body -->
                    <div class="erppagesmodal-body">

                        <!-- Search + Actions -->
                        <fieldset class="erppagesmodal-fieldset">
                            <legend><i class="fa fa-filter"></i> Search & Filter</legend>

                            <div class="erppagesrow">
                                <!-- Search -->
                                <div class="erppagescol-4">
                                    <div class="erppagesmodal-group">
                                        <label for="searchBoxEI" class="erppagesmodal-label">Search Module</label>
                                        <input type="text" id="searchBoxEI" class="erppagesmodal-input"
                                               placeholder="Search Module..." aria-label="Search term" />
                                    </div>
                                </div>

                                <!-- Append -->
                                <div class="erppagescol-2">
                                    <div class="erppagesmodal-group">
                                        <label class="erppagesmodal-label">Option</label>
                                        <div class="erppagesmodal-checkbox-wrap">
                                            <input type="checkbox" id="chkAppendEIModal">
                                            <label class="checkbox-label" for="chkAppendEIModal">Append</label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Button -->
                                <div class="erppagescol-6">
                                    <div class="erppagesmodal-action erppagesmodal-action-bottom">
                                        <button type="button" class="erppagesmodal-btn" data-bs-dismiss="modal">
                                            <i class="fa fa-copy"></i> Select
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </fieldset>

                        <!-- Table -->
                        <div class="erppagelist-container mt-3">
                            <div class="excel-wrapper">
                                <table id="tblellipsisIconmodal" class="excel-table fixed-grid-table table-width">
                                    <thead class="table-head">
                                        <tr>
                                            <th><input type="checkbox" id="selectAllPR" /></th>
                                            <th>Sauda No</th>
                                            <th>Sauda Date</th>
                                            <th>Item Name</th>
                                            <th>Sauda Quantity</th>
                                            <th>Sauda Rate</th>
                                            <th>Party Invoice No.</th>
                                            <th>Invoice Date</th>
                                            <th>Invoice Amount(usd)</th>
                                            <th>Container No.</th>
                                            <th>Container Weight</th>
                                            <th>Container Size</th>
                                            <th>Tracking Entry No.</th>
                                            <th style="display:none;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        
        <!-- Transport Details -->
        <fieldset class="erppage-subfieldset">
            <legend>Transport Details</legend>
            <div class="erppage-subheader">Transport Details</div>

            <!-- Row 1 -->
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label for="TxtVehicleNo" class="erppage-label">Vehicle No</label>
                    <input type="text" class="erppage-redinput" id="TxtVehicleNo" placeholder="Enter Vehicle No" maxlength="10" />
                </div>

                <div class="erppage-divfield">
                    <label for="TxtTransporter" class="erppage-label">Transport Name</label>
                    <select class="erppage-input" id="TxtTransporter">
                        <option>Select Transport Name</option>
                    </select>
                </div>

                <div class="erppage-divfield">
                    <label for="TxtGRNo" class="erppage-label">GR No.</label>
                    <input type="text" class="erppage-input" id="TxtGRNo" maxlength="20" />
                </div>

                <div class="erppage-divfield">
                    <label for="DtGRDate" class="erppage-label">GR Date</label>
                    <input type="date" class="erppage-input" id="DtGRDate" />
                </div>
            </div>

            <!-- Row 2 -->
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label for="TxtDriverName" class="erppage-label">Driver Name</label>
                    <input type="text" class="erppage-input" id="TxtDriverName" maxlength="50" />
                </div>

                <div class="erppage-divfield">
                    <label for="TxtDriverMobile" class="erppage-label">Driver Mobile No</label>
                    <input type="number" class="erppage-input" id="TxtDriverMobile" maxlength="10" oninput="validateMobile(this)" />
                </div>

                <div class="erppage-divfield erppage-col-span-2">
                    <label for="txt_VehicleRemarks" class="erppage-label">Vehicle Remarks</label>
                    <textarea class="erppage-textarea" id="txt_VehicleRemarks"></textarea>
                </div>
            </div>

            <!-- Row 3 Buttons -->
            
                <div class="erppage-internalaction">
                    <button type="button" class="erppage-btn erppage-btn-save" id="btn_setting">
                        <i class="fa fa-cog"></i>
                    </button>
                    <button type="button" class="erppage-btn erppage-btn-common" data-bs-toggle="modal" id="btn_RCDetail" data-bs-target="#RCDetail">
                        RC Detail
                    </button>
                
                    <button type="button" class="erppage-btn erppage-btn-save" id="btn_database">
                        <i class="fa fa-database"></i>
                    </button>
                    <button type="button" class="erppage-btn erppage-btn-common" id="btn_FastagDetail" data-bs-toggle="modal" data-bs-target="#FastDetail">
                        Fastag Detail
                    </button>
                </div>
           
            <!-- RC Detail Modal -->
            <div class="modal fade" id="RCDetail" tabindex="-1" aria-labelledby="RCDetailLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl erppagesmodal">
                    <div class="modal-content erppagesmodal-content draggable-modal">

                        <!-- Header -->
                        <div class="erppagesmodal-header">
                            <div class="erppagesmodal-header-left">
                                <div class="erppagesmodal-header-icon">
                                    <i class="fa fa-id-card"></i>
                                </div>
                                <h5 class="erppagesmodal-title">
                                    RC Data of Vehicle No.<span id="RCDetailLabel"></span>
                                </h5>
                            </div>

                            <button type="button" class="erppagesmodal-close" data-bs-dismiss="modal" aria-label="Close">
                                <i class="fa fa-times"></i>
                            </button>
                        </div>

                        <!-- Body -->
                        
                            <div class="erppagelist-container">
                                <div class="excel-wrapper">
                                    <table id="tblRCDetaillist" class="excel-table fixed-grid-table table-width">
                                        <thead class="table-head">
                                            <tr>
