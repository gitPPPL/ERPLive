@{
    ViewBag.Title = "Inward Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var logindate = Convert.ToDateTime(TempData["LoginDate"]).ToString("yyyy-MM-dd");
    var PubUserLevel = Convert.ToInt32(TempData["PubUserLevel"]);
}


<fieldset>
    <legend class="legend-field">Material Inward Entry</legend>
    <div class="row">
        <div class="offset-md-6 col-md-6">
            <div class="button-right">
                <button type="button" class="btn btn-approved" data-bs-toggle="modal" data-bs-target="#approvedModal" id="btn_approval" style="display:none;">
                    <i class="fa fa-check"></i> Approved
                </button>
                <button type="button" class="btn btn-draft"  id="btn_backtolist">
                    <i class="fa fa-list"></i> Back to list
                </button>
            </div>
        </div>
    </div>
    @* ModalPopup *@
    <div class="modal fade" id="approvedModal" tabindex="-1" aria-labelledby="ApprovedLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content draggable-modal">
                <div class="popup-header">
                    <h5 class="popup-title" id="ApprovedLabel">Document Approval Window</h5>
                    <i class="fa fa-times" data-bs-dismiss="modal" style="cursor: pointer;" aria-label="Close"></i>
                </div>
                <div class="modal-body">
                    <fieldset>
                        <legend class="sub-legend">Approval User</legend>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="ddlApprovalStatus">Approval Status</label>
                                    <select class="form-control" id="ddlApprovalStatus">
                                        <option value="">Select Approval Status</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="ddlForwardTo">Forward to</label>
                                    <select class="form-control" id="ddlForwardTo">
                                        <option value="">Select Forward to</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="TxtRemarks">Remarks</label>
                                    <select class="form-control" id="ddlRemarks">
                                        <option value="">Select Forward to</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="offset-md-4 col-md-8">
                                <div class="button-right">
                                    <button type="button" class="btn btn-success" id="btn_sendapproval"><i class="fa fa-paper-plane"></i> Send Approval</button>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>
    </div>

    <form id="InwardEntryForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlDocType">Doc Type</label>
                    <select class="form-control" id="ddlDocType">
                        <option>Select Doc Type</option>
                    </select>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="TxtDocNo">Document No</label>
                    <input type="text" class="form-control" id="TxtDocNo" placeholder="Enter Document No" readonly>
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="InDate">In Date</label>
                    <input type="date" class="form-control" id="InDate" value="@logindate">
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    <label for="InTime">In Time</label>
                    <input type="time" class="form-control" id="InTime">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtRptDate">Reporting Date<span style="color:red;">*</span></label>
                    <div class="input-divide">
                        <input type="date" class="form-control" id="TxtRptDate">
                        <input type="time" class="form-control" id="TiRptDate">
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <!-- Party Details -->
            <div class="col-md-4">
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Party Details</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ddlPartyName">Party Name<span style="color:red;">*</span></label>
                                <select class="form-control" id="ddlPartyName">
                                    <option value="">Select Party Name</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="TxtAddLine1">Address Line 1</label>
                                <div class="input-divide">
                                    <input type="text" class="form-control" id="TxtAddLine1" placeholder="Enter Address" readonly>
                                    <div class="select-wrapper">
                                        <select id="ddladdressline1">  <option value="" id="SelectAddress">Select address</option>  </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtAddLine2">Address Line 2</label>
                                <input type="text" class="form-control" id="TxtAddLine2" placeholder="Enter Address" readonly>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtAddLine3">Address Line 3</label>
                                <input type="text" class="form-control" id="TxtAddLine3" placeholder="Enter Address" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlcity">City</label>
                                <select class="form-control" id="ddlcity" disabled>
                                    <option>Select City</option>
                                </select>
                                
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtPincode">Pincode</label>
                                <input type="text" class="form-control" id="TxtPincode" placeholder="Enter Pincode" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="row">

                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtState">State</label>
                                <select class="form-control" id="TxtState" disabled>
                                    <option>Select State</option>
                                </select>

                            </div>
                        </div>


                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtGSTNo">GST No</label>
                                <input type="text" class="form-control" id="TxtGSTNo" placeholder="Enter GST No" readonly>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtPAN">PAN</label>
                                <input type="text" class="form-control" id="TxtPAN" placeholder="Enter PAN" readonly>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <!-- Shipping Info -->
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Shipping Info</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ddlShipFrom">Ship From</label>
                                <select class="form-control" id="ddlShipFrom">
                                    <option>Select Ship From</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">


                            <div class="form-group">
                                <label for="ShipBillNo">Ship Address</label>
                                <input type="text" class="form-control" id="txtShipAddress" placeholder="" readonly>
                            </div>


                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ShipBillNo">Ship. Bill No</label>
                                <input type="text" class="form-control" id="ShipBillNo" placeholder="Enter Ship Bill No" maxlength="30">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ShipBillDate">Ship. Bill Date</label>
                                <input type="date" class="form-control" id="ShipBillDate">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="VehicleOutTime">Vehicle Out Time</label>
                                <div class="input-divide">
                                    <input type="date" class="form-control" id="DtVehicleOutTime">
                                    <input type="time" class="form-control" id="TiVehicleOutTime">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="VehicleReturn">Vehicle Return</label>
                                <select class="form-control" id="VehicleReturn">
                                    <option> NA  </option>
                                    <option> Returnable  </option>                            
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlDocStatus">Doc Status</label>
                                <select class="form-control" id="ddlDocStatus">
                                    <option>Select Doc Status</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <!-- Challan & Billing Info -->
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Bill & Challan</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="TxtPONo">PO No</label>
                                <input type="text" class="form-control" id="TxtPONo" placeholder="Enter PO No" maxlength="30">
                            </div>
                        </div>
                    </div>
                   
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtBillNo">Party Bill No</label>
                                <div class="input-icon-wrapper">
                                    <input type="text" class="form-control" id="TxtBillNo" maxlength="30">
                                    <span class="input-icon" id="BtnPartyBillno" data-bs-toggle="modal" data-bs-target="#ellipsisIcon"><i class="fa fa-ellipsis-h"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtPartyBillDate">Party Bill Date <span id="span_partybilldate" style="color:red; display:none;">*</span></label>
                                <input type="date" class="form-control" id="DtPartyBillDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtChallanNo">Challan No</label>
                                <input type="text" class="form-control" id="TxtChallanNo" placeholder="Enter Challan No" maxlength="30"> 
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtChallanDate">Challan Date<span id="span_ChallanDatedate" style="color:red; display:none;">*</span></label>
                                <input type="date" class="form-control" id="TxtChallanDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtBillAmt">Bill Amount<span style="color:red;">*</span></label>
                                <input type="text"  class="form-control numeric-only" id="TxtBillAmt"  placeholder="Enter Bill Amount" maxlength="18">
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        <!--Modal Popup-->
        <div class="modal fade" id="ellipsisIcon" tabindex="-1" aria-labelledby="ellipsisIconLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content draggable-modal">
                    <div class="popup-header">
                        <h5 class="popup-title" id="ellipsisIconLabel">Copy From</h5>
                        <i class="fa fa-times" data-bs-dismiss="modal" style="cursor: pointer;" aria-label="Close"></i>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-4">
                                <div class="input-group shadow-sm rounded-pill overflow-hidden">
                                    <input type="text" id="searchBoxEI" class="form-control border-0" placeholder="Search Module..." aria-label="Search term" />
                                </div>
                            </div>
                            <div class="col-lg-2">
                                <div class="form-group">
                                    <div class="form-row">
                                        <input type="checkbox" id="chkAppendEIModal">
                                        <label class="checkbox-label" for="chkAppendEIModal">Append</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="btn-rightalign">
                                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><i class="fa fa-copy"></i>Select</button>
                                </div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="table-responsive">
                                <table id="tblellipsisIconmodal" class="table-width">
                                    <thead class="table-head">
                                        <tr>
                                            <th><input type="checkbox" id="selectAllPR" /></th>
                                            <th>Sauda No</th>
                                            <th>Sauda Date</th>
                                            <th>Item Name</th>
                                            <th>Sauda Quantity</th>
                                            <th>Sauda Rate</th>
                                            <th>Party Invoice No.</th>
                                            <th>Invoice Date</th>
                                            <th>Invoice Amount(usd)</th>
                                            <th>Container No.</th>
                                            <th>Container Weight</th>
                                            <th>Container Size</th>
                                            <th>Tracking Entry No.</th>
                                            <th style="display:none;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--Transport Details-->
        <fieldset class="fieldset-sub">
            <legend class="sub-legend">Transport Details</legend>
            <div class="row">
                <div class="col-md-2">
                    <div class="form-group">
                        <label for="TxtVehicleNo">Vehicle No<span style="color:red;">*</span></label>
                        <input type="text" class="form-control" id="TxtVehicleNo" placeholder="Enter Vehicle No"  maxlength="10" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtTransporter">Transport Name</label>         

                        <select class="form-control" id="TxtTransporter">
                            <option>Select Transport Name</option>
                        </select>


                    </div>
                </div>
                <div class="col-md-2">       
                    <div class="form-group">
                        <label for="TxtGRNo">GR No.</label>
                        <input type="text" class="form-control" id="TxtGRNo"  maxlength="20" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label for="DtGRDate">GR Date</label>
                        <input type="date" class="form-control" id="DtGRDate" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtDriverName">Driver Name </label>
                        <input type="text" class="form-control" id="TxtDriverName" maxlength="50"/>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtDriverMobile">Driver Mobile No</label>
                        <input type="number" class="form-control" id="TxtDriverMobile" maxlength="10" oninput="validateMobile(this)" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="txt_VehicleRemarks">Vehicle Remarks</label>
                        <textarea typeof="text" class="form-control" id="txt_VehicleRemarks" ></textarea>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="btn-mt">
                        <button type="button" class="btn btn-success" id="btn_setting"><i class="fa fa-cog"></i></button>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" id="btn_RCDetail" data-bs-target="#RCDetail">RC Detail</button>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="btn-mt">
                        <button type="button" class="btn btn-success" id="btn_database"><i class="fa fa-database"></i></button>
                        <button type="button" class="btn btn-primary" id="btn_FastagDetail" data-bs-toggle="modal" >Fastag Detail</button>
                    </div>
                </div>
            </div>
            @* Modal Popup *@
            <div class="modal fade" id="RCDetail" tabindex="-1" aria-labelledby="RCDetailLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content draggable-modal">
                        <div class="popup-header">
                            <h5 class="popup-title">RC Data of Vehicle No.<span id="RCDetailLabel"></span></h5>
                            <i class="fa fa-times" data-bs-dismiss="modal" style="cursor: pointer;" aria-label="Close"></i>
                        </div>
                        <div class="modal-body">
                            @* <div class="button-right">
                                <button type="button" class="btn btn-primary" id="Btn_selectedData">
                                    <i class="fa fa-check"></i> Selected Data
                                </button>
                            </div> *@
                            <div class="card">
                                <div class="table-responsive">
                                    <table id="tblRCDetaillist" class="table-width">
                                        <thead class="table-head">
                                            <tr>
                                                <th>Client ID</th>
                                                <th>RC Number</th>
                                                <th>Registration Date</th>
                                                <th>Owner Name</th>
                                                <th>Father Name</th>
                                                <th>Present Address</th>
                                                <th>Permanent Address</th>
                                                <th>Mobile Number</th>
                                                <th>Vehicle Category</th>
                                                <th>Chassis Number</th>
                                                <th>Engine Number</th>
                                                <th>Manufacturer</th>
                                                <th>Model Name</th>
                                                <th>Body Type</th>
                                                <th>Fuel Type</th>
                                                <th>Vehicle Color</th>
                                                <th>Emission Norms</th>
                                                <th>Fitness Valid Upto</th>
                                                <th>Financer Name</th>
                                                <th>Is Financed</th>
                                                <th>Insurance Company</th>
                                                <th>Insurance Policy No</th>
                                                <th>Insurance Valid Upto</th>
                                                <th>Manufacturing Date</th>
                                                <th>Manufacturing Date (Formatted)</th>
                                                <th>Registered RTO</th>
                                                <th>Data Updated By</th>
                                                <th>Less Information Flag</th>
                                                <th>Tax Valid Upto</th>
                                                <th>Tax Paid Upto</th>
                                                <th>Cubic Capacity (CC)</th>
                                                <th>Gross Vehicle Weight</th>
                                                <th>No Of Cylinders</th>
                                                <th>Seat Capacity</th>
                                                <th>Sleeper Capacity</th>
                                                <th>Standing Capacity</th>
                                                <th>Wheel Base</th>
                                                <th>Unladen Weight</th>
                                                <th>Vehicle Category Description</th>
                                                <th>PUCC Number</th>
                                                <th>PUCC Valid Upto</th>
                                                <th>Permit Number</th>
                                                <th>Permit Issue Date</th>
                                                <th>Permit Valid From</th>
                                                <th>Permit Valid Upto</th>
                                                <th>Permit Type</th>
                                                <th>National Permit Number</th>
                                                <th>National Permit Valid Upto</th>
                                                <th>National Permit Issued By</th>
                                                <th>Non Use Status</th>
                                                <th>Non Use From Date</th>
                                                <th>Non Use To Date</th>
                                                <th>Blacklist Status</th>
                                                <th>NOC Details</th>
                                                <th>Owner Number</th>
                                                <th>RC Status</th>
                                                <th>Masked Owner Name</th>
                                                <th>Challan Details</th>
                                              
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal fade" id="FastDetail" tabindex="-1" aria-labelledby="FastDetailLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content draggable-modal">
                        <div class="popup-header">
                            <h5 class="popup-title">RC Data of Vehicle No.<span id="FastDetailLabel"></span></h5>
                            <i class="fa fa-times" data-bs-dismiss="modal" style="cursor: pointer;" aria-label="Close"></i>
                        </div>
                        <div class="modal-body">                           
                            <div class="card">
                                <div class="table-responsive">
                                    <table id="tblFastagDetaillist" class="table-width">
                                        <thead class="table-head">
                                            <tr>
                                                <th>Client ID</th>
                                                <th>RC Number</th>
                                                <th>Bank Name</th>
                                                <th>Tag ID</th>
                                                <th>Transaction Status</th>
                                                <th>Lane Direction</th>
                                                <th>Transaction DateTime</th>
                                                <th>Sequence No</th>
                                                <th>Toll Plaza Geo Code</th>
                                                <th>Toll Plaza Name</th>
                                                <th>Vehicle Type</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
        <!-- EWay Bill -->
        <fieldset class="fieldset-sub">
            <legend class="sub-legend">EWay Bill Details</legend>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="ddlTransit">Transit No</label>
                        <div class="input-icon-wrapper">
                            <select class="form-control" id="ddlTransit">
                                <option>Select Transit No</option>
                            </select>
                            <span class="input-icon"><i class="fa fa-cog" id="EwayBillbtn"></i></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtEWayNo">EWayBill No</label>
                        <input type="text" class="form-control" id="TxtEWayNo" placeholder="Enter EWayBill No" maxlength="30">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="DtEWayDate">EWayBill Date<span id="span_EWayBillDate" style="color:red; display:none;">*</span></label>
                        <input type="date" class="form-control" id="DtEWayDate">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtEWayDate">EWayBill Expiry Date<span id="span_EWayBillExpiryDate" style="color:red; display:none;">*</span></label>
                        <input type="date" class="form-control" id="TxtEWayDate">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtEWBInvNo">EWB Party Inv No<span id="span_EWBPartyInvNo" style="color:red; display:none;">*</span></label>
                        <input type="text" class="form-control" id="TxtEWBInvNo" placeholder="Enter EWB Party Inv No">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtEWBInvAmt">EWB Party Inv Amt<span id="span_EWBPartyInvAm" style="color:red; display:none;">*</span></label>
