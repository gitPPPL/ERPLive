@{
    ViewBag.Title = "Inward Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
    <legend class="legend-field">Inward Entry</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="window.location.href='@Url.Action("Index", "InwardEntryList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>
    <form id="InwardEntryForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlDocType">Doc Type</label>
                    <select class="form-control" id="ddlDocType">
                        <option>Select Doc Type</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtDocNo">Doc No</label>
                    <input type="text" class="form-control" id="TxtDocNo" placeholder="Enter Doc No"   readonly >
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="InDate">In Date</label>
                    <input type="date" class="form-control" id="InDate">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="InTime">In Time</label>
                    <input type="time" class="form-control" id="InTime">
                </div>
            </div>
        </div>
        <div class="row">
            <!-- Party Details -->
            <div class="col-md-4">
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Party Details</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ddlPartyName">Party Name</label>
                                <select class="form-control" id="ddlPartyName">
                                    <option value="">Select Party Name</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="TxtAddLine1">Address Line 1</label>
                                <div class="input-divide">
                                    <input type="text" class="form-control" id="TxtAddLine1" placeholder="Enter Address" readonly>
                                    <div class="select-wrapper">
                                        <select id="ddladdressline1">
                                            <option value="" id="SelectAddress">Select address</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtAddLine2">Address Line 2</label>
                                <input type="text" class="form-control" id="TxtAddLine2" placeholder="Enter Address" readonly>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtAddLine3">Address Line 3</label>
                                <input type="text" class="form-control" id="TxtAddLine3" placeholder="Enter Address" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtAddLine3">City</label>
                                <input type="text" class="form-control" id="TxtCity" placeholder="Enter Address" readonly>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtPincode">Pincode</label>
                                <input type="text" class="form-control" id="TxtPincode" placeholder="Enter Pincode" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="row">

                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtState">State</label>
                                <input type="text" class="form-control" id="TxtState" placeholder="Enter Pincode" readonly>
                            </div>
                        </div>


                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtGSTNo">GST No</label>
                                <input type="text" class="form-control" id="TxtGSTNo" placeholder="Enter GST No" readonly>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtPAN">PAN</label>
                                <input type="text" class="form-control" id="TxtPAN" placeholder="Enter PAN" readonly>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <!-- Shipping Info -->
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Shipping Info</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ddlShipFrom">Ship From</label>
                                <select class="form-control" id="ddlShipFrom">
                                    <option>Select Ship From</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">


                            <div class="form-group">
                                <label for="ShipBillNo">Ship Address</label>
                                <input type="text" class="form-control" id="txtShipAddress" placeholder="" readonly>
                            </div>


                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ShipBillNo">Ship. Bill No</label>
                                <input type="text" class="form-control" id="ShipBillNo" placeholder="Enter Ship Bill No">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ShipBillDate">Ship. Bill Date</label>
                                <input type="date" class="form-control" id="ShipBillDate">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="VehicleOutTime">Vehicle Out Time</label>
                                <div class="input-divide">
                                    <input type="date" class="form-control" id="DtVehicleOutTime">
                                    <input type="time" class="form-control" id="TiVehicleOutTime">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="VehicleReturn">Vehicle Return</label>
                                <select class="form-control" id="VehicleReturn">
                                    <option>Select Vehicle Return</option>
                                    <option> Returnable  </option>
                                    <option> NA  </option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ddlDocStatus">Doc Status</label>
                                <select class="form-control" id="ddlDocStatus">
                                    <option>Select Doc Status</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <!-- Challan & Billing Info -->
                <fieldset class="fieldset-sub-divide">
                    <legend class="sub-legend">Bill & Challan</legend>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="TxtPONo">PO No</label>
                                <input type="text" class="form-control" id="TxtPONo" placeholder="Enter PO No">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="TxtRptDate">Reporting Date</label>
                                <div class="input-divide">
                                    <input type="date" class="form-control" id="TxtRptDate">
                                    <input type="time" class="form-control" id="TiRptDate">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtBillNo">Party Bill No</label>
                                <div class="input-icon-wrapper">
                                    <input type="text" class="form-control" id="TxtBillNo">
                                    <span class="input-icon" id="BtnPartyBillno" data-bs-toggle="modal" data-bs-target="#ellipsisIcon"><i class="fa fa-ellipsis-h"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtPartyBillDate">Party Bill Date</label>
                                <input type="date" class="form-control" id="DtPartyBillDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtChallanNo">Challan No</label>
                                <input type="text" class="form-control" id="TxtChallanNo" placeholder="Enter Challan No">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtChallanDate">Challan Date</label>
                                <input type="date" class="form-control" id="TxtChallanDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="TxtBillAmt">Bill Amount</label>
                                <input type="number" class="form-control" id="TxtBillAmt" placeholder="Enter Bill Amount">
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        <!--Modal Popup-->
        <div class="modal fade" id="ellipsisIcon" tabindex="-1" aria-labelledby="ellipsisIconLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content draggable-modal">
                    <div class="popup-header">
                        <h5 class="popup-title" id="ellipsisIconLabel">Copy From</h5>
                        <i class="fa fa-times" data-bs-dismiss="modal" style="cursor: pointer;" aria-label="Close"></i>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-4">
                                <div class="input-group shadow-sm rounded-pill overflow-hidden">
                                    <input type="text" id="searchBoxEI" class="form-control border-0" placeholder="Search Module..." aria-label="Search term" />
                                </div>
                            </div>
                            <div class="col-lg-2">
                                <div class="form-group">
                                    <div class="form-row">
                                        <input type="checkbox" id="chkAppendEIModal">
                                        <label class="checkbox-label" for="chkAppendEIModal">Append</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="btn-rightalign">
                                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><i class="fa fa-copy"></i>Select</button>
                                </div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="table-responsive">
                                <table id="tblellipsisIconmodal" class="table-width">
                                    <thead class="table-head">
                                        <tr>
                                            <th><input type="checkbox" id="selectAllPR" /></th>
                                            <th>Sauda No</th>
                                            <th>Sauda Date</th>
                                            <th>Item Name</th>
                                            <th>Sauda Quantity</th>
                                            <th>Sauda Rate</th>
                                            <th>Party Invoice No.</th>
                                            <th>Invoice Date</th>
                                            <th>Invoice Amount(usd)</th>
                                            <th>Container No.</th>
                                            <th>Container Weight</th>
                                            <th>Container Size</th>
                                            <th>Tracking Entry No.</th>
                                            <th style="display:none;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--Transport Details-->
        <fieldset class="fieldset-sub">
            <legend class="sub-legend">Transport Details</legend>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtVehicleNo">Vehicle No</label>
                        <input type="text" class="form-control" id="TxtVehicleNo" placeholder="Enter Vehicle No">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtTransporter">Transport Name</label>
                        <input type="text" class="form-control" id="TxtTransporter" placeholder="Enter Transport Name">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtGRNo">GR No.</label>
                        <input type="text" class="form-control" id="TxtGRNo">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="DtGRDate">GR Date</label>
                        <input type="date" class="form-control" id="DtGRDate">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtDriverName">Driver Name</label>
                        <input type="text" class="form-control" id="TxtDriverName">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtDriverMobile">Driver Mobile No</label>
                        <input type="number" class="form-control" id="TxtDriverMobile">
                    </div>
                </div>
            </div>
        </fieldset>
        <!-- EWay Bill -->
        <fieldset class="fieldset-sub">
            <legend class="sub-legend">EWay Bill Details</legend>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="ddlTransit">Transit No</label>
                        <div class="input-icon-wrapper">
                            <select class="form-control" id="ddlTransit">
                                <option>Select Transit No</option>
                            </select>
                            <span class="input-icon"><i class="fa fa-cog"></i></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtEWayNo">EWayBill No</label>
                        <input type="text" class="form-control" id="TxtEWayNo" placeholder="Enter EWayBill No">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="DtEWayDate">EWayBill Date</label>
                        <input type="date" class="form-control" id="DtEWayDate">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtEWayDate">EWayBill Expiry Date</label>
                        <input type="date" class="form-control" id="TxtEWayDate">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtEWBInvNo">EWB Party Inv No</label>
                        <input type="text" class="form-control" id="TxtEWBInvNo" placeholder="Enter EWB Party Inv No">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtEWBInvAmt">EWB Party Inv Amt</label>
                        <input type="number" class="form-control" id="TxtEWBInvAmt">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtWbSlipNo">Party WB Slip No</label>
                        <input type="text" class="form-control" id="TxtWbSlipNo">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtGrWt">Party WB GrWt</label>
                        <input type="text" class="form-control" id="TxtGrWt">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtTrWt">Party WB TrWt</label>
                        <input type="text" class="form-control" id="TxtTrWt">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtWbTime">Party WB Time</label>
                        <div class="input-divide">
                            <input type="date" class="form-control" id="DtWBTime">
                            <input type="time" class="form-control" id="TxtWbTime">
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="ddlPartyCity">Party City</label>
                        <select class="form-control" id="ddlPartyCity">
                            <option>Select Party City</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtContainerNo">Container No</label>
                        <div class="input-icon-wrapper">
                            <input type="text" class="form-control" id="TxtContainerNo">
                            <span class="input-icon"><i class="fa fa-search"></i></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtRemarks">Remarks</label>
                        <textarea class="form-control" id="TxtRemarks" rows="1"></textarea>
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="row">
            <div class="offset-md-8 col-md-4">
                <div class="btn-mt button-right">
                    <button type="button" class="btn btn-primary"><i class="fa fa-list"></i>List of Documents to be send</button>
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" id="btnpendingorderno" data-bs-target="#pendingorders"><i class="fa fa-clock"></i>Pending Orders/Bill</button>
                </div>
            </div>
        </div>
        <!--Modal Popup-->
        <div class="modal fade" id="pendingorders" tabindex="-1" aria-labelledby="pendingordersLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content draggable-modal">
                    <div class="popup-header">
                        <h5 class="popup-title" id="pendingordersLabel">Pending Order</h5>
                        <i class="fa fa-times" data-bs-dismiss="modal" style="cursor: pointer;" aria-label="Close"></i>
                    </div>
                    <div class="modal-body">
                        <div class="button-right">
                            <button type="button" class="btn btn-primary" id="Btn_selectedData">
                                <i class="fa fa-check"></i> Selected Data
                            </button>
                        </div>
                        <div class="card">
                            <div class="table-responsive">
                                <table id="tblpendingordermodal" class="table-width">
                                    <thead class="table-head">
                                        <tr>
                                            <th><input type="checkbox" id="selectAllPR" class="rowCheckbox" /></th>

                                            <th>ItemCode</th>
                                            <th>Item Name</th>
                                            <th>Unit</th>
                                            <th>Nos</th>
                                            <th>Qty</th>
                                            <th>Bal. Qty</th>
                                            <th>Doc Type</th>
                                            <th>Doc No</th>
                                            <th>Doc Date</th>
                                            <th>Rate</th>
                                            <th>Remarks</th>
                                            <th>Department</th>
                                            <th>Dept Code </th>

                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="table-responsive">
                <table id="tblInwardEntry" class="table-width">
                    <thead class="table-head">
                        <tr>
                            <th>Code</th>
                            <th>Item Name</th>
                             <th>Department</th>
                            <th>Unit</th>
                            <th>Nos</th>
                            <th>Quantity</th>
                            <th>Ship Rate</th>
                            <th>Empty</th>
                            <th>Remarks</th>
                            <th>Ref Type</th>
                            <th>Ref No</th>
                            <th>DeptCode</th>
           
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

        </div>

        <div class="modal-footer">
            <button id="btn-save" type="button" class="btn btn-success">
                <i class="fa fa-save"></i> Save
            </button>

        </div>


    </form>
</fieldset>

<script>

        $(document).ready(async function () {
        const urlParams = new URLSearchParams(window.location.search);
        const rowId = urlParams.get('id');
        const mode = urlParams.get('mode');
        const vtype = urlParams.get('vtype');  // fixed lowercase

                 
        await LoadDropDown();

        if (rowId && rowId !== "0") {
            await LoadFormByID(rowId, vtype);
            if (typeof isReadOnly !== 'undefined' && isReadOnly) {
                setFormReadOnly();
            }
        }

        const ddlAddressLine1 = document.getElementById('ddladdressline1');
        if (ddlAddressLine1) {
            ddlAddressLine1.addEventListener('change', function () {
                const selectedPartyValue = document.getElementById('ddlPartyName')?.value;
                const selectedAddressValue = ddlAddressLine1.value;
                if (selectedPartyValue) {
                    fetchDDlParty(selectedPartyValue, selectedAddressValue);
                }
            });
        }

        $("#btn-save").click(function (e) {
            e.preventDefault();



                const  PARTY_CODE = parseInt($('#ddlPartyName').val()) || null ;
                const  V_TYPE =  $('#ddlDocType').val();
                  const  STATUS= parseInt($('#ddlDocStatus').val()) || null;

                    if (!V_TYPE) {
                toastr.warning("Please select a Voucher Type");
                        $("#ddlDocType").focus();
                return;
                }


                    if (!PARTY_CODE) {
                  toastr.warning("Please select a Party.");
                    $("#ddlPartyName").focus();
                  return;
                  }


                           if (!STATUS) {
                    toastr.warning("Please select a Status.");
                      $("#ddlDocStatus").focus();
                    return;
                    }

            const Header = {
                    V_TYPE: $('#ddlDocType').val(),
                    V_NO: parseInt($('#TxtDocNo').val()) || null,
                    DOC_ID: $.trim($('#TxtCode').val()) || null,
                    V_DATE: formatDate($("#InDate").val()) || null,
                    OUT_DATE: formatDate($("#DtVehicleOutTime").val()) || null,
                    V_TIME: $.trim($('#InTime').val()) || null,

                    R_DATE: formatDate($("#TxtRptDate").val()) || null,
                    R_TIME: $.trim($('#TiRptDate').val()) || null,
                    DISP_PLAN_NO: parseInt($('#TxtPONo').val()) || null,
                    DISP_PLAN_TYPE: $('#TxtPONo').val(),
                    PARTY_CODE: parseInt($('#ddlPartyName').val()) || null,
                    PARTY_ADDRESSID: parseInt($('#ddladdressline1').val()) || null,
                    BILL_NO: $.trim($('#TxtBillNo').val()) || null,
                    BILL_DATE: formatDate($("#DtPartyBillDate").val()) || null,
                    BILL_AMT: parseFloat($('#TxtBillAmt').val()) || 0.0,
                    CHALL_NO: $.trim($('#TxtChallanNo').val()) || null,
                    CHALL_DATE: formatDate($("#TxtChallanDate").val()) || null,
                    TRUCK_NO: $.trim($('#TxtVehicleNo').val()) || null,
                    TRANSPORT_CODE: parseInt($('#TxtTransporter').val()) || null,
                    DRIVER_NAME: $.trim($('#TxtDriverName').val()) || null,
                    DRIVER_NO: $.trim($('#TxtDriverMobile').val()) || null,
                    EWB_DATE: formatDate($("#DtEWayDate").val()) || null,
                    EWB_EXPDATE: formatDate($("#TxtEWayDate").val()) || null,
                    EWB_INVNO: $.trim($('#TxtEWBInvNo').val()) || null,
                    EWB_INVAMT: parseFloat($('#TxtEWBInvAmt').val()) || 0.0,
                    PARTY_WBSLIPNO: $.trim($('#TxtWbSlipNo').val()) || null,
                    PARTY_WBGRWT: parseFloat($('#TxtGrWt').val()) || 0.0,
                    PARTY_WBTRWT: parseFloat($('#TxtTrWt').val()) || 0.0,
                     PARTY_WBTIME: formatDate($("#DtWBTime").val()) || null,
                    PARTY_EWBCITY: parseInt($('#ddlPartyCity').val()) || null,
                    TRANSIT_NO: parseInt($('#ddlTransit').val()) || null,
