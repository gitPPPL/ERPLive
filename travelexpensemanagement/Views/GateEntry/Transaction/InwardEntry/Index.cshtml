                    <td>${item.rate || ''}</td>
                    <td>${item.remark || ''}</td>
                    <td>${item.department || ''}</td>
                    <td style="display:none;">${item.deptCode || ''}</td>
                    <td>${item.emptY_YN || ''}</td>
                    <td style="display:none;">${item.uoM_CODE || ''}</td>
