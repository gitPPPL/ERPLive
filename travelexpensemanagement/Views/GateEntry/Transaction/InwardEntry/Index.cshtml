                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                       

                    </div>
                </div>
            </div>
            <!-- Fastag Detail Modal -->
            <div class="modal fade" id="FastDetail" tabindex="-1" aria-labelledby="FastDetailLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl erppagesmodal">
                    <div class="modal-content erppagesmodal-content draggable-modal">

                        <!-- Header -->
                        <div class="erppagesmodal-header">
                            <div class="erppagesmodal-header-left">
                                <div class="erppagesmodal-header-icon">
                                    <i class="fa fa-credit-card"></i>
                                </div>
                                <h5 class="erppagesmodal-title">
                                    Fastag Data of Vehicle No.<span id="FastDetailLabel"></span>
                                </h5>
                            </div>

