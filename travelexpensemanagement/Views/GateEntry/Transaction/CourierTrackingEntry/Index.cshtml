@{
    ViewBag.Title = "Courier Tracking Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-truck"></i>
        </div>
        <div class="erppage-header-title">Courier Tracking Entry</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "CourierTrackingEntryList")', readOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="CourierTrackingEntryForm">
    <input type="hidden" class="form-control" id="TxtDocId" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Type</label>
                    <select class="erppage-input" id="ddlDocType"></select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-input" id="DtDocDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc No</label>
                    <input type="number" class="erppage-input" id="NumDocNo">
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Party Name</label>
                    <select class="erppage-redinput" id="ddlPartyName"></select>
                </div>

                <div class="erppage-divfield">
                    <label class="erppage-label">City</label>
                    <select class="erppage-input" id="ddlCity"></select>
                </div>

                <div class="erppage-divfield">
                    <label class="erppage-label">Courier Name</label>
                    <select class="erppage-redinput" id="ddlCourierName"></select>
                </div>
            </div>

            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Docket No</label>
                    <input type="text" class="erppage-redinput" id="TxtDocketNo">
                </div>

                <div class="erppage-divfield">
                    <label class="erppage-label">Received By</label>
                    <select class="erppage-input" id="ddlReceivedBy"></select>
                </div>

                <div class="erppage-divfield">
                    <label class="erppage-label">Purpose</label>
                    <select class="erppage-input" id="ddlPurpose"></select>
                </div>

                <div class="erppage-divfield">
                    <label class="erppage-label">Weight (gm)</label>
                    <input type="text" class="erppage-input" id="txtWeight">
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Remarks</label>
                    <textarea class="erppage-textarea" id="txtRemarks"></textarea>
                </div>
            </div>
        </fieldset>
        <fieldset class="erppage-subfieldset">
            <div class="erppage-subheader">Print Option</div>
            <div class="erppage-body">
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label">From</label>
                        <input type="date" class="erppage-input" id="Dtfrom">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">To</label>
                        <input type="date" class="erppage-input" id="DtTo">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">VType</label>
                        <select class="erppage-input" id="ddlVtype"></select>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Party</label>
                        <select class="erppage-input" id="ddlParty"></select>
                    </div>
                </div>
            </div>
            <div class="erppage-internalaction">
                <button type="button" id="btn-print" class="erppage-btn erppage-btn-copy">
                    <i class="fa fa-print"></i>
                    <span>Print</span>
                </button>
            </div>
        </fieldset>

    </div>
    <div class="erppage-actions">
        <button id="btn-save" type="submit" class="erppage-btn erppage-btn-save">
            <i class="fa-solid fa-floppy-disk"></i>
            <span>Save</span>
        </button>
        @* <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" id="btn_Print">
            <i class="fa fa-print"></i>Print
        </button> *@
    </div>
</div>
<script src="~/common/dropdown.js"></script>

<script>
    $(document).ready(function () {

        const params = new URLSearchParams(window.location.search);
        const docNo = params.get('id');
        const docType = params.get('type');
        const mode = params.get('mode');

        if (mode === "view") {
            setFormReadOnly();
            $('#CourierTrackingEntryForm')
                .after('<span class="badge bg-secondary ms-2">Read-Only Mode</span>');
        }

        // Bind all dropdowns (ONE LINE EACH)
        bindDropdown('CourierTrackingEntry','DocType', '#ddlDocType', '-- Select Doc Type --');
        bindDropdown('CourierTrackingEntry','City', '#ddlCity', '-- Select City --');
        bindDropdown('CourierTrackingEntry','Party', '#ddlPartyName', '-- Select Party Name --');
        bindDropdown('CourierTrackingEntry','Courier', '#ddlCourierName', '-- Select Courier --');
        bindDropdown('CourierTrackingEntry','Employee', '#ddlReceivedBy', '-- Select Received By --');
        bindDropdown('CourierTrackingEntry','Purpose', '#ddlPurpose', '-- Select Purpose --');

        // DocType change → get DocNo
        $('#ddlDocType').on('change', function () {
            const selectedValue = $(this).val();
            const selectedText = $(this).find("option:selected").text();

            if (selectedValue) {
                $.post('/CourierTrackingEntry/GetDocNo', {
                    docType: selectedValue,
                    docName: selectedText
                }, function (response) {
                    if (response.success) {
                        $('#NumDocNo').val(response.nextVNo);
                    }
                });
            }
        });

        // EDIT MODE
        if (docNo) {
            $.ajax({
                url: '/CourierTrackingEntry/GetCourierDataList',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ docNo: docNo, docType: docType }),
                success: function (data) {
                    bindCourierTracking(data);
                }
            });
        }

        // SAVE
        $('#btn-save').on('click', function (e) {
            e.preventDefault();

            const formData = {
                DocType: $('#ddlDocType').val(),
                DocDate: $('#DtDocDate').val(),
                DocNo: $('#NumDocNo').val(),
                PartyName: $('#ddlPartyName').val(),
                City: $('#ddlCity').val(),
                CourierName: $('#ddlCourierName').val(),
                DocketNo: $('#TxtDocketNo').val(),
                ReceivedBy: $('#ddlReceivedBy').val(),
                Purpose: $('#ddlPurpose').val(),
                Weight: $('#txtWeight').val(),
                Remarks: $('#txtRemarks').val(),
                V_No: docNo,
                ACTION: docNo ? "UPDATE" : "INSERT"
            };

            $.ajax({
                url: '/CourierTrackingEntry/SaveCourierData',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (res) {
                    res.success ? toastr.success(res.message)
                                : toastr.error(res.message);
                },
                error: function () {
                    toastr.error('Error saving data');
                }
            });
        });

    });

    // 🔥 Bind data in edit mode
    function bindCourierTracking(data) {
        bindDropdown('CourierTrackingEntry','DocType', '#ddlDocType', '-- Select Doc Type --', data.vType);
        bindDropdown('CourierTrackingEntry','City', '#ddlCity', '-- Select City --', data.city);
        bindDropdown('CourierTrackingEntry','Party', '#ddlPartyName', '-- Select Party Name --', data.partyName);
        bindDropdown('CourierTrackingEntry','Courier', '#ddlCourierName', '-- Select Courier --', data.courierName);
        bindDropdown('CourierTrackingEntry','Employee', '#ddlReceivedBy', '-- Select Received By --', data.receivedBy);
        bindDropdown('CourierTrackingEntry','Purpose', '#ddlPurpose', '-- Select Purpose --', data.purpose);

        $('#DtDocDate').val(data.docDate ? formatDate(data.docDate) : '');
        $('#NumDocNo').val(data.docNo || '');
        $('#TxtDocketNo').val(data.docketNo || '');
        $('#txtWeight').val(data.weight || '');
        $('#txtRemarks').val(data.remarks || '');
    }
    // Format Date
    function formatDate(dateStr) {
        if (!dateStr) return '';
        const [day, month, year] = dateStr.split('/');
        return `${year}-${month}-${day}`;
    }

    // Readonly Mode
    function setFormReadOnly() {
        $('#CourierTrackingEntryForm input').prop('readonly', true);
        $('#CourierTrackingEntryForm select').prop('disabled', true);
        $('#btn-save').hide();
    }

</script>

