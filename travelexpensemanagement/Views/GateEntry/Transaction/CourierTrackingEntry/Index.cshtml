@{
    ViewBag.Title = "Courier Tracking Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
    <legend class="legend-field">Courier Tracking Entry</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="window.location.href='@Url.Action("Index", "CourierTrackingEntryList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>
    <form id="CourierTrackingEntryForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlDocType">Doc Type</label>
                    <select class="form-control" id="ddlDocType">
                        <option>--Select DOC Type--</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DtDocDate">Doc Date</label>
                    <input type="date" class="form-control" id="DtDocDate">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumDocNo">Doc No</label>
                    <input type="text" class="form-control" id="NumDocNo" placeholder="Enter Doc No">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlPartyName">Party Name<span class="required">*</span></label>
                    <select class="form-control" id="ddlPartyName">
                        <option value="">Select Party Name</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlCity">City</label>
                    <select class="form-control" id="ddlCity">
                        <option value="">Select City</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlCourierName">Courier Name<span class="required">*</span></label>
                    <select class="form-control" id="ddlCourierName">
                        <option value="">Select Courier Name</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtDocketNo">Docket No<span class="required">*</span></label>
                    <input type="text" class="form-control" id="TxtDocketNo" placeholder="Enter Docket No">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlReceivedBy">Received By</label>
                    <select class="form-control" id="ddlReceivedBy">
                        <option value="">Select Received By</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlPurpose">Purpose</label>
                    <select class="form-control" id="ddlPurpose">
                        <option value="">Select Purpose</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtWeight">Weight (in gm)</label>
                    <input type="text" class="form-control" id="txtWeight" placeholder="Enter Weight (in gm)">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="txtRemarks">Remarks</label>
                    <textarea type="text" class="form-control" id="txtRemarks" placeholder="Enter Remarks"></textarea>
                </div>
            </div>
        </div>
        <fieldset class="fieldset-sub">
            <legend class="sub-legend">Print Option</legend>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="DtFrom">From</label>
                        <input type="date" class="form-control" id="Dtfrom">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="DtTo">To</label>
                        <input type="date" class="form-control" id="DtTo">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="ddlVType">VType</label>
                        <select class="form-control" id="ddlVtype">
                            <option value="">Select Vtype</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="ddlParty">Party</label>
                        <select class="form-control" id="ddlParty">
                            <option value="">Select Party</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="button-right">
                        <button id="btn-print" type="submit" class="btn btn-primary"><i class="fa fa-print"></i>Print</button>
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="row">
            <div class="offset-md-10 col-md-2">
                <div class="btn-last">
                    <button id="btn-save" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
                </div>
            </div>
        </div>
    </form>
</fieldset>
<script src="~/common/dropdown.js"></script>

<script>
    $(document).ready(function () {

        const params = new URLSearchParams(window.location.search);
        const docNo = params.get('id');
        const docType = params.get('type');
        const mode = params.get('mode');

        if (mode === "view") {
            setFormReadOnly();
            $('#CourierTrackingEntryForm')
                .after('<span class="badge bg-secondary ms-2">Read-Only Mode</span>');
        }

        // Bind all dropdowns (ONE LINE EACH)
        bindDropdown('CourierTrackingEntry','DocType', '#ddlDocType', '-- Select Doc Type --');
        bindDropdown('CourierTrackingEntry','City', '#ddlCity', '-- Select City --');
        bindDropdown('CourierTrackingEntry','Party', '#ddlPartyName', '-- Select Party Name --');
        bindDropdown('CourierTrackingEntry','Courier', '#ddlCourierName', '-- Select Courier --');
        bindDropdown('CourierTrackingEntry','Employee', '#ddlReceivedBy', '-- Select Received By --');
        bindDropdown('CourierTrackingEntry','Purpose', '#ddlPurpose', '-- Select Purpose --');

        // DocType change → get DocNo
        $('#ddlDocType').on('change', function () {
            const selectedValue = $(this).val();
            const selectedText = $(this).find("option:selected").text();

            if (selectedValue) {
                $.post('/CourierTrackingEntry/GetDocNo', {
                    docType: selectedValue,
                    docName: selectedText
                }, function (response) {
                    if (response.success) {
                        $('#NumDocNo').val(response.nextVNo);
                    }
                });
            }
        });

        // EDIT MODE
        if (docNo) {
            $.ajax({
                url: '/CourierTrackingEntry/GetCourierDataList',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ docNo: docNo, docType: docType }),
                success: function (data) {
                    bindCourierTracking(data);
                }
            });
        }

        // SAVE
        $('#btn-save').on('click', function (e) {
            e.preventDefault();

            const formData = {
                DocType: $('#ddlDocType').val(),
                DocDate: $('#DtDocDate').val(),
                DocNo: $('#NumDocNo').val(),
                PartyName: $('#ddlPartyName').val(),
                City: $('#ddlCity').val(),
                CourierName: $('#ddlCourierName').val(),
                DocketNo: $('#TxtDocketNo').val(),
                ReceivedBy: $('#ddlReceivedBy').val(),
                Purpose: $('#ddlPurpose').val(),
                Weight: $('#txtWeight').val(),
                Remarks: $('#txtRemarks').val(),
                V_No: docNo,
                ACTION: docNo ? "UPDATE" : "INSERT"
            };

            $.ajax({
                url: '/CourierTrackingEntry/SaveCourierData',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (res) {
                    res.success ? toastr.success(res.message)
                                : toastr.error(res.message);
                },
                error: function () {
                    toastr.error('Error saving data');
                }
            });
        });

    });

    // 🔥 Bind data in edit mode
    function bindCourierTracking(data) {
        bindDropdown('CourierTrackingEntry','DocType', '#ddlDocType', '-- Select Doc Type --', data.vType);
        bindDropdown('CourierTrackingEntry','City', '#ddlCity', '-- Select City --', data.city);
        bindDropdown('CourierTrackingEntry','Party', '#ddlPartyName', '-- Select Party Name --', data.partyName);
        bindDropdown('CourierTrackingEntry','Courier', '#ddlCourierName', '-- Select Courier --', data.courierName);
        bindDropdown('CourierTrackingEntry','Employee', '#ddlReceivedBy', '-- Select Received By --', data.receivedBy);
        bindDropdown('CourierTrackingEntry','Purpose', '#ddlPurpose', '-- Select Purpose --', data.purpose);

        $('#DtDocDate').val(data.docDate ? formatDate(data.docDate) : '');
        $('#NumDocNo').val(data.docNo || '');
        $('#TxtDocketNo').val(data.docketNo || '');
        $('#txtWeight').val(data.weight || '');
        $('#txtRemarks').val(data.remarks || '');
    }
    // Format Date
    function formatDate(dateStr) {
        if (!dateStr) return '';
        const [day, month, year] = dateStr.split('/');
        return `${year}-${month}-${day}`;
    }

    // Readonly Mode
    function setFormReadOnly() {
        $('#CourierTrackingEntryForm input').prop('readonly', true);
        $('#CourierTrackingEntryForm select').prop('disabled', true);
        $('#btn-save').hide();
    }
      
</script>

