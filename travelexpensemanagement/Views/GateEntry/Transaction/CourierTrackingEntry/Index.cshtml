    //    $("#NumDocNo").prop("readonly", true);
    //     bindDropdown('CourierTrackingEntry','DocType', '#ddlDocType', '-- Select Doc Type --', data.vType);
    //     bindDropdownNew('CourierTrackingEntry','City', '#ddlCity', '-- Select City --', data.city);
    //     bindDropdownNew('CourierTrackingEntry','Party', '#ddlPartyName', '-- Select Party Name --', data.partyName);
    //     bindDropdownNew('CourierTrackingEntry','Courier', '#ddlCourierName', '-- Select Courier --', data.courierName);
    //     bindDropdown('CourierTrackingEntry','Employee', '#ddlReceivedBy', '-- Select Received By --', data.receivedBy);
    //     bindDropdownNew('CourierTrackingEntry','Purpose', '#ddlPurpose', '-- Select Purpose --', data.purpose);

    //     $('#DtDocDate').val(data.docDate ? formatDate(data.docDate) : '');

    //     var docNo = '';
    //     if (data.docNo && data.docNo.length > 4) {
    //         docNo = data.docNo.substring(4);
    //     }

    //     // Bind to textbox
    //     $('#NumDocNo').val(docNo);

    //         $('#TxtDocketNo').val(data.docketNo || '');
    //         $('#txtWeight').val(data.weight || '');
    //         $('#txtRemarks').val(data.remarks || '');
    //     }
    // Format Date
    function formatDate(dateStr) {
        if (!dateStr) return '';
        const [day, month, year] = dateStr.split('/');
        return `${year}-${month}-${day}`;
    }


        function setFormReadOnly() {

        // Textbox
        $("#CourierTrackingEntryForm")
            .find("input:not([type='hidden'])")
            .prop("readonly", true)
            .prop("disabled", true);

        // Textarea
        $("#CourierTrackingEntryForm textarea")
            .prop("readonly", true)
            .prop("disabled", true);

        // Dropdown
        $("#CourierTrackingEntryForm select")
            .prop("disabled", true);

        // Autocomplete destroy
        if ($("#ddlPartyName").data("ui-autocomplete"))
            $("#ddlPartyName").autocomplete("destroy");

        if ($("#ddlCity").data("ui-autocomplete"))
            $("#ddlCity").autocomplete("destroy");

        if ($("#ddlCourierName").data("ui-autocomplete"))
            $("#ddlCourierName").autocomplete("destroy");

        if ($("#ddlPurpose").data("ui-autocomplete"))
            $("#ddlPurpose").autocomplete("destroy");

        if ($("#ddlParty").data("ui-autocomplete"))
            $("#ddlParty").autocomplete("destroy");

        // Remove all events
        $("#CourierTrackingEntryForm")
            .find("input, textarea, select")
            .off("keydown keyup keypress change click focus");

        // Save button
        $("#btn-save").hide();
    }


  


</script>

