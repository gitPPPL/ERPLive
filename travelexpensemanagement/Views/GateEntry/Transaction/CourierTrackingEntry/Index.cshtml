@{
    ViewBag.Title = "Courier Tracking Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-truck"></i>
        </div>
        <div class="erppage-header-title">Courier Tracking Entry</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "CourierTrackingEntryList")', readOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="CourierTrackingEntryForm">
    <input type="hidden" class="form-control" id="TxtDocId" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Type</label>
                    <select class="erppage-input" id="ddlDocType"></select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-input" id="DtDocDate">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc No</label>
                    <input type="number" class="erppage-input" id="NumDocNo">
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Party Name</label>
                    <select class="erppage-redinput" id="ddlPartyName"></select>
                </div>

                <div class="erppage-divfield">
                    <label class="erppage-label">City</label>
                    <select class="erppage-input" id="ddlCity"></select>
                </div>

                <div class="erppage-divfield">
                    <label class="erppage-label">Courier Name</label>
                    <select class="erppage-redinput" id="ddlCourierName"></select>
                </div>
            </div>

            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Docket No</label>
                    <input type="text" class="erppage-redinput" id="TxtDocketNo">
                </div>

                <div class="erppage-divfield">
                    <label class="erppage-label">Received By</label>
                    <select class="erppage-input" id="ddlReceivedBy"></select>
                </div>

                <div class="erppage-divfield">
                    <label class="erppage-label">Purpose</label>
                    <select class="erppage-input" id="ddlPurpose"></select>
                </div>

                <div class="erppage-divfield">
                    <label class="erppage-label">Weight (gm)</label>
                    <input type="text" class="erppage-input" id="txtWeight">
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Remarks</label>
                    <textarea class="erppage-textarea" id="txtRemarks"></textarea>
                </div>
            </div>
        </fieldset>
        <fieldset class="erppage-subfieldset">
            <div class="erppage-subheader">Print Option</div>
            <div class="erppage-body">
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label">From</label>
                        <input type="date" class="erppage-input" id="Dtfrom">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">To</label>
                        <input type="date" class="erppage-input" id="DtTo">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">VType</label>
                        <select class="erppage-input" id="ddlVtype"></select>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Party</label>
                        <select class="erppage-input" id="ddlParty"></select>
                    </div>
                </div>
            </div>
            <div class="erppage-internalaction">
                <button type="button" id="btn-print" class="erppage-btn erppage-btn-copy">
                    <i class="fa fa-print"></i>
                    <span>Print</span>
                </button>
            </div>
        </fieldset>

    </div>
    <div class="erppage-actions">
        <button id="btn-save" type="submit" class="erppage-btn erppage-btn-save">
            <i class="fa-solid fa-floppy-disk"></i>
            <span>Save</span>
        </button>
        @* <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" id="btn_Print">
            <i class="fa fa-print"></i>Print
        </button> *@
    </div>
</div>



