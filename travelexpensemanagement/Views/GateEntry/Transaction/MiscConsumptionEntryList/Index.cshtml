@{
    ViewBag.Title = "Misc Consumption Entry List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- HEADER -->
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>Misc Consumption Entry List</span>
    </div>

    <div class="erppagelist-header-right">
        <button type="button"
                class="erppage-header-back"
                onclick="location.href='@Url.Action("Index", "MiscConsumptionEntry")'">
            <i class="fa fa-plus"></i> Add New
        </button>
    </div>
</div>

<!-- TOOLBAR -->
<div class="erppagelist-toolbar">

    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text"
               id="searchBox"
               placeholder="Search by All Columns Name..." />
    </div>

    <div class="erppagelist-actions">

        <button class="erppagelist-btn erppagelist-btn-action">
            <i class="fa fa-print"></i> Print
        </button>

        <button class="erppagelist-btn erppagelist-btn-action">
            <i class="fa fa-file-excel"></i> Export
        </button>

        <button class="erppagelist-btn erppagelist-btn-action">
            <i class="fa fa-envelope"></i> Mail
        </button>

        <button class="erppagelist-btn erppagelist-btn-action">
            <i class="fa fa-check"></i> Approved
        </button>

    </div>

</div>

<!-- TABLE -->
<div class="erppagelist-container">

    <div class="excel-wrapper fixed-grid-wrapper">

        <table id="tblMiscConsumptionList"
               class="excel-table fixed-grid-table">

            <colgroup>
                <col style="width:150px;" />
                <col style="width:150px;" />
                <col style="width:140px;" />
                <col style="width:250px;" />
                <col style="width:180px;" />
            </colgroup>

            <thead>
                <tr>
                    <th>Voucher No</th>
                    <th>Voucher Type</th>
                    <th>Voucher Date</th>
                    <th>Party Name</th>
                    <th class="action-col">Action</th>
                </tr>
            </thead>

            <tbody></tbody>

        </table>

    </div>

    <!-- PAGINATION -->
    <div class="erppagelist-pagination">

        <!-- LEFT -->
        <div class="pagination-left">

            <select id="pageSizeSelect"
                    onchange="changeRowsPerPage()">

                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>

            </select>

        </div>

        <!-- CENTER -->
        <div class="pagination-center">

            <button onclick="prevPage()"
                    class="page-nav"
                    id="prevBtn">
                ‹
            </button>

            <div id="pageNumbers"
                 class="page-numbers"></div>

            <button onclick="nextPage()"
                    class="page-nav"
                    id="nextBtn">
                ›
            </button>

        </div>

        <!-- RIGHT -->
        <div class="pagination-right"
             id="pageInfoText">

            Results: 0 - 0 of 0

        </div>

    </div>

</div>

<script>

    let currentPage = 1;
    let pageSize = 10;
    let totalCount = 0;
    let searchTimer;

    $(document).ready(function () {

        loadAllMenus();

        // SEARCH DEBOUNCE
        $('#searchBox').on('keyup', function () {

            clearTimeout(searchTimer);

            searchTimer = setTimeout(function () {

                currentPage = 1;
                loadAllMenus();

            }, 400);

        });

    });

    // ================= LOAD =================
    function loadAllMenus() {

        $.ajax({

            url: '/MiscConsumptionEntryList/GetList',
            type: 'GET',
            dataType: 'json',

            data: {
                searchTerm: $('#searchBox').val(),
                pageNumber: currentPage,
                pageSize: pageSize
            },

            beforeSend: function () {

                $('#tblMiscConsumptionList tbody').html(`
                    <tr>
                        <td colspan="5" class="text-center">
                            Loading...
                        </td>
                    </tr>
                `);

            },

            success: function (res) {

                if (!res.success) {
                    toastr.error(res.message || 'Failed to load data');
                    return;
                }

                const list = res.headers || res.lists || res.data || [];
                totalCount = res.totalCount || 0;

                renderTable(list);
                renderPagination();

            },

            error: function (xhr) {

                toastr.error('Error loading list: ' + xhr.responseText);

            }

        });

    }

    // ================= TABLE =================
    function renderTable(list) {

        const tbody = $('#tblMiscConsumptionList tbody');

        tbody.empty();

        if (!list || list.length === 0) {

            tbody.append(`
                <tr>
                    <td colspan="5"
                        class="text-center text-muted">
                        No records found.
                    </td>
                </tr>
            `);

            return;
        }

        $.each(list, function (index, item) {

            tbody.append(`

                <tr>

                    <td>${item.v_NO || ''}</td>

                    <td>${item.v_TYPE || ''}</td>

                    <td>${formatDate(item.v_DATE)}</td>

                    <td>${item.partY_NAME || ''}</td>

                    <td class="action-col">

                        <button class="act-btn edit"
                                onclick="AddOrEditFunction('${item.v_NO}','${item.vtypeCode}')">

                            <i class="fa fa-edit"></i>

                        </button>

                        <button class="act-btn view"
                                onclick="viewMenuDetails('${item.v_NO}','${item.vtypeCode}')">

                            <i class="fa fa-eye"></i>

                        </button>

                        <button class="act-btn delete"
                                onclick="deleteTemp('${item.v_NO}','${item.vtypeCode}')">

                            <i class="fa fa-trash"></i>

                        </button>

                    </td>

                </tr>

            `);

        });

    }

    // ================= PAGINATION =================
    function renderPagination() {

        const totalPages = Math.ceil(totalCount / pageSize) || 1;

        let html = '';

        let maxVisible = 5;

        let startPage = Math.max(
            1,
            currentPage - Math.floor(maxVisible / 2)
        );

        let endPage = startPage + maxVisible - 1;

        if (endPage > totalPages) {

            endPage = totalPages;

            startPage = Math.max(
                1,
                endPage - maxVisible + 1
            );

        }

        if (startPage > 1) {

            html += `
                <span class="page-number"
                      onclick="goToPage(1)">
                    1
                </span>
            `;

            if (startPage > 2) {
                html += `<span class="dots">...</span>`;
            }

        }

        for (let i = startPage; i <= endPage; i++) {

            html += `
                <span class="page-number ${i === currentPage ? 'active' : ''}"
                      onclick="goToPage(${i})">

                    ${i}

                </span>
            `;

        }

        if (endPage < totalPages) {

            if (endPage < totalPages - 1) {
                html += `<span class="dots">...</span>`;
            }

            html += `
                <span class="page-number"
                      onclick="goToPage(${totalPages})">

                    ${totalPages}

                </span>
            `;

        }

        $('#pageNumbers').html(html);

        let start = (currentPage - 1) * pageSize + 1;
        let end = Math.min(currentPage * pageSize, totalCount);

        if (totalCount === 0) {
            start = 0;
            end = 0;
        }

        $('#pageInfoText')
            .text(`Results: ${start} - ${end} of ${totalCount}`);

        $('#prevBtn')
            .prop('disabled', currentPage === 1);

        $('#nextBtn')
            .prop('disabled', currentPage === totalPages);

    }

    // ================= PAGINATION ACTIONS =================
    function prevPage() {

        if (currentPage > 1) {

            currentPage--;
            loadAllMenus();

        }

    }

    function nextPage() {

        const totalPages =
            Math.ceil(totalCount / pageSize);

        if (currentPage < totalPages) {

            currentPage++;
            loadAllMenus();

        }

    }

    function goToPage(page) {

        currentPage = page;
        loadAllMenus();

    }

    function changeRowsPerPage() {

        pageSize = parseInt(
            $('#pageSizeSelect').val()
        );

        currentPage = 1;

        loadAllMenus();

    }

    // ================= DATE =================
    function formatDate(dateStr) {

        if (!dateStr) return '';

        const d = new Date(dateStr);

        if (isNaN(d)) return '';

        const day = String(d.getDate()).padStart(2, '0');
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const year = d.getFullYear();

        return `${day}-${month}-${year}`;

    }

    // ================= ACTIONS =================
    function AddOrEditFunction(code, vtype) {

        window.location.href =
            `/MiscConsumptionEntry/Index?id=${encodeURIComponent(code)}&vtype=${encodeURIComponent(vtype)}`;

    }

    function viewMenuDetails(code, vtype) {

        window.location.href =
            `/MiscConsumptionEntry/Index?id=${encodeURIComponent(code)}&vtype=${encodeURIComponent(vtype)}&mode=view`;

    }

    function deleteTemp(code, vtype) {

        Swal.fire({

            title: 'Are you sure?',
            text: 'You want to delete this Misc Consumption Entry?',
            icon: 'warning',

            showCancelButton: true,

            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',

            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel'

        }).then((result) => {

            if (result.isConfirmed) {

                $.ajax({

                    url: '/MiscConsumptionEntryList/Delete',

                    type: 'POST',

                    dataType: 'json',

                    data: {
                        code: code,
                        vtype: vtype
                    },

                    beforeSend: function () {

                        Swal.fire({

                            title: 'Deleting...',
                            text: 'Please wait',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }

                        });

                    },

                    success: function (res) {

                        Swal.close();

                        if (res.success) {

                            toastr.success(
                                res.message || 'Deleted successfully'
                            );

                            // AUTO PAGE FIX
                            const totalPages =
                                Math.ceil((totalCount - 1) / pageSize);

                            if (currentPage > totalPages && currentPage > 1) {
                                currentPage--;
                            }

                            loadAllMenus();

                        } else {

                            toastr.error(
                                res.message || 'Failed to delete'
                            );

                        }

                    },

                    error: function (xhr) {

                        Swal.close();

                        toastr.error(
                            xhr.responseText || 'Error deleting record'
                        );

                    }

                });

            }

        });

    }
</script>