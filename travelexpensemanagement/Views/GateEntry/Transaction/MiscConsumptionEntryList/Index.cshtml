@{
	ViewBag.Title = "Misc Consumption Entry List";
	Layout = "~/Views/Shared/_Layout.cshtml";

}

<fieldset>
	<legend class="legend-field">Misc Consumption Entry List</legend>
	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>
		<div class="col-lg-6">
			<div class="btn-rightalign">
				<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "MiscConsumptionEntry")'" type="submit" class="btn btn-add">
					<i class="fa fa-plus"></i>Add
				</button>
				<button class="btn btn-print" onclick="printCityMasterReport()">
					<i class="fa fa-print"></i> Print
				</button>
				<button class="btn btn-export">
					<i class="fas fa-file-export"></i> Export
				</button>
				<button class="btn btn-mail">
					<i class="fa fa-envelope"></i> Mail
				</button>
				<button class="btn btn-approved">
					<i class="fa fa-check"></i> Approved
				</button>
			</div>
		</div>
	</div>
	<div class="card">
		<div class="table-responsive">
			<table id="tblMiscConsumptionList" class="table-width">
				<thead class="table-head">
					<tr>
					
						<th>Voucher No</th>
						<th>Voucher Type</th>
						<th>Voucher Date</th>
						<th>Party Name</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
	</div>
</fieldset>

<script>


	let currentPage = 1;
	let pageSize = 10;


	$(document).ready(function () {
			loadAllMenus();
		});

		function loadAllMenus(page = 1) {
	  currentPage = page;
	  const searchTerm = $('#searchBox').val();

	  console.log('Loading page', page, 'search:', searchTerm);

	  $.ajax({
		url: '/MiscConsumptionEntryList/GetList',
		type: 'GET',
		dataType: 'json',
		data: {
		  searchTerm,
		  pageNumber: currentPage,
		  pageSize
		},
		success: function(res) {


		  if (!res.success) {
			toastr.error(res.message || "Failed to load data.");
			return;
		  }

		  const list = res.headers ?? res.lists ?? res.data ?? [];
		  const totalCount = res.totalCount ?? 0;
		  const tbody = $('#tblMiscConsumptionList tbody');

		  console.log('table' , list);

		  tbody.empty();



		  if (!Array.isArray(list) || list.length === 0) {
			tbody.append('<tr><td colspan="10" class="text-center text-muted">No records found.</td></tr>');
		  } else {
			list.forEach(item => {
			  tbody.append(`
				<tr>
		
				  <td>${item.v_NO ?? ''}</td>
				  <td>${item.v_TYPE ?? ''}</td>
				  <td>${formatDate(item.v_DATE)}</td>
				  <td>${item.partY_NAME ?? ''}</td>
					
				  <td>
					<button class="btn btn-sm btn-light" onclick="AddOrEditFunction('${item.v_NO}','${item.vtypeCode}')">
					<i class="fas fa-edit" title="Edit"></i>
					</button>
					<button class="btn btn-sm btn-light" onclick="viewMenuDetails('${item.v_NO}', '${item.vtypeCode}')">
					<i class="fas fa-eye" title="View Detail"></i>
					</button>
					<button class="btn btn-sm btn-light btn-delete" onclick="deleteTemp('${item.v_NO}', '${item.vtypeCode}')">
					<i class="fas fa-trash text-danger" title="Delete"></i>
					</button>
				  </td>
				</tr>`);
			});
		  }

		  renderPagination(totalCount, pageSize, currentPage);
		},
		error: function(xhr) {
		  toastr.error('Error loading menu list: ' + xhr.responseText);
		}
	  });
	}

	function formatDate(dateStr) {
			if (!dateStr) return '';
			const d = new Date(dateStr);
			if (isNaN(d)) return '';
			return d.toISOString().slice(0, 10);
		}


	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const pagination = $('#tablePagination');
		pagination.empty();

		if (totalPages <= 1) return;

		let html = '';

		if (currentPage > 1) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		const startPage = Math.max(1, currentPage - 2);
		const endPage = Math.min(totalPages, currentPage + 2);

		for (let i = startPage; i <= endPage; i++) {
			html += `
				<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
		}

		if (currentPage < totalPages) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		pagination.html(html);
	}

	function goToPage(page) {
		currentPage = page;
		loadDocumentStages();
	}

	function AddOrEditFunction(code, vtype) {
			console.log('Selected Vtype:', vtype);
				window.location.href = `/MiscConsumptionEntry/Index?id=${encodeURIComponent(code)}&vtype=${encodeURIComponent(vtype)}`;



		}

		function viewMenuDetails(code, vtype) {
				console.log('Selected Vtype:', vtype);
			window.location.href = '/MiscConsumptionEntry/Index?id=' + encodeURIComponent(code) + '&vtype=' + encodeURIComponent(vtype) + '&mode=view';
		}


		function deleteTemp(code, vtype) {
			if (!confirm('Are you sure you want to delete this Inward Entry?')) return;

			$.ajax({
				url: '/MiscConsumptionEntryList/Delete',
				type: 'POST',
				data: { code: code, vtype: vtype }, // Adding VType to request
				success: function (res) {
					if (res.success) {
						toastr.success(res.message || 'Deleted successfully.');
						loadAllMenus(); // Refresh UI or list
					} else {
						toastr.error(res.message || 'Failed to delete.');
					}
				},
				error: function (xhr, status, error) {
					toastr.error(`Error deleting Misc Consumption Entry: ${xhr.responseText || error}`);
				}
			});
		}



</script>
