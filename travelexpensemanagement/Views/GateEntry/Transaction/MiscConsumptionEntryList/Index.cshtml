@{
	ViewBag.Title = "Misc Consumption Entry List";
	Layout = "~/Views/Shared/_Layout.cshtml";

}

<div id="erp-center-toast-container"></div>
<!-- HEADER -->
<div class="erppagelist-header">
	<div class="erppagelist-title">
		<i class="fa fa-list"></i>
		<span>Misc Consumption Entry List</span>
	</div>
	<div class="erppagelist-header-right">
		<button class="erppagelist-btn erppagelist-btn-add erppagelist-btn-add" onclick="location.href='@Url.Action("Index", "MiscConsumptionEntry")'">
			<i class="fa fa-plus"></i>Add New
		</button>
	</div>
</div>

<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
	<div class="erppagelist-search-wrapper">
		<i class="fa fa-search"></i>
		<input type="text" id="tableSearch" placeholder="Search by All Columns Name...." />
	</div>
	<div class="erppagelist-actions">
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" id="btnPrint">
			<i class="fa fa-print"></i>Print
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" id="btnExport" data-tooltip="Export to Excel">
			<i class="fa fa-file-excel"></i>Export
		</button>
		 <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail">
			<i class="fa fa-envelope"></i>Mail
		</button>
		<button class="erppagelist-btn erppagelist-btn-approve tooltip-btn" data-tooltip="Approve Records">
			<i class="fa fa-check-circle"></i>Approved
		</button> 
	</div>
</div>

<div class="erppagelist-container">
	<div class="excel-wrapper fixed-grid-wrapper">
		<table id="tblMiscConsumptionList" class="excel-table fixed-grid-table">
			<colgroup>
				<col style="display:none;" />
				<col style="width: 80px;" /> 
				<col style="width: 110px;" />
				<col style="width: 150px;" />
				<col style="width: 180px;" />
				<col style="width: 100px;" />
			</colgroup>
			<thead>
				<tr>
					<th>Voucher No</th>
					<th>Voucher Type</th>
					<th>Voucher Date</th>
					<th>Party Name</th>
				    @*<th>Action</th> *@
					<th class="action-col">Action</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>

	</div>

	<div class="erppagelist-pagination">
		<div class="pagination-left">
			<select id="pageSizeSelect" onchange="changeRowsPerPage()">
				<option value="5">5</option>
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
			</select>
		</div>
		<div class="pagination-center">
			<button onclick="prevPage()" class="page-nav" id="prevBtn">‹</button>
			<div id="pageNumbers" class="page-numbers"></div>

			<button onclick="nextPage()" class="page-nav" id="nextBtn">›</button>
		</div>
		<div class="pagination-right" id="pageInfoText">
			Results: 0 - 0 of 0
		</div>
	</div>
</div>

<script src="~/common/delete.js"></script>
<script src="~/common/pagination.js"></script>
<script src="~/js/erpjs/gateentry/transaction/misconsumptionentrylistjs/misconsumptionentrylist.js"></script>


