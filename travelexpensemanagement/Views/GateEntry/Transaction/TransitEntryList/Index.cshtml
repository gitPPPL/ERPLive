@{
    ViewBag.Title = "Transit Entry List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<!-- HEADER -->
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>Transit Entry List</span>
    </div>
    <div class="erppagelist-header-right">
        <button class="erppage-header-back" onclick="location.href='@Url.Action("Index", "TransitEntry")'">
            <i class="fa fa-plus"></i>Add New
        </button>
    </div>
</div>
<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" id="searchBox" placeholder="Search by All Columns Name...." />
    </div>
    <div class="erppagelist-actions">
		<div class="erppage-divfield">
			<label class="erppage-label">EWaybill Date</label>
			<input type="date" class="erppage-input" id="DtEWaybillDate" disabled />
		</div>
		<button type="button" class="erppage-btn erppage-btn-copy" id="btnEWayBillImportData">
			<i class="fa fa-download"></i>
			<span>Import and save EWayBill Data</span>
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" onclick="printCityMasterReport()">
            <i class="fa fa-print"></i> Print
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Export to Excel">
            <i class="fa fa-file-excel"></i> Export
        </button>
    </div>
</div>
<div class="erppagelist-container">
	<div class="excel-wrapper fixed-grid-wrapper">
		<table id="tblTransitEntryList" class="excel-table fixed-grid-table">
			<colgroup>
				<col style="display:none;" /> <!-- Code, hidden -->
				<col style="width: 80px;" />  <!-- V_Type -->
				<col style="width: 80px;" />  <!-- V_No -->
				<col style="width: 120px;" /> <!-- WayBill No -->
				<col style="width: 120px;" /> <!-- Create Date -->
				<col style="width: 120px;" /> <!-- Expiry_Date -->
				<col style="width: 180px;" /> <!-- Party_Name -->
				<col style="width: 140px;" /> <!-- Party_Gstin -->
				<col style="width: 100px;" /> <!-- Bill_No -->
				<col style="width: 120px;" /> <!-- Bill_Date -->
				<col style="width: 80px;" />  <!-- Truck_No -->
				<col style="width: 140px;" /> <!-- Action -->
			</colgroup>
			<thead>
				<tr>
					<th style="display:none;">Code</th>
					<th>V_Type</th>
					<th>V_No</th>
					<th>WayBill No</th>
					<th>Create Date</th>
					<th>Expiry_Date</th>
					<th>Party_Name</th>
					<th>Party_Gstin</th>
					<th>Bill_No</th>
					<th>Bill_Date</th>
					<th>Truck_No</th>
					<th class="action-col">Action</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>

	<div class="erppagelist-pagination">
		<div class="pagination-left">
			<select id="pageSizeSelect" onchange="changeRowsPerPage()">
				<option value="5">5</option>
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
			</select>
		</div>
		<div class="pagination-center">
			<button onclick="prevPage()" class="page-nav" id="prevBtn">‹</button>
			<div id="pageNumbers" class="page-numbers"></div>

			<button onclick="nextPage()" class="page-nav" id="nextBtn">›</button>
		</div>
		<div class="pagination-right" id="pageInfoText">
			Results: 0 - 0 of 0
		</div>
	</div>
</div>


<script src="~/common/delete.js"></script>
<script src="~/common/pagination.js"></script>
<script src="~/js/erpjs/gateentry/transaction/transitentrylist/transitentrylist.js"></script>
