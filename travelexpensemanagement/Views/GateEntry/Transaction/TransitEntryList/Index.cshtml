@{
	ViewBag.Title = "Transit Entry List";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
	<legend class="legend-field">Transit Entry List</legend>
	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>
		<div class="col-lg-6">
			<div class="btn-rightalign">
				<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "TransitEntry")'" type="submit" class="btn btn-add">
					<i class="fa fa-plus"></i>Add
				</button>
				<button class="btn btn-print" onclick="printCityMasterReport()">
					<i class="fa fa-print"></i> Print
				</button>
				<button class="btn btn-export">
					<i class="fas fa-file-export"></i> Export
				</button>
				<button class="btn btn-mail">
					<i class="fa fa-envelope"></i> Mail
				</button>
				<button class="btn btn-approved">
					<i class="fa fa-check"></i> Approved
				</button>
			</div>
		</div>
	</div>
	<div class="card">
		<div class="table-responsive">
			<table id="tblTransitEntryList" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>V_Type</th>
						<th>Doctype_Name</th>
						<th>V_No</th>
						<th>Form_No</th>
						<th>Form_Date</th>
						<th>Expiry_Date</th>
						<th>Party_Name</th>
						<th>Party_Code</th>
						<th>Party_Gstin</th>
						<th>Other_Gstin</th>
						<th>Nos</th>
						<th>Bill_No</th>
						<th>Bill_Date</th>
						<th>Gr_No</th>
						<th>Gr_Date</th>
						<th>Truck_No</th>
						<th>Transport</th>
						<th>Ord_Type</th>
						<th>Ord_No</th>
						<th>Hsn_Code</th>
						<th>Item_Desc</th>
						<th>Bill_Amt</th>
						<th>Sgst_Amt</th>
						<th>Cgst_Amt</th>
						<th>Igst_Amt</th>
						<th>Cess_Amt</th>
						<th>Cess_Nonadvolamt</th>
						<th>Other_Amt</th>
						<th>Total_Amt</th>
						<th>Uuser</th>
						<th>Udate</th>
						<th>Status</th>
						<th style="display:none;">Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
	</div>
</fieldset>

<script>

	let currentPage = 1;
	let pageSize = 10;

    $(document).ready(function () {
		loadAllMenus();
	});

	//Load main grid...............
	function loadAllMenus() {
		const searchTerm = $('#searchBox').val();

		$.ajax({
			url: '/TransitEntryList/GetList',
			type: 'GET',
			dataType: 'json',
			data: {
				searchTerm: searchTerm,
				pageNumber: currentPage,
				pageSize: pageSize
			},
			success: function (res) {
				if (!res.success) {
					toastr.error("Failed to load data.");
					return;
				}

				const list = res.lists;
				const totalCount = res.totalCount;
				const tbody = $('#tblTransitEntryList tbody');

				console.log('List', list);

				tbody.empty();

				if (list.length === 0) {
					tbody.append('<tr><td colspan="12" class="text-center text-muted">No list found.</td></tr>');
				} else {
					$.each(list, function (index, item) {
						tbody.append(`
							<tr>
							<td>${item.v_TYPE}</td>
							<td>${item.doctype_Name}</td>
							<td>${item.v_NO}</td>
							<td>${item.forM_NO}</td>
							<td>${formatDate(item.forM_DATE)}</td>
							<td>${formatDate(item.expirY_DATE)}</td>
							<td>${item.partyname}</td>
							<td>${item.partY_CODE}</td>
							<td>${item.partY_GSTIN}</td>
							<td>${item.otheR_GSTIN}</td>
							<td>${item.nos}</td>
							<td>${item.bilL_NO}</td>
							<td>${formatDate(item.bilL_DATE)}</td>
							<td>${item.gR_NO}</td>
							<td>${formatDate(item.gR_DATE)}</td>
							<td>${item.trucK_NO}</td>
							<td>${item.transport}</td>
							<td>${item.orD_TYPE}</td>
							<td>${item.orD_NO}</td>
							<td>${item.hsN_CODE}</td>
							<td>${item.iteM_DESC}</td>
							<td>${item.bilL_AMT}</td>
							<td>${item.sgsT_AMT}</td>
							<td>${item.cgsT_AMT}</td>
							<td>${item.igsT_AMT}</td>
							<td>${item.cesS_AMT}</td>
							<td>${item.cesS_NONADVOLAMT}</td>
							<td>${item.otheR_AMT}</td>
							<td>${item.totaL_AMT}</td>
							<td>${item.uuser}</td>
							<td>${formatDate(item.udate)}</td>
								<td>
									<button class="btn btn-sm btn-light" onclick="AddOrEditFunction('${item.v_NO}','${item.v_TYPE}')">
										<i class="fas fa-edit" title="Edit"></i>
									</button>
									<button class="btn btn-sm btn-light" onclick="viewMenuDetails('${item.v_NO}', '${item.v_TYPE}')">
										<i class="fas fa-eye" title="View Detail"></i>
									</button>
									<button class="btn btn-sm btn-light btn-delete" onclick="deleteTemp('${item.v_NO}', '${item.v_TYPE}')">
										<i class="fas fa-trash text-danger" title="Delete"></i>
									</button>
								</td>
							</tr>
						`);
					});
					renderPagination(totalCount, pageSize, currentPage);
				}
			},
			error: function (xhr) {
				toastr.error('Error loading menu list: ' + xhr.responseText);
				console.error(xhr);
			}
		});
	}

     function formatDate(dateStr) {
				if (!dateStr) return '';
				const d = new Date(dateStr);
				if (isNaN(d)) return '';
				return d.toISOString().slice(0, 10);
			}

	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const pagination = $('#tablePagination');
		pagination.empty();

		if (totalPages <= 1) return;

		let html = '';

		if (currentPage > 1) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		const startPage = Math.max(1, currentPage - 2);
		const endPage = Math.min(totalPages, currentPage + 2);

		for (let i = startPage; i <= endPage; i++) {
			html += `
				<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
		}

		if (currentPage < totalPages) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		pagination.html(html);
	}

	function goToPage(page) {
		currentPage = page;
		loadDocumentStages();
	}

	function AddOrEditFunction(code, vtype) {
     window.location.href = `/TransitEntry/Index?id=${encodeURIComponent(code)}&vtype=${encodeURIComponent(vtype)}`;
	}

	function viewMenuDetails(code, vtype) {
		window.location.href = '/TransitEntry/Index?id=' + encodeURIComponent(code) + '&vtype=' + encodeURIComponent(vtype) + '&mode=view';
	}

	function deleteTemp(code, VType) {
			if (!confirm('Are you sure you want to delete this Transit Entry?')) return;

			$.ajax({
				url: '/TransitEntryList/Delete',
				type: 'POST',
				data: { code: code, VType: VType }, 
				success: function (res) {
					if (res.success) {
						toastr.success(res.message || 'Deleted successfully.');
						loadAllMenus(); 
					} else {
						toastr.error(res.message || 'Failed to delete.');
					}
				},
				error: function (xhr, status, error) {
					toastr.error(`Error deleting : ${xhr.responseText || error}`);
				}
			});
		}


</script>
