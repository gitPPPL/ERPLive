@{
    ViewBag.Title = "Transit Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
    <legend class="legend-field">Transit Entry</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="handleBack('@Url.Action("Index", "TransitEntryList")', readOnly)" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>
    <form id="TransitEntryForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlDocType">Doc Type<span class="required">*</span></label>
                    <select class="form-control" id="ddlDocType">
                        <option>--Select DOC Type--</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumDocNo">Doc No<span class="required">*</span></label>
                    <input type="number" class="form-control" id="NumDocNo" placeholder="Enter Doc No" readonly>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlPartyName">Party Name<span class="required">*</span></label>
                    <select class="form-control" id="ddlPartyName">
                        <option>--Select Party Name--</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtPartyGSTIN">Party GSTIN<span class="required">*</span></label>
                    <input type="text" class="form-control" id="TxtPartyGSTIN" placeholder="Enter Party GSTIN" readonly>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtBillNo">Bill No<span class="required">*</span></label>
                    <input type="text" class="form-control" id="TxtBillNo" placeholder="Enter Bill No">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DtBillDate">Bill Date<span class="required">*</span></label>
                    <input type="date" class="form-control" id="DtBillDate">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumBillAmount">Bill Amount<span class="required">*</span></label>
                    <input type="number" class="form-control" id="NumBillAmount" placeholder="Enter Bill Amount">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumHSNCode">HSN Code</label>
                    <input type="number" class="form-control" id="NumHSNCode" placeholder="Enter HSN Amount">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtOtherPartyGST">Other Party GST</label>
                    <input type="text" class="form-control" id="TxtOtherPartyGST" placeholder="Enter Other Party GST">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtNoItem">No of Item</label>
                    <input type="text" class="form-control" id="TxtNoItem" placeholder="Enter No of Item">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="TxtItemDescription">Item Description</label>
                    <input type="text" class="form-control" id="TxtItemDesc" placeholder="Enter Item Description">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumSGSTAmt">SGST Amount</label>
                    <input type="number" class="form-control" id="NumSGSTAmt" placeholder="Enter SGST Amount">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumCGSTAmt">CGST Amount</label>
                    <input type="number" class="form-control" id="NumCGSTAmt" placeholder="Enter CGST Amount">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumCessAmt">Cess Amount</label>
                    <input type="number" class="form-control" id="NumCessAmt" placeholder="Enter Cess Amount">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumCessNAmount">Cess NAmount</label>
                    <input type="number" class="form-control" id="NumCessNAmount" placeholder="Enter Cess NAmount">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtGRNo">GR No</label>
                    <input type="text" class="form-control" id="TxtGRNo" placeholder="Enter GR No">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group position-relative">
                    <label for="DtGRDate">GR Date</label>
                    <div class="calender-check">
                        <input type="date" class="form-control" id="DtGRDate" style="padding-left: 30px;">
                        <input type="checkbox" id="chkGRDate" class="checkbox-inside">
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtTruckNo">Truck No</label>
                    <input type="text" class="form-control" id="TxtTruckNo" placeholder="Enter Truck No">
                </div>
            </div>
  
        </div>
        <fieldset class="fieldset-sub">
            <legend class="sub-legend">WayBill Details</legend>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="NumWaybillNo">Waybill No<span class="required">*</span></label>
                        <input type="text" class="form-control" id="NumWaybillNo" placeholder="Enter Waybill No">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="DtFormDate">Form Date<span class="required">*</span></label>
                        <input type="date" class="form-control" id="DtFormDate">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="DtExpiryDate">Expiry Date<span class="required">*</span></label>
                        <input type="date" class="form-control" id="DtExpiryDate">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="NumOrderNo">Order No</label>
                        <input type="number" class="form-control" id="NumOrderNo" placeholder="Enter Order No">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="NumIGSTAmount">IGST Amount</label>
                        <input type="number" class="form-control" id="NumIGSTAmount" placeholder="Enter IGST Amount">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="NumOtherAmount">Other Amount</label>
                        <input type="number" class="form-control" id="NumOtherAmount" placeholder="Enter Other Amount">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="NumTotalAmount">Total Amount</label>
                        <input type="number" class="form-control" id="NumTotalAmount" placeholder="Enter Total Amount">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="ddlStatus">Status</label>
                        <select class="form-control" id="ddlStatus">
                            <option value="">Select Status</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtTransport">Transport</label>
                        <input type="text" class="form-control" id="TxtTransport" placeholder="Enter Transport">
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="row">
            <div class="col-md-4">
                <fieldset class="fieldset-sub">
                    <legend class="sub-legend">Arrival Details</legend>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtArrivalDate">Arrival Date</label>
                                <input type="date" class="form-control" id="DtArrivalDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <button class="btn btn-primary" type="button">
                                <i class="fa fa-download"></i> Import and save EWayBill From Excel
                            </button>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mt-2">
                            <div class="dropdown">
                                <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Copy From
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#purchaseorderModal">Purchase Order</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </fieldset>
                <!--Purchase order Modal-->
                <div class="modal fade" id="purchaseorderModal" tabindex="-1" aria-labelledby="purchaseorderLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content draggable-modal">
                            <div class="popup-header">
                                <h5 class="popup-title" id="purchaseorderLabel">Copy From</h5>
                                <i class="fa fa-times" data-bs-dismiss="modal" style="cursor: pointer;" aria-label="Close"></i>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="col-lg-4">
                                        <div class="input-group shadow-sm rounded-pill overflow-hidden">
                                            <input type="text" id="searchBoxPR" class="form-control border-0" placeholder="Search Module..." aria-label="Search term" />
                                        </div>
                                    </div>
                                    <div class="col-lg-2">
                                        <div class="form-group">
                                            <div class="form-row">
                                                <input type="checkbox" id="chkAppendPOModal">
                                                <label class="checkbox-label" for="chkAppendPOModal">Append</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="btn-rightalign">
                                            <button type="button" class="btn btn-primary" data-bs-dismiss="modal"><i class="fa fa-copy"></i>Copy</button>
                                        </div>
                                    </div>
                                </div>
         
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <fieldset class="fieldset-sub">
                    <legend class="sub-legend">EWayBill Details</legend>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtEWaybillDate">EWaybill Date</label>
                                <input type="date" class="form-control" id="DtEWaybillDate" disabled>
                            </div>
                        </div>
                    </div>
                    <!-- Buttons -->
                    <div class="row">
                        <div class="col-md-12">
                            <button class="btn btn-primary" type="button">
                                <i class="fa fa-download"></i> Import and save EWayBill From Excel
                            </button>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <fieldset class="fieldset-sub">
                    <legend class="sub-legend">Print Option</legend>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtFromDate">From Date</label>
                                <input type="date" class="form-control" id="DtFromDate">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DtToDate">To Date</label>
                                <input type="date" class="form-control" id="DtToDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <button class="btn btn-primary" type="button">
                                <i class="fa fa-print"></i> Print
                            </button>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
                    
        <div class="row">
            <div class="offset-md-10 col-md-2">
                <div class="btn-last">
                    <button id="btn-save" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
                </div>
            </div>
        </div>
    </form>
</fieldset>
<script src="~/js/common/dropdown.js"></script>
<script>
    let readOnly = false;
    $(document).ready(async function () {
        const urlParams = new URLSearchParams(window.location.search);
        const rowId = urlParams.get('id');
        const mode = urlParams.get('mode');
        const vtype = urlParams.get('vtype');
        readOnly = (mode === 'view');
        //=======Set focus========
        $('#ddlDocType').focus();
        if (mode !== "view" && rowId !== null) {
            $('#DtFormDate').focus();
        }
        //=====Set Current Date==========
        const currentDate = getCurrentDateDMY();
        $('#DtBillDate, #DtGRDate, #DtFormDate, #DtExpiryDate, #DtArrivalDate, #DtEWaybillDate, #DtFromDate, #DtToDate').val(currentDate);
        
        // Load dropdowns and form data if editing
        LoadDropDown().then(() => {
                if (rowId) {
                    return LoadFormByID(rowId, vtype).then(() => {
                });
            }
        }).catch(error => {
                console.error("An error occurred:", error);
        });
        //======View Mode====
        if (mode === "view") {
            setFormReadOnly();
            $('#TransitEntryForm').after(
                '<span class="badge bg-secondary ms-2">Read‑Only Mode</span>'
            );
        }
        
        // Event handlers
        $("#ddlDocType").on('change', function () {
            if (rowId == null) {
                GetVNo(this.value);
                document.getElementById("ddlDocType").disabled = true;
                $('#NumWaybillNo').focus();
            }
            // DDLPartyName(this.value);
            bindDropdown('TransitEntry','PartyName', '#ddlPartyName', '-- Select Party Name --', null, null, false, this.value, true);
        });

        $("#ddlPartyName").on('change', function () {
            fetchPartyGstin(this.value);
        });

        $("#btn-save").click(function (e) {
            e.preventDefault();

            let GR_DATE = null;
            if ($("#chkGRDate").is(":checked")) {
                const dateVal = formatDate($("#DtGRDate").val());
                GR_DATE = dateVal ? dateVal : null;
            }
            else{
                GR_DATE = getCurrentDateDMY();
            }

            const Header = {
                V_TYPE:           $('#ddlDocType').val() || null,
                V_NO:             parseInt($('#NumDocNo').val()) || null,
                DOC_ID:           $.trim($('#TxtCode').val()) || null,
                FORM_NO:          $.trim($('#TxtBillNo').val()) || null,
                FORM_DATE:        formatDate($("#DtFormDate").val()) || null,
                EXPIRY_DATE:      formatDate($("#DtExpiryDate").val()) || null,
                PARTY_CODE:       parseInt($('#ddlPartyName').val()) || null,
                PARTY_GSTIN:      $.trim($('#TxtPartyGSTIN').val()) || null,
                OTHER_GSTIN:      $.trim($('#TxtOtherPartyGST').val()) || null,
                NOS:              parseFloat($('#TxtNoItem').val()) || null,
                BILL_NO:          $.trim($('#TxtBillNo').val()) || null,
                BILL_DATE:        formatDate($("#DtBillDate").val()) || null,
                GR_NO:            $.trim($('#TxtGRNo').val()) || null,
                GR_DATE:          GR_DATE,
                TRUCK_NO:         $.trim($('#TxtTruckNo').val()) || null,
                TRANSPORT:        $.trim($('#TxtTransport').val()) || null,
                ORD_NO:           parseInt($('#NumOrderNo').val()) || null,
                ORD_TYPE:         $.trim($('#TxtOrderType').val()) || null,
                HSN_CODE:         parseInt($('#NumHSNCode').val()) || null,
                ITEM_DESC:        $.trim($('#TxtItemDesc').val()) || null,
                BILL_AMT:         parseFloat($('#NumBillAmount').val()) || null,
                SGST_AMT:         parseFloat($('#NumSGSTAmt').val()) || null,
                CGST_AMT:         parseFloat($('#NumCGSTAmt').val()) || null,
                IGST_AMT:         parseFloat($('#NumIGSTAmount').val()) || null,
                CESS_AMT:         parseFloat($('#NumCessAmt').val()) || null,
                CESS_NONADVOLAMT: parseFloat($('#NumCessNAmount').val()) || null,
                OTHER_AMT:        parseFloat($('#NumOtherAmount').val()) || null,
                TOTAL_AMT:        parseFloat($('#NumTotalAmount').val()) || null,
                STATUS:           parseInt($('#ddlStatus').val()) || null,
                GATE_NO:          parseInt($('#TxtGRNo').val()) || null,
                GATE_DATE:        formatDate($("#chkGRDate").val()) || null,
                ARRIVAL_DATE:     formatDate($("#DtArrivalDate").val()) || null,
                action:           $.trim($('#TxtCode').val()) ? 'UPDATE' : 'INSERT',
            };

            // Validations
            if (!validateRequiredField('#ddlDocType', 'Doc Type')) return;
            
            if (!validateRequiredField('#NumDocNo', 'Doc No')) return;
            if (!validateRequiredField('#NumWaybillNo', 'WayBill No')) return;
            if (!validateRequiredField('#ddlPartyName', 'Party Name')) return;
            if (!validateRequiredField('#DtBillDate', 'Bill Date')) return;
            
            if (!validateRequiredField('#TxtPartyGSTIN', 'Party Gstin')) return;
            if (!validateRequiredField('#TxtBillNo', 'Bill No')) return;
            if (!validateRequiredField('#NumBillAmount', 'Bill Amount')) return;
            if (!validateRequiredField('#DtFormDate', 'Form Date')) return;
            if (!validateRequiredField('#DtExpiryDate', 'Expiry Date')) return;

            const payload = Header;

            // Disable button to prevent multiple submissions
            $("#btn-save").prop("disabled", true);

            // AJAX Save
            $.ajax({
                url: '/TransitEntry/Savedata',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response.success) {
                        toastr.success("Saved successfully!");
                        setTimeout(() => window.location.href = '/TransitEntryList/Index', 1000);
                    } else {
                        toastr.error(response.message || "Save failed.");
                    }
                },
                error: function (xhr) {
                    let errorMessage = "Something went wrong.";
                    if (xhr.status === 400) {
                        errorMessage = "Bad Request: " + xhr.responseText;
                    } else if (xhr.status === 500) {
                        errorMessage = "Server error: " + xhr.responseText;
                    } else {
                        errorMessage = "Unexpected error: " + xhr.statusText;
                    }
                    console.error("Error: ", errorMessage);
                    toastr.error(errorMessage);
                },
                complete: function () {
                    $("#btn-save").prop("disabled", false);
                }
            });
        });

    });

    ///////// Funtion

    function formatDate(dateStr) {
        if (!dateStr) return '';
        const d = new Date(dateStr);
        if (isNaN(d)) return '';
        return d.toISOString().slice(0, 10);
    }

    async function GetVNo(Vtype) {
        try {
            const res = await fetch(`/TransitEntry/GetVNo?Vtype=${encodeURIComponent(Vtype)}`);
            if (!res.ok) throw new Error(`HTTP ${res.status}`);

            const data = await res.json();

            if (data.error) throw new Error(data.error);
            if (!data.v_NO) throw new Error('Response missing V_NO');

            $('#NumDocNo').val(data.v_NO);
        } catch (e) {
            console.error('GetVNo failed:', e);
            alert('Error loading Document Number: ' + e.message);
        }
    }

    async function LoadDropDown(VTypeId) {
        try {
            await bindDropdown('TransitEntry','DocType', '#ddlDocType', '-- Select VType --', null, null, false, null);
            await bindDropdown('TransitEntry','DocStatus', '#ddlStatus', '-- Select Status --', null, null, true, null);
            await bindDropdown('TransitEntry','PartyName', '#ddlPartyName', '-- Select Party Name --', null, null, false, "", true);
        } catch (error) {
            console.error("Error loading dropdowns:", error);
        }
    }

    
    async function fetchPartyGstin(Partycode) {
        try {
            const response = await fetch(`/TransitEntry/fetchPartyGstinNo?Partycode=${Partycode}`);
            const data = await response.json();
            if (data.length > 0 && data[0].gstin) {
                $('#TxtPartyGSTIN').val(data[0].gstin);
            } else {
                $('#TxtPartyGSTIN').val('');
            }
        } catch (error) {
            console.error('Failed to fetch ship from address:', error);
        }
    }

    function LoadFormByID(code, vtype) {
        $.ajax({
            url: '/TransitEntryList/GetDataByID',
            type: 'GET',
            data: { code, vtype },
            success: function (res) {
                console.log('data', res);

                if (!res.success || !res.data) {
                    toastr.warning("No Data found for the given ID.");
                    return;
                }

                populateForm(res.data);
            },
            error: function (xhr) {
                toastr.error("Error loading data: " + xhr.responseText);
            }
        });
    }

    function populateForm(data) {
        $("#TxtCode").val($.trim(data.v_NO));
        $("#ddlDocType").val($.trim(data.v_TYPE)).prop('disabled', true);
        $("#NumDocNo").val($.trim(data.v_NO));
        $("#ddlPartyName").val($.trim(data.partY_CODE));
        $("#TxtPartyGSTIN").val($.trim(data.partY_GSTIN));
        $("#TxtBillNo").val($.trim(data.bilL_NO));
        $("#DtBillDate").val(formatDate(data.bilL_DATE));
        $("#NumBillAmount").val($.trim(data.bilL_AMT));
        $("#NumHSNCode").val(data.hsN_CODE);
        $("#TxtOtherPartyGST").val($.trim(data.otheR_GSTIN));
        $("#TxtNoItem").val($.trim(data.nos));
        $("#TxtItemDesc").val($.trim(data.iteM_DESC));
        $("#TxtGRNo").val($.trim(data.gR_NO));
        $("#DtGRDate").val(formatDate(data.gatE_DATE));
        $("#TxtTruckNo").val($.trim(data.trucK_NO));
        $("#NumSGSTAmt").val($.trim(data.sgsT_AMT));
        $("#NumCGSTAmt").val($.trim(data.cgsT_AMT));
        $("#NumCessAmt").val($.trim(data.cesS_AMT));
        $("#NumCessNAmount").val($.trim(data.cesS_NONADVOLAMT));
        $("#NumWaybillNo").val($.trim(data.forM_NO));
        $("#DtFormDate").val(formatDate(data.forM_DATE));
        $("#DtExpiryDate").val(formatDate(data.expirY_DATE));
        $("#NumOrderNo").val($.trim(data.orD_NO));
        $("#NumIGSTAmount").val($.trim(data.igsT_AMT));
        $("#NumOtherAmount").val($.trim(data.otheR_AMT));
        $("#NumTotalAmount").val($.trim(data.totaL_AMT));
        $("#ddlStatus").val($.trim(data.status));
        $("#TxtTransport").val($.trim(data.transport));
        const DtSBLCDue = $("#DtGRDate").val();
        $("#chkGRDate").prop("checked", !!DtSBLCDue);

    }

    function setFormReadOnly() {
        const form = $('#TransitEntryForm');
        form.find(':input').prop('disabled', true);
        form.find('textarea').css('background-color', '#f0f0f0');
        form.find('table tbody tr').css('background-color', '#f9f9f9');
        const ddlParty = $('#ddlPartyName');
        ddlParty.prop('disabled', false); 
        ddlParty.on('mousedown', function (e) {
            e.preventDefault(); 
            this.blur(); 
        });
        ddlParty.css({
            'pointer-events': 'none', 
            'background-color': '#e9ecef' 
        });
    }
    function getCurrentDateDMY(){
        const today = new Date();
        const dd = String(today.getDate()).padStart(2, '0');
        const mm = String(today.getMonth() + 1).padStart(2, '0');
        const yyyy = today.getFullYear();
        return `${yyyy}-${mm}-${dd}`;
    };
</script>


