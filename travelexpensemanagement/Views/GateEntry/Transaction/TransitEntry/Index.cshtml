@{
    ViewBag.Title = "Transit Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fas fa-right-to-bracket"></i>
        </div>
        <div class="erppage-header-title">Transit Entry</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "TransitEntryList")', readOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>

<div id="TransitEntryForm">
    <input type="hidden" class="form-control" id="TxtCode" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Document Type</label>
                    <Select class="erppage-redinput erppage-input" id="ddlDocType">
                        <option>Select Document Type</option>
                    </Select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Document No</label>
                    <input type="text" class="erppage-redinput" id="NumDocNo" placeholder="Enter Doc No" readonly />
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Party Name</label>
                    <Select class="erppage-redinput erppage-required" id="ddlPartyName">
                        <option>Select Party Name</option>
                    </Select>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Party GSTIN</label>
                    <input type="text" class="erppage-input" id="TxtPartyGSTIN" placeholder="Enter Party GSTIN" readonly />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Other Party GST</label>
                    <input type="text" class="erppage-input" id="TxtOtherPartyGST" placeholder="Enter Other Party GST" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Status</label>
                    <Select class="erppage-input" id="ddlStatus">
                        <option value="selectstaus">Select Status</option>
                    </Select>
                </div>
            </div>

            <fieldset class="erppage-subfieldset">
                <legend>Document Details</legend>
                <div class="erppage-subheader">Document Details</div>
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Waybill No</label>
                        <input type="text" class="erppage-redinput erppage-input" id="NumWaybillNo" placeholder="Enter Waybill No" />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Create Date</label>
                        <input type="date" class="erppage-redinput erppage-input" id="DtFormDate" />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Expiry Date</label>
                        <input type="date" class="erppage-input" id="DtExpiryDate" />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Order No</label>
                        <input type="number" class="erppage-input" id="NumOrderNo" placeholder="Enter Order No" />
                    </div>
                </div>
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Bill No</label>
                        <input type="text" class="erppage-redinput erppage-input" id="TxtBillNo" placeholder="Enter Bill No" />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Bill Date</label>
                        <input type="date" class="erppage-redinput erppage-input" id="DtBillDate" />
                    </div>
                </div>
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Basic Amount</label>
                        <input type="number" class="erppage-redinput erppage-input" id="NumBillAmount" placeholder="Enter Bill Amount" />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">SGST Amount</label>
                        <input type="number" class="erppage-input" id="NumSGSTAmt" placeholder="Enter SGST Amount" />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">CGST Amount</label>
                        <input type="number" class="erppage-input" id="NumCGSTAmt" placeholder="Enter CGST Amount" />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">IGST Amount</label>
                        <input type="number" class="erppage-input" id="NumIGSTAmount" placeholder="Enter IGST Amount" />
                    </div>
                </div>
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Cess Amount</label>
                        <input type="number" class="erppage-input" id="NumCessAmt" placeholder="Enter Cess Amount" />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Other Amount</label>
                        <input type="number" class="erppage-input" id="NumOtherAmount" placeholder="Enter Other Amount" />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Total Amount</label>
                        <input type="number" class="erppage-input" id="NumTotalAmount" placeholder="Enter Total Amount" />
                    </div>
                    

                </div>
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Truck No</label>
                        <input type="text" class="erppage-input" id="TxtTruckNo" placeholder="Enter Truck No" />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Transport</label>
                        <input type="text" class="erppage-input" id="TxtTransport" placeholder="Enter Transport" />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">GR No</label>
                        <input type="text" class="erppage-input" id="TxtGRNo" placeholder="Enter GR No" />
                    </div>
                    <div class="erppage-divfield erppage-datefield">
                        <label class="erppage-label">GR Date</label>
                        <div class="erppage-datebox">
                            <input type="date" class="erppage-input erppage-dateinput" id="DtGRDate">
                            <label class="erppage-checkbox-inside">
                                <input type="checkbox" class="erppage-input" id="chkGRDate">
                            </label>
                        </div>
                    </div>
                </div>
                <div class="erppage-grid4">
                    <div class="erppage-divfield erppage-col-span-2">
                        <label class="erppage-label">Item Description</label>
                        <textarea type="text" class="erppage-textarea" id="TxtItemDesc" placeholder="Enter Item Description"></textarea>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">HSN Code</label>
                        <input type="number" class="erppage-input" id="NumHSNCode" placeholder="Enter HSN Amount" />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">No of Item</label>
                        <input type="text" class="erppage-input" id="TxtNoItem" placeholder="Enter No of Item" />
                    </div>
                </div>
            </fieldset>
        </fieldset>

       
    </div>
    <div class="erppage-actions">
        <button id="btn-save" type="submit" class="erppage-btn erppage-btn-save">
            <i class="fa-solid fa-floppy-disk"></i>
            <span>Save</span>
        </button>
        @* <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" id="btn_Print">
            <i class="fa fa-print"></i>Print
        </button> *@
    </div>
</div>

<script src="~/js/common/dropdown.js"></script>
<script src="~/js/erpjs/gateentry/transaction/transitentry/transitentry.js"></script>
