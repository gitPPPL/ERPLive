@{
    ViewBag.Title = "Misc Consumption Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="erp-toast-container"></div>
<fieldset>
    <legend class="legend-field">Misc Consumption Entry</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="handleBack('@Url.Action("Index", "MiscConsumptionEntryList")', isReadOnly)" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>
    <form id="MiscConsumptionEntryForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlDocType">Doc Type</label>
                    <select class="form-control" id="ddlDocType">
                        <option>--Select DOC Type--</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumDocNo">Doc No<span class="required">*</span></label>
                    <input type="number" class="form-control" id="NumDocNo" placeholder="Enter Doc No" readonly>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DtDocDate">Doc Date<span class="required">*</span></label>
                    <input type="date" class="form-control" id="DtDocDate">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TmDocTime">Doc Time<span class="required">*</span></label>
                    <input type="time" class="form-control" id="TmDocTime">
                </div>
            </div>
        </div>
        <fieldset class="fieldset-sub">
            <legend class="sub-legend">Party Details<span class="required">*</span></legend>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="ddlPartyName">Party Name</label>
                        <select class="form-control" id="ddlPartyName">
                            <option>Select Party Name</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtAdd1PD">Add Line1</label>
                        <input type="text" class="form-control" id="TxtAdd1PD" placeholder="Enter Address Line 1">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtAdd2PD">Add Line2</label>
                        <input type="text" class="form-control" id="TxtAdd2PD" placeholder="Enter Address Line 2">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtAdd3PD">Add Line3</label>
                        <input type="text" class="form-control" id="TxtAdd3PD" placeholder="Enter Address Line 3">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtVehicleNo">Vehicle No<span class="required">*</span></label>
                        <input type="text" class="form-control" id="TxtVehicleNo" placeholder="Enter Vehicle No">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="ddlType">Type</label>
                        <select class="form-control" id="ddlType">
                            <option value="Misc">Misc</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtRemarks">Remarks</label>
                        <textarea type="text" class="form-control" id="TxtRemarks" placeholder="Enter Remarks"></textarea>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="btn-mt button-right">
                        <button id="btn-pending" type="button" class="btn btn-danger">
                            <i class="fa fa-clock"></i> Pending Documents
                        </button>
                    </div>
                </div>
            </div>
            @* Modal Popup *@
            <!-- Modal -->
            <div class="modal fade" id="pendingModal" tabindex="-1" role="dialog" aria-labelledby="pendingModalLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="popup-header">
                            <h5 class="popup-title" id="pendingModalLabel">Pending Documents</h5>
                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                <span>&times;</span>
                            </button>

                        </div>
                        
                        <div class="modal-body">
                            <div class="card">
                                <div class="table-responsive">
                                    <table id="tblPendingDocument" class="table-width">
                                        <thead class="table-head">
                                            <tr>
                                                <th style="display:none;">Code</th>
                                                <th><input type="checkbox" id="chkSelectAll"></th>
                                                <th>Voucher Type</th>             
                                                <th>Voucher No</th>                
                                                <th>Date</th>                      
                                                <th>Quantity</th>             
                                                <th>Pending Qty</th>              
                                                <th>Item Name</th>                
                                                <th>Remarks</th>                   
                                                <th>Nos</th>                       
                                                <th>Unit_name</th>                 
                                                <th>SRNO</th>                      

                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-2 mx-2">
                            <div class="offset-md-8 col-md-4">
                                <div class="button-right">
                                    <button type="button" class="btn btn-primary" id="PendngAddRow"><i class="fa fa-plus"></i>ADD</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="card">
            <div class="table-responsive">
                <table id="tblConsumptionEntry" class="table-width">
                    <thead class="table-head">
                        <tr>
                            <th style="display:none;">Code</th>
                            <th>Item Name</th>
                            <th>Department</th>
                            <th>Unit</th>
                            <th>Nos</th>
                            <th>Quantity</th>
                            <th>Remarks</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="btn-add-row-last">
                        <i class="fa fa-plus btn-add-row" title="Add Row"><span>Add New Row</span></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="offset-md-10 col-md-2">
                <div class="btn-last">
                    <button id="btn-save" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
                </div>
            </div>
        </div>
    </form>
</fieldset>

<script src="~/common/dropdown.js"></script>
<script src="~/js/erpjs/gateentry/transaction/misconsumptionentryjs/misconsumptioninit.js"></script>
<script src="~/js/erpjs/gateentry/transaction/misconsumptionentryjs/misconsumptionapi.js"></script>
<script src="~/js/erpjs/gateentry/transaction/misconsumptionentryjs/misconsumptionvalidation.js"></script>
<script src="~/js/erpjs/gateentry/transaction/misconsumptionentryjs/misconsumptionui.js"></script>



