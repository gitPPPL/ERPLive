@{
    ViewBag.Title = "Vehicle Inward Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="circle-loader" style="display: none;">
    <div class="container">
        Loading...
        <div class="spinner-part"></div>
        <div class="spinner-part"></div>
        <div class="spinner-part"></div>
    </div>
</div>

<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-truck-loading"></i>
        </div>
        <div class="erppage-header-title">Vehicle Inward Entry</div>
    </div>
    <div class="erppage-header-right">
        <button id="btnbacklist" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "VehicleInwardEntryList")', readOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div id="TransportInwardPassEntryForm">
    <input type="hidden" class="form-control" id="TxtDocId" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Type</label>
                    <Select class="erppage-redinput" id="ddlDocType" disabled>
                        <option>Select Document Type</option>
                    </Select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Document No</label>
                    <input type="text" class="erppage-redinput" id="NumDocNo" readonly />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Doc Date</label>
                    <input type="date" class="erppage-redinput" id="DtDocDate" autofocus />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Report Date</label>
                    <input type="date" class="erppage-input" id="DtReportDate" />
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">In Time</label>
                    <input type="time" class="erppage-redinput" id="TmInTime" readonly />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Report Time</label>
                    <input type="time" class="erppage-redinput" id="TmRTime" />
                </div>
            </div>
        </fieldset>
        <fieldset class="erppage-subfieldset">
            <legend>Vehicle Details</legend>
            <div class="erppage-subheader">Vehicle Details</div>
            <div class="erppage-grid2">
                <div class="erppage-divfield">
                    <label class="erppage-label">Vehicle No</label>
                    <input type="text" class="erppage-input" maxlength="15" id="TxtVehicleNo" placeholder="Enter Vehicle No" />
                    <button type="button" class="erppage-btn erppage-btn-common" id="btnGetVAHANData"><i class="fa fa-cloud-download"></i> Get Data (VAHAN Portal)</button>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Transport</label>
                    <select class="erppage-redinput erppage-required" id="ddlTransportName">
                        <option value="">Select Transport Name</option>
                    </select>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Driver Name</label>
                    <input type="text" class="erppage-redinput" maxlength="50" id="TxtDrivername" placeholder="Enter Driver Name" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Driver Mobile</label>
                    <input type="text" class="erppage-redinput" id="NumDriverMobile" maxlength="10" placeholder="Enter Driver Mobile" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">DL No</label>
                    <input type="text" class="erppage-input" maxlength="20" id="txtDLNo" placeholder="Enter DL No" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Vehicle RC</label>
                    <input type="text" class="erppage-input" maxlength="20" id="TxtVehicleRCNo" placeholder="Enter Vehicle RC No" />
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Insurance No</label>
                    <input type="text" class="erppage-input" id="TxtInsuranceNo" maxlength="20" placeholder="Enter Insurance No" />
                </div>
                <div class="erppage-divfield erppage-datefield">
                    <label class="erppage-label">Validity</label>
                    <div class="erppage-datebox">
                        <input type="date" class="erppage-input erppage-dateinput" id="DtValidity">
                        <label class="erppage-checkbox-inside">
                            <input type="checkbox" id="chkValidity">
                        </label>
                    </div>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Purpose</label>
                    <input type="text" class="erppage-input" maxlength="50" id="txtPurpose" placeholder="Enter Purpose" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">PAN No</label>
                    <input type="text" class="erppage-input" maxlength="10" id="txtPANNO" placeholder="Enter PAN No" />
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-datefield">
                    <label class="erppage-label">Fitment Vldty</label>
                    <div class="erppage-datebox">
                        <input type="date" class="erppage-input erppage-dateinput" id="DtFitmentValidity">
                        <label class="erppage-checkbox-inside">
                            <input type="checkbox" id="chkFitmentValidity">
                        </label>
                    </div>
                </div>
                <div class="erppage-divfield erppage-datefield">
                    <label class="erppage-label">Tax Validity</label>
                    <div class="erppage-datebox">
                        <input type="date" class="erppage-input erppage-dateinput" id="DtTaxValidity">
                        <label class="erppage-checkbox-inside">
                            <input type="checkbox" id="chkTaxValidity">
                        </label>
                    </div>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Vehicle Body</label>
                    <input type="text" class="erppage-input" maxlength="50" id="txtVehicleBody" placeholder="Enter Vehicle Body" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Pass Weight</label>
                    <input type="number" class="erppage-input" maxlength="50" id="txtPassWeight" placeholder="Enter Pass Weight" />
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Cont Size</label>
                    <select class="erppage-input" id="ddlContainerSize">
                        <option value="">Select Container Size</option>
                        <option value="40 HQ">40 HQ</option>
                        <option value="20 SD">20 SD</option>
                        <option value="LCL">LCL</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Container No</label>
                    <input type="text" class="erppage-input" maxlength="15" id="NumContainerNo" placeholder="Enter Container No" />
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Attachment</label>
                    <div class="erppage-upload-wrap">
                        <input type="file" class="erppage-input" id="TxtAttachment" accept="image" />
                        <div id="previewContainer" class="erppage-preview-box" style="display:none;">
                            <img id="imgPreview" src="" alt="Preview" />
                            <button type="button" id="btnRemoveImage" class="erppage-btn erppage-btn-remove">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
        <fieldset class="erppage-subfieldset">
            <legend>Customer Details</legend>
            <div class="erppage-subheader">Customer Details</div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">DO No</label>
                    <select class="erppage-input" id="ddlDONo">
                        <option value="">Select DO No</option>
                    </select>
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Customer Name</label>
                    <select class="erppage-redinput erppage-required" id="ddlCustomerName">
                        <option value="">Select Customer Name</option>
                    </select>
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Address1</label>
                    <input type="text" class="erppage-input" id="TxtAdd1TIR" placeholder="Enter Address Line 1" readonly />
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Address2</label>
                    <input type="text" class="erppage-input" id="TxtAdd2TIR" placeholder="Enter Address Line 2" readonly />
                </div>

            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label">Address3</label>
                    <input type="text" class="erppage-input" id="TxtAdd3PD" placeholder="Enter Address Line 3" readonly />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">City</label>
                    <select class="erppage-input" id="ddlCity" disabled>
                        <option value="">Select City</option>
                    </select>
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Remarks</label>
                    <input type="text" class="erppage-input" maxlength="500" id="TxtRemarks" placeholder="Enter Remarks" />
                </div>
            </div>
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Vehicle Remarks</label>
                    <textarea type="text" class="erppage-textarea" maxlength="500" id="TxtVehicleRemarks" placeholder="Enter Vehicle Remarks"></textarea>
                </div>
                <div class="erppage-btn-group-right erppage-col-span-2">
                    <button class="erppage-btn erppage-btn-copy">
                        <i class="fa fa-barcode"></i>
                        <span>Barcode</span>
                    </button>
                    <button class="erppage-btn erppage-btn-copy">
                        <i class="fa fa-sticky-note"></i>
                        <span>Sticker</span>
                    </button>
                </div>
            </div>
            @* <div class="erppage-internalaction">
                <button class="erppage-btn erppage-btn-copy">
                    <i class="fa fa-barcode"></i>
                    <span>Barcode</span>
                </button>
                <button class="erppage-btn erppage-btn-copy">
                    <i class="fa fa-sticky-note"></i>
                    <span>Sticker</span>
                </button>
            </div> *@
        </fieldset>
    </div>
    <div class="erppage-actions">
        <button id="btn-save" type="submit" class="erppage-btn erppage-btn-save">
            <i class="fa-solid fa-floppy-disk"></i>
            <span>Save</span>
        </button>
        @* <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" id="btn_Print">
            <i class="fa fa-print"></i>Print
        </button> *@
    </div>
</div>


<script src="~/js/erpjs/gateentry/transaction/vehicleinwardentry/vehicleinwardentry.api.js"></script>
<script src="~/js/erpjs/gateentry/transaction/vehicleinwardentry/vehicleinwardentry.ui.js"></script>
<script src="~/js/erpjs/gateentry/transaction/vehicleinwardentry/vehicleinwardentry.validation.js"></script>
<script src="~/js/erpjs/gateentry/transaction/vehicleinwardentry/vehicleinwardentry.init.js"></script>
