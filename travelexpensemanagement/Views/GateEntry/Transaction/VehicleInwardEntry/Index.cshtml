<script>

    function setCurrentTime() {
        const now = new Date();
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const currentTime = `${hours}:${minutes}`;
        document.getElementById('TmInTime').value = currentTime;
    }
    //============Correction=============
    function chkDtdisable(){
        const currentDate = setCurrentDate();
        $('#chkValidity, #chkFitmentValidity, #chkTaxValidity').prop('checked', false);
        $('#DtValidity, #DtFitmentValidity, #DtTaxValidity').prop('disabled', true);
        $('#DtValidity, #DtFitmentValidity, #DtTaxValidity').val(currentDate);
    }
    function toggleDate(chk, input) {
        $(chk).change(function () {
            $(input).prop('disabled', !$(this).is(':checked'));
        });
    }
    function setCurrentDate(){
        const today = new Date();
        const todayDate = today.getFullYear() + '-' +
        (today.getMonth() + 1).toString().padStart(2, '0') + '-' +
        today.getDate().toString().padStart(2, '0');
        return todayDate;
    }
    const formatDateToBind = val => val ? val.substring(0, 10) : '';
    //======================================================
    function GetDocTypeAsync(selectedValue) {
          return new Promise((resolve, reject) => {
              $.ajax({
                  url: '@Url.Action("GetDocType", "VehicleInwardEntry")',
                  type: 'GET',
                  dataType: 'json',
                  success: function (response) {
                      if (response.status) {
                          const $dropdown = $('#ddlDocType');
                          $dropdown.empty();
                          // $dropdown.append('<option value="">-select doc Type-</option>');

                          $.each(response.data, function (index, item) {
                              $dropdown.append(`<option value="${item.CODE}">${item.NAME}</option>`);
                          });

                          if (selectedValue && $dropdown.find(`option[value="${selectedValue}"]`).length > 0) {
                              $dropdown.val(selectedValue).trigger('change');
                          } else {
                              $dropdown.prop('selectedIndex', 0);
                          }

                          resolve();
                      } else {
                          reject("Invalid response status.");
                      }
                  },
                  error: function (xhr, status, error) {
                      // toastr.error("Document Type Load failed: " + error);
                      showToast("Document Type Load failed: " + error, { type: "error" });
                      reject(error);
                  }
              });
          });
    }

    async function handleDocLoad() {
             docId = getQueryParam('id');
             readOnly = getQueryParam('readOnly');

            if (docId) {
                $('#ddlDocType').prop('readonly', true);
                await GetDocData(docId, readOnly);
            } else {
                const Vtype = $('#ddlDocType').val();
                let selectedText = $('#ddlDocType option:selected').text();
                if(Vtype)
                {
                  GetDocid(Vtype);
                }
                setCurrentTime();
                let todayDate = setCurrentDate();
                $('#DtDocDate').val(todayDate);
                $('#DtReportDate').val(todayDate);
            }
    }

    function SaveData(saveDt) {
                $.ajax({
                     url: '@Url.Action("SaveOrUpdateTransportInward", "VehicleInwardEntry")',
                    type: 'POST',
                    //======Correction
                    // contentType: 'application/json',
                    contentType: false,
                    processData: false,
                    // data: JSON.stringify(saveDt),
                    data: saveDt,
                    //==========
                    success: function (response) {
                        if (response?.status) {
                            // showFlashMessageByKey('insert', 'success');
                            // resetFields();
                            setTimeout(() => {
                                window.location.href = '/VehicleInwardEntryList/Index';
                            }, 1500);
                            showToast("Inserted successfully!", { type: "success" });
                        } else {
                            // toastr.error(response?.message || "Save failed. Please try again.");
                            showToast(response?.message || "Save failed. Please try again.", { type: "error" });
                        }
                    },
                    error: function () {
                        // toastr.error("Error occurred while saving. Please contact admin.");
                        showToast("Error occurred while saving. Please contact admin.", { type: "error" });
                    }
                });
    }

    function UpdateData(UpdateDt) {
        $.ajax({
            url: '@Url.Action("SaveOrUpdateTransportInward", "VehicleInwardEntry")',
            type: 'POST',
            //====Correction
            // contentType: 'application/json',
            // data: JSON.stringify(UpdateDt),
            // dataType: 'json',
            contentType: false,
            processData: false,
            data: UpdateDt,
            //========
            success: function (response) {
                if (response?.status) {
                    // showFlashMessageByKey('update', 'success');
                    // resetFields();
                    showToast("Updated successfully!", { type: "success" });
                    setTimeout(() => {
                        window.location.href = '/VehicleInwardEntryList/Index';
                    }, 1500);
                } else {
