@{
	ViewBag.Title = "Outward Entry List";
	Layout = "~/Views/Shared/_Layout.cshtml";

}

<fieldset>
	<legend class="legend-field">Outward Entry List</legend>
	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>
		<div class="col-lg-6">
			<div class="btn-rightalign">
				<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "OutwardEntry")'" type="submit" class="btn btn-add">
					<i class="fa fa-plus"></i>Add
				</button>
				<button class="btn btn-print" onclick="printCityMasterReport()" id="btn_Report">
					<i class="fa fa-print"></i> Print
				</button>
				<button class="btn btn-export" id="btn_exportPdf">
					<i class="fas fa-file-export"></i> Export
				</button>
				<button class="btn btn-mail">
					<i class="fa fa-envelope"></i> Mail
				</button>
				<button class="btn btn-approved">
					<i class="fa fa-check"></i> Approved
				</button>
			</div>
		</div>
	</div>
	<div class="card">
		<div class="table-responsive">
			<table id="tblOutwardEntryList" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>Doc ID</th>
						<th>Voucher No.</th>
						<th>Voucher Date</th>
						<th>References Type</th>
						<th>References No</th>
						<th>Truck No</th>
						<th>Bill No</th>
						<th>Bill Date</th>
						<th>Party Name</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
	</div>
</fieldset>
<script src="~/common/delete.js"></script>
<script>

	let currentPage = 1;
	let pageSize = 10;

		$(document).ready(function () {
			loadAllMenus();

			$('#searchBox').on('keyup', function () {
				currentPage = 1;
				loadAllMenus();
			});

			$('#btn_exportPdf').on('click', function () {
				var text = $('#searchBox').val();
				var url = '/OutwardEntryList/ExportToExcel?searchTerm=' + encodeURIComponent(text);
				window.location.href = url;
			});

			$('#btn_Report').on('click', function () {
				var text = $('#searchBox').val();
				var url = '/OutwardEntryList/ExportToPdf?searchTerm=' + encodeURIComponent(text);
				window.open(url, '_blank');
			});

		});

	//Load main grid...............
	function loadAllMenus(page = 1) {
	  currentPage = page;
	  const searchTerm = $('#searchBox').val();

	  $.ajax({
		url: '/OutwardEntryList/GetList',
		type: 'GET',
		dataType: 'json',
		data: {
		  searchTerm,
		  pageNumber: currentPage,
		  pageSize
		},
		success: function(res) {

		  if (!res.success) {			
			 showToast("Failed to load data.", { type: "error" });
			return;
		  }

		  const list = res.headers ?? res.lists ?? res.data ?? [];
		  const totalCount = res.totalCount ?? 0;
		  const tbody = $('#tblOutwardEntryList tbody');
		  tbody.empty();
		  if (!Array.isArray(list) || list.length === 0) {
			tbody.append('<tr><td colspan="10" class="text-center text-muted">No records found.</td></tr>');
		  } else {
			list.forEach(item => {
			  tbody.append(`
				<tr>
				  <td>${item.doC_ID ?? ''}</td>
				  <td>${item.v_NO ?? ''}</td>
				  <td>${formatDate(item.v_DATE)}</td>
				  <td>${item.reF_TYPE ?? ''}</td>
				  <td>${item.reF_NO ?? ''}</td>
				  <td>${item.trucK_NO ?? ''}</td>
				  <td>${item.bilL_NO ?? ''}</td>
				  <td>${formatDate(item.bilL_DATE)}</td>
				  <td>${item.partY_NAME ?? ''}</td>
				  <td>
					<button class="btn btn-sm btn-light" onclick="AddOrEditFunction('${item.v_NO}','${item.v_TYPE}')">
					<i class="fas fa-edit" title="Edit"></i>
					</button>
					<button class="btn btn-sm btn-light" onclick="viewMenuDetails('${item.v_NO}', '${item.v_TYPE}')">
					<i class="fas fa-eye" title="View Detail"></i>
					</button>
					<button class="btn btn-sm btn-light btn-delete" onclick="deleteTemp('${item.v_NO}', '${item.v_TYPE}')">
					<i class="fas fa-trash text-danger" title="Delete"></i>
					</button>

					<button class="fa fa-file btn-document"
					onclick="showDocumentPopup('${item.v_TYPE + item.v_NO}')">
					</button>

				  </td>
				</tr>`);
			});
		  }

		  renderPagination(totalCount, pageSize, currentPage);
		},
		error: function(xhr) {
		
		  showToast("Error loading menu list", { type: "error" });
		}
	  });
	}

	function formatDate(dateStr) {
		if (!dateStr) return 'null';
		if (dateStr.startsWith('0001-01-01')) return 'null';
		const d = new Date(dateStr);
		if (isNaN(d.getTime()) || d.getFullYear() <= 1) return 'null';
		const day = String(d.getDate()).padStart(2, '0');
		const month = String(d.getMonth() + 1).padStart(2, '0');
		const year = d.getFullYear();
		return `${day}-${month}-${year}`;
	}

	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const pagination = $('#tablePagination');
		pagination.empty();

		if (totalPages <= 1) return;

		let html = '';

		if (currentPage > 1) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		const startPage = Math.max(1, currentPage - 2);
		const endPage = Math.min(totalPages, currentPage + 2);

		for (let i = startPage; i <= endPage; i++) {
			html += `
				<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
		}

		if (currentPage < totalPages) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		pagination.html(html);
	}

	function goToPage(page) {
		currentPage = page;
		loadDocumentStages();
	}

	function AddOrEditFunction(code, VType) {
		window.location.href = `/OutwardEntry/Index?id=${encodeURIComponent(code)}&VType=${encodeURIComponent(VType)}`;
	}

	function viewMenuDetails(code, VType) {
		window.location.href = '/OutwardEntry/Index?id=' + encodeURIComponent(code) + '&VType=' + encodeURIComponent(VType) + '&mode=view';
	}

	function deleteTemp(code, VType) {

		if (!code || !VType) return;

		var docId = VType + code;

		deleteRecord("OutwardEntryList", docId, {
			action: "Delete", // IMPORTANT: pass action here
			title: "Are you sure you want to delete this Inward Entry?",
			text: "This action cannot be undone.",

			successCallback: function () {
				loadAllMenus(); // Refresh UI
			}
		});
	}

    function showDocumentPopup(docCode) {
		$.ajax({
			url: '/OutwardEntryList/DocDetailsCode',
			type: 'POST',
			dataType: 'json',
			data: { docCode: docCode },
			success: function(response) {
				if(response.success) {
					showDocumentPopupjQuery(response.data, docCode);
				} else {
	             showToast("Failed to get document details.", { type: "error" });

				}
			},
			error: function() {
				 showToast("An error occurred while fetching document details", { type: "error" });
		
			}
		});
	}

</script>
