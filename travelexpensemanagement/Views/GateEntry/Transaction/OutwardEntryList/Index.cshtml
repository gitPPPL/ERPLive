@{
    ViewBag.Title = "Outward Entry List";
    Layout = "~/Views/Shared/_Layout.cshtml";



    var currentMenu = ViewBag.CurrentMenu as string;
    bool canAdd = false;
    bool canEdit = false;
    bool canDelete = false;
    bool canPrint = false;
    bool canExport = false;
    bool canMail = false;
    bool canApproval = false;
    bool canDocDetail = false;

    foreach (var permission in Model.UserMenuPermissions)
    {
        if (permission.DISPLAY_NAME == ViewBag.CurrentMenu)
        {
            canAdd = Model.UserLevel == 1 || permission._ADD == 1;
            canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
            canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
            canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
            canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
            canMail = Model.UserLevel == 1 || permission._MAIL == 1;
            canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
            canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
            break;
        }
    }



}


<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>Outward Entry List</span>
    </div>

    <div class="erppagelist-header-right">


        @if (canAdd == true)
        {
            <button type="button" class="erppage-header-back" onclick="location.href='@Url.Action("Index", "OutwardEntry")'">
                <i class="fa fa-plus"></i>Add New
            </button>
        }
    
    </div>
</div>

<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" id="searchBox" placeholder="Search by All Columns Name...." />
    </div>

    <div class="erppagelist-actions">

        @if(@canPrint)
        {
            <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" id="btn_Report">
            <i class="fa fa-print"></i>Print
        </button>
        }

        @if(@canExport)
        {
            <button class="erppagelist-btn erppagelist-btn-action tooltip-btn"  data-tooltip="Export Report" id="btn_exportExcel">
                <i class="fa fa-file-excel"></i>Export
            </button>
        }


    
    </div>
</div>

<!-- TABLE -->
<div class="erppagelist-container">
    <div class="excel-wrapper fixed-grid-wrapper">

        <table id="tblOutwardEntryList" class="excel-table fixed-grid-table width-table resizable-table">

            <colgroup>
                <col style="display:none;"> <!-- Code -->
                <col style="width: 112px;"> <!-- Party Name -->
                <col style="width:75px;">   <!-- Item Type -->
                <col style="width: 77px;">   <!-- E - Waybill No -->
                <col style="width:80px;">   <!-- Vehicle No -->
                <col style="width: 196px;">   <!-- GST No. -->
                <col style="width:90px;">   <!-- Action -->
            </colgroup>

            <thead>
                <tr>
                    <th class="hidden-col">Code</th>
                    <th>Doc ID</th>
                    <th>Doc No</th>
                    <th>Doc Type</th>
                    <th>Doc Date</th>              
                    <th>Party Name</th>
                    <th>Item Type</th>
                    <th>E - Waybill No</th>
                    <th>Vehicle No</th>
                    <th>GST No.</th>              
                    <th class="action-col">Action</th>
                </tr>
            </thead>

            <tbody></tbody>
        </table>

    </div>

    <!-- PAGINATION -->
    <div class="erppagelist-pagination">

        <div class="pagination-left">
            <select id="pageSizeSelect">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>

        <div class="pagination-center">
            <button onclick="prevPage()" class="page-nav" id="prevBtn">‹</button>
            <div id="pageNumbers" class="page-numbers"></div>
            <button onclick="nextPage()" class="page-nav" id="nextBtn">›</button>
        </div>

        <div class="pagination-right" id="pageInfoText">
            Results: 0 - 0 of 0
        </div>

    </div>
</div>

<script>

    let currentPage = 1;
    let pageSize = 10;
    let totalCount = 0;

    $(document).ready(function () {
        loadAlloutward();
        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadAlloutward();
        });

        $('#pageSizeSelect').on('change', function () {
            pageSize = parseInt($(this).val());
            currentPage = 1;
            loadAlloutward();
        });

        $('#btn_exportExcel').on('click', function () {
            let text = $('#searchBox').val();
            window.location.href = '/OutwardEntryList/ExportToExcel?searchTerm=' + encodeURIComponent(text);
        });

        $('#btn_Report').on('click', function () {
            let text = $('#searchBox').val();
            window.open('/OutwardEntryList/ExportToPdf?searchTerm=' + encodeURIComponent(text), '_blank');
        });

    });
    // ================= LOAD DATA =================
     function loadAlloutward() {
        $.ajax({
            url: '/OutwardEntryList/GetList',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: $('#searchBox').val(),
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {

                console.log("List data",res);



                if (!res.success) {
                    toastr.error("Failed to load data.");
                    return;
                }

                const list = res.lists || [];
                totalCount = res.totalCount || 0;

                renderTable(list);
                renderPagination();
            },
            error: function (xhr) {
                toastr.error('Error loading list: ' + xhr.responseText);
            }
        });
    }
    // ================= TABLE =================
    function renderTable(list) {

        let tbody = $('#tblOutwardEntryList tbody');
        tbody.empty();

        if (!list || list.length === 0) {
            tbody.append('<tr><td colspan="10" class="text-center">No records found</td></tr>');
            return;
        }

        list.forEach(item => {     

            tbody.append(`
                <tr>
                    <td style="display:none;">${item.doC_ID ?? ''}</td>
                      <+td>${item.doC_ID ?? ''}</td>
                      <td>${item.v_NO ?? ''}</td>
                      <td>${item.v_TYPE ?? ''}</td>
                      <td>${formatDate(item.v_DATE) ?? ''}</td>
                      <td>${item.partY_NAME ?? ''}</td>
                      <td>${item.iteM_TYPE ?? ''}</td>
                      <td>${item.waybilL_NO ?? ''}</td>
                      <td>${item.trucK_NO ?? ''}</td>
                      <td>${item.partY_GST ?? ''}</td>
                      <td class="action-col">
                        <div class="action-wrap">
                            @if(@canEdit)
                            {
                              <button class="act-btn edit" title="Edit Data" onclick="edit('${item.v_NO}','${item.v_TYPE}')"><i class="fa fa-edit"></i></button>
                            }
                              <button class="act-btn view" title="View Data" onclick="view('${item.v_NO}','${item.v_TYPE}')"><i class="fa fa-eye"></i></button>
                               
                            @if(@canDelete)
                            {
                              <button class="act-btn delete" title="Delete Data" onclick="deleteItem('${item.doC_ID}')"><i class="fa fa-trash"></i></button>
                            } 
                            @if(@canDocDetail)
                            {
                              <button class="act-btn document" title="Document Data" onclick="showDocumentPopup('${item.doC_ID}')"><i class="fa fa-file"></i></button>
                            }
                        </div>
                      </td>
                </tr>
            `);
        });
    }
    // ================= PAGINATION (VISITOR STYLE) =================
    function renderPagination() {
        const totalPages = Math.ceil(totalCount / pageSize) || 1;
        let html = '';
        let maxVisible = 5;
        let start = Math.max(1, currentPage - Math.floor(maxVisible / 2));
        let end = start + maxVisible - 1;
        if (end > totalPages) {
            end = totalPages;
            start = Math.max(1, end - maxVisible + 1);
        }
        if (start > 1) {
            html += `<span class="page-number" onclick="goToPage(1)">1</span>`;
            if (start > 2) html += `<span class="dots">...</span>`;
        }
        for (let i = start; i <= end; i++) {
            html += `<span class="page-number ${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</span>`;
        }
        if (end < totalPages) {
            if (end < totalPages - 1) html += `<span class="dots">...</span>`;
            html += `<span class="page-number" onclick="goToPage(${totalPages})">${totalPages}</span>`;
        }

        $('#pageNumbers').html(html);

        let s = (currentPage - 1) * pageSize + 1;
        let e = Math.min(currentPage * pageSize, totalCount);
        if (totalCount === 0) s = e = 0;
        $('#pageInfoText').text(`Results: ${s} - ${e} of ${totalCount}`);
        $('#prevBtn').prop('disabled', currentPage === 1);
        $('#nextBtn').prop('disabled', currentPage === totalPages);
    }
    // ================= NAVIGATION =================
    function goToPage(p) {
        currentPage = p;
        loadAlloutward();
    }

    function prevPage() {
        if (currentPage > 1) {
            currentPage--;
            loadAlloutward();
        }
    }

    function nextPage() {
        const totalPages = Math.ceil(totalCount / pageSize);
        if (currentPage < totalPages) {
            currentPage++;
            loadAlloutward();
        }
    }

    // ================= UTIL =================
    function formatDate(dateStr) {
        // Handle null, undefined, empty
        if (!dateStr || dateStr === "0001-01-01T00:00:00") {
            return '';
        }
        const d = new Date(dateStr);
        // Invalid date
        if (isNaN(d.getTime())) {
            return '';
        }
        const day = String(d.getDate()).padStart(2, '0');
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const year = d.getFullYear();
        return `${day}-${month}-${year}`;
    }
    // ================= ACTIONS =================
    function edit(code, type) {
        window.location.href = `/OutwardEntry/Index?id=${code}&VType=${type}`;
    }

    function view(code, type) {
        window.location.href = `/OutwardEntry/Index?id=${code}&VType=${type}&mode=view`;
    }

    function deleteItem(docId) {
        Swal.fire({
            title: "Delete?",
            text: "Are you sure?",
            icon: "warning",
            showCancelButton: true
        }).then(r => {
            if (r.isConfirmed) {
                $.post('/OutwardEntryList/Delete', { docId : docId }, function (res) {
                    if (res.success) {
                        toastr.success("Deleted Successfully ");
                        loadAlloutward();
                    } else {
                        toastr.error("Failed");
                    }
                });
            }
        });
    }

    function showDocumentPopup(docCode) {
        $.ajax({
            url: '/OutwardEntryList/DocDetailsCode',
            type: 'GET',
            dataType: 'json',
            data: { docCode: docCode },
            success: function (response) {
                if (response.success) {
                    showDocumentPopupjQuery(response.data, docCode);
                } else {
                    toastr.error(response.message || "Failed to get document details.");
                }
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
                toastr.error("Error fetching document details.");
            }
        });
    }
</script>