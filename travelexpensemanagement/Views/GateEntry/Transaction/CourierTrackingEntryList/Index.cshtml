<script src="/common/pagination.js"></script>
<script src="/common/delete.js"></script>

<script>
	let courierPagination;
	$(document).ready(function () {
		courierPagination = Pagination.create({
			pageSize: 10,
			paginationContainer: '#pageNumbers',   
			infoContainer: '#pageInfoText',            
			loader: function (params) {
				$.ajax({
					url: '/CourierTrackingEntryList/GetCourierTrackingEntryList',
					type: 'GET',
					dataType: 'json',
					data: {
						searchTerm: $('#searchBox').val(),
						pageNumber: params.pageNumber,
						pageSize: params.pageSize
					},
					success: function (res) {
						console.log('List page', res)
						params.callback({
							data: res.items,
							totalCount: res.totalCount
						});
					},
					error: function (xhr) {
						toastr.error('Error loading data');
					}
				});
			},
			render: function (docs) {
				const tbody = $('#tblCourierTrackingEntryList tbody');
				tbody.empty();
				if (!docs.length) {
					tbody.append(`<tr><td class="text-center">No records found</td></tr>`);
					return;
				}

				docs.forEach(doc => {
			tbody.append(`
			  <tr>
				<td style="display:none;">${doc.docNo || ''}</td>
				<td style="display:none;">${doc.docType || ''}</td>
				<td>${doc.name || ''}</td>
				<td>${doc.vNo || ''}</td>
				<td>${doc.docDate || ''}</td>
				<td>${doc.partyName || ''}</td>
				<td>${doc.city || ''}</td>
				<td>${doc.courierName || ''}</td>
				<td>${doc.docketNo || ''}</td>
				<td>${doc.purpose || ''}</td>
				<td>${doc.weight || ''}</td>
				<td>${doc.remarks || ''}</td>
				<td class="action-col">
				<div class="action-wrap">
					<button class="act-btn edit btn-edit" title="Edit" style="cursor:pointer;" onclick="editDocStage('${doc.vNo || ''}', '${doc.docType || ''}')"><i class="fa fa-edit"></i></button>
					<button class="act-btn view btn-view" title="View" style="cursor:pointer;" onclick="viewDocStage('${doc.docNo || ''}')"><i class="fa fa-eye"></i></button>
					<button class="act-btn delete btn-delete" title="View" style="cursor:pointer;" onclick="deleteDocStage('${doc.vNo || ''}', '${doc.docType || ''}')"><i class="fa fa-trash"></i></button>
				</div>
				</td>
			  </tr>
			`);
		  });
				
			}
		});
		// First Load
		courierPagination.load();
		// Search
		$('#searchBox').keyup(function () {
			courierPagination.load();
		});
	});

	function editDocStage(vNo, docType) {
	  window.location.href = `/CourierTrackingEntry/Index?id=${encodeURIComponent(vNo)}&type=${encodeURIComponent(docType)}`;
	}
	function viewDocStage(docCode) {
		window.location.href = '/CourierTrackingEntry/Index?id=' + docCode + '&mode=view';
	}

	function deleteDocStage(vNo, docType) {
		if (!vNo || !docType) {
			alert("Invalid data for deletion");
			return;
		}
		deleteRecordbytype("CourierTrackingEntryList", vNo, docType, {
			action: "Delete",
			text: "This will permanently delete the visitor entry.",
			successCallback: function () {
				if (courierPagination) {
					courierPagination.load(); // reload list
				}
			}
		});
	}
	function changeRowsPerPage() {
		courierPagination.setPageSize(parseInt($('#pageSizeSelect').val()));
		courierPagination.load();
	}
</script>