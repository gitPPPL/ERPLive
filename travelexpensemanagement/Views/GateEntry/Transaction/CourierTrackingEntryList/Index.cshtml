		function deleteDocStage(vNo, docType) {
	  Swal.fire({
		title: 'Are you sure?',
		text: "You won't be able to revert this deletion!",
		icon: 'warning',
		showCancelButton: true,
		confirmButtonColor: '#d33',
		cancelButtonColor: '#3085d6',
		confirmButtonText: 'Yes, delete it!'
	  }).then((result) => {
		if (result.isConfirmed) {
		  $.ajax({
			url: '/CourierTrackingEntryList/Delete',
			type: 'POST',
			data: {
			  vNo: vNo,      // your document code/id
			  docType: docType // additional docType parameter
			},
			success: function (response) {
			  if (response.success) {
				toastr.success(response.message || "Record deleted successfully.");
				CourierTrackingEntry();  // refresh list or reload data
			  } else {
				toastr.warning(response.message || "Delete failed.");
			  }
			},
			error: function () {
			  toastr.error("An error occurred while deleting.");
			}
		  });
		}
	  });
