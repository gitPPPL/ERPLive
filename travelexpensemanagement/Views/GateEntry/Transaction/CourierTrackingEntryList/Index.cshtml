@{
	ViewBag.Title = "Courier Tracking Entry List";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
	<legend class="legend-field">Courier Tracking Entry List</legend>
	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>
		<div class="col-lg-6">
			<div class="btn-rightalign">
				<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "CourierTrackingEntry")'" type="submit" class="btn btn-add">
					<i class="fa fa-plus"></i>Add
				</button>
				<button class="btn btn-print" onclick="printCityMasterReport()">
					<i class="fa fa-print"></i> Print
				</button>
				<button class="btn btn-export">
					<i class="fas fa-file-export"></i> Export
				</button>
				<button class="btn btn-mail">
					<i class="fa fa-envelope"></i> Mail
				</button>
				<button class="btn btn-approved">
					<i class="fa fa-check"></i> Approved
				</button>
			</div>
		</div>
	</div>
	<div class="card">
		<div class="table-responsive">
			<table id="tblCourierTrackingEntryList" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>VNo</th>
						<th>VDate</th>
						<th>Party Name</th>
						<th>City</th>
						<th>Courier Name</th>
						<th>Docket No.</th>
						<th>Purpose</th>
						<th>Weight (in gm)</th>
						<th>Remarks</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->

		<div class="erppagelist-pagination">
			<div class="pagination-left">
				<select id="pageSizeSelect" onchange="changeRowsPerPage()">
					<option value="5">5</option>
					<option value="10" selected>10</option>
					<option value="25">25</option>
					<option value="50">50</option>
				</select>
			</div>
			<div class="pagination-center">
				<button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
				<div id="pageNumbers" class="page-numbers"></div>
				<button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
			</div>
			<div class="pagination-right" id="pageInfoText">
				Results: 0 - 0 of 0
			</div>
		</div>


	</div>
</fieldset>

<script src="~/common/pagination.js"></script>
<script>
	let courierPagination;
	$(document).ready(function () {
		courierPagination = Pagination.create({
			pageSize: 10,
			paginationContainer: '#pageNumbers',   
			infoContainer: '#pageInfoText',            
			loader: function (params) {
				$.ajax({
					url: '/CourierTrackingEntryList/GetCourierTrackingEntryList',
					type: 'GET',
					dataType: 'json',
					data: {
						searchTerm: $('#searchBox').val(),
						pageNumber: params.pageNumber,
						pageSize: params.pageSize
					},
					success: function (res) {
						params.callback({
							data: res.items,
							totalCount: res.totalCount
						});
					},
					error: function (xhr) {
						toastr.error('Error loading data');
					}
				});
			},
			render: function (docs) {
				const tbody = $('#tblCourierTrackingEntryList tbody');
				tbody.empty();
				if (!docs.length) {
					tbody.append(`<tr><td colspan="11" class="text-center">No records found</td></tr>`);
					return;
				}

				docs.forEach(doc => {
			tbody.append(`
			  <tr>
				<td style="display:none;">${doc.docNo || ''}</td>
				<td style="display:none;">${doc.docType || ''}</td>
				<td>${doc.vNo || ''}</td>
				<td>${doc.vDate || ''}</td>
				<td>${doc.partyName || ''}</td>
				<td>${doc.cityName || ''}</td>
				<td>${(typeof doc.partyName === 'object' && doc.partyName !== null) ? doc.partyName.name : (doc.partyName || '')}</td>
				<td>${doc.docketNo || ''}</td>
				<td>${doc.purpose || ''}</td>
				<td>${doc.weight || ''}</td>
				<td>${doc.remarks || ''}</td>
				<td>
				  <div class="action-icons">
					<i class="fa fa-edit btn-edit" title="Edit" onclick="editDocStage('${doc.vNo || ''}', '${doc.docType || ''}')"></i>
					<i class="fas fa-eye btn-view" title="View" onclick="viewDocStage('${doc.docNo || ''}')"></i>
				   <i class="fas fa-trash btn-delete" title="Delete" onclick="deleteDocStage('${doc.vNo || ''}', '${doc.docType || ''}')"></i>
				  </div>
				</td>
			  </tr>
			`);
		  });
				
			}
		});
		// First Load
		courierPagination.load();
		// Search
		$('#searchBox').keyup(function () {
			courierPagination.load();
		});
	});

	// Page Size Change
	function changeRowsPerPage() {
		courierPagination.setPageSize(parseInt($('#pageSizeSelect').val()));
		courierPagination.load();
	}
</script>