@{
	ViewBag.Title = "Courier Tracking Entry List";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
	<legend class="legend-field">Courier Tracking Entry List</legend>
	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>
		<div class="col-lg-6">
			<div class="btn-rightalign">
				<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "CourierTrackingEntry")'" type="submit" class="btn btn-add">
					<i class="fa fa-plus"></i>Add
				</button>
				<button class="btn btn-print" onclick="printCityMasterReport()">
					<i class="fa fa-print"></i> Print
				</button>
				<button class="btn btn-export">
					<i class="fas fa-file-export"></i> Export
				</button>
				<button class="btn btn-mail">
					<i class="fa fa-envelope"></i> Mail
				</button>
				<button class="btn btn-approved">
					<i class="fa fa-check"></i> Approved
				</button>
			</div>
		</div>
	</div>
	<div class="card">
		<div class="table-responsive">
			<table id="tblCourierTrackingEntryList" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>VNo</th>
						<th>VDate</th>
						<th>Party Name</th>
						<th>City</th>
						<th>Courier Name</th>
						<th>Docket No.</th>
						<th>Purpose</th>
						<th>Weight (in gm)</th>
						<th>Remarks</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
	</div>
</fieldset>

<script>
	let currentPage = 1;
	let pageSize = 10;

	$(document).ready(function () {
	  CourierTrackingEntry();
	  $('#searchBox').on('keyup', function () {
		currentPage = 1;
		CourierTrackingEntry();
	  });
	});

	// Load courier tracking entries with pagination and search
	function CourierTrackingEntry() {
	  const searchTerm = $('#searchBox').val();

	  $.ajax({
		url: '/CourierTrackingEntryList/GetCourierTrackingEntryList',
		type: 'GET',
		dataType: 'json',
		data: {
		  searchTerm,
		  pageNumber: currentPage,
		  pageSize: pageSize
		},
		success: function (res) {
		  console.log(res);
		  const docs = res.items || [];
		  const totalCount = res.totalCount || 0;

		  const tbody = $('#tblCourierTrackingEntryList tbody');
		  tbody.empty();

		  if (docs.length === 0) {
			tbody.append(`<tr><td colspan="11" class="text-center text-muted">No records found.</td></tr>`);
			renderPagination(0, pageSize, currentPage);
			return;
		  }

		  docs.forEach(doc => {
			tbody.append(`
			  <tr>
				<td style="display:none;">${doc.docNo || ''}</td>
				<td style="display:none;">${doc.docType || ''}</td>
				<td>${doc.vNo || ''}</td>
				<td>${doc.vDate || ''}</td>
				<td>${doc.partyName || ''}</td>
				<td>${doc.cityName || ''}</td>
				<td>${(typeof doc.partyName === 'object' && doc.partyName !== null) ? doc.partyName.name : (doc.partyName || '')}</td>
				<td>${doc.docketNo || ''}</td>
				<td>${doc.purpose || ''}</td>
				<td>${doc.weight || ''}</td>
				<td>${doc.remarks || ''}</td>
				<td>
				  <div class="action-icons">
					<i class="fa fa-edit btn-edit" title="Edit" onclick="editDocStage('${doc.vNo || ''}', '${doc.docType || ''}')"></i>
					<i class="fas fa-eye btn-view" title="View" onclick="viewDocStage('${doc.docNo || ''}')"></i>
				   <i class="fas fa-trash btn-delete" title="Delete" onclick="deleteDocStage('${doc.vNo || ''}', '${doc.docType || ''}')"></i>
				  </div>
				</td>
			  </tr>
			`);
		  });

		  renderPagination(totalCount, pageSize, currentPage);
		},
		error: function (xhr) {
		  toastr.error('Error loading courier tracking entries: ' + (xhr.responseJSON?.message || xhr.statusText));
		}
	  });
	}

	// Pagination UI rendering
	function renderPagination(total, pageSize, currentPage) {
	  const totalPages = Math.ceil(total / pageSize);
	  const pagination = $('#tablePagination');
	  pagination.empty();

	  if (totalPages <= 1) return;

	  let html = '';

	  if (currentPage > 1) {
		html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
		html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
	  }

	  const startPage = Math.max(1, currentPage - 2);
	  const endPage = Math.min(totalPages, currentPage + 2);

	  for (let i = startPage; i <= endPage; i++) {
		html += `
		  <button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
	  }
	  if (currentPage < totalPages) {
		html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
		html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
	  }
	  pagination.html(html);
	}

	// Pagination navigation
	function goToPage(page) {
	  currentPage = page;
	  CourierTrackingEntry();
	}
    function editDocStage(vNo, docType) {
	  window.location.href = `/CourierTrackingEntry/Index?id=${encodeURIComponent(vNo)}&type=${encodeURIComponent(docType)}`;
	}
	function viewDocStage(docCode) {
		window.location.href = '/CourierTrackingEntry/Index?id=' + docCode + '&mode=view';
	}
