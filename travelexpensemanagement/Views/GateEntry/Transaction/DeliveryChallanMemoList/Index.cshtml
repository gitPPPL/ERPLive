@{
	ViewBag.Title = "Delivery Challan Memo List";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
	<legend class="legend-field">Delivery Challan Memo List</legend>
	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>
		<div class="col-lg-6">
			<div class="btn-rightalign">
				<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "DeliveryChallanMemo")'" type="submit" class="btn btn-add">
					<i class="fa fa-plus"></i>Add
				</button>
				<button class="btn btn-print" onclick="printCityMasterReport()">
					<i class="fa fa-print"></i> Print
				</button>
				<button class="btn btn-export">
					<i class="fas fa-file-export"></i> Export
				</button>
				<button class="btn btn-mail"> 
					<i class="fa fa-envelope"></i> Mail
				</button>
				<button class="btn btn-approved">
					<i class="fa fa-check"></i> Approved
				</button>
			</div> 
		</div>
	</div>
	<div class="card">
		<div class="table-responsive">
			<table id="tblDeliveryChallanList" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>Doc No</th>
						<th>Doc Date</th>
						<th>Employee Name</th>
						<th>Vender Name</th>
						<th>Transport/Courier</th>
						<th>Though</th>
						<th>Return Date</th>
						<th>Remarks</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
	</div>
</fieldset>

<script>
    let currentPage = 1;
    const pageSize = 10;

    $(document).ready(function () {
        loadDeliveryChallanList();
    });

    function loadDeliveryChallanList() {
        const searchTerm = $('#searchBox').val();

        $.ajax({
            url: '/DeliveryChallanMemoList/GetGateMemos',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
             
                const lists = res.lists;
                const totalCount = res.totalCount;

                console.log(lists);

                const tbody = $('#tblDeliveryChallanList tbody');
                tbody.empty();

                if (!lists || lists.length === 0) {
                    tbody.append('<tr><td colspan="10" class="text-center text-muted">No records found.</td></tr>');
                    renderPagination(0, pageSize, currentPage);
                    return;
                }

                lists.forEach(item => {
                    tbody.append(`
                        <tr>
                            <td style="display:none;">${item.COMP_CODE || ''}</td>
                            <td>${item.doC_ID || ''}</td>
                            <td>${item.v_DATE ? new Date(item.v_DATE).toLocaleDateString() : ''}</td>
                            <td>${item.emP_NAME || ''}</td>
                            <td>${item.vendoR_NAME || ''}</td>
                            <td>${item.transporT_NAME || ''}</td>
                            <td>${item.through || ''}</td>
                            <td>${item.returN_DATE ? new Date(item.returN_DATE).toLocaleDateString() : ''}</td>
                            <td>${item.remarks || ''}</td>
                            <td>
                                <i class="fas fa-edit text-primary" style="cursor:pointer;" title="Edit" onclick="editGateMemo(${item.V_NO})"></i>
                                <i class="fas fa-eye text-primary" style="cursor:pointer;" title="View" onclick="viewGateMemoDetails(${item.V_NO})"></i>
                                <i class="fas fa-trash text-danger ms-2" style="cursor:pointer;" title="Delete" onclick="deleteGateMemo(${item.V_NO})"></i>
                            </td>
                        </tr>
                    `);
                });

                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                console.error("Error loading delivery challan list:", xhr.responseText);
                toastr.error('Error loading delivery challan list: ' + xhr.responseText);
            }
        });
    }

    function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const paginationContainer = $('#tablePagination');
        paginationContainer.empty();

        if (totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        if (currentPage <= 3) endPage = Math.min(5, totalPages);
        if (currentPage >= totalPages - 2) startPage = Math.max(totalPages - 4, 1);

        for (let i = startPage; i <= endPage; i++) {
            html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        paginationContainer.html(html);
    }

    function goToPage(page) {
        currentPage = page;
        loadDeliveryChallanList();
    }

    $('#searchBox').on('keyup', function () {
        currentPage = 1;
        loadDeliveryChallanList();
    });

    function editGateMemo(vNo) {
        window.location.href = `/DeliveryChallanMemo/Index?vNo=${encodeURIComponent(vNo)}`;
    }

    function viewGateMemoDetails(vNo) {
        window.location.href = `/GateMemo1/Details?vNo=${encodeURIComponent(vNo)}`;
    }

    function deleteGateMemo(vNo) {
        if (confirm("Are you sure you want to delete this record?")) {
            $.ajax({
                url: `/GateMemo1/Delete?vNo=${encodeURIComponent(vNo)}`,
                type: 'POST',
                success: function () {
                    toastr.success("Record deleted successfully.");
                    loadDeliveryChallanList();
                },
                error: function (xhr) {
                    toastr.error("Failed to delete record: " + xhr.responseText);
                }
            });
        }
    }

</script>
