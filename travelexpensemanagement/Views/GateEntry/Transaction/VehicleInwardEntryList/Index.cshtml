<div id="erp-toast-container"></div>
<!-- HEADER -->
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>Vehicle Inward Entry List</span>
    </div>

    <div class="erppagelist-header-right">
        <button class="erppage-header-back" onclick="location.href='@Url.Action("Index", "VehicleInwardEntry")'" id="button_add">
            <i class="fa fa-plus"></i>Add New
        </button>
    </div>
</div>

<!-- TOOLBAR -->
<div class="erppagelist-toolbar">
    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" id="searchBox" placeholder="Search by All Columns Name...." />
    </div>

    <div class="erppagelist-actions">

        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Export to Excel" id="button_export">
            <i class="fa fa-file-excel"></i> Export
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail" id="button_mail">
            <i class="fa fa-envelope"></i> Mail
        </button>
        @* <button class="erppagelist-btn erppagelist-btn-approve tooltip-btn" data-tooltip="Approve Records" id="button_approval">
            <i class="fa fa-check-circle"></i> Approved
        </button> *@

    </div>
</div>

<div class="erppagelist-container">
    <div class="excel-wrapper fixed-grid-wrapper">
        <table id="tblPurchaseBillPassEntry" class="excel-table fixed-grid-table table-width resizable-table">
            <colgroup>
                <col style="display:none;" />  <!-- Code (hidden) -->

                <col style="width: 80px;" />   <!-- VNo -->
                <col style="width: 110px;" />  <!-- VDate -->
                <col style="width: 90px;" />   <!-- VTime -->
                <col style="width: 90px;" />   <!-- Do No -->
                <col style="width: 200px;" />  <!-- Party Name -->
                <col style="width: 150px;" />  <!-- Truck No -->
                <col style="width: 120px;" />  <!-- Transport -->

                <col style="width: 120px;" />  <!-- Action -->
            </colgroup>
            <thead>
                <tr>
                    <th style="display:none;">Code</th>
                    <th>Doc No</th>
                    <th>Doc Date</th>
                    <th>Doc Time</th>
                    <th>Do No</th>
                    <th>Party Name</th>
                    <th>Truck No</th>
                    <th>Transport</th>
                    <th class="action-col">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div class="erppagelist-pagination">
        <div class="pagination-left">
            <select id="pageSizeSelect" onchange="changeRowsPerPage()">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="pagination-center">
            <button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
            <div id="pageNumbers" class="page-numbers"></div>

            <button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
        </div>
        <div class="pagination-right" id="pageInfoText">
            Results: 0 - 0 of 0
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="~/common/delete.js"></script>
<script src="~/common/pagination.js"></script>
<script src="~/js/erpjs/gateentry/transaction/vehicleinwardentrylist/vehicleinwardentrylist.js"></script>
<script>
    window.globalVariables = {
        compCode: "@globalVariables?.PubCompCode",
        yearCode: "@globalVariables?.PubFYearCode",
        branchCode: "@globalVariables?.PubBranchCode",
        companyName: "@globalVariables?.CompanyName",
        add1: "@globalVariables?.Address1",
        add2: "@globalVariables?.Address2",
    };
    window.database = {
        db: "@ViewBag.DatabaseName"
    }
</script>