    async function GetVNo(Vtype, tableName) {
      const res = await fetch(`/OutwardEntry/GetVNo?Vtype=${encodeURIComponent(Vtype)}&tableName=${encodeURIComponent(tableName)}`);
      const data = await res.json();
      if (data.v_NO) {
        $('#NumDocNo').val(data.v_NO);
