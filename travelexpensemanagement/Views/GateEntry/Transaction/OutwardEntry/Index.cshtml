@{
    ViewBag.Title = "Outward Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
    <legend class="legend-field">Outward Entry</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="window.location.href='@Url.Action("Index", "OutwardEntryList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div>
    <form id="OutwardEntryForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlDocType">Doc Type</label>
                    <select class="form-control" id="ddlDocType">
                        <option>--Select DOC Type--</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumDocNo">Doc No</label>
                    <input type="number" class="form-control" id="NumDocNo" placeholder="Enter Doc No" readonly>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DtDocDate">Doc Date</label>
                    <div class="input-divide">
                        <input type="date" class="form-control" id="DtDocDate" />
                        <input type="time" class="form-control" id="DtTxtDocDate">


                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlType">Type</label>
                    <select class="form-control" id="ddlType">
                        <option>--Select Type--</option>
                        <option value="Sale">Sale</option>
                        <option value="Scrap Sale">Scrap Sale</option>
                        <option value="Order">Order</option>
                        <option value="GST Challan">GST Challan</option>
                        <option value="Challan">Challan</option>
                        <option value="Challan (Other than JW)">Challan (Other than JW)</option>
                        <option value="Challan (Internal)">Challan (Internal)</option>
                        <option value="Challan (Godown)">Challan (Godown)</option>
                        <option value="Jobwork Challan">Jobwork Challan</option>
                        <option value="Misc">Misc</option>
                        <option value="Empty">Empty</option>
                        <option value="Others">Others</option>
                        <option value="Sample">Sample</option>
                        <option value="Repair">Repair</option>
                        <option value="Purchase Return">Purchase Return</option>
                        <option value="BillsOfSupply">BillsOfSupply</option>
                        <option value="E‑Commerce Sale">E‑Commerce Sale</option>




                    </select>
                </div>
            </div>
        </div>
        <fieldset class="fieldset-sub">
            <legend class="sub-legend">Party Details</legend>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="ddlPartyName">Party Name<span class="required">*</span></label>
                        <select class="form-control" id="ddlPartyName">
                            <option>Select Party Name</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="ddlPartyNameByAddress">Party Name By Address<span class="required">*</span></label>
                        <select class="form-control" id="ddlPartyNameByAddress">
                            <option>Select Party Name By Address</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtAdd1PD">Add Line1</label>
                        <input type="text" class="form-control" id="TxtAdd1PD" placeholder="Enter Address Line 1" readonly>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtAdd2PD">Add Line2</label>
                        <input type="text" class="form-control" id="TxtAdd2PD" placeholder="Enter Address Line 2" readonly>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtAdd3PD">Add Line3</label>
                        <input type="text" class="form-control" id="TxtAdd3PD" placeholder="Enter Address Line 3" readonly>
                    </div>
                </div>


                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtCity">City</label>
                        <input type="text" class="form-control" id="TxtCity" placeholder="Enter City Name" readonly>
                    </div>
                </div>



                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtState">State</label>
                        <input type="text" class="form-control" id="TxtState" placeholder="Enter State Name" readonly  >
                    </div>
                </div>



             
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtVehicleNo">Vehicle No</label>
                        <input type="text" class="form-control" id="TxtVehicleNo" placeholder="Enter Vehicle No.">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="NumPincode">Pincode</label>
                        <input type="number" class="form-control" id="NumPincode" placeholder="Enter Pincode" readonly>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtGSTNo">GST No</label>
                        <input type="text" class="form-control" id="TxtGSTNo" placeholder="Enter GST No" readonly>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtRemarks">Remarks</label>
                        <textarea type="text" class="form-control" id="TxtRemarks" placeholder="Enter Remarks"></textarea>
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="row">
            <div class="offset-md-8 col-md-4">
                <div class="btn-mt button-right">
                    <button id="btn-pending" type="button" class="btn btn-danger"><i class="fa fa-clock"></i>Pending Document</button>
                    <button id="btn-pending" type="button" class="btn btn-primary"><i class="fa fa-tag"></i>Sticker</button>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="table-responsive">
                <table id="tblOutwardEntry" class="table-width">
                    <thead class="table-head">
                        <tr>
                            <th style="display:none;">Code</th>
                            <th>Item Name</th>
                            <th>Department</th>
                            <th>Unit</th>
                            <th>No.</th>
                            <th>Quantity</th>
                            <th>Remarks</th>
                            <th>Reff. Type</th>
                            <th>Reff. No</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <!-- Pagination container -->
            <div class="row">
                <div class="col-md-12">
                    <div class="btn-add-row-last">
                        <i class="fa fa-plus btn-add-row" title="Add Row"><span>Add New Row</span></i>
                                        </div>
                    <div class="pagination-end">
                        <div class="custom-pagination" id="tablePagination"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="offset-md-10 col-md-2">
                <div class="btn-last">
                    <button id="btn-save" type="submit" class="btn btn-primary"><i class="fa fa-save"></i>Save</button>
                </div>
            </div>
        </div>
    </form>
</fieldset>

<script>
    const refTypeOptions = ["PO", "Indent", "Manual"];
    let itemMap = {};
    let UnitMap = {};
    let DeptMap = {};

    $(document).ready(function () {
      const urlParams = new URLSearchParams(window.location.search);

      const rowId = urlParams.get('id');
      const vtype = urlParams.get('vtype');
      const $tbody = $("#tblOutwardEntry tbody");
        const mode = urlParams.get('mode');
        const isReadOnly = urlParams.get('readOnly') === 'true';
      (async () => {
        try { 
          await LoadDropDowns();
          addRow($tbody);


            if (rowId) {

                await LoadFormByID(rowId);
                    if (mode == 'view') {
                        console.log('Mode', mode);
                          setFormReadOnly();
                    }

            }



          if (rowId && rowId !== 0) {
            await LoadFormByID(rowId, vtype);
            if (typeof isReadOnly !== 'undefined' && isReadOnly) {
              setFormReadOnly();
            }
          }

          // Save Button Click
          $("#btn-save").click(function (e) {
            e.preventDefault();

            const V_DATE = formatDate($("#DtDocDate").val());
            const DocType = $.trim($('#ddlDocType').val());
            const PartyCode = parseInt($('#ddlPartyName').val()) || 0;

            if (!DocType) {
                toastr.warning("Please select a Doc Type.");
                $("#ddlDocType").focus();
                return;
            }

            if (!V_DATE) {
                toastr.warning("Please select a Voucher Date.");
                $("#ddlDocType").focus();
                return;
            }

            if (!PartyCode) {
                toastr.warning("Please select a Party.");
                $("#ddlPartyName").focus();
                return;
            }

            const header = {
              DOC_ID: $.trim($('#TxtCode').val()) ?? null,
              V_TYPE: $('#ddlDocType').val() ?? null,
              V_NO: parseInt($('#NumDocNo').val()) || null,
              V_DATE: (() => {
                const d = new Date($("#DtDocDate").val());
                return !isNaN(d) ? d.toISOString() : null;
              })(),
              PARTY_CODE: parseInt($('#ddlPartyName').val()) || null,
              PARTY_NAME: $('#ddlPartyName option:selected').text() ?? null,
              TRUCK_NO: $.trim($('#TxtVehicleNo').val()) ?? null,
              REMARKS: $.trim($('#TxtRemarks').val()) ?? null,
              Add1: $.trim($('#TxtAdd1PD').val()) ?? null,
              Add2: $.trim($('#TxtAdd2PD').val()) ?? null,
              Add3: $.trim($('#TxtAdd3PD').val()) ?? null,
              PARTY_CITY: parseInt($('#TxtCity').val()) || null,
              PARTY_GST: $.trim($('#TxtGSTNo').val()) ?? null,
              PARTY_PINCODE: $.trim($('#NumPincode').val()) ?? null,
              ITEM_TYPE: $.trim($('#ddlType').val()) ?? null,
              PARTY_ADDRESSID: parseInt($('#ddlPartyNameByAddress').val()) || null,
              action: $.trim($('#TxtCode').val()) ? 'UPDATE' : 'INSERT'
            };

            const payload = {
              Header: header,
              Deatils: collectTableRowData()
            };

            $("#btn-save").prop("disabled", true);

            $.ajax({
              url: '/OutwardEntry/SavedData',
              type: 'POST',
              contentType: 'application/json',
              data: JSON.stringify(payload),
              success: function (response) {
                if (response.success) {
                  toastr.success("Saved successfully!");
                      setTimeout(() => window.location.href = '/OutwardEntryList/Index', 1000);

                } else {
                  toastr.error(response.message || "Save failed.");
                }
              },
              error: function (xhr) {
                let errorMessage = "Something went wrong.";
                if (xhr.status === 400) {
                  errorMessage = "Bad Request: " + xhr.responseText;
                } else if (xhr.status === 500) {
                  errorMessage = "Server error: " + xhr.responseText;
                } else {
                  errorMessage = "Unexpected error: " + xhr.statusText;
                }
                toastr.error(errorMessage);
              },
              complete: function () {
                $("#btn-save").prop("disabled", false);
              }
            });
          });

         // Add/Delete row buttons
          $(document).on("click", ".btn-add-action", () => addRow($tbody));

          $(document).on("click", ".btn-delete-action", function () {
            const $row = $(this).closest("tr");
            const wasLast = $row.is(":last-child");
            $row.remove();
            if (wasLast) {
              const $last = $tbody.find("tr:last");
              if ($last.length && !$last.find(".btn-add-action").length) {
                $last.find("td:last").prepend(
                  `<i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer;"></i>`
                );
              }
            }
          });

          $("#ddlDocType").change(function () {
            if (!rowId) GetVNo(this.value);
          });

          $("#ddlPartyName").on("change", function () {
            const partyId = $(this).val();
            loadPartyAddresses(partyId);
          });

          $("#ddlPartyNameByAddress").on("change", function () {
            const partyId = $("#ddlPartyName").val();
            const addId = $(this).val();
            fetchPartyAddressDetails(partyId, addId);
          });



        } catch (err) {
          console.error("Error initializing page:", err);
        }
      })();
    });


      function setFormReadOnly() {
             
        $('#OutwardEntryForm input:not([type="hidden"]):not([type="time"])').prop('readonly', true);

     
        $('#OutwardEntryForm input[type="time"]').prop('disabled', true);

   
        $('#OutwardEntryForm select').prop('disabled', true);

  
        $('#OutwardEntryForm textarea').prop('readonly', true);


        $('#OutwardEntryForm button').prop('disabled', true);

   
        $('#tblOutwardEntry tbody tr').each(function () {
            $(this).find('input, select').prop('disabled', true);
        });

    
        $('.btn-add-action, .btn-delete-action').css({
            'pointer-events': 'none',
            'opacity': '0.5'
        });

 
        $('#tablePagination').css({
            'pointer-events': 'none',
            'opacity': '0.5'
        });

        $('#OutwardEntryForm input, #OutwardEntryForm select, #OutwardEntryForm textarea').attr('tabindex', '-1');
    }



    async function LoadDropDowns() {
      await Promise.all([
        loadItemMaster(),
        loadDeptMaster(),
        loadUnit(),
        DDLVtype(),
        DDLParty()
      ]);
    }

    async function loadItemMaster() {
      const res = await fetch("/OutwardEntry/DDLItemMaster");
      const data = await res.json();
      itemMap = {};
      data.forEach(i => itemMap[i.value] = i.text);
    }

    async function loadDeptMaster() {
      const res = await fetch("/OutwardEntry/DDLDeptMaster");
      const data = await res.json();
      DeptMap = {};
      data.forEach(i => DeptMap[i.value] = i.text);
    }

    async function loadUnit() {
      const res = await fetch("/OutwardEntry/DDLUnit");
      const data = await res.json();
      UnitMap = {};
      data.forEach(i => UnitMap[i.value] = i.text);
    }

    async function DDLVtype() {
      const res = await fetch("/OutwardEntry/DDlVType");
      const list = await res.json();
      const ddl = $("#ddlDocType");
      ddl.empty().append('<option value="">-- Select Voucher Type --</option>');
      list.forEach(it => ddl.append(`<option value="${it.value}">${it.text}</option>`));
    }

    async function DDLParty() {
      const res = await fetch("/OutwardEntry/DDlParty");
      const list = await res.json();
      const ddl = $("#ddlPartyName");
      ddl.empty().append('<option value="">-- Select Party --</option>');
      list.forEach(it => ddl.append(`<option value="${it.value}">${it.text}</option>`));
    }

    async function GetVNo(Vtype) {
      const res = await fetch(`/OutwardEntry/GetVNo?Vtype=${encodeURIComponent(Vtype)}`);
      const data = await res.json();
      if (data.v_NO) {
        $('#NumDocNo').val(data.v_NO);
      } else {
        console.warn('No document number received');
      }
    }

    async function loadPartyAddresses(partyId) {
      const res = await fetch(`/OutwardEntry/fetchPartyAdd?PartyId=${encodeURIComponent(partyId)}`);
      const list = await res.json();
      const ddl = $("#ddlPartyNameByAddress");
      ddl.empty().append('<option value="">-- Select Address --</option>');
      list.forEach(it => ddl.append(`<option value="${it.value}">${it.text}</option>`));
    }

    async function fetchPartyAddressDetails(partyId, addressId) {
      const res = await fetch(`/OutwardEntry/GetDataByPartyCode?PartyId=${encodeURIComponent(partyId)}&AddressId=${encodeURIComponent(addressId)}`);
      const details = await res.json();
      if (details.length) {
        const d = details[0];
        $("#TxtAdd1PD").val(d.add1);
        $("#TxtAdd2PD").val(d.add2);
        $("#TxtAdd3PD").val(d.add3);
        $("#TxtCity").val(d.cityName);
        $("#NumPincode").val(d.pincode);
        $("#TxtState").val(d.state);
        $("#TxtGSTNo").val(d.gstin);
      }
    }

    function formatDate(dateStr) {
      if (!dateStr) return null;
      const date = new Date(dateStr);
      return isNaN(date) ? null : date.toISOString().split('T')[0];
    }

    function generateSelect(optionsMap, selected = "") {
      return Object.entries(optionsMap)
        .map(([val, txt]) => `<option value="${val}"${val == selected ? " selected" : ""}>${txt}</option>`)
        .join("");
    }

    function collectTableRowData() {
      return Array.from(document.querySelectorAll('#tblOutwardEntry tbody tr')).map(row => {
        return {
          ITEM_CODE: parseInt(row.querySelector('select.itemName')?.value) || null,
          ITEM_NAME: row.querySelector('select.itemName option:checked')?.text || '',
          DEPT_CODE: parseInt(row.querySelector('select.department')?.value) || null,
          UOM_CODE: parseInt(row.querySelector('select.unit')?.value) || null,
          NOS: parseInt(row.querySelector('input.no')?.value) || null,
          QTY: parseFloat(row.querySelector('input.quantity')?.value) || null,
          REMARKS: row.querySelector('input.remarks')?.value || '',
          REF_TYPE: row.querySelector('select.ref-type')?.value || '',
          REF_NO: row.querySelector('input.ref-no')?.value || ''
        };
      });
    }

    function addRow($tbody, data = {}) {
      $tbody.find(".btn-add-action").remove();

      const selectItems = generateSelect(itemMap, data.itemName || "");
      const selectDept = generateSelect(DeptMap, data.department || "");
      const selectunit = generateSelect(UnitMap, data.unit || "");
      const selectRef = generateSelect(refTypeOptions.reduce((o, v) => { o[v] = v; return o; }, {}), data.refType || "");

      const row = `
        <tr class="no-border-input">
          <td style="display:none;">${data.code || ""}</td>
          <td><select class="form-control itemName"><option value="">-- Select --</option>${selectItems}</select></td>
          <td><select class="form-control department"><option value="">-- Select --</option>${selectDept}</select></td>
          <td><select class="form-control unit"><option value="">-- Select --</option>${selectunit}</select></td>
          <td><input type="number" class="form-control no" value="${data.no || ''}"/></td>
          <td><input type="number" class="form-control quantity" value="${data.quantity || ''}"/></td>
          <td><input type="text" class="form-control remarks" value="${data.remarks || ''}"/></td>
          <td><select class="form-control ref-type"><option value="">-- Select Ref --</option>${selectRef}</select></td>
          <td><input type="text" class="form-control ref-no" value="${data.refNo || ''}"/></td>
          <td>
            <i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer;"></i>
            <i class="fa fa-trash btn-delete-action text-danger" title="Delete Row" style="cursor:pointer;"></i>
          </td>
        </tr>`;
      $tbody.append(row);
    }

    function LoadFormByID(rowId, vtype) {
      $.ajax({
        url: '/OutwardEntryList/GetDataByCode',
        method: 'POST',
        data: {
          rowId: rowId,
          vtype: vtype
        },
        success: function (result) {
          console.log("Raw AJAX result:", result);

          if (!result.success || !result.data || !result.data.header) {
            toastr.error("Invalid or missing response data.");
            return;
          }

          const header = result.data.header;
          const details = result.data.details;

          // Fill header fields
          $('#TxtCode').val(header.doC_ID || '');
          $('#ddlDocType').val(header.v_TYPE || '');
          $('#NumDocNo').val(header.v_NO || '');
          $('#DtDocDate').val(formatDate(header.v_DATE));
          $('#ddlPartyName').val(header.partY_CODE || '');
          $('#TxtVehicleNo').val(header.trucK_NO || '');
          $('#TxtRemarks').val(header.remarks || '');
          $('#TxtAdd1PD').val(header.add1 || '');
          $('#TxtAdd2PD').val(header.add2 || '');
          $('#TxtAdd3PD').val(header.add3 || '');
          $('#TxtCity').val(header.partY_CITY || '');
          $('#TxtGSTNo').val(header.partY_GST || '');
          $('#NumPincode').val(header.partY_PINCODE || '');
          $('#ddlType').val(header.iteM_TYPE || '');

          // Load party addresses and set selected
          loadPartyAddresses(header.partY_CODE).then(() => {
            $('#ddlPartyNameByAddress').val(header.partY_ADDRESSID || '');
          });

          // Populate table rows
          const $tbody = $("#tblOutwardEntry tbody");
          $tbody.empty();

          (details || []).forEach(detail => {
            const rowData = {
              code: detail.iteM_CODE || '',
              itemName: detail.iteM_CODE || '',
              department: detail.depT_CODE || '',
              unit: detail.uoM_CODE || '',
              no: detail.nos || '',
              quantity: detail.qty || '',
              remarks: detail.remarks || '',
              refType: detail.reF_TYPE || '',
              refNo: detail.reF_NO || ''
            };

            addRow($tbody, rowData);  // Assuming addRow is your custom row-adding function
          });
        },
        error: function (xhr, status, error) {
          console.error("AJAX error:", error);
          toastr.error("Error loading form data: " + error);
        }
      });
    }


</script>













<script>

    let currentPage = 1;
    let pageSize = 10;

    $(document).ready(function () {
        loadDocumentStages();

        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadDocumentStages();
        });
    });

    //Load main grid...............
    function loadDocumentStages() {
        const searchTerm = $('#searchBox').val();

        $.ajax({
            url: '/ApprovalStageMasterList/GetAllDocs',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                console.log(res);
                const docs = res.items || res.data || [];
                const totalCount = res.totalCount || 0;

                const tbody = $('#tblApprovalStageMaster tbody');
                tbody.empty();

                if (docs.length === 0) {
                    tbody.append(`<tr><td colspan="5" class="text-center text-muted">No records found.</td></tr>`);
                    renderPagination(0, pageSize, currentPage);
                    return;
                }

                docs.forEach(doc => {
                    tbody.append(`
                        <tr>
                            <td style="display:none;">${doc.code || doc.doC_CODE || ''}</td>
                            <td>${doc.doC_CODE || ''}</td>
                            <td>${doc.doC_NAME || ''}</td>
                            <td>${doc.useR_NO || '0'}</td>
                            <td>
                              <div class="action-icons">
                              <i class="fa fa-edit btn-edit" data-bs-toggle="tooltip" title="Edit" onclick="editDocStage('${doc.doC_CODE}')"></i>
                              <i class="fas fa-eye btn-view" data-bs-toggle="tooltip" title="View" onclick="viewDocStage('${doc.doC_CODE}')"></i>
                              <i class="fas fa-trash btn-delete" data-bs-toggle="tooltip" title="Delete" onclick="deleteDocStage('${doc.doC_CODE}')"></i>
                               <i class="fa fa-file btn-document" data-bs-toggle="tooltip" data-bs-title="Document Details" onclick="showDocumentPopup('${doc.doC_CODE}')"></i>
                              </div>

                            </td>
                        </tr>
                    `);
                });

                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                toastr.error('Error loading document stages: ' + (xhr.responseJSON?.message || xhr.statusText));
            }
        });
    }

        function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const pagination = $('#tablePagination');
        pagination.empty();

        if (totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        const startPage = Math.max(1, currentPage - 2);
        const endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
            html += `
                <button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        pagination.html(html);
    }

    function goToPage(page) {
        currentPage = page;
        loadDocumentStages();
    }

    function editDocStage(docCode) {
        window.location.href = `/ApprovalStageMaster/Index?docCode=${encodeURIComponent(docCode)}`;
    }

    function viewDocStage(docCode) {
        window.location.href = `/ApprovalStageMaster/Index?docCode=${encodeURIComponent(docCode)}&readOnly=true`;
    }

    function deleteDocStage(docCode) {
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this deletion!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/ApprovalStageMasterList/DeleteDocByCode',
                    type: 'POST',
                    data: { docCode: docCode },
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message || "Record deleted successfully.");
                            loadDocumentStages();
                        } else {
                            toastr.warning("Delete failed.");
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while deleting.");
                    }
                });
            }
        });
    }



</script>
