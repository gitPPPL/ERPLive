@{
    ViewBag.Title = "Outward Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var logindate = Convert.ToDateTime(TempData["LoginDate"]).ToString("yyyy-MM-dd");
    var PubUserLevel = Convert.ToInt32(TempData["PubUserLevel"]);
    var CompCode = Convert.ToInt32(TempData["CompCode"]);
}
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fas fa-right-to-bracket"></i>
        </div>
        <div class="erppage-header-title">Outward Entry</div>
    </div>
    <div class="erppage-header-right">
        @* <button type="button" class="erppage-header-back" onclick="window.location.href='@Url.Action("Index", "OutwardEntryList")'">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
 *@
        <button id="btnbacklist"
                onclick="handleBack('@Url.Action("Index", "OutwardEntryList")', isReadOnly)" type="button" class="btn btn-primary">
            <i class="fa fa-list"></i>Back to list
        </button>



    </div>
</div>
<div id="OutwardEntryForm">
    <input type="hidden" class="form-control" id="TxtCode" name="CODE">
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-grid4">
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Document Type</label>
                    <Select class="erppage-input" id="ddlDocType">
                        <option>Select Document Type</option>
                    </Select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Document No</label>
                    <input type="text" class="erppage-input" id="NumDocNo" placeholder="Enter Doc No" readonly />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Document Date</label>
                    <input type="date" class="erppage-input" id="DtDocDate" />
                    <input type="time" class="erppage-input" id="DtTxtDocDate" />
                </div>
                <div class="erppage-divfield erppage-col-span-2">
                    <label class="erppage-label">Type</label>
                    <Select class="erppage-input" id="ddlType">
                        <option> Select Type </option>
                        <option value="Sale">Sale</option>
                        <option value="Scrap Sale">Scrap Sale</option>
                        <option value="Order">Order</option>
                        <option value="GST Challan">GST Challan</option>
                        <option value="Challan">Challan</option>
                        <option value="Challan (Other than JW)">Challan (Other than JW)</option>
                        <option value="Challan (Internal)">Challan (Internal)</option>
                        <option value="Challan (Godown)">Challan (Godown)</option>
                        <option value="Jobwork Challan">Jobwork Challan</option>
                        <option value="Misc">Misc</option>
                        <option value="Empty">Empty</option>
                        <option value="Others">Others</option>
                        <option value="Sample">Sample</option>
                        <option value="Repair">Repair</option>
                        <option value="Purchase Return">Purchase Return</option>
                        <option value="BillsOfSupply">Bills Of Supply</option>
                        <option value="E-Commerce Sale">E-Commerce Sale</option>
                    </Select>
                </div>
            </div>
            <div class="erppage-grid4" id="Conditionnaldesignid" style="display:none;">
                <div class="erppage-divfield">
                    <label class="erppage-label">Expected Date of Return</label>
                    <input type="date" class="erppage-input" id="DtExpectedDateReturn" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Responsible Person</label>
                    <input type="text" class="erppage-input" id="txtResponsiblePerson" />
                </div>
            </div>
            <fieldset class="erppage-subfieldset">
                <legend>Party Details</legend>
                <div class="erppage-subheader">Party Details</div>
                <div class="erppage-grid4">
                    <div class="erppage-divfield erppage-col-span-2">
                        <label class="erppage-label">Party Name</label>
                        <Select class="erppage-input erppage-required" id="ddlPartyName">
                            <option>Select Party Name</option>
                        </Select>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Party Name By Address</label>
                        <Select class="erppage-input" id="ddlPartyNameByAddress">
                            <option>Select Party Name By Address</option>
                        </Select>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Add Line1</label>
                        <input type="text" class="erppage-textarea" id="TxtAdd1PD" placeholder="Enter Address Line 1" readonly />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Add Line2</label>
                        <input type="text" class="erppage-input" id="TxtAdd2PD" placeholder="Enter Address Line 2" readonly />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Add Line3</label>
                        <input type="text" class="erppage-input" id="TxtAdd3PD" placeholder="Enter Address Line 3" readonly />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">City</label>
                        <Select class="erppage-input" id="ddlCity" disabled>
                            <option>Select Party City</option>
                        </Select>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">State</label>
                        <input type="text" class="erppage-input" id="TxtState" placeholder="Enter State Name" readonly />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Vehicle No</label>
                        <input type="text" class="erppage-input" id="TxtVehicleNo" placeholder="Enter Vehicle No." />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Pincode</label>
                        <input type="text" class="erppage-input" id="NumPincode" placeholder="Enter Pincode" readonly />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">GST No</label>
                        <input type="text" class="erppage-input" id="TxtGSTNo" placeholder="Enter GST No" readonly />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">WayBill No</label>
                        <input type="text" class="erppage-input" id="TxtWayBillNo" placeholder="Enter WayBill No" />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Remarks</label>
                        <textarea type="text" class="erppage-input" id="TxtRemarks" placeholder="Enter Remarks"></textarea>
                    </div>
                </div>
            </fieldset>
            <div class="erppage-actions">
                <button type="button" class="erppage-btn erppage-btn-danger" data-bs-toggle="modal" id="btnpendingorderno" data-bs-target="#pendingorders"><i class="fa fa-clock"></i>Pending Orders/Bill</button>
                <button id="btn-pending" type="button" class="erppage-btn erppage-btn-common"><i class="fa fa-tag"></i>Sticker</button>
            </div>
        </fieldset>

    </div>
</div>
<div class="erppagelist-container">
    <div class="excel-wrapper fixed-grid-wrapper">
        <table id="tblOutwardEntry" class="excel-table fixed-grid-table">

            <!-- Column Width Control -->
            <colgroup>
                <col style="display:none;" /> <!-- Code -->
                <col style="width: 250px;" /> <!-- Item Name -->
                <col style="width: 150px;" /> <!-- Department -->
                <col style="width: 120px;" />  <!-- Unit -->
                <col style="width: 70px;" />  <!-- No -->
                <col style="width: 100px;" /> <!-- Quantity -->
                <col style="width: 180px;" /> <!-- Remarks -->
                <col style="width: 120px;" /> <!-- Reff Type -->
                <col style="width: 120px;" /> <!-- Reff No -->
                <col style="width: 140px;" /> <!-- Action -->
            </colgroup>

            <thead>
                <tr>
                    <th style="display:none;">Code</th>
                    <th>Item Name</th>
                    <th>Department</th>
                    <th>Unit</th>
                    <th>No.</th>
                    <th>Quantity</th>
                    <th>Remarks</th>
                    <th>Reff. Type</th>
                    <th>Reff. No</th>
                    <th class="action-col">Action</th>
                </tr>
            </thead>

            <tbody></tbody>
        </table>
    </div>

    <!-- Pagination (Same as First Table) -->
    <div class="erppagelist-pagination">
        <div class="pagination-left">
            <select id="pageSizeSelectOutward" onchange="changeRowsPerPageOutward()">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>

        <div class="pagination-center">
            <button onclick="prevPageOutward()" class="page-nav" id="prevBtnOutward">‹</button>
            <div id="pageNumbersOutward" class="page-numbers"></div>
            <button onclick="nextPageOutward()" class="page-nav" id="nextBtnOutward">›</button>
        </div>

        <div class="pagination-right" id="pageInfoTextOutward">
            Results: 0 - 0 of 0
        </div>
    </div>
</div>
<div class="erppage-actions">
    <button id="btn-save" type="submit" class="erppage-btn erppage-btn-save">
        <i class="fa-solid fa-floppy-disk"></i>
        <span>Save</span>
    </button>
</div>

@* Modal Popup New *@
<div class="modal fade" id="pendingorders" tabindex="-1" aria-labelledby="pendingordersLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg erppagesmodal">
        <div class="modal-content erppagesmodal-content draggable-modal">
            <div class="erppagesmodal-header">
                <div class="erppagesmodal-header-left">
                    <div class="erppagesmodal-header-icon">
                        <i class="fa fa-clock"></i>
                    </div>
                    <h5 class="erppagesmodal-title" id="pendingordersLabel">
                        Pending Order
                    </h5>
                </div>
                <button type="button" class="erppagesmodal-close" data-bs-dismiss="modal">
                    <i class="fa fa-times"></i>
                </button>
            </div>
            <div class="erppagesmodal-body">
                <div class="d-flex justify-content-end mb-3">
                    <button type="button" class="erppage-btn erppage-btn-copy" id="Btn_selectedData">
                        <i class="fa fa-check"></i> Selected Data
                    </button>
                </div>
                <div class="erppagelist-container">
                    <div class="excel-wrapper fixed-grid-wrapper">
                        <table id="tblpendingordermodal" class="excel-table fixed-grid-table">

                            <colgroup>
                                <col style="width:50px;" />
                                <col style="width:120px;" />
                                <col style="width:120px;" />
                                <col style="width:120px;" />
                                <col style="width:120px;" />
                                <col style="width:140px;" />
                                <col style="width:100px;" />
                                <col style="width:120px;" />
                                <col style="width:140px;" />
                                <col style="width:80px;" />
                                <col style="width:120px;" />
                                <col style="width:120px;" />
                                <col style="width:80px;" />
                            </colgroup>

                            <thead>
                                <tr>
                                    <th><input type="checkbox" id="selectAllPR" class="rowCheckbox" /></th>
                                    <th>voucher Type</th>
                                    <th>voucher No</th>
                                    <th>Voucher Date</th>
                                    <th>Item code</th>
                                    <th>Item Name</th>
                                    <th>Quantity</th>
                                    <th>Purchase Qty</th>
                                    <th>Remark</th>
                                    <th>NOS</th>
                                    <th>Unit Name</th>
                                    <th>Unit Code</th>
                                    <th>Sr.No </th>
                                </tr>
                            </thead>

                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <!-- PAGINATION -->
                <div class="erppagelist-pagination mt-3">
                    <div class="pagination-left">
                        <select id="pageSizeSelect" onchange="changeRowsPerPage()">
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                    </div>

                    <div class="pagination-center">
                        <button onclick="prevPage()" class="page-nav" id="prevBtn">‹</button>
                        <div id="pageNumbers" class="page-numbers"></div>
                        <button onclick="nextPage()" class="page-nav" id="nextBtn">›</button>
                    </div>

                    <div class="pagination-right" id="pageInfoText">
                        Results: 0 - 0 of 0
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="~/js/erpjs/gateentry/transaction/outwordentry_js/outwordentryapi.js"></script>
<script src="~/js/erpjs/gateentry/transaction/outwordentry_js/outwordentry.validation.js"></script>
<script src="~/js/erpjs/gateentry/transaction/outwordentry_js/outwordentry.ui.js"></script>
<script src="~/js/erpjs/gateentry/transaction/outwordentry_js/outwordentry.init.js"></script>


