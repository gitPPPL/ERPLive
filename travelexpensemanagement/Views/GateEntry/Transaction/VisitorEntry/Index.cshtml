@{
    ViewBag.Title = "Visitor Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="erp-toast-container"></div>

<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-clipboard-list"></i>
        </div>
        <div class="erppage-header-title">Visitor Entry</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" id="btnbacklist" class="erppage-header-back" onclick="returnBack('@Url.Action("Index", "VisitorEntryList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list 
        </button> 
    </div>
</div>
<form id="VisitorEntryForm" enctype="multipart/form-data">
    <input type="hidden" class="form-control" id="DOCID" name="DOCID">
    <div id="erp-toast-container"></div>
    <div class="erppage-container">
        <fieldset class="erppage-fieldset">
            <div class="erppage-split">
                <!-- LEFT: FORM -->
                <div class="erppage9">
                    <div class="erppage-grid3 mb-2">
                        <div class="erppage-divfield">
                            <label class="erppage-label">Document No</label>
                            <input class="erppage-input" id="NumDocNo" placeholder="Enter Doc No" readonly/>
                        </div>
                        <div class="erppage-divfield">
                            <label class="erppage-label">Document Date</label>
                            <input type="date" class="erppage-input" id="DtDocDate" />
                        </div>
                        <div class="erppage-divfield">
                            <label class="erppage-label">In Time</label>
                            <input type="time" class="erppage-redinput" id="TMInTime" readonly />
                        </div>
                    </div>
                    <fieldset class="erppage-subfieldset">
                        <legend></legend>
                        <div class="erppage-subheader">Basic Visitor Information</div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Mobile No</label>
                                <input type="text" class="erppage-input" id="NumMobileNo" placeholder="Enter Mobile No" />
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label">Card No</label>
                                <input type="text" class="erppage-input" id="ddlCardNo" placeholder="Enter Card No." />
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Visitor Name</label>
                                <input type="text" class="erppage-redinput" id="TxtVisitorName" placeholder="Enter Visitor Name" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Address</label>
                                <input type="text" class="erppage-input" id="TxtAddress" placeholder="Enter Address" />
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Organization</label>
                                <input type="text" class="erppage-input" id="TxtOrganization" placeholder="Enter Organization" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Visit Purpose</label>
                                <select class="erppage-redinput" id="ddlPurpose">
                                    <option value="">Select Purpose</option>
                                    <option value="Official Work">Official Work</option>
                                    <option value="Service Work">Service Work</option>
                                    <option value="Interview">Interview</option>
                                    <option value="Personal">Personal</option>
                                    <option value="Others">Others</option>
                                </select>
                            </div>

                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Meet Employee</label>
                                <select class="erppage-input erppage-required" id="ddlMeetEmployee">
                                    <option value="">Select Meet Employee</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Meet Other</label>
                                <input type="text" class="erppage-input" id="TxtMeetOther" placeholder="Enter Meet Other">
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield erppage-datefield">
                                <label class="erppage-label">Out Date</label>
                                <div class="erppage-datewrap">
                                    <input type="date" class="erppage-input erppage-dateinput" id="DtOutDate">
                                    <label class="erppage-checkboxwrap">
                                        <input type="checkbox" id="chkOutDate">
                                    </label>
                                </div>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Out Time</label>
                                <input type="time" class="erppage-input" id="TMOutTime" />
                            </div>
                        </div>
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Vehicle No</label>
                                <input type="text" class="erppage-input" id="TxtVehicleNo" placeholder="Enter Vehicle No">
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Material</label>
                                <input type="text" class="erppage-input" id="TxtMaterial" placeholder="Enter Material">
                            </div>

                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Remarks</label>
                                <textarea class="erppage-textarea" id="TxtRemarks" placeholder="Enter Remarks"></textarea>
                            </div>
                        </div>
                    </fieldset>
                </div>
                <!-- RIGHT: IMAGE PANEL -->
                <div class="erppage3">
                    <div class="erppage-image-card">

                        <div class="erppage-image-preview">
                            <img src="placeholder.jpg" alt="Preview" />
                            <input type="file" style="display:none;" class="form-control" id="VisitorImage" name="VisitorImage" accept="image/*">
                        </div>
                        <canvas id="canvas" width="300" height="225" style="display:none;"></canvas>
                        <img id="previewImage" src="" style="display:none; width: 100px; height: 100px; object-fit: cover; margin-top:10px;" />
                        <div class="erppage-image-actions">
                            <button type="button" class="erppage-btn erppage-btn-primary" onclick="startCamera()">Start Camera</button>
                            <button type="button" class="erppage-btn erppage-btn-save" onclick="capturePhoto()">Capture</button>
                            <button type="button" class="erppage-btn erppage-btn-remove" onclick="removePhoto()">Remove</button>
                            <input type="hidden" id="IsImageRemoved" name="IsImageRemoved" value="false" />
                        </div>
                        <!-- Hidden base64 input -->
                        <input type="hidden" id="WebcamImage" name="WebcamImage" />
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="erppage-actions">
        <button id="btn-save" type="submit" class="erppage-btn erppage-btn-save">
            <i class="fa-solid fa-floppy-disk"></i>
            <span>Save</span>
        </button>
        <button  type="button"class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print Report" id="btn_Print">
            <i class="fa fa-print"></i>Print
        </button>
    </div>
</form>

<script src="~/js/erpjs/gateentry/transaction/visitorentryjs/visitorapi.js"></script>
<script src="~/js/erpjs/gateentry/transaction/visitorentryjs/visitor.js"></script>
<script src="~/js/erpjs/gateentry/transaction/visitorentryjs/visitorinit.js"></script>

