<script>
     // Global Variable getting from controller
    var compCode = '@ViewBag.CompCode';
    var branchCode = '@ViewBag.BranchCode';
    var yearCode = '@ViewBag.YearCode';

    //getting
    const urlParams = new URLSearchParams(location.search);
    const rowId = parseInt(urlParams.get('id'));
    const isReadOnly = urlParams.get('readOnly') === 'true';


    $(document).ready(function () {

        if (!isNaN(rowId) && rowId > 0) {
            loadEmpList().then(function() {
                loadVisitorEntry(rowId); 
            });
            if (isReadOnly) {
                setVisitorEntryFormReadOnly();
            }
        } else {
            loadEmpList();
        }
        loadNextDocNo(yearCode);
    });

    function loadNextDocNo(yearC){
        $.ajax({
            url: '/VisitorEntry/GetNextV_NO',
            type: 'GET',
            data: { yearCode : yearC },
            success: function (response) {
                $('#NumDocNo').val(response).attr('disabled',true);
            },
            error: function (xhr, status, error) {
                toastr.error('Error loading Item make: ' + error);
            }
        });
    }

    function loadEmpList() {
        empMap = {};
        return $.ajax({
            url: '/VisitorEntry/GetEmpList',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                console.log('Employee list loaded');
                var ddl = $('#ddlMeetEmployee');
                ddl.empty();
                ddl.append('<option value="">-- Select Meet Employee --</option>');

                $.each(data, function (index, item) {
                    var displayText = item.text + '\u00A0\u00A0\u00A0\u00A0|\u00A0\u00A0\u00A0\u00A0' + item.value;
                    ddl.append('<option value="' + item.value + '">' + displayText + '</option>');
                    empMap[item.value] = item.text;
                });
            },
            error: function (xhr, status, error) {
                toastr.error('Error loading employee list: ' + error);
            }
        });
    }


    $('#VisitorEntryForm').on('submit', async function (e) {
        e.preventDefault();

        const visitorName = $('#TxtVisitorName').val().trim();
        const docDate = $('#DtDocDate').val();
        const meetEmployee = $('#ddlMeetEmployee').val();
        const meetOtherName = $('#TxtMeetOther').val().trim();
        const purpose = $('#ddlPurpose').val();

        let isValid = true;


        // Validation: Visitor Name
        if (!visitorName) {
            toastr.warning('Visitor Name is required.');
            $('#TxtVisitorName').addClass('is-invalid');
            isValid = false;
        } else {
            $('#TxtVisitorName').removeClass('is-invalid');
        }

          // ✅ Doc Date validation
        if (!docDate) {
            toastr.warning('Doc Date is required.');
            $('#DtDocDate').addClass('is-invalid');
            isValid = false;
        } else {
            $('#DtDocDate').removeClass('is-invalid');
        }

        // Validation: Purpose
        if (!purpose) {
            toastr.warning('Purpose is required.');
            $('#ddlPurpose').addClass('is-invalid');
            isValid = false;
        } else {
            $('#ddlPurpose').removeClass('is-invalid');
        }

        // Validation: At least one of Meet Employee or Meet Other must be filled
        if (!meetEmployee && !meetOtherName) {
            toastr.warning('Please select Meet Employee or enter Meet Other.');
            $('#ddlMeetEmployee').addClass('is-invalid');
            $('#TxtMeetOther').addClass('is-invalid');
            isValid = false;
        } else {
            $('#ddlMeetEmployee').removeClass('is-invalid');
            $('#TxtMeetOther').removeClass('is-invalid');
        }

        if (!isValid) return;

        // Process image file
        const fileInput = $('#VisitorImage')[0];
        let base64Image = "";

        if (fileInput.files.length > 0) {
            const file = fileInput.files[0];
            base64Image = await toBase64(file);
        }

        // Prepare Meet Name and Code
        const MEET_NAME = meetEmployee
            ? $('#ddlMeetEmployee option:selected').text()
            : meetOtherName;

        const MEET_CODE = meetEmployee || 0;

        const payload = {
            Visitor: {
                V_NO: $('#TxtCode').val(),
                V_TYPE: 'VISI',
                SLIP_NO: $('#TxtSlipNo').val(),
                NAME: $('#TxtVisitorName').val(),
                CARD_NO: $('#ddlCardNo').val(),
                ORGANIZATION: $('#TxtOrganization').val(),
                ADDRESS: $('#TxtAddress').val(),
                MEET_NAME: MEET_NAME,
                MEET_CODE: MEET_CODE,
                REMARKS: $('#TxtRemarks').val(),
                // REMARKS: $('#TxtMeetOther').val(),
                IN_TIME: $('#TMInTime').val(),
                OUT_DATE: $('#DtOutDate').val(),
                OUT_TIME: $('#TMOutTime').val(),
                MOBILE_NO: $('#NumMobileNo').val(),
                PURPOSE: $('#ddlPurpose').val(),
                VEHICLE_NO: $('#TxtVehicleNo').val(),
                MATERIAL: $('#TxtMaterial').val()
            },
            Image: {
                FileName: fileInput.files.length > 0 ? fileInput.files[0].name : null,
                Base64Content: base64Image
            }
        };
        
        $.ajax({
            url: '/VisitorEntry/SaveVisitorEntry',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (response) {
                if (response.success) {
                    toastr.success('Visitor saved successfully!');
                    setTimeout(() => {
                        window.location.href = '/VisitorEntryList/Index';
                    }, 1000);
                } else {
                    toastr.error('Failed to save visitor: ' + response.message);
                }            },
            error: function (err) {
                alert("Error occurred.");
                console.error(err);
            }
        });
    });

    function toBase64(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = () => resolve(reader.result);
            reader.onerror = error => reject(error);
        });
    }

    function loadVisitorEntry(vNo) {
        $.ajax({
            url: '/VisitorEntryList/GetVisitorByVno',
            type: 'GET',
            data: { vNo },
            success: function (res) {
                console.log(res);
                if (!res.success || !res.data) {
                    toastr.warning("Visitor record not found.");
                    return;
                }

                const visitor = res.data;
                $('#TxtCode').val(visitor.v_NO || '');
                $('#NumDocNo').val(visitor.v_NO || '');
                $('#DtDocDate').val(visitor.v_DATE ? visitor.v_DATE.substring(0, 10) : '');
                $('#TxtSlipNo').val(visitor.sliP_NO || '');
                $('#TxtVisitorName').val(visitor.name || '');
                $('#ddlCardNo').val(visitor.carD_NO || '').trigger('change');
                $('#TxtOrganization').val(visitor.organization || '');
                $('#TxtAddress').val(visitor.address || '');

                // 🧠 Logic to decide where to display meet name
                const meetCode = visitor.meeT_CODE;
                const meetName = visitor.meeT_NAME;

                const empExists = $('#ddlMeetEmployee option[value="' + meetCode + '"]').length > 0;

                if (empExists && meetCode) {
                    $('#ddlMeetEmployee').val(meetCode).trigger('change');
                    $('#TxtMeetOther').val('').prop('disabled', true);
                } else {
                    $('#ddlMeetEmployee').val('').trigger('change');
                    $('#TxtMeetOther').val(meetName || '').prop('disabled', false);
                }

                $('#TMInTime').val(visitor.iN_TIME || '');
                $('#DtOutDate').val(visitor.ouT_DATE ? visitor.ouT_DATE.substring(0, 10) : '');
                $('#chkOutDate').prop('checked', !!visitor.ouT_DATE);
                $('#TMOutTime').val(visitor.ouT_TIME || '');
                $('#NumMobileNo').val(visitor.mobilE_NO || '');
                $('#ddlPurpose').val(visitor.purpose || '').trigger('change');
                $('#TxtVehicleNo').val(visitor.vehiclE_NO || '');
                $('#TxtMaterial').val(visitor.material || '');
                $('#TxtRemarks').val(visitor.remarks || '');

                const base64Image = res.base64Image;

                // ✅ Handle Image Preview
                if (base64Image && base64Image.length > 0) {
                    const imageType = visitor.filE_NAME && visitor.filE_NAME.toLowerCase().endsWith('.png')
                        ? 'png'
                        : 'jpeg';

                    $('#previewImage')
                        .attr('src', 'data:image/' + imageType + ';base64,' + base64Image)
                        .css('display', 'inline-block');

                    $('#WebcamImage').val(base64Image);
                    $('#VisitorImage').val('');
                } else {
                    $('#previewImage').hide().attr('src', '');
                    $('#WebcamImage').val('');
                }
            },
            error: function (xhr) {
                toastr.error("Failed to load visitor data: " + xhr.responseText);
            }
        });
    }


    function setVisitorEntryFormReadOnly() {
        const form = $('#VisitorEntryForm');

        // Disable all input, select, textarea inside the form
        form.find('input, select, textarea, button[type="submit"]').prop('disabled', true);

        // Disable custom buttons (webcam, capture, remove)
        form.find('button').not('#btnbacklist').prop('disabled', true);

        // Optionally hide or disable file input manually
        $('#VisitorImage').prop('disabled', true);

        // Disable image capture controls
        $('#canvas').hide();
        $('#previewImage').css('pointer-events', 'none');

        // Optional: visually indicate the form is read-only
        form.css('opacity', '0.95');
    }


