@{
    ViewBag.Title = "Visitor Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
    <legend class="legend-field">Visitor Entry</legend>
    <div class="row">
        <div class="offset-md-10 col-md-2">
            <div class="btn-right">
                <button id="btnbacklist"
                        onclick="window.location.href='@Url.Action("Index", "VisitorEntryList")'" type="button" class="btn btn-primary">
                    <i class="fa fa-list"></i>Back to list
                </button>
            </div>
        </div>
    </div> 
    <form id="VisitorEntryForm" enctype="multipart/form-data">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumDocNo">Doc No</label>
                    <input type="number" class="form-control" id="NumDocNo" placeholder="Enter Doc No">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DtDocDate">Doc Date</label>
                    <input type="date" class="form-control" id="DtDocDate">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtSlipNo">Slip No</label>
                    <input type="text" class="form-control" id="TxtSlipNo" placeholder="Enter Slip No">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtVisitorName">Visitor Name<span class="required">*</span></label>
                    <input type="text" class="form-control" id="TxtVisitorName" placeholder="Enter Visitor Name">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlCardNo">Card No</label>
                    <input type="text" class="form-control" id="ddlCardNo" placeholder="Enter Card No.">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtOrganization">Organization</label>
                    <input type="text" class="form-control" id="TxtOrganization" placeholder="Enter Organization">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtAddress">Address</label>
                    <textarea type="text" class="form-control" id="TxtAddress" placeholder="Enter Address"></textarea>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlMeetEmployee">Meet Employee<span class="required">*</span></label>
                    <select class="form-control" id="ddlMeetEmployee">
                        <option value="">Select Meet Employee</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtMeetOther">Meet Other</label>
                    <input type="text" class="form-control" id="TxtMeetOther" placeholder="Enter Meet Other">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TMInTime">In Time</label>
                    <input type="time" class="form-control" id="TMInTime">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group position-relative">
                    <label for="DtOutDate">Out Date</label>
                    <div class="calender-check">
                        <input type="date" class="form-control" id="DtOutDate" style="padding-left: 30px;">
                        <input type="checkbox" id="chkOutDate" class="checkbox-inside">
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TMOutTime">Out Time</label>
                    <input type="time" class="form-control" id="TMOutTime">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumMobileNo">Mobile No</label>
                    <input type="number" class="form-control" id="NumMobileNo" placeholder="Enter Mobile No">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlPurpose">Purpose<span class="required">*</span></label>
                    <select class="form-control" id="ddlPurpose">
                        <option value="Interview">Interview</option>
                        <option value="Meeting">Meeting</option>
                        <option value="Vendor">Vendor</option>
                        <option value="Delivery">Delivery</option>
                        <option value="Training">Training</option>
                        <option value="Student">Student</option>
                        <option value="Investors">Investors</option>
                        <option value="Investors">Customer</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtVehicleNo">Vehicle No</label>
                    <input type="text" class="form-control" id="TxtVehicleNo" placeholder="Enter Vehicle No">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtMaterial">Material</label>
                    <input type="text" class="form-control" id="TxtMaterial" placeholder="Enter Material">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                   
                     <!-- Live webcam preview -->
                    @* <video id="video" width="300" height="225" autoplay style="display:none;"></video> *@

 
                    <!-- File upload input -->
                    @* <input type="file" id="fileInput" accept="image/*" class="form-control" onchange="uploadPhoto(this)" /> *@
                    <div class="form-group">
                        <label for="VisitorImage">Upload Image</label>
                        <input type="file" class="form-control" id="VisitorImage" name="VisitorImage" accept="image/*">
                    </div>

                    <!-- Captured or uploaded image -->
                    <canvas id="canvas" width="300" height="225" style="display:none;"></canvas>
                    @* <img id="previewImage" src="" style="display:none; margin-top:10px;" /> *@
                    <img id="previewImage" src="" style="display:none; width: 100px; height: 100px; object-fit: cover; margin-top:10px;" />



                    <!-- Control buttons -->
                    <div class="mt-2">
                        <button type="button" class="btn btn-primary" onclick="startCamera()">Start Camera</button>
                        <button type="button" class="btn btn-success" onclick="capturePhoto()">Capture</button>
                        <button type="button" class="btn btn-danger" onclick="removePhoto()">Remove</button>
                    </div>

                    <!-- Hidden base64 input -->
                    <input type="hidden" id="WebcamImage" name="WebcamImage" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="Remarks">Remarks</label>
                    <textarea class="form-control" id="TxtRemarks" placeholder="Enter Remarks"></textarea>
                </div>
            </div>
        </div>
