@{
    ViewBag.Title = "Vehicle Gatepass Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<fieldset>
    <legend class="legend-field">Vehicle Gatepass Entry</legend>
   
    <div id="VehicleGatepassEntryForm">
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DtFrom">From</label>
                    <input type="date" class="form-control" id="DtFrom">
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DtTo">To</label>
                    <input type="date" class="form-control" id="DtTo">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="ddlWBType">WB Type</label>
                    <select class="form-control" id="ddlWBType">
                        <option>--Select WB Type--</option>
                        <option>Raw Material</option>
                        <option>Store</option>
                        <option>Fuel</option>
                        <option> Outsider</option>
                        <option>Misc</option>
                        <option>JobWork</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtVehicleNo">Vehicle No.</label>
                    <select class="form-control" id="ddlTxtVehicleNo">
                        <option value="">Select Vehicle No</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="TxtQRBarcodeNo">QR/Barcode No</label>
                    <input type="text" class="form-control" id="TxtQRBarcodeNo" placeholder="Enter QR/Barcode No">
                </div>
            </div>
            <div class="col-md-3">
                <div class="btn-mt button-right">
                    <button class="btn btn-success" id="LoadData" type="button"><i class="fa fa-download"></i> Load Data</button>
                </div>
            </div>
        </div>      
        <div class="card">
            <div class="table-responsive">
                <table id="tblVehicleGatepassEntry" class="table-width">
                    <thead class="table-head">
                        <tr>
                            <th style="display:none;">Code</th>
                            <th>
                                <input type="checkbox" id="chkAll" />
                            </th>
                            <th>Gate No</th>
                            <th>Gate Date</th>
                            <th>Wb No</th>
                            <th>Wb Date</th>
                            <th>Wb Type</th>
                            <th>Party Name</th>
                            <th>Vehicle No</th>
                            <th>Bill No</th>
                            <th>Wb Qty</th>
                            <th>Final Remarks</th>
                            <th>Out Allowed</th>
                            <th>Wb Slip</th>
                            <th>Gate Out</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</fieldset>

<script>
    $(document).ready(function () {
        const today = new Date();
        const yyyy = today.getFullYear();
        const mm = String(today.getMonth() + 1).padStart(2, '0');
        const dd = String(today.getDate()).padStart(2, '0');
        const formattedDate = `${yyyy}-${mm}-${dd}`;

        $('#DtFrom').val(formattedDate);
        $('#DtTo').val(formattedDate);
        ddlVehicleNo();

        $("#LoadData").on("click", async function () {
            const FromDate = $("#DtFrom").val();
            const ToDate = $("#DtTo").val();
            const WbType = $("#ddlWBType").val();
            const VehicleNo = $("#ddlTxtVehicleNo").val();
            await loadPendingDocuments(FromDate, ToDate, WbType, VehicleNo);
        });

    });

    // Load Vehicle Dropdown
    async function ddlVehicleNo() {
        try {
            const response = await fetch('/VehicleGatepassEntry/ddlVehicleNo');
            const data = await response.json();

            const ddl = $('#ddlTxtVehicleNo');
            ddl.empty();
            ddl.append('<option value="">Select Vehicle</option>');

            data.forEach(item => {
                ddl.append(`<option value="${item.value}">${item.text}</option>`);
            });

            ddl.select2({
                placeholder: 'Select Vehicle',
                allowClear: true,
                width: '100%'
            });

        } catch (err) {
            console.error(err);
        }
    }

    // Load Table Data
    function loadPendingDocuments(FromDate, ToDate, WbType, VehicleNo) {

        $.ajax({
            url: '/VehicleGatepassEntry/Getdata',
            type: 'GET',
            data: { FromDate, ToDate, WbType, VehicleNo },
            success: function (data) {
                console.log('page load', data)

                let tbody = $('#tblVehicleGatepassEntry tbody');
                tbody.empty();

                if (data.length === 0) {
                    tbody.append('<tr><td colspan="14">No Data Found</td></tr>');
                    return;
                }
                $.each(data, function (i, item) {

                    let row = `<tr>
                        <td><input type="checkbox" class="row-check" /></td>
                        <td>${item.gateNo}</td>
                        <td>${formatDate(item.gateDate)}</td>
                        <td>${item.wbNo}</td>
                        <td>${formatDate(item.wbDate)}</td>
                        <td>${item.wbType}</td>
                        <td>${item.partyName}</td>
                        <td>${item.vehicleNo}</td>
                        <td>${item.billNo}</td>
                        <td>${item.wbQty}</td>
                        <td>${item.finalRemarks}</td>
                        <td>${item.outAllowed}</td>
                        <td>${item.partY_WBSLIPNO}</td>
                        <td>${item.gateOut}</td>
                    </tr>`;

                    tbody.append(row);
                });
            }
        });
    }
    // Checkbox change event (MAIN LOGIC)
    $(document).on('change', '.row-check', function () {

        const checkbox = $(this);
        const row = checkbox.closest('tr');
        const cells = row.find('td');

        const rowData = {
            GateNo: cells.eq(1).text().trim(),
            WbNo: cells.eq(3).text().trim(),
            WbType: cells.eq(5).text().trim(),
            GateOut: cells.eq(13).text().trim() // IMPORTANT COLUMN
        };

        // ✅ Check if already OUT
        if (rowData.GateOut && rowData.GateOut.toLowerCase() === 'yes') {

            Swal.fire({
                icon: 'error',
                title: 'Vehicle already out',
                text: 'This vehicle is already marked as OUT.'
            });

            checkbox.prop('checked', false); // uncheck again
            return;
        }

        //  Ask confirmation
        Swal.fire({
            title: 'Are you sure?',
            text: "Do you want to mark this vehicle as OUT?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes',
            cancelButtonText: 'No',
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33'
        }).then((result) => {

            if (result.isConfirmed) {

                //  Send to server
                sendRowToServer(rowData);

            } else {
                // ❌ If NO → uncheck again
                checkbox.prop('checked', false);
            }
        });

    });

    function sendRowToServer(rowData) {
        $.ajax({
            url: '/VehicleGatepassEntry/SaveSingleRow',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(rowData),

            success: async function (res) {
                console.log("Saved:", res);

                // Show Toastr message
                if (res.success) {
                    toastr.success(res.message || "Saved successfully");
                } else {
                    toastr.error(res.message || "Something went wrong");
                }
                // Reload data
                const FromDate = $("#DtFrom").val();
                const ToDate = $("#DtTo").val();
                const WbType = $("#ddlWBType").val();
                const VehicleNo = $("#ddlTxtVehicleNo").val();

                await loadPendingDocuments(FromDate, ToDate, WbType, VehicleNo);
            },

            error: function (err) {
                console.log(err);
                toastr.error("Server error occurred");
            }
        });
    }

    // Date Format
    function formatDate(dateStr) {
        if (!dateStr) return '';
        const d = new Date(dateStr);
        return isNaN(d) ? '' : d.toISOString().split('T')[0];
    }
</script>
