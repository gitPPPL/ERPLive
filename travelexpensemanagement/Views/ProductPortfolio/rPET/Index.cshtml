                <div class="row">
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
                        <div class="card">
                            <!-- FULL COVER IMAGE -->
                            <div class="product-image">
                                <img src="~/ProductPortfolio/images/rpetgranuels1.jpg" alt="rPET Granules">
                            </div>
                            <!-- PADDED CONTENT -->
                            <div class="content">
                                <!-- Flex container for title and watermark -->
