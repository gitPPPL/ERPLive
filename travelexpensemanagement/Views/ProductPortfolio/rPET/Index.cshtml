                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- rMASTER BATCHES -->
        <div class="tab-pane fade" id="masterbatches">
            @* rMaster batches *@
            <h2 class="sub-heading">rPET Masterbatches</h2>
            <section class="main_section">
                <div class="row">
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
                        <div class="card">
                            <div class="product-image">
                                <img src="https://pashupatigrp.com/frontend/images/rpet-black-p1.png" alt="rPET Masterbatches">
                            </div>
                            <div class="content">
                                <div class="content-inner">
                                    <div class="title-container">
                                        <div class="title">rPET Masterbatches <span class="b2b-text">(Black)</span></div>
                                    </div>
                                </div>
                                <a href="#" class="btn-tds" data-bs-toggle="modal" data-bs-target="#B2BpopupModal"
                                   data-image="/ProductPortfolio/images/rpetgranuels10tds.JPG"
                                   data-title="rPET Masterbatches (Black)">TDS</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
                        <div class="card">
                            <div class="product-image">
                                <img src="https://pashupatigrp.com/frontend/images/pp-filler-p1.jpg" alt="rPET Masterbatches">
                            </div>
                            <div class="content">
                                <div class="content-inner">
                                    <div class="title-container">
                                        <div class="title">rPET Masterbatches <span class="b2b-text">(White)</span></div>
                                    </div>
                                </div>
