@{
    ViewBag.Title = "rPET";
    Layout = "~/Views/Shared/ProductPortfolioLayout.cshtml";
}

<section class="container-fluid">
    <!-- Heading -->
    <div class="row">
        <div class="offset-md-9 col-md-3 text-md-end text-center">
            <div class="button-right">
                <button onclick="window.location.href='@Url.Action("Index", "Home")'"
                        type="button"
                        class="btn-back">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span class="d-none d-md-inline"> Back To Page</span>
                </button>
            </div>
        </div>
    </div>

    <div class="section-heading">
        <h1 class="main-heading">rPET</h1>
        <span class="heading-line"></span>
    </div>

    <div class="row">
        <div class="col-12">
            <ul class="nav nav-tabs justify-content-center product-tabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#granules">
                        <i class="fa-solid fa-cubes"></i>
                        <span>rPET Granules</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#flakes">
                        <i class="fa-solid fa-layer-group"></i>
                        <span>rPET Flakes</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#masterbatches">
                        <i class="fa-solid fa-industry"></i>
                        <span>rPET Masterbatches</span>
                    </button>
                </li>

            </ul>
        </div>
    </div>

    <div class="tab-content">
        <!-- rPET GRANULES -->
        <div class="tab-pane fade show active" id="granules">
            @* rPet Granuels *@
            <h2 class="sub-heading">rPET Granules</h2>
