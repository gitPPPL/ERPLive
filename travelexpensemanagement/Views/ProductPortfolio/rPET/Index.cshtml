                                   data-title="rPET Granules Film (Food Grade)">TDS</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
                        <div class="card">
                            <div class="product-image">
                                <img src="~/ProductPortfolio/images/rpetgranuels3.jpg" alt="rPET Granules">
                            </div>
                            <div class="content">
                                <div class="content-inner">
                                    <div class="title-container">
                                        <div class="title">rPET Granules <span class="b2b-text">Textiles</span></div>
                                    </div>
                                </div>
                                <a href="#" class="btn-tds" data-bs-toggle="modal" data-bs-target="#B2BpopupModal"
                                   data-image="/ProductPortfolio/images/rpetgranuels3tds.JPG"
                                   data-title="rPET Granules Textiles (Non-Food Grade)">TDS</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
                        <div class="card">
                            <div class="product-image">
                                <img src="https://pashupatigrp.com/images/rpsf11.jpg" alt="rPET Granules">
                            </div>
                            <div class="content">
                                <div class="content-inner">
                                    <div class="title-container">
                                        <div class="title">rPET Granules <span class="b2b-text">Semi Dull</span></div>
                                    </div>
                                </div>
                                <a href="#" class="btn-tds" data-bs-toggle="modal" data-bs-target="#B2BpopupModal"
