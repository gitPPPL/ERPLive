                                    <div class="title-container">
                                        <div class="title">rPET Granules <span class="b2b-text">B2B</span></div>
                                    </div>
                                    <div class="watermark-container">
                                        <img src="~/ProductPortfolio/images/foodgrade.jpg" alt="Logo" class="watermark-logo">
                                    </div>
                                </div>
                                <a href="#" class="btn-tds" data-bs-toggle="modal" data-bs-target="#B2BpopupModal"
                                   data-image="/ProductPortfolio/images/rpetgranuels1tds.JPG"
                                   data-title="rPET Granules B2B (Food Grade)">TDS</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
                        <div class="card">
                            <div class="product-image">
                                <img src="~/ProductPortfolio/images/rpetgranuels2.jpg" alt="rPET Granules">
                            </div>
                            <div class="content">
                                <div class="content-inner">
                                    <div class="title-container">
                                        <div class="title">rPET Granules <span class="b2b-text">Thermoforming</span></div>
                                    </div>
                                    <div class="watermark-container">
                                        <img src="~/ProductPortfolio/images/foodgrade.jpg" alt="Logo" class="watermark-logo">
                                    </div>
                                </div>
                                <a href="#" class="btn-tds" data-bs-toggle="modal" data-bs-target="#B2BpopupModal"
                                   data-image="/ProductPortfolio/images/rpetgranuels2tds.JPG"
                                   data-title="rPET Granules Thermoforming (Food Grade)">TDS</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
                        <div class="card">
                            <div class="product-image">
                                <img src="~/ProductPortfolio/images/rpetgranuels3.jpg" alt="rPET Granules">
                            </div>
                            <div class="content">
                                <div class="content-inner">
                                    <div class="title-container">
                                        <div class="title">rPET Granules <span class="b2b-text">Film</span></div>
                                    </div>
                                    <div class="watermark-container">
                                        <img src="~/ProductPortfolio/images/foodgrade.jpg" alt="Logo" class="watermark-logo">
                                    </div>
                                </div>
                                <a href="#" class="btn-tds" data-bs-toggle="modal" data-bs-target="#B2BpopupModal"
