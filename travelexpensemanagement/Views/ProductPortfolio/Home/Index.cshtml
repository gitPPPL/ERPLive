@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/ProductPortfolioLayout.cshtml";
}

<!-- MAIN CONTENT -->
<section class="container-fluid">
    <!-- Heading -->
    <div class="section-heading">
        <h1 class="main-heading">Pashupati's Product Range</h1>
        <span class="heading-line"></span>
    </div>

   

    <!-- Cards Row -->
    <div class="row">
        <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
            <div class="card">
                <div class="product-image">
                    <img src="https://pashupatigrp.com/frontend/images/rpet-banner-new.png" alt="rPET Granules">
                </div>
                <div class="content">
                    @* <div class="category">Pashupati's Product</div> *@
                    <div class="main_title">rPET</div>
                    <a href="@Url.Action("Index", "rPET")" class="know-btn">Know More About rPET<i class="fa-solid fa-arrow-right"></i></a>
                </div>

            </div>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
            <div class="card">
                <div class="product-image">
                    <img src="https://pashupatigrp.com/images/rpolyolefin.png" alt="rPET Granules">
                </div>
                <div class="content">
                    @* <div class="category">Pashupati's Product</div> *@
                    <div class="main_title">rPolyolefin</div>
                    <a href="@Url.Action("Index", "rPolyolefin")" class="know-btn">Know More About rPolyolefin <i class="fa-solid fa-arrow-right"></i></a>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
            <div class="card">
                <div class="product-image">
                    <img src="https://pashupatigrp.com/frontend/images/fiver-banner-new.png" alt="rPET Granules">
                </div>
                <div class="content">
                    @* <div class="category">Pashupati's Product</div> *@
                    <div class="main_title">Fibre</div>
                    <a href="@Url.Action("Index", "Fibre")" class="know-btn">Know More About Fibre<i class="fa-solid fa-arrow-right"></i></a>
                </div>

            </div>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-3">
            <div class="card">
                <!-- FULL COVER IMAGE -->
                <div class="product-image">
                    <img src="https://pashupatigrp.com/frontend/images/packaging-banner.png" alt="rPET Granules">
                </div>
                <!-- PADDED CONTENT -->
                <div class="content">
                    @* <div class="category">Pashupati's Product</div> *@
                    <div class="main_title">Packaging</div>
                    <a href="@Url.Action("Index", "Packaging")" class="know-btn">Know More About Packaging<i class="fa-solid fa-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>


   
</section>

<script src="~/js/portfoliopinsession.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        if (!isPinSessionValid()) {
            window.location.href = "/HomeLogin/Index";
        }
    });
    
  

</script>
