<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
        let leaveChartInstance = null;
        let selectedRowData = null;

            /* ===================== DOCUMENT READY ===================== */
        $(document).ready(async function () {
            try {
                Cheack();
                await loadEmployeeDetails();
                await loadLeaveChart();
            } catch (err) {           
               toas.error("Failed to load dashboard data. Please try again later.");
            }

            $('#btn_LeaveHistory').on('click', function () {

                    const input = document.getElementById("Fltr_date");

                    let now = new Date();

                    // Current month
                    let currentYear = now.getFullYear();
                    let currentMonth = String(now.getMonth() + 1).padStart(2, '0');

                    input.value = `${currentYear}-${currentMonth}`;
                    input.max = `${currentYear}-${currentMonth}`;

                    // 3 months back
                    let minDate = new Date();
                    minDate.setMonth(minDate.getMonth() - 3);

                    let minYear = minDate.getFullYear();
                    let minMonth = String(minDate.getMonth() + 1).padStart(2, '0');

                    input.min = `${minYear}-${minMonth}`;

                    fetchLeaveHistory();

                });
    
            $('#btnRequestModal').on('click', async function () {
            try {
                const res = await $.ajax({
                    url: '/EmployeeDashboard/GetLeaveBalances',
                    type: 'GET'
                });

                if (!res.success || !res.data) return;

                $('#LblCL').text(res.data.clBal);
                $('#LblEL').text(res.data.elBal);

            }
            catch (error) {

                toastr.error("Error", error);
            }
        });

            $(document).on("change", ".from-date, .to-date", function () {

            const row = $(this).closest("tr");

            const fromVal = row.find(".from-date").val();
            const toVal = row.find(".to-date").val();

            if (fromVal && toVal) {

                const from = new Date(fromVal);
                const to = new Date(toVal);

                let days = Math.floor((to - from) / (1000 * 60 * 60 * 24)) + 1;

                if (days < 0) days = 0;

                row.find(".days").val(days);
            }

        });
         
            $('#Fltr_date').on('change', function(){
              fetchLeaveHistory();
            });

           document.addEventListener("click", function (e) {
                  const dropdown = document.querySelector(".emp-leave-dropdown");
                if (!dropdown.contains(e.target)) {
                 document.getElementById("empLeaveMenu").classList.remove("emp-show");
                }
            });

        /* ===================== LEAVE TYPE CHANGE ===================== */
            $("#ddlLeaveType").change(async function () {
            let leaveCode = $(this).val();
            if (!leaveCode) return;

            try {
                const res = await $.ajax({
                    url: '/EmployeeDashboard/GetLeaveBalance',
                    type: 'GET',
                    data: { leaveCode: leaveCode }
                });

                if (res.success) {
                    $("#lblCL").text(res.balCL);
                    $("#lblEL").text(res.balEL);

                    let balCL = parseInt(res.balCL) || 0;
                    let balEL = parseInt(res.balEL) || 0;

                    if (balCL === 0 && balEL === 0)
                        $("#btnSubmitRequest").hide();
                    else
                        $("#btnSubmitRequest").show();
                } else {
                    toas.info(res.message);
                    $("#btnSubmitRequest").hide();
                }

            } catch (error) {
              
                toastr.error("Error fetching leave balance:", error)
            }
        });

            $(document).on("change", ".from-date, .to-date", function () {
                const row = $(this).closest("tr");
                const fromVal = row.find(".from-date").val();
                const toVal = row.find(".to-date").val();
                if (fromVal && toVal) {

                    const from = new Date(fromVal);
                    const to = new Date(toVal);
                    
                    if (to < from) {
                        toastr.warning("To Date cannot be earlier than From Date");
                        return;
                    }                  
                    let days = Math.floor((to - from) / (1000 * 60 * 60 * 24)) + 1;
                    row.find(".days").val(days);
                }
            });

            $("#fromDate").on("change", function () {
                let fromVal = $(this).val();

                if (fromVal) {
                    // Restrict To Date selection
                     $("#toDate").attr("min", fromVal);
                    }
                });

            $("#toDate").on("change", function () {
                let fromVal = $("#fromDate").val();
                let toVal = $(this).val();


                if(!fromVal)
                {
                  toastr.warning("First Select From Date.");
                  $('#toDate').val('');
                  return;
                }




                if (fromVal && toVal) {
                    if (new Date(toVal) < new Date(fromVal)) {
                        toastr.warning("To Date cannot be earlier than From Date");
                        $(this).val(""); // reset invalid value
                    }
                }
            });

        /* ===================== SUBMIT REQUEST ===================== */

          $("#SubmitRequest").click(async function (e) {
                e.preventDefault();
                // Gather form values
                let model = {
                    FromDate: $("#fromDate").val(),
                    ToDate: $("#toDate").val(),
                    LeaveType: $("#ddlLeaveType").val(),
                    LeaveTypeName: $("#ddlLeaveType option:selected").text(),
                    Remarks: $("#requestRemarks").val()
                };

                // Check all fields are filled
                if (!model.FromDate || !model.ToDate || !model.LeaveType || !model.Remarks) {
                    toastr.warning("Please fill all fields");
                    return;
                }

                // Parse dates
                const fromDate = new Date(model.FromDate);
                const toDate = new Date(model.ToDate);

                if (toDate < fromDate) {
                    toastr.warning("To Date cannot be before From Date");
                    return;
                }

                // Calculate total leave days
                let totalDays = Math.floor((toDate - fromDate) / (1000 * 60 * 60 * 24)) + 1;

                // Get leave balances (trimmed and parsed to float)
                const elBalance = parseFloat($('#LblEL').text().trim());
                const clBalance = parseFloat($('#LblCL').text().trim());

                // Check against leave type
                const leaveType = parseInt(model.LeaveType);

                if (leaveType === 1 && totalDays > elBalance) {
                    toastr.info("You have only " + elBalance + " Earned Leave");
                    return;
                }

                if (leaveType === 2 && totalDays > clBalance) {
                    toastr.info("You have only " + clBalance + " Casual Leave");
                    return;
                }

                // Submit the leave request
                try {
                    const res = await $.ajax({
                        url: '/EmployeeDashboard/SubmitLeaveRequest',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(model)
                    });

                    if (res.success === true) {
                        toastr.success("Leave Request submitted successfully!");

                        // Close modal after short delay
                        await new Promise(resolve => setTimeout(resolve, 1500));
                        const modalElement = document.getElementById('requestLeaveModal');
                        const modalInstance = bootstrap.Modal.getOrCreateInstance(modalElement);
                        modalInstance.hide();

                        // Clear form
                        $('#requestLeaveModal').find('input, textarea, select').val('');

                        await loadLeaveChart();
                    } else {
                        toastr.error(res.message);
                    }

                } catch (error) {
                    toastr.error("Server error");       
                 
                }
            });

        });

        /* ===================== DROPDOWN ===================== */

        async function Cheack()
            {
                try{
                    const res = await $.ajax({
                        url: '/EmpAttendance/CheackParentId',
                        type: 'GET'
                    });

                    if (res.success == true)
                    {
                      $('#btn_leaveapply').show();
                    }
                    else
                    {
                      $('#btn_leaveapply').hide();
                    }
            
                }
                catch(ex){
                    toastr.error(ex.message);
                }
            }

        function toggleLeaveDropdown() {
            document.getElementById("empLeaveMenu").classList.toggle("emp-show");
        }

        document.addEventListener("click", function (e) {
            const dropdown = document.querySelector(".emp-leave-dropdown");
            if (dropdown && !dropdown.contains(e.target)) {
                document.getElementById("empLeaveMenu")?.classList.remove("emp-show");
            }
        });

        function toggleLeaveDropdown() {
            document.getElementById("empLeaveMenu").classList.toggle("emp-show");
        }

        /* ===================== LOAD EMPLOYEE DETAILS ===================== */
        async function loadEmployeeDetails() {
            try {
                const response = await $.ajax({
                    url: '/EmployeeDashboard/EmployeeDetails',
                    type: 'GET',
                    dataType: 'json'
                });

                if (response?.employee) {
                    const emp = response.employee;
                    // sessionStorage.setItem("EmpCode", emp.code);
                    $("#lbl_EmpID").text(emp.code);
                    $("#lbl_EmpNameTop").text(emp.fullName);
                    $("#lblEmpName").text(emp.fullName);
                    $("#lblempDesignation").html("<strong>Designation:</strong> " + emp.designationName);
                    $("#lblEmpdept").text(emp.departmentName);

                    if (emp.email?.trim()) {
                        $("#lblEmail").html(`<a href="mailto:${emp.email}">${emp.email}</a>`);
                    } else {
                        $("#lblEmail").text("Not Available");
                    }

                    if (emp.dob) {
                        const dobDate = new Date(emp.dob);
                        $("#dobContent").html(`
                            <p><strong>${emp.fullName}</strong></p>
                            <p>${formatDate(dobDate, false)}</p>
                            <p>Happy Birthday! 🎉</p>
                        `);
                        $("#dobCard").show();
                    }

                    if (emp.dom) {
                        const domDate = new Date(emp.dom);
                        $("#domContent").html(`
                            <p><strong>${emp.fullName}</strong></p>
                            <p>${formatDate(domDate, true)}</p>
                            <p>Happy Work Anniversary! 🎊</p>
                        `);
                        $("#domCard").show();
                    }
                }

                if (response?.holidays?.length > 0) {
                    loadUpcomingHoliday(response.holidays);
                } else {
                    $("#dHoliday").html("<p>No holidays found</p>");
                }

            } catch (error) {         
                toa.error("Unable to load employee details:", error);
            }
        }

        /* ===================== FORMAT DATE ===================== */
        function formatDate(date, showYear) {
            return date.toLocaleDateString('en-IN', {
                day: 'numeric',
                month: 'long',
                year: showYear ? 'numeric' : undefined
            });
        }

        /* ===================== LOAD HOLIDAYS ===================== */
        function loadUpcomingHoliday(holidays) {

            const today = new Date();
            today.setHours(0, 0, 0, 0);

            const upcoming = holidays
                .map(h => ({
                    name: h.name,
                    date: new Date(h.holidayDate)
                }))
                .filter(h => h.date >= today)
                .sort((a, b) => a.date - b.date);

            if (upcoming.length === 0) {
                $("#dHoliday").html("<p>No upcoming holidays</p>");
                return;
            }

            let html = "<ul class='list-unstyled'>";
            upcoming.forEach(h => {
                html += `
                    <li>
                        <strong>${h.name}</strong><br/>
                        <small>${formatDate(h.date, true)}</small>
                    </li>
                    <hr/>
                `;
            });
            html += "</ul>";

            $("#dHoliday").html(html);
        }

        /* ===================== LOAD LEAVE CHART ===================== */
     async function loadLeaveChart() {
            try {
                const res = await $.ajax({
                    url: '/EmployeeDashboard/GetLeaveBalances',
                    type: 'GET'
                });

                if (!res.success || !res.data) return;

                drawLeaveChart(
                    res.data.elBal,
                    res.data.clBal,
                    res.data.elApplied,
                    res.data.clApplied
                );

            } catch (error) {
             
                toastr.error("Error loading leave chart:", error);
            }
        }

        /* ===================== DRAW CHART ===================== */
    function drawLeaveChart(elBal, clBal, elApplied, clApplied) {

            elBal = Math.max(0, elBal);
            clBal = Math.max(0, clBal);
            elApplied = Math.max(0, elApplied);
            clApplied = Math.max(0, clApplied);

            const totalel = elBal + elApplied;
            const totalcl = clBal + clApplied;

            const ctx = document.getElementById('leaveChart');

            if (leaveChartInstance)
                leaveChartInstance.destroy();

            leaveChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: [
                        'Casual Leave (' + totalcl + ')',
                        'Earned Leave (' + totalel + ')'
                    ],
                    datasets: [
                        {
                            label: 'Applied Leave',
                            data: [clApplied, elApplied],
                            backgroundColor: '#EF5350',
                            stack: 'leave'
                        },
                        {
                            label: 'Remaining Balance',
                            data: [clBal, elBal],
                            backgroundColor: '#66BB6A',
                            stack: 'leave'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { stacked: true },
                        y: {
                            stacked: true,
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });
        }

    async function fetchLeaveHistory() {
            try {
                
               const selecteddate  = $('#Fltr_date').val();

                const res = await $.ajax({
                    url: '/EmployeeDashboard/GetLeaveHistoryData',
                    data : {selecteddate : selecteddate},
                    type: 'GET'
                });

                const data = res.data || [];  
                $(".emp-history-table tbody").empty();

                data.forEach((item, index) => {
                    addRow({ ...item, index });
                });

            } catch (error) {        
                toastr.error("Error fetching leave history:", error);
            }
        }

    function addRow(data = {}) {

        const leaveTypeClass = getLeaveTypeClass(data.leaveType);
        const statusClass = getStatusClass(data.status);

        data.index = data.index !== undefined ? data.index : rowIndex++;

        let days = "";

        if (data.fromDate && data.toDate) {
            const from = new Date(data.fromDate);
            const to = new Date(data.toDate);
            days = Math.floor((to - from) / (1000 * 60 * 60 * 24)) + 1;
        }

        const row = `
            <tr data-row="${data.index}">

                <td style="display:none;">
                    <input type="text"
                           class="form-control"
                           style="width:120px"
                           id="DocID_${data.index}"
                           value="${data.doC_ID}"
                           readonly>
                </td>

                <td>
                    <input type="date"
                           class="form-control from-date"
                           id="from_${data.index}"
                           value="${data.fromDate || ''}"
                           readonly>
                </td>

                <td>
                    <input type="date"
                           class="form-control to-date"
                           id="to_${data.index}"
                           value="${data.toDate || ''}"
                           readonly>
                </td>

                <td>
                    <select class="form-control leave-type-badge ${leaveTypeClass}"
                            id="type_${data.index}"
                            style="width:120px"
                            readonly>
                        <option value="">Select Leave</option>
                        <option value="Earned Leave" ${data.leaveType === 'Earned Leave' ? 'selected' : ''}>Earned Leave</option>
                        <option value="Casual Leave" ${data.leaveType === 'Casual Leave' ? 'selected' : ''}>Casual Leave</option>
                        <option value="Earn Leave" ${data.leaveType === 'Earn Leave' ? 'selected' : ''}>Earn Leave</option>
                        <option value="Leave Without Pay" ${data.leaveType === 'Leave Without Pay' ? 'selected' : ''}>Leave Without Pay</option>
                    </select>
                </td>

                <td>
                    <input type="number"
                           class="form-control days leave-days"
                           style="width:40px"
                           id="days_${data.index}"
                           value="${days}"
                           readonly>
                </td>

                <td>
                    <input type="text"
                           class="leave-status-badge ${statusClass}"
                           style="width:120px"
                           id="status_${data.index}"
                           value="${data.status || 'Pending'}"
                           readonly>
                </td>

                <td>
                    <i class="fa fa-edit btn-edit"
                       title="Edit Leave"
                       style="cursor:pointer;color:#28a745;"
                       onclick="editRow(${data.index}, this)">
                    </i>

                    <i class="fa fa-save btn-save"
                       title="Save Leave Request"
                       style="cursor:pointer;color:#0e253c;"
                       onclick="updateLeave(${data.index}, this)">
                    </i>
                </td>

            </tr>
        `;

        $(".emp-history-table tbody").append(row);
    }

    function editRow(index, el) {
        const row = $(el).closest("tr");

        // Enable only specific fields
        row.find(`#from_${index}`).prop("readonly", false);
        row.find(`#to_${index}`).prop("readonly", false);
        row.find(`#status_${index}`).prop("readonly", false);

        // Optional: add visual highlight
        row.addClass("editing-row");
    }

    async function updateLeave(index, el) {
            try {

                const res = await $.ajax({
                    url: '/EmployeeDashboard/GetLeaveBalances',
                    type: 'GET'
                });
                
                if (!res.success || !res.data) return;
                clBal1 = res.data.clBal;
                elBal1 =  res.data.elBal ;

                const row = $(el).closest("tr");

                const rowData = {
                    index: index,
                    DocID: row.find("#DocID_" + index).val(),
                    fromDate: row.find("#from_" + index).val(),
                    toDate: row.find("#to_" + index).val(),
                    leaveType: row.find("#type_" + index).val(),
                    days: row.find("#days_" + index).val(),
                    status: row.find("#status_" + index).val()
                };

                if (rowData.status === 'Approved') {
                    toastr.warning("Your leave has already been approved. No further changes are allowed.");
                    return;
                }

                if (rowData.leaveType === 'Earned Leave') {
                    if (rowData.days > elBal1) {
                        toastr.warning("Leave days cannot be greater than the available Earned Leave balance (" + elBal1 + ").");
                        return;
                    }
                }

                else if (rowData.leaveType === 'Casual Leave') {
                    if (rowData.days > clBal1) {
                        toastr.warning("Leave days cannot be greater than the available Casual Leave balance (" + clBal1 + ").");
                        return;
                    }
                }

                $.ajax({
                    url: "/EmployeeDashboard/UpdateLeave",
                    type: "POST",
                    data: rowData,
                    success: function (res) {
                        toastr.success("Leave update Succesfull")
                    },
                    error: function (err) {
              
                        toastr.error("Error", err);
                    }
                });

            }
            catch (error) {
                toastr.error("Error", err);
            }
        }

    function getLeaveTypeClass(leaveType) {
        switch(leaveType) {
            case 'Earned Leave':
                return 'leavehistory-earned'; 
            case 'Casual Leave':
                return 'leavehistory-casual';
            case 'Earn Leave':
                return 'leavehistory-earn'; 
            case 'Leave Without Pay':
                return 'leavehistory-lwp'; 
            default:
                return ''; 
        }
    }

    function getStatusClass(status) {
        switch(status) {
            case 'Pending':
                return 'leavehistory-pending'; 
            case 'Approved':
                return 'leavehistory-approved';
            case 'Rejected':
                return 'leavehistory-rejected'; 
            default:
                return 'leavehistory-default'; 
        }
    }

</script>







