@{
    ViewBag.Title = "Manage Leave";
    Layout = "~/Views/Shared/EmployeeLayout.cshtml";
}

<style>
    /* ====================== Buttons ====================== */
    .manageleave-back-btn {
        background-color: #0e243a;
        color: #cbd5e1;
        padding: 4px 16px;
        border: none;
        cursor: pointer;
        border-radius: 4px;
        font-size: 14px;
    }

        .manageleave-back-btn:hover {
            background-color: #45a049;
            color: white;
        }

        .manageleave-back-btn i {
            margin-right: 10px;
        }

    .manageleave-save-btn {
        background-color: #d2ffde;
        color: #318346;
        padding: 4px 6px;
        border: 1px solid #93c7a1;
        border-radius: 50px;
        font-size: 13px;
        margin-right: 5px;
    }

        .manageleave-save-btn:hover {
            background-color: #318346;
            color: #fff;
            border: 1px solid #318346;
        }

    .manageleave-delete-btn {
        background-color: #ffdee1;
        color: #dc3545;
        padding: 4px 8px;
        border: 1px solid #dc3545;
        border-radius: 50px;
        font-size: 13px;
    }

        .manageleave-delete-btn:hover {
            background-color: #dc3545;
            color: #fff;
            border: 1px solid #dc3545;
        }

    /* ====================== Wrapper ====================== */


    .manageleave-card {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 6px 20px rgb(0 0 0 / 16%);
    }

    /* ====================== Header ====================== */
    .manageleave-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .manageleave-title {
        font-size: 20px;
        font-weight: 600;
        color: #0e243a;
    }

    /* ====================== Search ====================== */
    .manageleave-search {
        position: relative;
    }

        .manageleave-search i {
            position: absolute;
            top: 50%;
            left: 8px;
            transform: translateY(-50%);
            color: #888;
            font-size: 14px;
        }

        .manageleave-search input {
            padding: 2px 10px 2px 28px;
            width: 250px;
            border-radius: 6px;
            border: 1px solid #ccc;
            font-size: 14px;
        }

    /* ====================== Table ====================== */


    .timesheettasklist-table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border-radius: 4px;
        overflow: hidden;
    }

        .timesheettasklist-table th {
            padding: 8px 14px;
            text-align: left;
            border-bottom: 1px solid #0e243a;
            font-size: 14px;
        }

        .timesheettasklist-table td {
            padding: 6px 10px;
            text-align: left;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }

        .timesheettasklist-table th {
            background: #cfcfcf;
            color: #0e243a;
            font-weight: 600;
        }

        .timesheettasklist-table tr:hover {
            background: #f9fbff;
        }


    /* ====================== Status Dropdown ====================== */
    .manageleave-status-select {
        padding: 4px 6px;
        border-radius: 6px;
        border: 1px solid #ccc;
    }

    /* ====================== Pagination ====================== */
    .manageleave-pagination {
        margin-top: 10px;
        display: flex;
        gap: 5px;
    }

        .manageleave-pagination button {
            padding: 4px 8px;
            border-radius: 4px;
            border: 1px solid #ccc;
            cursor: pointer;
        }

            .manageleave-pagination button.active {
                background-color: #1f4e79;
                color: white;
                border: 1px solid #1f4e79;
            }

    .emp-bar {
        background: #ffffff;
        padding: 6px 20px;
        border-radius: 8px;
        margin-bottom: 16px;
        box-shadow: 0 6px 9px rgb(0 0 0 / 16%);
        border: 1px solid #d7d7d7;
    }

    .emp-main-title {
        display: flex;
        align-items: center;
        gap: clamp(6px, 1.5vw, 10px);
        font-weight: 600;
        font-size: clamp(13px, 2vw, 16px);
        color: #1f4e79;
    }

        .emp-main-title i {
            color: #fff;
            padding: 6px;
            border-radius: 8px;
            font-size: 12px;
            background: #318346;
        }
</style>
<div class="emp-bar">
    <div class="emp-main-title">
        <i class="fa-solid fa-file-signature"></i>
        <span>Employee Manage Leave</span>
    </div>
</div>
<div class="manageleave-wrapper">
    <div class="manageleave-card">

        <div class="manageleave-header">
            <div class="manageleave-search">
                <i class="fa fa-search"></i>
                <input type="text" id="searchInput" placeholder="Search employees..." />
            </div>
            <button onclick="window.location.href='@Url.Action("Index", "EmployeeDashboard")'" class="manageleave-back-btn">
                <i class="fa fa-arrow-left"></i>Back
            </button>
        </div>

        <div class="table-responsive">
            <table class="timesheettasklist-table">
                <thead>
                    <tr>
                        <th>Employee Name</th>
                        <th>From Date</th>
                        <th>To Date</th>
                        <th>Leave Type</th>
                        <th>Remarks</th>
                        <th>Status</th>
                        <th style="text-align:center;">Action</th>
                    </tr>
                </thead>
                <tbody id="tableManageLeaveBody"></tbody>
            </table>

            <div class="manageleave-pagination" id="pagination"></div>
        </div>


    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    let currentPage = 1;
    const rowsPerPage = 10;
    let totalCount = 0;
    let currentSearch = "";

    function loadManageLeaveData() {
        fetch(`/EmpLeaveApprovalList/GetList?searchTerm=${encodeURIComponent(currentSearch)}&pageNumber=${currentPage}&pageSize=${rowsPerPage}`)
            .then(response => response.json())
            .then(result => {
                if(result.success){
                  console.log("RESULT", result);
                    totalCount = result.totalCount;
                    displayTable(result.lists);
                    setupPagination();
                } else {
                    console.error(result.message);
                }
            })
            .catch(error => console.error("Error:", error));
    }

    function displayTable(data){
        const tbody = document.getElementById("tableManageLeaveBody");
        tbody.innerHTML = "";

        if(!data || data.length === 0){
            tbody.innerHTML = `<tr>
                <td colspan="7" style="text-align:center;">No records found</td>
            </tr>`;
            return;
        }

        data.forEach(item => {

            const fromDate = item.from_date ? new Date(item.from_date).toLocaleDateString() : "";
            const toDate = item.to_date ? new Date(item.to_date).toLocaleDateString() : "";

            tbody.innerHTML += `
            <tr>
                <td>${item.useR_NAME || ""}</td>
                <td>${formatDate(fromDate)}</td>
                <td>${formatDate(toDate)}</td>
                <td>${item.leave_type || ""}</td>
                <td>${item.faprov_remarks || ""}</td>
                <td>
                    <select class="manageleave-status-select">
                        <option value="Pending" ${item.faprov_status==="Pending"?"selected":""}>Pending</option>
                        <option value="Approved" ${item.faprov_status==="Approved"?"selected":""}>Approved</option>
                        <option value="Rejected" ${item.faprov_status==="Rejected"?"selected":""}>Rejected</option>
                    </select>
                </td>
                <td style="text-align:center;">
                    <button class="manageleave-save-btn" onclick="saveLeave('${item.doC_ID}', this)">
                      <i class="fa fa-save"></i>
                    </button>
                    <button class="manageleave-delete-btn" onclick="deleteLeave('${item.doC_ID}')">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>
            </tr>
            `;
        });
    }

    function setupPagination(){
        const pageCount = Math.ceil(totalCount / rowsPerPage);
        const pagination = document.getElementById("pagination");
        pagination.innerHTML = "";

        if(pageCount <=1) return;

        for(let i=1; i<=pageCount; i++){
            pagination.innerHTML += `<button onclick="changePage(${i})" class="${i===currentPage?'active':''}">${i}</button>`;
        }
    }

    function changePage(page){
        currentPage = page;
        loadManageLeaveData();
    }

    document.getElementById("searchInput").addEventListener("keyup", function(){
        currentSearch = this.value;
        currentPage = 1;
        loadManageLeaveData();
    });

    // Save leave status
    function saveLeave(docId,btn){

        const row = btn.closest("tr");

        const status = row.querySelector(".manageleave-status-select").value;

        console.log("DOC ID:",docId);
        console.log("STATUS:",status);

        fetch('/EmpLeaveApprovalList/UPDATEDATA',{

            method:'POST',
            headers:{
                'Content-Type':'application/json'
            },

            body:JSON.stringify({

                docId:docId,
                status:status

            })

        })
        .then(res=>res.json())
        .then(result=>{

            if(result.success){

                Swal.fire("Success","Leave Updated","success");
                loadManageLeaveData();

            }else{

                Swal.fire("Error",result.message,"error");

            }

        });

    }
    // Delete leave
     function deleteLeave(docId){

        Swal.fire({
            title: "Delete Leave?",
            text: "Are you sure you want to delete this leave request?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#318346",
            cancelButtonColor: "#dc3545",
            confirmButtonText: "Yes, Delete it!",
            cancelButtonText: "Cancel",
            reverseButtons: true
        })
        .then((result)=>{

            if(result.isConfirmed){

                fetch('/EmpLeaveApprovalList/DELETEROW',{

                    method:'POST',

                    headers:{
                        'Content-Type':'application/json'
                    },

                    body: JSON.stringify({
                        docId: docId
                    })

                })
                .then(res => res.json())
                .then(result => {

                    if(result.success){

                        Swal.fire("Deleted!","Leave request deleted.","success");

                        loadManageLeaveData();

                    }
                    else{

                        Swal.fire("Error!",result.message,"error");

                    }

                })
                .catch(error => console.error(error));

            }

        });
    }

    document.addEventListener("DOMContentLoaded", function(){
        loadManageLeaveData();
    });


        function formatDate(dateStr) {
            if (!dateStr) return null;
            const date = new Date(dateStr);
            if (isNaN(date)) return null;
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            
            return `${day}-${month}-${year}`;
        }




</script>