    function loadAttendanceDetails(month) {
        $.ajax({
            url: '/EmpAttendance/GetAttendanceDetails',
            type: 'GET',
            data: { month: month },

            success: function (res) {

                console.log("Attendance Data:", res);

                const calendarBody = $("#calendarBody");
                calendarBody.empty();

                let [year, monthIndex] = month.split("-");
                year = parseInt(year);
                monthIndex = parseInt(monthIndex) - 1;

                let firstDay = new Date(year, monthIndex, 1);
                let lastDate = new Date(year, monthIndex + 1, 0).getDate();
                let startDay = firstDay.getDay();

                let date = 1;
                let row = $("<tr></tr>");
                let today = new Date();

                // Optimize lookup: map by ISO date
                let attendanceMap = {};
                res.forEach(x => {
                    let formatted = convertToISO(x.date); // function you already use
                    attendanceMap[formatted] = x;
                });

                // Empty cells before first day
                for (let i = 0; i < startDay; i++) {
                    row.append("<td class='empty-cell'></td>");
                }

                while (date <= lastDate) {

                    if (row.children().length === 7) {
                        calendarBody.append(row);
                        row = $("<tr></tr>");
                    }

                    let fullDate = `${year}-${(monthIndex + 1).toString().padStart(2, '0')}-${date.toString().padStart(2, '0')}`;

                    let record = attendanceMap[fullDate];

                    let cellClass = "calendar-cell missing";
                    let inTime = "";
                    let outTime = "";

                    if (record) {
                        inTime = record.inTime || "";
                        outTime = record.outTime || "";

                        if (record.status === "P") {
                            cellClass = "calendar-cell present";
                        } else if (record.status === "A") {
                            cellClass = "calendar-cell absent";
                        } else {
                            cellClass = "calendar-cell offday";
                        }
                    }

                    // Highlight today
                    let highlightToday =
                        (date === today.getDate() &&
                            monthIndex === today.getMonth() &&
                            year === today.getFullYear())
                            ? "border:2px solid #ef8c10;"
                            : "";

                    // Build cell content: date left, status-right
                    let status = "";
                    let hrsText = "";

                    if (record) {
                        status = record.status || "";
                        if (record.ahrs) {
                            hrsText = `(${record.ahrs})`;
                        } else if (record.bhrs) {
                            hrsText = `(-${record.bhrs})`;
                        }
                    }

                    let cellContent = `
                        <div class="cell-top">
                            <span class="date-left">${date.toString().padStart(2,'0')}</span>
                            <span class="status-right">${status}${hrsText}</span>
                        </div>
                    `;

                    // Optional: show in/out time below
                    if (record && (inTime || outTime)) {
                        cellContent += `
                            <div class="time-subtext">
                                ${inTime || ''}
                                ${inTime && outTime ? 'To' : ''}
                                ${outTime || ''}
                            </div>`;
                    }

                    let cell = `<td class="${cellClass}" style="${highlightToday}">${cellContent}</td>`;
                    row.append(cell);

                    date++;
                }

                // Fill remaining cells in last row
                while (row.children().length < 7) {
                    row.append("<td class='empty-cell'></td>");
                }

                calendarBody.append(row);
            },

            error: function () {
                alert("Failed to load attendance data");
            }
        });
    }


    async function Cheack()
    {
        try{
            const res = await $.ajax({
                url: '/EmpAttendance/CheackParentId',
                type: 'GET'
            });

            if (res.success == true)
            {
          document.querySelector('.empattendancecheck-container').style.display = 'block'; // or 'flex'
                $("#chkMultiple").prop("checked", false);
                $(".calendar-wrapper").show();
                $("#tbl_multiuser").hide();
                $("#multiUserSection").hide();
                $('#empattendancecheckUserSearch').hide();
                $('#lbl_selecteduser').hide();
                $('#calendarTable').show();
                $('#BTN_LoadData').show();
                loadAttendanceDetails($("#monthSelect").val());

            }
            else
            {
               document.querySelector('.empattendancecheck-container').style.display = 'none';
                $("#tbl_multiuser").hide();
                $('#lbl_ViewType').hide();
                $('#chkSelf').hide();
                $('#chkMultiple').hide();
                $('#lbl_self').hide();
                $('#lbl_multiuser').hide();
                $('#empattendancecheckUserSearch').hide();
                $('#lbl_selecteduser').hide();
                $('#BTN_LoadData').hide();

                loadAttendanceDetails($("#monthSelect").val());

            }

            console.log("res" ,res);
        }
        catch(ex){
            alert(ex.message);
        }
    }

       async function LoadMultipleEmpdata(month, selectedEmpIds) {

        try {

            const res = await $.ajax({
                url: '/EmpAttendance/GetMULTIPLEEMPAttendanceDetails',
                type: 'GET',
                traditional: true,
                data: {
                    month: month,      // format: "2026-03"
                    EMPID: selectedEmpIds
                }
            });

            console.log("API Response:", res);

            // ===== GENERATE ALL DATES OF MONTH =====
            function getAllDatesOfMonth(monthStr) {

                const [year, monthNum] = monthStr.split('-');
                const totalDays = new Date(year, monthNum, 0).getDate();

                let dates = [];

                for (let d = 1; d <= totalDays; d++) {

                    let day = String(d).padStart(2, '0');
                    let month = String(monthNum).padStart(2, '0');

                    dates.push(`${year}-${month}-${day}`);
                }

                return dates;
            }

            const days = getAllDatesOfMonth(month);

            // ===== TABLE HEADER =====
            let header = `<tr>
                            <th>Emp Code</th>
                            <th>Employee</th>`;

            days.forEach(d => {

                let day = new Date(d).getDate();

                header += `<th>${day}</th>`;
            });

            header += `</tr>`;

            $("#attendanceHead").html(header);

            // ===== NO DATA =====
            if (!res || res.length === 0) {

                $("#multiUserBody").html(`
                    <tr>
                        <td colspan="${days.length + 2}" style="text-align:center;">
                            No record found
                        </td>
                    </tr>
                `);

                toastr.warning("Record not found for this selected month");

                return;
            }

            // ===== GROUP DATA BY EMPLOYEE =====
            const employees = {};

            res.forEach(item => {

                // convert API date to yyyy-mm-dd
                let formattedDate = new Date(item.date)
                    .toISOString()
                    .split('T')[0];

                // create employee group
                if (!employees[item.empId]) {

                    employees[item.empId] = {
                        name: item.employeeName,
                        dates: {}
                    };
                }

                // ===== STATUS COLOR CLASS =====
                let status = (item.status || "").toLowerCase();

                let cellClass = "default-cell";

                if (status === "present" || status === "p") {

                    cellClass = "present-cell";
                }
                else if (status === "absent" || status === "a") {

                    cellClass = "absent-cell";
                }
                else if (status === "leave" || status === "l") {

                    cellClass = "leave-cell";
                }
                else if (
                    status === "off" ||
                    status === "o" ||
                    status === "offday"
                ) {

                    cellClass = "offday-cell";
                }

                // ===== CELL CONTENT =====

                let statusText = item.status || "";

                // show Ahrs or Bhrs only when exists
                let hrsText = "";

                if (item.ahrs) {

                    hrsText = ` (${item.ahrs})`;
                }
                else if (item.bhrs) {

                    hrsText = ` (-${item.bhrs})`;
                }

                // show time only when exists
                let timeText = "";

                if (item.inTime && item.outTime) {

                    timeText = `<br><small>${item.inTime} - ${item.outTime}</small>`;
                }

                // final content
                let cellContent = "";

                if (statusText) {

                    cellContent += `<b>${statusText}${hrsText}</b>`;
                }

                cellContent += timeText;

                // save data
                employees[item.empId].dates[formattedDate] = {

                    class: cellClass,
                    content: cellContent
                };
            });

            // ===== BUILD TABLE ROWS =====
            let rows = "";

            Object.keys(employees).forEach(empId => {

                rows += `
                    <tr>
                        <td>${empId}</td>
                        <td>${employees[empId].name}</td>
                `;

                days.forEach(d => {

                    if (employees[empId].dates[d]) {

                        rows += `
                            <td class="${employees[empId].dates[d].class}">
                                ${employees[empId].dates[d].content}
                            </td>
                        `;
                    }
                    else {

                        rows += `
                            <td class="default-cell"></td>
                        `;
                    }
                });

                rows += `</tr>`;
            });

            $("#multiUserBody").html(rows);

        }
        catch (err) {

            console.error("Error:", err);

            toastr.error("Error loading attendance data");
        }
    }
</script>