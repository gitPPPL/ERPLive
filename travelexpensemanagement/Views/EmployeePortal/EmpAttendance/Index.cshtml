<style>
    /* ===== Calendar Table ===== */
    .calendar-table {
        table-layout: fixed;
        width: 100%;
        border-collapse: collapse;
        border-radius: 6px;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
