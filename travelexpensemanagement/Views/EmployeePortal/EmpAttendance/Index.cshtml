    function populateMonthDropdown() {

        const monthSelect = $("#monthSelect");

        const monthNames = [
            "January","February","March","April","May","June",
            "July","August","September","October","November","December"
        ];

        let today = new Date();
        let currentMonth = today.getMonth();
        let currentYear = today.getFullYear();

        monthSelect.empty();

        for (let i = 0; i < 12; i++) {

            let monthIndex = currentMonth - i;
            let year = currentYear;

            if (monthIndex < 0) {
                monthIndex += 12;
                year -= 1;
            }
            let monthValue = `${year}-${(monthIndex + 1).toString().padStart(2,'0')}`;
            let monthText = `${monthNames[monthIndex]} ${year}`;
            monthSelect.append(`<option value="${monthValue}">${monthText}</option>`);
        }
    }

    function loadUserList() {
        $.ajax({
            url: '/EmpAttendance/DDLUserMast',
            type: 'GET',
            success: function (data) {

                let container = $("#userCheckboxList");
                container.empty();

                $.each(data, function (index, user) {

                    let html = `
                        <label class="empattendancecheck-useritem">
                            <input type="checkbox" class="userCheckbox" value="${user.value}">
                            <span>${user.text}</span>
                        </label>
                    `;

                    container.append(html);

                });

            },
            error: function () {
                alert("Unable to load users.");
            }
        });

    }

    function getSelectedUserIds(){
        let users = [];
        $(".userCheckbox:checked").each(function(){
            users.push($(this).val());
        });
        return users;
    }

    function convertToISO(dateStr) {
        let parts = dateStr.split("-");
        let day = parts[0];
        let monthName = parts[1];
        let year = parts[2];

        let monthNames = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
        let monthNumber = monthNames.indexOf(monthName) + 1;

        return year + "-" + monthNumber.toString().padStart(2,'0') + "-" + day.padStart(2,'0');

    }

