    .empty-cell {
        background-color: #f8f9fa;
        height: 80px;
    }

    .calendar-wrapper {
        overflow-x: auto;
    }
        .time-text {
        font-weight: bold;
    }

    .time-subtext {
        font-size: 11px;
        color: #666;
    }


    /* Flex layout for date + status on the same line */
