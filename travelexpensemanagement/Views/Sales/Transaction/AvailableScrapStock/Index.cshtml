        let tbody = $('#tblAvailableScrapStockEntry tbody');
        let rowCount = tbody.find('tr').length + 1;

        let newRow = `
        <tr>
            <td>
                <input type="text" class="form-control" id="TxtCode${rowCount}" />
            </td>
            <td>
                <select class="form-control" id="ddlItemname${rowCount}">
                    <option value="">-select item Name-</option>
                </select>
            </td>
            <td>
               <select class="form-control" id="ddlUnit${rowCount}">
                    <option value="">-select-</option>
                </select>                 
            </td>
            <td>
               <select class="form-control" id="ddlItemType${rowCount}">
                    <option value="">-select item type-</option>
                    <option>Store</option>
                    <option>Fuel</option>
                    <option>Scrap</option>
                    <option>Waste</option>
                    <option>Other</option>              
                </select>
            </td>
            <td>
                <input type="number" class="form-control" id="TxtNos${rowCount}" />
            </td>
            <td>
                <input type="text" maxlength="10" oninput="allowOnlyNumbers(this)" class="form-control" id="TxtQuantity${rowCount}" />
            </td>
