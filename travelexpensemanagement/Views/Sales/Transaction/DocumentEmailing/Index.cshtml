@{
    ViewBag.Title = "Email Setting";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var userlevel = ViewBag.UserLevel;
}

<div id="erp-toast-container"></div>

<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon"><i class="fa fa-envelope"></i></div>
        <div class="erppage-header-title">Email Setting</div>
    </div>

    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" id="btn-Exit">
            <i class="fa-solid fa-arrow-left"></i>Exit
        </button>
    </div>
</div>

<div class="erppage-container">
    <div class="erppage-fieldset">
        <div id="EmailSettingForm">

            <!-- =====================================================
                 MAIL FROM + MAIL TYPE
            ====================================================== -->
            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Mail Details</legend>
                <div class="erppagesrow">
                    <div class="erppagescol-12">
                        <div class="erppage-grid6">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label" for="ddlMailFrom">Mail From</label>
                                <select class="erppage-redinput erppage-required" id="ddlMailFrom">
                                    <option value="">Select Mail From</option>
                                </select>
                            </div>
                            <div class="erppage-divfield erppage-col-span-3"></div>
                            <div class="erppage-divfield erppage-btn-group-right">
                                <label class="erppage-label">&nbsp;</label>
                                <button type="button" class="erppage-btn erppage-btn-common" title="Print" id="button_print" onclick="DocumentEmailingReport();">
                                    <i class="fa fa-print"></i> Print
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="erppagesrow">
                    <div class="erppagescol-12">
                        <label class="erppage-label">Mail Type</label>
                        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:8px 28px; white-space:nowrap;">
                            <div class="erppage-checkbox-wrap">
                                <input type="radio" id="rdoSalesInvoiceCustomer" name="MailType" value="SalesInvoiceCustomer" class="erppage-checkbox-input">
                                <label for="rdoSalesInvoiceCustomer" class="erppage-checkbox-label">Sales Invoice Customer</label>
                            </div>
                            <div class="erppage-checkbox-wrap">
                                <input type="radio" id="rdoSalesInvoiceAgent" name="MailType" value="SalesInvoiceAgent" class="erppage-checkbox-input">
                                <label for="rdoSalesInvoiceAgent" class="erppage-checkbox-label">Sales Invoice Agent</label>
                            </div>
                            <div class="erppage-checkbox-wrap">
                                <input type="radio" id="rdoDrNote" name="MailType" value="DrNote" class="erppage-checkbox-input">
                                <label for="rdoDrNote" class="erppage-checkbox-label">Dr Note</label>
                            </div>
                            <div class="erppage-checkbox-wrap">
                                <input type="radio" id="rdoCrNote" name="MailType" value="CrNote" class="erppage-checkbox-input">
                                <label for="rdoCrNote" class="erppage-checkbox-label">Cr Note</label>
                            </div>
                            <div class="erppage-checkbox-wrap">
                                <input type="radio" id="rdoPackingSlip" name="MailType" value="PackingSlip" class="erppage-checkbox-input">
                                <label for="rdoPackingSlip" class="erppage-checkbox-label">Packing Slip</label>
                            </div>
                            <div class="erppage-checkbox-wrap">
                                <input type="radio" id="rdoPackingSlipExcel" name="MailType" value="PackingSlipExcel" class="erppage-checkbox-input">
                                <label for="rdoPackingSlipExcel" class="erppage-checkbox-label">Packing Slip in Excel</label>
                            </div>
                            <div class="erppage-checkbox-wrap">
                                <input type="radio" id="rdoPartyBalance" name="MailType" value="PartyBalance" class="erppage-checkbox-input">
                                <label for="rdoPartyBalance" class="erppage-checkbox-label">Party Balance</label>
                            </div>
                            <div class="erppage-checkbox-wrap">
                                <input type="radio" id="rdoOutstanding" name="MailType" value="outstanding" class="erppage-checkbox-input">
                                <label for="rdoOutstanding" class="erppage-checkbox-label">Debtors O/s</label>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- =====================================================
                     FILTERS + MESSAGE
                ====================================================== -->
                <div class="erppagesrow">
                    <!-- FILTERS -->
                    <div class="erppagescol-6">
                        <div class="erppage-grid4">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label" for="ddlDocumentType">Document Type</label>
                                <select class="erppage-redinput erppage-required" id="ddlDocumentType">
                                    <option value="">Select Document Type</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label" for="DtFromDate">From Date</label>
                                <input type="date" class="erppage-input" id="DtFromDate">
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label" for="DtToDate">To Date</label>
                                <input type="date" class="erppage-input" id="DtToDate">
                            </div>
                        </div>

                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label" for="ddlPartyName">Party Name</label>
                                <select class="erppage-input erppage-select" id="ddlPartyName">
                                    <option value="">Select Party Name</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">&nbsp;</label>
                                <div class="erppage-grid2">
                                    <div class="erppage-checkbox-wrap">
                                        <input type="radio" id="rdoPartySelected" name="PartyOption" value="Selected" class="erppage-checkbox-input">
                                        <label for="rdoPartySelected" class="erppage-checkbox-label">Selected</label>
                                    </div>
                                    <div class="erppage-checkbox-wrap">
                                        <input type="radio" id="rdoPartyAll" name="PartyOption" value="All" class="erppage-checkbox-input" checked>
                                        <label for="rdoPartyAll" class="erppage-checkbox-label">All</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="erppage-grid1" id="divSelectedParty" style="display:none;">
                            <div class="erppagetabledynamic-wrapper">
                                <table class="erppagetabledynamic-table" id="tblSelectedParty">
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label" for="ddlAgentName">Agent Name</label>
                                <select class="erppage-input erppage-select" id="ddlAgentName">
                                    <option value="">Select Agent Name</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label" for="ddlAcGroup">A/c Group</label>
                                <select class="erppage-input erppage-select" id="ddlAcGroup">
                                    <option value="">Select A/c Group</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- MESSAGE + ACTIONS -->
                    <div class="erppagescol-6">

                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <label class="erppage-label">&nbsp;</label>
                                <textarea class="erppage-input" id="TxtMessage" aria-label="Message" style="height:80px"></textarea>
                            </div>
                        </div>

                        <div class="erppage-grid3">
                            <div class="erppage-divfield">
                                <label class="erppage-label" for="ddlSalesItemType">Sales Item Type</label>
                                <select class="erppage-input erppage-select" id="ddlSalesItemType">
                                    <option value="">Select Sales Item Type</option>
                                </select>
                            </div>
                            <div class="erppage-col-span-2">
                                <label class="erppage-label">&nbsp;</label>
                                <div class="erppage-internalaction">
                                    <button type="button" id="btn-ExportSalesInvoice" class="erppagelist-btn erppagelist-btn-action" onclick="ExportSalesInvoices();">
                                        <i class="fa fa-file-pdf"></i> Export Sales Invoice
                                    </button>
                                    <button type="button" id="btn-FillData" class="erppagelist-btn erppagelist-btn-action">
                                        <i class="fa fa-download"></i> Fill Data
                                    </button>
                                    <button type="button" id="btn-Mail" class="erppagelist-btn erppagelist-btn-action">
                                        <i class="fa fa-envelope"></i> Mail
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="erppage-grid5">
                            <div class="erppage-divfield">
                                <label class="erppage-label">&nbsp;</label>
                                <label class="erppage-label" id="lblTotalRowsCount" style="color:black"></label>
@*                                 <div class="erppage-checkbox-wrap">
                                    <input type="checkbox" id="ChkSelectRecords" class="erppage-checkbox-input">
                                </div>
 *@                            </div>
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label" for="NumFromRNo">Select Records From RNo</label>
                                <input type="number" class="erppage-input" id="NumFromRNo">
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label" for="NumToRNo">To RNo</label>
                                <input type="number" class="erppage-input" id="NumToRNo">
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">&nbsp;</label>
                                <div class="erppage-btn-group-right">
                                    <button type="button" id="btn-SelectRecords" class="erppagelist-btn erppagelist-btn-action">
                                        <i class="fa fa-rotate"></i> Select
                                    </button>
                                    <button type="button" id="btn-Clear" class="erppagelist-btn erppagelist-btn-action">
                                        <i class="fa fa-rotate-left"></i> Clear
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>


            <!-- =====================================================
                 RECORDS GRID
            ====================================================== -->
            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Records</legend>

                <div class="erppagelist-container">
                    <div class="excel-wrapper fixed-grid-wrapper">
                        <table id="tblEmailSetting" class="excel-table fixed-grid-table resizable-table">
                            <colgroup>
                                <col style="width: 50px;">
                                <col style="width: 80px;">
                                <col style="width: 100px;">
                                <col style="width: 110px;">
                                <col>
                                <col style="width: 120px;">
                                <col style="width: 110px;">
                                <col style="width: 120px;">
                                <col style="width: 220px;">
                            </colgroup>
                            <thead class="table-head">
                                <tr>
                                    <th><input type="checkbox" class="erppage-checkbox-input" id="chkAllRecords" aria-label="Select all records"></th>
                                    <th>Vtype</th>
                                    <th>Srno</th>
                                    <th>Date</th>
                                    <th>A/C Name</th>
                                    <th>Inv No</th>
                                    <th>Inv Date</th>
                                    <th>Inv Amt</th>
                                    <th>Email Id</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </fieldset>

        </div>
    </div>
</div>
<script>
    window.userlevel = "@ViewBag.UserLevel";
</script>
<script src="~/js/erpjs/sales/transaction/documentemailing/documentemailing.js"></script>
