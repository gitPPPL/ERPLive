@{
	ViewBag.Title = "Sales Invoice List";
	Layout = "~/Views/Shared/_Layout.cshtml";

}

<fieldset>
	<legend class="legend-field">Sales Invoice List</legend>
	<div class="row">
		<div class="col-lg-6">
			<div class="input-group shadow-sm rounded-pill overflow-hidden">
				<input type="text" id="searchBox" class="form-control" placeholder="Search by All Columns Name..." aria-label="Search term">
			</div>
		</div>
		<div class="col-lg-6">
			<div class="btn-rightalign">
				<button id="btnSave" onclick="window.location.href='@Url.Action("Index", "SalesInvoice")'" type="submit" class="btn btn-add">
					<i class="fa fa-plus"></i>Add
				</button>
				<button class="btn btn-print" onclick="printCityMasterReport()">
					<i class="fa fa-print"></i> Print
				</button>
				<button class="btn btn-export">
					<i class="fas fa-file-export"></i> Export
				</button>
				<button class="btn btn-mail">
					<i class="fa fa-envelope"></i> Mail
				</button>
				
			</div>
		</div>
	</div>
	<div class="card">
		<div class="table-responsive">
			<table id="tblSalesInvoiceList" class="table-width">
				<thead class="table-head">
					<tr>
						<th style="display:none;">Code</th>
						<th>Voucher type</th>
						<th>Voucher Name</th>
						<th>Voucher No.</th>
						<th>Date</th>
						<th>Bill Name</th>
						<th>Bill Address1</th>
						<th>Bill Address2</th>
						<th>Bill Address3</th>
						<th>Bill City</th>
						<th>Agent</th>
						<th>Ship Name</th>
						<th>Ship Address1</th>
						<th>Ship Address2</th>
						<th>Ship Address3</th>
						<th>S_Name</th>
						<th>Tax Name</th>
						<th>Trantype</th>
						<th>Suptype</th>
						<th>Item Type</th>
						<th>Wb No</th>
						<th>Pack No</th>
						<th>Amount</th>
						<th>Pack Per</th>
						<th>Pack Amount</th>
						<th>Namount</th>
						<th>Cgst Per</th>
						<th>Cgst Amount</th>
						<th>Sgst Per</th>
						<th>Sgst Amount</th>
						<th>Igst Per</th>
						<th>Igst Amount</th>
						<th>Cess Per</th>
						<th>Cess Amount</th>
						<th>Load Per</th>
						<th>Load Amount</th>
						<th>Load_Ac</th>
						<th>Wb Amount</th>
						<th>Wb Ac</th>
						<th>Total Nos</th>
						<th>Freight Amount</th>
						<th>Round Off</th>
						<th>Total Net</th>
						<th>Insu_Per</th>
						<th>Insu_Amount</th>
						<th>Tds_Per</th>
						<th>Tds_Amount</th>
						<th>Load_Rem</th>
						<th>Wb_Rem</th>
						<th>Total Gross</th>
						<th>Gross No</th>
						<th>Gross Date</th>
						<th>Vehicle No</th>
						<th>Transport_Code</th>
						<th>Transport_Name</th>
						<th>Driver_Name</th>
						<th>Driver_No</th>
						<th>Ewaybill_No</th>
						<th>Remark</th>
						<th>Freight Topay</th>
						<th>Wb Quantity</th>
						<th>Disc_Per</th>
						<th>Disc Amount</th>
						<th>Cdisc_Per</th>
						<th>Cdisc Amount</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
		<!-- Pagination container -->
		<div class="row">
			<div class="col-md-12">
				<div class="pagination-end">
					<div class="custom-pagination" id="tablePagination"></div>
				</div>
			</div>
		</div>
	</div>



</fieldset>

<script>



	let currentPage = 1;
	let pageSize = 10;

	$(document).ready(function () {
		loadDocumentStages();

		$('#searchBox').on('keyup', function () {
			currentPage = 1;
			loadDocumentStages();
		});
	});

	//Load main grid...............
	function loadDocumentStages() {
		const searchTerm = $('#searchBox').val();

		$.ajax({
			url: '/ApprovalStageMasterList/GetAllDocs',
			type: 'GET',
			dataType: 'json',
			data: {
				searchTerm,
				pageNumber: currentPage,
				pageSize: pageSize
			},
			success: function (res) {
				console.log(res);
				const docs = res.items || res.data || [];
				const totalCount = res.totalCount || 0;

				const tbody = $('#tblApprovalStageMaster tbody');
				tbody.empty();

				if (docs.length === 0) {
					tbody.append(`<tr><td colspan="5" class="text-center text-muted">No records found.</td></tr>`);
					renderPagination(0, pageSize, currentPage);
					return;
				}

				docs.forEach(doc => {
					tbody.append(`
						<tr>
							<td style="display:none;">${doc.code || doc.doC_CODE || ''}</td>
							<td>${doc.doC_CODE || ''}</td>
							<td>${doc.doC_NAME || ''}</td>
							<td>${doc.useR_NO || '0'}</td>
							<td>
							  <div class="action-icons">
							  <i class="fa fa-edit btn-edit" data-bs-toggle="tooltip" title="Edit" onclick="editDocStage('${doc.doC_CODE}')"></i>
							  <i class="fa fa-eye btn-view" data-bs-toggle="tooltip" title="View" onclick="viewDocStage('${doc.doC_CODE}')"></i>
							  <i class="fa fa-trash btn-delete" data-bs-toggle="tooltip" title="Delete" onclick="deleteDocStage('${doc.doC_CODE}')"></i>
							  <i class="fa fa-file btn-document" data-bs-toggle="tooltip" data-bs-title="Document Details" onclick="showDocumentPopup('${doc.doC_CODE}')"></i>
							  </div>

							</td>
						</tr>
					`);
				});

				renderPagination(totalCount, pageSize, currentPage);
			},
			error: function (xhr) {
				toastr.error('Error loading document stages: ' + (xhr.responseJSON?.message || xhr.statusText));
			}
		});
	}

	function renderPagination(total, pageSize, currentPage) {
		const totalPages = Math.ceil(total / pageSize);
		const pagination = $('#tablePagination');
		pagination.empty();

		if (totalPages <= 1) return;

		let html = '';

		if (currentPage > 1) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
		}

		const startPage = Math.max(1, currentPage - 2);
		const endPage = Math.min(totalPages, currentPage + 2);

		for (let i = startPage; i <= endPage; i++) {
			html += `
				<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
		}

		if (currentPage < totalPages) {
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
			html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
		}

		pagination.html(html);
	}

	function goToPage(page) {
		currentPage = page;
		loadDocumentStages();
	}

	function editDocStage(docCode) {
		window.location.href = `/ApprovalStageMaster/Index?docCode=${encodeURIComponent(docCode)}`;
	}

	function viewDocStage(docCode) {
		window.location.href = `/ApprovalStageMaster/Index?docCode=${encodeURIComponent(docCode)}&readOnly=true`;
	}

	function deleteDocStage(docCode) {
		Swal.fire({
			title: 'Are you sure?',
			text: "You won't be able to revert this deletion!",
			icon: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#d33',
			cancelButtonColor: '#3085d6',
			confirmButtonText: 'Yes, delete it!'
		}).then((result) => {
			if (result.isConfirmed) {
				$.ajax({
					url: '/ApprovalStageMasterList/DeleteDocByCode',
					type: 'POST',
					data: { docCode: docCode },
					success: function (response) {
						if (response.success) {
							toastr.success(response.message || "Record deleted successfully.");
							loadDocumentStages();
						} else {
							toastr.warning("Delete failed.");
						}
					},
					error: function () {
						toastr.error("An error occurred while deleting.");
					}
				});
			}
		});
	}


</script>

