@{
    ViewBag.Title = "Delivery Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon"><i class="fa-solid fa-truck-fast"></i></div>
        <div class="erppage-header-title">Delivery Order</div>
    </div>
    <div class="erppage-header-right">
        <button type="button" class="erppage-header-back" onclick="window.location.href='@Url.Action("Index", "DeliveryOrderList")'">
            <i class="fa-solid fa-arrow-left"></i> Back to list
        </button>
    </div>
</div>

<input type="hidden" id="TxtCode" name="CODE">
<div class="erppage-container">
    <fieldset class="erppage-fieldset">
        <div class="erppage-grid5">
            <div class="erppage-divfield">
                <label class="erppage-label" for="ddlVoucherType">Voucher Type</label>
                <select class="erppage-redinput erppage-required" id="ddlVoucherType"><option value="">Select Voucher Type</option></select>
            </div>
            <div class="erppage-divfield">
                <label class="erppage-label" for="NumVoucherNo">Voucher No</label>
                <input type="number" class="erppage-redinput" id="NumVoucherNo">
            </div>
            <div class="erppage-divfield">
                <label class="erppage-label" for="DtBillDate">Bill Date</label>
                <input type="date" class="erppage-redinput" id="DtBillDate">
            </div>
            <div class="erppage-divfield">
                <label class="erppage-label" for="DtDeliveryDate">Delivery Date</label>
                <input type="date" class="erppage-input" id="DtDeliveryDate">
            </div>
            <div class="erppage-divfield">
                <label class="erppage-label" for="NumSaudaNo"> Sauda No </label>
                <div class="erppage-inputgroup">
                    <input type="number" class="erppage-input" id="NumSaudaNo">
                    <button type="button" id="btnCalcSauda" class="erppage-btn erppage-btn-common"> Calc </button>
                </div>
            </div>
        </div>
        <div class="erppagesrow">
            <div class="erppagescol-6">
                <fieldset class="erppagefieldset">
                    <legend class="erppagefieldset-legend">Party Details</legend>
                    <div class="erppage-grid1">
                        <div class="erppage-divfield">
                            <label class="erppage-label" for="ddlPartyName">Party Name</label>
                            <select class="erppage-redinput erppage-required" id="ddlPartyName"><option value="">Select Party Name</option></select>
                           
                            <button type="button" id="btnPartyInfo" class="erppage-btn erppage-btn-common erppage-width-7" title="Party Credit Details" disabled>
                                <i class="fa-solid fa-circle-info"></i>
                            </button>
                        </div>
                    </div>
                    <div class="erppage-grid1"><div class="erppage-divfield">
                        <label class="erppage-label" for="TxtAddressL1">Address L1</label>
                        <div class="erppage-inputgroup">
                            <input type="text" class="erppage-input erppage-width-93" id="TxtAddressL1" placeholder="Enter Address L1">
                            <select class="erppage-input erppage-select erppage-width-7" id="ddladdressL1">
                                <option value="">Select address</option>
                            </select>
                        </div>
                        </div>
                    </div>
                    <div class="erppage-grid1">
                        <div class="erppage-divfield">
                            <label class="erppage-label" for="TxtAddressL2">Address L2</label>
                            <textarea class="erppage-input" id="TxtAddressL2" placeholder="Enter Address L2"></textarea>
                        </div>
                    </div>
                    <div class="erppage-grid2">
                        <div class="erppage-divfield">
                            <label class="erppage-label" for="TxtAddressL3">Address L3</label>
                            <textarea class="erppage-input" id="TxtAddressL3" placeholder="Enter Address L3"></textarea>
                        </div>
                        <div class="erppage-divfield">
                            <label class="erppage-label" for="TxtGST">GST</label>
                            <input type="text" class="erppage-input" id="TxtGST">
                        </div>
                    </div>
                    <div class="erppage-grid2">
                        <div class="erppage-divfield">
                            <label class="erppage-label" for="ddlStation">Station</label>
                            <select class="erppage-input erppage-select" id="ddlStation"><option value="">Select Station</option></select>
                        </div>

                        <div class="erppage-divfield">
                            <label class="erppage-label" for="NumPincode">Pincode</label>
                            <input type="number" class="erppage-input" id="NumPincode">
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="erppagescol-6">
                <fieldset class="erppagefieldset">
                    <legend class="erppagefieldset-legend">Sauda Details</legend>
                    <div class="erppage-grid2">
                       
                        <div class="erppage-divfield">
                            <label class="erppage-label" for="ddlSoldBy">Sold By</label>
                            <select class="erppage-input erppage-select" id="ddlSoldBy"><option value="">Select Sold By</option></select>
                        </div>
                        <div class="erppage-divfield">
                            <label class="erppage-label" for="ddlConsignee">Consignee</label>
                            <select class="erppage-input erppage-select" id="ddlConsignee"><option value="">Select Consignee</option></select>
                        </div>
                    </div>
                    <div class="erppage-grid1"><div class="erppage-divfield"><label class="erppage-label" for="TxtTransactionAddressL1">Address L1</label><div class="erppage-inputgroup"><input type="text" class="erppage-input erppage-width-93" id="TxtTransactionAddressL1" placeholder="Enter Address L1"><select class="erppage-input erppage-select erppage-width-7" id="ddlTransactionaddressL1"><option value="">Select address</option></select></div></div></div>
                    <div class="erppage-grid2">
                        <div class="erppage-divfield">
                            <label class="erppage-label" for="TxtTransactionAddressL2">Address L2</label>
                            <textarea class="erppage-input" id="TxtTransactionAddressL2" placeholder="Enter Address L2"></textarea>
                        </div>
                        <div class="erppage-divfield">
                            <label class="erppage-label" for="TxtTransactionAddressL3">Address L3</label>
                            <textarea class="erppage-input" id="TxtTransactionAddressL3" placeholder="Enter Address L3"></textarea>
                        </div>
                        <div class="erppage-divfield">
                            <label class="erppage-label" for="NumTransactionGSTNo">GST No</label>
                            <input type="text" class="erppage-input" id="NumTransactionGSTNo">
                        </div>
                        <div class="erppage-divfield">
                            <label class="erppage-label" for="TxtTransactionStation">Station</label>
                            <select class="erppage-input erppage-select" id="TxtTransactionStation"><option value="">Select Station</option></select>
                        </div>
                    </div>
                    <div class="erppage-grid2">
                        <div class="erppage-divfield">
                            <label class="erppage-label" for="NumTransactionPIN">PIN</label>
                            <input type="number" class="erppage-input" id="NumTransactionPIN">
                        </div>
                        <div class="erppage-divfield">
                            <label class="erppage-label" for="ddlFormType">Form Type</label>
                            <select class="erppage-input erppage-select" id="ddlFormType"><option value="">Select Form Type</option></select>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        <fieldset class="erppagefieldset">
            <legend class="erppagefieldset-legend">Tax Detail</legend>
            <div class="erppage-grid5">
                <div class="erppage-divfield">
                    <label class="erppage-label" for="ddlSupplyType">Supply Type</label>
                    <select class="erppage-input erppage-select" id="ddlSupplyType">
                        <option value="B2B">B2B</option>
                        <option value="B2C">B2C</option>
                        <option value="SEZWP">SEZWP</option>
                        <option value="SEZWOP">SEZWOP</option>
                        <option value="EXPWP">EXPWP</option>
                        <option value="EXPWOP">EXPWOP</option>
                        <option value="DEXP">DEXP</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label" for="ddlProdType">Prod Type</label>
                    <select class="erppage-input erppage-select" id="ddlProdType">
                        <option value="">Select Prod Type</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label" for="ddlTaxType">Tax Type</label>
                    <select class="erppage-input erppage-select" id="ddlTaxType"><option value="">Select Tax Type</option></select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label" for="ddlPackNo">Pack No</label>
                    <select class="erppage-input erppage-select" id="ddlPackNo"><option value="">Select Pack No</option></select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label" for="ddlIssueNo">Issue No</label>
                    <select class="erppage-input erppage-select" id="ddlIssueNo"><option value="">Select Issue No</option></select>
                </div>
            </div>
            <div class="erppage-grid6">
                <div class="erppage-divfield">
                    <label class="erppage-label" for="ddlTransactionType">Transaction Type</label>
                    <select class="erppage-input erppage-select" id="ddlTransactionType">
                        <option value="Regular">Regular</option>
                        <option value="BillToShipTo">Bill To - Ship To</option>
                        <option value="BillFrom">Bill From</option>
                        <option value="CombinationOfBoth">Combination of both</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label" for="ddlWBNo">WB No</label>
                    <select class="erppage-input erppage-select" id="ddlWBNo"><option value="">Select WB No</option></select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label" for="TxtRemarks">Remarks</label>
                    <textarea class="erppage-input" id="TxtRemarks" placeholder="Enter Remarks"></textarea>
                </div>
                <div class="erppage-divfield">
                    <div class="erppage-checkbox-wrap">
                        <input type="checkbox" id="ChkDetail" class="erppage-checkbox-input">
                        <label for="ChkDetail" class="erppage-checkbox-label">Detail</label>
                        <input type="checkbox" id="cbCalOnPcs" class="erppage-checkbox-input">
                        <label for="cbCalOnPcs" class="erppage-checkbox-label">PCS</label>
                    </div>
                </div>
                <div class="erppage-divfield">
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">&nbsp;</label>
                    <button type="button" id="btnPendingDetails" class="btn btn-primary">
                        <i class="fa-solid fa-clock-rotate-left me-1"></i> Pending Details
                    </button>
                </div>

            </div>
        </fieldset>
        <fieldset class="erppagefieldset">
            <legend class="erppagefieldset-legend">Item Record</legend>
            <div class="erppagelist-container">
                <div class="excel-wrapper fixed-grid-wrapper">
                    <table id="tblDeliveryorder" class="excel-table fixed-grid-table width-table resizable-table">
                        <colgroup>
                            <col style="display:none;">
                            <col style="width:80px;">
                            <col style="width:260px;">
                            <col style="width:85px;">
                            <col style="width:110px;">
                            <col style="width:110px;">
                            <col style="width:110px;">
                            <col style="width:120px;">
                            <col style="width:85px;">
                            <col style="width:110px;">
                            <col style="width:85px;">
                            <col style="width:120px;">
                            <col style="width:110px;">
                            <col style="width:110px;">
                            <col style="width:110px;">
                            <col style="width:110px;">
                            <col style="width:90px;">
                            <col style="width:130px;">
                            <col style="width:110px;">
                        </colgroup>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th class="freeze-item">Product Name</th>
                                <th>Nos</th>
                                <th>Net Quantity</th>
                                <th>Rate (in USD)</th>
                                <th>Rate (in Rs)</th>
                                <th>Amount</th>
                                <th>Pack %</th>
                                <th>Pack Amt</th>
                                <th>Disc %</th>
                                <th>Disc Amount</th>
                                <th>Pack No</th>
                                <th>Lot No</th>
                                <th>Sauda No</th>
                                <th>Sauda Rate</th>
                                <th>ROWID</th>
                                <th>Stock Quantity</th>
                                <th class="action-col">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </fieldset>
        <!-- Delivery Order Tabs -->
        <div class="erppage-tabs">
            <button type="button" class="erppage-tab active" data-tab="accounttaxsummary">Account & Tax Summary </button>
            <button type="button" class="erppage-tab"  data-tab="transportdetail">Transport Detail</button>
            <button type="button"  class="erppage-tab" data-tab="waybillloading">Waybill/Loading Detail</button>
            <button type="button" class="erppage-tab"  data-tab="exportdetail"> Export Detail</button>
        </div>
        <!-- ========================================================= -->
        <!-- ACCOUNT & TAX SUMMARY -->
        <!-- ========================================================= -->
        <div class="erppage-tab-content active" id="accounttaxsummary">
            <fieldset class="erppagefieldset">
                <div class="erppage-grid5">
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="NumOtherTotalAmount"> Total Amount </label>
                        <input type="number" class="erppage-input" id="NumOtherTotalAmount">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label"> Packing </label>
                        <div class="erppage-inputgroup">
                            <input type="number" class="erppage-input" id="NumOtherPacking1" placeholder="%">
                            <input type="number" class="erppage-input" id="NumOtherPacking2" placeholder="Amount">
                        </div>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label"> Discount </label>
                        <div class="erppage-inputgroup">
                            <input type="number" class="erppage-input" id="NumOtherDiscount1" placeholder="%">
                            <input type="number" class="erppage-input"  id="NumOtherDiscount2"  placeholder="Amount">
                        </div>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">  Cash Discount </label>
                        <div class="erppage-inputgroup">
                            <input type="number"  class="erppage-input" id="NumCashDiscount1" placeholder="%">
                            <input type="number" class="erppage-input" id="NumCashDiscount2" placeholder="Amount">
                        </div>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="NumSubTotal"> Sub Total </label>
                        <input type="number" class="erppage-input" id="NumSubTotal">
                    </div>
                </div>
                <div class="erppage-grid5">
                    <div class="erppage-divfield">
                        <label class="erppage-label"> CGST </label>
                        <div class="erppage-inputgroup">
                            <input type="number"  class="erppage-input" id="NumOtherCGST1" placeholder="%">
                            <input type="number" class="erppage-input" id="NumOtherCGST2"  placeholder="Amount">
                        </div>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">  SGST </label>
                        <div class="erppage-inputgroup">
                            <input type="number"  class="erppage-input"  id="NumOtherSGST1"  placeholder="%">
                            <input type="number" class="erppage-input"  id="NumOtherSGST2" placeholder="Amount">
                        </div>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label"> IGST </label>
                        <div class="erppage-inputgroup">
                            <input type="number" class="erppage-input" id="NumOtherIGST1" placeholder="%">
                            <input type="number" class="erppage-input" id="NumOtherIGST2" placeholder="Amount">
                        </div>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">  CESS  </label>
                        <div class="erppage-inputgroup">
                            <input type="number" class="erppage-input" id="NumOtherCESS1" placeholder="%">
                            <input type="number" class="erppage-input" id="NumOtherCESS2" placeholder="Amount">
                        </div>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">  TCS </label>
                        <div class="erppage-inputgroup">
                            <input type="number" class="erppage-input" id="NumOtherTCS1" placeholder="%">
                            <input type="number" class="erppage-input" id="NumOtherTCS2" placeholder="Amount">
                        </div>
                    </div>
                </div>
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="NumOtherTotalNos"> Total Nos </label>
                        <input type="number" class="erppage-input"  id="NumOtherTotalNos">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="NumOtherRoundOff"> Round Off </label>
                        <input type="number" class="erppage-input" id="NumOtherRoundOff">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="NumOtherNetAmount"> Net Amount </label>
                        <input type="number" class="erppage-input" id="NumOtherNetAmount">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="ddlDocStatus">   Doc Status </label>
                        <select class="erppage-input erppage-select" id="ddlDocStatus">
                            <option value="">Select Doc Status</option>
                        </select>
                    </div>
                </div>
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="NumDist"> Dist. </label>
                        <input type="number" class="erppage-input" id="NumDist">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="NumNetQuantity">  Net Quantity </label>
                        <input type="number"  class="erppage-input" id="NumNetQuantity">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="NumWbQuantity"> WB Quantity </label>
                        <input type="number" class="erppage-input" id="NumWbQuantity">
                    </div>
                </div>
            </fieldset>
        </div>
        <!-- ========================================================= -->
        <!-- TRANSPORT DETAIL -->
        <!-- ========================================================= -->
        <div class="erppage-tab-content" id="transportdetail">
            <fieldset class="erppagefieldset">
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="TxtTransport"> Transport </label>
                        <select class="erppage-input erppage-select" id="ddlTransport">
                            <option value="">Select Transport</option>
                        </select>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="TxtGRNo">GR No/DT</label>
                        <input type="text" class="erppage-input" id="TxtGRNo">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="DtGRDate">GR Date</label>
                        <input type="date" class="erppage-input" id="DtGRDate">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="TxtTruckNo">Truck No</label>
                        <input type="text"  class="erppage-input" id="TxtTruckNo">
                    </div>
                </div>
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="TxtDriverName">Driver Name</label>
                        <input type="text" class="erppage-input" id="TxtDriverName">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="TxtDriverNo">Driver No</label>
                        <input type="text" class="erppage-input"  id="TxtDriverNo">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="txtins_p">Insurance</label>
                        <div class="erppage-inputgroup">
                            <input type="number" class="erppage-input"  id="txtins_p" placeholder="%">
                            <input type="number" class="erppage-input" id="txtins_amt" placeholder="Amount">
                        </div>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="NumFreightAmt">Freight Amt</label>
                        <input type="number" class="erppage-input" id="NumFreightAmt">
                    </div>
                </div>
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="txttds_p">TDS on Frt.</label>
                        <div class="erppage-inputgroup">
                            <input type="number" class="erppage-input" id="txttds_p" placeholder="%">
                            <input type="number"  class="erppage-input" id="txttds_amt"  placeholder="Amount">
                        </div>
                    </div>
                    <div class="erppage-divfield erppage-col-span-2">
                        <label class="erppage-label" for="TxtBuyerOrder">Buyer Ord/Offer No</label>
                        <input type="text" class="erppage-input" id="TxtBuyerOrder">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="txttaxOnFrt_p">Tax on Frt.</label>
                        <div class="erppage-inputgroup">
                            <input type="number" class="erppage-input" id="txttaxOnFrt_p"  placeholder="%">
                            <input type="number" class="erppage-input" id="txttaxOnFrt_Amt"  placeholder="Amount">
                        </div>
                    </div>
                </div>
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="TxtPaymentTerm">Payment Term</label>
                        <input type="text" class="erppage-input" id="TxtPaymentTerm">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="ddlModeOfTransport">Mode of Tpt.</label>
                        <select class="erppage-input erppage-select" id="ddlModeOfTransport">
                            <option value="">Select Mode</option>
                            <option value="1">Road</option>
                            <option value="2">Rail</option>
                            <option value="3">Air</option>
                            <option value="4">Sea</option>
                        </select>
                    </div>
                </div>
                <div class="erppage-internalaction mt-2">
                    <button type="button"  class="erppage-btn erppage-btn-common"  id="btnReconcileDO">  <i class="fa-solid fa-arrows-rotate"></i> <span>Reconcile DO</span> </button>
                    <button type="button" class="erppage-btn erppage-btn-common" id="btnCreateProforma"> <i class="fa-solid fa-file-invoice"></i> <span>Create Proforma Invoice</span> </button>
                    <button type="button" class="erppage-btn erppage-btn-common"  id="btnCreateSalesInvoice"> <i class="fa-solid fa-file-invoice-dollar"></i> <span>Create Sales Invoice</span> </button>
                </div>
            </fieldset>
        </div>
        <!-- ========================================================= -->
        <!-- WAYBILL / LOADING DETAIL -->
        <!-- ========================================================= -->
        <div class="erppage-tab-content" id="waybillloading">
            <fieldset class="erppagefieldset">
                <div class="erppage-grid2">
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="TxtWayBillNo">  Way Bill No </label>
                        <input type="text" class="erppage-input" id="TxtWayBillNo">
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="NumToPayFrt"> To Pay Frt </label>
                        <input type="number" class="erppage-input" id="NumToPayFrt">
                    </div>
                </div>
                <div class="erppage-grid4">
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="txtload_p"> Load Amt </label>
                        <div class="erppage-inputgroup">
                            <input type="number" class="erppage-input" id="txtload_p" placeholder="%">
