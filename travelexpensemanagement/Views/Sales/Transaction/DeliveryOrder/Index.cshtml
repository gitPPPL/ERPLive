<script>
    $(document).ready(function () {
        const $tbody = $('#tblDeliveryorder tbody');

        // Function to add a new row with empty values or provided data
        function addRow(data = {}) {
            const row = `
                <tr class="no-border-input">
                    <!-- Hidden Code Column -->
                    <td style="display:none;">${data.code || ''}</td>

                    <!-- ID -->
                    <td><input type="text" class="form-control" value="${data.id || ''}" /></td>

                    <!-- Product Name -->
                    <td><input type="text" class="form-control" value="${data.productName || ''}" /></td>

                    <!-- Nos -->
                    <td><input type="text" class="form-control" value="${data.nos || ''}" /></td>

                    <!-- Net Quantity -->
                    <td><input type="number" class="form-control" value="${data.netQuantity || ''}" /></td>

                    <!-- Rate (in USD) -->
                    <td><input type="number" step="any" class="form-control" value="${data.rateUSD || ''}" /></td>

                    <!-- Rate (in Rs) -->
                    <td><input type="number" step="any" class="form-control" value="${data.rateRs || ''}" /></td>

                    <!-- Amount -->
                    <td><input type="number" step="any" class="form-control" value="${data.amount || ''}" /></td>

                    <!-- Pack % -->
                    <td><input type="number" step="any" class="form-control" value="${data.packPercent || ''}" /></td>

                    <!-- Pack Amt -->
                    <td><input type="number" step="any" class="form-control" value="${data.packAmount || ''}" /></td>

                    <!-- Disc % -->
                    <td><input type="number" step="any" class="form-control" value="${data.discPercent || ''}" /></td>

                    <!-- Disc Amt -->
                    <td><input type="number" step="any" class="form-control" value="${data.discAmount || ''}" /></td>

                    <!-- Pack No -->
                    <td><input type="text" class="form-control" value="${data.packNo || ''}" /></td>

                    <!-- Lot No -->
                    <td><input type="text" class="form-control" value="${data.lotNo || ''}" /></td>

                    <!-- Sauda No -->
                    <td><input type="text" class="form-control" value="${data.saudaNo || ''}" /></td>

                    <!-- Sauda Rate -->
                    <td><input type="number" step="any" class="form-control" value="${data.saudaRate || ''}" /></td>

                    <!-- ROWID -->
                    <td><input type="text" class="form-control" value="${data.rowId || ''}" /></td>

                    <!-- Stock Quantity -->
                    <td><input type="number" class="form-control" value="${data.stockQuantity || ''}" /></td>

                    <!-- Action: Add Row / Delete Row -->
                    <td>
                        <i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer;"></i>
                        <i class="fa fa-trash btn-delete-action text-danger" title="Delete Row" style="cursor:pointer;"></i>
                    </td>
                </tr>
            `;
            $tbody.append(row);
        }

        // Initial row
        addRow();

        // Add row on clicking plus icon or "Add New Row"
        $(document).on('click', '.btn-add-row, .btn-add-action', function () {
            addRow();
        });

        // Delete row
        $(document).on('click', '.btn-delete-action', function () {
            const $row = $(this).closest('tr');
            const isLastRow = $row.is(':last-child');
            $row.remove();

            // If last row was deleted, show plus icon on the new last row
            if (isLastRow) {
                const $lastRow = $tbody.find('tr:last');
                if ($lastRow.length > 0 && $lastRow.find('.btn-add-action').length === 0) {
                    $lastRow.find('td:last').prepend(
                        `<i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer;"></i>`
                    );
                }
            }
        });
    });
</script>

<script>



    let currentPage = 1;
    let pageSize = 10;

    $(document).ready(function () {
        loadDocumentStages();

        $('#searchBox').on('keyup', function () {
            currentPage = 1;
            loadDocumentStages();
        });
    });

    //Load main grid...............
    function loadDocumentStages() {
        const searchTerm = $('#searchBox').val();

        $.ajax({
            url: '/ApprovalStageMasterList/GetAllDocs',
            type: 'GET',
            dataType: 'json',
            data: {
                searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize
            },
            success: function (res) {
                console.log(res);
                const docs = res.items || res.data || [];
                const totalCount = res.totalCount || 0;

                const tbody = $('#tblApprovalStageMaster tbody');
                tbody.empty();

                if (docs.length === 0) {
                    tbody.append(`<tr><td colspan="5" class="text-center text-muted">No records found.</td></tr>`);
                    renderPagination(0, pageSize, currentPage);
                    return;
                }

                docs.forEach(doc => {
                    tbody.append(`
                        <tr>
                            <td style="display:none;">${doc.code || doc.doC_CODE || ''}</td>
                            <td>${doc.doC_CODE || ''}</td>
                            <td>${doc.doC_NAME || ''}</td>
                            <td>${doc.useR_NO || '0'}</td>
                            <td>
                              <div class="action-icons">
                              <i class="fa fa-edit btn-edit" data-bs-toggle="tooltip" title="Edit" onclick="editDocStage('${doc.doC_CODE}')"></i>
                              <i class="fas fa-eye btn-view" data-bs-toggle="tooltip" title="View" onclick="viewDocStage('${doc.doC_CODE}')"></i>
                              <i class="fas fa-trash btn-delete" data-bs-toggle="tooltip" title="Delete" onclick="deleteDocStage('${doc.doC_CODE}')"></i>
                               <i class="fa fa-file btn-document" data-bs-toggle="tooltip" data-bs-title="Document Details" onclick="showDocumentPopup('${doc.doC_CODE}')"></i>
                              </div>

                            </td>
                        </tr>
                    `);
                });

                renderPagination(totalCount, pageSize, currentPage);
            },
            error: function (xhr) {
                toastr.error('Error loading document stages: ' + (xhr.responseJSON?.message || xhr.statusText));
            }
        });
    }

        function renderPagination(total, pageSize, currentPage) {
        const totalPages = Math.ceil(total / pageSize);
        const pagination = $('#tablePagination');
        pagination.empty();

        if (totalPages <= 1) return;

        let html = '';

        if (currentPage > 1) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(1)">First</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage - 1})">Prev</button>`;
        }

        const startPage = Math.max(1, currentPage - 2);
        const endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
            html += `
                <button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} mx-1" onclick="goToPage(${i})">${i}</button>`;
        }

        if (currentPage < totalPages) {
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${currentPage + 1})">Next</button>`;
            html += `<button class="btn btn-sm btn-light mx-1" onclick="goToPage(${totalPages})">Last</button>`;
        }

        pagination.html(html);
    }

    function goToPage(page) {
        currentPage = page;
        loadDocumentStages();
    }

    function editDocStage(docCode) {
        window.location.href = `/ApprovalStageMaster/Index?docCode=${encodeURIComponent(docCode)}`;
    }

    function viewDocStage(docCode) {
        window.location.href = `/ApprovalStageMaster/Index?docCode=${encodeURIComponent(docCode)}&readOnly=true`;
    }

    function deleteDocStage(docCode) {
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this deletion!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/ApprovalStageMasterList/DeleteDocByCode',
                    type: 'POST',
                    data: { docCode: docCode },
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message || "Record deleted successfully.");
                            loadDocumentStages();
                        } else {
                            toastr.warning("Delete failed.");
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while deleting.");
                    }
                });
            }
        });
    }



</script>
