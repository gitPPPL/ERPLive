@{
    ViewBag.Title = "Insurance Cover Note";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var globalVar = ViewBag.GlobalVariables as Models.UserSessionData;
}

<style>
    .erppage-policy-row {
        display: flex;
        justify-content: flex-end;
    }

    .erppage-policy-amount {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .erppage-policy-label {
        font-weight: 600;
    }

    .erppage-policy-value {
        font-weight: 600;
        min-width: 85px;
        text-align: right;
    }
</style>

<div id="erp-toast-container"></div>

<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa-solid fa-shield-halved"></i>
        </div>

        <div class="erppage-header-title">
            Insurance Cover Note
        </div>
    </div>

    <div class="erppage-header-right">
        <div class="erppage-internalaction">
            <button type="button" id="btn_print" class="erppage-btn erppage-btn-common-print-disabled" onclick="InsuranceEntry()"><i class="fa fa-print"></i> Print</button>
        </div>
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "InsuranceCoverNoteList")', isReadOnly)">
          <i class="fa-solid fa-arrow-left"></i>
            Back to list
        </button>

    </div>

</div>

<div id="InsuranceCoverNoteform">
    <input type="hidden" class="form-control" id="TxtDocId" name="CODE">

    <div class="erppage-container">

        <fieldset class="erppagefieldset">

            <div class="erppage-grid4">

                <div class="erppage-divfield">
                    <label class="erppage-label"> Document No  </label>
                    <input type="number" class="erppage-input" id="NumDocNo" placeholder="Enter Document No"readonly>
                </div>

                <div class="erppage-divfield">
                    <label class="erppage-label"> Document Date  </label>
                    <input type="date" class="erppage-input" id="DtDocumentDate">
                </div>

                <div class="erppage-divfield">
                    <label class="erppage-label "> Insurance Type  </label>
                    <select class="erppage-input erppage-select  erppage-required" id="ddlInsuranceType">
                        <option value="">Select Insurance Type</option>
                    </select>
                </div>

                <div class="erppage-divfield">
                    <label class="erppage-label "> Bill Type  </label>
                    <select class="erppage-input erppage-select erppage-required" id="ddlBillType">
                        <option value="">Select Bill Type</option>
                    </select>
                </div>

            </div>

            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label"> Policy Issue Date  </label>
                    <input type="date" class="erppage-input" id="DtPolicyIssueDate" readonly>
                </div>

                <div class="erppage-divfield">
                    <label class="erppage-label"> Policy Expire Date  </label>
                    <input type="date" class="erppage-input" id="DtPolicyExpireDate" readonly>
                </div>

                <div class="erppage-divfield">
                    <label class="erppage-label "> From Bill No  </label>
                    <select class="erppage-input erppage-select erppage-required" id="ddlFromBillNo">
                        <option value="">Select From Bill</option>
                    </select>
                    <input type="text" class="erppage-input" id="txtFromBillNo" style="display:none;">
                </div>

                <div class="erppage-divfield">
                    <label class="erppage-label"> To Bill No  </label>
                    <select class="erppage-input erppage-select erppage-required" id="ddlToBillNo">
                        <option value="">Select To Bill</option>
                    </select>
                    <input type="text" class="erppage-input"  id="txtToBillNo" style="display:none;">
                </div>

            </div>

            <div id="policyAmountRow" class="erppage-grid4 erppage-policy-row">
                <div class="erppage-policy-amount">
                    <span class="erppage-policy-label">Policy Bal. Amt:</span>
                    <span id="TxtPolicyAmount" class="erppage-policy-value">0.00</span>
                </div>
            </div>

        </fieldset>

        <div class="erppage-actions">
            <button id="btn-save" type="submit" class="erppage-btn erppage-btn-save">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>

        </div>

    </div>

</div>

<script src="~/js/erpjs/sales/transaction/insurancecovernotejs/insurancecovernote.js"></script>

<script>
    var compCode = '@ViewBag.CompCode';
    var branchCode = '@ViewBag.BranchCode';
    var yearCode = '@ViewBag.YearCode';

    window.globalVariables = {
        compCode: "@globalVar?.PubCompCode",
        yearCode: "@globalVar?.PubFYearCode",
        branchCode: "@globalVar?.PubBranchCode",

        companyName: "@globalVar?.CompanyName",
        add1: "@globalVar?.Address1",
        add2: "@globalVar?.Address2",

        gstin: "@globalVar?.gstin",
        pan: "@globalVar?.PAN",
        website: "@globalVar?.Website",
        email: "@globalVar?.Email",
        phone: "@globalVar?.Phone"
    };

    window.database = {
        db: "@ViewBag.DatabaseName"
    };
</script>