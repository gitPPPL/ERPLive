<script src="~/js/GlobalValidation.js" asp-append-version="true"></script>

<script>
    
    const AllFieldsId = [
        "TxtDocId",
        "NumDocNo",
        "DtDocumentDate",
        "ddlInsuranceType",
        "ddlBillType",
        "NumFrombillNo",
        "NumTobillNo"
    ];

    let itemRecords = [
        'TxtCode',
        'ddlItemname',
        'TxtNos',
        'TxtWeight',
        'TxtRate',
        'ddlTenacity',
        'DtDeliveryDate',
        'TxtRemarks'
    ];

    var LoginDate=@logindate;
    console.log(LoginDate);
    let docId = "";
    let readOnly;

    function getQueryParam(param) {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(param);
    }

    $(async function () {
        try {
            handleDocLoad();
        } catch (error) {
            toastr.error('Failed to load document types: ' + error);
        }
    });

    $(document).ready(function () {
    GetInsuranceTypeList();
    GetBillTypeList();
    // $("#DtDocumentDate").attr("max", loginDate);
    setEnterKeyFocus(AllFieldsId);
          
    $('#btn-save').on('click', async function (e) {
          e.preventDefault();

          if (!validateRequiredField('#NumDocNo', 'Document No.')) return;
          if (!validateRequiredField('#DtDocumentDate', 'Document Date')) return;
          if (!validateRequiredField('#ddlInsuranceType', 'Insurance Type')) return;
          if (!validateRequiredField('#ddlBillType', 'Bill Type')) return;
          if (!validateRequiredField('#NumFrombillNo', 'From billNo')) return;
          if (!validateRequiredField('#NumTobillNo', 'To bill No')) return;

        try
        {
            const tableData = await collectFormData();
            console.log(tableData);
            if (docId) {
                UpdateData(tableData);
            } else {
                SaveData(tableData);
            }
        } catch (error) {
            toastr.error('An error occurred while saving the data.');
        }
    });
    

    });

</script>

<script>

    async function handleDocLoad() {
         docId = getQueryParam('id');
         readOnly = getQueryParam('readOnly');
        console.log(docId, readOnly);
        if (docId) {
            $('#SaudaDetail').show();
            $('#ddlStatus').prop('disabled', false);
            await GetDocData(docId, readOnly);
        } else {
            GetDocid();
        }
    }
        
    async function GetDocData(MasterTblId, readOnly) {
        try {
            const response = await $.ajax({
                url: '/InsuranceCoverNote/GetSalesOrderForUpdate',
                type: 'GET',
                data: { id: MasterTblId }
            });

            if (response.status) {
                if (readOnly === 'true') {
                    disableAllFields();
                    $('.btn-add-row-last').hide();
                    $('#btn-save, #cancelBtn').hide();
                } else {
                    enableAllFields();
                    $('#btn-save, #cancelBtn').show();
                    $('.btn-add-row-last').show();

                }
                console.log(response.data);
                await fillFormFields(response.data);
               

            } else {
                toastr.error('No data returned.');
            }
        } catch (error) {
            toastr.error('Failed to load data.');
            toastr.error(error);
        }
    }

    function enableAllFields() {
      AllFieldsId.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.disabled = false;
      });
    }

    function disableAllFields() {
      AllFieldsId.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.disabled = true;
      });
    }

    function SaveData(saveDt) {
                $.ajax({
                    url: '@Url.Action("SaveOrUpdateInsuCoverNoteMast", "InsuranceCoverNote")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(saveDt),
                    success: function (response) {
                        if (response?.status) {
                            // showFlashMessageByKey('insert', 'success');
                            toastr.success("Data Insert Successfully");
                            // resetFields();
                            setTimeout(() => {
                                window.location.href = '/InsuranceCoverNoteList/Index';
                            }, 500);
                        } else {
                            toastr.error(response?.message || "Save failed. Please try again.");
                        }
                    },
                    error: function () {
                        toastr.error("Error occurred while saving. Please contact admin.");
                    }
                });
    }

    function UpdateData(UpdateDt) {
        $.ajax({
            url: '@Url.Action("SaveOrUpdateInsuCoverNoteMast", "InsuranceCoverNote")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(UpdateDt),
            dataType: 'json',
            success: function (response) {
                if (response?.status) {
                    showFlashMessageByKey('update', 'success');
                    // resetFields();
                    setTimeout(() => {
                        window.location.href = '/InsuranceCoverNoteList/Index';
                    }, 1500);
                } else {
                    toastr.error("Update failed: " + (response?.message || "Unknown error."));
                }
            },
            error: function (xhr, status, error) {
                toastr.error("Data not updated: " + error);
            }
        });
    }      

    async function fillFormFields(data) {
        if (!Array.isArray(data) || data.length === 0) {
            toastr.error("Invalid or empty data array");
            return;
        }
        const d = data[0];
        document.getElementById("TxtDocId").value = d.DOC_ID || '';
        document.getElementById("NumDocNo").value = d.V_NO || '';
        document.getElementById("DtDocumentDate").value = formatDate(d.V_DATE) || '';
        document.getElementById("ddlInsuranceType").value = d.INSU_CODE || '';
        document.getElementById("ddlBillType").value = d.BILL_TYPE || '';
        document.getElementById("NumFrombillNo").value = d.F_BILL_NO || '';
        document.getElementById("NumTobillNo").value = d.T_BILL_NO || '';
    }

    async function collectFormData() {        
        const strdocId = toNullableString(document.getElementById("TxtDocId")?.value);
        const vNo = parseIntSafe(document.getElementById("NumDocNo")?.value);
        const vDate = toNullableDate(document.getElementById("DtDocumentDate")?.value);
        const insuCode = parseIntSafe(document.getElementById("ddlInsuranceType")?.value);
        const billType = toNullableString(document.getElementById("ddlBillType")?.value);
        const fBillNo = parseIntSafe(document.getElementById("NumFrombillNo")?.value);
        const tBillNo = parseIntSafe(document.getElementById("NumTobillNo")?.value);
        const saveOrUpdate = !docId ? "Save" : "Update";

        return {
            DocId: strdocId,
            VNo: vNo,
            VDate: vDate,
            InsuCode: insuCode,
            VType: "INSU",
            BillType: billType,
            FBillNo: fBillNo,
            TBillNo: tBillNo,
            Srno: null,
            SaveOrUpdate: saveOrUpdate
        };
    }
 
    function GetDocid() {
        $.ajax({
            url: '@Url.Action("GetMaxVNo", "InsuranceCoverNote")',
            type: 'GET',
            data:{V_type:'INSU'},
            success: function (response) {
                if (response.status === true && response.data) {
                    $('#NumDocNo').val(response.data.vNo || '');
                    $('#TxtDocId').val(response.data.docId || '');
                } else {
                    $('#NumDocNo').val('');
                    $('#TxtDocId').val('');
                }
            },
            error: function (xhr, status, error) {
                toastr.error('Error fetching Doc ID:', error);
            }
        });
    }
    
    function GetInsuranceTypeList() {
        $.ajax({
            url: '@Url.Action("GetInsuranceType", "InsuranceCoverNote")',
            type: 'GET',
            dataType: 'json',
            success: function (response) {
                if (response.status) {
                    const $DropdownId = $('#ddlInsuranceType');
                    $DropdownId.empty();
                    $DropdownId.append('<option value="">- Select -</option>');
                    $.each(response.data, function (index, item) {
                        $DropdownId.append(`<option value="${item.CODE}">${item.NAME}</option>`);
                    });

                } else {
                    toastr.error("data Load failed");
                }
            },
            error: function (xhr, status, error) {
                toastr.error("data Load failed", error);
            }
        });
    }

    function GetBillTypeList() {
        $.ajax({
            url: '@Url.Action("GetBillTypeList", "InsuranceCoverNote")',
            type: 'GET',
            dataType: 'json',
            success: function (response) {
                if (response.status) {
                    const $DropdownId = $('#ddlBillType');
                    $DropdownId.empty();
                    $DropdownId.append('<option value="">- Select -</option>');
                    $.each(response.data, function (index, item) {
                        $DropdownId.append(`<option value="${item.CODE}">${item.NAME}</option>`);
                    });

                } else {
                    toastr.error("data Load failed");
                }
            },
            error: function (xhr, status, error) {
                toastr.error("data Load failed", error);
            }
        });
    }
  
    function formatDate(dateStr) {
      if (!dateStr) return '';
      const d = new Date(dateStr);
      return d.toISOString().split('T')[0];
    }

    function parseIntSafe(value) {
        const parsed = parseInt(value, 10);
        return isNaN(parsed) ? null : parsed;
    }

    function parseFloatSafe(value) {
        const parsed = parseFloat(value);
        return isNaN(parsed) ? null : parsed;
    }

     function parseDate(dateStr) {
        if (!dateStr) return null;
        const parts = dateStr.split(/[-\/]/);
        if (parts.length === 3) {
            let [day, month, year] = parts.map(p => parseInt(p, 10));
            if (year < 1000) year += 2000;
            return new Date(year, month - 1, day);
        }
        return null;
     }

    function toNullableInt(val) {
        const parsed = parseInt(val);
        return isNaN(parsed) ? null : parsed;
    }

    function toNullableDate(val) {
        const date = new Date(val);
        return isNaN(date.getTime()) ? null : val;
    }

    function toNullableString(val) {
      return val?.trim() || null;
    }

    function toNullableDate(val) {
        const date = new Date(val);
        return isNaN(date.getTime()) ? null : date.toISOString(); // if server expects ISO string
    }

    function allowOnlyNumbers(input) {
      input.value = input.value
        .replace(/[^0-9.]/g, '')
        .replace(/(\..*)\./g, '$1');
    }

    function setFieldsEnabled(enabled) {
      AllFieldsId.forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          el.disabled = !enabled;
        }
      });
    }

     function setEnterKeyFocus(sequence) {
               sequence.forEach((id, index) => {
                   $(`#${id}`).on('keypress', function (e) {
                       if (e.key === 'Enter') {
                           e.preventDefault();
                           if (index + 1 < sequence.length) {
                               $(`#${sequence[index + 1]}`).focus();
                           }
                       }
                   });
               });
     }

    function setEnterKeyFocusOnTable(sequence, rowCount) {
        sequence.forEach((id, index) => {
            let elementId = `#${id}${rowCount}`;
            $(document).on('keydown', elementId, function (e) {
                if (e.key === 'Enter' || e.key === 'Tab' || e.keyCode === 13 || e.keyCode === 9) {
                    e.preventDefault();

                    let nextIndex = index + 1;
                    if (nextIndex < sequence.length) {
                        let nextElementId = `#${sequence[nextIndex]}${rowCount}`;
                        if ($(nextElementId).length) {
                            $(nextElementId).focus();
                        }
                    } else {

                        addItemRecordRow();
                        setEnterKeyFocus(sequence, rowCount + 1);
                        $(`#${sequence[0]}${rowCount + 1}`).focus();
                    }
                }
            });
        });
    }


</script>



