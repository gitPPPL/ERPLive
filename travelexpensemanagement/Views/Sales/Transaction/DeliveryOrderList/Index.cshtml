@{
	ViewBag.Title = "Delivery Order List";
	Layout = "~/Views/Shared/_Layout.cshtml";

}

<div id="erp-toast-container"></div>
<div class="erppagelist-header">
	<div class="erppagelist-title">
		<i class="fa fa-list"></i>
		<span>Delivery Order</span>
	</div>
	<div class="erppagelist-header-right">
		<button class="erppage-header-back" id="button_add" onclick="window.location.href='@Url.Action("Index", "DeliveryOrder")'">
			<i class="fa fa-plus"></i>Add New
		</button>
	</div>
</div>
<div class="erppagelist-toolbar">
	<div class="erppagelist-search-wrapper">
		<i class="fa fa-search"></i>
		<input type="text" id="searchBox" placeholder="Search Module..." />
	</div>
	<div class="erppagelist-actions">
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" id="button_export" data-tooltip="Export to Excel">
			<i class="fa fa-file-excel"></i> Export
		</button>
		<button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail">
			<i class="fa fa-envelope"></i> Mail
		</button>
	</div>
</div>
<div class="erppagelist-container">
	<div class="excel-wrapper fixed-grid-wrapper">
		<table id="tblDeliveryOrder" class="excel-table fixed-grid-table table-width resizable-table">
			<colgroup>
				<col style="width: 67px;">  <!-- VTYPE -->
				<col style="width: 84px;">   <!-- VNO -->
				<col style="width: 90px;">   <!-- VDATE -->
				<col style="width: 90px;">   <!-- DEL DATE -->
				<col style="width: 150px;">  <!-- BILL NAME -->
				<col style="width: 232px;">  <!-- BILL ADD1 -->
				<col style="width: 120px;">  <!-- BILL ADD2 -->
				<col style="width: 120px;">  <!-- BILL ADD3 -->
				<col style="width: 100px;">  <!-- BILL CITY -->
				<col style="width: 108px;">   <!-- AGENT CODE -->
				<col style="width: 150px;">  <!-- SHIP NAME -->
				<col style="width: 120px;">  <!-- SHIP ADD1 -->
				<col style="width: 120px;">  <!-- SHIP ADD2 -->
				<col style="width: 120px;">  <!-- SHIP ADD3 -->
				<col style="width: 100px;">  <!-- SHIP CITY -->
				<col style="width: 90px;">   <!-- TAX CODE -->
				<col style="width: 100px;">  <!-- ITEM TYPE -->
				<col style="width: 100px;">  <!-- AMOUNT -->
				<col style="width: 90px;">   <!-- PACK PER -->
				<col style="width: 100px;">  <!-- PACK AMT -->
				<col style="width: 100px;">  <!-- TOT NET -->
				<col class="action-col">     <!-- Action -->
			</colgroup>

			<thead>
				<tr>
					<th>VTYPE</th>
					<th>VNO</th>
					<th>VDATE</th>
					<th>DEL DATE</th>
					<th>BILL NAME</th>
					<th>BILL ADD1</th>
					<th>BILL ADD2</th>
					<th>BILL ADD3</th>
					<th>BILL CITY</th>
					<th>AGENT CODE</th>
					<th>SHIP NAME</th>
					<th>SHIP ADD1</th>
					<th>SHIP ADD2</th>
					<th>SHIP ADD3</th>
					<th>SHIP CITY</th>
					<th>TAX CODE</th>
					<th>ITEM TYPE</th>
					<th>AMOUNT</th>
					<th>PACK PER</th>
					<th>PACK AMT</th>
					<th>TOT NET</th>
					<th class="action-col">Action</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>
	<div class="erppagelist-pagination">
		<div class="pagination-left">
			<select id="pageSizeSelect">
				<option value="5">5</option>
				<option value="10" selected>10</option>
				<option value="20">20</option>
				<option value="50">50</option>
			</select>
		</div>
		<div class="pagination-center">
			<button class="page-nav" id="prevBtn">‹</button>
			<div id="tablePagination" class="page-numbers"></div>
			<button class="page-nav" id="nextBtn">›</button>
		</div>
		<div class="pagination-right" id="pageInfoText">
			Results: 0 - 0 of 0
		</div>
	</div>
</div>

<script src="~/common/pagination.js"></script>
<script src="~/js/erpjs/sales/transaction/deliveryorderlistjs/deliveryorderlist.js"></script>