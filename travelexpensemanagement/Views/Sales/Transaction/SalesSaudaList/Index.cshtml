@{
    ViewBag.Title = "Sales Sauda List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentMenu = ViewBag.CurrentMenu as string;
}
<div id="erp-toast-container"></div>
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>Sales Sauda List</span>
    </div>
    <div class="erppagelist-header-right">
        <button class="erppage-header-back" onclick="window.location.href='@Url.Action("Index", "SalesSaudaEntry")'">
            <i class="fa fa-plus"></i>Add New
        </button>
    </div>
</div>
<div class="erppagelist-toolbar">
    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" id="searchBox" placeholder="Search Module..." />
    </div>
    <div class="erppagelist-actions">
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" id="button_print" data-tooltip="Print Report">
            <i class="fa fa-print"></i> Print
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Export to Excel" id="button_export">
            <i class="fa fa-file-excel"></i> Export
        </button>
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail" id="button_mail">
            <i class="fa fa-envelope"></i> Mail
        </button>
        <button class="erppagelist-btn erppagelist-btn-approve tooltip-btn"
                data-tooltip="Approve Records" id="button_approval">
            <i class="fa fa-check-circle"></i> Approved
        </button>
    </div>
</div>
<div class="erppagelist-container">
    <div class="excel-wrapper fixed-grid-wrapper">
        <table id="tblSalesSaudaList" class="excel-table fixed-grid-table table-width resizable-table">
            <colgroup>
                <col style="width: 61px;">   
                <col style="width: 75px;">   
                <col style="width: 150px;">  
                <col style="width: 100px;">  
                <col style="width: 120px;">  
                <col style="width: 150px;">  
                <col style="width: 120px;">  
                <col style="width: 80px;">   
                <col style="width: 80px;">   
                <col style="width: 150px;">  
                <col class="action-col"> 
            </colgroup>
            <thead>
                <tr>
                    <th>Sr. No</th>
                    <th>Date</th>
                    <th>Customer Name</th>
                    <th>City</th>
                    <th>Phone</th>
                    <th>Deliver To</th>
                    <th>Item Name</th>
                    <th>Type</th>
                    <th>Pino</th>
                    <th>Remarks</th>
                    <th class="action-col">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    <div class="erppagelist-pagination">
        <div class="pagination-left">
            <select id="pageSizeSelect">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="pagination-center">
            <button class="page-nav" id="prevBtn">‹</button>
            <div id="tablePagination" class="page-numbers"></div>
            <button class="page-nav" id="nextBtn">›</button>
        </div>
        <div class="pagination-right" id="pageInfoText">
            Results: 0 - 0 of 0
        </div>
    </div>
</div>

<script src="~/common/pagination.js"></script>
<script src="~/common/delete.js"></script>
<script src="~/js/erpjs/sales/transaction/salessaudaentrylistjs/salesaudaentrylist.js"></script>