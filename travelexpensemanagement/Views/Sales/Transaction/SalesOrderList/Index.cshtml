@{
    ViewBag.Title = "Sales Order List";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<div id="erp-toast-container"></div>
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-list"></i>
        <span>Sales Order List</span>
    </div>
    <div class="erppagelist-header-right">
        <button class="erppage-header-back" onclick="window.location.href='@Url.Action("Index", "SalesOrder")'" id="button_add">
            <i class="fa fa-plus"></i>Add New
        </button>
    </div>
</div>
<div class="erppagelist-toolbar">
    <div class="erppagelist-search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" id="searchBox" placeholder="Search Module..." />
    </div>
    <div class="erppagelist-actions">
        @* <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" id="button_print" onclick="callGetReportAsPdf()" data-tooltip="Print Report">
            <i class="fa fa-print"></i> Print
        </button> *@
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" onclick="exportToExcel()" data-tooltip="Export to Excel" id="button_export">
            <i class="fa fa-file-excel"></i> Export
        </button>
        @* <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Send Mail" id="button_mail">
            <i class="fa fa-envelope"></i> Mail
        </button> *@
    </div>
</div>
<div class="erppagelist-container">
    <div class="excel-wrapper fixed-grid-wrapper">
        <table id="tblSalesOrderList" class="excel-table fixed-grid-table table-width resizable-table">
            <colgroup>
                <col style="width: 100px;">
                <col style="width: 91px;">
                <col style="width: 348px;">
                <col style="width: 131px;">
                <col style="width: 165px;">
                <col style="width: 110px;">
                <col class="action-col" style="width: 120px;">
            </colgroup>
            <thead>
                <tr>
                    <th>Order No</th>
                    <th>Date</th>
                    <th>Customer Name</th>
                    <th>Delivery Period</th>
                    <th>Delivery To</th>
                    <th>Sauda No</th>
                    <th class="action-col">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    <div class="erppagelist-pagination">
        <div class="pagination-left">
            <select id="pageSizeSelect" onchange="changeRowsPerPage()">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="pagination-center">
            <button onclick="Pagination.prev()" class="page-nav" id="prevBtn">‹</button>
            <div id="pageNumbers" class="page-numbers"></div>

            <button onclick="Pagination.next()" class="page-nav" id="nextBtn">›</button>
        </div>
        <div class="pagination-right" id="pageInfoText">
            Results: 0 - 0 of 0
        </div>
    </div>
</div>

<script src="~/common/delete.js"></script>
<script src="~/common/pagination.js"></script>
<script src="~/js/erpjs/sales/transaction/salesorderlist/salesorderlist.js"></script>
