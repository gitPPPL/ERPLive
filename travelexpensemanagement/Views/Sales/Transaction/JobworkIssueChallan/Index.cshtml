                                data-cityName="${item.CityName}"
                                data-gstin="${item.GSTIN}"
                                data-cityCd="${item.CITY_CODE}"
                                data-pinCd="${item.PINCODE}"
                        value="${item.CODE}">${item.NAME}
                        </option>`);
