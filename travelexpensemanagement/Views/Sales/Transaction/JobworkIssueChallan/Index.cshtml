    async function fillItemDetailsTable(data) {
        if (!Array.isArray(data)) {
            data = Object.values(data);
        }
        const $tbody = $('#tblJobworkIssueChallan tbody');
        $tbody.empty();

        for (let i = 0; i < data.length; i++) {

            const item = data[i];
            const idx = i + 1;

            
            addItemRecordRow();
            await bindDropdownData(idx);
             
            $(`#ddlItemname${idx}`).val(item.ITEM_CODE).trigger('change');
            $(`#hsn${idx}`).val(item.HSN_CODE ?? '');

            $(`#TxtNos${idx}`).val(item.NOS ?? 0);
            $(`#TxtgrossQuantity${idx}`).val(item.GROSS_QTY ?? 0);
            $(`#TxtNQty${idx}`).val(item.QTY ?? 0);

            $(`#rateUSD${idx}`).val(item.FOR_RATE ?? 0);
            $(`#TxtRateRs${idx}`).val(item.RATE ?? 0);
            $(`#TxtAmount${idx}`).val(item.AMOUNT ?? 0);

            $(`#TxtPackPercent${idx}`).val(item.PACK_PER ?? 0);
            $(`#TxtPack${idx}`).val(item.PACK_AMT ?? 0);

            $(`#TxtDiscPercent${idx}`).val(item.DISC_PER ?? 0);
            $(`#TxtDisc${idx}`).val(item.DISC_AMT ?? 0);
            $(`#cTxtDisc${idx}`).val(item.CDISC_AMT ?? 0);

            $(`#ddlTax${idx}`).val(item.TAX_CODE ?? '').trigger('change');

            $(`#TxtCgstPercent${idx}`).val(item.CGST_PER ?? 0);
            $(`#TxtCgst${idx}`).val(item.CGST_AMT ?? 0);

            $(`#TxtSgstPercent${idx}`).val(item.SGST_PER ?? 0);
            $(`#TxtSgst${idx}`).val(item.SGST_AMT ?? 0);

            $(`#TxtIgstPercent${idx}`).val(item.IGST_PER ?? 0);
            $(`#TxtIgst${idx}`).val(item.IGST_AMT ?? 0);

            $(`#TxtCessPercent${idx}`).val(item.CESS_PER ?? 0);
            $(`#TxtCess${idx}`).val(item.CESS_AMT ?? 0);

            $(`#freightAmount${idx}`).val(item.FRT_AMT ?? 0);
            $(`#insuAmount${idx}`).val(item.INSU_AMT ?? 0);

            $(`#packNo${idx}`).val(item.PACK_NO ?? 0);
            $(`#lotNo${idx}`).val(item.LOT_No ?? '');
            $(`#remark${idx}`).val(item.REMARK ?? '');

            $(`#saudaType${idx}`).val(item.SAUDA_TYPE ?? '');
            $(`#saudaNo${idx}`).val(item.SAUDA_NO ?? 0);
            $(`#saudaRate${idx}`).val(item.SAUDA_RATE ?? 0);

            $(`#orderType${idx}`).val(item.ORD_TYPE ?? '');
            $(`#orderNo${idx}`).val(item.ORD_NO ?? 0);
            $(`#orderRate${idx}`).val(item.ORD_RATE ?? 0);

            $(`#dcnType${idx}`).val(item.DCN_TYPE ?? '');
            $(`#dcnNo${idx}`).val(item.DCN_NO ?? 0);

            $(`#wbQuantity${idx}`).val(item.WBQTY ?? 0);
        }
    }

