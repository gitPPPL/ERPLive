    async function collectOrder2Items() {
      const items = [];

      $('#tblJobworkIssueChallan tbody tr').each(function () {
        const $row = $(this);
        const rowId = $row.attr('id');

        if (!rowId) return; // safety

        const idx = rowId.replace('row', '');

        items.push({
          // Required
          SNO: parseIntSafe(idx),
          ROW_ID: rowId,

          // Item
          ITEM_CODE: parseIntSafe($(`#ddlItemname${idx}`).val()),
          ITEM_NAME: $(`#ddlItemname${idx} option:selected`).text() || null,
          PROD_DESC: null,

          // Unit / HSN
          UNIT_CODE: null,
          UNIT_NAME: null,
          HSN_CODE: $(`#hsn${idx}`).val() || null,

          // Quantities
          NOS: parseIntSafe($(`#TxtNos${idx}`).val()),
          QTY: parseFloatSafe($(`#TxtNQty${idx}`).val()),
          GROSS_QTY: parseFloatSafe($(`#TxtgrossQuantity${idx}`).val()),
          GATE_QTY: null,
          WBQTY: parseFloatSafe($(`#wbQuantity${idx}`).val()),
          GATE_INQTY: null,

          // Rates
          RATE: parseFloatSafe($(`#TxtRateRs${idx}`).val()),
          FOR_RATE: parseFloatSafe($(`#rateUSD${idx}`).val()),
          AMOUNT: parseFloatSafe($(`#TxtAmount${idx}`).val()),

          // Packing
          PACK_PER: parseFloatSafe($(`#TxtPackPercent${idx}`).val()),
          PACK_AMT: parseFloatSafe($(`#TxtPack${idx}`).val()),
          PACK_NO: parseIntSafe($(`#packNo${idx}`).val()),
          PACK_TYPE: null,

          // Discount
          DISC_PER: parseFloatSafe($(`#TxtDiscPercent${idx}`).val()),
          DISC_AMT: parseFloatSafe($(`#TxtDisc${idx}`).val()),
          CDISC_AMT: parseFloatSafe($(`#cTxtDisc${idx}`).val()),

          // Tax
          TAX_CODE: parseIntSafe($(`#ddlTax${idx}`).val()),
          CGST_PER: parseFloatSafe($(`#TxtCgstPercent${idx}`).val()),
          CGST_AMT: parseFloatSafe($(`#TxtCgst${idx}`).val()),
          SGST_PER: parseFloatSafe($(`#TxtSgstPercent${idx}`).val()),
          SGST_AMT: parseFloatSafe($(`#TxtSgst${idx}`).val()),
          IGST_PER: parseFloatSafe($(`#TxtIgstPercent${idx}`).val()),
          IGST_AMT: parseFloatSafe($(`#TxtIgst${idx}`).val()),
          CESS_PER: parseFloatSafe($(`#TxtCessPercent${idx}`).val()),
          CESS_AMT: parseFloatSafe($(`#TxtCess${idx}`).val()),

          // Charges
          INSU_AMT: parseFloatSafe($(`#insuAmount${idx}`).val()),
          FRT_AMT: parseFloatSafe($(`#freightAmount${idx}`).val()),
          FREIGHT_AMT: parseFloatSafe($(`#freightAmount${idx}`).val()),

          // Order
          ORD_TYPE: $(`#orderType${idx}`).val() || null,
          ORD_NO: parseIntSafe($(`#orderNo${idx}`).val()),
          ORD_RATE: parseFloatSafe($(`#orderRate${idx}`).val()),

          // Sauda
          SAUDA_TYPE: $(`#saudaType${idx}`).val() || null,
          SAUDA_NO: parseIntSafe($(`#saudaNo${idx}`).val()),
          SAUDA_RATE: parseFloatSafe($(`#saudaRate${idx}`).val()),

          // DCN
          DCN_TYPE: $(`#dcnType${idx}`).val() || null,
          DCN_NO: parseIntSafe($(`#dcnNo${idx}`).val()),

          // Misc
          LOT_No: $(`#lotNo${idx}`).val() || null,
          REMARK: $(`#remark${idx}`).val() || null,
          LAND_RATE: null,
          LAND_AMT: null,
          FEXCH_USD: null,
          MIS_GROUP: null,

          FINAL_LOCK: null,
          STATUS: null,
          DEPT_CODE: null
        });
      });

      return items;
    }



