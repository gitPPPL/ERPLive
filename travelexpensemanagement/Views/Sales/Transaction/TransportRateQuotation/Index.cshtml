

@using System.Text.Json

@{
      ViewBag.Title = "Transport Quotation Approval";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var globalVariables = ViewBag.GlobalVariables as Models.UserSessionData ?? new Models.UserSessionData();
    var databaseName = ViewBag.DatabaseName as string ?? "";
    var CompCode = int.TryParse(globalVariables.PubCompCode, out var parsedCompCode) ? parsedCompCode : 0;
    var PubUserLevel = int.TryParse(globalVariables.PubUserLevel, out var parsedPubUserLevel) ? parsedPubUserLevel : 0;
    var logindate = globalVariables.PubLoginDate is DateTime date ? date.ToString("yyyy-MM-dd") : "";
    var LoadGeneralSetting = ViewBag.LoadGeneralSetting;
}

 <script>
    window.globalVariables = @Html.Raw(JsonSerializer.Serialize(new {
        CompCode = int.TryParse(globalVariables.PubCompCode, out var c) ? c : 0,
        UserId = globalVariables.PubUserId,
        UserName = globalVariables.PubUserName,
        UserLevel = int.TryParse(globalVariables.PubUserLevel, out var ul) ? ul : 0,
        FYearCode = globalVariables.PubFYearCode,
        BranchCode = globalVariables.PubBranchCode,
        LoginDate = globalVariables.PubLoginDate.ToString("yyyy-MM-dd"),
        CompanyName = globalVariables.CompanyName,
        Address1 = globalVariables.Address1,
        Address2 = globalVariables.Address2,
        GST = globalVariables.gstin,
        PAN = globalVariables.PAN,
        Phone = globalVariables.Phone,
        Email = globalVariables.Email,
        ICE = globalVariables.IEC,
        website = globalVariables.Website,
        RegAdd1 = globalVariables.RegAdd1,
        RegAdd2 = globalVariables.RegAdd2,
        CINNO = globalVariables.CINNO

    }));

        var LoadGeneralSetting = @Html.Raw( JsonSerializer.Serialize(ViewBag.LoadGeneralSetting)
    );


    window.database = @Html.Raw(JsonSerializer.Serialize(databaseName));
</script> 

 <div id="erp-toast-container"></div>
 <div class="erppage-header">

        <div class="erppage-header-left">
            <div class="erppage-header-icon">
                <i class="fa fa-file-invoice-dollar"></i>
            </div>
            <div class="erppage-header-title">Transport Rate Quotation</div>
        </div>

        <div class="erppage-header-right">
          
            <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "TransportRateQuotationList")', isReadOnly)">
                <i class="fa-solid fa-arrow-left"></i>Back to list
            </button>  

        </div>
    </div>
 <div class="erppage-container">
    <div id="TransportRateQuotationForm">
     
        <input type="hidden" class="form-control" id="TxtCode" name="CODE">
        <input type="hidden" class="form-control" id="Vtpye" >

          <fieldset class="fieldset-sub">         

                <div class="erppage-grid3">
                   <div class="erppage-divfield">     
                            <label for="NumDocumentNo">Document No</label>
                            <input type="number" class="form-control" id="NumDocumentNo" placeholder="Enter Document No" readonly>
                    </div>

                        <div class="erppage-divfield">  
         
                            <label for="DtDocumentDate">Document Date</label>
                            <input type="date" class="form-control" id="DtDocumentDate">
             
                    </div>
                      <div class="erppage-divfield">  

                            <label for="ddlDONo">DO No</label>
                            <select class="form-control" id="ddlDONo">
                                <option value="">Select DO No</option>
                            </select>

                    </div>
                     
           
                </div>

                <div class="erppage-grid3">
                   <div class="erppage-divfield">                  
                        <label for="TxtBillTo">Bill To</label>
                        <select class="form-control" id="TxtBillTo">
                            <option value="">Select DO No</option>
                        </select>
                   </div>
                </div>

                <div class="erppage-grid3">
                
                    <div class="erppage-divfield">    
                            <label for="TxtAddressL1">Address L1</label>
                            <textarea typeof="text" class="form-control" id="TxtAddressL1" placeholder="Enter Address L1"readonly ></textarea>
                    </div>

                     <div class="erppage-divfield">             
                            <label for="TxtAddressL2">Address L2</label>
                            <textarea typeof="text" class="form-control" id="TxtAddressL2" placeholder="Enter Address L2" readonly></textarea>
         
                    </div>
                    <div class="erppage-divfield">                  
                            <label for="TxtAddressL3">Address L3</label>
                            <textarea typeof="text" class="form-control" id="TxtAddressL3" placeholder="Enter Address L3" readonly></textarea>
                    </div>                         
                </div>

                <div class="erppage-grid4">
                    <div class="erppage-divfield">               
                                <label for="TxtCity">City</label>
                                <select class="form-control" id="DDlCityname">
                                    <option value="">Select City Name</option>
                                </select>            
                        </div>

                    <div class="erppage-divfield"> 
              
                                <label for="NumQuantity">Quantity</label>
                                <input type="number" class="form-control" id="NumQuantity" placeholder="Enter Quantity"/>
                  
                        </div>
    
                    <div class="erppage-divfield">              
                                <label>Mobile No.</label>
                                <div class="input-icon-wrapper">
                                    <input type="number" class="form-control" id="NumMobile">
                                    <span class="input-icon" id="Btn_Whatsapp"><i class="fab fa-whatsapp" style="font-size: 18px;color: #25d366;margin-right: 6px;"></i> Whatsapp</span>
                                </div>         
                        </div>
      
                    <div class="erppage-divfield">                       
                                <label for="TxtRemarks">Remarks</label>
                                <textarea typeof="text" class="form-control" id="TxtRemarks" placeholder="Enter Remarks"></textarea>                 
                        </div>                 

                </div>
        
                <div class="erppage-grid4">
                    <div class="erppage-divfield"> 
                        <div class="button-right btn-mt">
                            <button type="button" class="btn btn-success" id="btn_load"><i class="fa fa-download"></i> Load Transports</button>
                        </div>
                    </div>
                </div>

          </fieldset>
          
          <div class="card">
            <div class="table-responsive">
                <table id="tblTransportRateQuotation" class="table-width">
                    <colgroup>
                        <col style="width: 10%;" />
                        <col style="width: 20%;" />
                        <col style="width: 10%;" />
                        <col style="width: 10%;" />
                        <col style="width: 15%;" />
                        <col style="width: 15%;" />
                        <col style="width: 15%;" />
                        <col style="width: 5%;" />
                    </colgroup>
                    <thead class="table-head">
                        <tr>
                            <th>Code</th>
                            <th>Transport name</th>
                            <th>Rate</th>
                            <th>Final Rate</th>
                            <th>Truck No</th>
                            <th>GR No</th>
                            <th>GR Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
    
        </div>
           
          <div class="erppage-actions">
                <button id="btn-save" type="submit" class="erppage-btn erppage-btn-save">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
                </button>
          </div>

    </div>
</div>

<script src="~/js/erpjs/sales/transaction/transportratequotation/transportratequotation.js"></script>
<script src="~/js/erpjs/sales/transaction/transportratequotation/transportratequotationapi.js"></script>
<script src="~/js/erpjs/sales/transaction/transportratequotation/transportratequotationinit.js"></script>