@{
    ViewBag.Title = "Sales Order";
    Layout = "~/Views/Shared/_Layout.cshtml";

   var logindate= Convert.ToDateTime(TempData["LoginDate"]).ToString("yyyy-MM-dd");
    var currentMenu = ViewBag.CurrentMenu as string;
    bool canAdd = false;
    bool canEdit = false;
    bool canDelete = false;
    bool canPrint = false;
    bool canExport = false;
    bool canMail = false;
    bool canApproval = false;
    bool canDocDetail = false;

    foreach (var permission in Model.UserMenuPermissions)
    {
        if (permission.MENU_NAME == ViewBag.CurrentMenu)
        {
            canAdd = Model.UserLevel == 1 || permission._ADD == 1;
            canEdit = Model.UserLevel == 1 || permission._EDIT == 1;
            canDelete = Model.UserLevel == 1 || permission._DELETE == 1;
            canPrint = Model.UserLevel == 1 || permission._PRINT == 1;
            canExport = Model.UserLevel == 1 || permission._EXPORT == 1;
            canMail = Model.UserLevel == 1 || permission._MAIL == 1;
            canApproval = Model.UserLevel == 1 || permission._APPROVAL == 1;
            canDocDetail = Model.UserLevel == 1 || permission._DOCDETAIL == 1;
            break;
        }
    }
}
<fieldset>
    <legend class="legend-field">Sales Order</legend>
    <form id="SalesOrderForm">
        <div class="row">
            <div class="offset-md-4 col-md-8">
                <div class="button-right">
                    @if(canPrint)
                    {
                        <button class="btn btn-print">
                            <i class="fa fa-print"></i> Print
                        </button>
                    }
                    @if(canExport)
                    {
                        <button class="btn btn-export">
                            <i class="fas fa-file-export"></i> Export
                        </button>
                    }
                    @if(canMail)
                    {
                        <button class="btn btn-mail">
                            <i class="fa fa-envelope"></i> Mail
                        </button>
                    }
                    @if(canApproval)
                    {
                        <button class="btn btn-send" type="button" onclick="popupModal()">
                            <i class="fa fa-paper-plane"></i> Approval Send
                        </button>
                    }                     
                    <button class="btn btn-approved">
                        <i class="fa fa-check"></i> Approved
                    </button>
                </div>
            </div>
        </div>
        <input type="hidden" class="form-control" id="TxtDocId">
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label for="NumDocNo">Doc No</label>
                    <input type="number" class="form-control" id="NumDocNo" placeholder="Enter Doc No" readonly />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label for="DtDocDate">Doc Date</label>
                    <input type="date" class="form-control" id="DtDocDate" value="@logindate">
                </div>
            </div>
            <div class="col-md-6">
                <div class="button-right btn-mt">
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#OrderAdjustmentModal"> Order Adjustment Detail</button>
                </div>
            </div>
        </div>
