<script src="~/js/GlobalValidation.js" asp-append-version="true"></script>

<script>
    const AllFieldsId = [    
    'TxtDocId', 'NumDocNo', 'DtDocDate',
    'ddlSaudaNo',
    'ddlBillTo',
    'TxtAddressL1',
    'ddladdressL1',
    'TxtAddressL2',
    'TxtAddressL3',
    'ddlCity',
    'NumPincode',
    'TxtGSTNo',
    'NumMobile',
    'TxtDelivery',
    'NumIssueNo',
    'ddlShipTo',
    'TxtAddressShipL1',
    'ddlShipaddressL1',
    'TxtAddressShipL2',
    'TxtAddressShipL3',
    'ddlShipCity',
    'NumShipPincode',
    'TxtShipGST',
    'NumContactNo',   
    'NumPackingNo',    
    'ddlPaymentTerm', 'TxtDeliveryPeriod',
    'ddlStatus'
    ];

    let itemRecords = [
        'TxtCode',
        'ddlItemname',
        'TxtNos',
        'TxtWeight',
        'TxtRate',
        'ddlTenacity',
        'DtDeliveryDate',
        'TxtRemarks'
    ];
      

    var LoginDate=@logindate;
    console.log(LoginDate);
    let docId = "";
    let readOnly;

    function getQueryParam(param) {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(param);
    }

    $(async function () {
        try {            
            handleDocLoad();
        } catch (error) {
            toastr.error('Failed to load document types: ' + error);
        }
    });
 
    $(document).ready(function () {
    GetBindSaudaNoList();
    GetPaymentTermList();
    GetBillToList();
    GetShipToList();
    GetCityList('ddlCity');
    GetCityList('ddlShipCity');


    $('#DtDocDate').attr('max', LoginDate);
    // handleDocLoad();
    addItemRecordRow();
    setEnterKeyFocus(AllFieldsId);

    $(document).on('click', '.btn-delete-action, .btn-Itemdelete-action', function () {
        var tbody = $(this).closest('tbody');
        var rowCount = tbody.find('tr').length;

        if (rowCount > 1) {
            $(this).closest('tr').remove();
        } else {
            alert('Cannot delete the first row.');
        }
    });
    
    // $(document).on('click', '#tab1 .btn-add-row, #tab1 .btn-Itemadd-action', function () {
    //     addItemRecordRow();
    // });
       
    $('#btn-save').on('click', async function (e) {
        e.preventDefault();

          // if (!validateRequiredField('#ddlPriceType', 'Price Type')) return;
          // if (!validateRequiredField('#ddlPlace', 'Place')) return;
          // if (!validateRequiredField('#ddlPartyName', 'Party Name')) return;
          // if (!validateRequiredField('#ddlShipFrom', 'Ship From')) return;

        try
        {
            const tableData = await collectFormData();
            console.log(tableData); 
            if (docId) {
                UpdateData(tableData);
            } else {
                SaveData(tableData);
            }
        } catch (error) {
            toastr.error('An error occurred while saving the data.');
        }
    });

    $(document).on('change', '#ddlSaudaNo', async function() {
        // console.log(docId);
        // if (!docId) return;
        // console.log('a');
        const saudaNo = $('#ddlSaudaNo').val();       
        try {
            const saudaList = await $.ajax({
                url: '@Url.Action("GetSaudaDataList", "SalesOrder")',
                type: 'GET',
                dataType: 'json',
                data: { saudaNo: saudaNo }
            });
             console.log(saudaList);
           await fillISaudaBySaudaNo(saudaList.data);
           await showSaudasDetails(saudaList.saudaDetails);

        } catch (error) {
            console.error('Error loading Sauda data:', error);
        }
    });

    $(document).on('click', '.btn-add-action, .btn-add-row', function () {
    addItemRecordRow();
    });

    $(document).on('change', '#ddladdressL1, #ddlShipaddressL1', function () {
        const selectedOption = $(this).find('option:selected');
        const dropdownId = $(this).attr('id');
        var cityCd=selectedOption.data('cityCd');
                
        if (dropdownId === 'ddladdressL1') {
            $('#TxtAdd1SD').val(selectedOption.text().trim());
            $('#TxtAdd2SD').val(selectedOption.data('add2'));
            $('#TxtAdd3SD').val(selectedOption.data('add3'));
            $('#NumPincode').val(selectedOption.data('pincd'));
            // $('#ddlCity').val(selectedOption.data('cityCd'));
            $('#TxtGSTNo').val(selectedOption.data('gstin'));
            $('#NumMobile').val(selectedOption.data('gstin'));
            GetCityList('ddlCity', cityCd);
             
        } else {
            $('#TxtAddressShipL1').val(selectedOption.text().trim());
