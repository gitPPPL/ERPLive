    async function fillISaudaDetailsTableBySaudaNo(data) {
        const todayDt=getTodayDate();
        const $tbody = $('#tblSalesOrderEntryModal tbody');
        $tbody.empty();        

        for (let index = 0; index < data.length; index++) {
            const item = data[index];
            const idx = index + 1;

            addItemRecordRow();
