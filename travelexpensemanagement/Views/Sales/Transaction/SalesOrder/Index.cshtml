@{
    ViewBag.Title = "Sales Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="erp-toast-container"></div>
<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon">
            <i class="fa fa-file-invoice"></i>
        </div>
        <div class="erppage-header-title">Sales Order Entry</div>
    </div>
    <div class="erppage-header-right">
        <button class="erppagelist-btn erppagelist-btn-action tooltip-btn" id="button_print" onclick="SalesOrderReport()" data-tooltip="Print Report">
            <i class="fa fa-print"></i> Print
        </button>
        <button type="button"
                id="btn_Sendapproval"
                style="display:none;" class="erppagebtn_sendapproval">
            <i class="fa fa-share"></i>Send For Approval
        </button>
        <button type="button"
                id="btn_Approved"
                style="display:none;"
                class="erppagebtn_approved">
            Approved
        </button>
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "SalesOrderList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>
</div>
<div class="erppage-container">
    <div class="erppage-fieldset">

        <div id="SalesOrderForm">
            @*  <div class="row">
                <div class="offset-md-4 col-md-8">
                    <div class="button-right">
                        
                            <button class="btn btn-print">
                                <i class="fa fa-print"></i> Print
                            </button>
                       
                            <button class="btn btn-export">
                                <i class="fas fa-file-export"></i> Export
                            </button>
                        
                            <button class="btn btn-mail">
                                <i class="fa fa-envelope"></i> Mail
                            </button>
                       
                            <button class="btn btn-send" type="button" onclick="popupModal()">
                                <i class="fa fa-paper-plane"></i> Approval Send
                            </button>
                        
                        <button class="btn btn-approved">
                            <i class="fa fa-check"></i> Approved
                        </button>
                    </div>
                </div>
            </div> *@
            <input type="hidden" class="form-control" id="TxtDocId">
            <div class="erppage-grid4">
                <div class="erppage-divfield">
                    <label class="erppage-label" for="NumDocNo">Doc No</label>
                    <input type="number" class="erppage-input" id="NumDocNo" placeholder="Enter Doc No" readonly />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label" for="DtDocDate">Doc Date</label>
                    <input type="date" class="erppage-input" id="DtDocDate">
                </div>
                @* <div class="erppage-divfield">
                </div> *@
                <div class="erppage-divfield">
                    <label class="erppage-label">Sauda No</label>
                    <div class="erppage-inputgroup">
                        <select class="erppage-input erppage-select" id="ddlSaudaNo">
                            <option>Select Sauda No.</option>
                        </select>
                        <button type="button" class="erppage-btn erppage-btn-common-print-disabled" onclick="getSaudaRate();" id="btnCalcRate">
                            <i class="fa fa-calculator"></i> Calculate Rate
                        </button>
                    </div>
                </div>
                <div class="erppage-divfield erppage-button-field">
                    <button type="button" class="erppage-btn erppage-btn-common-print-disabled" data-bs-toggle="modal" data-bs-target="#OrderAdjustmentModal" id="btnOrderAdjustmentDetails"
                    onclick="GetOrderAdjustment();">
                        Order Adjustment Detail
                    </button>
                </div>
            </div>
            @* Modal Popup *@
            <div class="modal fade" id="OrderAdjustmentModal" tabindex="-1" aria-labelledby="OrderAdjustmentLabel" aria-hidden="true">
                <div class="modal-dialog small-modal erppagesmodal">
                    <div class="modal-content erppagesmodal-content">
                        <div class="erppagesmodal-header">
                            <div class="erppagesmodal-header-left">
                                <div class="erppagesmodal-header-icon">
                                    <i class="fa fa-file-invoice"></i>
                                </div>
                                <h5 class="erppagesmodal-title" id="OrderAdjustmentLabel">
                                    Order Adjustment
                                </h5>
                            </div>
                            <button type="button" class="erppagesmodal-close" data-bs-dismiss="modal" aria-label="Close">
                                <i class="fa fa-times"></i>
                            </button>
                        </div>
                        <div class="erppagesmodal-body">
                            <div class="erppagelist-container">
                                <div class="excel-wrapper fixed-grid-wrapper">
                                    <table id="tblOrderAdjustmentModal" class="excel-table fixed-grid-table table-width resizable-table">
                                        <thead class="table-head">
                                            <tr>
                                                <th>Bill No</th>
                                                <th>Bill Date</th>
                                                <th>Item Name</th>
                                                <th>Quantity</th>
                                                <th class="hidden-col">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="erppagesrow">
                <div class="erppagescol-6">
                    <fieldset class="erppagefieldset">
                        <legend class="erppagefieldset-legend"><i class="fa fa-file-contract"></i> Billing Details</legend>
                        <div class="erppage-grid2">
                            @* <div class="erppage-divfield">
                                <label class="erppage-label">Sauda No</label>
                                <div class="erppage-inputgroup">
                                    <select class="erppage-input erppage-select" id="ddlSaudaNo">
                                        <option>Select Sauda No.</option>
                                    </select>
                                    <button type="button" class="erppage-btn erppage-btn-common-print-disabled" onclick="getSaudaRate();" id="btnCalcRate">
                                        <i class="fa fa-calculator"></i> Calculate Rate
                                    </button>
                                </div>
                            </div> *@
                            <div class="erppage-divfield">
                                <label class="erppage-label">Bill To</label>
                                <select class="erppage-input erppage-select" id="ddlBillTo">
                                    <option value="">Select Bill To</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label">Address L1</label>
                                <div class="erppage-inputgroup">
                                    <input type="text" class="erppage-input erppage-width-93" id="TxtAddressL1" placeholder="Enter Address L1" disabled maxlength="100">
                                    <select class="erppage-input erppage-select erppage-width-7" id="ddladdressL1">
                                        <option value="">Select address</option>
                                    </select>
                                </div>
                            </div>
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label">Address L2</label>
                                <textarea class="erppage-input" id="TxtAddressL2" placeholder="Enter Address L2" disabled maxlength="100"></textarea>
                            </div>

                        </div>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Address L3</label>
                                <textarea class="erppage-input" id="TxtAddressL3" placeholder="Enter Address L3" disabled maxlength="100"></textarea>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">City</label>
                                <select id="ddlCity" class="erppage-input erppage-select" disabled>
                                    <option value="">Select City</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Pincode</label>
                                <input type="number" class="erppage-input" id="NumPincode" disabled maxlength="10">
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">GST No.</label>
                                <input type="text" class="erppage-input" id="TxtGSTNo" disabled maxlength="15">
                            </div>
                        </div>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label">Mobile No.</label>
                                <input type="text" class="erppage-input" id="NumMobile" disabled maxlength="50">
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label" for="TxtDelivery">Delivery To</label>
                                <input type="text" class="erppage-input" id="TxtDelivery" maxlength="50">
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Delivery Period</label>
                                <input type="text" class="erppage-input" id="TxtDeliveryPeriod" maxlength="50">
                            </div>
                        </div>

                    </fieldset>
                </div>
                <div class="erppagescol-6">
                    <fieldset class="erppagefieldset">
                        <legend class="erppagefieldset-legend">
                            <i class="fa fa-truck"></i> Ship Details
                        </legend>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label">Issue No</label>
                                <div class="erppage-inputgroup">
                                    <select class="erppage-input erppage-select" id="ddlIssueNo">
                                        <option value="">Select Issue No</option>
                                    </select>
                                    <button type="button" class="erppage-btn erppage-btn-common-print-disabled" id="btnLoadIssueData">
                                        <i class="fa fa-refresh"></i> Load Issue Data
                                    </button>
                                </div>
                            </div>
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label">Ship To</label>
                                <select class="erppage-input erppage-select" id="ddlShipTo">
                                    <option value="">Select Ship To</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label">Address L1</label>
                                <div class="erppage-inputgroup">
                                    <input type="text" class="erppage-input erppage-width-93" id="TxtAddressShipL1" placeholder="Enter Address L1" disabled maxlength="100">
                                    <select class="erppage-input erppage-select erppage-width-7" id="ddlShipaddressL1">
                                        <option value="">Select address</option>
                                    </select>
                                </div>
                            </div>
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label">Address L2</label>
                                <textarea class="erppage-input" id="TxtAddressShipL2" placeholder="Enter Address L2" disabled maxlength="100"></textarea>
                            </div>
                        </div>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Address L3</label>
                                <textarea class="erppage-input" id="TxtAddressShipL3" placeholder="Enter Address L3" disabled maxlength="100"></textarea>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">City</label>
                                <select id="ddlShipCity" class="erppage-input erppage-select" disabled>
                                    <option value="">Select City</option>
                                </select>
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label">Pincode</label>
                                <input type="number" class="erppage-input" id="NumShipPincode" disabled maxlength="10">
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">GST</label>
                                <input type="text" class="erppage-input" id="TxtShipGST" disabled maxlength="15">
                            </div>
                        </div>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label">Contact No.</label>
                                <div class="erppage-inputgroup">
                                    <input type="text" class="erppage-input" id="NumContactNo" placeholder="Enter Contact No" maxlength="50">
                                    <button class="erppage-btn erppage-btn-common-print-disabled" type="button" id="btn_createdelivery" data-bs-toggle="modal" 
                                    data-bs-target="#CreateDeliveryModal">
                                        <i class="fa fa-plus"></i> Create Delivery Plan
                                    </button>
                                </div>
                            </div>
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label">Packing No.</label>
                                <div class="erppage-inputgroup">
                                    <select id="ddlPackingNo" class="erppage-input erppage-select">
                                        <option value="">Select Packing No</option>
                                    </select>
                                    <button class="erppage-btn erppage-btn-common-print-disabled" type="button" id="btn_loadpacking">
                                        <i class="fa fa-download"></i> Load Packing Data
                                    </button>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>

            </div>

            <!--There was delivery plan modal-->
            <div class="erppagesrow">
                <div class="erppagescol-6">
                    <fieldset class="erppagefieldset">
                        <legend class="erppagefieldset-legend">
                            <i class="fa fa-file-contract"></i> Sauda Details
                        </legend>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Party</label>
                                <input type="text" class="erppage-input" id="TxtParty" disabled />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Item Name</label>
                                <input type="text" class="erppage-input" id="TxtItemName" disabled />
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label">Quantity</label>
                                <input type="number" class="erppage-input" id="NumQuantity" disabled />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Rate</label>
                                <input type="number" class="erppage-input" id="NumRate" disabled />
                            </div>
                        </div>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label">Tenacity Group</label>
                                <input type="text" class="erppage-input" id="TxtTenaCity" disabled />
                            </div>
                            <div class="erppage-divfield erppage-button-field erppage-col-span-2">
                                <button type="button" class="erppage-btn erppage-btn-common-print-disabled" id="btn_linkedOrder" data-bs-toggle="modal" data-bs-target="#linkedorderModal"
                                        onclick="getLinkedOrders();">
                                    <i class="fa fa-link"></i> Linked Order
                                </button>
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="erppagescol-6">
                    <fieldset class="erppagefieldset">
                        <legend class="erppagefieldset-legend">
                            <i class="fa fa-list-check"></i> Other Details
                        </legend>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label">Payment Term</label>
                                <select class="erppage-input erppage-select" id="ddlPaymentTerm">
                                    <option value="">Select Payment Term</option>
                                </select>
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Cash Discount</label>
                                <input type="number" class="erppage-input" id="NumCashDiscount" oninput="SetMaxlength(this, 18, 2);" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Freight</label>
                                <input type="number" class="erppage-input" id="NumFreight" oninput="SetMaxlength(this, 18, 2);" />
                            </div>
                        </div>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield">
                                <label class="erppage-label">Total Quantity</label>
                                <input type="number" class="erppage-input" id="NumTotalQuantity" />
                            </div>
                            <div class="erppage-divfield">
                                <label class="erppage-label">Status</label>
                                <select class="erppage-input erppage-select" id="ddlStatus" disabled>
                                    <option value="">Select Status</option>
                                </select>
                            </div>
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label">Remarks</label>
                                <textarea class="erppage-input" id="TxtRemarks" style="height:50px;" placeholder="Enter Remarks"></textarea>
                            </div>
                        </div>
                        <div class="erppage-grid1">
                            <div class="erppage-divfield">
                                <div class="erppage-checkbox-wrap">
                                    <input type="checkbox" id="ChkCalPCS" class="erppage-checkbox-input">
                                    <label for="ChkCalPCS" class="erppage-checkbox-label">Cal on PCS</label>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>




            @* Modal Popup *@
            <div class="modal fade" id="linkedorderModal" tabindex="-1" aria-labelledby="linkedorderLabel" aria-hidden="true">
                <div class="modal-dialog small-modal erppagesmodal">
                    <div class="modal-content erppagesmodal-content">
                        <div class="erppagesmodal-header">
                            <div class="erppagesmodal-header-left">
                                <div class="erppagesmodal-header-icon">
                                    <i class="fa fa-link"></i>
                                </div>
                                <h5 class="erppagesmodal-title" id="linkedorderLabel">List of Orders</h5>
                            </div>
                            <button type="button" class="erppagesmodal-close" data-bs-dismiss="modal" aria-label="Close">
                                <i class="fa fa-times"></i>
                            </button>
                        </div>
                        <div class="erppagesmodal-body">
                            <div class="erppagelist-container">
                                <div class="excel-wrapper fixed-grid-wrapper">
                                    <table id="tblRMPurchaseModal" class="excel-table fixed-grid-table table-width resizable-table">
                                        <thead class="table-head">
                                            <tr>
                                                <th>Order No</th>
                                                <th>Party</th>
                                                <th>Item Name</th>
                                                <th>Quantity</th>
                                                <th>Rate</th>
                                                <th>Tenacity</th>
                                                <th>Tenacity Group</th>
                                                <th class="hidden-col">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Item Detail</legend>
                <div class="erppagelist-container">
                    <div class="excel-wrapper fixed-grid-wrapper">
                        <table id="tblSalesOrderEntryModal" class="excel-table fixed-grid-table table-width resizable-table">
                            <colgroup>
                                <col style="width: 75px;">
                                <col style="width: 150px;">
                                <col style="width: 140px;">
                                <col style="width: 70px;">
                                <col style="width: 85px;">
                                <col style="width: 85px;">
                                <col style="width: 100px;">
                                <col style="width: 80px;">
                                <col style="width: 95px;">
                                <col style="width: 80px;">
                                <col style="width: 95px;">
                                <col style="width: 100px;">
                                <col style="width: 80px;">
                                <col style="width: 95px;">
                                <col style="width: 80px;">
                                <col style="width: 95px;">
                                <col style="width: 80px;">
                                <col style="width: 95px;">
                                <col style="width: 80px;">
                                <col style="width: 95px;">
                                <col style="width: 80px;">
                                <col style="width: 95px;">
                                <col style="width: 110px;">
                                <col style="width: 110px;">
                                <col style="width: 80px;">
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Item Name</th>
                                    <th>Remarks</th>
                                    <th>Nos</th>
                                    <th>Weight</th>
                                    <th>Rate</th>
                                    <th>Amount</th>
                                    <th>Pack (%)</th>
                                    <th>Pack Amt</th>
                                    <th>Disc (%)</th>
                                    <th>Disc Amt</th>
                                    <th>Tax Type</th>
                                    <th>CGST (%)</th>
                                    <th>CGST Amt</th>
                                    <th>SGST (%)</th>
                                    <th>SGST Amt</th>
                                    <th>IGST (%)</th>
                                    <th>IGST Amt</th>
                                    <th>VAT (%)</th>
                                    <th>VAT Amt</th>
                                    <th>CESS (%)</th>
                                    <th>CESS Amt</th>
                                    <th>Net Amount</th>
                                    <th>Delivery Date</th>
                                    <th class="action-col">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </fieldset>

            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Item Total</legend>
                <div class="erppage-grid6">
                    <div class="erppage-divfield">
                        <label class="erppage-label">Total Nos</label>
                        <input type="number" class="erppage-input" id="NumTotalNos" oninput="SetMaxlength(this, 15, 4);" disabled/>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Quantity</label>
                        <input type="number" class="erppage-input" id="NumTotalQty" oninput="SetMaxlength(this, 15, 4);" disabled/>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Amount</label>
                        <input type="number" class="erppage-input" id="NumAmount" oninput="SetMaxlength(this, 15, 4);" disabled/>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Packing Amount</label>
                        <input type="number" class="erppage-input" id="NumPackingAmount" oninput="SetMaxlength(this, 15, 4);" />
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Disc Amount</label>
                        <input type="number" class="erppage-input" id="NumDiscAmount" oninput="SetMaxlength(this, 15, 4);" />
                    </div>
                </div>
                <div class="erppage-grid8">
                    <div class="erppage-divfield">
                        <label class="erppage-label">CGST Amt</label>
                        <input type="number" class="erppage-input" id="NumCGSTAmt" value="0.00" oninput="SetMaxlength(this, 15, 4);" disabled/>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">SGST Amt</label>
                        <input type="number" class="erppage-input" id="NumSGSTAmt" value="0.00" oninput="SetMaxlength(this, 15, 4);" disabled/>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">IGST Amt</label>
                        <input type="number" class="erppage-input" id="NumIGSTAmt" value="0.00" oninput="SetMaxlength(this, 15, 4);" disabled/>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">VAT Amt</label>
                        <input type="number" class="erppage-input" id="NumVATAmt" value="0.00" oninput="SetMaxlength(this, 15, 4);" disabled/>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Cess Amt</label>
                        <input type="number" class="erppage-input" id="NumCessAmt" value="0.00" oninput="SetMaxlength(this, 18, 4);" disabled/>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">TCS</label>
                        <div style="display:flex; gap:2px; width:100%;">
                            <input type="number" class="erppage-input" id="NumTCSRate" value="0.00" style="width:35%;" oninput="SetMaxlength(this, 18, 4);" />
                            <input type="number" class="erppage-input" id="NumTCSAmount" value="0.00" style="width:65%;" oninput="SetMaxlength(this, 18, 4);" disabled/>
                        </div>
                    </div>
                    <div class="erppage-divfield">
                        <label class="erppage-label">Other Amt</label>
