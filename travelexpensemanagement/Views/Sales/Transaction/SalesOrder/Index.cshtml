    async function fillItemDetailsTable(data) {
        const $tbody = $('#tblSalesOrderEntryModal tbody');
        $tbody.empty();

        for (let index = 0; index < data.length; index++) {

            const item = data[index];
            const idx = index + 1;

            addItemRecordRow();
            await bindDropdownData(idx);

            $(`#TxtCode${idx}`).val(item.ITEM_CODE);

            if (item.ITEM_CODE) {
                $(`#ddlItemname${idx}`).val(item.ITEM_CODE).trigger('change');
            }

            $(`#TxtNos${idx}`).val(item.NOS);
            $(`#TxtWeight${idx}`).val(item.QTY);
            $(`#TxtRate${idx}`).val(item.RATE);

            if (item.TENACITY_CODE) {
                $(`#ddlTenacity${idx}`).val(item.TENACITY_CODE).trigger('change');
            }

            if (item.DELIVERY_DATE) {
                $(`#DtDeliveryDate${idx}`).val(item.DELIVERY_DATE.split('T')[0]);
            }

            $(`#TxtRemarks${idx}`).val(item.REMARKS);
        }
    }

 
    async function GetDocData(MasterTblId, readOnly) {
        try {
            const response = await $.ajax({
                url: '/SalesOrder/GetPurchaseOrderRecordsById',
                type: 'GET',
                data: { id: MasterTblId }
            });

            if (response.status) {
                if (readOnly === 'true') {
                    disableAllFields();
                    $('.btn-add-row-last').hide();
                    $('#btn-save, #cancelBtn').hide();
                } else {
                    enableAllFields();
                    $('#btn-save, #cancelBtn').show();
                    $('.btn-add-row-last').show();

                }
                console.log(response.header,response.detail);
                await fillFormFields(response.header);
                await fillItemDetailsTable(response.detail);
                

            } else {
                toastr.error('No data returned.');
            }
        } catch (error) {
            toastr.error('Failed to load data.');
            toastr.error(error);
        }
    }

    function enableAllFields() {
      AllFieldsId.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.disabled = false;
      });
    }

    function disableAllFields() {
      AllFieldsId.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.disabled = true;
      });
    }

    function SaveData(saveDt) {
                $.ajax({
                    url: '@Url.Action("SaveOrUpdateSalesOrder", "SalesOrder")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(saveDt),
                    success: function (response) {
                        if (response?.status) {
                            // showFlashMessageByKey('insert', 'success');
                            toastr.success("Data Insert Successfully");
                            // resetFields();
                            setTimeout(() => {
                                window.location.href = '/SalesOrderList/Index';
                            }, 500);
                        } else {
                            toastr.error(response?.message || "Save failed. Please try again.");
                        }
                    },
                    error: function () {
                        toastr.error("Error occurred while saving. Please contact admin.");
                    }
                });
    }

    function UpdateData(UpdateDt) {
        $.ajax({
            url: '@Url.Action("SaveOrUpdateSalesOrder", "SalesOrder")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(UpdateDt),
            dataType: 'json',
            success: function (response) {
                if (response?.status) {
                    showFlashMessageByKey('update', 'success');
                    // resetFields();
                    setTimeout(() => {
                        window.location.href = '/SalesOrderList/Index';
                    }, 1500);
                } else {
                    toastr.error("Update failed: " + (response?.message || "Unknown error."));
                }
            },
            error: function (xhr, status, error) {
                toastr.error("Data not updated: " + error);
            }
        });
    }

