    async function collectOrder2Items() {
        const items = [];
        $('#tblSalesOrderEntryModal tbody tr').each(function (index) {
            const idx = index + 1;             
            const qty = parseFloatSafe($(`#TxtWeight${idx}`).val());
            const rate = parseFloatSafe($(`#TxtRate${idx}`).val());           
            const saudaNo = $('#ddlSaudaNo option:selected').text();
            console.log(saudaNo);

            items.push({
                SNO: idx, 
                ItemCode: parseIntSafe($(`#TxtCode${idx}`).val()),
                ItemName: $(`#ddlItemname${idx} option:selected`).text(),
                NOS: parseIntSafe($(`#TxtNos${idx}`).val()),
                Qty: qty,
                Rate: rate,
                Amount: qty && rate ? qty * rate : 0,
                Remarks: $(`#TxtRemarks${idx}`).val(),
                TenacityCode: parseIntSafe($(`#ddlTenacity${idx}`).val()),
                TenacityName: $(`#ddlTenacity${idx} option:selected`).text(),                
                SaudaType: 'SAUD',
                SaudaNo: saudaNo,
                DeliveryDate: toNullableDate($(`#DtDeliveryDate${idx}`).val()),
                Status: 1
            });
        });
        return items;
    }


