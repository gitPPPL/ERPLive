                        </label>
                    </div>
                </div>
            </div>
        </fieldset>
        
        <div class="card">
            <div class="table-responsive">
                <table id="tblSalesReturn" class="table-width">
                    <thead class="table-head">
                        <tr>
                            <th style="display:none;">Code</th>
                            <th>ID</th>
                            <th>Product name</th>
                            <th>Nos</th>
                            <th>Gross Qty</th>
                            <th>Net Qty</th>
                            <th>Rate</th>
                            <th>Amount</th>
                            <th>Pack %</th>
                            <th>Pack Amt</th>
                            <th>Disc %</th>
                            <th>Disc Amt</th>
                            <th>Tax Type</th>
                            <th>CGST%</th>
                            <th>CGST Amt</th>
                            <th>SGST %</th>
                            <th>SGST Amt</th>
                            <th>IGST %</th>
                            <th>IGST Amt</th>
                            <th>CESS %</th>
                            <th>CESS Amt</th>
                            <th>Remark</th>
                            <th>Pack No</th>
                            <th>Lot No</th>
                            <th>Sauda Type</th>
                            <th>Sauda No</th>
                            <th>Sauda Rate</th>
                            <th>Order Type</th>
                            <th>Order No</th>
                            <th>Order Rate</th>
                            <th>DCN Type</th>
                            <th>DCN No</th>
                            <th>HSN</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <!-- Pagination container -->
            <div class="row">
                <div class="col-md-12">
                    <div class="btn-add-row-last">
                        <i class="fa fa-plus btn-add-row" title="Add Row"><span>Add New Row</span></i>
                    </div>
                    <div class="pagination-end">
                        <div class="custom-pagination" id="tablePagination"></div>
                    </div>
                </div>
            </div>
        </div>

