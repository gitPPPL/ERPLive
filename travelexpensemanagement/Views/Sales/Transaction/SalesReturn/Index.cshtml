    ///i want to banding dropdown list
    function loadProductNameDropdown($dropdown, selectedItem = "") {
        $.ajax({
            url: '/SalesReturn/GetProductName',
            type: 'GET',
            success: function (data) {

                $dropdown.empty();
                $dropdown.append('<option value="">--Select Item--</option>');

                selectedItem = String(selectedItem).trim();

                $.each(data, function (index, item) {

                    let isSelected =
                        selectedItem === String(item.value).trim()
                            ? 'selected'
                            : '';

                    $dropdown.append(
                        `<option value="${item.value}" ${isSelected}>
                            ${item.text}
                         </option>`
                    );
                });
            },
            error: function () {
                toastr.error('Failed to load items');
            }
        });
    }
