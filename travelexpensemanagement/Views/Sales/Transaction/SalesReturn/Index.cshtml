                            <option value="2">B2C</option>
                            <option value="3">SEZWP</option>
                            <option value="4">SEZWOP</option>
                            <option value="5">EXPWP</option>
                            <option value="6">EXPWOP</option>
                            <option value="7">DEXP</option>
                        </select>
