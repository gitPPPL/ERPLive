                                    <select class="erppage-input erppage-select erppage-width-7" id="ddladdressL1">
                                        <option value="">Select address</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label" for="TxtAddressL2">Address L2</label>
                                <textarea class="erppage-input" id="TxtAddressL2" placeholder="Enter Address L2" disabled maxlength="150"></textarea>
                            </div>


                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label" for="TxtAddressL3">Address L3</label>
                                <textarea class="erppage-input" id="TxtAddressL3" placeholder="Enter Address L3" disabled maxlength="150"></textarea>
                            </div>
                        </div>
                        <div class="erppage-grid4">

                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label" for="Station">Station</label>
                                <select class="erppage-input erppage-select" id="Station" disabled>
                                    <option value="">Select station</option>
                                </select>
                                @* <input type="text" class="erppage-input" id="Station" placeholder="Station"> *@
                            </div>

                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label" for="NumPincode">Pincode</label>
