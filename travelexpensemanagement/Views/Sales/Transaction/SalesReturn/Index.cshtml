                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="ddlGateNo">Gate No</label>
                        <select class="form-control" id="ddlGateNo">
                            <option value="">Select Gate No</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="ddlWBNo">WB No</label>
                        <select class="form-control" id="ddlWBNo">
                            <option value="">Select WB No</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="ddlPackNo">Pack No</label>
                        <select class="form-control" id="ddlPackNo">
                            <option value="">Select Pack No</option>
                        </select>
                    </div>
                </div>
