                                <label class="erppage-label"></label>
                                <label class="erppage-label" id="lbl-cancelled" style="color:red; font-size:large; display:none">Cancelled</label>
                            </div>
                        </div>
                    </fieldset>
                </div>

                <!-- CONSIGNEE -->
                <div class="erppagescol-6">

                    <fieldset class="erppagefieldset">
                        <legend class="erppagefieldset-legend">Consignee Details</legend>

                        <div class="erppage-grid4">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label" for="ddlSaleThrough">Sale Through</label>
                                <select class="erppage-input erppage-select" id="ddlSaleThrough">
                                    <option value="">Select Sale Through</option>
                                </select>
                            </div>

                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label" for="ddlConsignee">Consignee</label>
                                <select class="erppage-input erppage-select" id="ddlConsignee">
                                    <option value="">Select Consignee</option>
                                </select>
                            </div>
                        </div>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label" for="TxtTransactionAddressL1">Address L1</label>
                                <div class="erppage-inputgroup">
                                    @* <input type="text" class="erppage-input erppage-width-93" id="TxtTransactionAddressL1" placeholder="Enter Address L1" disabled> *@
                                    <textarea type="text" class="erppage-input erppage-width-93" id="TxtTransactionAddressL1" placeholder="Enter Address L1" disabled maxlength="150"></textarea>
                                    <select class="erppage-input erppage-select erppage-width-7" id="ddlTransactionaddressL1">
                                        <option value="">Select address</option>
                                    </select>
                                </div>
                            </div>

                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label" for="TxtTransactionAddressL2">Address L2</label>
                                <textarea class="erppage-input" id="TxtTransactionAddressL2" placeholder="Enter Address L2" disabled maxlength="150"></textarea>
                            </div>
                        </div>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label" for="TxtTransactionAddressL3">Address L3</label>
                                <textarea class="erppage-input" id="TxtTransactionAddressL3" placeholder="Enter Address L3" disabled maxlength="150"></textarea>
                            </div>

                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label" for="TxtTransactionStation">Station</label>
                                <select class="erppage-input erppage-select" id="TxtTransactionStation" disabled>
                                    <option value="">Select station</option>
                                </select>
                                @* <input type="text" class="erppage-input" id="TxtTransactionStation" placeholder="Enter Station"> *@
                            </div>
                        </div>
                        <div class="erppage-grid4">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label" for="NumTransactionPIN">PIN</label>
                                <input type="text" class="erppage-input" id="NumTransactionPIN" disabled maxlength="10">
                            </div>

                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label" for="ddlFormType">Form Type</label>
                                <select class="erppage-input erppage-select" id="ddlFormType">
                                    <option value="">Select Form Type</option>
                                    @* <option value="1">Finish</option>
                                    <option value="2">Raw</option>
                                    <option value="3">Store</option>
                                    <option value="4">Fuel</option>
                                    <option value="5">Scrap</option>
                                    <option value="6">Waste</option>
                                    <option value="7">Others</option>
                                    <option value="8">Capital</option> *@
                                </select>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>


            <!-- =====================================================
                 ITEM DETAIL
            ====================================================== -->
            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Item Details</legend>

                <div class="erppagelist-container">
                    <div class="excel-wrapper fixed-grid-wrapper">
                        <table id="tblSalesReturn" class="excel-table fixed-grid-table table-width resizable-table">
                            <colgroup>
                                <col style="width: 69px;">
                                <col style="width:200px;">
                                <col style="width: 54px;">
                                <col style="width: 86px;">
                                <col style="width: 73px;">
                                <col style="width: 70px;">
                                <col style="width: 76px;">
                                <col style="width: 67px;">
                                <col style="width:80px;">
                                <col style="width: 65px;">
                                <col style="width: 77px;">
                                <col style="width:120px;">
                                <col style="width: 68px;">
                                <col style="width: 85px;">
                                <col style="width: 74px;">
                                <col style="width: 87px;">
                                <col style="width: 69px;">
                                <col style="width: 85px;">
                                <col style="width: 73px;">
                                <col style="width: 89px;">
                                <col style="width: 119px;">
                                <col style="width:100px;">
                                <col style="width:100px;">
                                <col style="width: 94px;">
                                <col style="width:100px;">
                                <col style="width: 94px;">
                                <col style="width: 94px;">
                                <col style="width:100px;">
                                <col style="width: 89px;">
                                <col style="width: 84px;">
                                <col style="width:100px;">
                                <col style="width: 84px;">
                                <col class="action-col" style="width:70px;">
                            </colgroup>
                            <thead class="table-head">
                                <tr>
                                    <th>ID</th>
                                    <th>Product name</th>
                                    <th>Nos</th>
                                    <th>Gross Qty</th>
                                    <th>Net Qty</th>
                                    <th>Rate</th>
                                    <th>Amount</th>
                                    <th>Pack %</th>
                                    <th>Pack Amt</th>
                                    <th>Disc %</th>
                                    <th>Disc Amt</th>
                                    <th>Tax Type</th>
                                    <th>CGST%</th>
                                    <th>CGST Amt</th>
                                    <th>SGST %</th>
                                    <th>SGST Amt</th>
                                    <th>IGST %</th>
                                    <th>IGST Amt</th>
                                    <th>CESS %</th>
                                    <th>CESS Amt</th>
                                    <th>Remark</th>
                                    <th>Pack No</th>
                                    <th>Lot No</th>
                                    <th>Sauda Type</th>
                                    <th>Sauda No</th>
                                    <th>Sauda Rate</th>
                                    <th>Order Type</th>
                                    <th>Order No</th>
                                    <th>Order Rate</th>
                                    <th>DCN Type</th>
                                    <th>DCN No</th>
                                    <th>HSN</th>
                                    <th class="action-col">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </fieldset>

            <!-- =====================================================
                 TOTALS / OTHER DETAILS
            ====================================================== -->
            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Total & Other Details</legend>

                <div class="erppagesrow">
                    <!-- =================================================
                         AMOUNT DETAILS
                    ================================================== -->
                    <div class="erppagescol-4">
                        <div class="erppage-grid2">
                            <div class="erppage-divfield">
                                <label class="erppage-label" for="NumOtherTotalAmount">Total Amount</label>
                                <input type="number" class="erppage-input" id="NumOtherTotalAmount" oninput="SetMaxlength(this, 18, 4);">
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label" for="NumOtherTotalNos">Total Nos</label>
                                <input type="number" class="erppage-input" id="NumOtherTotalNos">
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label">Packing</label>
                                <div class="erppage-inputgroup">
                                    <input type="number" class="erppage-input" id="NumOtherPacking1" oninput="SetMaxlength(this, 7, 4);">
                                    <input type="number" class="erppage-input" id="NumOtherPacking2" oninput="SetMaxlength(this, 18, 4);">
                                </div>
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label">CESS</label>
                                <div class="erppage-inputgroup">
                                    <input type="number" class="erppage-input" id="NumOtherCESS1" oninput="SetMaxlength(this, 7, 4);">
                                    <input type="number" class="erppage-input" id="NumOtherCESS2" oninput="SetMaxlength(this, 18, 4);">
                                </div>
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label">Discount</label>
                                <div class="erppage-inputgroup">
                                    <input type="number" class="erppage-input" id="NumOtherDiscount1" oninput="SetMaxlength(this, 7, 4);">
                                    <input type="number" class="erppage-input" id="NumOtherDiscount2" oninput="SetMaxlength(this, 18, 4);">
                                </div>
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label">TCS</label>
                                <div class="erppage-inputgroup">
                                    <input type="number" class="erppage-input" id="NumOtherTCS1" oninput="SetMaxlength(this, 18, 4);">
                                    <input type="number" class="erppage-input" id="NumOtherTCS2" oninput="SetMaxlength(this, 18, 4);">
                                </div>
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label" for="NumOtherSubTotal">Sub Total</label>
                                <input type="number" class="erppage-input" id="NumOtherSubTotal">
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label" for="NumOtherRoundOff">Round Off</label>
                                <input type="number" class="erppage-input" id="NumOtherRoundOff" oninput="SetMaxlength(this, 18, 4);">
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label">CGST</label>
                                <div class="erppage-inputgroup">
                                    <input type="number" class="erppage-input" id="NumOtherCGST1" oninput="SetMaxlength(this, 7, 4);">
                                    <input type="number" class="erppage-input" id="NumOtherCGST2" oninput="SetMaxlength(this, 18, 4);">
                                </div>
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label" for="NumOtherNetAmount">Net Amount</label>
                                <input type="number" class="erppage-input" id="NumOtherNetAmount" oninput="SetMaxlength(this, 18, 4);">
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label">SGST</label>
                                <div class="erppage-inputgroup">
                                    <input type="number" class="erppage-input" id="NumOtherSGST1" oninput="SetMaxlength(this, 7, 4);">
                                    <input type="number" class="erppage-input" id="NumOtherSGST2" oninput="SetMaxlength(this, 18, 4);">
                                </div>
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label">Insurance %</label>
                                <div class="erppage-inputgroup">
                                    <input type="number" class="erppage-input" id="NumInsurance1" oninput="SetMaxlength(this, 7, 4);">
                                    <input type="number" class="erppage-input" id="NumInsurance2" oninput="SetMaxlength(this, 18, 4);">
                                </div>
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label">IGST</label>
                                <div class="erppage-inputgroup">
                                    <input type="number" class="erppage-input" id="NumOtherIGST1" oninput="SetMaxlength(this, 7, 4);">
                                    <input type="number" class="erppage-input" id="NumOtherIGST2">
                                </div>
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label" for="NumConsFreight">Cons. Freight</label>
                                <input type="number" class="erppage-input" id="NumConsFreight" oninput="SetMaxlength(this, 18, 4);">
                            </div>

                            <div class="erppage-divfield">
                                <label class="erppage-label">TDS Freight %</label>
                                <div class="erppage-inputgroup">
                                    <input type="number" class="erppage-input" id="NumTDSFreight1" oninput="SetMaxlength(this, 7, 4);">
                                    <input type="number" class="erppage-input" id="NumTDSFreight2" oninput="SetMaxlength(this, 18, 4);">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- =================================================
                         QUANTITY / FREIGHT
                    ================================================== -->
                    <div class="erppagescol-4">

