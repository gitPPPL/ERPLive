                        <select class="form-control" id="ddlReferenceNo">
                            <option value="">Select Reference No</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group position-relative">
                        <label for="DtReferenceDate">Reference Date</label>
                        <div class="calender-check">
                            <input type="text" class="form-control" id="DtReferenceDate" name="ReferenceDate" style="padding-left: 30px;">
                            <input type="checkbox" id="chkReferenceDate" class="checkbox-inside">
