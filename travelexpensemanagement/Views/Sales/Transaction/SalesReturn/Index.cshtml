@{
    ViewBag.Title = "Sales Return";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Normal inputs / textarea / select jo transport edit me editable hon */
    .erppage-readonly input.tpt-editable,
    .erppage-readonly textarea.tpt-editable,
    .erppage-readonly select.tpt-editable {
        pointer-events: auto;
        user-select: text;
        background-color: #fff;
        color: inherit;
        cursor: text;
    }

    .erppage-readonly input[type="checkbox"].tpt-editable {
        cursor: pointer;
    }

    /* Select2 container + andar ka selection box, disabled styling ko bhi override */
    .erppage-readonly .select2-container.tpt-editable,
    .erppage-readonly .select2-container.tpt-editable .select2-selection,
    .erppage-readonly .select2-container.tpt-editable.select2-container--disabled .select2-selection,
    .erppage-readonly .select2-container.tpt-editable .select2-selection__rendered {
        background-color: #fff !important;
        color: #000 !important;
        pointer-events: auto;
        user-select: auto;
        cursor: pointer;
    }

        /* Arrow aur clear (x) ka background transparent rahe */
        .erppage-readonly .select2-container.tpt-editable .select2-selection__arrow,
        .erppage-readonly .select2-container.tpt-editable .select2-selection__clear {
            background-color: transparent !important;
            pointer-events: auto;
            cursor: pointer;
        }
</style>

<div id="erp-toast-container"></div>

<div class="erppage-header">
    <div class="erppage-header-left">
        <div class="erppage-header-icon"><i class="fa fa-file-invoice"></i></div>
        <div class="erppage-header-title">Sales Return</div>
    </div>


    <div class="erppage-header-right">
        <button type="button" class="erppagelist-btn erppagelist-btn-action tooltip-btn" data-tooltip="Print" id="button_print"
                onclick="SalesReturnReport()">
            <i class="fa fa-print"></i> Print
        </button>
        <button type="button"
                id="btn_Sendapproval"
                style="display:none;" class="erppagebtn_sendapproval">
            <i class="fa fa-share"></i>Send For Approval
        </button>
        <button type="button"
                id="btn_Approved"
                style="display:none;"
                class="erppagebtn_approved">
            Approved
        </button>
        <button type="button" class="erppage-header-back" onclick="handleBack('@Url.Action("Index", "SalesReturnList")', isReadOnly)">
            <i class="fa-solid fa-arrow-left"></i>Back to list
        </button>
    </div>

</div>


<div class="erppage-container">
    <div class="erppage-fieldset">
        <div id="SalesReturnForm">

            <input type="hidden" class="erppage-input" id="TxtCode" name="CODE">
            <!-- =====================================================
                 DOCUMENT DETAILS
            ====================================================== -->
            <fieldset class="erppagefieldset">
                <legend class="erppagefieldset-legend">Document Details</legend>
                <div class="erppage-grid5">
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="ddlDocumentType">Document Type</label>
                        <select class="erppage-redinput erppage-required" id="ddlDocumentType">
                            <option value="">Select Document Type</option>
                        </select>
                    </div>

                    <div class="erppage-divfield">
                        <label class="erppage-label" for="NumDocumentNo">Document No</label>
                        <input type="number" class="erppage-redinput" id="NumDocumentNo" disabled>
                    </div>

                    <div class="erppage-divfield">
                        <label class="erppage-label" for="DtDocumentDate">Document Date</label>
                        <input type="date" class="erppage-input" id="DtDocumentDate">
                    </div>

                    <div class="erppage-divfield">
                        <label class="erppage-label" for="ddlTransactionThrough">Transaction Type</label>
                        <select class="erppage-input erppage-select" id="ddlTransactionThrough">
                            <option value="Regular" selected>Regular</option>
                            <option value="Bill To - Ship To">Bill To - Ship To</option>
                            <option value="Bill From">Bill From</option>
                            <option value="Combination of both">Combination of both</option>
                        </select>
                    </div>
                    <!-- Supply Type -->
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="ddlSupplyType">Supply Type</label>
                        <select class="erppage-input erppage-select" id="ddlSupplyType">
                            <option value="">Select Supply Type</option>
                            <option value="B2B" selected>B2B</option>
                            <option value="B2C">B2C</option>
                            <option value="SEZWP">SEZWP</option>
                            <option value="SEZWOP">SEZWOP</option>
                            <option value="EXPWP">EXPWP</option>
                            <option value="EXPWOP">EXPWOP</option>
                            <option value="DEXP">DEXP</option>
                        </select>
                    </div>

                </div>
            </fieldset>

            <!-- =====================================================
                 TRANSACTION + TAX
            ====================================================== -->
            <fieldset class="erppagefieldset">

                <legend class="erppagefieldset-legend">Transaction Details</legend>
                <div class="erppage-grid6">
                    <!-- Tax Type -->
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="ddlTaxType">Tax Type</label>
                        <select class="erppage-input erppage-select" id="ddlTaxType">
                            <option value="">Select Tax Type</option>
                        </select>
                    </div>

                    <!-- Production Type -->
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="ddlProductionType">Production Type</label>
                        <select class="erppage-input erppage-select" id="ddlProductionType">
                        </select>
                    </div>

                    <!-- Reference No -->
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="ddlReferenceNo">Reference No</label>
                        <select class="erppage-input erppage-select" id="ddlReferenceNo">
                            <option value="">Select Reference No</option>
                        </select>
                    </div>

                    <!-- Reference Date -->
                    <div class="erppage-divfield erppage-datefield">
                        <label class="erppage-label" for="DtReferenceDate">Reference Date</label>
                        <div class="erppage-datebox">
                            <input type="date" class="erppage-input erppage-dateinput" id="DtReferenceDate">
                            <label class="erppage-checkbox-inside">
                                <input type="checkbox" class="erppage-checkbox-input" id="chkReferenceDate">
                            </label>

                        </div>
                    </div>
                </div>

                <div class="erppage-grid6">

                    <!-- Gate No -->
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="ddlGateNo">Gate No</label>
                        <select class="erppage-input erppage-select" id="ddlGateNo">
                            <option value="">Select Gate No</option>
                        </select>
                    </div>

                    <!-- WB No -->
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="ddlWBNo">WB No</label>
                        <select class="erppage-input erppage-select" id="ddlWBNo">
                            <option value="">Select WB No</option>
                        </select>
                    </div>
                    <!-- Pack No -->
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="ddlPackNo">Pack No</label>
                        <select class="erppage-input erppage-select" id="ddlPackNo">
                            <option value="">Select Pack No</option>
                        </select>
                    </div>

                    <!-- Sauda No -->
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="ddlSaudaNo">Sauda No</label>
                        <select class="erppage-input erppage-select" id="ddlSaudaNo">
                            <option value="">Select Sauda No</option>
                        </select>
                    </div>

                    <!-- Sauda Rate -->
                    <div class="erppage-divfield">
                        <label class="erppage-label" for="NumSaudaRate">Sauda Rate</label>
                        <div class="erppage-inputgroup">
                            <input type="number" class="erppage-input" id="NumSaudaRate">
                            <span class="erppage-btn erppage-btn-common-print-disabled">
                                <i class="fa fa-calculator" id="btn-Calculator"></i>
                            </span>
                        </div>
                    </div>

                    <!-- PCS -->
                    <div class="erppage-divfield">
                        <div class="erppage-checkbox-wrap">
                            <input type="checkbox" id="ChkPCS" class="erppage-checkbox-input">
                            <label for="ChkPCS" class="erppage-checkbox-label">PCS</label>
                        </div>
                    </div>
                </div>
            </fieldset>
            <!-- =====================================================
                 PARTY + CONSIGNEE
            ====================================================== -->
            <div class="erppagesrow">
                <!-- PARTY -->
                <div class="erppagescol-6">
                    <fieldset class="erppagefieldset">
                        <legend class="erppagefieldset-legend">Party Details</legend>

                        <div class="erppage-grid4">
                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label" for="ddlPartyName">Party Name</label>
                                <select class="erppage-redinput erppage-required" id="ddlPartyName">
                                    <option value="">Select Party Name</option>
                                </select>
                            </div>

                            <div class="erppage-divfield erppage-col-span-2">
                                <label class="erppage-label" for="TxtAddressL1">Address L1</label>
                                <div class="erppage-inputgroup">
                                    @* <input type="text" class="erppage-input erppage-width-93" id="TxtAddressL1" placeholder="Enter Address L1" disabled> *@
