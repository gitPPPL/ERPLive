                        <select class="form-control" id="ddlConsignee">
                            <option value="">Select Consignee</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtTransactionAddressL1">Address L1</label>
                        <div class="input-divide">
                            <input type="text" class="form-control" id="TxtTransactionAddressL1" placeholder="Enter Address L1">
                            <div class="select-wrapper">
                                <select id="ddlTransactionaddressL1">
                                    <option value="">Select address</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="TxtTransactionAddressL2">Address L2</label>
                        <textarea typeof="text" class="form-control" id="TxtTransactionAddressL2" placeholder="Enter Address L2"></textarea>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label for="TxtTransactionAddressL3">Address L3</label>
                        <textarea typeof="text" class="form-control" id="TxtTransactionAddressL3" placeholder="Enter Address L3"></textarea>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label for="TxtTransactionStation">Station</label>
                        <input typeof="text" class="form-control" id="TxtTransactionStation" placeholder="Enter Station">
                    </div>
                </div>
