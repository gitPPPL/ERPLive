    async function ddlPartyName() {
        try {
            const response = await fetch('/SalesReturn/GetddlPartyName');
            if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
            const data = await response.json();
            const ddl = $('#ddlPartyName');
            ddl.empty(); 
            ddl.append('<option value="" disabled selected>Select Employee</option>');
            data.forEach(item => {
                ddl.append(`<option value="${item.value}">${item.text} (${item.value})</option>`);
            });
            ddl.select2({
                placeholder: 'Select Employee',
                allowClear: true,
                width: '100%',
                matcher: function (params, data) {
                    if ($.trim(params.term) === '') {
                        return data;
                    }
                    const text = data.text.toLowerCase();
                    const term = params.term.toLowerCase();
                    return text.indexOf(term) > -1 ? data : null;
                }
            });
        } catch (err) {
            console.error("Error loading Employee Code dropdown:", err);
            toastr.error("Error loading Employee Code dropdown");
        }
    }
