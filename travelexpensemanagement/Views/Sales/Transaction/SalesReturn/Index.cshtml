                    <div class="form-group">
                        <label for="NumTransactionPIN">PIN</label>
                        <input type="number" class="form-control" id="NumTransactionPIN" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-2">
                    <div class="form-group">
                        <label for="ddlFormType">Form Type</label>
                        <select class="form-control" id="ddlFormType">
                            <option value="">Select Form Type</option>
                            <option value="1">Finish</option>
                            <option value="2">Raw</option>
                            <option value="3">Store</option>
                            <option value="4">Fuel</option>
                            <option value="5">Scrap</option>
                            <option value="6">Waste</option>
                            <option value="7">Others</option>
                            <option value="8">Capital</option>
                        </select>
                    </div>
                </div>
            </div>
        </fieldset>
        <fieldset class="fieldset-sub">
            <legend class="sub-legend">Tax Detail</legend>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="ddlTaxType">Tax Type</label>
                        <select class="form-control" id="ddlTaxType">
                            <option value="">Select Tax Type</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="ddlProductionType">Production Type</label>
                        <select class="form-control" id="ddlProductionType">
                            <option value="">Select Production Type</option>
                            <option value="1">Finish</option>
                            <option value="2">Raw</option>
                            <option value="3">Store</option>
                            <option value="4">Fuel</option>
                            <option value="5">Scrap</option>
                            <option value="6">Waste</option>
                            <option value="7">Other</option>
                            <option value="8">Capital</option>
