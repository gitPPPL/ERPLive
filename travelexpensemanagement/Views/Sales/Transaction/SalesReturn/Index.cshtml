<script>
    $(document).ready(async function () {
        function getQueryParam(param) {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get(param);
        }
        const VNo = getQueryParam('VoucherNo');
        const vType = getQueryParam('vType');
        const mode = getQueryParam("mode");

        if (VNo && vType) {
            $.ajax({
            url: '/SalesReturn/GetID',
            type: 'POST',
            data: JSON.stringify({
                VoucherNo: VNo,
                VType: vType
            }),
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            success: function (res) {
                console.log('response:', res);
                // Validate response
                if (!res || !res.header || res.header.length === 0) {
                    toastr.warning('No record found');
                    return;
                }
                bindSaleHeader(res.header[0]);
                if (res.items && res.items.length > 0) {
                    bindSaleItems(res.items);
                }
                toastr.success('Data loaded successfully');
            },
            error: function (xhr) {
                console.error(xhr.responseText);
                toastr.error('Failed to load data');
            }
            });
        }

        await ddlPartyName();
        await ddlSaleThrough();
        await ddlSaleConsignee();
        await ddlTaxType();
        await ddlReferenceNo();
        await ddlGateNo();
        await ddlWBNo();
        await ddlSaudaNo();
       
        ddlDocumentType();
        ddlTransport();
        ddlWBParty();
        ddlLoadParty();
        var today = new Date();
        var dd = String(today.getDate()).padStart(2, '0');
        var mm = String(today.getMonth() + 1).padStart(2, '0');
        var yyyy = today.getFullYear();
        $("#DtDocumentDate").val(dd + "/" + mm + "/" + yyyy);
        $("#DtReferenceDate").val(dd + "/" + mm + "/" + yyyy);
        $("#DtGRdate").val(dd + "/" + mm + "/" + yyyy);
        $("#ddlDocumentType").on('change', async function () {
            var docType = $(this).val();
            if (!docType) return;
            try {
                const response = await $.ajax({
                    url: '/SalesReturn/GetDocumentNo',
                    type: 'GET',
                    data: { documentType: docType }
                });
                $("#NumDocumentNo").val(response.documentNo);
            } catch (err) {
                console.error("Error loading Document No:", err);
            }
            await ddlPackNo(docType);
        });
        const $tbody = $('#tblSalesReturn tbody');
        function generateSelect(options, selected = "") {
            return options.map(opt => `<option ${selected === opt ? 'selected' : ''}>${opt}</option>`).join('');
        }
        function addRow(data = {}) {
            const $tbody = $('#tblSalesReturn tbody');
            $tbody.find('.btn-add-action').remove();
            const row = `
            <tr class="no-border-input">
                <td style="display:none;">${data.code || ''}</td>
                <td><input type="text" class="form-control" value="${data.id || ''}" /></td>
                <td> <select class="form-control productName-dropdown" name="productName" data-selected-value="${data.code || ''}"> </select> </td>
                <td><input type="text" class="form-control nos-input" value="${data.nos || ''}" /></td>
                <td><input type="number" class="form-control Quantity-input" value="${data.grossQuantity || ''}" /></td>
                <td><input type="number" class="form-control net-input" value="${data.netQuantity || ''}" /></td>
                <td><input type="number" step="any" class="form-control rate-input" value="${data.rate || ''}" /></td>
                <td><input type="number" step="any" class="form-control amount-input" value="${data.amount || 0}" readonly /></td>
                <td><input type="number" class="form-control pack-input" value="${data.packPercent || 0}" /></td>
                <td><input type="number" class="form-control pack-amount-input" value="${data.packAmount || 0}" readonly /></td>
                <td><input type="number" class="form-control disc-input" value="${data.discPercent || 0}" /></td>
                <td><input type="number" class="form-control disc-amount-input" value="${data.discAmount || 0}"  readonly /></td>
                <td><select class="form-control taxTypes-dropdown" name="taxTypes" data-selected-value="${data.taxTypes || ''}"> </select> </td>
                <td><input type="number" class="form-control cgst-per" readonly /></td>
                <td><input type="number" class="form-control cgst-amt" readonly /></td>
                <td><input type="number" class="form-control sgst-per" readonly /></td>
                <td><input type="number" class="form-control sgst-amt" readonly /></td>
                <td><input type="number" class="form-control igst-per" readonly /></td>
                <td><input type="number" class="form-control igst-amt" readonly /></td>
                <td><input type="number" class="form-control cess-per" readonly /></td>
                <td><input type="number" class="form-control cess-amt" readonly /></td>
                <td><input type="text" class="form-control remark-input" value="${data.remark || ''}" /></td>
                <td><input type="text" class="form-control packNo-input" value="${data.packNo || ''}" /></td>
                <td><input type="text" class="form-control lotNo-input" value="${data.lotNo || ''}" /></td>
                <td><input type="text" class="form-control saudaType-input" value="${data.saudaType || ''}" /></td>
                <td><input type="text" class="form-control saudaNo-input" value="${data.saudaNo || ''}" /></td>
                <td><input type="number" class="form-control saudaRate-input" value="${data.saudaRate || ''}" /></td>
                <td><input type="text" class="form-control orderType-input" value="${data.orderType || ''}" /></td>
                <td><input type="text" class="form-control orderNo-input" value="${data.orderNo || ''}" /></td>
                <td><input type="number" step="any" class="form-control orderRate-input" value="${data.orderRate || ''}" /></td>
                <td><input type="text" class="form-control dcnType-input" value="${data.dcnType || ''}" /></td>
                <td><input type="text" class="form-control dcnNo-input" value="${data.dcnNo || ''}" /></td>
                <td><input type="text" class="form-control hsn-input" value="${data.hsn || ''}" /></td>
                <td>
                    <i class="fa fa-plus btn-add-action text-success"></i>
                    <i class="fa fa-trash btn-delete-action text-danger"></i>
                </td>
            </tr>
        `;
            $tbody.append(row);
            const $lastRow = $tbody.find('tr:last');
            // Load dropdowns
            loadProductNameDropdown($lastRow.find('.productName-dropdown'), data.code);
            loadTaxTypeDropdown($lastRow.find('.taxTypes-dropdown'), data.taxTypes);
             return $lastRow;
        }
        addRow();
        $(document).on('click', '.btn-add-row, .btn-add-action', function () {
            addRow();
        });
        $(document).on('click', '.btn-delete-action', function () {
            const $row = $(this).closest('tr');
            const isLastRow = $row.is(':last-child');
            $row.remove();
            if (isLastRow) {
                const $lastRow = $tbody.find('tr:last');
                if ($lastRow.length > 0 && $lastRow.find('.btn-add-action').length === 0) {
                    $lastRow.find('td:last').prepend(
                        `<i class="fa fa-plus btn-add-action text-success" title="Add Row" style="cursor:pointer;"></i>`
                    );
                }
            }
        });
        // onchange .rate-input, .net-input, .pack-input
        $(document).on('input','.rate-input, .net-input, .pack-input, .disc-input',
      function () {

          let $row = $(this).closest('tr');
          let rate    = parseFloat($row.find('.rate-input').val()) || 0;
          let netQty  = parseFloat($row.find('.net-input').val()) || 0;
          let packPer = parseFloat($row.find('.pack-input').val()) || 0;
          let discPer = parseFloat($row.find('.disc-input').val()) || 0;
          let amount = rate * netQty;
          $row.find('.amount-input').val(amount.toFixed(2));
          let packAmt = amount * packPer / 100;
          $row.find('.pack-amount-input').val(packAmt.toFixed(2));
          let discAmt = (amount + packAmt) * discPer / 100;
          $row.find('.disc-amount-input').val(discAmt.toFixed(2));
          $row.find('.taxTypes-dropdown').trigger('change');
    });
        $(document).on('change', '.taxTypes-dropdown', function () {
        let $row = $(this).closest('tr');
        let taxCode = $(this).val();
        applyTax($row, taxCode);
    });

    function applyTax($row, taxCode) {
        if (!taxCode) return;

        let amount = parseFloat($row.find('.amount-input').val()) || 0;
        let packAmt = parseFloat($row.find('.pack-amount-input').val()) || 0;
        let discAmt = parseFloat($row.find('.disc-amount-input').val()) || 0;
        let taxable = amount + packAmt - discAmt;

        $.ajax({
            url: '/SalesReturn/GetTaxTypeDetails',
            type: 'GET',
            data: { code: taxCode },
            success: function (res) {
                if (!res) return toastr.error('Invalid tax data');

                let cgstPer = parseFloat(res.cgsT_PER) || 0;
                let sgstPer = parseFloat(res.sgsT_PER) || 0;
                let igstPer = parseFloat(res.igsT_PER) || 0;
                let cessPer = parseFloat(res.otH_PER) || 0;

                $row.find('.cgst-per').val(cgstPer.toFixed(2));
                $row.find('.sgst-per').val(sgstPer.toFixed(2));
                $row.find('.igst-per').val(igstPer.toFixed(2));
                $row.find('.cess-per').val(cessPer.toFixed(2));

                $row.find('.cgst-amt').val((taxable * cgstPer / 100).toFixed(2));
                $row.find('.sgst-amt').val((taxable * sgstPer / 100).toFixed(2));
                $row.find('.igst-amt').val((taxable * igstPer / 100).toFixed(2));
                $row.find('.cess-amt').val((taxable * cessPer / 100).toFixed(2));

                calculateTotalRecQty();
            },
            error: function () {
                toastr.error('Tax calculation failed');
            }
        });
    }
    function calculateTotalRecQty() {
            let totalNos = 0, totalGrossQty = 0, totalNetQty = 0;
            let totalAmount = 0, totalPackAmt = 0, totalDiscAmt = 0;
            let totalCGST = 0, totalSGST = 0, totalIGST = 0, totalCESS = 0;
            $('#tblSalesReturn tbody tr').each(function () {
                let $row = $(this);
                totalNos += parseFloat($row.find('.nos-input').val()) || 0;
                totalGrossQty += parseFloat($row.find('.Quantity-input').val()) || 0;
                totalNetQty += parseFloat($row.find('.net-input').val()) || 0;
                totalAmount += parseFloat($row.find('.amount-input').val()) || 0;
                totalPackAmt += parseFloat($row.find('.pack-amount-input').val()) || 0;
                totalDiscAmt += parseFloat($row.find('.disc-amount-input').val()) || 0;
                totalCGST += parseFloat($row.find('.cgst-amt').val()) || 0;
                totalSGST += parseFloat($row.find('.sgst-amt').val()) || 0;
                totalIGST += parseFloat($row.find('.igst-amt').val()) || 0;
                totalCESS += parseFloat($row.find('.cess-amt').val()) || 0;
            });

            let subTotal = totalAmount + totalPackAmt - totalDiscAmt;
            let netAmount = subTotal + totalCGST + totalSGST + totalIGST + totalCESS;
            $('#NumOtherTotalNos').val(totalNos.toFixed(2));
            $('#NumGrossQty').val(totalGrossQty.toFixed(2));
            $('#NumNetQty').val(totalNetQty.toFixed(2));
            $('#NumOtherTotalAmount').val(totalAmount.toFixed(2));
            $('#NumOtherPacking2').val(totalPackAmt.toFixed(2));
            $('#NumOtherDiscount2').val(totalDiscAmt.toFixed(2));
            $('#NumOtherSubTotal').val(subTotal.toFixed(2));
            $('#NumOtherCGST2').val(totalCGST.toFixed(2));
            $('#NumOtherSGST2').val(totalSGST.toFixed(2));
            $('#NumOtherIGST2').val(totalIGST.toFixed(2));
            $('#NumOtherCESS2').val(totalCESS.toFixed(2));
            $('#NumOtherNetAmount').val(netAmount.toFixed(2));
         }
    $('#ddlReferenceNo').on('change', function () {
        var refValue = $(this).val();
        var refText = $('#ddlReferenceNo option:selected').text().trim();
        if (!refValue) return;
        $.ajax({
            url: '/SalesReturn/GetReferenceDetails',
            type: 'POST',
            data: { refValue, refText },
            success: function (res) {
                if (res.success) {
                    if (res.header.length > 0)
                        bindSaleHeader(res.header[0]);
                    if (res.items.length > 0)
                        bindSaleItems(res.items);
                } else {
                    alert('No data found');
                }
            },
            error: function () {
                alert('Server Error');
            }
        });
    });
    function bindSaleHeader(d) {
        setDropdownValue('#ddlPartyName', d.BILL_CODE);
        $('#TxtAddressL1').val(d.BILL_ADD1);
        $('#TxtAddressL2').val(d.BILL_ADD2);
        $('#TxtAddressL3').val(d.BILL_ADD3);
        $('#Station').val(d.B_CITY);
        $('#NumPincode').val(d.BILL_PINCODE);

        setDropdownValue('#ddlConsignee', d.SHIP_CODE);
        $('#TxtTransactionAddressL1').val(d.SHIP_ADD1);
        $('#TxtTransactionAddressL2').val(d.SHIP_ADD2);
        $('#TxtTransactionAddressL3').val(d.SHIP_ADD3);
        $('#TxtTransactionStation').val(d.S_NAME);
        $('#NumTransactionPIN').val(d.SHIP_PINCODE);

        setDropdownValue('#ddlTaxType', d.TAX_CODE);
        $('#NumGRNo').val(d.GR_NO);
        setDropdownValue('#ddlTransport', d.TRANSPORT_CODE);
        $('#NumTruckNo').val(d.VEHICLE_NO);
        $('#NumMobileNo').val(d.DRIVER_NO);
        $('#TxtRemarks1').val(d.REMARK);
    }

    function bindSaleItems(list) {
       const $tbody = $('#tblSalesReturn tbody');
       $tbody.empty();
       $.each(list, function (i, d) {
            let $row = addRow({
                id: i + 1,
                code: d.ITEM_CODE,
                productName: d.I_NAME,
                nos: d.NOS,
                grossQuantity: d.GROSS_QTY,
                netQuantity: d.QTY,
                rate: d.RATE,
                amount: d.AMOUNT,
                packPercent: d.PACK_PER,
                packAmount: d.PACK_AMT,
                discPercent: d.DISC_PER,
                discAmount: d.DISC_AMT,
                taxTypes: d.TAX_CODE,
                remark: d.REMARK,
                packNo: d.PACK_NO,
                lotNo: d.LOT_NO,
                saudaType: d.SAUDA_TYPE,
                saudaNo: d.SAUDA_NO,
                saudaRate: d.SAUDA_RATE,
                orderType: d.ORDER_TYPE,
                orderNo: d.ORDER_NO,
                orderRate: d.ORDER_RATE,
                dcnType: d.DCN_TYPE,
                dcnNo: d.DCN_NO,
                hsn: d.HSN
            });

            // Calculate taxable amount for the row
            let amount = parseFloat(d.AMOUNT) || 0;
            let packAmt = parseFloat(d.PACK_AMT) || 0;
            let discAmt = parseFloat(d.DISC_AMT) || 0;
            let taxable = amount + packAmt - discAmt;
            // Get tax details and apply
            $.ajax({
                url: '/SalesReturn/GetTaxTypeDetails',
                type: 'GET',
                data: { code: d.TAX_CODE },
                success: function (res) {
                    debugger
                    if (!res) return toastr.error('Invalid tax data');

                    let cgstPer = parseFloat(res.cgsT_PER) || 0;
                    let sgstPer = parseFloat(res.sgsT_PER) || 0;
                    let igstPer = parseFloat(res.igsT_PER) || 0;
                    let cessPer = parseFloat(res.otH_PER) || 0;

                    // Set % in row
                    $row.find('.cgst-per').val(cgstPer.toFixed(2));
                    $row.find('.sgst-per').val(sgstPer.toFixed(2));
                    $row.find('.igst-per').val(igstPer.toFixed(2));
                    $row.find('.cess-per').val(cessPer.toFixed(2));

                    // Calculate tax amounts
                    $row.find('.cgst-amt').val((taxable * cgstPer / 100).toFixed(2));
                    $row.find('.sgst-amt').val((taxable * sgstPer / 100).toFixed(2));
                    $row.find('.igst-amt').val((taxable * igstPer / 100).toFixed(2));
                    $row.find('.cess-amt').val((taxable * cessPer / 100).toFixed(2));

                    calculateTotalRecQty(); // Update totals
                },
                error: function () {
                    toastr.error('Tax calculation failed');
                }
            });
        });
    }
    // ======================== Apply Tax Function ========================
    function applyTax($row, taxCode) {

        if (!taxCode) return;

        let amount  = parseFloat($row.find('.amount-input').val()) || 0;
        let packAmt = parseFloat($row.find('.pack-amount-input').val()) || 0;
        let discAmt = parseFloat($row.find('.disc-amount-input').val()) || 0;
        let taxable = amount + packAmt - discAmt;

        $.ajax({
            url: '/SalesReturn/GetTaxTypeDetails',
            type: 'GET',
            data: { code: taxCode },
            success: function (res) {
                if (!res) return toastr.error('Invalid tax data');

                let cgstPer = parseFloat(res.cgsT_PER) || 0;
                let sgstPer = parseFloat(res.sgsT_PER) || 0;
                let igstPer = parseFloat(res.igsT_PER) || 0;
                let cessPer = parseFloat(res.otH_PER) || 0;

                // Set % in row
                $row.find('.cgst-per').val(cgstPer.toFixed(2));
                $row.find('.sgst-per').val(sgstPer.toFixed(2));
                $row.find('.igst-per').val(igstPer.toFixed(2));
                $row.find('.cess-per').val(cessPer.toFixed(2));

                // Calculate tax amounts
                $row.find('.cgst-amt').val((taxable * cgstPer / 100).toFixed(2));
                $row.find('.sgst-amt').val((taxable * sgstPer / 100).toFixed(2));
                $row.find('.igst-amt').val((taxable * igstPer / 100).toFixed(2));
                $row.find('.cess-amt').val((taxable * cessPer / 100).toFixed(2));

                calculateTotalRecQty();
            },
            error: function () {
                toastr.error('Tax calculation failed');
            }
        });
    }
    //==========================Save Funcation Start Block=================

