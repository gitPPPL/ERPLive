@{
    ViewBag.Title = "Export Tracking Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="erp-toast-container"></div>
<div class="erppagelist-header">
    <div class="erppagelist-title">
        <i class="fa fa-ship"></i>
        <span>Export Tracking Report</span>
    </div>
</div>
