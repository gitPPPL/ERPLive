        <fieldset class="erppagefieldset">
            <div class="erppage-grid5">
                <div class="erppage-divfield">
                    <label class="erppage-label">Date From</label>
                    <input type="date" class="erppage-input" id="DtDatefrom" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">To</label>
                    <input type="date" class="erppage-input" id="Dtto" />
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Ship Type</label>
                    <select class="erppage-input erppage-select" id="ddlshiptype">
                        <option value="IMPORT" selected>IMPORT</option>
                    </select>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label">Status</label>
                    <select class="erppage-input erppage-select" id="ddlstatus">
                        <option value="OPEN" selected>OPEN</option>
                        <option value="CLOSE">CLOSE</option>
                    </select>
                </div>
            </div>
            <div class="erppage-grid5">
                <div class="erppage-divfield">
                    <label class="erppage-label" id="lblTotalCount"></label>
                </div>
                <div class="erppage-divfield">
                    <label class="erppage-label" id="lblTotalUpdated"></label>
                </div>
            </div>
            <div class="erppage-grid5">
                <div class="erppage-divfield erppage-col-span-3">
                    <div class="erppagelist-search-wrapper">
                        <i class="fa fa-search"></i>
                        <input type="text" id="searchBox" placeholder="Search By" />
                    </div>
                </div>
                @* <div class="erppage-divfield"></div> *@
                <div class="erppage-divfield">
                    <div class="erppagesmodal-checkbox-wrap">
                        <input type="checkbox" id="chkContainerDetails" class="erppagecheckbox-input" />
                        <label class="erppagecheckbox-label" for="chkContainerDetails">With Container Detail</label>
                    </div>
                </div>
                <div class="erppage-divfield">
                    <button type="button" id="btnviewdata" class="erppage-btn erppage-btn-common">
                        <i class="fa fa-table"></i>
                        <span>View Data</span>
