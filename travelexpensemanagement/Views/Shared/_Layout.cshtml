<body>

	



	<div class="ERPPageLayout-overlay" id="ERPPageLayoutOverlay"></div>
	<aside class="ERPPageLayout-sidebar" id="ERPPageLayoutSidebar">
		<div class="ERPPageLayout-logo">
			<img src="~/images/logo.webp">
			<div class="ERPPageLayout-logo-text">
				<h2>ERP Portal</h2>
			</div>
		</div>
		<div class="ERPPageLayout-company-info">
			<div class="ERPPageLayout-company-icon">
				<i class="fa fa-building"></i>
			</div>
			<div class="ERPPageLayout-company-details">
				<h3>@Company</h3>
				<span>Corporate ERP System</span>
			</div>
		</div>
		<div class="ERPPageLayout-search">
			<i class="fa fa-search"></i>
			<input type="text" id="ERPPageLayoutMenuSearch" placeholder="Search Menu...">
			<div id="ERPPageLayoutSearchResults" class="ERPPageLayout-search-results"></div>
		</div>
		@functions {

			bool HasMenuAccess(
			travelexpensemanagement.ModuleService.ModuleService.MenuModule menu,
			List<travelexpensemanagement.ModuleService.ModuleService.UserMenuPermission> permissions,
			int? userLevel)
			{
				// Admin access
				if (userLevel == 1)
					return true;

				// Current menu access
				bool currentAccess = permissions.Any(p =>
				p.MENU_CODE == menu.CODE &&
				p._ACCESS == 1);

				if (currentAccess)
					return true;

				// Child menu access
				if (menu.Children != null && menu.Children.Any())
				{
					return menu.Children.Any(child =>
					HasMenuAccess(child, permissions, userLevel));
				}

				return false;
			}
		}

		<ul class="ERPPageLayout-menu">

			@if (moduleMenus != null)
			{
				foreach (var module in moduleMenus)
				{
					bool hasModuleAccess = userLevel == 1 ||
					module.Menus.Any(menu =>
					HasMenuAccess(menu, menuPermissions, userLevel));

					// Hide module if no menu access
					if (!hasModuleAccess)
					{
						continue;
					}

					<li class="ERPPageLayout-menu-item">

						<!-- LEVEL 1 -->

						<a href="#" class="ERPPageLayout-menu-link ERPPageLayout-has-submenu">

							<span>
								<i class="fa fa-folder"></i>
								@module.ModuleName
							</span>

							<i class="fa fa-angle-down ERPPageLayout-arrow"></i>

						</a>

						<!-- LEVEL 2 -->

						<ul class="ERPPageLayout-submenu">

							@foreach (var menu in module.Menus)
							{
								bool hasAccess = HasMenuAccess(
								(travelexpensemanagement.ModuleService.ModuleService.MenuModule)menu,
								menuPermissions,
								userLevel);

								if (!hasAccess)
								{
									continue;
								}

								@Html.Partial(
								"_MenuPartial",
										(travelexpensemanagement.ModuleService.ModuleService.MenuModule)menu)
										}

						</ul>

					</li>
				}
			}

		</ul>
			
	
	</aside>
	<!-- MAIN -->
	<div class="ERPPageLayout-main">
		<header class="ERPPageLayout-topbar">
			<div class="ERPPageLayout-topbar-left">
				<button class="ERPPageLayout-icon-btn" id="ERPPageLayoutToggleSidebar">
					<i class="fa fa-bars"></i>
				</button>
			</div>
			<div class="ERPPageLayout-topbar-right">
				<button class="ERPPageLayout-icon-btn" id="ERPPageLayoutFullscreenBtn">
					<i class="fa fa-expand"></i>
				</button>
				<div class="ERPPageLayout-user">
					<button class="ERPPageLayout-user-btn" id="ERPPageLayoutUserBtn">
						<img src="~/images/user.png" class="user-avatar" alt="User" width="32" height="32">
						<span>@userName</span>
						<i class="fa fa-angle-down"></i>
					</button>
					<div class="ERPPageLayout-user-menu" id="ERPPageLayoutUserMenu">
						<a href="#"><i class="fa fa-user"></i>Profile</a>
						<a href="#"><i class="fa fa-gear"></i>Settings</a>
						<a href="#"><i class="fa fa-lock"></i>Change Password</a>
						<a href="@Url.Action("Logout", "Login")"><i class="fa fa-right-from-bracket"></i>Logout</a>
					</div>
				</div>
			</div>
		</header>
		<div class="ERPPageLayout-content">
			<div id="lottie-overlay">
				<div id="lottie-animation"></div>
			</div>
			@RenderBody()
		</div>
	</div>
	<script>

		document.addEventListener("DOMContentLoaded", function () {

			/* =========================================
			   MENU TOGGLE
			========================================= */

			const menuLinks = document.querySelectorAll('.ERPPageLayout-has-submenu');

			menuLinks.forEach(link => {

				link.addEventListener('click', function (e) {

					e.preventDefault();
					e.stopPropagation();

					const parentLi = this.parentElement;

					const submenu =
						parentLi.querySelector(':scope > .ERPPageLayout-submenu');

					if (!submenu) return;

					const isOpen = submenu.classList.contains('open');

					// CLOSE ONLY SAME LEVEL MENUS
					const siblings = parentLi.parentElement.children;

					Array.from(siblings).forEach(item => {

						if (item !== parentLi) {

							const siblingSubmenu =
								item.querySelector(':scope > .ERPPageLayout-submenu');

							const siblingLink =
								item.querySelector(':scope > .ERPPageLayout-menu-link');

							// DO NOT CLOSE ACTIVE MENU PATH
							if (!item.classList.contains('keep-open')) {

								item.classList.remove('active');

								if (siblingSubmenu) {
									siblingSubmenu.classList.remove('open');
								}

								if (siblingLink) {
									siblingLink.classList.remove('open');
								}
							}
						}

					});

					// TOGGLE CURRENT MENU
					if (isOpen) {

						// PREVENT ACTIVE PAGE PARENT FROM CLOSING
						if (!parentLi.classList.contains('keep-open')) {

							submenu.classList.remove('open');
							parentLi.classList.remove('active');
							this.classList.remove('open');

						}

					} else {

						submenu.classList.add('open');
						parentLi.classList.add('active');
						this.classList.add('open');

					}

				});

			});

			/* =========================================
			   AUTO OPEN ACTIVE PAGE MENU
			========================================= */

			const currentPath = window.location.pathname.toLowerCase();

			const allLinks = document.querySelectorAll('.ERPPageLayout-menu a');

			allLinks.forEach(link => {

				const href = link.getAttribute('href');

				if (!href || href === '#') return;

				const cleanHref = href.toLowerCase();

				// EXACT MATCH
				if (currentPath === cleanHref) {

					link.classList.add('active-page');

					let currentLi = link.closest('li');

					while (currentLi) {

						currentLi.classList.add('active');
						currentLi.classList.add('keep-open');

						const submenu =
							currentLi.querySelector(':scope > .ERPPageLayout-submenu');

						if (submenu) {
							submenu.classList.add('open');
						}

						const parentLink =
							currentLi.querySelector(':scope > .ERPPageLayout-menu-link');

						if (parentLink) {
							parentLink.classList.add('open');
						}

						currentLi = currentLi.parentElement.closest('li');

					}

				}

			});

			/* =========================================
			   SIDEBAR TOGGLE
			========================================= */

			const sidebarBtn =
				document.getElementById('ERPPageLayoutToggleSidebar');

			const sidebar =
				document.getElementById('ERPPageLayoutSidebar');

			const overlay =
				document.getElementById('ERPPageLayoutOverlay');

			if (sidebarBtn && sidebar && overlay) {

				sidebarBtn.addEventListener('click', function () {

					sidebar.classList.toggle('active');
					overlay.classList.toggle('active');

				});

				overlay.addEventListener('click', function () {

					sidebar.classList.remove('active');
					overlay.classList.remove('active');

				});

			}

			/* =========================================
			   USER DROPDOWN
			========================================= */

			const userBtn =
				document.getElementById('ERPPageLayoutUserBtn');

			const userMenu =
				document.getElementById('ERPPageLayoutUserMenu');

			if (userBtn && userMenu) {

				userBtn.addEventListener('click', function (e) {

					e.stopPropagation();

					userMenu.classList.toggle('show');

				});

				document.addEventListener('click', function (e) {

					if (!e.target.closest('.ERPPageLayout-user')) {
						userMenu.classList.remove('show');
					}

				});

			}

			/* =========================================
			   FULLSCREEN
			========================================= */

			const fullscreenBtn =
				document.getElementById('ERPPageLayoutFullscreenBtn');

			if (fullscreenBtn) {

				fullscreenBtn.addEventListener('click', function () {

					if (!document.fullscreenElement) {

						document.documentElement.requestFullscreen();

					} else {

						document.exitFullscreen();

					}

				});

			}

			/* =========================================
			   LOTTIE
			========================================= */

			const lottieContainer =
				document.getElementById('lottie-animation');

			if (lottieContainer && typeof lottie !== "undefined") {

				lottie.loadAnimation({
					container: lottieContainer,
					renderer: 'svg',
					loop: true,
					autoplay: true,
					path: 'https://lottie.host/30e1c7d5-22ca-41c7-b0a2-f2b0a7ce94e2/ysJGEsOTl6.json'
				});

			}

		});

	</script>
	<script>
		$(document).ajaxComplete(function (event, xhr) {
			if (xhr.status === 401 && xhr.responseText === "SessionExpired") {
				window.location.href = "/AccessedError/Index";
			}
		});
	</script>

	
	<script>
		$(document).ajaxStart(function () {
			showLoader();
		});

		$(document).ajaxStop(function () {
			hideLoader();
		});

		let loaderTimeout;
		let loaderStartTime;

		function showLoader() {
			loaderStartTime = Date.now();
			document.getElementById('lottie-overlay').style.display = 'flex';
		}

		function hideLoader() {
			const elapsed = Date.now() - loaderStartTime;
			const minTime = 400; // 👈 smooth delay (300–500ms best)

			if (elapsed < minTime) {
				clearTimeout(loaderTimeout);
				loaderTimeout = setTimeout(() => {
					document.getElementById('lottie-overlay').style.display = 'none';
				}, minTime - elapsed);
			} else {
				document.getElementById('lottie-overlay').style.display = 'none';
			}
		}

		// ✅ ADD HERE 👇 (GLOBAL FETCH WRAPPER)
		const originalFetch = window.fetch;

		window.fetch = async function (...args) {
			showLoader();
			try {
				const response = await originalFetch(...args);
				return response;
			} finally {
				hideLoader();
			}
		};

	</script>
	


	<script>
		var $window = $(window);
		var nav = $('.fixed-button');
			$window.scroll(function(){
				if ($window.scrollTop() >= 200) {
				 nav.addClass('active');
			}
			 else {
				 nav.removeClass('active');
			 }
		 });
	</script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.7.10/lottie.min.js"></script>
