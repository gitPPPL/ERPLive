@inject IHttpContextAccessor HttpContextAccessor
@inject travelexpensemanagement.ModuleService.ModuleService ModuleService

@{
	var userName = "Guest";
	var modules = new List<travelexpensemanagement.ModuleService.ModuleService.Module>();
	var moduleMenus = ModuleService.BuildModuleMenus();
	//var moduleMenus = ModuleService.GetModuleMenus();
	//var moduleMenus = ViewBag.ModuleMenus as List<travelexpensemanagement.ModuleService.ModuleService.ModuleMenuViewModel>;
	var menumodules = new List<travelexpensemanagement.ModuleService.ModuleService.MenuModule>();
	var menuPermissions = new List<travelexpensemanagement.ModuleService.ModuleService.UserMenuPermission>();
	int? userLevel = 1;
	var Company = string.Empty;

	

	// Current controller and action
	var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
	var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower() ?? string.Empty;

	// Helper to match controller + optional actions
	bool IsHere(string ctrl, params string[] actions) =>
		!string.IsNullOrEmpty(ctrl) &&
		string.Equals(currentCtrl, ctrl, StringComparison.OrdinalIgnoreCase) &&
		(actions == null || actions.Length == 0 ||
		 actions.Any(a => string.Equals(a, currentAction, StringComparison.OrdinalIgnoreCase)));

	// Load session-based data safely
	if (HttpContextAccessor?.HttpContext?.Session != null &&
		HttpContextAccessor.HttpContext.Session.Keys.Any())
	{
		userName = HttpContextAccessor.HttpContext.Session.GetString("USER_NAME") ?? "Guest";

		modules = ModuleService.GetAllModules() ?? modules;
		menumodules = ModuleService.GetMenuMaster() ?? menumodules;
		menuPermissions = ModuleService.GetUserMenuPermissions() ?? menuPermissions;
		userLevel = ModuleService.GetUserLevel() ?? userLevel;
		Company = ModuleService.GetCompanyName() ?? Company;
	}
}
<style>
	
	#lottie-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(255,255,255,0.6);
		display: none;
		justify-content: center;
		align-items: center;
		z-index: 9999;
	}

	#lottie-animation {
		width: 120px;
		height: 120px;
	}
</style>

