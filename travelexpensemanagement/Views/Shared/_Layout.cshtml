	<script>
		document.addEventListener("DOMContentLoaded", function () {

			/* =========================================
			   MENU TOGGLE
			========================================= */

			document.addEventListener('click', function (e) {

			const link = e.target.closest('.ERPPageLayout-has-submenu');

			if (!link) return;

			e.preventDefault();
			e.stopPropagation();

			const parentLi = link.closest('li');

			const submenu = Array.from(parentLi.children).find(el => el.classList.contains('ERPPageLayout-submenu'));

			console.log("Clicked:", link.textContent.trim());
			console.log("Parent LI:", parentLi);
			console.log("Submenu:", submenu);

			if (!submenu) return;

			const isOpen = submenu.classList.contains('open');

			if (isOpen) {

				submenu.classList.remove('open');
				parentLi.classList.remove('active');
				link.classList.remove('open');

			} else {

				submenu.classList.add('open');
				parentLi.classList.add('active');
				link.classList.add('open');
			}
		});

			/* =========================================
			   AUTO OPEN ACTIVE PAGE MENU
			========================================= */

			const currentPath = window.location.pathname.toLowerCase();

			const activeLink = document.querySelector(`.ERPPageLayout-menu a[href="${window.location.pathname}"]`);

		if (activeLink) {

			activeLink.classList.add('active-page');

			let currentLi = activeLink.closest('li');

			while (currentLi) {

				currentLi.classList.add('active');
				currentLi.classList.add('keep-open');

				const submenu = Array.from(currentLi.children)
					.find(el => el.classList.contains('ERPPageLayout-submenu'));

				if (submenu) {
					submenu.classList.add('open');
				}

				const parentLink = currentLi.querySelector(
					':scope > .ERPPageLayout-menu-link'
				);

				if (parentLink) {
					parentLink.classList.add('open');
				}

				currentLi = currentLi.parentElement.closest('li');
			}
		}

			

			/* =========================================
			   SIDEBAR TOGGLE
			========================================= */

			// const sidebarBtn = document.getElementById('ERPPageLayoutToggleSidebar');
			// const sidebar = document.getElementById('ERPPageLayoutSidebar');
			// const overlay = document.getElementById('ERPPageLayoutOverlay');

			// if (sidebarBtn && sidebar && overlay) {

			// 	sidebarBtn.addEventListener('click', function () {
			// 		sidebar.classList.toggle('active');
			// 		overlay.classList.toggle('active');
			// 	});

			// 	overlay.addEventListener('click', function () {
			// 		sidebar.classList.remove('active');
			// 		overlay.classList.remove('active');
			// 	});
			// }

			/* =========================================
			   USER DROPDOWN
			========================================= */

			const userBtn = document.getElementById('ERPPageLayoutUserBtn');
			const userMenu = document.getElementById('ERPPageLayoutUserMenu');

			if (userBtn && userMenu) {

				userBtn.addEventListener('click', function (e) {
					e.stopPropagation();
					userMenu.classList.toggle('show');
				});

				document.addEventListener('click', function (e) {
					if (!e.target.closest('.ERPPageLayout-user')) {
						userMenu.classList.remove('show');
					}
				});
			}

			/* =========================================
			   FULLSCREEN
			========================================= */

			const fullscreenBtn = document.getElementById('ERPPageLayoutFullscreenBtn');

			if (fullscreenBtn) {

				fullscreenBtn.addEventListener('click', function () {

					if (!document.fullscreenElement) {
						document.documentElement.requestFullscreen();
					} else {
						document.exitFullscreen();
					}
				});
			}

		/* =========================================
		   SIDEBAR TOGGLE
		========================================= */

		const sidebarBtn = document.getElementById('ERPPageLayoutToggleSidebar');
		const sidebar = document.getElementById('ERPPageLayoutSidebar');
		const overlay = document.getElementById('ERPPageLayoutOverlay');
		const main = document.querySelector('.ERPPageLayout-main');

		if (sidebarBtn && sidebar) {

			sidebarBtn.addEventListener('click', function () {

				sidebar.classList.toggle('collapsed');

				if (main) {
					main.classList.toggle('expanded');
				}

			});

			if (overlay) {
				overlay.addEventListener('click', function () {
					sidebar.classList.remove('collapsed');

					if (main) {
						main.classList.remove('expanded');
					}
				});
			}
		}

			/* =========================================
			   LOTTIE
			========================================= */

			const lottieContainer = document.getElementById('lottie-animation');

			if (lottieContainer && typeof lottie !== "undefined") {

				lottie.loadAnimation({
					container: lottieContainer,
					renderer: 'svg',
					loop: true,
					autoplay: true,
					path: 'https://lottie.host/30e1c7d5-22ca-41c7-b0a2-f2b0a7ce94e2/ysJGEsOTl6.json'
				});
			}

			/* =========================================
			   MENU SEARCH
			========================================= */

			const searchInput = document.getElementById("ERPPageLayoutMenuSearch");

			if (searchInput) {

				searchInput.addEventListener("input", function () {

					const keyword = this.value.trim().toLowerCase();

					const resetUI = () => {

						document.querySelectorAll('.ERPPageLayout-menu-link')
							.forEach(link => link.classList.remove('active-page'));

						document.querySelectorAll('.ERPPageLayout-menu li')
							.forEach(li => li.classList.remove('active'));

						document.querySelectorAll(".ERPPageLayout-menu li")
							.forEach(li => {
								li.style.display = "";
								li.classList.remove("search-match");
							});

						document.querySelectorAll(".ERPPageLayout-submenu")
							.forEach(sub => {
								if (!sub.closest(".keep-open")) {
									sub.classList.remove("open");
								}
							});
					};

					resetUI();

					if (keyword === "") return;

					const rootMenus = document.querySelectorAll(".ERPPageLayout-menu > li");

					rootMenus.forEach(root => {
						const matched = processMenu(root, keyword);
						root.style.display = matched ? "" : "none";
					});
				});
			}

			function processMenu(li, keyword) {

				let selfMatch = false;
				let childMatch = false;

				const link = li.querySelector(":scope > a");

				if (link) {

					const text = link.textContent.trim().toLowerCase();
					selfMatch = text.includes(keyword);

					link.classList.remove("active-page");

					if (selfMatch) {

						const hasChildren = li.querySelector(":scope > .ERPPageLayout-submenu");

						if (hasChildren) {
							link.classList.add("active-page");
						} else {
							link.classList.remove("active-page");
						}

						let level = 0;
						let parentLi = li.parentElement.closest("li");

						while (parentLi) {

							level++;

							const parentLink =
								parentLi.querySelector(':scope > .ERPPageLayout-menu-link');

							if (level <= 2) {

								parentLi.classList.add("active");

								if (parentLink) {
									parentLink.classList.add("active-page");
								}
							}

							parentLi = parentLi.parentElement.closest("li");
						}
					}
				}

				const children = li.querySelectorAll(":scope > .ERPPageLayout-submenu > li");

				children.forEach(child => {
					if (processMenu(child, keyword)) {
						childMatch = true;
					}
				});

				const finalMatch = selfMatch || childMatch;

				li.style.display = finalMatch ? "" : "none";

				const submenu = li.querySelector(":scope > .ERPPageLayout-submenu");
				const parentLink = li.querySelector(":scope > .ERPPageLayout-menu-link");

				if (submenu) {

					if (childMatch || selfMatch) {
						submenu.classList.add("open");
						if (parentLink) parentLink.classList.add("open");
					} else {
						submenu.classList.remove("open");
						if (parentLink) parentLink.classList.remove("open");
					}
				}

				return finalMatch;
			}

		});
	</script>
	<script>
		$(document).ajaxComplete(function (event, xhr) {
			if (xhr.status === 401 && xhr.responseText === "SessionExpired") {
				window.location.href = "/AccessedError/Index";
			}
		});
	</script>

	
	<script>
		$(document).ajaxStart(function () {
			showLoader();
		});

		$(document).ajaxStop(function () {
			hideLoader();
		});

		let loaderTimeout;
		let loaderStartTime;

		function showLoader() {
			loaderStartTime = Date.now();
			document.getElementById('lottie-overlay').style.display = 'flex';
		}

		function hideLoader() {
			const elapsed = Date.now() - loaderStartTime;
			const minTime = 400; // 👈 smooth delay (300–500ms best)

			if (elapsed < minTime) {
				clearTimeout(loaderTimeout);
				loaderTimeout = setTimeout(() => {
					document.getElementById('lottie-overlay').style.display = 'none';
				}, minTime - elapsed);
			} else {
				document.getElementById('lottie-overlay').style.display = 'none';
			}
		}

		// ✅ ADD HERE 👇 (GLOBAL FETCH WRAPPER)
		const originalFetch = window.fetch;

		window.fetch = async function (...args) {
			showLoader();
			try {
				const response = await originalFetch(...args);
				return response;
			} finally {
				hideLoader();
			}
		};

	</script>
	


	<script>
		var $window = $(window);
		var nav = $('.fixed-button');
			$window.scroll(function(){
				if ($window.scrollTop() >= 200) {
				 nav.addClass('active');
			}
			 else {
				 nav.removeClass('active');
			 }
		 });
	</script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.7.10/lottie.min.js"></script>
