			</div>
		</div>
		<div class="ERPPageLayout-company-info">
			<div class="ERPPageLayout-company-icon">
				<i class="fa fa-building"></i>
			</div>
			<div class="ERPPageLayout-company-details">
				<h3>@Company</h3>
				<span>Corporate ERP System</span>
			</div>
		</div>
		<div class="ERPPageLayout-search">
			<i class="fa fa-search"></i>
			<input type="text" id="ERPPageLayoutMenuSearch" placeholder="Search Menu...">
			<div id="ERPPageLayoutSearchResults" class="ERPPageLayout-search-results"></div>
		</div>
		@functions {

			bool IsMenuActiveRecursive(
			travelexpensemanagement.ModuleService.ModuleService.MenuModule menu,
			string currentController)
			{
				if (!string.IsNullOrEmpty(menu.WebFORM_NAME) &&
				string.Equals(menu.WebFORM_NAME,
				currentController,
				StringComparison.OrdinalIgnoreCase))
				{
					return true;
				}

				if (menu.Children != null && menu.Children.Any())
				{
					return menu.Children.Any(child =>
					IsMenuActiveRecursive(child, currentController));
				}

				return false;
			}

			bool HasMenuAccess(
			travelexpensemanagement.ModuleService.ModuleService.MenuModule menu,
			List<travelexpensemanagement.ModuleService.ModuleService.UserMenuPermission> permissions,
			int? userLevel)
			{
				if (userLevel == 1)
					return true;

				bool currentAccess = permissions.Any(p =>
				p.MENU_CODE == menu.CODE &&
				p._ACCESS == 1);

				if (currentAccess)
					return true;

				if (menu.Children != null && menu.Children.Any())
				{
					return menu.Children.Any(child =>
					HasMenuAccess(child, permissions, userLevel));
				}

				return false;
			}

			void RenderMenu(
			travelexpensemanagement.ModuleService.ModuleService.MenuModule menu,
			List<travelexpensemanagement.ModuleService.ModuleService.UserMenuPermission> menuPermissions,
			int? userLevel,
			TextWriter writer)
			{
				bool hasAccess = userLevel == 1 ||
				HasMenuAccess(menu, menuPermissions, userLevel);

				if (!hasAccess)
					return;

				writer.WriteLine("<li class='ERPPageLayout-menu-item'>");

				if (menu.Children != null && menu.Children.Any())
				{
					writer.WriteLine($@"
				<a href='#' class='ERPPageLayout-menu-link ERPPageLayout-has-submenu'>
				<span>{menu.DISPLAY_NAME}</span>
				<i class='fa fa-angle-down ERPPageLayout-arrow'></i>
				</a>

				<ul class='ERPPageLayout-submenu'>
				");

					foreach (var child in menu.Children)
					{
						RenderMenu(
						child,
						menuPermissions,
						userLevel,
						writer);
					}

					writer.WriteLine("</ul>");
				}
				else
				{
					writer.WriteLine($@"
				<a href='/{menu.WebFORM_NAME}/Index'
				class='ERPPageLayout-menu-link'>
				{menu.DISPLAY_NAME}
				</a>
				");
				}

				writer.WriteLine("</li>");
			}
		}
		
		<ul class="ERPPageLayout-menu">

    @if (moduleMenus != null)
    {
        foreach (var module in moduleMenus)
        {
            bool moduleOpen = module.Menus.Any(m =>
                IsMenuActiveRecursive(m, currentCtrl));

            bool hasModuleAccess = userLevel == 1 ||
                module.Menus.Any(menu =>
                    HasMenuAccess(menu, menuPermissions, userLevel));

            if (!hasModuleAccess)
            {
                continue;
            }

            <li class="ERPPageLayout-menu-item @(moduleOpen ? "active keep-open" : "")">

                <a href="#" class="ERPPageLayout-menu-link ERPPageLayout-has-submenu">

                    <span>
                        <i class="fa @(string.IsNullOrEmpty(module.Icon) ? "fa-folder" : module.Icon)"></i>
                        @module.ModuleName
                    </span>

                    <i class="fa fa-angle-down ERPPageLayout-arrow"></i>

                </a>

                <ul class="ERPPageLayout-submenu @(moduleOpen ? "open" : "")">

                    @foreach (var menu in module.Menus)
                    {
                        bool hasAccess = HasMenuAccess(
                            (travelexpensemanagement.ModuleService.ModuleService.MenuModule)menu,
                            menuPermissions,
                            userLevel);

                        if (!hasAccess)
                        {
                            continue;
                        }

								RenderMenu(
								(travelexpensemanagement.ModuleService.ModuleService.MenuModule)menu,
								menuPermissions,
								userLevel,
								Output);
                    }

                </ul>

            </li>
        }
    }

</ul>
			
	
	</aside>
	<!-- MAIN -->
	<div class="ERPPageLayout-main">
		<header class="ERPPageLayout-topbar">
			<div class="ERPPageLayout-topbar-left">
				<button class="ERPPageLayout-icon-btn" id="ERPPageLayoutToggleSidebar">
					<i class="fa fa-bars"></i>
				</button>
			</div>
			<div class="ERPPageLayout-topbar-right">
				<button class="ERPPageLayout-icon-btn" id="ERPPageLayoutFullscreenBtn">
					<i class="fa fa-expand"></i>
				</button>
				<div class="ERPPageLayout-user">
					<button class="ERPPageLayout-user-btn" id="ERPPageLayoutUserBtn">
						<img src="~/images/user.png" class="user-avatar" alt="User" width="32" height="32">
						<span>@userName</span>
						<i class="fa fa-angle-down"></i>
					</button>
					<div class="ERPPageLayout-user-menu" id="ERPPageLayoutUserMenu">
						<a href="#"><i class="fa fa-user"></i>Profile</a>
						<a href="#"><i class="fa fa-gear"></i>Settings</a>
						<a href="#"><i class="fa fa-lock"></i>Change Password</a>
						<a href="@Url.Action("Logout", "Login")"><i class="fa fa-right-from-bracket"></i>Logout</a>
					</div>
				</div>
			</div>
		</header>
		<div class="ERPPageLayout-content">
			<div id="lottie-overlay">
				<div id="lottie-animation"></div>
			</div>
			@RenderBody()
		</div>
