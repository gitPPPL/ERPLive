@model travelexpensemanagement.ModuleService.ModuleService.MenuModule

@inject travelexpensemanagement.ModuleService.ModuleService ModuleService

@{
    var menuPermissions = ModuleService.GetUserMenuPermissions();
    var userLevel = ModuleService.GetUserLevel() ?? 1;

    bool HasAccessRecursive(
        travelexpensemanagement.ModuleService.ModuleService.MenuModule menu)
    {
        // Admin access
        if (userLevel == 1)
            return true;

        // Direct access
        bool directAccess = menuPermissions.Any(p =>
            p.MENU_CODE == menu.CODE &&
            p._ACCESS == 1);

        if (directAccess)
            return true;

        // Child access
        if (menu.Children != null && menu.Children.Any())
        {
            return menu.Children.Any(child => HasAccessRecursive(child));
        }

        return false;
    }

    bool hasAccess = HasAccessRecursive(Model);

    if (!hasAccess)
    {
        return;
    }
}

<li>

    @if (Model.Children != null && Model.Children.Any())
    {
        <!-- MENU WITH CHILD -->

        <a href="#"
           class="ERPPageLayout-menu-link ERPPageLayout-has-submenu">

            <span>
                @Model.DISPLAY_NAME
            </span>

            <i class="fa fa-angle-down ERPPageLayout-arrow"></i>

        </a>

        <ul class="ERPPageLayout-submenu">

            @foreach (var child in Model.Children)
            {
                @Html.Partial("_MenuPartial", child)
            }

        </ul>
    }
    else
    {
        <!-- FINAL MENU -->

        <a href="/@Model.WebFORM_NAME/Index"
           class="ERPPageLayout-menu-link">

            @Model.DISPLAY_NAME

        </a>
    }

</li>