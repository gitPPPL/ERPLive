    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <!-- Include jQuery before any other scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> <!-- Add this line -->
    <style>
        .btn-logout {
            border: 1px solid #dc3545;
            background-color: white;
            color: #dc3545;
            padding: 4px 16px;
            font-weight: 500;
        }

            .btn-logout:hover {
                border: 1px solid #dc3545;
                background-color: #dc3545;
                color: #fff;
                padding: 4px 16px;
                font-weight: 500;
            }
    </style>
  
</head>
<body>
   

    <div class="container">
        
        <div class="top-header-wrapper">
            <div class="top-header">
                <div class="logo">
                    <img src="~/ProductPortfolio/images/web-logo.webp" alt="Pashupati Logo" />
                </div>

                <button class="btn btn-logout logout-btn" onclick="logout()">
                    <i class="fa-solid fa-right-from-bracket"></i> Logout
                </button>
            </div>
        </div>


       @*  <div class="logo">
            <img src="~/ProductPortfolio/images/web-logo.webp" alt="Pashupati Logo" />
        </div> *@
        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    </div>
    

    <!-- Bootstrap JS and dependencies -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
              function logout() {
            clearPinSession(); // clears PIN_VERIFIED & PIN_TIME
            window.location.href = "/HomeLogin/Index";
        }
    </script>
    <script>
        const returnToTop = document.getElementById("return-to-top");

        window.addEventListener("scroll", () => {
            returnToTop.style.display = window.scrollY > 200 ? "block" : "none";
        });

        function smoothScrollToTop() {
            const start = window.scrollY;
            const duration = 500; // increase for slower
            const startTime = performance.now();

            function scrollStep(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);

                // easeOutCubic
                const ease = 1 - Math.pow(1 - progress, 3);

                window.scrollTo(0, start * (1 - ease));

                if (progress < 1) {
                    requestAnimationFrame(scrollStep);
                }
            }

            requestAnimationFrame(scrollStep);
        }

        returnToTop.addEventListener("click", smoothScrollToTop);
    </script>
    <!-- Your custom site.js (make sure this file exists) -->
    <script src="~/ProductPortfolio/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
